class MacroFieldW23:
    def __init__(self, dimensions: Tuple[int, int] = (7, 7)):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=np.int8)
        
        mid_x, mid_y = dimensions[0] // 2, dimensions[1] // 2
        for x in range(dimensions[0]):
            for y in range(dimensions[1]):
                dist = abs(x - mid_x) + abs(y - mid_y)
                if dist == 0: self.field[x, y] = np.int8(1)
                elif dist <= 2: self.field[x, y] = np.int8(0)
                else: self.field[x, y] = np.int8(-1)

    def calculate_entropy(self) -> float:
        total = self.field.size
        if total == 0:
            return 0.0
        counts = Counter(int(x) for x in self.field.flatten())
        entropy = 0.0
        for count in counts.values():
            p = count / total
            if p > 0:
                entropy -= p * math.log(p, 3)
        return float(entropy)

    def recover_extremes(self) -> int:
        mask = (self.field == -1)
        count = int(np.sum(mask))
        if count > 0:
            self.field[mask] = np.int8(0)
        return count


class CounterRotatingTernaryBiCore:
    def __init__(self, size: int = 3):
        self.size = size
        self.matrix_a = self._generate_ternary(size)
        self.matrix_b = self._generate_ternary(size)
        self.step_index_a: int = 0
        self.step_index_b: int = 0

    def _generate_ternary(self, size: int) -> np.ndarray:
        mat = np.zeros((size, size), dtype=np.int8)
        mid = size // 2
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid: mat[x, y] = np.int8(0)
                elif (x + y) % 2 == 0: mat[x, y] = np.int8(1)
                else: mat[x, y] = np.int8(-1)
        return mat

    def update_rotation(self, entropy: float) -> None:
        step_delta = 1 if entropy < 0.5 else 1
        self.step_index_a = (self.step_index_a + step_delta) % 12
        self.step_index_b = (self.step_index_b - int(step_delta * 1.5)) % 12

    @property
    def angle_a(self) -> float:
        return self.step_index_a * (math.pi / 6.0)

    @property
    def angle_b(self) -> float:
        return self.step_index_b * (math.pi / 6.0)

    def get_combined_state(self, local_coord: Tuple[int, int], angle: float, matrix: np.ndarray) -> int:
        x, y = local_coord
        mid = self.size // 2
        ox, oy = x - mid, y - mid
        cos_a, sin_a = math.cos(angle), math.sin(angle)
        rx = int(round(ox * cos_a - oy * sin_a))
        ry = int(round(ox * sin_a + oy * cos_a))
        tx = max(0, min(self.size - 1, rx + mid))
        ty = max(0, min(self.size - 1, ry + mid))
        return int(matrix[tx, ty])


class PhaseHysteresisMemory:
    def __init__(self, window_size: int = 4):
        self.history = deque(maxlen=window_size)

    def register_state(self, state: int) -> int:
        self.history.append(state)
        avg = sum(self.history) / len(self.history)
        if avg > 0.33: return 1
        elif avg >= -0.33: return 0
        else: return -1


class TetraCube5:
    """
    Dual-layer 5x5x5 cube structure (1000 bytes monolith):
    Layer 1 (data): Physical layer / Compressed residual_delta bytes (500 bytes)
    Layer 2 (semantic): AI judgments and semantic states (500 bytes)
    """
    __slots__ = ("data", "semantic_data")

    def __init__(self, data: Optional[np.ndarray] = None, semantic_data: Optional[np.ndarray] = None) -> None:
        self.data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8) if data is None else data
        self.semantic_data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8) if semantic_data is None else semantic_data

    @classmethod
    def from_text_residual(cls, raw_text: str, semantic_val: int = 0) -> "TetraCube5":
        source_bytes = np.frombuffer(raw_text.encode('utf-8'), dtype=np.uint8)
        recon = np.zeros_like(source_bytes)
        if len(recon) > 0:
            recon[0] = source_bytes[0]
            
        residual_delta = _njit_calculate_text_residual(source_bytes.astype(np.int16), recon.astype(np.int16))
        compressed_residual = zlib.compress(residual_delta.tobytes(), 9)
        
        comp_len = len(compressed_residual)
        if comp_len > 498:
            raise ValueError("Compressed residual exceeds physical layer capacity (498 bytes)")
            
        phys_data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
        flat_phys = phys_data.ravel().view(np.uint8)
        flat_phys[0] = comp_len & 0xFF
        flat_phys[1] = (comp_len >> 8) & 0xFF
        flat_phys[2:2+comp_len] = np.frombuffer(compressed_residual, dtype=np.uint8)
        
        sem_data = np.full((CUBE, CUBE, CUBE, N_FACES), semantic_val, dtype=np.int8)
        return cls(data=phys_data, semantic_data=sem_data)

    def pack_monolith(self) -> bytes:
        return self.data.tobytes() + self.semantic_data.tobytes()

    @classmethod
    def unpack_monolith(cls, raw: bytes) -> "TetraCube5":
        if len(raw) < 1000:
            raise ValueError("Monolithic payload too short (need 1000 bytes)")
        arr_phys = np.frombuffer(raw[:500], dtype=np.int8).copy().reshape(CUBE, CUBE, CUBE, N_FACES)
        arr_sem = np.frombuffer(raw[500:1000], dtype=np.int8).copy().reshape(CUBE, CUBE, CUBE, N_FACES)
        return cls(data=arr_phys, semantic_data=arr_sem)

    def mean_energy(self) -> float:
        return float((np.mean(np.abs(self.data)) + np.mean(np.abs(self.semantic_data))) / 2.0)


class TetraBitstreamWriter:
    __slots__ = ("_fh",)

    def __init__(self, path: str) -> None:
        self._fh = open(path, "wb")
        self._fh.write(MAGIC + struct.pack("<H", VERSION))

    def __enter__(self) -> "TetraBitstreamWriter":
        return self

    def __exit__(self, exc_type, exc_val, exc_tb) -> None:
        self.close()

    def write_gop(self, cubes: List[TetraCube5], tiles_y: int, tiles_x: int) -> None:
        raw = b"".join(c.pack_monolith() for c in cubes)
        comp = zlib.compress(raw, 9)
        ent = float(np.mean([c.mean_energy() for c in cubes])) if cubes else 0.0
        
        self._fh.write(struct.pack("<HHIfI", tiles_y, tiles_x, len(cubes), ent, len(comp)))
        self._fh.write(comp)

    def close(self) -> None:
        if self._fh and not self._fh.closed:
            self._fh.close()


class TetraBitstreamReader:
    __slots__ = ("_fh", "version")

    def __init__(self, path: str) -> None:
        self._fh = open(path, "rb")
        if self._fh.read(4) != MAGIC:
            raise ValueError("Invalid format: Magic bytes 'ZVDT' not found")
        self.version = struct.unpack("<H", self._fh.read(2))[0]

    def __enter__(self) -> "TetraBitstreamReader":
        return self

    def __exit__(self, exc_type, exc_val, exc_tb) -> None:
        self.close()

    def read_gop(self) -> Optional[Tuple[List[TetraCube5], int, int, float]]:
        hdr_size = struct.calcsize("<HHIfI")
        hdr = self._fh.read(hdr_size)
        if len(hdr) != hdr_size:
            return None
            
        ty, tx, n, ent, plen = struct.unpack("<HHIfI", hdr)
        payload = self._fh.read(plen)
        if len(payload) != plen:
            return None
            
        raw = zlib.decompress(payload)
        need = 1000
        cubes = [TetraCube5.unpack_monolith(raw[i*need:(i+1)*need]) for i in range(n)]
        return cubes, ty, tx, ent

    def close(self) -> None:
        if self._fh and not self._fh.closed:
            self._fh.close()


