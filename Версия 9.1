class ConsoleV9:
    def __init__(self):
        self.engine = GameEngineV9()
        self.running = True

    def _render(self):
        print("\n" + "=" * 60)
        print("V9 CONSOLE ACTIVE")
        print("=" * 60)

        print("\nТЕКУЩАЯ МАТРИЦА:")
        for row in self.engine.state.data:
            print(f"  {row}")

        print(f"\nСТАТИСТИКА:")
        print(f"  Стабильность: {self.engine.state.stability_index():.2f}")
        print(f"  Энтропия: {self.engine.state.entropy():.2f}")
        print(f"  Детерминант: {self.engine.state.determinant()}")
        print(f"  История: {len(self.engine.history)} блоков")
        print(f"  Геометрия: {self.engine.geometry.mode.value}")
        print(f"  Уровень спирали: {self.engine.lomonosov.get_level()}")

        print("\n" + "-" * 60)
        print("КОМАНДЫ:")
        print("  show                 - показать текущую матрицу")
        print("  set <row> <col> <val> - установить значение")
        print("  add <matrix>         - сложить с матрицей")
        print("  mult <matrix>        - умножить на матрицу")
        print("  transpose            - транспонировать")
        print("  sin, cos, tan, cot   - тригонометрические функции")
        print("  sec, csc             - секанс/косеканс")
        print("  sinh, cosh, tanh     - гиперболические функции")
        print("  trig                 - все тригонометрические функции")
        print("  predict <steps>      - прогноз на N шагов")
        print("  graph                - граф состояний")
        print("  analyze              - полный анализ")
        print("  state                - полное состояние")
        print("  exit                 - выход")
        print("=" * 60)

    def _get_matrix_input(self, rows: int, cols: int) -> TernaryMatrix:
        print(f"Введите матрицу {rows}x{cols} (значения -1, 0, 1):")
        data = []
        for i in range(rows):
            while True:
                try:
                    row = list(map(int, input(f"Строка {i+1}: ").split()))
                    if len(row) != cols:
                        print(f"❌ Ожидается {cols} значений")
                        continue
                    data.append(row)
                    break
                except ValueError:
                    print("❌ Введите числа через пробел")
        return TernaryMatrix(data)

    def run(self):
        while self.running:
            self._render()
            cmd = input("\n➜ ").strip().split()
            if not cmd:
                continue
            action = cmd[0].lower()

            if action == "exit":
                self.running = False
                print("👋 Выход из V9")
            elif action == "show":
                print("\nТекущая матрица:")
                for row in self.engine.state.data:
                    print(f"  {row}")
            elif action == "set" and len(cmd) >= 4:
                try:
                    r, c, v = int(cmd[1]), int(cmd[2]), int(cmd[3])
                    data = [row[:] for row in self.engine.state.data]
                    data[r][c] = v
                    new_mat = TernaryMatrix(data)
                    self.engine.transition('set', new_mat, {'set': (r, c, v)})
                    print(f"✅ Значение [{r}][{c}] = {v}")
                except Exception as e:
                    print(f"❌ Ошибка: {e}")
            elif action in ['sin', 'cos', 'tan', 'cot', 'sec', 'csc', 'sinh', 'cosh', 'tanh', 'transpose']:
                self.engine.transition(action)
                print(f"✅ {action} применён")
            elif action == "trig":
                analysis = self.engine.analyze()
                print("\nВСЕ ТРИГОНОМЕТРИЧЕСКИЕ ФУНКЦИИ:")
                for name, data in analysis.get('trig_functions', {}).items():
                    print(f"\n  {name}:")
                    for row in data.get('data', []):
                        print(f"    {row}")
            elif action == "predict":
                steps = int(cmd[1]) if len(cmd) > 1 else 1
                pred = self.engine.predict(steps)
                print(f"\nПРОГНОЗ НА {steps} ШАГОВ:")
                for row in pred.data:
                    print(f"  {row}")
            elif action == "graph":
                graph = self.engine.get_graph()
                print("\nГРАФ СОСТОЯНИЙ:")
                print(json.dumps(graph, indent=2, ensure_ascii=False))
            elif action == "analyze":
                analysis = self.engine.analyze()
                print("\nПОЛНЫЙ АНАЛИЗ:")
                print(json.dumps(analysis, indent=2, ensure_ascii=False))
            elif action == "state":
                state = self.engine.get_state()
                print("\nПОЛНОЕ СОСТОЯНИЕ:")
                print(json.dumps(state, indent=2, ensure_ascii=False))
            else:
                print(f"❌ Неизвестная команда: {action}")
            input("\nНажмите Enter для продолжения...")


