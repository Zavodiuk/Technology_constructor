class GameEngineV9:
    def __init__(self, initial_matrix: Optional[TernaryMatrix] = None):
        if initial_matrix is None:
            data = [[0, 0, 0], [0, 1, 0], [0, 0, 0]]
            initial_matrix = TernaryMatrix(data)

        self.state = initial_matrix
        self.history: List[MatrixBlockX] = []
        self.blockchain = MatrixBlockChain()
        self.operations_log: List[str] = []
        self.geometry = GeometryEngine()
        self.lomonosov = LomonosovSpiral()
        self.experience = ExperienceModule()

        self._log("GameEngine V9 инициализирован")

    def _log(self, msg: str):
        print(f"[GameEngine V9] {msg}")

    # ---- ОПЕРАЦИИ ПЕРЕХОДА ----

    def transition(self, operation: str, matrix: Optional[TernaryMatrix] = None,
                   payload: Optional[Dict] = None) -> MatrixBlockX:
        old_state = self.state.copy()

        operations = {
            'set': lambda: matrix.copy() if matrix else old_state,
            'add': lambda: self.state.add(matrix) if matrix else old_state,
            'multiply': lambda: self.state.multiply(matrix) if matrix else old_state,
            'transpose': lambda: self.state.transpose(),
            'sin': lambda: self.state.sin(),
            'cos': lambda: self.state.cos(),
            'tan': lambda: self.state.tan(),
            'cot': lambda: self.state.cot(),
            'sec': lambda: self.state.sec(),
            'csc': lambda: self.state.csc(),
            'sinh': lambda: self.state.sinh(),
            'cosh': lambda: self.state.cosh(),
            'tanh': lambda: self.state.tanh(),
            'convolve': lambda: self.state.convolve(matrix) if matrix else old_state
        }

        if operation not in operations:
            raise ValueError(f"Неизвестная операция: {operation}")

        new_matrix = operations[operation]()
        self.state = new_matrix

        block = MatrixBlockX(
            index=len(self.history),
            version='V9',
            timestamp=time.time(),
            prev_hash=self.history[-1].hash if self.history else 'GENESIS',
            state_matrix=self.state,
            payload=payload or {'operation': operation}
        )
        self.history.append(block)
        self.blockchain.add_block(self.state, {'operation': operation})
        self.operations_log.append(f"{operation} → {time.strftime('%H:%M:%S')}")

        self._log(f"Переход: {operation} → блок #{block.index}")
        return block

    def predict(self, steps: int = 1) -> TernaryMatrix:
        result = self.state.copy()
        for _ in range(steps - 1):
            result = result.convolve(result)
        return result

    def get_graph(self) -> Dict:
        nodes, edges = [], []
        for i, block in enumerate(self.history):
            nodes.append({
                'id': i,
                'matrix': block.state_matrix.to_dict(),
                'stability': block.state_matrix.stability_index(),
                'entropy': block.state_matrix.entropy(),
                'timestamp': block.timestamp
            })
            if i > 0:
                edges.append({
                    'from': i - 1,
                    'to': i,
                    'label': block.payload.get('operation', 'unknown')
                })
        return {
            'nodes': nodes,
            'edges': edges,
            'current': self.state.to_dict(),
            'stability': self.state.stability_index()
        }

    def analyze(self) -> Dict:
        return {
            'current_state': self.state.to_dict(),
            'stability': self.state.stability_index(),
            'entropy': self.state.entropy(),
            'determinant': self.state.determinant(),
            'history_len': len(self.history),
            'operations': self.operations_log[-10:],
            'trig_functions': {
                'sin': self.state.sin().to_dict(),
                'cos': self.state.cos().to_dict(),
                'tan': self.state.tan().to_dict(),
                'cot': self.state.cot().to_dict(),
                'sec': self.state.sec().to_dict(),
                'csc': self.state.csc().to_dict(),
                'sinh': self.state.sinh().to_dict(),
                'cosh': self.state.cosh().to_dict(),
                'tanh': self.state.tanh().to_dict()
            },
            'geometry': {
                'mode': self.geometry.mode.value,
                'curvature': self.geometry.curvature
            },
            'lomonosov': {
                'level': self.lomonosov.get_level(),
                'trend': self.lomonosov.get_trend()
            }
        }

    def get_state(self) -> Dict:
        return {
            'version': 'V9',
            'matrix': self.state.to_dict(),
            'stability': self.state.stability_index(),
            'history_len': len(self.history),
            'blockchain': self.blockchain.to_dict(),
            'geometry': {
                'mode': self.geometry.mode.value,
                'curvature': self.geometry.curvature
            },
            'lomonosov': {
                'level': self.lomonosov.get_level(),
                'trend': self.lomonosov.get_trend()
            }
        }

    def get_matrix(self) -> TernaryMatrix:
        return self.state


# ============================================================
# 8. ОПЫТ
# ============================================================

class ExperienceModule:
    def __init__(self, max_size: int = 1000):
        self.records: List[Dict] = []
        self.max_size = max_size

    def add(self, decision: Dict, outcome: float, confidence: float = 0.5):
        self.records.append({
            "decision": decision,
            "outcome": outcome,
            "confidence": confidence,
            "timestamp": time.time()
        })
        if len(self.records) > self.max_size:
            self.records.pop(0)

    def predict(self, decision: Dict) -> float:
        if not self.records:
            return 0.5
        successful = [r["outcome"] for r in self.records if r["outcome"] > 0.5]
        return len(successful) / len(self.records) if self.records else 0.5


# ============================================================
# 9. ЦИКЛ ЛОМОНОСОВА
# ============================================================

class LomonosovSpiral:
    def __init__(self):
        self.history: List[Dict] = []
        self.spiral_level = 0
        self.direction = 0

    def analyze_event(self, event: Dict) -> Dict:
        result = {
            "why": event.get("reason", "неизвестно"),
            "where": event.get("location", "неизвестно"),
            "when": event.get("timestamp", time.time()),
            "loss": event.get("loss", "неизвестно"),
            "gain": event.get("gain", "неизвестно"),
            "spiral_level": self.spiral_level,
            "direction": self.direction,
            "status": "incomplete"
        }

        if result["loss"] != "неизвестно" and result["gain"] != "неизвестно":
            gain_val = result["gain"] if isinstance(result["gain"], (int, float)) else 1
            loss_val = result["loss"] if isinstance(result["loss"], (int, float)) else 1

            if gain_val > loss_val:
                self.direction = 1
            elif loss_val > gain_val:
                self.direction = -1
            else:
                self.direction = 0

            self.spiral_level += self.direction
            result["spiral_level"] = self.spiral_level
            result["direction"] = self.direction
            result["status"] = "complete"

        self.history.append(result)
        return result

    def get_trend(self) -> str:
        if not self.history:
            return "неизвестно"
        last = self.history[-1]
        if last["direction"] == 1:
            return "восходящая"
        elif last["direction"] == -1:
            return "нисходящая"
        else:
            return "горизонтальная"

    def get_level(self) -> int:
        return self.spiral_level


