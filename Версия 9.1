@dataclass
class TimePoint:
    timestamp: float
    state_value: float
    step: int

@dataclass
class TempoPoint:
    timestamp: float
    speed: float
    direction: str
    step: int

@dataclass
class RhythmPoint:
    timestamp: float
    acceleration: float
    cycle_length: int
    phase: float
    pattern: List[str]
    step: int

class TimeTempoRhythmMixin:
    def __init__(self):
        self.time_points: List[TimePoint] = []
        self.tempo_points: List[TempoPoint] = []
        self.rhythm_points: List[RhythmPoint] = []
        self._state_history = deque(maxlen=100)
        self._operation_history = deque(maxlen=100)
        self._step_counter = 0

    def _record_time_point(self, state_value: float, operation: str = None):
        self._step_counter += 1
        point = TimePoint(time.time(), state_value, self._step_counter)
        self.time_points.append(point)
        self._state_history.append(state_value)
        if operation:
            self._operation_history.append(operation)
        if len(self.time_points) >= 2:
            self._compute_tempo()
        if len(self.tempo_points) >= 2:
            self._compute_rhythm()

    def _compute_tempo(self):
        if len(self.time_points) < 2:
            return
        p1, p2 = self.time_points[-2], self.time_points[-1]
        dt = p2.timestamp - p1.timestamp
        if dt == 0:
            return
        speed = (p2.state_value - p1.state_value) / dt
        direction = 'accelerating' if speed > 0.01 else ('decelerating' if speed < -0.01 else 'stable')
        self.tempo_points.append(TempoPoint(p2.timestamp, speed, direction, p2.step))

    def _compute_rhythm(self):
        if len(self.tempo_points) < 2:
            return
        t1, t2 = self.tempo_points[-2], self.tempo_points[-1]
        dt = t2.timestamp - t1.timestamp
        if dt == 0:
            return
        acceleration = (t2.speed - t1.speed) / dt
        ops = list(self._operation_history)
        cycle_length, phase, pattern = 0, 0.0, []
        for length in range(2, min(len(ops)//2, 10)):
            pattern_candidate = list(ops[-length:])
            matches = sum(1 for i in range(0, len(ops)-length, length) if ops[i:i+length] == pattern_candidate)
            if matches >= 2:
                cycle_length, phase, pattern = length, (len(ops) % length) / length, pattern_candidate
                break
        self.rhythm_points.append(RhythmPoint(t2.timestamp, acceleration, cycle_length, phase, pattern, t2.step))

    def get_current_tempo(self):
        return self.tempo_points[-1] if self.tempo_points else None

    def get_current_rhythm(self):
        return self.rhythm_points[-1] if self.rhythm_points else None

    def analyze_time_series(self):
        if not self.time_points:
            return {'error': 'Нет данных'}
        tempo_data = [t.speed for t in self.tempo_points]
        rhythm_data = [r.acceleration for r in self.rhythm_points]
        return {
            'steps': len(self.time_points),
            'duration': self.time_points[-1].timestamp - self.time_points[0].timestamp,
            'avg_tempo': sum(tempo_data)/len(tempo_data) if tempo_data else 0,
            'avg_rhythm': sum(rhythm_data)/len(rhythm_data) if rhythm_data else 0,
            'current_tempo': self.get_current_tempo(),
            'current_rhythm': self.get_current_rhythm()
        }


