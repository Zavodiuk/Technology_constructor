# ============================================================================
# БАЗОВОЕ ЯДРО BLOCK X (скопировано для автономности)
# ============================================================================

def quantize(value, low=0.3, high=0.7):
    """Квантует значение [0,1] в трит {-1,0,+1}."""
    if value >= high:
        return 1
    if value <= low:
        return -1
    return 0

def normalize_sign(x):
    """Нормализация знака: x>0 → +1, x=0 → 0, x<0 → -1."""
    if x > 0:
        return 1
    if x < 0:
        return -1
    return 0

def ternary_fold(vector):
    """Свёртка вектора тритов в один трит."""
    return normalize_sign(sum(vector))

def ternary_diff(vec_a, vec_b):
    """Поэлементная разность без нормализации (результат [-2..+2])."""
    return tuple(a - b for a, b in zip(vec_a, vec_b))

# ============================================================================
# КЛАССИФИКАЦИЯ ЗАПРОСОВ
# ============================================================================

def classify_query(text):
    """Базовый классификатор запросов (без контекста)."""
    has_subject = any(w in text for w in ['телефон','ноутбук','компьютер','книга','фильм','игра','погода'])
    has_criteria = any(w in text for w in ['камера','цена','память','скорость','качество','звук','экран','батарея'])
    has_constraint = any(w in text for w in ['до','бюджет','хочу','нужен','посоветуй','подбери','выбери'])
    
    coverage = (has_subject + has_criteria + has_constraint) / 3
    l3 = quantize(coverage)
    
    return l3, coverage, has_subject, has_criteria, has_constraint

def enhanced_classify(text, context=None):
    """
    Расширенная классификация с учётом контекста.
    """
    l3, coverage, has_subject, has_criteria, has_constraint = classify_query(text)
    
    # Если есть контекст, добавляем бонус к покрытию
    has_context = context is not None and len(context) > 0
    if has_context:
        # Увеличиваем coverage на 0.1, но не больше 1.0
        coverage = min(coverage + 0.1, 1.0)
        l3 = quantize(coverage)
    
    # Генерируем объяснение
    if l3 == 1:
        explanation = "Ответ полный и непротиворечивый"
    elif l3 == 0:
        explanation = "Ответ неполный или требует уточнения"
    else:
        explanation = "Обнаружено противоречие или недостаточно данных"
    
    return {
        'l3': l3,
        'coverage': round(coverage, 3),
        'explanation': explanation,
        'has_subject': has_subject,
        'has_criteria': has_criteria,
        'has_constraint': has_constraint,
        'has_context': has_context
    }

