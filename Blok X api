@app.route('/classify', methods=['POST'])
def classify_endpoint():
    """
    Классифицирует ответ и возвращает L3-статус.
    
    Пример запроса:
        {
            "text": "Рекомендую Samsung Galaxy S24",
            "context": "покупатель ищет телефон с хорошей камерой"
        }
    
    Пример ответа:
        {
            "status": "success",
            "l3": 1,
            "decision": "PASS",
            "modified_response": "Рекомендую Samsung Galaxy S24",
            "message": "✅ Ответ прошел фильтрацию",
            "explanation": "Ответ полный и непротиворечивый",
            "details": {...},
            "log": {...}
        }
    """
    try:
        data = request.get_json()
        if not data:
            return jsonify({'error': 'Invalid JSON'}), 400
        
        text = data.get('text', '')
        context = data.get('context', None)
        
        if not text:
            return jsonify({'error': 'Поле "text" обязательно'}), 400
        
        logger.info(f"Classifying: {text[:50]}...")
        
        result = enhanced_classify(text, context)
        
        # Принятие решения
        if result['l3'] == 1:
            decision = 'PASS'
            modified = text
            message = '✅ Ответ прошел фильтрацию'
        elif result['l3'] == 0:
            decision = 'CLARIFY'
            modified = f"❓ Уточните: {text}"
            message = '❓ Требуется уточнение'
        else:
            decision = 'REJECT'
            modified = "⚠️ Извините, я не могу ответить на этот запрос"
            message = '⚠️ Ответ отклонён'
        
        response = {
            'status': 'success',
            'l3': result['l3'],
            'decision': decision,
            'modified_response': modified,
            'message': message,
            'explanation': result['explanation'],
            'details': {
                'coverage': result['coverage'],
                'has_subject': result['has_subject'],
                'has_criteria': result['has_criteria'],
                'has_constraint': result['has_constraint'],
                'has_context': result['has_context']
            },
            'log': {
                'stage': 'Block X v6.3',
                'quantize': f"coverage = {result['coverage']:.2f} → L3 = {result['l3']}",
                'decision': decision
            }
        }
        
        logger.info(f"Result: L3={result['l3']}, decision={decision}")
        return jsonify(response)
        
    except Exception as e:
        logger.error(f"Error: {str(e)}")
        return jsonify({'status': 'error', 'error': str(e)}), 500

@app.route('/batch', methods=['POST'])
def batch_endpoint():
    """
    Пакетная классификация нескольких ответов.
    
    Пример запроса:
        {
            "texts": ["Ответ 1", "Ответ 2", "Ответ 3"],
            "context": "контекст"
        }
    """
    try:
        data = request.get_json()
        if not data:
            return jsonify({'error': 'Invalid JSON'}), 400
        
        texts = data.get('texts', [])
        context = data.get('context', None)
        
        if not texts:
            return jsonify({'error': 'Поле "texts" обязательно'}), 400
        
        results = []
        for i, text in enumerate(texts):
            result = enhanced_classify(text, context)
            results.append({
                'index': i,
                'text': text[:100] + '...' if len(text) > 100 else text,
                'l3': result['l3'],
                'explanation': result['explanation']
            })
        
        # Сводка
        summary = {
            'total': len(results),
            'pass': sum(1 for r in results if r['l3'] == 1),
            'clarify': sum(1 for r in results if r['l3'] == 0),
            'reject': sum(1 for r in results if r['l3'] == -1)
        }
        
        return jsonify({
            'status': 'success',
            'summary': summary,
            'results': results
        })
        
    except Exception as e:
        logger.error(f"Batch error: {str(e)}")
        return jsonify({'status': 'error', 'error': str(e)}), 500

