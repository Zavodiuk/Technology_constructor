class TernaryConflictAttractorPoint:
    """Одиночная плавающая точка-вершина с защитой от слияния (проверка forbidden_coords)."""
    def __init__(self, name: str, initial_coords: tuple, field_dims: tuple):
        self.name = name
        self.coords = list(initial_coords)
        self.field_dims = field_dims

    def drift_by_conflict(self, tensor_field: np.ndarray, gradient_fields: list, forbidden_coords: set = None):
        if forbidden_coords is None:
            forbidden_coords = set()
            
        dims = len(self.field_dims)
        best_coords = list(self.coords)
        
        current_pos = tuple(self.coords)
        local_base = abs(int(tensor_field[current_pos]))
        grad_base = sum(abs(gradient_fields[i][current_pos]) for i in range(dims))
        max_tension = float(local_base) + float(grad_base)

        for d in range(dims):
            for delta in [-1, 1]:
                test_coords = list(self.coords)
                test_coords[d] += delta
                
                if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                    test_pos = tuple(test_coords)
                    # Если координата уже занята другой вершиной на текущем такте — пропускаем её (упругий отбор)
                    if test_pos in forbidden_coords:
                        continue
                        
                    local_val = abs(int(tensor_field[test_pos]))
                    grad_val = sum(abs(gradient_fields[i][test_pos]) for i in range(dims))
                    tension = float(local_val) + float(grad_val)

                    if tension > max_tension:
                        max_tension = tension
                        best_coords = test_coords

        self.coords = best_coords


class TernaryDynamicPlaneMembrane:
    """
    Динамическая плоскость-мембрана с упругим разделением вершин и активным демпфированием нуля.
    """
    def __init__(self, field_dims: tuple, p1: tuple, p2: tuple, p3: tuple):
        self.field_dims = field_dims
        self.vertex_a = TernaryConflictAttractorPoint("Vertex-A", p1, field_dims)
        self.vertex_b = TernaryConflictAttractorPoint("Vertex-B", p2, field_dims)
        self.vertex_c = TernaryConflictAttractorPoint("Vertex-C", p3, field_dims)

    def update_membrane_position(self, tensor_field: np.ndarray, gradients: list):
        # Последовательный независимый дрейф с исключением координат других вершин текущего такта
        forbidden_a = {tuple(self.vertex_b.coords), tuple(self.vertex_c.coords)}
        self.vertex_a.drift_by_conflict(tensor_field, gradients, forbidden_a)

        forbidden_b = {tuple(self.vertex_a.coords), tuple(self.vertex_c.coords)}
        self.vertex_b.drift_by_conflict(tensor_field, gradients, forbidden_b)

        forbidden_c = {tuple(self.vertex_a.coords), tuple(self.vertex_b.coords)}
        self.vertex_c.drift_by_conflict(tensor_field, gradients, forbidden_c)

    def get_plane_vertices(self) -> tuple:
        return (tuple(self.vertex_a.coords), tuple(self.vertex_b.coords), tuple(self.vertex_c.coords))

    def apply_membrane_barrier(self, tensor_field: TernaryTensorField, evolution: TernaryTensorEvolution):
        """
        Инжектирует импульсы по вершинам:
        A -> +1 (Активация) с волновым фронтом,
        B -> 0 (Покой) с АКТИВНЫМ ДЕМПФИРОВАНИЕМ (принудительное обнуление шумов в радиусе 1),
        C -> -1 (Блокировка) с волновым фронтом.
        """
        va = tuple(self.vertex_a.coords)
        vb = tuple(self.vertex_b.coords)
        vc = tuple(self.vertex_c.coords)

        # Вершина A: Активный фронт
        tensor_field.inject_quantum_impulse(va, 1)
        evolution.propagate_wave(va, radius=1)

        # Вершина B: Активный гаситель энтропии (демпфирование зоны Покоя)
        tensor_field.inject_quantum_impulse(vb, 0)
        dims = len(tensor_field.dimensions)
        damping_ranges = [range(max(0, vb[d] - 1), min(tensor_field.dimensions[d], vb[d] + 2)) for d in range(dims)]
        for coords in product(*damping_ranges):
            tensor_field.field[coords] = np.int8(0)

        # Вершина C: Блокирующий фронт
        tensor_field.inject_quantum_impulse(vc, -1)
        evolution.propagate_wave(vc, radius=1)


