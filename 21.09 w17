class TernaryUniverseW17_1:
    def __init__(self, dimensions: tuple, node_coords: dict):
        self.dimensions = dimensions
        self.tensor_field = TernaryTensorField(dimensions)
        self.tensor_evolution = TernaryTensorEvolution(self.tensor_field)
        self.graph = TernaryUniverseGraph()
        self.node_coords = node_coords

        mid = dimensions[0] // 2
        max_idx = dimensions[0] - 1
        
        p1 = (mid, mid, mid, mid)
        p2 = (0, max_idx, mid, mid)
        p3 = (max_idx, 0, mid, mid)
        
        self.membrane = TernaryDynamicPlaneMembrane(dimensions, p1, p2, p3)

    def add_node(self, name: str, coords: tuple):
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str):
        self.graph.add_edge(src, tgt)

    def step(self):
        # 1. Шаг микро-динамики графовой сети
        self.graph.pulse()
        
        # 2. Проецирование решений узлов в тензорное поле
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_field.inject_quantum_impulse(coords, impulse_val)
        
        # 3. Распространение волн от узлов
        for name, coords in self.node_coords.items():
            self.tensor_evolution.propagate_wave(coords, radius=1)

        # 4. Анализ градиентов с защитным фолбеком и обновление упругой мембраны
        try:
            gradients = np.gradient(self.tensor_field.field.astype(np.float32))
        except Exception:
            gradients = [np.abs(np.diff(self.tensor_field.field, axis=i, append=0)).astype(np.float32) 
                         for i in range(self.tensor_field.field.ndim)]
        
        self.membrane.update_membrane_position(self.tensor_field.field, gradients)
        self.membrane.apply_membrane_barrier(self.tensor_field, self.tensor_evolution)

        # 5. Обратная связь тензорного поля на каналы графа
        field_divergence = self.tensor_evolution.calculate_field_divergence()
        for edge in self.graph.edges:
            edge.energy_flow = max(0.0, edge.energy_flow * (1.0 - (field_divergence * 0.01)))

    def display_state(self):
        va, vb, vc = self.membrane.get_plane_vertices()
        print(f"\n================ [ ТРОИЧНЫЙ СИНХРО-ТАКТ W17.1: {self.graph.time_step} ] ================")
        print(f"  -> Энтропия тензорного поля: {self.tensor_field.calculate_field_entropy():.4f}")
        print(f"  -> Дивергенция поля: {self.tensor_evolution.calculate_field_divergence():.2f}")
        print(f"  -> Вершины упругой мембраны (сохранен разнос):")
        print(f"     [A/+1]: {va} | [B/0 Демпфер]: {vb} | [C/-1]: {vc}")
        print("--- СОСТОЯНИЕ УЗЛОВ И КАНАЛОВ ---")
        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({TERNARY_CODE[int(node.decision)][:22]}...) | МАССА = {node.mass:.2f}")
        for edge in self.graph.edges:
            print(f"  -> Канал [{edge.source.node_id} -> {edge.target.node_id}]: ПОТОК = {edge.energy_flow:.2f}, ТЕМП = {edge.temp:.2f}")


