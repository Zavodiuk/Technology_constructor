class BXOSHardwareGate:
    def __init__(self, min_confidence: float = 0.4, max_rpm: float = 6500.0, crit_knock: float = 3.5):
        self.min_confidence = min_confidence
        self.max_rpm = max_rpm
        self.crit_knock = crit_knock

    def guard_telemetry(self, raw_telemetry: np.ndarray) -> np.ndarray:
        clean = np.copy(raw_telemetry).astype(np.float64)
        clean[0] = np.clip(clean[0], 0.0, self.max_rpm)
        clean[1] = np.clip(clean[1], 0.0, 100.0)
        clean[2] = np.clip(clean[2], 0.6, 1.4)
        clean[3] = np.clip(clean[3], 0.0, self.crit_knock * 1.5)
        clean[4] = np.clip(clean[4], 0.0, 1.0)
        if clean[4] < self.min_confidence:
            clean[4] = -1.0  
        return clean


class LinuxSocketCANReceiver:
    def __init__(self, channel: str = "can0", min_conf: float = 0.4, max_rpm: float = 6500.0, crit_knock: float = 3.5):
        self.channel = channel
        self.bus = None
        self.gate = BXOSHardwareGate(min_confidence=min_conf, max_rpm=max_rpm, crit_knock=crit_knock)

    def initialize_bus(self) -> bool:
        if can is None:
            return False
        try:
            self.bus = can.interface.Bus(channel=self.channel, bustype="socketcan", receive_own_messages=False)
            return True
        except Exception:
            return False

    def capture_bus_tick(self) -> Optional[np.ndarray]:
        if self.bus is None:
            t = time.time()
            sim_vector = np.array([
                2000.0 + 400.0 * np.sin(t * 0.5),
                25.0 + 5.0 * np.sin(t * 0.3),
                1.0 + 0.02 * np.cos(t * 0.8),
                0.15 + 0.05 * np.sin(t * 2.0),
                0.98 if np.sin(t * 0.1) > -0.9 else 0.3
            ], dtype=np.float64)
            return self.gate.guard_telemetry(sim_vector)
            
        try:
            msg = self.bus.recv(timeout=0.002) # Неблокирующее окно чтения 2мс
            if msg is None:
                return None
            if msg.arbitration_id == 0x100 and len(msg.data) >= 8:
                raw_rpm, raw_tps, raw_knock, raw_lambda = struct.unpack(">HHHH", msg.data[:8])
                raw_vector = np.array([
                    raw_rpm * 0.25,
                    raw_tps * 0.015,
                    raw_lambda * 0.001,
                    raw_knock * 0.001,
                    1.0
                ], dtype=np.float64)
                return self.gate.guard_telemetry(raw_vector)
        except Exception:
            pass
        return None


