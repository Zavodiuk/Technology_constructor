# ШАГ 5: КВАНТОВАТЕЛЬ ОСТАТКА И АРХИВАТОР ZV26 (.zvd)
# =====================================================================

class ZvdAdaptiveResidualEngine:
    def __init__(self, size: int = 256):
        self.size = size

    def compute_residual_and_filter(self, actual: np.ndarray, model: np.ndarray, rhythm: float):
        threshold = 5.0 + rhythm * 55.0
        delta = actual - model
        mask = np.abs(delta) >= threshold
        y, x = np.where(mask)
        return y.astype(np.uint8), x.astype(np.uint8), delta[mask].astype(np.int16)


class ZvdBitstreamManager:
    MAGIC_SIGNATURE = b"ZV26"

    @classmethod
    def pack_log_frame(cls, y: np.ndarray, x: np.ndarray, devs: np.ndarray) -> bytes:
        count = len(y)
        raw = struct.pack(f"=I{count}B{count}B{count}h", count, *y.tolist(), *x.tolist(), *devs.tolist())
        comp = zlib.compress(raw, level=9)
        return cls.MAGIC_SIGNATURE + struct.pack("=I", len(comp)) + comp


