# ШАГ 4: СТРАТЕГИИ ГЁДЕЛЯ/ЛУКАСЕВИЧА И ЭБУ-ДРАЙВЕР (W5.5)
# =====================================================================

class W5AdaptiveProductionPipeline:
    def __init__(self, stress_threshold: float = 0.70):
        self.stress_threshold = stress_threshold

    def process_cycle(self, rpm: float, throttle: float, knock: float, macro_pot: float, max_rpm: float):
        stress = float(np.clip((rpm / max_rpm * 0.4) + (throttle / 100.0 * 0.3) + (knock / 5.0 * 0.3), 0.0, 1.0))
        use_luka = stress >= self.stress_threshold
        strategy = "LUKASIEWICZ_STRONG" if use_luka else "GODEL_KLEENE"
        
        norm_macro_pot = np.clip(macro_pot / 2.0, -1.0, 1.0)
        sensor_signal = np.clip(1.0 - knock / 5.0, -1.0, 1.0)
        
        if use_luka:
            folded = max(-1.0, norm_macro_pot + sensor_signal - 1.0)
            if norm_macro_pot <= 0.0 and sensor_signal <= 0.0:
                folded = -1.0
        else:
            folded = min(norm_macro_pot, sensor_signal)
            
        fuel_trim = -15.0 * abs(folded) if use_luka and folded < 0 else float(np.clip(folded * 3.75, -15.0, 0.0))
        spark_advance = -8.0 * abs(folded) if use_luka and folded < 0 else float(np.clip(folded * 3.25, -8.0, 5.0))
        
        receipt_id = str(uuid.uuid4())
        digest = hashlib.sha256(f"{receipt_id}:{strategy}:{stress:.4f}".encode('utf-8')).hexdigest()
        return {"fuel_trim": fuel_trim, "spark_advance": spark_advance}, {"request_id": receipt_id, "strategy": strategy, "digest": digest}


