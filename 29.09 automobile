class ZavodiukCyberControllerCore:
    """
    Финальный бортовой кибернетический контроллер ДВС Заводюка (100 Гц).
    Интегрирует ядра W5.5, v18_hybrid, W18.1 и W19.2 под Embedded Linux.
    """
    def __init__(self, config: dict, can_channel: str = "can0", target_tick_ms: float = 10.0):
        self.config = config
        self.target_tick_sec = target_tick_ms / 1000.0
        self.is_running = False
        self.safe_mode_active = False

        meta = config["engine_metadata"]
        thresholds = config["sensor_thresholds"]
        calibs = config["ternary_calibrations"]

        self.max_rpm = meta.get("max_rpm", 6500.0)

        self.can_receiver = LinuxSocketCANReceiver(
            channel=can_channel,
            min_conf=thresholds["min_gate_confidence"],
            max_rpm=self.max_rpm,
            crit_knock=thresholds.get("critical_knock_voltage", 3.5)
        )
        
        self.macro_field = TernaryEngineMacroField(
            size=256,
            damping=calibs["wave_damping"],
            c2=calibs["wave_c2_velocity"]
        )
        
        self.membrane = TernaryDynamicPlaneMembrane(
            entropy_chaos_barrier=calibs["entropy_chaos_barrier"]
        )
        
        self.pipeline = W5AdaptiveProductionPipeline(
            stress_threshold=calibs["stress_threshold"]
        )
        
        self.residual_engine = ZvdAdaptiveResidualEngine(size=256)

        self.tick_counter = 0
        self.emergency_triggers = 0
        self.last_receipt = None

    def start_bootstrap(self):
        print(f"[*] Запуск ИИ-контроллера Заводюка V26 (Production) для профиля: {self.config['engine_metadata']['name']}")
        if self.can_receiver.initialize_bus():
            print("[+] CAN-интерфейс инициализирован (SocketCAN).")
        else:
            print("[!] Аппаратный CAN недоступен. Запущен отказоустойчивый симуляционный контур.")

        self.is_running = True
        self.run_main_loop()

    def run_main_loop(self):
        print(f"[+] Тактовый контур реального времени активен (100 Гц, период {self.target_tick_sec*1000:.1f} мс).")
        
        while self.is_running:
            tick_start = time.perf_counter()
            
            try:
                # 1. Захват и фильтрация телеметрии
                raw = self.can_receiver.capture_bus_tick()
                if raw is None or raw[4] < 0.0:
                    raise TimeoutError("Таймаут шины CAN: нет валидного пакета.")

                rpm, throttle, lambda_val, knock, _ = raw

                # 2. Волновой накат на матрице 256x256
                self.macro_field.update_engine_map(rpm, throttle, self.max_rpm)
                self.macro_field.propagate_wave_vectorized()
                macro_pot = self.macro_field.extract_current_state(rpm, throttle, self.max_rpm)

                # 3. Мембрана УОЗ, расчет энтропии log3 и дрейф вершин
                self.membrane.update_membrane_state(knock)
                grad_vector = np.array([rpm, throttle, lambda_val, knock], dtype=np.float64)
                self.membrane.drift_vertices(grad_vector)
                rhythm = float(self.membrane.calculate_shannon_entropy_base3() / 2.0)

                # 4. Оркестратор стресса (Гёдель / Лукасевич) и драйвер ЭБУ
                _, self.last_receipt = self.pipeline.process_cycle(rpm, throttle, knock, macro_pot, self.max_rpm)

                # 5. Квантование остатка и упаковка потока ZV26 (.zvd)
                model_stub = np.full((256, 256), macro_pot, dtype=np.float64)
                y_idx, x_idx, devs = self.residual_engine.compute_residual_and_filter(
                    self.macro_field.field, model_stub, rhythm
                )
                _ = ZvdBitstreamManager.pack_log_frame(y_idx, x_idx, devs)

                if self.safe_mode_active:
                    print("[*] Выход из SAFE_MODE: штатный контур стабилизирован.")
                    self.safe_mode_active = False

                self.tick_counter += 1

            except Exception as e:
                self.safe_mode_active = True
                self.emergency_triggers += 1
                print(f"[!] АВАРИЙНЫЙ СБОЙ КОНТУРА (#{self.emergency_triggers}): {e} -> SAFE_MODE активирован.")

            # Синхронизация тактовой частоты 10 мс
            elapsed = time.perf_counter() - tick_start
            sleep_time = self.target_tick_sec - elapsed
            if sleep_time > 0:
                time.sleep(sleep_time)

    def stop(self):
        self.is_running = False
        print(f"[*] Контроллер остановлен. Всего обработано тактов: {self.tick_counter}.")


def install_as_systemd_service():
    """Автоматическая установка скрипта как systemd сервиса реального времени (RT FIFO)."""
    script_path = os.path.abspath(__file__)
    work_dir = os.path.dirname(script_path)
    service_content = SYSTEMD_SERVICE_TEMPLATE.format(script_path=script_path, work_dir=work_dir)
    service_path = "/etc/systemd/system/cyber-controller.service"
    
    try:
        with open(service_path, "w", encoding="utf-8") as f:
            f.write(service_content)
        print(f"[+] Systemd юнит успешно записан в {service_path}")
        os.system("systemctl daemon-reload")
        os.system("systemctl enable cyber-controller.service")
        print("[+] Сервис зарегистрирован и добавлен в автозагрузку.")
    except Exception as ex:
        print(f"[-] Ошибка установки systemd сервиса (требуются права root): {ex}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--install":
        install_as_systemd_service()
        sys.exit(0)

