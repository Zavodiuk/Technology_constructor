# ШАГ 2: ВЕКТОРИЗОВАННАЯ ВОЛНОВАЯ КАРТА ДВС (v18_hybrid)
# =====================================================================

class TernaryEngineMacroField:
    def __init__(self, size: int = 256, damping: float = 0.98, c2: float = 0.25):
        self.size = size
        self.damping = damping
        self.c2 = c2
        self.field = np.zeros((size, size), dtype=np.float64)
        self.velocity = np.zeros((size, size), dtype=np.float64)
        self.brigella_mask = np.zeros((size, size), dtype=np.float64)
        self.arlecchino_mask = np.zeros((size, size), dtype=np.float64)
        self._init_attractors()

    def _init_attractors(self):
        self.brigella_mask[64:96, 64:96] = 2.0
        self.arlecchino_mask[200:240, 200:240] = -2.0

    def propagate_wave_vectorized(self):
        laplacian = (
            np.roll(self.field, 1, axis=0) +
            np.roll(self.field, -1, axis=0) +
            np.roll(self.field, 1, axis=1) +
            np.roll(self.field, -1, axis=1) -
            4.0 * self.field
        )
        accel = self.c2 * laplacian + self.brigella_mask + self.arlecchino_mask
        self.velocity = self.velocity * self.damping + accel
        self.field += self.velocity
        np.clip(self.field, -2.0, 2.0, out=self.field)

    def update_engine_map(self, rpm: float, load: float, max_rpm: float):
        x = int(np.clip((rpm / max_rpm) * (self.size - 1), 0, self.size - 1))
        y = int(np.clip((load / 100.0) * (self.size - 1), 0, self.size - 1))
        # Насыщение предотвращает числовой взрыв инкремента
        y_min, y_max = max(0, y-4), min(self.size, y+5)
        x_min, x_max = max(0, x-4), min(self.size, x+5)
        self.field[y_min:y_max, x_min:x_max] = np.clip(self.field[y_min:y_max, x_min:x_max] + 1.0, -2.0, 2.0)

    def extract_current_state(self, rpm: float, load: float, max_rpm: float) -> float:
        x = int(np.clip((rpm / max_rpm) * (self.size - 1), 0, self.size - 1))
        y = int(np.clip((load / 100.0) * (self.size - 1), 0, self.size - 1))
        return float(self.field[y, x])


# =====================================================================
# ШАГ 3: МЕМБРАНА ЗАЖИГАНИЯ И ЭНТРОПИЯ ПО БАЗЕ 3 (W18.1 + W19.2)
# =====================================================================

class TernaryDynamicPlaneMembrane:
    def __init__(self, entropy_chaos_barrier: float = 0.35):
        self.field_4d = np.zeros((5, 5, 5, 5), dtype=np.float64)
        self.vertex_a = np.array([4, 4, 4, 4], dtype=int)
        self.vertex_c = np.array([0, 0, 0, 0], dtype=int)
        self.entropy_threshold = entropy_chaos_barrier
        self.chaos_radius = 1

    def _check_forbidden_coords(self, new_pos: np.ndarray, other: np.ndarray) -> bool:
        return not (np.array_equal(new_pos, other) or np.sum(np.abs(new_pos - other)) < 1)

    def drift_vertices(self, grad: np.ndarray):
        step = np.sign(grad[:4]).astype(int)
        cand_a = np.clip(self.vertex_a + step, 0, 4)
        if self._check_forbidden_coords(cand_a, self.vertex_c):
            self.vertex_a = cand_a
        cand_c = np.clip(self.vertex_c - step, 0, 4)
        if self._check_forbidden_coords(cand_c, self.vertex_a):
            self.vertex_c = cand_c

    def calculate_shannon_entropy_base3(self) -> float:
        flat = self.field_4d.flatten()
        total = np.sum(np.abs(flat))
        if total == 0.0:
            return 0.0
        p = np.abs(flat) / total
        p = p[p > 0]
        return float(-np.sum(p * np.log(p) / np.log(3.0)))

    def update_membrane_state(self, knock: float):
        h3 = self.calculate_shannon_entropy_base3()
        self.chaos_radius = 2 if h3 > self.entropy_threshold else 1
        self.field_4d[tuple(self.vertex_a)] += 1.0
        self.field_4d[tuple(self.vertex_c)] -= 1.0
        self.field_4d *= 0.95


