class TacticalCryptoEngine:
    """Military-grade AEAD cryptographic engine ensuring zero-allocation confidentiality."""
    def __init__(self, master_key: Optional[bytes] = None):
        if not HAS_CRYPTO:
            raise RuntimeError("Cryptography package missing.")
        self.key = master_key if master_key is not None else AESGCM.generate_key(bit_length=256)
        self.aesgcm = AESGCM(self.key)
        self._nonce_counter = 0

    def encrypt_payload(self, plaintext: bytes) -> bytes:
        nonce = os.urandom(8) + struct.pack(">I", self._nonce_counter)
        self._nonce_counter += 1
        ciphertext = self.aesgcm.encrypt(nonce, plaintext, associated_data=None)
        return nonce + ciphertext

    def decrypt_payload(self, encrypted_packet: bytes) -> bytes:
        if len(encrypted_packet) < 12:
            raise ValueError("Encrypted packet too short: missing Nonce")
        nonce = encrypted_packet[:12]
        ciphertext = encrypted_packet[12:]
        return self.aesgcm.decrypt(nonce, ciphertext, associated_data=None)


# =====================================================================
# JIT 3-4-5 MATHEMATICAL KERNELS & ZERO-ALLOCATION RASHOMON
# =====================================================================

_JIT_PACK_LUT = np.array([
    [-2, -2, -1, -1],
    [-1,  0,  0,  1],
    [ 0,  1,  2,  2]
], dtype=np.int8)

@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_rashomon_evaluate_zero_alloc(matrix: np.ndarray, out_results: np.ndarray):
    """Zero-Allocation Rashomon Audit Core (Shared between Edge and GCS)."""
    rows = matrix.shape[0]
    cols = matrix.shape[1]
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = matrix[i, 0]
        max_val = matrix[i, 0]
        for j in range(cols):
            val = matrix[i, j]
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val: min_val = val
            if val > max_val: max_val = val
        mean_val = sum_val / cols
        var_sum = 0.0
        for j in range(cols):
            val = matrix[i, j]
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        
        out_results[i, 0] = mean_val
        out_results[i, 1] = min_val
        out_results[i, 2] = max_val
        out_results[i, 3] = std_val
        out_results[i, 4] = -(abs_sum_val / cols)


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_build_all_cubes(st_contiguous: np.ndarray, tiles_y: int, tiles_x: int, out_cubes: np.ndarray):
    """Vectorized parallel cube builder for airborne FPV video stream."""
    num_cubes = tiles_y * tiles_x
    lut = _JIT_PACK_LUT
    for idx in prange(num_cubes):
        ty = idx // tiles_x
        tx = idx % tiles_x
        y0, x0 = ty * 5, tx * 5
        for y in range(5):
            for x in range(5):
                for t in range(5):
                    raw_v = st_contiguous[y0 + y, x0 + x, t]
                    e = abs(raw_v)
                    t0 = 1 if raw_v >= 0.33 else (-1 if raw_v <= -0.33 else 0)
                    q0 = min(3, max(0, int(e * 4.0)))
                    p0 = lut[t0 + 1, q0]
                    
                    out_cubes[idx, y, x, t, 0] = np.uint8(p0 + 2)
                    out_cubes[idx, y, x, t, 1] = np.uint8(p0 + 2)
                    out_cubes[idx, y, x, t, 2] = np.uint8(p0 + 2)
                    out_cubes[idx, y, x, t, 3] = np.uint8(p0 + 2)


# =====================================================================
# PENTARNY RASHOMON ENGINE (ZERO-ALLOCATION WRAPPER)
# =====================================================================

class PentarnyRashomonEngine:
    """Encapsulates zero-allocation buffer and audit evaluation."""
    def __init__(self):
        self._audit_buffer = np.empty((1, 5), dtype=np.float64)

    def evaluate(self, matrix: np.ndarray) -> Dict[str, float]:
        mat = np.asarray(matrix, dtype=np.float64)
        if mat.ndim == 1:
            mat = mat.reshape(1, -1)
        rows, cols = mat.shape
        
        if cols < 5:
            padded = np.zeros((rows, 5), dtype=np.float64)
            padded[:, :cols] = mat
            for c in range(cols, 5):
                padded[:, c] = mat[:, -1]
            mat = padded
        elif cols > 5:
            mat = mat[:, :5]

        if self._audit_buffer.shape[0] != rows:
            self._audit_buffer = np.empty((rows, 5), dtype=np.float64)

        _njit_rashomon_evaluate_zero_alloc(mat, self._audit_buffer)
        
        return {
            "technical": float(self._audit_buffer[0, 0]),
            "operational": float(self._audit_buffer[0, 1]),
            "structural": float(self._audit_buffer[0, 2]),
            "boundary": float(self._audit_buffer[0, 3]),
            "risk": float(self._audit_buffer[0, 4])
        }


# =====================================================================
# DATA STRUCTURES
# =====================================================================

class TetraCube5:
    __slots__ = ("data", "semantic_data")

    def __init__(self, data: Optional[np.ndarray] = None, semantic_data: Optional[np.ndarray] = None) -> None:
        self.data = data if data is not None else np.full((CUBE, CUBE, CUBE, N_FACES), 2, dtype=np.uint8)
        self.semantic_data = semantic_data if semantic_data is not None else np.full((CUBE, CUBE, CUBE, N_FACES), 2, dtype=np.uint8)

    def pack_monolith(self) -> bytes:
        return self.data.reshape(-1).tobytes() + self.semantic_data.reshape(-1).tobytes()

    @classmethod
    def unpack_monolith(cls, raw: bytes) -> "TetraCube5":
        if len(raw) < 1000:
            raise ValueError("Payload too short for TetraCube5 monolith")
        arr_phys = np.frombuffer(raw[:500], dtype=np.uint8).copy().reshape(CUBE, CUBE, CUBE, N_FACES)
        arr_sem = np.frombuffer(raw[500:1000], dtype=np.uint8).reshape(CUBE, CUBE, CUBE, N_FACES)
        return cls(data=arr_phys, semantic_data=arr_sem)


@dataclass
class DroneTelemetry:
    drone_id: int
    roll: float
    pitch: float
    throttle: float
    battery_pct: float
    threat_level: float

    def to_vector(self) -> np.ndarray:
        return np.array([
            self.roll, self.pitch, self.throttle, self.battery_pct, self.threat_level
        ], dtype=np.float64)


@dataclass
class GCSCommand:
    command_id: int  # 1: Waypoint, 2: RTH, 3: Emergency Land, 4: Hold, 5: Edge-Stabilize
    target_param_1: float
    target_param_2: float


