class PentarNode:
    def __init__(self, node_id: str):
        self.node_id = node_id
        self.internal_state = 0
        self.mass = 0.0
        self.decision = 0

    def process_signals(self, sig_a: int, sig_b: int) -> int:
        sig_a = max(-2, min(2, sig_a))
        sig_b = max(-2, min(2, sig_b))
        s_sum = sig_a + sig_b
        conflict = abs(sig_a - sig_b)
        
        if conflict >= 3:
            self.mass = conflict * 2.5
            self.internal_state = 0
        else:
            self.mass = conflict * 0.5
            self.internal_state = max(-2, min(2, s_sum))
        self.decision = self.internal_state
        return self.internal_state


class PentarEdge:
    def __init__(self, source: PentarNode, target: PentarNode):
        self.source = source
        self.target = target
        self.energy_flow = 1.0
        self.temp = 1.0

    def update_dynamics(self):
        dec_sum = self.source.decision + self.target.decision
        mass_sum = self.source.mass + self.target.mass
        old_temp = self.temp
        self.temp = max(0.05, 1.0 + (dec_sum * 0.25) - (mass_sum * 0.2))
        if self.source.decision == -2 or self.target.decision == -2:
            self.energy_flow = 0.0
        else:
            self.energy_flow = (self.temp * 1.5) + (mass_sum * 0.5)


class PentarUniverseGraph:
    def __init__(self):
        self.nodes: Dict[str, PentarNode] = {}
        self.edges: List[PentarEdge] = []
        self.time_step = 0

    def add_node(self, name: str):
        self.nodes[name] = PentarNode(name)

    def add_edge(self, src: str, tgt: str):
        self.edges.append(PentarEdge(self.nodes[src], self.nodes[tgt]))

    def pulse(self):
        self.time_step += 1
        for name, node in self.nodes.items():
            sigs = []
            for edge in self.edges:
                if edge.target == node:
                    sigs.append(quantize_pentarny((edge.energy_flow - 1.5) / 1.5))
                elif edge.source == node:
                    sigs.append(quantize_pentarny(edge.energy_flow / 3.0 - 0.5))
            if not sigs:
                sigs = [random.choice([-2, -1, 0, 1, 2])]
            node.process_signals(int(sigs[0]), int(sigs[-1]))
        for edge in self.edges:
            edge.update_dynamics()


