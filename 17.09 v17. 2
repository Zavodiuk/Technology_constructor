@dataclass
class FacePortState:
    negative_axis: int  # -X, -Y, or -Z
    positive_axis: int  # +X, +Y, or +Z
    permeability: float


class TensorCube5x5x5:
    """
    Кубическая тензорная сетка 5x5x5 (125 элементов).
    Каждый мини-кубик имеет 6 граней-портов по осям X, Y, Z:
      - Ось X: Намерение / Цель (-X / +X)
      - Ось Y: Контекст / Онтология (-Y / +Y)
      - Ось Z: Действие / Результат (-Z / +Z)
    """
    def __init__(self, size: int = 5):
        self.size = size
        self.grid = np.zeros((size, size, size), dtype=int)
        self.permeability_grid = np.ones((size, size, size, 6), dtype=float) # 6 граней: -X, +X, -Y, +Y, -Z, +Z

    def set_cell(self, coords: Tuple[int, int, int], value: int):
        if all(0 <= c < self.size for c in coords):
            self.grid[coords] = max(-2, min(2, value))

    def get_cell(self, coords: Tuple[int, int, int]) -> int:
        if all(0 <= c < self.size for c in coords):
            return int(self.grid[coords])
        return 0

    def get_face_neighbors(self, coords: Tuple[int, int, int]) -> List[Tuple[Tuple[int, int, int], int]]:
        """Возвращает список соседей через 6 граней (индексы 0..5)"""
        x, y, z, = coords
        directions = [
            ((-1, 0, 0), 0), # -X (Intent down)
            ((1, 0, 0), 1),  # +X (Intent up)
            ((0, -1, 0), 2), # -Y (Context down)
            ((0, 1, 0), 3),  # +Y (Context up)
            ((0, 0, -1), 4), # -Z (Action down)
            ((0, 0, 1), 5)   # +Z (Action up)
        ]
        neighbors = []
        for (dx, dy, dz), face_idx in directions:
            nx, ny, nz = x + dx, y + dy, z + dz
            if 0 <= nx < self.size and 0 <= ny < self.size and 0 <= nz < self.size:
                neighbors.append(((nx, ny, nz), face_idx))
        return neighbors

    def propagate_through_faces(self):
        """Распространение сигнала строго через 6 граней соседних мини-кубиков"""
        new_grid = self.grid.copy()
        for x in range(self.size):
            for y in range(self.size):
                for z in range(self.size):
                    current_coords = (x, y, z)
                    current_val = self.grid[current_coords]
                    if current_val == 0:
                        continue
                    
                    neighbors = self.get_face_neighbors(current_coords)
                    for n_coords, face_idx in neighbors:
                        perm = self.permeability_grid[current_coords][face_idx]
                        if perm > 0.1:
                            neighbor_val = self.grid[n_coords]
                            # Импульс затухает или усиливается через грань
                            delta = int(np.sign(current_val) * (1 if abs(current_val) > 1 else 0))
                            propagated = max(-2, min(2, neighbor_val + delta))
                            new_grid[n_coords] = propagated
        self.grid = new_grid

    def calculate_cube_entropy(self) -> float:
        total = self.grid.size
        extremes = np.sum(np.abs(self.grid) >= 2)
        return float(extremes / total)


