# 4. DYNAMIC PLANE MEMBRANE (3 ATTRACTORS IN 3D CUBE)
# ============================================================================

class ConflictAttractorPoint:
    def __init__(self, name: str, initial_coords: Tuple[int, int, int], cube_size: int):
        self.name = name
        self.coords = list(initial_coords)
        self.cube_size = cube_size

    def drift(self, tensor_grid: np.ndarray):
        best = list(self.coords)
        max_tension = -1.0
        for d in range(3):
            for delta in [-1, 1]:
                test_c = list(self.coords)
                test_c[d] += delta
                if all(0 <= test_c[i] < self.cube_size for i in range(3)):
                    tension = abs(tensor_grid[tuple(test_c)])
                    if tension > max_tension:
                        max_tension = tension
                        best = test_c
        self.coords = best


class DynamicPlaneMembrane3D:
    """
    Трехточечная плоскость-мембрана, разрезающая куб 5x5x5 изнутри
    и блокирующая/модифицирующая пропускную способность граней мини-кубиков.
    """
    def __init__(self, cube_size: int = 5):
        self.cube_size = cube_size
        self.v1 = ConflictAttractorPoint("Vertex-A", (0, 0, 2), cube_size)
        self.v2 = ConflictAttractorPoint("Vertex-B", (4, 4, 2), cube_size)
        self.v3 = ConflictAttractorPoint("Vertex-C", (2, 4, 0), cube_size)

    def update_membrane(self, tensor_grid: np.ndarray):
        self.v1.drift(tensor_grid)
        self.v2.drift(tensor_grid)
        self.v3.drift(tensor_grid)

    def apply_barrier_to_cube(self, tensor_cube: TensorCube5x5x5):
        # Вершины мембраны инжектируют крайние состояния в куб
        tensor_cube.set_cell(tuple(self.v1.coords), 2)
        tensor_cube.set_cell(tuple(self.v2.coords), 0)
        tensor_cube.set_cell(tuple(self.v3.coords), -2)

        # Перекрытие граней для ячеек на пути мембраны
        for v in [self.v1.coords, self.v2.coords, self.v3.coords]:
            for face_idx in range(6):
                tensor_cube.permeability_grid[tuple(v)][face_idx] = 0.2 # Замедление потока через барьер


