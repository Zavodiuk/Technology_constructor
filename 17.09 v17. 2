# 5. BXOS GATES & ORCHESTRATOR
# ============================================================================

class GateStatus(Enum):
    READY = "ready_for_simulation"
    LOCKED = "locked_critical"


@dataclass
class GateResult:
    status: GateStatus
    reason: str
    timestamp: float


class BXOSGate:
    def __init__(self, critical_states=(-2, -1)):
        self.critical_states = set(critical_states)
        self.log: List[GateResult] = []

    def check(self, entropy: float, divergence: float) -> GateResult:
        if entropy > 0.6 or divergence > 15.0:
            status = GateStatus.LOCKED
            reason = f"Критическая энтропия ({entropy:.2f}) или дивергенция ({divergence:.2f})"
        else:
            status = GateStatus.READY
            reason = "Контур стабилен, пропуск разрешен"
        res = GateResult(status=status, reason=reason, timestamp=time.time())
        self.log.append(res)
        return res


class FullHarmonyCubePipeline:
    def __init__(self, cube_size: int = 5):
        self.cube_size = cube_size
        self.tensor_cube = TensorCube5x5x5(cube_size)
        self.graph = PentarUniverseGraph()
        self.membrane = DynamicPlaneMembrane3D(cube_size)
        self.gate = BXOSGate()
        self.node_mapping: Dict[str, Tuple[int, int, int]] = {}

    def register_node(self, name: str, coords: Tuple[int, int, int]):
        self.graph.add_node(name)
        self.node_mapping[name] = coords

    def add_edge(self, src: str, tgt: str):
        self.graph.add_edge(src, tgt)

    def step(self) -> Dict[str, Any]:
        # 1. Шаг графа
        self.graph.pulse()

        # 2. Инъекция решений графа в куб 5x5x5 через грани
        for name, coords in self.node_mapping.items():
            node = self.graph.nodes[name]
            self.tensor_cube.set_cell(coords, node.decision)

        # 3. Распространение сигнала через 6 граней-портов кубиков
        self.tensor_cube.propagate_through_faces()

        # 4. Обновление деформирующейся плоскости-мембраны
        self.membrane.update_membrane(self.tensor_cube.grid)
        self.membrane.apply_barrier_to_cube(self.tensor_cube)

        # 5. Проверка гейтом BXOS
        entropy = self.tensor_cube.calculate_cube_entropy()
        divergence = float(np.sum(np.abs(np.gradient(self.tensor_cube.grid.astype(float)))))
        gate_res = self.gate.check(entropy, divergence)

        return {
            'step': self.graph.time_step,
            'entropy': entropy,
            'divergence': divergence,
            'gate': gate_res,
            'membrane_vertices': (self.membrane.v1.coords, self.membrane.v2.coords, self.membrane.v3.coords)
        }


