# 7. EMBEDDED BENCHMARK SUITE
# ============================================================

def run_benchmark():
    print("=" * 70)
    print("HARMONY3 / BXOS — ВСТРОЕННЫЙ ЭНД-ТУ-ЭНД БЕНЧМАРК")
    print("=" * 70)

    N = 5000
    query, interp = "Хочу устройство с высокой защитой", {"Камера": 0.4, "Безопасность": 0.95, "Цена": 0.5}

    print(f"\nЗапуск сквозного прогона пайплайна на {N:,} итераций...")

    pipeline_fast = FullPipeline(use_trait_table=True)
    t0 = time.perf_counter()
    for _ in range(N):
        pipeline_fast.process(query, interp)
    time_fast = time.perf_counter() - t0

    pipeline_slow = FullPipeline(use_trait_table=False)
    t0 = time.perf_counter()
    for _ in range(N):
        pipeline_slow.process(query, interp)
    time_slow = time.perf_counter() - t0

    print(f"\n[Результаты бенчмарка полного пайплайна]:")
    print(f"  С трайт-таблицей:  {time_fast:.4f} сек -> {time_fast/N*1e6:.2f} мкс/вызов")
    print(f"  Без трайт-таблицы: {time_slow:.4f} сек -> {time_slow/N*1e6:.2f} мкс/вызов")
    print(f"  Разница:           {(time_slow/time_fast - 1)*100:+.1f}%")

    # Микробенчмарк свёртки
    N2 = 50,000
    t0 = time.perf_counter()
    for _ in range(N2):
        fold_and_via_trait_table((1, 0, -1))
    t_table = time.perf_counter() - t0

    t0 = time.perf_counter()
    for _ in range(N2):
        fold_and_scalar((1, 0, -1))
    t_scalar = time.perf_counter() - t0

    print(f"\n[Микробенчмарк функции свёртки ({N2:,} вызовов)]:")
    print(f"  Скалярный метод:       {t_scalar*1e6/N2:.3f} мкс/вызов")
    print(f"  Через трайт-таблицу:   {t_table*1e6/N2:.3f} мкс/вызов")
    print(f"  Соотношение (Table/Scalar): {t_table/t_scalar:.2f}x")
    print("\n[Вывод]: Трайт-таблица оптимальна для батчей, скаляр — для одиночных запросов.")
    print("=" * 70)


