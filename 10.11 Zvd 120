    std::vector<uint8_t> encode_optic_burst(std::span<const int8_t, DIM_120> payload_120d) {
        std::array<uint8_t, DIM_120> scratch_bytes{};
        for (int i = 0; i < DIM_120; ++i) {
            int val = payload_120d[i];
            scratch_bytes[i] = static_cast<uint8_t>(std::clamp(val + 2, 0, 4));
        }

        auto checksum = NativeSHA256::hash(scratch_bytes);
        std::vector<uint8_t> packet;
        packet.insert(packet.end(), OPTIC_SYNC_MAGIC_BYTES.begin(), OPTIC_SYNC_MAGIC_BYTES.end());

        uint32_t payload_len = DIM_120;
        const uint8_t* len_ptr = reinterpret_cast<const uint8_t*>(&payload_len);
        packet.insert(packet.end(), len_ptr, len_ptr + 4);
        packet.insert(packet.end(), checksum.begin(), checksum.end());
        packet.insert(packet.end(), scratch_bytes.begin(), scratch_bytes.end());
        return packet;
    }

    std::array<int8_t, DIM_120> decode_optic_burst(std::span<const uint8_t> optic_packet) {
        if (optic_packet.size() < 19 || !std::equal(OPTIC_SYNC_MAGIC_BYTES.begin(), OPTIC_SYNC_MAGIC_BYTES.end(), optic_packet.begin())) {
