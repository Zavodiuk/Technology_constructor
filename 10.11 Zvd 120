        if (!verify_consensus(payload_vector, authority_key)) return false;
        if (current_height >= static_cast<int>(ledger_buffer.size())) {
            ledger_buffer.resize(ledger_buffer.size() * 2);
        }
        for (int i = 0; i < DIM_120; ++i) {
            ledger_buffer[current_height][i] = payload_vector[i % payload_vector.size()];
        }
        current_height++;
        return true;
    }

    std::array<int8_t, DIM_120> synchronize_peers(std::span<const int8_t> peer_matrix_flat, int rows) {
        std::array<int8_t, DIM_120> consensus{};
        for (int c = 0; c < DIM_120; ++c) {
            int total = 0;
            for (int r = 0; r < rows; ++r) {
                total += peer_matrix_flat[r * DIM_120 + c];
            }
            int avg = (rows > 0) ? (total / rows) : 0;
            consensus[c] = static_cast<int8_t>(std::max(-2, std::min(2, avg)));
        }
        return consensus;
    }

    static std::array<double, 5> rashomon_audit(std::span<const double, DIM_120> state_120d) {
        double sum_val = 0.0;
        double abs_sum_val = 0.0;
        double min_val = state_120d[0];
        double max_val = state_120d[0];

        for (int i = 0; i < DIM_120; ++i) {
            double val = state_120d[i];
            sum_val += val;
            abs_sum_val += std::abs(val);
            if (val < min_val) min_val = val;
            if (val > max_val) max_val = val;
        }

        double mean_val = sum_val / DIM_120;
        double var_sum = 0.0;
        for (int i = 0; i < DIM_120; ++i) {
            double diff = state_120d[i] - mean_val;
            var_sum += diff * diff;
        }
        double std_val = std::sqrt(var_sum / DIM_120);
        double risk = -(abs_sum_val / DIM_120) - (std_val * 0.15);

        return {mean_val, min_val, max_val, std_val, risk};
    }
};

