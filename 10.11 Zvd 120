        int v_idx = 0;
        for (int x = 0; x < CUBE; ++x) {
            for (int y = 0; y < CUBE; ++y) {
                for (int z = 0; z < CUBE; ++z) {
                    for (int f = 0; f < N_FACES; ++f) {
                        cube.vertex_data[x][y][z][f] = static_cast<uint8_t>(v04[v_idx++] - 2);
                    }
