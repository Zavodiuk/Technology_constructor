        std::memcpy(&payload_len, optic_packet.data() + 19, 4);

        std::array<uint8_t, 32> checksum;
        std::memcpy(checksum.data(), optic_packet.data() + 23, 32);

        const uint8_t* data_ptr = optic_packet.data() + 55;
        if (optic_packet.size() - 55 != payload_len) {
            throw std::runtime_error("Optical packet framing error: length mismatch.");
        }

        std::span<const uint8_t> data_bytes(data_ptr, payload_len);
        auto calc_checksum = NativeSHA256::hash(data_bytes);
        if (!std::equal(checksum.begin(), checksum.end(), calc_checksum.begin())) {
            throw std::runtime_error("Optical fiber noise corruption detected: SHA-256 checksum mismatch.");
        }

        std::array<int8_t, DIM_120> out_vec{};
        for (int i = 0; i < DIM_120; ++i) {
            out_vec[i] = static_cast<int8_t>(static_cast<int>(data_bytes[i]) - 2);
        }
        return out_vec;
    }
};

