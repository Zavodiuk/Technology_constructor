inline void pack_array_base5(const std::array<uint8_t, 500>& flat_arr, std::array<uint8_t, 167>& out) {
    out.fill(0);
    int idx = 0;
    for (int i = 0; i < 498; i += 3) {
        out[idx] = static_cast<uint8_t>(flat_arr[i] + 5 * flat_arr[i + 1] + 25 * flat_arr[i + 2]);
        idx++;
    }
    out[166] = static_cast<uint8_t>(flat_arr[498] + 5 * flat_arr[499]);
}

inline void unpack_array_base5(const std::array<uint8_t, 167>& packed_bytes, std::array<uint8_t, 500>& out) {
    out.fill(0);
    int idx = 0;
    for (int i = 0; i < 166; ++i) {
        int val = packed_bytes[i];
        out[idx]     = val % 5;
        out[idx + 1] = (val / 5) % 5;
        out[idx + 2] = (val / 25) % 5;
        idx += 3;
    }
    int val = packed_bytes[166];
    out[498] = val % 5;
    out[499] = (val / 5) % 5;
}

alignas(64) class TetraCube120D {
public:
