        for (auto& row : field) {
            for (auto& cell : row) {
                if (cell == -2) {
                    cell = 0;
                    count++;
                }
            }
        }
        return count;
    }
};

class CounterRotatingBiCore120D {
public:
    int size;
    std::array<std::array<int8_t, 5>, 5> matrix_a{};
    std::array<std::array<int8_t, 5>, 5> matrix_b{};
    double angle_a;
    double angle_b;
    double base_velocity;

    CounterRotatingBiCore120D(int sz = 5) : size(sz), angle_a(0.0), angle_b(0.0), base_velocity(M_PI_VAL / 6.0) {
        init_matrices();
    }

    void init_matrices() {
        int mid = size / 2;
        for (int x = 0; x < size; ++x) {
            for (int y = 0; y < size; ++y) {
                if (x == mid && y == mid) {
                    matrix_a[x][y] = 0;
                    matrix_b[x][y] = 0;
                } else if ((x + y) % 2 == 0) {
                    matrix_a[x][y] = 1;
                    matrix_b[x][y] = -1;
                } else {
                    matrix_a[x][y] = -1;
                    matrix_b[x][y] = 1;
                }
            }
        }
    }

    void update_rotation(double entropy) {
        double dynamic_velocity = base_velocity / (1.0 + entropy * 2.0);
        angle_a += dynamic_velocity;
        angle_b -= dynamic_velocity * 1.5;
        if (angle_a >= 2 * M_PI_VAL) angle_a = 0.0;
        if (angle_b <= -2 * M_PI_VAL) angle_b = 0.0;
    }
};

