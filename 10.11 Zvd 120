inline std::array<float, DIM_120> stride_collapse_to_120(std::span<const uint8_t> arr_u8) {
    std::array<float, DIM_120> out{};
    size_t n = arr_u8.size();
    if (n <= DIM_120) {
        for (size_t i = 0; i < n; ++i) {
            out[i % DIM_120] = static_cast<float>(arr_u8[i]);
        }
    } else {
        size_t chunk_size = n / DIM_120;
        for (int i = 0; i < DIM_120; ++i) {
            size_t start = i * chunk_size;
            size_t end = (i == DIM_120 - 1) ? n : (start + chunk_size);
            float s = 0.0f;
            for (size_t j = start; j < end; ++j) {
                s += static_cast<float>(arr_u8[j]);
            }
            out[i] = s / static_cast<float>(end - start);
        }
    }
    return out;
}

inline float enterprise_unified_synthesis_120d(const std::array<float, DIM_120>& collapsed_120, 
                                              double angle_a, double angle_b, 
                                              std::array<int8_t, DIM_120>& out_vector_120d) {
    double cos_a = std::cos(angle_a);
    double sin_a = std::sin(angle_a);
    double cos_b = std::cos(angle_b);
    double sin_b = std::sin(angle_b);

    float total_interference = 0.0f;
    const auto& sin_lut = get_math_lut().sin_lut;

    for (int i = 0; i < DIM_120; ++i) {
        float raw = collapsed_120[i];
        double fx = (i - DIM_120 / 2) * cos_a - (i - DIM_120 / 2) * sin_a;
        double fy = (i - DIM_120 / 2) * sin_b + (i - DIM_120 / 2) * cos_b;
        double moire = std::sin(fx * 0.1 + fy * 0.1 + angle_a - angle_b);
        float val_acc = raw * (1.0f + 0.5f * static_cast<float>(moire));

        long long scaled = std::llround(static_cast<double>(val_acc) * 2.0);
        int clipped = std::max(-2, std::min(2, static_cast<int>(scaled)));
        out_vector_120d[i] = static_cast<int8_t>(clipped);
        total_interference += static_cast<float>(clipped) * sin_lut[i];
    }

    return total_interference;
}

inline int pythagorean_directive_lock(int val) {
    int leg_a = val * 3;
    int leg_b = (std::abs(val) + 1) * 4;
    double hypot_val = std::sqrt(static_cast<double>(leg_a * leg_a + leg_b * leg_b));
    int stepped = static_cast<int>(std::round(hypot_val / 5.0) * 5.0);
    return (val >= 0) ? stepped : -stepped;
}

