    std::array<std::array<std::array<std::array<uint8_t, N_FACES>, CUBE>, CUBE>, CUBE> vertex_data;

    TetraCube120D() {
        fill_tensor(face_data, 2);
        fill_tensor(vertex_data, 2);
    }

    TetraCube120D(const decltype(face_data)& fd, const decltype(vertex_data)& vd) 
        : face_data(fd), vertex_data(vd) {}

    std::array<uint8_t, TOTAL_MONOLITH_SIZE> pack_monolith() const {
        std::array<uint8_t, 500> flat_face{};
        std::array<uint8_t, 500> flat_vertex{};

        int f_idx = 0;
        for (int x = 0; x < CUBE; ++x) {
            for (int y = 0; y < CUBE; ++y) {
                for (int z = 0; z < CUBE; ++z) {
                    for (int f = 0; f < N_FACES; ++f) {
                        if (f_idx < 500) {
                            flat_face[f_idx++] = static_cast<uint8_t>(face_data[x][y][z][f] + 2);
                        }
                    }
                }
            }
        }
        for (int i = f_idx; i < 500; ++i) flat_face[i] = 2;

        int v_idx = 0;
        for (int x = 0; x < CUBE; ++x) {
            for (int y = 0; y < CUBE; ++y) {
                for (int z = 0; z < CUBE; ++z) {
                    for (int f = 0; f < N_FACES; ++f) {
                        if (v_idx < 500) {
                            flat_vertex[v_idx++] = static_cast<uint8_t>(vertex_data[x][y][z][f] + 2);
                        }
                    }
                }
            }
        }
        for (int i = v_idx; i < 500; ++i) flat_vertex[i] = 2;

        std::array<uint8_t, 167> packed_f{};
        std::array<uint8_t, 167> packed_v{};
        pack_array_base5(flat_face, packed_f);
        pack_array_base5(flat_vertex, packed_v);

        std::array<uint8_t, TOTAL_MONOLITH_SIZE> monolith{};
        std::memcpy(monolith.data(), packed_f.data(), FACE_LAYER_BYTES);
        std::memcpy(monolith.data() + FACE_LAYER_BYTES, packed_v.data(), VERTEX_LAYER_BYTES);
        return monolith;
    }

    static TetraCube120D unpack_monolith(std::span<const uint8_t, TOTAL_MONOLITH_SIZE> raw) {
        std::array<uint8_t, 167> pf{};
        std::array<uint8_t, 167> pv{};
        std::memcpy(pf.data(), raw.data(), FACE_LAYER_BYTES);
        std::memcpy(pv.data(), raw.data() + FACE_LAYER_BYTES, VERTEX_LAYER_BYTES);

        std::array<uint8_t, 500> f04{};
        std::array<uint8_t, 500> v04{};
        unpack_array_base5(pf, f04);
        unpack_array_base5(pv, v04);

        TetraCube120D cube;
        int f_idx = 0;
        for (int x = 0; x < CUBE; ++x) {
            for (int y = 0; y < CUBE; ++y) {
                for (int z = 0; z < CUBE; ++z) {
                    for (int f = 0; f < N_FACES; ++f) {
                        cube.face_data[x][y][z][f] = static_cast<uint8_t>(f04[f_idx++] - 2);
                    }
                }
