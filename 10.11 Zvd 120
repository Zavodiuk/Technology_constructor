// Module 5: ZVD-Aero-Translator (Float32 Quantization Kernel)
class ZVDAeroTranslator {
public:
    alignas(64) std::array<int8_t, DIM_120> scratch_120d{};

    std::span<const int8_t, DIM_120> translate_tensor(std::span<const float> float_weights) {
        size_t n = float_weights.size();
        for (int i = 0; i < DIM_120; ++i) {
            float val_sum = 0.0f;
            size_t chunk_size = std::max(size_t(1), n / DIM_120);
            size_t start_idx = i * chunk_size;
            size_t end_idx = std::min(n, start_idx + chunk_size);

            for (size_t j = start_idx; j < end_idx; ++j) {
                val_sum += float_weights[j];
            }
            float mean_val = val_sum / static_cast<float>(end_idx - start_idx + 1e-6f);
            long long scaled = std::llround(static_cast<double>(mean_val) * 2.0);
            scratch_120d[i] = static_cast<int8_t>(std::max(-2, std::min(2, static_cast<int>(scaled))));
        }
        return std::span<const int8_t, DIM_120>(scratch_120d.data(), DIM_120);
    }
};

