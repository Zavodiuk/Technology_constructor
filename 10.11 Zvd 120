    static bool verify_consensus(std::span<const int8_t> block_vector, std::span<const int8_t> auth_key) {
        if (block_vector.empty() || auth_key.empty()) return false;
        long long accumulated = 0;
        for (int i = 0; i < DIM_120; ++i) {
            long long b_val = block_vector[i % block_vector.size()];
            long long k_val = auth_key[i % auth_key.size()];
            accumulated += b_val * k_val;
