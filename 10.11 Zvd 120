class Polymorphic120DEngine {
public:
    int arch_target;
    alignas(64) std::array<std::array<int8_t, DIM_120>, DIM_120> polymorphic_lut{};
    alignas(64) std::array<int8_t, DIM_120> out_scratch_1d{};

    Polymorphic120DEngine(int target = 0) : arch_target(target) {}

    void generate_lut(std::span<const int8_t> seed_120d) {
        size_t n = seed_120d.size();
        for (int i = 0; i < DIM_120; ++i) {
            for (int j = 0; j < DIM_120; ++j) {
                int seed_val = seed_120d[i % n];
                int mod_factor = (i + j + arch_target + seed_val) % 5 - 2;
                polymorphic_lut[i][j] = static_cast<int8_t>(mod_factor);
            }
        }
    }

    std::span<const int8_t> mutate_and_transform(std::span<const int8_t> basis_120d, std::span<const int8_t> raw_payload) {
        generate_lut(basis_120d);
        size_t rows = raw_payload.size();
        for (size_t i = 0; i < DIM_120 && i < rows; ++i) {
            int acc = 0;
            for (int k = 0; k < DIM_120; ++k) {
                acc += raw_payload[i] * polymorphic_lut[k][i % DIM_120];
            }
            out_scratch_1d[i] = static_cast<int8_t>(std::max(-2, std::min(2, acc / DIM_120)));
        }
        return std::span<const int8_t>(out_scratch_1d.data(), DIM_120);
    }
};

