class TetrahedralVertex:
    def __init__(self, name: str, initial_coords: Tuple[int, ...], field_dims: Tuple[int, ...]):
        self.name = name
        self.coords = list(initial_coords)
        self.field_dims = field_dims

    def drift(self, tensor_field: np.ndarray, gradient_fields: List[np.ndarray], forbidden_coords: set = None) -> None:
        if forbidden_coords is None:
            forbidden_coords = set()

        dims = len(self.field_dims)
        best_coords = list(self.coords)
        
        current_pos = tuple(self.coords)
        local_base = abs(int(tensor_field[current_pos]))
        grad_base = sum(abs(gradient_fields[i][current_pos]) for i in range(dims))
        max_tension = float(local_base) + float(grad_base)

        for d in range(dims):
            for delta in [-1, 1]:
                test_coords = list(self.coords)
                test_coords[d] += delta
                
                if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                    test_pos = tuple(test_coords)
                    if test_pos in forbidden_coords:
                        continue

                    local_val = abs(int(tensor_field[test_pos]))
                    grad_val = sum(abs(gradient_fields[i][test_pos]) for i in range(dims))
                    tension = float(local_val) + float(grad_val)

                    if tension > max_tension:
                        max_tension = tension
                        best_coords = test_coords

        self.coords = best_coords


class TetrahedralConfinedCapsule:
    """
    Сбалансированная объемная тетраэдральная капсула с троичным разделением зарядов 
    и прецизионным Манхэттенским фильтром конфайнмента.
    """
    def __init__(self, field_dims: Tuple[int, ...], p1: tuple, p2: tuple, p3: tuple, p4: tuple):
        self.field_dims = field_dims
        self.v_alpha = TetrahedralVertex("Alpha", p1, field_dims)
        self.v_beta = TetrahedralVertex("Beta", p2, field_dims)
        self.v_gamma = TetrahedralVertex("Gamma", p3, field_dims)
        self.v_delta = TetrahedralVertex("Delta", p4, field_dims)

    def evolve_capsule(self, tensor_field: np.ndarray, gradients: List[np.ndarray]) -> None:
        fa = {tuple(self.v_beta.coords), tuple(self.v_gamma.coords), tuple(self.v_delta.coords)}
        self.v_alpha.drift(tensor_field, gradients, fa)

        fb = {tuple(self.v_alpha.coords), tuple(self.v_gamma.coords), tuple(self.v_delta.coords)}
        self.v_beta.drift(tensor_field, gradients, fb)

        fg = {tuple(self.v_alpha.coords), tuple(self.v_beta.coords), tuple(self.v_delta.coords)}
        self.v_gamma.drift(tensor_field, gradients, fg)

        fd = {tuple(self.v_alpha.coords), tuple(self.v_beta.coords), tuple(self.v_gamma.coords)}
        self.v_delta.drift(tensor_field, gradients, fd)

    def get_vertices(self) -> Tuple[tuple, tuple, tuple, tuple]:
        return (
            tuple(self.v_alpha.coords), 
            tuple(self.v_beta.coords), 
            tuple(self.v_gamma.coords), 
            tuple(self.v_delta.coords)
        )

    def enforce_containment(self, tensor_field: TernaryTensorField, evolution: TernaryTensorEvolution, graph: TernaryUniverseGraph, node_coords: Dict[str, Tuple[int, ...]], dynamic_radius: int = 1) -> None:
        va = tuple(self.v_alpha.coords)
        vb = tuple(self.v_beta.coords)
        vc = tuple(self.v_gamma.coords)
        vd = tuple(self.v_delta.coords)

        # 1. Троичный сбалансированный волновой запуск (Защита от энтропийного взрыва)
        tensor_field.inject_quantum_impulse(va, 1)    # Alpha: +1
        tensor_field.inject_quantum_impulse(vb, 1)    # Beta:  +1
        tensor_field.inject_quantum_impulse(vc, -1)   # Gamma: -1

        evolution.propagate_wave(va, radius=dynamic_radius)
        evolution.propagate_wave(vb, radius=dynamic_radius)
        evolution.propagate_wave(vc, radius=dynamic_radius)

        # Delta работает как объемный демпфер (0) — принудительное вырезание хаоса вокруг себя
        tensor_field.inject_quantum_impulse(vd, 0)
        dims = len(tensor_field.dimensions)
        damping_ranges = [range(max(0, vd[d] - dynamic_radius), min(tensor_field.dimensions[d], vd[d] + dynamic_radius + 1)) for d in range(dims)]
        for coords in product(*damping_ranges):
            tensor_field.field[coords] = np.int8(0)

        # 2. Прецизионная Манхэттенская проверка конфайнмента (Bounding Box + Distance Filter)
        all_vertices = np.array([va, vb, vc, vd])
        min_b = np.min(all_vertices, axis=0)
        max_b = np.max(all_vertices, axis=0)

        for name, node in graph.nodes.items():
            if name in node_coords:
                n_coords = np.array(node_coords[name])
                # Геометрический барьер: проверяем попадание в габариты
                in_box = np.all(n_coords >= min_b) and np.all(n_coords <= max_b)
                
                # Физический барьер: среднее Манхэттенское расстояние до вершин тетраэдра
                avg_dist = np.mean([sum(abs(n_coords[d] - v[d]) for d in range(dims)) for v in all_vertices])
                
                # Узел капсулируется строго при пересечении энергетических полей граней
                if in_box and avg_dist <= (dynamic_radius * 2.2):
                    node.isolated = True
                else:
                    node.isolated = False


