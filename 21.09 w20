class TernaryTensorField:
    def __init__(self, dimensions: Tuple[int, ...]):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=np.int8)  # [] — адресная сетка

    def inject_quantum_impulse(self, coordinates: Tuple[int, ...], value: int) -> None:
        clipped = ternary_clip(value)
        if all(0 <= coordinates[i] < self.dimensions[i] for i in range(len(self.dimensions))):
            self.field[coordinates] = clipped

    def calculate_field_entropy(self) -> float:
        total_elements = self.field.size
        if total_elements == 0:
            return 0.0
        counts = Counter(int(x) for x in self.field.flatten())
        entropy = 0.0
        for count in counts.values():
            p = count / total_elements
            if p > 0:
                entropy -= p * math.log(p, 3)
        return float(entropy)

    def evaluate_metric_tensor(self) -> float:
        extreme_states = np.sum(np.abs(self.field) == 1)
        return float(extreme_states / self.field.size)


class TernaryTensorEvolution:
    def __init__(self, tensor_field: TernaryTensorField):
        self.field = tensor_field
        self.step_counter = 0

    def propagate_wave(self, origin: Tuple[int, ...], radius: int = 1) -> None:
        dims = len(origin)
        self.step_counter += 1
        ranges = [range(max(0, origin[d] - radius), 
                       min(self.field.dimensions[d], origin[d] + radius + 1)) 
                  for d in range(dims)]
        for coords in product(*ranges):
            dist = sum(abs(coords[d] - origin[d]) for d in range(dims))
            if 0 < dist <= radius:
                orig_val = int(self.field.field[origin])
                float_val = float(orig_val) / (dist + 1)
                impulse_value = int(float_val)
                if impulse_value != 0:
                    current = int(self.field.field[coords])
                    self.field.field[coords] = ternary_clip(current + impulse_value)

    def calculate_field_gradient(self) -> List[np.ndarray]:
        try:
            return list(np.gradient(self.field.field.astype(np.float32)))
        except Exception:
            return [np.abs(np.diff(self.field.field, axis=i, append=0)).astype(np.float32) 
                    for i in range(self.field.field.ndim)]

    def calculate_field_divergence(self) -> float:
        try:
            gradient = self.calculate_field_gradient()
            return float(np.sum([np.sum(np.abs(g)) for g in gradient]))
        except Exception:
            diffs = [np.sum(np.abs(np.diff(self.field.field, axis=i))) for i in range(self.field.field.ndim)]
            return float(np.sum(diffs))


