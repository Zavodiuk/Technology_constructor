<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>Радио-спутниковая передача (v6)</title>
    <style>
        body {
            margin: 0;
            background: #0B0D11;
            color: #EAE8E3;
            font-family: 'Manrope', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
        }
        canvas {
            display: block;
            background: #0F121A;
            border-radius: 16px;
            box-shadow: 0 0 60px rgba(0,0,0,0.9);
            width: 95vmin;
            height: 95vmin;
        }
        .info {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #1C1F26;
            border: 1px solid #2C3038;
            padding: 8px 18px;
            border-radius: 40px;
            font-size: 13px;
            color: #8A8F99;
            text-align: center;
            pointer-events: none;
            user-select: none;
            font-family: 'Manrope', sans-serif;
            white-space: nowrap;
        }
        .info strong { color: #FBBF24; }
        .l3-status {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #1C1F26;
            border: 1px solid #2C3038;
            padding: 10px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-family: 'IBM Plex Mono', monospace;
            text-align: center;
        }
        .l3-status .tag {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 20px;
            font-weight: 600;
            margin-top: 4px;
        }
        .tag.plus { background: rgba(74,222,128,.2); color: #4ADE80; }
        .tag.zero { background: rgba(251,191,36,.2); color: #FBBF24; }
        .tag.minus { background: rgba(248,113,113,.2); color: #F87171; }
        .controls {
            position: fixed;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
            background: #1C1F26;
            padding: 10px 16px;
            border-radius: 40px;
            border: 1px solid #2C3038;
        }
        .controls button {
            background: #2C3038;
            border: none;
            color: #EAE8E3;
            padding: 6px 16px;
            border-radius: 20px;
            font-family: 'Manrope', sans-serif;
            font-size: 13px;
            cursor: pointer;
            transition: background .2s;
        }
        .controls button:hover { background: #3A3F4A; }
        .controls button.active { background: #4ADE80; color: #0B1410; }
    </style>
</head>
<body>

<canvas id="canvas"></canvas>

<div class="l3-status" id="l3Status">
    L3 · передача
    <div class="tag zero" id="l3Tag">0 · ожидание</div>
</div>

<div class="controls">
    <button id="sendBtn">🚀 Передать сигнал</button>
    <button id="resetBtn">↺ Сброс</button>
</div>

<div class="info">
    🛰️ <strong>Троичная передача</strong> · Земля → Спутник · сигнал кодируется в <strong>-1, 0, +1</strong>
</div>

<script>
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const l3Tag = document.getElementById('l3Tag');

    // Размер
    const size = Math.min(window.innerWidth * 0.93, window.innerHeight * 0.85, 800);
    canvas.width = size;
    canvas.height = size;
    const cx = size / 2;
    const cy = size / 2;
    const R = size * 0.32;

    // Состояние
    let phase = 0; // 0 = idle, 1 = sending, 2 = received
    let progress = 0;
    let l3 = 0;
    let animationId = null;
    let packetData = [];

    // Кодирование троичного сигнала
    const tritSymbols = ['−1', '0', '+1'];
    const tritColors = ['#F87171', '#FBBF24', '#4ADE80'];

    function generatePacket() {
        const length = 5 + Math.floor(Math.random() * 6);
        return Array.from({ length }, () => Math.floor(Math.random() * 3) - 1);
    }

    function resetSimulation() {
        phase = 0;
        progress = 0;
        l3 = 0;
        packetData = generatePacket();
        updateL3Status(0);
        if (animationId) cancelAnimationFrame(animationId);
        draw();
    }

    function updateL3Status(value) {
        const tag = l3Tag;
        if (value === 1) {
            tag.className = 'tag plus';
            tag.textContent = '+1 · сигнал получен';
        } else if (value === -1) {
            tag.className = 'tag minus';
            tag.textContent = '-1 · ошибка передачи';
        } else {
            tag.className = 'tag zero';
            tag.textContent = '0 · ожидание';
        }
        l3 = value;
    }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Звёздный фон
        for (let i = 0; i < 80; i++) {
            ctx.fillStyle = `rgba(255,255,255,${0.2 + Math.random() * 0.5})`;
            ctx.beginPath();
            ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, 0.5 + Math.random() * 1.5, 0, 2 * Math.PI);
            ctx.fill();
        }

        // Орбита спутника (эллипс)
        ctx.strokeStyle = '#1C1F26';
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 8]);
        ctx.beginPath();
        ctx.ellipse(cx, cy, R * 1.4, R * 1.0, 0, 0, 2 * Math.PI);
        ctx.stroke();
        ctx.setLineDash([]);

        // Земля
        const earthR = R * 0.35;
        const grad = ctx.createRadialGradient(cx - earthR * 0.2, cy - earthR * 0.2, 0, cx, cy, earthR);
        grad.addColorStop(0, '#2D6A4F');
        grad.addColorStop(0.5, '#1B4332');
        grad.addColorStop(1, '#0D1F1A');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(cx, cy, earthR, 0, 2 * Math.PI);
        ctx.fill();

        // Континенты (просто узоры)
        ctx.fillStyle = 'rgba(74,222,128,0.08)';
        for (let i = 0; i < 5; i++) {
            const a = i * 1.2 + 0.3;
            const rx = earthR * (0.3 + Math.random() * 0.4);
            const ry = earthR * (0.2 + Math.random() * 0.3);
            ctx.beginPath();
            ctx.ellipse(cx + Math.cos(a) * earthR * 0.3, cy + Math.sin(a) * earthR * 0.3, rx, ry, 0, 0, 2 * Math.PI);
            ctx.fill();
        }

        // Атмосфера
        ctx.strokeStyle = 'rgba(74,222,128,0.1)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(cx, cy, earthR * 1.04, 0, 2 * Math.PI);
        ctx.stroke();

        // Спутник (на орбите)
        const angle = performance.now() / 3000;
        const satX = cx + Math.cos(angle) * R * 1.4;
        const satY = cy + Math.sin(angle) * R * 1.0;

        // Солнечные панели
        ctx.fillStyle = '#2C3038';
        ctx.fillRect(satX - 12, satY - 2, 24, 4);
        ctx.fillRect(satX - 2, satY - 12, 4, 24);
        ctx.fillStyle = '#4A4F5A';
        ctx.fillRect(satX - 8, satY - 4, 16, 2);
        ctx.fillRect(satX - 4, satY - 8, 2, 16);

        // Корпус спутника
        ctx.fillStyle = '#8A8F99';
        ctx.beginPath();
        ctx.arc(satX, satY, 5, 0, 2 * Math.PI);
        ctx.fill();
        ctx.fillStyle = '#EAE8E3';
        ctx.beginPath();
        ctx.arc(satX, satY, 3, 0, 2 * Math.PI);
        ctx.fill();

        // Подпись спутника
        ctx.fillStyle = '#8A8F99';
        ctx.font = '9px Manrope, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Спутник', satX, satY + 20);

        // ---- ПЕРЕДАЧА СИГНАЛА ----
        if (phase === 1 || phase === 2) {
            const startX = cx + Math.cos(angle) * earthR * 0.9;
            const startY = cy + Math.sin(angle) * earthR * 0.9;

            const progressFactor = Math.min(progress, 1);
            const midX = (startX + satX) / 2 + (Math.random() - 0.5) * 50 * (1 - progressFactor);
            const midY = (startY + satY) / 2 - 50 * (1 - progressFactor) * 0.8;

            const tx = (1 - progressFactor) * (1 - progressFactor) * startX + 2 * (1 - progressFactor) * progressFactor * midX + progressFactor * progressFactor * satX;
            const ty = (1 - progressFactor) * (1 - progressFactor) * startY + 2 * (1 - progressFactor) * progressFactor * midY + progressFactor * progressFactor * satY;

            // Гиперболическая траектория
            ctx.strokeStyle = 'rgba(251,191,36,0.2)';
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 8]);
            ctx.beginPath();
            ctx.moveTo(startX, startY);
            ctx.quadraticCurveTo(midX, midY, satX, satY);
            ctx.stroke();
            ctx.setLineDash([]);

            // Пакет данных
            const packetSize = 4;
            for (let i = 0; i < packetData.length && i < 8; i++) {
                const p = packetData[i] || 0;
                const offset = i * 6 - (packetData.length * 3);
                const px = tx + Math.cos(progress * 10 + i * 2) * 6 + offset * 1.2;
                const py = ty + Math.sin(progress * 10 + i * 2) * 6 - 10 + i * 2;
                ctx.fillStyle = tritColors[p + 1] || '#8A8F99';
                ctx.shadowColor = tritColors[p + 1] || '#8A8F99';
                ctx.shadowBlur = 8;
                ctx.beginPath();
                ctx.arc(px, py, 3, 0, 2 * Math.PI);
                ctx.fill();
                ctx.shadowBlur = 0;
                ctx.fillStyle = '#EAE8E3';
                ctx.font = '6px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(tritSymbols[p + 1] || '0', px, py - 6);
            }

            // Обновление L3
            if (phase === 2) {
                updateL3Status(1);
            } else if (progress > 0.5 && Math.random() < 0.01) {
                // редкая ошибка
                updateL3Status(-1);
            }
        }

        // Антенна на Земле
        ctx.strokeStyle = '#8A8F99';
        ctx.lineWidth = 1.5;
        const antX = cx - earthR * 0.35;
        const antY = cy + earthR * 0.3;
        ctx.beginPath();
        ctx.moveTo(antX, antY);
        ctx.lineTo(antX - 12, antY - 18);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(antX, antY);
        ctx.lineTo(antX + 12, antY - 18);
        ctx.stroke();
        ctx.fillStyle = '#8A8F99';
        ctx.beginPath();
        ctx.arc(antX, antY, 2, 0, 2 * Math.PI);
        ctx.fill();

        // L3-индикатор на Земле
        const l3Color = l3 === 1 ? '#4ADE80' : l3 === -1 ? '#F87171' : '#FBBF24';
        ctx.fillStyle = l3Color;
        ctx.shadowColor = l3Color;
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.arc(antX, antY - 24, 4, 0, 2 * Math.PI);
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#EAE8E3';
        ctx.font = '7px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(l3 === 1 ? '+1' : l3 === -1 ? '-1' : '0', antX, antY - 32);

        if (phase === 0) {
            ctx.fillStyle = '#8A8F99';
            ctx.font = '12px Manrope, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Нажмите «Передать сигнал»', cx, cy + R + 50);
        }

        if (phase === 2) {
            ctx.fillStyle = '#4ADE80';
            ctx.font = '14px Manrope, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('✅ Сигнал получен', cx, cy + R + 50);
        }
    }

    function animate() {
        if (phase === 1) {
            progress += 0.008;
            if (progress >= 1) {
                progress = 1;
                phase = 2;
                updateL3Status(1);
            }
        }
        draw();
        animationId = requestAnimationFrame(animate);
    }

    function startTransmission() {
        if (phase === 1) return;
        resetSimulation();
        packetData = generatePacket();
        phase = 1;
        progress = 0;
        updateL3Status(0);
        if (animationId) cancelAnimationFrame(animationId);
        animate();
    }

    // Кнопки
    document.getElementById('sendBtn').addEventListener('click', startTransmission);
    document.getElementById('resetBtn').addEventListener('click', () => {
        resetSimulation();
        draw();
    });

    // Инициализация
    resetSimulation();
    draw();

    // Автопередача при загрузке
    setTimeout(() => {
        startTransmission();
    }, 500);

    // Адаптация размера
    window.addEventListener('resize', () => {
        const newSize = Math.min(window.innerWidth * 0.93, window.innerHeight * 0.85, 800);
        canvas.width = newSize;
        canvas.height = newSize;
        // Обновляем центр и радиус
        // Просто перерисовываем с новыми размерами
        draw();
    });

    // Перерисовка при изменении размера окна
    window.addEventListener('resize', () => {
        const newSize = Math.min(window.innerWidth * 0.93, window.innerHeight * 0.85, 800);
        canvas.width = newSize;
        canvas.height = newSize;
        draw();
    });
</script>
</body>
</html>
