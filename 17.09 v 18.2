# МОДУЛЬ 4: УНИВЕРСАЛЬНОЕ КУБИЧЕСКОЕ ЯДРО СИНТЕЗА V18.2
# ============================================================================
class PentarnyUniverseV18Cube:
    def __init__(self, node_coords: dict, cube_size: int = 5):
        self.cube_size = cube_size
        self.tensor_cube = TensorCube5x5x5(cube_size)
        self.graph = PentarUniverseGraph()
        self.node_coords = node_coords

        mid = cube_size // 2
        max_idx = cube_size - 1
        p1 = (mid, mid, mid)
        p2 = (0, max_idx, mid)
        p3 = (max_idx, 0, mid)
        
        self.membrane = DynamicPlaneMembrane3D(cube_size, p1, p2, p3)

    def add_node(self, name: str, coords: tuple):
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str):
        self.graph.add_edge(src, tgt)

    def step(self):
        current_entropy = self.tensor_cube.calculate_field_entropy()
        
        self.graph.pulse()
        
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_cube.inject_quantum_impulse(coords, impulse_val)
        
        self.tensor_cube.propagate_through_faces()

        gradients = np.gradient(self.tensor_cube.field.astype(float))
        self.membrane.update_membrane_position(self.tensor_cube.field, gradients)
        self.membrane.apply_membrane_barrier(self.tensor_cube)

        field_divergence = float(np.sum([np.sum(np.abs(g)) for g in gradients]))
        for edge in self.graph.edges:
            edge.energy_flow = max(0.0, edge.energy_flow * (1.0 - (field_divergence * 0.01)))

    def display_state(self):
        va, vb, vc = self.membrane.get_plane_vertices()
        gradients = np.gradient(self.tensor_cube.field.astype(float))
        field_divergence = float(np.sum([np.sum(np.abs(g)) for g in gradients]))
        
        print(f"\n================ [ СИНХРО-ТАКТ V18.2: {self.graph.time_step} ] ================")
        print(f"  -> Энтропия тензорного куба: {self.tensor_cube.calculate_field_entropy():.4f}")
        print(f"  -> Дивергенция через грани : {field_divergence:.2f}")
        print(f"  -> Мембранный треугольник [A, B, C]: {va} | {vb} | {vc}")
        print("--- СОСТОЯНИЕ УЗЛОВ И КАНАЛОВ ---")
        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({PENTAR_CODE[node.decision][:20]}...)")


