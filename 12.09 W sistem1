# ==============================================================================
# 1. ПЕРЕХОДНЫЕ ИНТЕРФЕЙСНЫЕ МОДУЛИ (SIGNAL CONVERTERS)
# ==============================================================================

def interface_continuous_to_ternary(top_scores: np.ndarray, margins: np.ndarray, 
                                    min_score: float, threshold: float, 
                                    out_buffer: np.ndarray) -> None:
    """
    ПЕРЕХОДНЫЙ МОДУЛЬ 1: Трансляция непрерывного хаоса оценок в троичные триты.
    Записывает результат напрямую в заранее выделенный буфер памяти (out_buffer).
    """
    np.where(margins >= threshold, np.int8(1), np.int8(0), out=out_buffer[:, 0])
    np.where(top_scores < min_score, np.int8(-1), out_buffer[:, 0], out=out_buffer[:, 0])
    np.where(top_scores > 0.5, np.int8(1), np.int8(0), out=out_buffer[:, 1])
    np.where(top_scores > 0.7, np.int8(1), 
             np.where(top_scores >= 0.4, np.int8(0), np.int8(-1)), out=out_buffer[:, 2])


def interface_ternary_to_pentary(parallel_logic_tensor: np.ndarray, out_buffer: np.ndarray) -> None:
    """
    ПЕРЕХОДНЫЙ МОДУЛЬ 2: Из троичного пространства {-1, 0, 1} в пентарное {-2, -1, 0, 1, 2}.
    Масштабирует силу сигнала трех параллельных логик одновременно без аллокаций.
    """
    res = np.select(
        condlist=[
            parallel_logic_tensor == 1,
            parallel_logic_tensor == 0,
            parallel_logic_tensor == -1
        ],
        choicelist=[np.int8(2), np.int8(1), np.int8(-1)],
        default=np.int8(0)
    ).astype(np.int8)
    np.copyto(out_buffer, res)


def compute_supreme_consensus(pentary_tensor: np.ndarray) -> np.ndarray:
    """
    МОДУЛЬ КОНСЕНСУСА АНСАМБЛЯ: Вычисляет интегральный консенсус трех логик 
    (Лукасевич, Гёдель, Клини) через единогласие и мажоритарную медиану.
    """
    unanimity_mask = (pentary_tensor[:, 0] == pentary_tensor[:, 1]) & (pentary_tensor[:, 1] == pentary_tensor[:, 2])
    majority_vote = np.median(pentary_tensor, axis=1).astype(np.int8)
    return np.where(unanimity_mask, pentary_tensor[:, 0], majority_vote)


def interface_pentary_to_topology(l5_initial: np.ndarray, supreme_verdict: np.ndarray, 
                                  final_execution_mask: np.ndarray) -> np.ndarray:
    """
    ПЕРЕХОДНЫЙ МОДУЛЬ 3: Матричный проектор (Геометрический конфигуратор).
    Строит живую топологию связей 5х5 на основе вердикта ансамбля и маски гейтов.
    """
    l5_trits = np.where(l5_initial > 0, np.int8(1), np.where(l5_initial < 0, np.int8(-1), np.int8(0)))
    
    identity_mesh = np.eye(5, dtype=np.int8)
    cross_links = np.zeros((5, 5), dtype=np.int8)
    cross_links[0, 1] = np.int8(1)  # Намерение -> Цель
    cross_links[3, 4] = np.int8(1)  # Контекст -> Действие
    
    topology_mask = identity_mesh + cross_links
    
    matrices = (l5_trits[:, :, np.newaxis] * topology_mask[np.newaxis, :, :])
    matrices = matrices * supreme_verdict[:, np.newaxis, np.newaxis]
    matrices = matrices * final_execution_mask[:, np.newaxis, np.newaxis]
    
    return matrices


# ==============================================================================
# 2. ОСНОВНОЙ ВЫЧИСЛИТЕЛЬНЫЙ КОНТУР (SUPREME PIPELINE)
# ==============================================================================

class SupremeSupercomputerPipeline:
    def __init__(self, margin_threshold: float = 0.15, min_score: float = 0.3):
        self.margin_threshold = margin_threshold
        self.min_score = min_score

    def process_large_batch(self, interp_matrix: np.ndarray, l5_initial: np.ndarray) -> dict:
        N = interp_matrix.shape[0]
        
        base_trits = np.empty((N, 3), dtype=np.int8)
        parallel_logic_tensor = np.empty((N, 3), dtype=np.int8)
        pentary_tensor = np.empty((N, 3), dtype=np.int8)
        target_b = np.ones(N, dtype=np.int8)
        
        # Этап 1. Анализ Рашомона & Входной Гейт
        sorted_interp = np.sort(interp_matrix, axis=1)[:, ::-1]
        top_scores = sorted_interp[:, 0]
        margins = top_scores - sorted_interp[:, 1]
        
        gate_input_mask = (top_scores >= self.min_score) & (margins >= self.margin_threshold)
        interface_continuous_to_ternary(top_scores, margins, self.min_score, self.margin_threshold, base_trits)
        
        # Этап 2. Свертка Брусенцова (SIMD минимум)
        consolidated_base = np.min(base_trits, axis=1)
        
        # Этап 3. Параллельный ансамбль логик (Лукасевич / Гёдель / Клини)
        np.clip(target_b - consolidated_base, -1, 1, out=parallel_logic_tensor[:, 0])
        np.where(consolidated_base <= target_b, np.int8(1), target_b, out=parallel_logic_tensor[:, 1])
        np.maximum(-consolidated_base, target_b, out=parallel_logic_tensor[:, 2])
        
        interface_ternary_to_pentary(parallel_logic_tensor, pentary_tensor)
        
        # Этап 4. Интегральный консенсус ансамбля
        supreme_verdict = compute_supreme_consensus(pentary_tensor)
        
        # Этап 5. Выходной BXOS-гейт синхронизации
        gate_output_mask = (supreme_verdict != -2) & (supreme_verdict != -1)
        final_execution_mask = gate_input_mask & gate_output_mask
        
        # Этап 6. Топологический матричный проектор
        final_matrices = interface_pentary_to_topology(l5_initial, supreme_verdict, final_execution_mask)
        
        return {
            "execution_mask": final_execution_mask,
            "supreme_verdict": supreme_verdict,
            "matrices": final_matrices
        }


