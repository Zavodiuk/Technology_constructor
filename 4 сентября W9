import numpy as np
from typing import List, Dict, Any, Optional
from dataclasses import dataclass, field

K = 2  # Пентарный параметр домена {-2..2}


@dataclass
class AIDataCenterConfig:
    """Конфигурация параметров ИИ-кластера и дата-центра."""
    metric_labels: List[str] = field(default_factory=lambda: [
        'compute_density',     # Плотность вычислений (FLOPs/ватт)
        'thermal_dissipation', # Эффективность охлаждения (PUE / отвод тепла)
        'memory_bandwidth',    # Пропускная способность памяти (HBM / межсоединения)
        'power_efficiency',    # Энергоэффективность (минимизация потерь по Джоулю-Ленцу)
        'latency_factor',      # Скорость отклика / задержка инференса
        'fault_tolerance'      # Отказоустойчивость и резерв узлов
    ])
    max_level: int = 5


class DataCenterHarmonyBalancer:
    """
    Движок балансировки ресурсов дата-центра под управлением пентарной логики.
    Реализует распределение нагрузки между терморегулированием, пропускной 
    способностью и вычислительной плотностью ИИ-кластера.
    """

    def __init__(self, config: Optional[AIDataCenterConfig] = None):
        self.config = config or AIDataCenterConfig()
        self.width = len(self.config.metric_labels)
        
        # Матрица взаимного влияния инфраструктурных параметров (Trade-Off)
        self.trade_off_matrix = np.array([
            [ 1.0, -0.4, -0.2, -0.3,  0.1, -0.2],  # compute_density
            [-0.4,  1.0, -0.1, -0.4, -0.2, -0.1],  # thermal_dissipation
            [-0.2, -0.1,  1.0, -0.2, -0.3, -0.2],  # memory_bandwidth
            [-0.3, -0.4, -0.2,  1.0, -0.1, -0.3],  # power_efficiency
            [ 0.1, -0.2, -0.3, -0.1,  1.0, -0.2],  # latency_factor
            [-0.2, -0.1, -0.2, -0.3, -0.2,  1.0],  # fault_tolerance
        ], dtype=np.float32)

    def _validate_pentary(self, vector: List[int]) -> np.ndarray:
        arr = np.asarray(vector, dtype=np.int8)
        if not np.all(np.isin(arr, [-2, -1, 0, 1, 2])):
            raise ValueError("Управляющий вектор должен содержать пентарные значения от -2 до 2")
        return arr

    def balance_cluster(
        self, 
        base_metrics: Dict[str, float], 
        control_vector: List[int]
    ) -> Dict[str, Any]:
        """
        Перераспределение параметров дата-центра на основе пентарного управляющего 
        сигнала (например, при переходе кластера в режим пикового обучения LLM).
        """
        ctrl = self._validate_pentary(control_vector)
        if len(ctrl) != self.width:
            raise ValueError(f"Длина вектора ({len(ctrl)}) не равна числу метрик ({self.width})")

        current_vals = np.array([base_metrics.get(label, 3.0) for label in self.config.metric_labels], dtype=np.float32)
        
        normalized_ctrl = ctrl.astype(np.float32) / K
        delta = np.dot(self.trade_off_matrix, normalized_ctrl) * 0.4
        
        new_vals = np.clip(current_vals + delta, 1.0, float(self.config.max_level))

        balanced_result = {
            self.config.metric_labels[i]: round(float(new_vals[i]), 2)
            for i in range(self.width)
        }

        cluster_stability = float(np.mean(new_vals) / self.config.max_level)

        return {
            'control_vector': ctrl.tolist(),
            'cluster_metrics': balanced_result,
            'harmony_stability_index': round(cluster_stability, 3),
            'operational_status': 'OPTIMIZED_FOR_AI_WORKLOAD'
        }


