# ЧАСТЬ 1: PYTHON-АККУМУЛЯТОР (Сворачивание версий и пентаризация)
# ---------------------------------------------------------------------
def python_fold_repository(version_contents: list[str]) -> tuple[bytes, list[int]]:
    """Шаг 1: Сворачивание всех версий в бинарный поток и пентарную матрицу."""
    combined_data = "".join(version_contents).encode('utf-8')
    pentary_stream = []
    decimal_val = int.from_bytes(combined_data[:8], "big")
    temp = decimal_val
    while temp > 0:
        pentary_stream.append(temp % 5)
        temp //= 5
    return combined_data, pentary_stream[::-1]


