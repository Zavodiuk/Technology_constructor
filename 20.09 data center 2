# 3. MULTIVALUED LOGIC ENGINE W4.2 (GÖDEL vs STRONG ŁUKASIEWICZ K=2)
# ============================================================

class MultivaluedLogicEngine:
    """Универсальный контур свёртки: Гёдель/Клини (min) vs Коммутативный Сильный Лукасевич (K=2)."""
    
    def __init__(self, strategy: str = "luka"):
        if strategy not in ("godel", "luka"):
            raise ValueError("Стратегия должна быть 'godel' или 'luka'")
        self.strategy = strategy

    def fold(self, data: np.ndarray) -> np.ndarray:
        clean_data = BXOSGate.guard(data)
        if clean_data.ndim == 1:
            return self._reduce_1d(clean_data)
        return self._reduce_batch(clean_data)

    def _reduce_1d(self, arr: np.ndarray) -> int:
        if self.strategy == "godel":
            return int(np.minimum.reduce(arr))
        else:
            n = len(arr)
            if n == 0:
                return -2
            total_sum = int(np.sum(arr, dtype=np.int16))
            return int(max(-2, total_sum - 2 * (n - 1)))

    def _reduce_batch(self, batch: np.ndarray) -> np.ndarray:
        if self.strategy == "godel":
            return np.minimum.reduce(batch, axis=-1)
        else:
            n = batch.shape[-1]
            total_sum = np.sum(batch.astype(np.int16), axis=-1)
            res = np.maximum(-2, total_sum - 2 * (n - 1))
            return res.astype(np.int8)


# ============================================================
# 4. PENTARNY RASHOMON MULTI-PERSPECTIVE AUDIT
# ============================================================

class PentarnyRashomon:
    """Многоракурсный векторизованный блок валидации (Rashomon) без истории."""
    
    PERSPECTIVES = ("technical", "operational", "structural", "boundary", "risk")

    @staticmethod
    def evaluate(matrix: np.ndarray) -> Dict[str, np.ndarray]:
        if matrix.size == 0:
            batch_dim = matrix.shape[:-1] if matrix.ndim > 1 else ()
            zero_arr = np.zeros(batch_dim, dtype=float)
            return {p: zero_arr for p in PentarnyRashomon.PERSPECTIVES}
            
        float_m = matrix.astype(float)
        return {
            "technical": np.mean(float_m, axis=-1),
            "operational": np.min(float_m, axis=-1),
            "structural": np.max(float_m, axis=-1),
            "boundary": np.std(float_m, axis=-1) if float_m.ndim > 1 else np.array(0.0),
            "risk": -np.mean(np.abs(float_m), axis=-1)
        }


# ============================================================
# 5. BRUSENTSOV LOGIC & CACHED TRAIT TABLE
# ============================================================

class BrusentsovLogic:
    """Логика Брусенцова с кэшированием (синглтон трайт-таблицы) и бродкастингом."""
    
    _trait_table_cache: Optional[np.ndarray] = None

    def __init__(self, width: int = 3):
        self.width = width
        self.size = 3 ** width
        
        if BrusentsovLogic._trait_table_cache is None:
            steps = np.arange(self.size, dtype=np.int16)
            power_weights = 3 ** np.arange(width - 1, -1, -1)
            trits_matrix = (steps[:, None] // power_weights) % 3 - 1
            min_trits = np.minimum(trits_matrix[:, None, :], trits_matrix[None, :, :])
            encoded = np.sum((min_trits + 1) * power_weights, axis=-1)
            BrusentsovLogic._trait_table_cache = encoded
            
        self.trait_table = BrusentsovLogic._trait_table_cache

    @staticmethod
    def fold_and_vector(trits: np.ndarray) -> np.ndarray:
        return np.min(trits, axis=-1)


# ============================================================
# 6. PENTARY PROTECTIVE MATRIX ENGINE (Tensor 5x5)
# ============================================================

class PentaryMatrixEngine:
    """Конструктор матриц защитных свойств для перчаток, рукавов и гетр (Автор: Владимир Заводюк)."""
    
    LAYERS = [
        'water_resistance',       # 1. Водостойкость
        'spark_resistance',       # 2. Искростойкость
        'impact_resistance',      # 3. Ударопрочность
        'cut_resistance',         # 4. Сопротивление порезам
        'temperature_resistance'  # 5. Термостойкость
    ]
    
    @staticmethod
    def build_linear_matrix(l5_vector: np.ndarray) -> np.ndarray:
        ternary_vector = np.sign(l5_vector).astype(np.int8)
        if ternary_vector.ndim == 1:
            v1 = ternary_vector[:, None]
            v2 = ternary_vector[None, :]
            return np.minimum(v1, v2).astype(np.int8)
        else:
            v1 = ternary_vector[:, :, None] # (BatchSize, 5, 1)
            v2 = ternary_vector[:, None, :] # (BatchSize, 1, 5)
            return np.minimum(v1, v2).astype(np.int8)


# ============================================================
# 7. BXOS PIPELINE ORCHESTRATOR (BATCHED W4.2 + RASHOMON)
# ============================================================

class BXOSPipeline:
    """Сквозной оркестратор пакетных расчетов W4.2, Rashomon и матриц защитных свойств без циклов."""
    
    def __init__(self, strategy: str = "luka"):
        self.ternary = TernaryProcessor()
        self.brusentsov = BrusentsovLogic(width=3)
        self.logic_engine = MultivaluedLogicEngine(strategy=strategy)
        self.matrix_engine = PentaryMatrixEngine()
        self.rashomon = PentarnyRashomon()
        self.gate = BXOSGate()

    def run(self, interpretations_scores: List[List[float]], l5_values_list: List[List[int]]) -> dict:
        scores = np.array(interpretations_scores, dtype=np.float64)
        l5_vector = np.array(l5_values_list, dtype=np.int8)
        
        self.gate.verify_input_shape(scores, expected_dim=2)
        self.gate.verify_input_shape(l5_vector, expected_dim=2)
        if l5_vector.shape[1] != 5:
            raise ValueError("Пентарный вектор свойств L5 должен содержать ровно 5 элементов по последней оси.")

        # 1. Защита входного гейта
        clean_l5 = BXOSGate.guard(l5_vector)

        # 2. Триаж и анализ скоров
        states, best_idx, margins = self.ternary.analyze_interpretations(scores)
        batch_size = scores.shape[0]
        row_indices = np.arange(batch_size)
        best_scores = scores[row_indices, best_idx]
        
        second_trit = np.where(best_scores > 0.5, 1, 0).astype(np.int8)
        third_trit = np.ones_like(second_trit, dtype=np.int8)
        
        feature_trits = np.stack([states, second_trit, third_trit], axis=-1)
        consolidated_trits = self.brusentsov.fold_and_vector(feature_trits)
        
        confidence_map = {-1: 0.3, 0: 0.55, 1: 0.85}
        confidences = np.array([confidence_map.get(t, 0.5) for t in consolidated_trits], dtype=np.float64)
        
        # 3. Построение матриц 5x5 и логическая свёртка W4.2
        matrices_5x5 = self.matrix_engine.build_linear_matrix(clean_l5)
        folded_results = self.logic_engine.fold(clean_l5)

        # 4. Расчет системной энергии (L5 system energy)
        system_energy = np.sum(np.abs(clean_l5), axis=-1) / 10.0

        # 5. Многоракурсный Rashomon-анализ батча
        rashomon_audit = self.rashomon.evaluate(clean_l5)
        rashomon_serializable = {
            k: (v.tolist() if isinstance(v, np.ndarray) else float(v)) 
            for k, v in rashomon_audit.items()
        }

        # 6. Проверка статусов и телеметрия
        pentary_values = clean_l5[:, 0]
        timestamp = time.perf_counter()
        
        statuses = []
        for i in range(batch_size):
            if states[i] == -1:
                status = "LOCKED_INPUT"
            elif pentary_values[i] in self.gate.critical_states or confidences[i] < self.gate.min_confidence:
                status = "LOCKED_OUTPUT"
                self.gate.log.append({"status": "LOCKED", "ts": timestamp})
            else:
                status = "OK"
                self.gate.log.append({"status": "READY", "ts": timestamp})
            statuses.append(status)

        return {
            "statuses": statuses,
            "best_candidate_indices": best_idx.tolist(),
            "confidences": confidences.tolist(),
            "folded_results": folded_results.tolist(),
            "system_energy": system_energy.tolist(),
            "rashomon_audit": rashomon_serializable,
            "matrix_shape": [5, 5],
            "property_layers": self.matrix_engine.LAYERS,
            "linear_matrices_5x5": matrices_5x5.tolist()
        }


