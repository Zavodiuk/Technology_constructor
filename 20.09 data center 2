# 2. TERNARY PROCESSOR (L3) & BATCH VECTOR ANALYSIS
# ============================================================

class TernaryProcessor:
    """Оптимизированный троичный блок (L3) на NumPy для пакетного анализа скоров."""
    
    @staticmethod
    def analyze_interpretations(scores: np.ndarray, margin_threshold: float = 0.15, min_score: float = 0.3) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
        if scores.size == 0:
            return np.array([-1]), np.array([-1]), np.array([0.0])
            
        if scores.shape[-1] > 1:
            top_2_idx = np.argpartition(scores, -2, axis=-1)[..., -2:]
            sorted_vals = np.take_along_axis(scores, top_2_idx, axis=-1)
            sorted_order = np.argsort(sorted_vals, axis=-1)[..., ::-1]
            top_2_idx = np.take_along_axis(top_2_idx, sorted_order, axis=-1)
            best_idx = top_2_idx[..., 0]
            second_idx = top_2_idx[..., 1]
            best_score = np.take_along_axis(scores, best_idx[..., None], axis=-1).squeeze(-1)
            second_score = np.take_along_axis(scores, second_idx[..., None], axis=-1).squeeze(-1)
            margin = best_score - second_score
        else:
            best_idx = np.zeros(scores.shape[0], dtype=np.intp)
            best_score = scores[:, 0]
            margin = best_score
            
        state = np.where(best_score < min_score, -1, np.where(margin >= margin_threshold, 1, 0))
        return state, best_idx, margin


