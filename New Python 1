class MultiVector:
    """Мультивектор в 3D геометрической алгебре Cl(3,0)"""

    def __init__(self, scalar=0.0, v1=0.0, v2=0.0, v3=0.0,
                 b12=0.0, b13=0.0, b23=0.0, trivector=0.0):
        self.s = scalar
        self.v1 = v1; self.v2 = v2; self.v3 = v3
        self.b12 = b12; self.b13 = b13; self.b23 = b23
        self.t = trivector

    def is_zero(self, eps=1e-12):
        return (abs(self.s) < eps and abs(self.v1) < eps and abs(self.v2) < eps and
                abs(self.v3) < eps and abs(self.b12) < eps and abs(self.b13) < eps and
                abs(self.b23) < eps and abs(self.t) < eps)

    def norm(self) -> float:
        return math.sqrt(self.s**2 + self.v1**2 + self.v2**2 + self.v3**2 +
                         self.b12**2 + self.b13**2 + self.b23**2 + self.t**2)

    def reverse(self):
        return MultiVector(
            scalar=self.s,
            v1=self.v1, v2=self.v2, v3=self.v3,
            b12=-self.b12, b13=-self.b13, b23=-self.b23,
            trivector=-self.t
        )

    def __add__(self, other):
        if not isinstance(other, MultiVector):
            raise TypeError("Можно складывать только мультивекторы")
        return MultiVector(
            scalar=self.s + other.s,
            v1=self.v1 + other.v1, v2=self.v2 + other.v2, v3=self.v3 + other.v3,
            b12=self.b12 + other.b12, b13=self.b13 + other.b13, b23=self.b23 + other.b23,
            trivector=self.t + other.t
        )

    def __sub__(self, other):
        if not isinstance(other, MultiVector):
            raise TypeError("Можно вычитать только мультивекторы")
        return MultiVector(
            scalar=self.s - other.s,
            v1=self.v1 - other.v1, v2=self.v2 - other.v2, v3=self.v3 - other.v3,
            b12=self.b12 - other.b12, b13=self.b13 - other.b13, b23=self.b23 - other.b23,
            trivector=self.t - other.t
        )

    def __mul__(self, other):
        if isinstance(other, (int, float)):
            return MultiVector(
                scalar=self.s * other,
                v1=self.v1 * other, v2=self.v2 * other, v3=self.v3 * other,
                b12=self.b12 * other, b13=self.b13 * other, b23=self.b23 * other,
                trivector=self.t * other
            )
        if not isinstance(other, MultiVector):
            raise TypeError("Можно умножать только на мультивектор или скаляр")

        a, b = self, other

        s = (a.s*b.s + a.v1*b.v1 + a.v2*b.v2 + a.v3*b.v3
             - a.b12*b.b12 - a.b13*b.b13 - a.b23*b.b23 - a.t*b.t)
        v1 = (a.s*b.v1 + a.v1*b.s + a.v2*b.b12 + a.v3*b.b13
              - a.b12*b.v2 - a.b13*b.v3 - a.b23*b.b23 + a.t*b.b23)
        v2 = (a.s*b.v2 + a.v2*b.s + a.v3*b.b23 + a.v1*b.b12
              - a.b12*b.v1 - a.b23*b.v3 - a.b13*b.b13 + a.t*b.b13)
        v3 = (a.s*b.v3 + a.v3*b.s + a.v1*b.b13 + a.v2*b.b23
              - a.b13*b.v1 - a.b23*b.v2 - a.b12*b.b12 + a.t*b.b12)
        b12 = (a.s*b.b12 + a.b12*b.s + a.v1*b.v2 - a.v2*b.v1
               + a.b13*b.b23 - a.b23*b.b13 + a.t*b.b23 + a.b12*b.t)
        b13 = (a.s*b.b13 + a.b13*b.s + a.v1*b.v3 - a.v3*b.v1
               + a.b23*b.b12 - a.b12*b.b23 + a.t*b.b23 + a.b13*b.t)
        b23 = (a.s*b.b23 + a.b23*b.s + a.v2*b.v3 - a.v3*b.v2
               + a.b12*b.b13 - a.b13*b.b12 + a.t*b.b12 + a.b23*b.t)
        t = (a.s*b.t + a.t*b.s + a.v1*b.b23 + a.v2*b.b13 + a.v3*b.b12
             + a.b12*b.v3 + a.b13*b.v2 + a.b23*b.v1 + a.t*b.t)

        return MultiVector(s, v1, v2, v3, b12, b13, b23, t)

    def __rmul__(self, other):
        return self.__mul__(other)

    def __neg__(self):
        return self.__mul__(-1)

    def exp(self):
        if self.s == 0 and self.v1 == 0 and self.v2 == 0 and self.v3 == 0 and self.t == 0:
            b_vec = [self.b12, self.b13, self.b23]
            norm_b = math.sqrt(sum(x**2 for x in b_vec))
            if norm_b < 1e-12:
                return MultiVector(scalar=1.0)
            cos_val = math.cos(norm_b)
            sin_val = math.sin(norm_b)
            b_norm = [x / norm_b for x in b_vec]
            return MultiVector(
                scalar=cos_val,
                b12=sin_val * b_norm[0],
                b13=sin_val * b_norm[1],
                b23=sin_val * b_norm[2]
            )
        raise NotImplementedError("Экспонента только для бивекторов")

    def log(self):
        if self.s != 0 and self.b12 != 0 and self.b13 != 0 and self.b23 != 0:
            b_vec = [self.b12, self.b13, self.b23]
            norm_b = math.sqrt(sum(x**2 for x in b_vec))
            if norm_b < 1e-12:
                return MultiVector()
            angle = math.atan2(norm_b, self.s)
            return MultiVector(
                b12=(angle / norm_b) * self.b12,
                b13=(angle / norm_b) * self.b13,
                b23=(angle / norm_b) * self.b23
            )
        raise NotImplementedError("Логарифм только для роторов")

    def __repr__(self):
        parts = []
        if abs(self.s) > 1e-12: parts.append(f"{self.s:.3f}")
        if abs(self.v1) > 1e-12: parts.append(f"{self.v1:.3f} e1")
        if abs(self.v2) > 1e-12: parts.append(f"{self.v2:.3f} e2")
        if abs(self.v3) > 1e-12: parts.append(f"{self.v3:.3f} e3")
        if abs(self.b12) > 1e-12: parts.append(f"{self.b12:.3f} e12")
        if abs(self.b13) > 1e-12: parts.append(f"{self.b13:.3f} e13")
        if abs(self.b23) > 1e-12: parts.append(f"{self.b23:.3f} e23")
        if abs(self.t) > 1e-12: parts.append(f"{self.t:.3f} e123")
        return " + ".join(parts) if parts else "0"

def vector(v1, v2, v3):
    """Создаёт вектор (мультивектор с нулевым скаляром)"""
    return MultiVector(v1=v1, v2=v2, v3=v3)

def rotor(angle, axis_v1, axis_v2, axis_v3):
    """Создаёт ротор (вращение) вокруг оси"""
    norm = math.sqrt(axis_v1**2 + axis_v2**2 + axis_v3**2)
    if norm < 1e-12:
        return MultiVector(scalar=1.0)
    n1, n2, n3 = axis_v1/norm, axis_v2/norm, axis_v3/norm
    half_angle = angle / 2.0
    cos_val = math.cos(half_angle)
    sin_val = math.sin(half_angle)
    return MultiVector(
        scalar=cos_val,
        b12=-sin_val * n3,
        b13=-sin_val * n2,
        b23=-sin_val * n1
    )

def rotate_vector(vec: MultiVector, rotor_obj: MultiVector) -> MultiVector:
    """Поворачивает вектор с помощью ротора: R * v * R_reverse"""
    return rotor_obj * vec * rotor_obj.reverse()

def reflect_vector(vec: MultiVector, normal: MultiVector) -> MultiVector:
    """Отражает вектор относительно плоскости с нормалью n: -n * v * n"""
    return -normal * vec * normal

