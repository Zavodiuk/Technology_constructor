# ЧАСТЬ 2: ГИПЕРБОЛИЧЕСКАЯ ГЕОМЕТРИЯ
# ============================================================

def hyperbolic_distance(vec_a: Tuple[float, ...], vec_b: Tuple[float, ...], radius: float = 1.0) -> float:
    """Гиперболическое расстояние в модели Пуанкаре"""
    if len(vec_a) != len(vec_b):
        raise ValueError(f"Размерности не совпадают: {len(vec_a)} != {len(vec_b)}")
    
    a = [v / radius for v in vec_a]
    b = [v / radius for v in vec_b]
    
    norm_a = math.sqrt(sum(ai**2 for ai in a))
    norm_b = math.sqrt(sum(bi**2 for bi in b))
    
    max_safe = 0.999999
    if norm_a >= 1.0: norm_a = max_safe
    if norm_b >= 1.0: norm_b = max_safe
    
    numerator = sum((ai - bi)**2 for ai, bi in zip(a, b))
    denominator = (1.0 - norm_a**2) * (1.0 - norm_b**2)
    
    if denominator <= 0:
        return float('inf')
    
    arg = 1.0 + 2.0 * numerator / denominator
    if arg < 1.0:
        arg = 1.0
        
    return radius * math.acosh(arg)

def hyperbolic_vector(metrics: List[float], radius: float = 1.0) -> Tuple[float, ...]:
    """Превращает метрики в гиперболический вектор"""
    trits = [quantize(m) for m in metrics]
    norm = math.sqrt(sum(t**2 for t in trits))
    max_allowable = radius * 0.999
    if norm > max_allowable and norm > 0:
        trits = [t * max_allowable / norm for t in trits]
    return tuple(float(t) for t in trits)

@dataclass
class Point:
    """Точка в гиперболическом пространстве"""
    x: float
    y: float
    z: float = 0.0

    def to_tuple(self) -> Tuple[float, ...]:
        return (self.x, self.y, self.z)

    def distance_to(self, other: 'Point', radius: float = 1.0) -> float:
        return hyperbolic_distance(self.to_tuple(), other.to_tuple(), radius)

    def __repr__(self):
        return f"Point(x={self.x:.3f}, y={self.y:.3f}, z={self.z:.3f})"

@dataclass
class Geodesic:
    """Геодезическая линия"""
    start: Point
    end: Point
    radius: float = 1.0

    def length(self) -> float:
        return self.start.distance_to(self.end, self.radius)

    def midpoint(self) -> Point:
        return Point(
            (self.start.x + self.end.x) / 2,
            (self.start.y + self.end.y) / 2,
            (self.start.z + self.end.z) / 2
        )

    def __repr__(self):
        return f"Geodesic({self.start} → {self.end})"

@dataclass
class HyperbolicVector:
    coordinates: Tuple[float, ...]
    radius: float = 1.0

    def norm(self) -> float:
        return math.sqrt(sum(c**2 for c in self.coordinates))

    def to_point(self) -> Point:
        if len(self.coordinates) >= 3:
            return Point(self.coordinates[0], self.coordinates[1], self.coordinates[2])
        elif len(self.coordinates) == 2:
            return Point(self.coordinates[0], self.coordinates[1], 0.0)
        else:
            return Point(self.coordinates[0], 0.0, 0.0)

    def __repr__(self):
        return f"HyperbolicVector{self.coordinates}"

