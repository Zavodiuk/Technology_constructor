# ============================================================
# ЧАСТЬ 1: ТРОИЧНАЯ ЛОГИКА
# ============================================================

def sgn(x):
    """Знак числа: +1, 0, -1"""
    if x > 0: return 1
    elif x < 0: return -1
    return 0

def cmp(a, b):
    """Сравнение: +1 (a>b), 0 (a==b), -1 (a<b)"""
    if a > b: return 1
    elif a < b: return -1
    return 0

def neg(x):
    """Троичная инверсия: -1 ↔ +1, 0 → 0"""
    if x == 1: return -1
    elif x == -1: return 1
    return 0

def tmin(a, b):
    """Троичный минимум (И)"""
    if a == -1 or b == -1: return -1
    elif a == 0 or b == 0: return 0
    return 1

def tmax(a, b):
    """Троичный максимум (ИЛИ)"""
    if a == 1 or b == 1: return 1
    elif a == 0 or b == 0: return 0
    return -1

def quantize(value, low=0.3, high=0.7):
    """Квантует число в трит (-1, 0, +1)"""
    if value >= high: return 1
    elif value <= low: return -1
    return 0

