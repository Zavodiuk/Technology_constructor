import random

# =====================================================================
# 1. МОДУЛЬ TERNARY_MATRIX & ЭВРИСТИЧЕСКИЙ АНАЛИЗ (Скриншоты 1, 3, 5, 6)
# =====================================================================

def candidate_agreement_matrix(validator_votes):
    """
    Строит матрицу совпадений оценок между валидаторами по всем осям.
    Элемент matrix[i][j] хранит количество осей, по которым голоса совпали.
    """
    n = len(validator_votes)
    matrix = [[0] * n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            # Считаем, по скольким осям (элементам вектора) голоса полностью совпали
            matches = sum(1 for axis1, axis2 in zip(validator_votes[i], validator_votes[j]) if axis1 == axis2)
            matrix[i][j] = matches
    return matrix

def disagreement_from_agreement_matrix(agreement_matrix):
    """
    Рассчитывает общие метрики согласия и индекс расхождения сети.
    """
    n = len(agreement_matrix)
    if n == 0:
        return {"disagreement": 0.0, "mean_agreement": 0.0}
    
    total_elements = n * n
    sum_agreement = sum(sum(row) for row in agreement_matrix)
    mean_agreement = sum_agreement / total_elements
    
    # Нормализованный индекс расхождения (Disagreement)
    disagreement = 1.0 - (mean_agreement / n)
    return {
        "disagreement": disagreement,
        "mean_agreement": mean_agreement
    }

def matrix_based_check(validator_votes):
    """
    Дополнительный слой: анализ через матрицу согласия. Ищем СГОВОР.
    Фиксирует скоординированные паттерны в многомерном пространстве решений.
    """
    agreement = candidate_agreement_matrix(validator_votes)
    n = len(validator_votes)
    n_axes = len(validator_votes[0]) if n > 0 else 5
    
    suspicious_pairs = []
    for i in range(n):
        for j in range(i + 1, n):
            # Ищем пары с ПОДОЗРИТЕЛЬНО высоким взаимным согласием (ПОЛНОЕ совпадение по всем осям)
            if agreement[i][j] == n_axes:
                suspicious_pairs.append((i, j))
                
    # ИСПРАВЛЕНО: Передаем корректную матрицу 'agreement' вместо ошибочного 'v'
    overall = disagreement_from_agreement_matrix(agreement)
    
    return {
        "agreement_matrix": agreement,
        "suspicious_pairs": suspicious_pairs,
        "overall_disagreement": overall["disagreement"],
        "mean_agreement": overall["mean_agreement"]
    }

# =====================================================================
# 2. БАЗОВЫЙ МОДУЛЬ ГОЛОСОВАНИЯ (Скриншот 2)
# =====================================================================

def simple_majority_vote(validator_votes):
    """
    Baseline: обычное голосование -- каждый схлопывается в ОДИН скалярный голос.
    (например, среднее по осям), решение принимается по большинству.
    """
    def quantize_scalar(avg):
        if avg >= 0.34: return 1
        elif avg <= -0.34: return -1
        return 0

    scalar_votes = [quantize_scalar(sum(v) / len(v)) for v in validator_votes]
    positive = scalar_votes.count(1)
    negative = scalar_votes.count(-1)
    
    return {
        "scalar_votes": scalar_votes,
        "positive": positive,
        "negative": negative,
        "decision": "ACCEPT" if positive > negative else "REJECT",
        "unanimous_looking": abs(positive - negative)
    }

