    print("BASELINE: простое голосование (один скалярный голос от каждого)")
    print("-" * 65)
    
    majority = simple_majority_vote(all_votes)
    print(f"Скалярные голоса: {majority['scalar_votes']}")
    print(f"За: {majority['positive']}, Против: {majority['negative']}")
    print(f"Решение: {majority['decision']}")
    print(">>> Простое голосование не видит проблему в критических осях")
    print("    (double-spend) -- она усредняется внутри каждого вектора.")
    
    print("\n" + "-" * 65)
    print("ДОПОЛНИТЕЛЬНЫЙ СЛОЙ: матричный анализ скоординированности")
    print("-" * 65)
    
    matrix_result = matrix_based_check(all_votes)
    print(f"Среднее попарное согласие: {round(matrix_result['mean_agreement'], 2)}")
    print(f"Общий Disagreement: {round(matrix_result['overall_disagreement'], 2)}")
    
    print("\nПодозрительные пары (ПОЛНОЕ совпадение по всем осям):")
    if matrix_result["suspicious_pairs"]:
        for i, j in matrix_result["suspicious_pairs"]:
            # Полное соответствие выводу на вашем 6-м скриншоте
            print(f"   {validator_names[i]} <-> {validator_names[j]} -- ИДЕНТИЧНЫ ПО ВСЕМ 5 ОСЯМ")
    else:
        print("   Не найдено")
        
    print("\n" + "=" * 65)
    print("ЧТО ПОКАЗАЛ ТЕСТ")
    print("=" * 65)
    print("Простое голосование дало ACCEPT (7 честных зашумлены, а векторы")
    print("2 сговорившихся) -- формально решение принято большинством.")
    print()
    print("Но матричный анализ ДОПОЛНИТЕЛЬНО подсветил, что Byzantine_0")
    print("и Byzantine_1 голосуют АБСОЛЮТНО идентично. Это математически")
    print("маловероятное совпадение для независимых узлов в зашумленной сети --")
    print("сигнал возможного сговора, требующий изоляции атакующего кластера,")
    print("даже если итоговое решение по большинству голосов кажется валидным.")
