    ]
    
    all_votes = honest_votes + byzantine_votes
    validator_names = [f"Honest_{i}" for i in range(7)] + [f"Byzantine_{i}" for i in range(len(byzantine_votes))]
    
    # Вывод исходных векторов
    print("\nГолоса валидаторов (11..15):")
