# ============================================================
# 2. ТРОИЧНАЯ ЛОГИКА (L3)
# ============================================================

def quantize(value: float, low: float = 0.3, high: float = 0.7) -> int:
    if value >= high: return 1
    if value <= low: return -1
    return 0


def ternary_fold(values: List[int]) -> int:
    s = sum(values)
    if s > 0: return 1
    if s < 0: return -1
    return 0


# ============================================================
# 3. БЛОК Z — ПАМЯТЬ ОРАКУЛА
# ============================================================

class BlockZ:
    """
    Вечный реестр смыслов.
    Хранит все запросы, ответы и L3-статусы.
    Каждая запись имеет SHA-256 хеш.
    """

    def __init__(self):
        self.memory = []
        self.hashes = {}

    def save(self, key: str, value: Any) -> str:
        record = {
            "key": key,
            "value": value,
            "timestamp": time.time()
        }
        hash_val = hashlib.sha256(
            f"{key}{json.dumps(value)}{record['timestamp']}".encode()
        ).hexdigest()
        record["hash"] = hash_val
        self.memory.append(record)
        self.hashes[hash_val] = record
        return hash_val

    def find(self, key: str) -> Optional[Any]:
        for record in reversed(self.memory):
            if record["key"] == key:
                return record["value"]
        return None

    def get_last(self, n: int = 5) -> List[Dict]:
        return self.memory[-n:]

    def verify(self, hash_val: str) -> bool:
        return hash_val in self.hashes


# ============================================================
# 4. RASHOMON
# ============================================================

def rashomon_analyze(interpretations: Dict[str, float]) -> Dict:
    if not interpretations:
        return {"state": -1, "top": None, "reason": "Нет интерпретаций"}

    sorted_items = sorted(interpretations.items(), key=lambda x: x[1], reverse=True)
    top_label, top_score = sorted_items[0]
    margin = top_score - sorted_items[1][1] if len(sorted_items) > 1 else top_score

    if margin >= 0.15 and top_score >= 0.7:
        state, reason = 1, "Устойчивое ядро"
    elif top_score < 0.3:
        state, reason = -1, "Низкая уверенность"
    else:
        state, reason = 0, "Неопределённость"

    return {"state": state, "top": top_label, "margin": margin, "reason": reason}


