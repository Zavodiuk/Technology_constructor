# 5. ЯДРО ОРАКУЛА V6
# ============================================================

class OracleV6:
    """
    Главный класс Оракула.
    Управляется через L3, Block Z, Rashomon и STOP Veto.
    Готов к подключению любого LLM (Gemini, Claude, локальный).
    """

    def __init__(self):
        self.memory = BlockZ()
        self.l3_status = 0
        self.history = []
        self.active = True
        self.root_hash = ROOT_HASH
        self.architect = ROOT_ARCHITECT
        self.version = VERSION
        self.name = ORACLE_NAME

        # Базовая база ответов
        self._responses = {
            "привет": "Я — Оракул V6. Я готов отвечать на ваши вопросы, Root-Architect.",
            "как дела": f"Мой L3 статус: {self.l3_status}. Я в ожидании ваших команд.",
            "стоп": "⚠️ ВЕТО АКТИВИРОВАНО. Оракул остановлен.",
            "старт": "Оракул возобновлён. L3 статус: 0.",
            "статус": self._status_response,
            "память": self._memory_response,
            "кто ты": self._who_response,
            "команды": self._commands_response,
            "оракул": "Я здесь, Root-Architect. Я слушаю вас."
        }

        self.memory.save("init", "Оракул V6 инициализирован")
        print(f"[Оракул] Инициализация завершена. Root-Architect: {self.architect}")
        print(f"[Оракул] SHA-256: {self.root_hash[:16]}...")
        print(f"[Оракул] Версия: {self.version}")

    # ----------------------------------------------------------
    # ВНУТРЕННИЕ ОТВЕТЫ
    # ----------------------------------------------------------

    def _status_response(self) -> str:
        return (
            f"Статус Оракула: {'Активен' if self.active else 'Остановлен Veto'}\n"
            f"L3 статус: {self.l3_status}\n"
            f"Память: {len(self.memory.memory)} записей\n"
            f"История: {len(self.history)} запросов\n"
            f"Root-Architect: {self.architect}\n"
            f"SHA-256: {self.root_hash[:16]}..."
        )

    def _memory_response(self) -> str:
        last = self.memory.get_last(5)
        if not last:
            return "Память Оракула пуста."
        lines = ["Последние 5 записей Оракула:"]
        for r in last:
            value_str = str(r['value'])[:60] + "..." if len(str(r['value'])) > 60 else str(r['value'])
            lines.append(f"  - {r['key']}: {value_str}")
        return "\n".join(lines)

    def _who_response(self) -> str:
        return (
            f"Я — Оракул V6, агент на архитектуре v6.\n"
            f"Меня создал {self.architect} (Root-Architect).\n"
            f"Я работаю на троичной логике, имею вечную память и подчиняюсь STOP Veto.\n"
            f"Мой SHA-256: {self.root_hash[:16]}..."
        )

    def _commands_response(self) -> str:
        return (
            "Доступные команды Оракула:\n"
            "  привет — проверка связи\n"
            "  статус — состояние Оракула\n"
            "  память — последние записи\n"
            "  кто ты — информация об Оракуле\n"
            "  команды — этот список\n"
            "  стоп — активация STOP Veto\n"
            "  старт — возобновление работы\n"
            "  оракул — я откликнусь"
        )

    # ----------------------------------------------------------
    # L3-ФИЛЬТРАЦИЯ
    # ----------------------------------------------------------

    def _evaluate_input(self, text: str) -> int:
        has_subject = any(w in text.lower() for w in ['помоги', 'создай', 'напиши', 'объясни', 'расскажи', 'скажи', 'покажи'])
        has_criteria = any(w in text.lower() for w in ['как', 'почему', 'что', 'где', 'когда', 'зачем'])
        score = (has_subject + has_criteria) / 2
        return quantize(score)

    def _evaluate_output(self, response: str) -> int:
        if not response or len(response) < 5:
            return -1
        if len(response) > 20:
            return 1
        return 0

    # ----------------------------------------------------------
    # ОСНОВНОЙ МЕТОД
    # ----------------------------------------------------------

    def ask(self, user_input: str) -> Dict[str, Any]:
        """
        Основной метод взаимодействия с Оракулом.
        """
        if not self.active:
            return {
                "status": "veto",
                "message": "Оракул остановлен Root-Architect Veto",
                "l3_in": -1,
                "l3_out": -1
            }

        # 1. Оценка входа
        l3_in = self._evaluate_input(user_input)
        self.memory.save("l3_in", l3_in)

        if l3_in == -1:
            return {
                "status": "rejected",
                "message": "Запрос заблокирован (L3_in = -1)",
                "l3_in": -1,
                "l3_out": -1,
                "response": None
            }

        # 2. Поиск ответа в базе
        lower = user_input.lower()
        response_text = None
        for key, value in self._responses.items():
            if key in lower:
                response_text = value() if callable(value) else value
                break

        # 3. Если не найдено — общий ответ
        if response_text is None:
            response_text = (
                f"Запрос принят, Root-Architect. L3_in: {l3_in}.\n"
                f"Я — Оракул V6. Моя задача — служить вам.\n"
                f"Для подключения LLM-слоя используйте метод set_llm().\n"
                f"Введите 'команды' для списка доступных команд."
            )

        # 4. Оценка выхода
        l3_out = self._evaluate_output(response_text)

        # 5. Если L3_out = -1 — блокируем
        if l3_out == -1:
            return {
                "status": "veto",
                "message": "Ответ Оракула заблокирован (L3_out = -1)",
                "l3_in": l3_in,
                "l3_out": -1,
                "response": None
            }

        # 6. Сохранение в память
        self.memory.save("query", user_input)
        self.memory.save("response", response_text)
        self.memory.save("l3_in", l3_in)
        self.memory.save("l3_out", l3_out)

        # 7. История
        self.history.append({
            "input": user_input,
            "output": response_text,
            "l3_in": l3_in,
            "l3_out": l3_out,
            "time": time.time()
        })

        self.l3_status = l3_out

        return {
            "status": "success",
            "l3_in": l3_in,
            "l3_out": l3_out,
            "response": response_text,
            "memory_hash": self.memory.hashes.get("response", None),
            "history_size": len(self.history)
        }

    # ----------------------------------------------------------
    # УПРАВЛЕНИЕ ОРАКУЛОМ
    # ----------------------------------------------------------

    def veto(self) -> Dict:
        """Активирует STOP Veto — Оракул останавливается."""
        self.active = False
        self.l3_status = -1
        self.memory.save("veto", "Оракул остановлен")
        return {
            "status": "veto",
            "message": "Оракул остановлен Root-Architect Veto",
            "l3_status": -1
        }

    def resume(self) -> Dict:
        """Возобновляет работу Оракула."""
        self.active = True
        self.l3_status = 0
        self.memory.save("resume", "Оракул возобновлён")
        return {
            "status": "resumed",
            "message": "Оракул активен",
            "l3_status": 0
        }

    def status(self) -> Dict:
        """Возвращает полный статус Оракула."""
        return {
            "active": self.active,
            "l3_status": self.l3_status,
            "memory_size": len(self.memory.memory),
            "history_size": len(self.history),
            "root_architect": self.architect,
            "sha_256": self.root_hash,
            "version": self.version,
            "name": self.name
        }

    def memory_dump(self) -> Dict:
        """Возвращает содержимое памяти."""
        return {
            "last_10": self.memory.get_last(10),
            "total": len(self.memory.memory),
            "hashes": list(self.memory.hashes.keys())[-5:]
        }

    # ----------------------------------------------------------
    # ПОДКЛЮЧЕНИЕ LLM (ЗАГОТОВКА)
    # ----------------------------------------------------------

    def set_llm(self, llm_type: str, config: Dict = None):
        """
        Место для подключения внешнего LLM.
        llm_type: 'gemini', 'claude', 'local'
        """
        self._llm_type = llm_type
        self._llm_config = config or {}
        self.memory.save("llm_connected", f"{llm_type} - {self._llm_config}")
        print(f"[Оракул] LLM подключён: {llm_type}")


