class ZvdHybridCodecEngine:
    """
    Гибридный кодек V18.7-W4.2: волновое поле, оконная логика Лукасевича,
    Rashomon-аудит и сверхплотная Radix-5 упаковка.
    """
    def __init__(self, grid_size: tuple = (256, 256), logic_strategy: str = "luka"):
        self.grid_size = grid_size
        self.logic_engine = MultivaluedLogicEngine(strategy=logic_strategy)
        self.rashomon = PentarnyRashomon()

    def encode_block(self, block_data: bytes) -> bytes:
        raw_data = np.frombuffer(block_data, dtype=np.uint8)
        orig_len = len(raw_data)

        pentary = BXOSGate.guard(((raw_data.astype(int) * 4) // 255) - 2)
        folded_state = self.logic_engine.fold(pentary)
        
        # Многоракурсный Rashomon-анализ текущего батча
        audit = self.rashomon.evaluate(pentary)
        print(f"   [Rashomon Audit] Size: {orig_len}B | Mean Energy: {audit['technical']:.3f} | Structural Risk: {audit['risk']:.3f}")

        # Безопасное приведение folded_state независимо от его типа
        if isinstance(folded_state, np.ndarray):
            mean_folded = float(np.mean(folded_state))
            int_folded = int(folded_state.flatten()[0] if folded_state.size > 0 else 0)
        elif isinstance(folded_state, (list, tuple)):
            mean_folded = float(np.mean(folded_state))
            int_folded = int(folded_state[0] if len(folded_state) > 0 else 0)
        else:
            mean_folded = float(folded_state)
            int_folded = int(folded_state)

        packed_payload = Radix5Packer.pack_pentary(pentary)
        header = struct.pack('>Ifb', orig_len, mean_folded, int_folded)
        return header + packed_payload

    def decode_block(self, encoded_block: bytes) -> bytes:
        if len(encoded_block) < 9:
            raise ValueError("V18 Error: Invalid block header length.")
            
        orig_len, folded_val, folded_int = struct.unpack('>Ifb', encoded_block[:9])
        packed_payload = encoded_block[9:]

        unpacked_pentary = Radix5Packer.unpack_pentary(packed_payload, orig_len)
        restored_bytes = np.clip(((unpacked_pentary.astype(int) + 2) * 255) // 4, 0, 255).astype(np.uint8)
        return bytes(restored_bytes)


class ZvdBitstreamManager:
    """Менеджер дискового бистрима (.zvd / ZV26) с защитной сигнатурой."""
    def __init__(self, filename: str):
        self.filename = filename
        self.write_buffer = []

    def write_packet(self, encoded_data: bytes):
        self.write_buffer.append(encoded_data)

    def flush_to_disk(self):
        with open(self.filename, "wb") as f:
            f.write(b"ZV26")
            for packet in self.write_buffer:
                packet_len = len(packet)
                f.write(struct.pack('>I', packet_len) + packet)
        file_size = os.path.getsize(self.filename)
        print(f"[+] Файл .zvd успешно записан. Общий объем архива: {file_size} байт.")
        self.write_buffer.clear()

    def read_from_disk(self) -> list:
        packets = []
        with open(self.filename, "rb") as f:
            magic = f.read(4)
            if magic != b"ZV26":
                raise ValueError("Критическая ошибка: Неверная сигнатура потока .zvd (ожидалась ZV26)!")
                
            while True:
                len_bytes = f.read(4)
                if not len_bytes or len(len_bytes) < 4:
                    break
                packet_len = struct.unpack('>I', len_bytes)[0]
                packet_data = f.read(packet_len)
                packets.append(packet_data)
        return packets


