class BXOSGate:
    """Детерминированный входной/выходной фильтр критических состояний с нулевой задержкой."""
    @staticmethod
    def guard(signal: np.ndarray) -> np.ndarray:
        return np.clip(signal, -2, 2)


class L3Triage:
    """Блок быстрого триажа (Fast-Path): квантование сигналов на уровни."""
    @staticmethod
    def process_vector(arr: np.ndarray, low: float = 0.3, high: float = 0.7) -> np.ndarray:
        res = np.zeros_like(arr, dtype=int)
        res[arr >= high] = 1
        res[arr <= low] = -1
        return res


class MultivaluedLogicEngine:
    """Универсальный контур свёртки: Гёдель/Клини (min) vs Коммутативный Лукасевич с окном по 5."""
    def __init__(self, strategy: Literal["godel", "luka"] = "luka"):
        if strategy not in ("godel", "luka"):
            raise ValueError("Стратегия должна быть 'godel' или 'luka'")
        self.strategy = strategy

    def fold(self, data: Union[Sequence[int], np.ndarray]) -> Union[int, np.ndarray]:
        arr = np.asarray(data, dtype=np.int8)
        clean_data = BXOSGate.guard(arr)
        
        if clean_data.ndim == 1:
            return self._reduce_1d(clean_data)
        return self._reduce_batch(clean_data)

    def _reduce_1d(self, arr: np.ndarray) -> int:
        """Оконный Лукасевич для одномерных потоковых данных."""
        if self.strategy == "godel":
            return int(np.minimum.reduce(arr))
        else:
            window_size = 5
            n_elem = arr.size
            remainder = n_elem % window_size
            if remainder != 0:
                pad_width = window_size - remainder
                arr = np.pad(arr, (0, pad_width), 'constant', constant_values=0)
            
            reshaped = arr.reshape(-1, window_size)
            n = reshaped.shape[-1]
            total_sum = np.sum(reshaped.astype(np.int16), axis=-1)
            window_res = np.maximum(-2, total_sum - 2 * (n - 1))
            # Возвращаем средний скалярный итог для 1D
            return int(np.round(np.mean(window_res)))

    def _reduce_batch(self, batch: np.ndarray) -> np.ndarray:
        """
        Промышленный оконный Лукасевич для двумерных батчей (матриц)
        с абсолютной защитой осей и размерностей.
        """
        if self.strategy == "godel":
            return np.minimum.reduce(batch, axis=-1)
        else:
            window_size = 5
            h, w = batch.shape
            remainder = w % window_size
            
            if remainder != 0:
                pad_width = window_size - remainder
                batch = np.pad(batch, ((0, 0), (0, pad_width)), 'constant', constant_values=0)
                w = batch.shape[1]
            
            reshaped = batch.reshape(h, -1, window_size)
            n = reshaped.shape[-1]
            total_sum = np.sum(reshaped.astype(np.int16), axis=-1)
            window_res = np.maximum(-2, total_sum - 2 * (n - 1))
            return window_res.astype(np.int8)


class PentarnyRashomon:
    """Многоракурсный блок валидации (Rashomon) для аудита тензорного поля."""
    PERSPECTIVES = ("technical", "operational", "structural", "boundary", "risk")

    @staticmethod
    def evaluate(matrix: np.ndarray) -> Dict[str, Union[float, np.ndarray]]:
        if matrix.size == 0:
            return {p: 0.0 for p in PentarnyRashomon.PERSPECTIVES}
        float_m = matrix.astype(float)
        return {
            "technical": np.mean(float_m, axis=-1),
            "operational": np.min(float_m, axis=-1),
            "structural": np.max(float_m, axis=-1),
            "boundary": np.std(float_m, axis=-1) if float_m.ndim > 0 else 0.0,
            "risk": -np.mean(np.abs(float_m), axis=-1)
        }


