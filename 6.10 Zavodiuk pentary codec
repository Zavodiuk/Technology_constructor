# МОДУЛЬ 3: МНОГОПОТОЧНЫЙ ПАРАЛЛЕЛЬНЫЙ ПРОЦЕССОР (PROCESS POOL EXECUTOR)
# ============================================================================
class ZvdParallelBatchProcessor:
    """
    Промышленный параллельный процессор для сжатия файлов 
    силами многопроцессорного пула (ProcessPoolExecutor) на всех ядрах CPU.
    """
    def __init__(self, codec_engine: ZvdHybridCodecEngine, block_size: int = 1024 * 1024):
        self.codec = codec_engine
        self.block_size = block_size
        self.num_workers = cpu_count()

    def compress_large_file(self, source_path: str, output_path: str):
        if not os.path.exists(source_path):
            raise FileNotFoundError(f"Исходный файл {source_path} не найден.")

        file_size = os.path.getsize(source_path)
        print(f"[*] Запуск параллельного сжатия: {source_path} ({file_size / (1024**2):.2f} МБ)")
        print(f"[*] Задействовано ядер CPU: {self.num_workers}")

        start_time = time.perf_counter()
        bitstream_mgr = ZvdBitstreamManager(output_path)

        tasks = []
        with open(source_path, "rb") as f:
            block_idx = 0
            while True:
                block_data = f.read(self.block_size)
                if not block_data:
                    break
                tasks.append((block_idx, block_data))
                block_idx += 1

        print(f"[*] Файл разбит на {len(tasks)} блоков. Распределение по процессору...")

        encoded_blocks = [None] * len(tasks)
        with concurrent.futures.ProcessPoolExecutor(max_workers=self.num_workers) as executor:
            future_to_idx = {
                executor.submit(self.codec.encode_block, data): idx for idx, data in tasks
            }

            for future in concurrent.futures.as_completed(future_to_idx):
                idx = future_to_idx[future]
                try:
                    encoded_blocks[idx] = future.result()
                except Exception as exc:
                    print(f"[!] Блок {idx} вызвал критическую ошибку: {exc}")
                    raise

        for packet in encoded_blocks:
            if packet is not None:
                bitstream_mgr.write_packet(packet)

        bitstream_mgr.flush_to_disk()
        end_time = time.perf_counter()
        print(f"[+] Сжатие завершено за {end_time - start_time:.4f} сек.")
        print(f"[+] Скорость обработки: {(file_size / (1024**2)) / (end_time - start_time + 1e-9):.2f} МБ/сек.")

    def decompress_large_file(self, zvd_path: str, restored_path: str):
        print(f"[*] Запуск параллельной декомпрессии: {zvd_path}")
        start_time = time.perf_counter()
        
        bitstream_mgr = ZvdBitstreamManager(zvd_path)
        packets = bitstream_mgr.read_from_disk()
        
        print(f"[*] Извлечено {len(packets)} пакетов. Распараллеливание декодера...")
        
        restored_blocks = [None] * len(packets)
        with concurrent.futures.ProcessPoolExecutor(max_workers=self.num_workers) as executor:
            future_to_idx = {
                executor.submit(self.codec.decode_block, packet): idx for idx, packet in enumerate(packets)
            }
            
            for future in concurrent.futures.as_completed(future_to_idx):
                idx = future_to_idx[future]
                restored_blocks[idx] = future.result()

        with open(restored_path, "wb") as f:
            for block in restored_blocks:
                if block is not None:
                    f.write(block)
                    
        end_time = time.perf_counter()
        print(f"[+] Декомпрессия завершена за {end_time - start_time:.4f} сек.")


