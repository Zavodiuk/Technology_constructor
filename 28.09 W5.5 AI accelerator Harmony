import numpy as np
import time
import hashlib
import json
from typing import Literal, Dict, Union, Sequence, Any, Generator
from dataclasses import dataclass


class BXOSGate:
    """Детерминированный входной/выходной фильтр критических состояний с нулевой задержкой."""
    
    @staticmethod
    def guard(signal: np.ndarray) -> np.ndarray:
        if np.issubdtype(signal.dtype, np.integer):
            return np.clip(signal, -2, 2)
        return np.clip(signal, -2.0, 2.0)


class BXOSReceiptGenerator:
    """Криптографический регистратор операций с фиксацией активной логической стратегии."""
    
    MASTER_SIGNATURE = "KEY-VZ-2026-MASTER-SIGNATURE"

    @classmethod
    def generate(cls, request_id: str, status: str, strategy: str, payload_summary: Dict[str, Any]) -> Dict[str, Any]:
        body = {
            "request_id": request_id,
            "status": status,
            "active_strategy": strategy,
            "timestamp_ns": time.time_ns(),
            "payload_digest": hashlib.sha256(str(payload_summary).encode()).hexdigest(),
            "authority_signature": cls.MASTER_SIGNATURE
        }
        serialized = json.dumps(body, sort_keys=True).encode()
        body["bxos_digest"] = hashlib.sha256(serialized).hexdigest()
        body["simulated"] = True
        return body


class L3Triage:
    """Блок быстрого триажа (Fast-Path): квантование сигналов на три уровня {-1, 0, 1}."""
    
    @staticmethod
    def process(value: float, low: float = 0.3, high: float = 0.7) -> int:
        if value >= high:
            return 1
        if value <= low:
            return -1
        return 0

    @staticmethod
    def process_vector(arr: np.ndarray, low: float = 0.3, high: float = 0.7) -> np.ndarray:
        condlist = [arr >= high, arr <= low]
        choicelist = [1, -1]
        return np.select(condlist, choicelist, default=0).astype(np.int8)


class MultivaluedLogicEngine:
    """Универсальный контур свёртки: Гёдель/Клини (min) vs Коммутативный Сильный Лукасевич (K=2)."""
    
    def __init__(self):
        pass

    def fold(self, data: Union[Sequence[int], np.ndarray], strategy: Literal["godel", "luka"] = "godel") -> Union[int, np.ndarray]:
        incoming_dtype = data.dtype if isinstance(data, np.ndarray) else np.int8
        arr = np.asarray(data, dtype=incoming_dtype)
        clean_data = BXOSGate.guard(arr)
        
        if clean_data.ndim == 1:
            return int(self._reduce_1d(clean_data, strategy))
        return self._reduce_batch(clean_data, strategy)

    def _reduce_1d(self, arr: np.ndarray, strategy: str) -> int:
        if strategy == "godel":
            return int(np.minimum.reduce(arr))
        else:
            n = len(arr)
            if n == 0:
                return -2
            total_sum = int(np.sum(arr, dtype=np.int16))
            return int(max(-2, total_sum - 2 * (n - 1)))

    def _reduce_batch(self, batch: np.ndarray, strategy: str) -> np.ndarray:
        if strategy == "godel":
            return np.minimum.reduce(batch, axis=-1)
        else:
            n = batch.shape[-1]
            total_sum = np.sum(batch.astype(np.int16), axis=-1)
            return np.maximum(-2, total_sum - 2 * (n - 1)).astype(np.int8)


class PentarnyRashomon:
    """Многоракурсный блок валидации (Rashomon): проверка цепи под разными углами."""
    
    PERSPECTIVES = ("technical", "operational", "structural", "boundary", "risk")

    @staticmethod
    def evaluate(matrix: np.ndarray) -> Dict[str, Union[float, np.ndarray]]:
        if matrix.size == 0:
            return {p: 0.0 for p in PentarnyRashomon.PERSPECTIVES}
            
        float_m = matrix.astype(np.float32)
        return {
            "technical": np.mean(float_m, axis=-1),
            "operational": np.min(float_m, axis=-1),
            "structural": np.max(float_m, axis=-1),
            "boundary": np.std(float_m, axis=-1) if float_m.ndim > 0 else 0.0,
            "risk": -np.mean(np.abs(float_m), axis=-1)
        }


class L5OntologyLayer:
    """Пять векторизованных слоёв онтологии без лишних аллокаций памяти."""
    
    LAYERS = ("intent", "goal", "ontology", "context", "action")

    def __init__(self):
        self.state = np.zeros(5, dtype=np.int8)

    def update(self, values: Sequence[int]) -> np.ndarray:
        if len(values) != 5:
            raise ValueError("L5-слой требует ровно 5 значений")
        self.state = BXOSGate.guard(np.array(values, dtype=np.int8))
        return self.state

    @property
    def system_energy(self) -> float:
        return float(np.sum(np.abs(self.state)) / 10.0)


@dataclass
class ProductionPipelineResult:
    status: str
    triage_state: int
    folded_result: int
    system_energy: float
    active_strategy: str
    rashomon_audit: Dict[str, Any]
    l5_state: list
    bxos_receipt: Dict[str, Any]


class W5AdaptiveProductionPipeline:
    """Полный адаптивный производственный пайплайн с динамическим переключением стратегий, OOM-Guard и крипто-квитанциями."""
    
    def __init__(self, stress_threshold: float = 0.70, chunk_size: int = 250_000):
        self.logic_engine = MultivaluedLogicEngine()
        self.ontology = L5OntologyLayer()
        self.rashomon = PentarnyRashomon()
        self.stress_threshold = stress_threshold
        self.chunk_size = chunk_size

    def _determine_strategy(self, stress_level: float) -> Literal["godel", "luka"]:
        """Динамический переключатель математического домена."""
        if stress_level >= self.stress_threshold:
            return "luka"  # Сильный Лукасевич для компенсации перегрузок
        return "godel"     # Консервативный Гёдель для штатных состояний

    def process(self, request_id: str, raw_score: float, l5_inputs: Sequence[int], current_stress: float = 0.45) -> ProductionPipelineResult:
        """Поточный запуск для одиночных транзакций с адаптивным выбором стратегии."""
        triage_state = L3Triage.process(raw_score)
        strategy = self._determine_strategy(current_stress)
        
        if triage_state == -1:
            receipt = BXOSReceiptGenerator.generate(request_id, "DENIED_BY_TRIAGE", strategy, {"raw_score": raw_score})
            return ProductionPipelineResult(
                status="REJECTED_BY_TRIAGE", triage_state=-1, folded_result=-2,
                system_energy=0.0, active_strategy=strategy, rashomon_audit={}, l5_state=list(l5_inputs), bxos_receipt=receipt
            )

        l5_arr = self.ontology.update(l5_inputs)
        folded = self.logic_engine.fold(l5_arr, strategy=strategy)
        audit_res = self.rashomon.evaluate(l5_arr)
        
        payload_meta = {"folded_result": int(folded), "system_energy": self.ontology.system_energy, "stress_level": current_stress}
        receipt = BXOSReceiptGenerator.generate(request_id, "AUTHORIZED_PASS", strategy, payload_meta)

        return ProductionPipelineResult(
            status="OK", triage_state=triage_state, folded_result=int(folded),
            system_energy=self.ontology.system_energy, active_strategy=strategy,
            rashomon_audit={k: (v.item() if isinstance(v, np.generic) else v) for k, v in audit_res.items()},
            l5_state=l5_arr.tolist(), bxos_receipt=receipt
        )

    def process_large_stream(self, stream_id: str, large_matrix: np.ndarray, current_stress: float = 0.45) -> Generator[Dict[str, Any], None, None]:
        """Чанкинг-обработка сверхбольших массивов данных с защитой памяти (OOM-Guard) и адаптивным выбором стратегии."""
        total_rows = large_matrix.shape[0]
        strategy = self._determine_strategy(current_stress)
        
        for i in range(0, total_rows, self.chunk_size):
            chunk = large_matrix[i:i + self.chunk_size]
            clean_chunk = BXOSGate.guard(chunk)
            
            folded = self.logic_engine.fold(clean_chunk, strategy=strategy)
            audit_res = self.rashomon.evaluate(clean_chunk)
            
            tech_mean = float(np.mean(audit_res["technical"])) if isinstance(audit_res["technical"], np.ndarray) else float(audit_res["technical"])
            payload_meta = {"chunk_len": len(chunk), "stress_level": current_stress, "technical_mean": tech_mean}
            receipt = BXOSReceiptGenerator.generate(f"{stream_id}-CHNK-{i//self.chunk_size}", "STREAM_PASS", strategy, payload_meta)
            
            yield {
                "status": "CHUNK_OK",
                "chunk_index": i // self.chunk_size,
                "strategy_used": strategy,
                "folded_sample": (folded[:3].tolist() if folded.ndim > 0 else [int(folded)]),
                "bxos_receipt": receipt
            }


