# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ---------------------------------------------------------------------------
def b64_encode(b: bytes) -> str:
    return base64.b64encode(b).decode("utf-8")


def b64_decode(s: str) -> bytes:
    return base64.b64decode(s.encode("utf-8"))


