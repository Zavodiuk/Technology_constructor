# ДИСКОВЫЙ БЭКЕНД (оригинальный TypeAgnosticStore)
# ---------------------------------------------------------------------------
class TypeAgnosticStore:
    """Персистентный менеджер хранения на диске."""
    def __init__(self, storage_dir: str = "./w55_dc_storage"):
        self.storage_dir = storage_dir
        os.makedirs(storage_dir, exist_ok=True)
        self.registry: Dict[str, Dict[str, Any]] = {}
        self._load_registry()

    def _load_registry(self):
        idx_file = os.path.join(self.storage_dir, "_registry.json")
        if os.path.exists(idx_file):
            try:
                with open(idx_file, "r", encoding="utf-8") as f:
                    self.registry = json.load(f)
            except Exception:
                self.registry = {}

    def _save_registry(self):
        idx_file = os.path.join(self.storage_dir, "_registry.json")
        with open(idx_file, "w", encoding="utf-8") as f:
            json.dump(self.registry, f, ensure_ascii=False, indent=2)

    def write_record(self, record: UniversalSemanticRecord) -> str:
        safe_name = hashlib.sha256(record.record_id.encode()).hexdigest()[:32]
        file_path = os.path.join(self.storage_dir, f"{safe_name}.bxos")

        container = {
            "record_id": record.record_id,
            "data_type": record.data_type,
            "schema_version": record.schema_version,
            "ontology_vector": record.ontology_vector,
            "payload_b64": b64_encode(record.compressed_payload),
            "original_size": record.original_size,
            "bxos_checksum": record.bxos_checksum,
            "timestamp_ns": record.timestamp_ns
        }

        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(container, f)

        self.registry[record.record_id] = {
            "file_path": file_path,
            "bxos_checksum": record.bxos_checksum
        }
        self._save_registry()
        return record.bxos_checksum

    def fetch_record(self, record_id: str) -> UniversalSemanticRecord:
        if record_id not in self.registry:
            raise KeyError(f"Запись {record_id} не найдена.")
        meta = self.registry[record_id]
        with open(meta["file_path"], "r", encoding="utf-8") as f:
            d = json.load(f)

        return UniversalSemanticRecord(
            record_id=d["record_id"],
            data_type=d["data_type"],
            schema_version=d["schema_version"],
            ontology_vector=d["ontology_vector"],
            compressed_payload=b64_decode(d["payload_b64"]),
            original_size=d["original_size"],
            bxos_checksum=d["bxos_checksum"],
            timestamp_ns=d["timestamp_ns"]
        )


# ---------------------------------------------------------------------------
# ГИБРИДНЫЙ СЛОЙ ХРАНЕНИЯ: СНАЧАЛА RecursiveCube → ПОТОМ ДИСК
# Автор: Владимир Заводюк
# ---------------------------------------------------------------------------
class HybridDenseStore:
    """
    Гибридное сверхплотное хранилище.
    1. Данные сначала упаковываются в RecursiveCube (глубина 3).
    2. Затем надёжно сбрасываются на диск через TypeAgnosticStore.
    """

    def __init__(self, storage_dir: str = "./w55_dc_storage"):
        self.cube = RecursiveCube(side=5, depth=3)          # основной плотный слой
        self.disk = TypeAgnosticStore(storage_dir=storage_dir)  # страховочный слой
        self._cube_index: Dict[str, int] = {}               # record_id → позиция в кубе

    def write_record(self, record: UniversalSemanticRecord) -> str:
        # 1. Упаковка в рекурсивный куб
        #    (храним сам объект записи для максимальной плотности и быстрого доступа)
        position = self.cube._count_filled()
        self.cube.pack([record])
        self._cube_index[record.record_id] = position

        print(f"  [Hybrid] Запись '{record.record_id}' упакована в RecursiveCube "
              f"(позиция ≈ {position}, плотность куба: {self.cube.density():.4%})")

        # 2. Обязательный сброс на диск
        checksum = self.disk.write_record(record)
        print(f"  [Hybrid] Запись дополнительно сохранена на диск (BXOS).")
        return checksum

    def fetch_record(self, record_id: str) -> UniversalSemanticRecord:
        # Сначала пытаемся достать из куба (быстрый путь)
        if record_id in self._cube_index:
            all_records = self.cube.unpack()
            for rec in all_records:
                if isinstance(rec, UniversalSemanticRecord) and rec.record_id == record_id:
                    print(f"  [Hybrid] Запись '{record_id}' извлечена из RecursiveCube (быстрый путь).")
                    return rec

        # Фоллбэк на диск
        print(f"  [Hybrid] Запись '{record_id}' извлечена с диска.")
        return self.disk.fetch_record(record_id)

    def cube_summary(self) -> str:
        return self.cube.summary()


