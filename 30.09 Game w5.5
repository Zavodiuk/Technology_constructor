from dataclasses import dataclass, asdict as _asdict

@dataclass
class UnifiedContourResult:
    query: str
    best_candidate: object
    composite_score: float
    geometry_mode: str
    leading_maschera: object
    stability_index: float
    lomonosov_trend: str
    lomonosov_level: int
    w55_status: str
    triage_state: int
    active_strategy: str
    folded_result: int
    system_energy: float
    bxos_digest: str
    decision: str
    latency_ms: float
    version: str = "Game+W5.5 Monolith V1"


def game_result_to_w55_inputs(game_result, interpretations):
    names = list(interpretations.keys())
    confidences = [float(interpretations[n]) for n in names]
    while len(confidences) < 2:
        confidences.append(0.0)
    scores_row = confidences[:8]

    stability = float(game_result.get("stability_index", 0.5))
    composite = float(game_result.get("best_composite_score", 0.5))
    conflicts = float(game_result.get("conflicts_count", 0))
    node_count = max(float(game_result.get("node_count", 1)), 1.0)
    conflict_ratio = min(1.0, conflicts / node_count)
    balanced = 1.0 if game_result.get("is_balanced") else 0.0
    coherence = 1.0 if game_result.get("teatro", {}).get("coherence") else 0.0

    def to_pentary(x: float) -> int:
        v = int(round((x * 4.0) - 2.0))
        return max(-2, min(2, v))

    l5 = [
        to_pentary(composite),
        to_pentary(stability),
        to_pentary(coherence),
        to_pentary(1.0 - conflict_ratio),
        to_pentary(balanced),
    ]
    raw_score = composite
    stress = float(max(0.0, min(0.99, 0.55 * conflict_ratio + 0.45 * (1.0 - stability))))
    return [scores_row], [l5], raw_score, stress


def map_to_decision(triage_state: int, w55_status: str, composite: float) -> str:
    if triage_state == -1 or w55_status == "REJECTED_BY_TRIAGE":
        return "REJECT"
    if triage_state == 0 or composite < 0.45:
        return "CLARIFY"
    return "PASS"


class GameW55UnifiedContour:
    def __init__(self, stress_threshold: float = 0.70):
        self.game = GameEngineV9Improved()
        self.w55 = W5AdaptiveProductionPipeline(stress_threshold=stress_threshold)

    def run(self, query: str, interpretations: dict, request_id=None, force_stress=None) -> UnifiedContourResult:
        t0 = time.perf_counter()
        rid = request_id or f"UNIFIED-{int(time.time_ns() % 1_000_000_000)}"

        game_out = self.game.process(query, interpretations)
        scores_batch, l5_batch, raw_score, stress = game_result_to_w55_inputs(game_out, interpretations)
        if force_stress is not None:
            stress = force_stress

        w55_res = self.w55.process(
            request_id=rid,
            raw_score=raw_score,
            l5_inputs=l5_batch[0],
            current_stress=stress,
        )
        try:
            self.w55.run(scores_batch, l5_batch, current_stress=stress)
        except Exception:
            pass

        decision = map_to_decision(
            w55_res.triage_state,
            w55_res.status,
            float(game_out.get("best_composite_score", 0.0)),
        )
        latency = (time.perf_counter() - t0) * 1000.0
        digest = ""
        if w55_res.bxos_receipt:
            digest = str(w55_res.bxos_receipt.get("bxos_digest", ""))

        return UnifiedContourResult(
            query=query,
            best_candidate=game_out.get("best_candidate"),
            composite_score=float(game_out.get("best_composite_score", 0.0)),
            geometry_mode=str(game_out.get("geometry_mode", "")),
            leading_maschera=(game_out.get("teatro") or {}).get("leading_maschera"),
            stability_index=float(game_out.get("stability_index", 0.0)),
            lomonosov_trend=(game_out.get("lomonosov") or {}).get("trend", ""),
            lomonosov_level=int((game_out.get("lomonosov") or {}).get("level", 0)),
            w55_status=w55_res.status,
            triage_state=int(w55_res.triage_state),
            active_strategy=str(w55_res.active_strategy),
            folded_result=int(w55_res.folded_result),
            system_energy=float(w55_res.system_energy),
            bxos_digest=digest,
            decision=decision,
            latency_ms=latency,
        )

    def run_as_dict(self, query: str, interpretations: dict, **kwargs) -> dict:
        return _asdict(self.run(query, interpretations, **kwargs))


