class GameEngineV9Improved:
    """Улучшенный Game Engine V9 с правильной интеграцией всех компонентов"""
    
    def __init__(self):
        self.geometry = GeometryEngine()
        self.wave_system = InterferenceMatrix(self.geometry)
        self.kirchhoff = KirchhoffBalance()
        self.lomonosov = LomonosovSpiral()
        self.teatro = TeatroDelleMaschere()
        self.experience = ExperienceModule()
        self.nodes: Dict[int, WaveNode] = {}
        self.node_counter = 0
        self.history = []
        self.current_time = 0.0

    def _add_node(self, name: str, amplitude: float, phase: float, 
                  position: Tuple[float, float]) -> int:
        """Добавить узел волны"""
        self.node_counter += 1
        node = WaveNode(
            id=self.node_counter,
            amplitude=amplitude,
            phase=phase,
            position=position,
            children=[],
            parents=[]
        )
        self.nodes[node.id] = node
        self.wave_system.add_node(node)
        return node.id

    def _connect_nodes(self, from_id: int, to_id: int):
        """Связать узлы волн"""
        if from_id in self.nodes and to_id in self.nodes:
            if to_id not in self.nodes[from_id].children:
                self.nodes[from_id].children.append(to_id)
            if from_id not in self.nodes[to_id].parents:
                self.nodes[to_id].parents.append(from_id)

    def _distribute_nodes_in_space(self, count: int) -> List[Tuple[float, float]]:
        """Распределить узлы по кругу в пространстве"""
        positions = []
        for i in range(count):
            angle = 2 * math.pi * i / count
            x = 0.5 * math.cos(angle)
            y = 0.5 * math.sin(angle)
            positions.append((x, y))
        return positions

    def process(self, query: str, interpretations: Dict[str, float]) -> Dict[str, Any]:
        """Выполнить полный цикл обработки запроса"""
        self.current_time += 1.0

        # ====== ФАЗА 1: ГЕОМЕТРИЯ ======
        selected_mode = self.geometry.select_mode_by_task(query, interpretations)
        self.geometry.set_mode(selected_mode)

        # ====== ФАЗА 2: ВОЛНОВЫЕ УЗЛЫ (РАСПРЕДЕЛЁННЫЕ В ПРОСТРАНСТВЕ) ======
        positions = self._distribute_nodes_in_space(len(interpretations))
        node_ids = {}
        
        for (name, score), (x, y) in zip(interpretations.items(), positions):
            # Амплитуда = уверенность, фаза = порядок узла
            phase = len(node_ids) * 0.5
            node_id = self._add_node(name, score, phase, (x, y))
            node_ids[name] = node_id

        # ====== ФАЗА 3: СВЯЗИ МЕЖДУ УЗЛАМИ ======
        node_list = list(node_ids.values())
        for i in range(len(node_list) - 1):
            self._connect_nodes(node_list[i], node_list[i + 1])

        # ====== ФАЗА 4: ВОЛНОВАЯ ФИЗИКА ======
        self.wave_system.propagate_waves(self.current_time)
        pattern = self.wave_system.interference_pattern(self.current_time)
        conflicts = self.wave_system.find_conflicts(self.current_time)
        stability = self.wave_system.stability_index(self.current_time)

        # ====== ФАЗА 5: КИРХГОФ (БАЛАНС) ======
        graph = {nid: node.children for nid, node in self.nodes.items()}
        cycles = self.kirchhoff.find_cycles(graph)
        balance = self.kirchhoff.system_balance(pattern)
        is_balanced = self.kirchhoff.is_balanced(pattern)

        # ====== ФАЗА 6: ТЕАТР МАСОК ======
        teatro_evaluation = self.teatro.evaluate(interpretations)
        leading_maschera = self.teatro.find_leading_maschera(teatro_evaluation)

        # ====== ФАЗА 7: ОПЫТ ======
        experience_scores = {}
        for name in interpretations.keys():
            exp_score = self.experience.predict(name)
            experience_scores[name] = exp_score

        # ====== ФАЗА 8: КОМБИНИРОВАННЫЙ ВЫБОР КАНДИДАТА ======
        best_candidate = None
        best_composite_score = -float('inf')
        candidate_scores = {}

        for name, node_id in node_ids.items():
            # Компонента 1: Волновая амплитуда (нормализованная)
            wave_amplitude = pattern.get(node_id, 0.0)
            wave_score = (wave_amplitude + 1.0) / 2.0  # Нормализуем в [0, 1]
            
            # Компонента 2: Оценка театра
            teatro_score = 0.5
            if "results" in teatro_evaluation and name in teatro_evaluation["results"]:
                teatro_score = teatro_evaluation["results"][name]["score"]
            
            # Компонента 3: Опыт
            exp_score = experience_scores.get(name, 0.5)
            
            # Компонента 4: Базовая уверенность (интерпретация)
            confidence = interpretations.get(name, 0.5)
            
            # КОМБИНИРОВАННЫЙ СКОР (weighted average)
            composite_score = (
                0.25 * wave_score +
                0.30 * teatro_score +
                0.25 * exp_score +
                0.20 * confidence
            )
            
            candidate_scores[name] = {
                "wave": round(wave_score, 3),
                "teatro": round(teatro_score, 3),
                "experience": round(exp_score, 3),
                "confidence": round(confidence, 3),
                "composite": round(composite_score, 3)
            }
            
            if composite_score > best_composite_score:
                best_composite_score = composite_score
                best_candidate = name

        # ====== ФАЗА 9: ЛОМОНОСОВСКАЯ СПИРАЛЬ ======
        # Реальный gain/loss на основе стабильности и согласованности
        stability_gain = stability  # Насколько система стабильна
        conflict_loss = len(conflicts) / max(len(self.nodes), 1)  # Потеря от конфликтов
        coherence_factor = 1.0 if teatro_evaluation.get("coherence", False) else 0.5
        
        gain = stability_gain * coherence_factor * best_composite_score
        loss = conflict_loss * (1.0 - stability)
        
        lomonosov_event = {
            "reason": query,
            "location": "GameEngine V9.6 Improved",
            "timestamp": time.time(),
            "gain": gain,
            "loss": loss
        }
        lomonosov_result = self.lomonosov.analyze_event(lomonosov_event)

        # ====== ИСТОРИЯ ======
        self.history.append({
            'time': self.current_time,
            'query': query,
            'best_candidate': best_candidate,
            'stability': stability,
            'conflicts': len(conflicts),
            'is_balanced': is_balanced,
            'leading_maschera': leading_maschera,
            'composite_score': best_composite_score,
            'lomonosov_level': self.lomonosov.get_level()
        })

        # ====== ВОЗВРАЩАЕМ РЕЗУЛЬТАТ ======
        return {
            'status': 'success',
            'query': query,
            'best_candidate': best_candidate,
            'best_composite_score': round(best_composite_score, 3),
            'candidate_scores': candidate_scores,
            'stability_index': round(stability, 3),
            'conflicts_count': len(conflicts),
            'is_balanced': is_balanced,
            'system_balance': round(balance, 3),
            'cycles_count': len(cycles),
            'node_count': len(self.nodes),
            'geometry_mode': self.geometry.mode.value,
            'curvature': self.geometry.curvature,
            'teatro': {
                'leading_maschera': leading_maschera,
                'coherence': teatro_evaluation.get("coherence", False),
                'coherence_std_dev': teatro_evaluation.get("std_dev", 0),
                'weighted_sum': teatro_evaluation.get("weighted_sum", 0)
            },
            'lomonosov': {
                'gain': round(gain, 3),
                'loss': round(loss, 3),
                'level': lomonosov_result['spiral_level'],
                'direction': lomonosov_result['direction'],
                'trend': self.lomonosov.get_trend()
            },
            'time': self.current_time,
            'version': 'V9.6 Improved'
        }

    def get_state(self) -> Dict:
        """Получить текущее состояние"""
        return {
            'version': 'V9.6 Improved',
            'nodes': len(self.nodes),
            'history_len': len(self.history),
            'current_time': self.current_time,
            'stability': round(self.wave_system.stability_index(self.current_time), 3),
            'geometry_mode': self.geometry.mode.value,
            'lomonosov_level': self.lomonosov.get_level(),
            'lomonosov_trend': self.lomonosov.get_trend(),
            'experience_records': len(self.experience.records)
        }

    def get_history(self, limit: int = 5) -> List[Dict]:
        """Получить последние N записей"""
        return self.history[-limit:]

    def add_experience(self, interpretation: str, outcome: float):
        """Добавить опыт"""
        self.experience.add({"interpretation": interpretation}, outcome)


