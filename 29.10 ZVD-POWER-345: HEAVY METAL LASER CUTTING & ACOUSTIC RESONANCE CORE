@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_guard(signal: np.ndarray) -> np.ndarray:
    np.clip(signal, -2, 2, out=signal)
    return signal


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_translate_to_power_streams(
    cubes_arr: np.ndarray, 
    tiles_y: int, 
    tiles_x: int, 
    out_powers: np.ndarray, 
    out_frequencies: np.ndarray, 
    out_coords: np.ndarray
):
    """
    ===================================================================
    BRANCHLESS JIT POWER MODULATION & ACOUSTIC RESONANCE KERNEL
    ===================================================================
    Reads the 3-4-5 tetrahedral faces and translates them directly into 
    heavy metal cutting parameters:
    - Quad energy (0..3) -> Diode/Fiber pump power (25%, 50%, 75%, 100%).
    - Trit motion (-1..1) -> Ultrasonic frequency shift for slag ejection.
    - Cartesian grid coordinates -> Strict orthogonal positioning.
    ===================================================================
    """
    num_cubes = tiles_y * tiles_x
    
    for idx in prange(num_cubes):
        ty = idx // tiles_x
        tx = idx % tiles_x
        y0 = ty * 5
        x0 = tx * 5
        
        for y in range(5):
            for x in range(5):
                target_y = y0 + y
                target_x = x0 + x
                
                for t in range(5):
                    # Read Face 0 (Motion) and Face 1 (Energy) from 3-4-5 layers
                    penta_motion = int(cubes_arr[idx, y, x, t, FACE_MOTION]) - 2
                    penta_energy = int(cubes_arr[idx, y, x, t, FACE_ENERGY]) - 2
                    
                    # Branchless unpacking via static JIT table
                    pm_idx = penta_motion + 2
                    if pm_idx < 0: pm_idx = 0
                    if pm_idx > 4: pm_idx = 4
                    trit = _JIT_UNPACK_LUT[pm_idx, 0]  # -1, 0, or 1
                    
                    pe_idx = penta_energy + 2
                    if pe_idx < 0: pe_idx = 0
                    if pe_idx > 4: pe_idx = 4
                    quad = _JIT_UNPACK_LUT[pe_idx, 1]  # 0 to 3
                    
                    # 1. Map quad to power level percentage (25%, 50%, 75%, 100%)
                    q_clamped = quad
                    if q_clamped < 0: q_clamped = 0
                    if q_clamped > 3: q_clamped = 3
                    power_pct = (q_clamped + 1) * 25
                    
                    # 2. Map trit to acoustic frequency modulation offset (Hz / kHz scale)
                    # -1 -> Low frequency deep penetration (-500 Hz)
                    #  0 -> Base acoustic resonance frequency (0 Hz offset)
                    # +1 -> High-speed ultrasonic slag blowout (+1000 Hz)
                    freq_offset_hz = 0
                    if trit == -1:
                        freq_offset_hz = -500
                    elif trit == 1:
                        freq_offset_hz = 1000
                        
                    flat_target_idx = idx * (5 * 5 * 5) + (y * 25 + x * 5 + t)
                    out_powers[flat_target_idx] = np.uint8(power_pct)
                    out_frequencies[flat_target_idx] = np.int32(20000 + freq_offset_hz)  # Base 20kHz acoustic carrier
                    out_coords[flat_target_idx, 0] = np.int32(target_y)
                    out_coords[flat_target_idx, 1] = np.int32(target_x)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_calculate_mean_energy(data: np.ndarray, semantic_data: np.ndarray) -> float:
    d_flat = data.ravel()
    s_flat = semantic_data.ravel()
    n = d_flat.size
    d_sum = 0.0
    s_sum = 0.0
    for i in range(n):
        d_sum += abs(int(d_flat[i]) - 2)
        s_sum += abs(int(s_flat[i]) - 2)
    return float((d_sum / n + s_sum / n) / 2.0)


