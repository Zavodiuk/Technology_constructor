def pentary_to_ternary(value: int) -> int:
    """Конвертация пентарного значения (-2..2) в троичный базис (-1, 0, 1)."""
    if value <= -1:
        return -1
    if value >= 1:
        return 1
    return 0


def from_pentary(l5_values: Dict[str, int]) -> TernaryMatrix:
    """Создание диагональной троичной матрицы 5x5 из пяти пентарных слоев."""
    order = ['intent', 'goal', 'ontology', 'context', 'action']
    n = len(order)
    data = [[0] * n for _ in range(n)]
    for i, layer in enumerate(order):
        v = l5_values.get(layer, 0)
        data[i][i] = pentary_to_ternary(v)
    return TernaryMatrix(data)


