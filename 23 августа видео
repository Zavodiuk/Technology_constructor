import kotlin.math.*

// Шаг 1: Троичный граф компрессии (Base Ternary Graph)
class TernaryGraphNode(val id: Int) {
    // Состояния троичной логики: -1 (спад), 0 (базовый уровень), +1 (рост)
    val ternaryStates: MutableMap<Int, Int> = mutableMapOf()
    val neighbors: MutableList<TernaryGraphNode> = mutableListOf()

    fun evaluateDelta(currentVal: Double, baseline: Double, threshold: Double): Int {
        return when {
            currentVal < baseline - threshold -> -1
            currentVal > baseline + threshold -> 1
            else -> 0
        }
    }
}

class TernaryCompressionPipeline {
    private val nodes = mutableListOf<TernaryGraphNode>()

    fun addNode(node: TernaryGraphNode) {
        nodes.add(node)
    }

    fun compressStream(rawStream: List<Double>, threshold: Double): List<Int> {
        val compressedCodes = mutableListOf<Int>()
        var baseline = rawStream.firstOrNull() ?: 0.0

        for ((index, value) in rawStream.withIndex()) {
            val node = nodes.getOrElse(index % nodes.size) { TernaryGraphNode(index).also { nodes.add(it) } }
            val state = node.evaluateDelta(value, baseline, threshold)
            compressedCodes.add(state)
            baseline = value
        }
        return compressedCodes
    }
}

// Шаг 2: Пентаричный узел и дерево познания Ломоносова
class PentanaryKnowledgeNode(val level: Int) {
    // Пентаричные состояния: от -2 до +2
    val subNodes: MutableMap<Int, PentanaryKnowledgeNode> = mutableMapOf()
    var patternWeight: Double = 1.0

    fun evaluatePentanaryState(deltaValue: Double, step: Double): Int {
        return when {
            deltaValue < -2 * step -> -2
            deltaValue < -step -> -1
            deltaValue > 2 * step -> 2
            deltaValue > step -> 1
            else -> 0
        }
    }
}

class LomonosovKnowledgeTree {
    private val root = PentanaryKnowledgeNode(0)

    fun ingestPattern(sequence: List<Int>, step: Double) {
        var currentNode = root
        for (state in sequence) {
            currentNode = currentNode.subNodes.getOrPut(state) {
                PentanaryKnowledgeNode(currentNode.level + 1)
            }
            currentNode.patternWeight += 1.0
        }
    }

    fun getWeightSum(): Double {
        fun calculateWeight(node: PentanaryKnowledgeNode): Double {
            var sum = node.patternWeight
            for ((_, child) in node.subNodes) {
                sum += calculateWeight(child)
            }
            return sum
        }
        return calculateWeight(root)
    }
}

// Шаг 3: Многомерные матричные структуры (Версии 9-10+)
class MatrixNode(val matrixId: Int, val dimension: Int) {
    val dataMatrix: Array<DoubleArray> = Array(dimension) { DoubleArray(dimension) { 0.0 } }

    fun packMatrixData(rawChunk: List<Double>) {
        var index = 0
        for (i in 0 until dimension) {
            for (j in 0 until dimension) {
                if (index < rawChunk.size) {
                    dataMatrix[i][j] = rawChunk[index++]
                }
            }
        }
    }

    fun compressToMatrixVector(): Double {
        var checksum = 0.0
        for (i in 0 until dimension) {
            for (j in 0 until dimension) {
                checksum += dataMatrix[i][j] * (i + j + 1)
            }
        }
        return checksum
    }
}

class MatrixCompressionGrid {
    private val gridNodes = mutableMapOf<Int, MatrixNode>()

    fun registerMatrixBlock(id: Int, dim: Int, chunk: List<Double>): Double {
        val node = MatrixNode(id, dim)
        node.packMatrixData(chunk)
        gridNodes[id] = node
        return node.compressToMatrixVector()
    }
}

