# 4. СЕТЕВОЙ СТЕК PTCP И КРИПТОГРАФИЯ P-CHAIN
# ---------------------------------------------------------------------
class HybridPentanaryNetworkStack:
    def __init__(self, cog_core):
        self.cog_core = cog_core

    def create_cognitive_packet(self, address_vector, payload_trits):
        consensus, status = self.cog_core.compute_rashomon_consensus(payload_trits)
        header_flag = -2 if consensus == -2 else consensus
        packet = address_vector + [header_flag] + payload_trits
        return packet, f"Packet built. Status: {status}"

class HybridPentanaryCryptography:
    def __init__(self, cog_core):
        self.cog_core = cog_core
        self.alu_base = HybridPentanaryALU(cog_core)

    def generate_cognitive_p_hash(self, trit_stream):
        hash_vector = [0, -1, 2, -2, 1, 0, 1, -1, 2]
        if not trit_stream: return hash_vector
        consensus, _ = self.cog_core.compute_rashomon_consensus(trit_stream)
        
        for i, trit in enumerate(trit_stream):
            target_index = i % len(hash_vector)
            modulated = -trit if consensus == -2 else trit
            res, carry = self.alu_base.balanced_pentanary_operation(hash_vector[target_index], modulated, [modulated])
            hash_vector[target_index] = res if isinstance(res, int) else 0
        return hash_vector

class HybridPentanaryBlockchain:
    def __init__(self, cog_core):
        self.cog_core = cog_core
        self.crypto = HybridPentanaryCryptography(cog_core)
        self.chain = []
        self.create_genesis_block()

    def create_genesis_block(self):
        genesis_hash = [0] * 9
        genesis_payload = [1, 2, -2, -1, 0]
        block_hash = self.crypto.generate_cognitive_p_hash(genesis_payload)
        self.chain.append({
            "index": 0, "prev_hash": genesis_hash, "payload": genesis_payload, "hash": block_hash, "pot_status": "GENESIS_SECURE"
        })

    def add_cognitive_block(self, transaction_trits):
        consensus, status = self.cog_core.compute_rashomon_consensus(transaction_trits)
        if consensus == -2:
            return f"PoT Rejection: Block rejected due to critical logical tension (-2). {status}."
        
        prev_block = self.chain[-1]
        prev_hash = prev_block["hash"]
        current_hash = self.crypto.generate_cognitive_p_hash(prev_hash + transaction_trits)
        
        new_block = {
            "index": len(self.chain), "prev_hash": prev_hash, "payload": transaction_trits, "hash": current_hash, "pot_status": f"VERIFIED_CONSENSUS_{consensus}"
        }
        self.chain.append(new_block)
        return f"Block #{new_block['index']} successfully mined via Proof-of-Tension. {status}"


