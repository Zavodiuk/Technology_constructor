# 1. КОГНИТИВНОЕ ЯДРО (БЛОК X v6 + RASHOMON LAYER)
# ---------------------------------------------------------------------
class CognitiveBlockXCore:
    def __init__(self):
        self.active_state = 0 
        
    def evaluate_input_trit(self, raw_value):
        if raw_value < -0.5: return -1
        elif raw_value > 0.5: return 1
        else: return 0

    def compute_rashomon_consensus(self, hypothesis_list):
        if not hypothesis_list:
            return 0, "EMPTY_HYPOTHESIS"
        
        mean_val = sum(hypothesis_list) / len(hypothesis_list)
        variance = sum((x - mean_val) ** 2 for x in hypothesis_list) / len(hypothesis_list)
        std_dev = math.sqrt(variance)
        
        if std_dev > 1.2:
            return -2, f"RASHOMON_CRITICAL_DISAGREEMENT (StdDev: {std_dev:.2f})"
        elif std_dev > 0.6:
            return 0, f"RASHOMON_NEUTRAL_UNCERTAINTY (StdDev: {std_dev:.2f})"
        else:
            consensus = max(-1, min(1, round(mean_val)))
            return consensus, f"RASHOMON_CONSENSUS_ACHIEVED (StdDev: {std_dev:.2f})"


