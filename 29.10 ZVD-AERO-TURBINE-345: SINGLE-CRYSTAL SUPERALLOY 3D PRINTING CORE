# 1. SACRED 3-4-5 TETRAHEDRAL GEOMETRY & LOOKUP TABLES
# =====================================================================

_JIT_UNPACK_LUT = np.array([
    [-1, 0],  # penta -2 -> trit -1, quad 0
    [-1, 2],  # penta -1 -> trit -1, quad 2
    [ 0, 1],  # penta  0 -> trit  0, quad 1
    [ 0, 3],  # penta  1 -> trit  0, quad 3
    [ 1, 2]   # penta  2 -> trit +1, quad 2
], dtype=np.int8)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_unpack_345(penta: int) -> Tuple[int, int]:
    p_idx = penta + 2
    if p_idx < 0: p_idx = 0
    if p_idx > 4: p_idx = 4
    res = _JIT_UNPACK_LUT[p_idx]
    return int(res[0]), int(res[1])


# =====================================================================
# 2. BARE-METAL JIT KERNELS (ZERO-ALLOCATION, BRANCHLESS)
# =====================================================================

@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_guard(signal: np.ndarray) -> np.ndarray:
    np.clip(signal, -2, 2, out=signal)
    return signal


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_translate_to_turbine_streams(
    cubes_arr: np.ndarray, 
    tiles_y: int, 
    tiles_x: int, 
    out_frequencies: np.ndarray, 
    out_powers: np.ndarray, 
    out_coords: np.ndarray
):
    """
    Branchless JIT kernel translating tetrahedral volumes into Flat-top power density 
    and ultrasonic acoustic resonance parameters for single-crystal superalloy printing.
    """
    num_cubes = tiles_y * tiles_x
    
    for idx in prange(num_cubes):
        ty = idx // tiles_x
        tx = idx % tiles_x
        y0 = ty * 5
        x0 = tx * 5
        
        for y in range(5):
            for x in range(5):
                target_y = y0 + y
                target_x = x0 + x
                
                for t in range(5):
                    penta_byte = cubes_arr[idx, y, x, t, 0]
                    penta_val = int(penta_byte) - 2
                    
                    p_idx = penta_val + 2
                    if p_idx < 0: p_idx = 0
                    if p_idx > 4: p_idx = 4
                    
                    trit = _JIT_UNPACK_LUT[p_idx, 0]
                    quad = _JIT_UNPACK_LUT[p_idx, 1]
                    
                    # 1. Map trit to acoustic frequency offset for parasitic grain suppression
                    freq_offset_hz = 0
                    if trit == -1:
                        freq_offset_hz = -500  # Deep root penetration mode
                    elif trit == 1:
                        freq_offset_hz = 1500  # High-frequency shockwave to eject micro-defects
                        
                    # 2. Map quad to Flat-top laser power density percentage (25%, 50%, 75%, 100%)
                    q_clamped = quad
                    if q_clamped < 0: q_clamped = 0
                    if q_clamped > 3: q_clamped = 3
                    power_pct = (q_clamped + 1) * 25
                    
                    flat_target_idx = idx * (5 * 5 * 5) + (y * 25 + x * 5 + t)
                    out_frequencies[flat_target_idx] = np.int32(25000 + freq_offset_hz) # 25kHz base acoustic carrier
                    out_powers[flat_target_idx] = np.uint8(power_pct)
                    out_coords[flat_target_idx, 0] = np.int32(target_y)
                    out_coords[flat_target_idx, 1] = np.int32(target_x)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_calculate_mean_energy(data: np.ndarray, semantic_data: np.ndarray) -> float:
    d_flat = data.ravel()
    s_flat = semantic_data.ravel()
    n = d_flat.size
    d_sum = 0.0
    s_sum = 0.0
    for i in range(n):
        d_sum += abs(int(d_flat[i]) - 2)
        s_sum += abs(int(s_flat[i]) - 2)
    return float((d_sum / n + s_sum / n) / 2.0)


