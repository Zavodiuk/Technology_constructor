class TetraCube5:
    """
    Dual-layer 5x5x5 compact cube (Zero-Copy Serialized with 3-4-5 mapping):
    Layer 1 (data): Physics / Lossless Residual footprint (500 bytes, uint8 shifted by +2)
    Layer 2 (semantic): System telemetry & deterministic state evaluations (500 bytes, uint8 shifted by +2)
    Total Monolithic Quantum Payload: 1000 bytes.
    """
    __slots__ = ("data", "semantic_data")

    def __init__(self, data: Optional[np.ndarray] = None, semantic_data: Optional[np.ndarray] = None) -> None:
        if data is None:
            self.data = np.full((CUBE, CUBE, CUBE, N_FACES), 2, dtype=np.uint8)
        else:
            if data.dtype == np.uint8:
                self.data = data
            else:
                self.data = (np.clip(data, -2, 2) + 2).astype(np.uint8)
                
        if semantic_data is None:
            self.semantic_data = np.full((CUBE, CUBE, CUBE, N_FACES), 2, dtype=np.uint8)
        else:
            if semantic_data.dtype == np.uint8:
                self.semantic_data = semantic_data
            else:
                self.semantic_data = (np.clip(semantic_data, -2, 2) + 2).astype(np.uint8)

    def pack_monolith(self, lossless: bool = False) -> bytes:
        if lossless:
            flat_phys = self.data.view(np.uint8).reshape(-1)
        else:
            flat_phys = self.data.reshape(-1)
        flat_sem = self.semantic_data.reshape(-1)
        return flat_phys.tobytes() + flat_sem.tobytes()

    @classmethod
    def unpack_monolith(cls, raw: bytes, lossless: bool = False) -> "TetraCube5":
        need = 1000
        if len(raw) < need:
            raise ValueError("monolithic dual-layer payload too short")
        if lossless:
            arr_phys = np.frombuffer(raw[:500], dtype=np.uint8).copy().reshape(CUBE, CUBE, CUBE, N_FACES)
            arr_sem = np.frombuffer(raw[500:1000], dtype=np.uint8).reshape(CUBE, CUBE, CUBE, N_FACES)
            cube = cls(semantic_data=arr_sem)
            cube.data = arr_phys
            return cube
        else:
            arr_phys = np.frombuffer(raw[:500], dtype=np.uint8).copy().reshape(CUBE, CUBE, CUBE, N_FACES)
            arr_sem = np.frombuffer(raw[500:1000], dtype=np.uint8).reshape(CUBE, CUBE, CUBE, N_FACES)
            return cls(data=arr_phys, semantic_data=arr_sem)

    def mean_energy(self) -> float:
        d_signed = self.data.astype(np.int16) - 2
        s_signed = self.semantic_data.astype(np.int16) - 2
        return float((np.mean(np.abs(d_signed)) + np.mean(np.abs(s_signed))) / 2.0)


