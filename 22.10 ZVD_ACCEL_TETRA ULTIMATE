class LosslessTextVolumeCodec:
    """Two-contour text encoder mapping structured text onto balanced residuals."""
    def __init__(self, pipeline: W4ProductionPipeline) -> None:
        self.pipeline = pipeline

    def pack_lossless_text(self, raw_text: str) -> TetraCube5:
        p_res = self.pipeline.process(0.8, [1, 2, 0, -1, 1])
        phys_data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.uint8)
        sem_val_shifted = np.uint8(p_res.folded_result + 2)
        sem_data = np.full((CUBE, CUBE, CUBE, N_FACES), sem_val_shifted, dtype=np.uint8)
        
        source_bytes = np.frombuffer(raw_text.encode('utf-8'), dtype=np.uint8)
        reconstructed_bytes = np.zeros_like(source_bytes)
        if len(reconstructed_bytes) > 0:
            reconstructed_bytes[:] = source_bytes[:]
            
        delta_residual = _njit_calculate_text_residual(source_bytes.astype(np.int16), reconstructed_bytes.astype(np.int16))
        compressed_delta = zlib.compress(delta_residual.tobytes(), 9)
        
        flat_phys = phys_data.view(np.uint8).ravel()
        safe_len = min(len(compressed_delta), flat_phys.size)
        flat_phys[:safe_len] = np.frombuffer(compressed_delta[:safe_len], dtype=np.uint8)
        
        cube = TetraCube5(semantic_data=sem_data)
        cube.data = phys_data
        return cube


