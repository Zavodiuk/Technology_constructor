# МОДУЛЬ 2: ВНУТРЕННЕЕ ВРАЩАЮЩЕЕСЯ ТЕРНАРНОЕ ЯДРО ( {} )
# ============================================================================
class RotatingTernaryCore:
    """
    Симметричное тернарное ядро [-1, 0, 1] с прецизионным целочисленным 
    тактированием фазы вращения (абсолютная защита от тригонометрического дрейфа).
    """
    def __init__(self, size: int = 3):
        self.size = size
        self.core_matrix = np.zeros((size, size), dtype=np.int8)
        
        mid = size // 2
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid:
                    self.core_matrix[x, y] = np.int8(0)
                elif (x + y) % 2 == 0:
                    self.core_matrix[x, y] = np.int8(1)
                else:
                    self.core_matrix[x, y] = np.int8(-1)
        
        # Целочисленный базис шага (0..11) для 12-фазной симметрии (30 градусов)
        self.step_index: int = 0

    def rotate_step(self) -> None:
        """Циклический сдвиг фазы за фиксированное O(1) время без погрешности float"""
        self.step_index = (self.step_index + 1) % 12

    @property
    def rotation_angle_rad(self) -> float:
        """Динамический расчет радианного угла без накопления следового шума"""
        return self.step_index * (math.pi / 6.0)

    def get_effective_state_at(self, local_coord: Tuple[int, int]) -> int:
        x, y = local_coord
        mid = self.size // 2
        ox, oy = x - mid, y - mid
        
        # Точное тригонометрическое зеркало текущей фазы
        current_angle = self.rotation_angle_rad
        cos_a = math.cos(current_angle)
        sin_a = math.sin(current_angle)
        
        rx = int(round(ox * cos_a - oy * sin_a))
        ry = int(round(ox * sin_a + oy * cos_a))
        
        tx = max(0, min(self.size - 1, rx + mid))
        ty = max(0, min(self.size - 1, ry + mid))
        
        return int(self.core_matrix[tx, ty])


