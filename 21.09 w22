# МОДУЛЬ 1: МАКРО-ПОЛЕ С ВЕКТОРНОЙ РЕКУПЕРАЦИЕЙ ( [] )
# ============================================================================
class TernaryMacroField:
    """Внешнее поле высокой размерности с троичным базисом [-1, 0, 1]."""
    def __init__(self, dimensions: Tuple[int, int] = (7, 7)):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=np.int8)
        
        # Инициализация градиентного паттерна макро-поля
        mid_x, mid_y = dimensions[0] // 2, dimensions[1] // 2
        for x in range(dimensions[0]):
            for y in range(dimensions[1]):
                dist = abs(x - mid_x) + abs(y - mid_y)
                if dist == 0:
                    self.field[x, y] = np.int8(1)
                elif dist <= 2:
                    self.field[x, y] = np.int8(0)
                else:
                    self.field[x, y] = np.int8(-1)

    def get_field_slice(self, center: Tuple[int, int], radius: int) -> np.ndarray:
        cx, cy = center
        r = radius
        return self.field[max(0, cx-r):min(self.dimensions[0], cx+r+1),
                          max(0, cy-r):min(self.dimensions[1], cy+r+1)]

    def recover_to_laminar_balance(self) -> int:
        """
        ⚡ Векторизованная рекуперация на NumPy: 
        мгновенный сброс всех заблокированных состояний (-1) в баланс (0) за один такт.
        """
        mask = (self.field == -1)
        converted_count = int(np.sum(mask))
        if converted_count > 0:
            self.field[mask] = np.int8(0)
        return converted_count

    def calculate_field_entropy(self) -> float:
        total_elements = self.field.size
        if total_elements == 0:
            return 0.0
        counts = Counter(int(x) for x in self.field.flatten())
        entropy = 0.0
        for count in counts.values():
            p = count / total_elements
            if p > 0:
                entropy -= p * math.log(p, 3)
        return float(entropy)


