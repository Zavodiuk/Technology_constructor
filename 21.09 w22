# --- БАЗИСЫ И СЕМИОТИЧЕСКИЕ СЛОВАРИ ТРОИЧНОЙ ЛОГИКИ ---
TERNARY_BASIS = np.array([1, 0, -1], dtype=np.int8)

TERNARY_CODE: Dict[int, str] = {
    -1: "ЛОЖЬ / БЛОКИРОВКА (Аппаратный обрыв / Рекуперационный сток)",
     0: "НЕОПРЕДЕЛЕННОСТЬ / ПОКОЙ (Ламинарный фазовый ноль / Регенерация)",
     1: "ИСТИНА / АКТИВАЦИЯ (Индукционный резонансный подъем)"
}

def ternary_clip(val: int) -> np.int8:
    return np.int8(max(-1, min(1, val)))


