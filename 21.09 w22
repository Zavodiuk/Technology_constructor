# МОДУЛЬ 3: ОРКЕСТРАТОР ПРЕЦИЗИОННОГО МУАРА W22.1
# ============================================================================
class VectorizedMoiréReducerW22:
    """
    Интегрированный контур редуктора с целочисленным тактом муара и векторной рекуперацией.
    """
    def __init__(self, macro_field_dims: Tuple[int, int] = (7, 7)):
        self.macro_field = TernaryMacroField(macro_field_dims)
        self.ternary_core = RotatingTernaryCore(size=3)
        self.time_step: int = 0
        self.gate_transmission_state: int = 0

    def evaluate_phase_gate(self) -> Tuple[int, int, float, int]:
        self.time_step += 1
        self.ternary_core.rotate_step()
        
        current_entropy = self.macro_field.calculate_field_entropy()
        recovered_nodes = 0
        
        if current_entropy > 0.6:
            recovered_nodes = self.macro_field.recover_to_laminar_balance()

        center = (self.macro_field.dimensions[0] // 2, self.macro_field.dimensions[1] // 2)
        macro_slice = self.macro_field.get_field_slice(center, radius=1)
        
        interaction_sum = 0
        match_count = 0
        
        for tx in range(3):
            for ty in range(3):
                t_val = self.ternary_core.get_effective_state_at((tx, ty))
                if tx < macro_slice.shape[0] and ty < macro_slice.shape[1]:
                    p_val = int(macro_slice[tx, ty])
                    product_val = t_val * p_val
                    interaction_sum += product_val
                    if t_val == p_val:
                        match_count += 1

        # `:` — пороговый барьер редуктора
        if interaction_sum > 3:
            self.gate_transmission_state = 1   # Проводящий резонанс
        elif interaction_sum >= -3:
            self.gate_transmission_state = 0   # Ламинарный баланс
        else:
            self.gate_transmission_state = -1  # Аппаратный обрыв муара

        coherence_factor = float(match_count / 9.0)
        return self.gate_transmission_state, interaction_sum, coherence_factor, recovered_nodes

    def display_telemetry(self) -> None:
        state, sum_val, coherence, recovered = self.evaluate_phase_gate()
        angle_deg = math.degrees(self.ternary_core.rotation_angle_rad)
        entropy = self.macro_field.calculate_field_entropy()
        
        print(f"\n================ [ W22.1-STABLE МУАР-ТАКТ: ШАГ №{self.time_step} ] ================")
        print(f"  -> Индекс шага ядра (0..11): {self.ternary_core.step_index} ({angle_deg:.1f}°)")
        print(f"  -> Энтропия макро-среды (Base-3): {entropy:.6f}")
        print(f"  -> Интегральный индекс муара (Σ): {sum_val:+d}")
        print(f"  -> Коэффициент фазовой когерентности: {coherence:.2f}")
        print(f"  -> Восстановлено узлов (NumPy Mask): {recovered}")
        print(f"  -> Состояние полевого шлюза: {state:+d} ({TERNARY_CODE[state]})")


