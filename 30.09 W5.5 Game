class W5AdaptiveProductionPipeline:
    def __init__(self, stress_threshold: float = 0.70, chunk_size: int = 250_000):
        self.gate = BXOSGate()
        self.logic_engine = MultivaluedLogicEngine()
        self.ontology = L5OntologyLayer()
        self.rashomon = PentarnyRashomon()
        self.stress_threshold = stress_threshold
        self.chunk_size = chunk_size

    def _determine_strategy(self, stress_level: float) -> Literal["godel", "luka"]:
        return "luka" if stress_level >= self.stress_threshold else "godel"

    def run(self, interpretations_scores: List[List[float]], l5_values_list: List[List[int]], current_stress: float = 0.45) -> dict:
        scores = np.array(interpretations_scores, dtype=np.float32)
        l5 = np.array(l5_values_list, dtype=np.int8)
        
        states, best_idx, confidences = L3Triage.analyze_interpretations(scores)
        strategy = self._determine_strategy(current_stress)
        
        folded = self.logic_engine.fold(l5, strategy=strategy)
        audit = self.rashomon.evaluate(l5)
        
        system_energy = [float(np.mean(np.abs(l5)) / 2.0)] if l5.ndim == 1 else (np.mean(np.abs(l5), axis=-1) / 2.0).tolist()
        statuses = np.where(states == -1, "LOCKED_INPUT", np.where(states == 0, "LOCKED_OUTPUT", "OK")).tolist()
        
        self.gate.total_count += len(statuses)
        self.gate.locked_count += sum(1 for s in statuses if s.startswith("LOCKED"))
        
        receipt = BXOSReceiptGenerator.generate("BATCH-REQ-01", "AUTHORIZED_BATCH_PASS", strategy, {"batch_size": len(statuses), "stress": current_stress})

        return {
            "statuses": statuses, "best_candidate_indices": best_idx.tolist(), "confidences": confidences.tolist(),
            "folded_results": folded.tolist() if hasattr(folded, "tolist") else list(folded),
            "system_energy": system_energy, "rashomon_audit": {k: (v.tolist() if isinstance(v, np.ndarray) else v) for k, v in audit.items()},
            "matrix_shape": [5, 5], "ontology_layers": self.ontology.LAYERS, "bxos_receipt": receipt
        }

    def process(self, request_id: str, raw_score: float, l5_inputs: Sequence[int], current_stress: float = 0.45) -> ProductionPipelineResult:
        triage_state = L3Triage.process(raw_score)
        strategy = self._determine_strategy(current_stress)
        
        if triage_state == -1:
            receipt = BXOSReceiptGenerator.generate(request_id, "DENIED_BY_TRIAGE", strategy, {"raw_score": raw_score})
            return ProductionPipelineResult("REJECTED_BY_TRIAGE", -1, -2, 0.0, strategy, {}, list(l5_inputs), receipt)

        l5_arr = self.ontology.update(l5_inputs)
        folded = self.logic_engine.fold(l5_arr, strategy=strategy)
        audit_res = self.rashomon.evaluate(l5_arr)
        receipt = BXOSReceiptGenerator.generate(request_id, "AUTHORIZED_PASS", strategy, {"folded_result": int(folded), "energy": self.ontology.system_energy})

        return ProductionPipelineResult(
            "OK", triage_state, int(folded), self.ontology.system_energy, strategy,
            {k: (v.item() if isinstance(v, np.generic) else v) for k, v in audit_res.items()},
            l5_arr.tolist(), receipt
        )

    def process_large_stream(self, stream_id: str, large_matrix: np.ndarray, current_stress: float = 0.45) -> Generator[Dict[str, Any], None, None]:
        total_rows = large_matrix.shape[0]
        strategy = self._determine_strategy(current_stress)
        
        for i in range(0, total_rows, self.chunk_size):
            chunk = large_matrix[i:i + self.chunk_size]
            clean_chunk = BXOSGate.guard(chunk)
            folded = self.logic_engine.fold(clean_chunk, strategy=strategy)
            audit_res = self.rashomon.evaluate(clean_chunk)
            tech_mean = float(np.mean(audit_res["technical"])) if isinstance(audit_res["technical"], np.ndarray) else float(audit_res["technical"])
            receipt = BXOSReceiptGenerator.generate(f"{stream_id}-CHNK-{i//self.chunk_size}", "STREAM_PASS", strategy, {"chunk_len": len(chunk)})
            
            yield {
                "status": "CHUNK_OK", "chunk_index": i // self.chunk_size, "strategy_used": strategy,
                "folded_sample": (folded[:3].tolist() if hasattr(folded, "ndim") and folded.ndim > 0 else [int(folded)]),
                "bxos_receipt": receipt
            }


