class BXOSGate:
    @staticmethod
    def guard(signal: np.ndarray) -> np.ndarray:
        if np.issubdtype(signal.dtype, np.integer):
            return np.clip(signal, -2, 2)
        return np.clip(signal, -2.0, 2.0)

    def __init__(self, min_confidence: float = 0.4, critical_states: Tuple[int, ...] = (-2, -1)):
        self.min_confidence = min_confidence
        self.critical_states = set(critical_states)
        self.total_count = 0
        self.locked_count = 0

    def summary(self) -> Dict[str, Any]:
        return {"total": self.total_count, "ready": self.total_count - self.locked_count, "locked": self.locked_count}


class BXOSReceiptGenerator:
    MASTER_SIGNATURE = "KEY-VZ-2026-MASTER-SIGNATURE"

    @classmethod
    def generate(cls, request_id: str, status: str, strategy: str, payload_summary: Dict[str, Any]) -> Dict[str, Any]:
        body = {
            "request_id": request_id,
            "status": status,
            "active_strategy": strategy,
            "timestamp_ns": time.time_ns(),
            "payload_digest": hashlib.sha256(str(payload_summary).encode()).hexdigest(),
            "authority_signature": cls.MASTER_SIGNATURE
        }
        serialized = json.dumps(body, sort_keys=True).encode()
        body["bxos_digest"] = hashlib.sha256(serialized).hexdigest()
        body["simulated"] = True
        return body


class L3Triage:
    @staticmethod
    def process(value: float, low: float = 0.3, high: float = 0.7) -> int:
        if value >= high: return 1
        if value <= low: return -1
        return 0

    @staticmethod
    def process_vector(arr: np.ndarray, low: float = 0.3, high: float = 0.7) -> np.ndarray:
        condlist = [arr >= high, arr <= low]
        choicelist = [1, -1]
        return np.select(condlist, choicelist, default=0).astype(np.int8)

    @staticmethod
    def analyze_interpretations(scores: np.ndarray, margin_threshold: float = 0.15, min_score: float = 0.3):
        if scores.size == 0: return np.array([-1]), np.array([-1]), np.array([0.0])
        best_idx = np.argmax(scores, axis=1)
        best_scores = scores[np.arange(scores.shape[0]), best_idx]
        sorted_scores = np.sort(scores, axis=1)[:, ::-1]
        margins = sorted_scores[:, 0] - (sorted_scores[:, 1] if scores.shape[1] > 1 else 0.0)
        states = np.zeros(scores.shape[0], dtype=np.int8)
        states[best_scores < min_score] = -1
        states[(best_scores >= min_score) & (margins >= margin_threshold)] = 1
        return states, best_idx, best_scores


class MultivaluedLogicEngine:
    def __init__(self, strategy: str = "luka"):
        self.strategy = strategy

    def fold(self, data: Union[Sequence[int], np.ndarray], strategy: Optional[str] = None) -> Union[int, np.ndarray]:
        strat = strategy if strategy is not None else self.strategy
        arr = np.asarray(data)
        if arr.ndim == 0: arr = arr.reshape(1)
        clean_data = BXOSGate.guard(arr)
        if clean_data.ndim == 1:
            return int(self._reduce_1d(clean_data, strat))
        return self._reduce_batch(clean_data, strat)

    def _reduce_1d(self, arr: np.ndarray, strategy: str) -> int:
        if strategy == "godel": return int(np.minimum.reduce(arr))
        n = len(arr)
        if n == 0: return -2
        total_sum = int(np.sum(arr, dtype=np.int16))
        return int(np.maximum(-2, total_sum - 2 * (n - 1)))

    def _reduce_batch(self, batch: np.ndarray, strategy: str) -> np.ndarray:
        if strategy == "godel": return np.minimum.reduce(batch, axis=-1)
        n = batch.shape[-1]
        total_sum = np.sum(batch.astype(np.int16), axis=-1)
        return np.maximum(-2, total_sum - 2 * (n - 1)).astype(np.int8)


class PentarnyRashomon:
    PERSPECTIVES = ("technical", "operational", "structural", "boundary", "risk")

    @staticmethod
    def evaluate(matrix: np.ndarray) -> Dict[str, Union[float, np.ndarray]]:
        if matrix.size == 0: return {p: 0.0 for p in PentarnyRashomon.PERSPECTIVES}
        float_m = matrix.astype(np.float32)
        target_axis = -1 if float_m.ndim > 1 else None
        return {
            "technical": np.mean(float_m, axis=target_axis),
            "operational": np.min(float_m, axis=target_axis),
            "structural": np.max(float_m, axis=target_axis),
            "boundary": np.std(float_m, axis=target_axis) if float_m.ndim > 0 else 0.0,
            "risk": -np.mean(np.abs(float_m), axis=target_axis)
        }


class L5OntologyLayer:
    LAYERS = ["L1_Intent", "L2_Goal", "L3_Ontology", "L4_Context", "L5_Action"]

    def __init__(self):
        self.state = np.zeros(5, dtype=np.int8)

    def update(self, values: Sequence[int]) -> np.ndarray:
        arr = np.asarray(values)
        if arr.size != 5:
            padded = np.zeros(5, dtype=np.int8)
            padded[:min(arr.size, 5)] = arr[:5]
            arr = padded
        self.state = BXOSGate.guard(arr.astype(np.int8))
        return self.state

    @property
    def system_energy(self) -> float:
        return float(np.sum(np.abs(self.state)) / 10.0)


