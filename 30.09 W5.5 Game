@dataclass
class MascheraProfile:
    name: Maschera
    group: str
    description: str
    fact_keywords: List[str]
    weight: float = 1.0
    active: bool = True

    def find_relevant_facts(self, facts: Dict[str, Any]) -> Dict[str, Any]:
        relevant = {}
        facts_lower = {k.lower(): v for k, v in facts.items()}
        keywords_lower = [kw.lower() for kw in self.fact_keywords]
        
        for fact_key, fact_value in facts_lower.items():
            for kw in keywords_lower:
                if kw in fact_key:
                    relevant[fact_key] = fact_value
                    break
        if not relevant:
            relevant = facts_lower
        return relevant

    def evaluate(self, facts: Dict[str, Any]) -> float:
        relevant = self.find_relevant_facts(facts)
        if not relevant: return 0.5
        values = list(relevant.values())
        avg_value = sum(values) / len(values)
        
        if self.name in (Maschera.PANTALONE,):
            return 0.5 * avg_value + 0.5 * (1 - avg_value)
        elif self.name in (Maschera.DOTTOR, Maschera.ARLECCHINO, Maschera.GIANDUJA, Maschera.BALANZONE):
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return 1.0 - std_dev
        elif self.name in (Maschera.CAPITANO, Maschera.COLOMBINA):
            return max(values) if values else 0.5
        elif self.name in (Maschera.TARTAGLIA,):
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return std_dev
        return avg_value


class TeatroDelleMaschere:
    def __init__(self):
        self.maschere: List[MascheraProfile] = []
        self._init_default()

    def _init_default(self):
        self.maschere.append(MascheraProfile(Maschera.PANTALONE, "власть", "Цена/Бюджет", ["цена", "стоимость", "деньги", "финанс", "бюджет"]))
        self.maschere.append(MascheraProfile(Maschera.DOTTOR, "власть", "Логика/Закон", ["логик", "закон", "правил", "науч"]))
        self.maschere.append(MascheraProfile(Maschera.CAPITANO, "власть", "Сила/Энергия", ["сила", "мощ", "производ", "энерг"]))
        self.maschere.append(MascheraProfile(Maschera.BRIGHELLA, "действие", "План/Практика", ["план", "приме", "практи", "функц"]))
        self.maschere.append(MascheraProfile(Maschera.ARLECCHINO, "действие", "Простота", ["прост", "удобн", "лёгк", "быстр"]))
        self.maschere.append(MascheraProfile(Maschera.TARTAGLIA, "действие", "Ошибки/Риски", ["недостат", "проблем", "ошиб", "минус"]))
        self.maschere.append(MascheraProfile(Maschera.INNAMORATI, "человек", "Эстетика", ["красив", "привлек", "нрави", "эстет"]))
        self.maschere.append(MascheraProfile(Maschera.COLOMBINA, "человек", "Истина", ["истин", "подлин", "скрыт", "реальн"]))
        self.maschere.append(MascheraProfile(Maschera.PULCINELLA, "человек", "Общество", ["народ", "мнени", "обществ", "масс"]))
        self.maschere.append(MascheraProfile(Maschera.SCAPINO, "человек", "Гибкость", ["гибк", "манев", "адапт", "обход"]))
        self.maschere.append(MascheraProfile(Maschera.GIANDUJA, "человек", "Искренность", ["искренн", "честн", "правдив"]))
        self.maschere.append(MascheraProfile(Maschera.BALANZONE, "власть", "Точность", ["точн", "коррект", "акурат"]))

    def evaluate(self, facts: Dict[str, Any]) -> Dict[str, Any]:
        results = {}
        weighted_sum = 0.0
        total_weight = 0.0

        for m in self.maschere:
            if not m.active: continue
            score = m.evaluate(facts)
            weighted = score * m.weight
            results[m.name.value] = {"score": round(score, 3), "weight": m.weight, "weighted": round(weighted, 3), "group": m.group}
            weighted_sum += weighted
            total_weight += m.weight

        if total_weight == 0: return {"error": "Нет активных масок"}
        scores = [r["score"] for r in results.values()]
        avg_score = sum(scores) / len(scores)
        std_dev = math.sqrt(sum((s - avg_score)**2 for s in scores) / len(scores))

        return {
            "results": results, "weighted_sum": round(weighted_sum / total_weight, 3),
            "coherence": std_dev < 0.15, "std_dev": round(std_dev, 3), "avg_score": round(avg_score, 3)
        }

    def find_leading_maschera(self, evaluation: Dict[str, Any]) -> Optional[str]:
        if "results" not in evaluation or not evaluation["results"]: return None
        return max(evaluation["results"].items(), key=lambda x: x[1]["weighted"])[0]


class LomonosovSpiral:
    def __init__(self):
        self.history: List[Dict] = []
        self.spiral_level = 0
        self.direction = 0

    def analyze_event(self, event: Dict) -> Dict:
        result = {
            "why": event.get("reason", "неизвестно"), "timestamp": event.get("timestamp", time.time()),
            "loss": event.get("loss", 0.0), "gain": event.get("gain", 0.0),
            "spiral_level": self.spiral_level, "direction": self.direction, "status": "complete"
        }
        loss_val, gain_val = result["loss"], result["gain"]
        if gain_val > loss_val: self.direction = 1
        elif loss_val > gain_val: self.direction = -1
        else: self.direction = 0
        
        self.spiral_level += self.direction
        result["spiral_level"] = self.spiral_level
        result["direction"] = self.direction
        self.history.append(result)
        return result

    def get_trend(self) -> str:
        if not self.history: return "неизвестно"
        d = self.history[-1]["direction"]
        return "восходящая" if d == 1 else ("нисходящая" if d == -1 else "горизонтальная")


class ExperienceModule:
    def __init__(self, max_size: int = 1000):
        self.records: List[Dict] = []
        self.max_size = max_size

    def add(self, decision: Dict, outcome: float):
        self.records.append({"decision": decision, "outcome": outcome, "timestamp": time.time()})
        if len(self.records) > self.max_size: self.records.pop(0)

    def predict(self, name: str) -> float:
        if not self.records: return 0.5
        similar = [r["outcome"] for r in self.records if name.lower() in str(r["decision"]).lower()]
        if similar: return sum(similar) / len(similar)
        return sum(r["outcome"] for r in self.records) / len(self.records)


