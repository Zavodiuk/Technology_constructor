def vector(v1, v2, v3):
    """Создаёт чистый вектор"""
    return MultiVector(v1=v1, v2=v2, v3=v3)

def rotor(angle, axis_v1, axis_v2, axis_v3):
    """Создаёт ротор вращения вокруг оси на заданный угол"""
    norm = math.sqrt(axis_v1**2 + axis_v2**2 + axis_v3**2)
    if norm < 1e-12:
        return MultiVector(scalar=1.0)
    n1, n2, n3 = axis_v1/norm, axis_v2/norm, axis_v3/norm
    half = angle / 2.0
    return MultiVector(
        scalar=math.cos(half),
        b12=-math.sin(half) * n3,
        b13=-math.sin(half) * n2,
        b23=-math.sin(half) * n1
    )

def rotate_vector(vec: MultiVector, rot: MultiVector) -> MultiVector:
    """Поворот вектора ротором: R * v * R_reverse"""
    return rot * vec * rot.reverse()

def reflect_vector(vec: MultiVector, normal: MultiVector) -> MultiVector:
    """Отражение относительно плоскости с нормалью n: -n * v * n"""
    return -normal * vec * normal

