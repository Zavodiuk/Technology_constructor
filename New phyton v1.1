    print("\n[2] Гиперболическая геометрия + троичное квантование:")
    p1 = Point(0.8, 0.2, 0.1)
    p2 = Point(0.1, 0.9, 0.3)
    dist = p1.distance_to(p2)
    print(f"  p1 = {p1}")
    print(f"  p2 = {p2}")
    print(f"  distance(p1, p2) = {dist:.4f}")
    # Троичная оценка расстояния (относительно радиуса 1.0)
    dist_trit = quantize(dist)
    print(f"  Троичная оценка расстояния: {dist_trit} (1=далеко, 0=средне, -1=близко)")

    # 3. Геометрическая алгебра (исправленное умножение)
    print("\n[3] Геометрическая алгебра (Clifford Cl(3,0)):")
    e1 = vector(1, 0, 0)
    e2 = vector(0, 1, 0)
    e3 = vector(0, 0, 1)
    print(f"  e1 = {e1}")
    print(f"  e2 = {e2}")
    prod = e1 * e2
    print(f"  e1 * e2 = {prod}  (ожидается e12)")
    # Проверка антикоммутативности
    print(f"  e2 * e1 = {e2 * e1} (ожидается -e12)")
    # Проверка e12 * e12 = -1
    e12 = prod
    print(f"  e12 * e12 = {e12 * e12} (ожидается -1)")

    # 4. Вращение и троичная оценка
    print("\n[4] Вращение с троичной оценкой:")
    v = vector(0, 1, 0)  # исходный вектор
    angle = math.pi / 2  # 90 градусов вокруг оси Z
    R = rotor(angle, 0, 0, 1)
    rotated = rotate_vector(v, R)
    print(f"  Исходный v = {v}")
    print(f"  Ротор R (90° вокруг Z) = {R}")
    print(f"  Повёрнутый v' = {rotated}")
    # Троичная оценка: сравниваем результат с ожидаемым (-e1)
    expected = vector(-1, 0, 0)
    diff = (rotated - expected).norm()
    print(f"  Ошибка отклонения: {diff:.2e}")
    print(f"  Троичная оценка точности: {quantize(1.0 - diff)} (1=точно, -1=плохо)")

    # 5. Гиперболический вектор и троичное квантование метрик
    print("\n[5] Гиперболический вектор из метрик (троичное ядро):")
    metrics = [0.9, 0.8, 0.7]
    hv = hyperbolic_vector(metrics, radius=1.0)
    print(f"  Метрики: {metrics}")
    print(f"  Гиперболический вектор: {hv}")
    # Троичные триты метрик
    trits = [quantize(m) for m in metrics]
    print(f"  Троичное представление метрик: {trits}")

    # 6. Интеграция: троичное решение + гиперболическое расстояние
    print("\n[6] Интеграция: троичный выбор в гиперболическом пространстве")
    # Два кандидата в гиперболическом пространстве
    candidate_a = hyperbolic_vector([0.9, 0.2, 0.1])
    candidate_b = hyperbolic_vector([0.1, 0.9, 0.3])
    query_vec = hyperbolic_vector([0.8, 0.8, 0.5])
    dist_a = hyperbolic_distance(query_vec, candidate_a)
    dist_b = hyperbolic_distance(query_vec, candidate_b)
    print(f"  Вектор запроса: {query_vec}")
    print(f"  Кандидат A: {candidate_a}, расстояние: {dist_a:.4f}")
    print(f"  Кандидат B: {candidate_b}, расстояние: {dist_b:.4f}")
    # Троичное решение: выбрать с минимальным расстоянием, но с защитой
    choice_trit = cmp(-dist_a, -dist_b)  # инвертируем, чтобы большее расстояние давало -1
    print(f"  Троичный выбор: {choice_trit} (1 -> A, -1 -> B, 0 -> равно)")

    print("\n✅ NEW PHYTON v1.1 успешно загружен и готов к экспертной оценке.")
