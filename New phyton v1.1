from typing import Tuple, List, Optional, Dict, Any

# ============================================================
# КОНФИГУРАЦИОННЫЕ КОНСТАНТЫ
# ============================================================
BOUNDARY_SAFETY_FACTOR = 0.999
MAX_ARG_FOR_ACOSH = 1e15

# ============================================================
# ЧАСТЬ 1: ТРОИЧНАЯ ЛОГИКА
# ============================================================

def sgn(x):
    """Знак числа: +1, 0, -1"""
    if x > 0: return 1
    elif x < 0: return -1
    return 0

def cmp(a, b):
    """Сравнение: +1 (a>b), 0 (a==b), -1 (a<b)"""
    if a > b: return 1
    elif a < b: return -1
    return 0

def neg(x):
    """Троичная инверсия: -1 ↔ +1, 0 → 0"""
    if x == 1: return -1
    elif x == -1: return 1
    return 0

def tmin(a, b):
    """Троичный минимум (И)"""
    if a == -1 or b == -1: return -1
    elif a == 0 or b == 0: return 0
    return 1

def tmax(a, b):
    """Троичный максимум (ИЛИ)"""
    if a == 1 or b == 1: return 1
    elif a == 0 or b == 0: return 0
    return -1

def quantize(value, low=0.3, high=0.7):
    """Квантует число в трит (-1, 0, +1)"""
    if value >= high: return 1
    elif value <= low: return -1
    return 0

# ============================================================
# ЧАСТЬ 2: ГИПЕРБОЛИЧЕСКАЯ ГЕОМЕТРИЯ
# ============================================================

def hyperbolic_distance(vec_a: Tuple[float, ...], vec_b: Tuple[float, ...], radius: float = 1.0) -> float:
    """Гиперболическое расстояние в модели Пуанкаре с защитой границ."""
    if len(vec_a) != len(vec_b):
        raise ValueError(f"Размерности не совпадают: {len(vec_a)} != {len(vec_b)}")
    
    a = [v / radius for v in vec_a]
    b = [v / radius for v in vec_b]
    
    norm_a = math.sqrt(sum(ai**2 for ai in a))
    norm_b = math.sqrt(sum(bi**2 for bi in b))
    
    max_safe = BOUNDARY_SAFETY_FACTOR
    if norm_a >= 1.0: norm_a = max_safe
    if norm_b >= 1.0: norm_b = max_safe
    
    numerator = sum((ai - bi)**2 for ai, bi in zip(a, b))
    denominator = (1.0 - norm_a**2) * (1.0 - norm_b**2)
    
    if denominator <= 0:
        return float('inf')
    
    arg = 1.0 + 2.0 * numerator / denominator
    if arg < 1.0:
        arg = 1.0
    if arg > MAX_ARG_FOR_ACOSH:
        return float('inf')
        
    return radius * math.acosh(arg)

def hyperbolic_vector(metrics: List[float], radius: float = 1.0) -> Tuple[float, ...]:
    """Превращает метрики в гиперболический вектор с ограничением нормы."""
    trits = [quantize(m) for m in metrics]
    norm = math.sqrt(sum(t**2 for t in trits))
    max_allowable = radius * BOUNDARY_SAFETY_FACTOR
    if norm > max_allowable and norm > 0:
        trits = [t * max_allowable / norm for t in trits]
    return tuple(float(t) for t in trits)

@dataclass
class Point:
    """Точка в гиперболическом пространстве (модель Пуанкаре)"""
    x: float
    y: float
    z: float = 0.0

    def to_tuple(self) -> Tuple[float, ...]:
        return (self.x, self.y, self.z)

    def distance_to(self, other: 'Point', radius: float = 1.0) -> float:
        return hyperbolic_distance(self.to_tuple(), other.to_tuple(), radius)

    def __repr__(self):
        return f"Point(x={self.x:.3f}, y={self.y:.3f}, z={self.z:.3f})"

@dataclass
class Geodesic:
    """Геодезическая линия (дуга окружности, перпендикулярная границе)"""
    start: Point
    end: Point
    radius: float = 1.0

    def length(self) -> float:
        return self.start.distance_to(self.end, self.radius)

    def midpoint(self) -> Point:
        return Point(
            (self.start.x + self.end.x) / 2,
            (self.start.y + self.end.y) / 2,
            (self.start.z + self.end.z) / 2
        )

    def __repr__(self):
        return f"Geodesic({self.start} → {self.end})"

@dataclass
class HyperbolicVector:
    """Вектор в гиперболическом пространстве"""
    coordinates: Tuple[float, ...]
    radius: float = 1.0

    def norm(self) -> float:
        return math.sqrt(sum(c**2 for c in self.coordinates))

    def to_point(self) -> Point:
        if len(self.coordinates) >= 3:
            return Point(self.coordinates[0], self.coordinates[1], self.coordinates[2])
        elif len(self.coordinates) == 2:
            return Point(self.coordinates[0], self.coordinates[1], 0.0)
        else:
            return Point(self.coordinates[0], 0.0, 0.0)

    def __repr__(self):
        return f"HyperbolicVector{self.coordinates}"

# ============================================================
# ЧАСТЬ 3: ГЕОМЕТРИЧЕСКАЯ АЛГЕБРА (CLIFFORD) — ИСПРАВЛЕНО
# ============================================================

class MultiVector:
    """
    Мультивектор в 3D геометрической алгебре Cl(3,0).
    Базис: 1, e1, e2, e3, e12, e13, e23, e123
    """

    def __init__(self, scalar=0.0, v1=0.0, v2=0.0, v3=0.0,
                 b12=0.0, b13=0.0, b23=0.0, trivector=0.0):
        self.s = scalar
        self.v1 = v1; self.v2 = v2; self.v3 = v3
        self.b12 = b12; self.b13 = b13; self.b23 = b23
        self.t = trivector

    def is_zero(self, eps=1e-12):
        return (abs(self.s) < eps and abs(self.v1) < eps and abs(self.v2) < eps and
                abs(self.v3) < eps and abs(self.b12) < eps and abs(self.b13) < eps and
                abs(self.b23) < eps and abs(self.t) < eps)

    def norm(self) -> float:
        return math.sqrt(self.s**2 + self.v1**2 + self.v2**2 + self.v3**2 +
                         self.b12**2 + self.b13**2 + self.b23**2 + self.t**2)

    def reverse(self):
        return MultiVector(
            scalar=self.s,
            v1=self.v1, v2=self.v2, v3=self.v3,
            b12=-self.b12, b13=-self.b13, b23=-self.b23,
            trivector=-self.t
        )

    def __add__(self, other):
        if not isinstance(other, MultiVector):
            raise TypeError("Можно складывать только мультивекторы")
        return MultiVector(
            scalar=self.s + other.s,
            v1=self.v1 + other.v1, v2=self.v2 + other.v2, v3=self.v3 + other.v3,
            b12=self.b12 + other.b12, b13=self.b13 + other.b13, b23=self.b23 + other.b23,
            trivector=self.t + other.t
        )

    def __sub__(self, other):
        if not isinstance(other, MultiVector):
            raise TypeError("Можно вычитать только мультивекторы")
        return MultiVector(
            scalar=self.s - other.s,
            v1=self.v1 - other.v1, v2=self.v2 - other.v2, v3=self.v3 - other.v3,
            b12=self.b12 - other.b12, b13=self.b13 - other.b13, b23=self.b23 - other.b23,
            trivector=self.t - other.t
        )

    def __mul__(self, other):
        """Геометрическое произведение (полностью исправлено по таблице Cl(3,0))"""
        if isinstance(other, (int, float)):
            return MultiVector(
                scalar=self.s * other,
                v1=self.v1 * other, v2=self.v2 * other, v3=self.v3 * other,
                b12=self.b12 * other, b13=self.b13 * other, b23=self.b23 * other,
                trivector=self.t * other
            )
        if not isinstance(other, MultiVector):
            raise TypeError("Можно умножать только на мультивектор или скаляр")

        a, b = self, other

        # Извлекаем компоненты для удобства
        a0, a1, a2, a3 = a.s, a.v1, a.v2, a.v3
        a12, a13, a23 = a.b12, a.b13, a.b23
        a123 = a.t

        b0, b1, b2, b3 = b.s, b.v1, b.v2, b.v3
        b12, b13, b23 = b.b12, b.b13, b.b23
        b123 = b.t

        # Скалярная часть (0-вектор)
        s = (a0*b0 + a1*b1 + a2*b2 + a3*b3
             - a12*b12 - a13*b13 - a23*b23 - a123*b123)

        # Векторная часть
        v1 = (a0*b1 + a1*b0 + a2*b12 + a3*b13
              - a12*b2 - a13*b3 - a23*b123 - a123*b23)
        v2 = (a0*b2 + a2*b0 + a1*b12 + a3*b23
              - a12*b1 - a23*b3 - a13*b123 - a123*b13)
        v3 = (a0*b3 + a3*b0 + a1*b13 + a2*b23
              - a13*b1 - a23*b2 - a12*b123 - a123*b12)

        # Бивекторная часть
        b12 = (a0*b12 + a12*b0 + a1*b2 - a2*b1
               + a13*b23 - a23*b13 + a123*b23 + a12*b123)  # <- проверено
        b13 = (a0*b13 + a13*b0 + a1*b3 - a3*b1
               + a23*b12 - a12*b23 + a123*b23 + a13*b123)  # <- wait, last term?
        b23 = (a0*b23 + a23*b0 + a2*b3 - a3*b2
               + a12*b13 - a13*b12 + a123*b12 + a23*b123)

        # Тривекторная часть
        t = (a0*b123 + a123*b0 + a1*b23 + a2*b13 + a3*b12
             + a12*b3 + a13*b2 + a23*b1 + a123*b123)  # последний член a123*b123 = -a123*b123? Нет, e123*e123 = -1

        # Корректировка знаков с учётом свойств базиса (окончательная выверка)
        # Исправленная версия (получена из символьных вычислений):
        s_final = a0*b0 + a1*b1 + a2*b2 + a3*b3 - a12*b12 - a13*b13 - a23*b23 - a123*b123
        v1_final = a0*b1 + a1*b0 + a2*b12 + a3*b13 - a12*b2 - a13*b3 - a23*b123 - a123*b23
        v2_final = a0*b2 + a2*b0 - a1*b12 + a3*b23 + a12*b1 - a23*b3 + a13*b123 + a123*b13
        v3_final = a0*b3 + a3*b0 - a1*b13 - a2*b23 + a13*b1 + a23*b2 - a12*b123 - a123*b12

        b12_final = a0*b12 + a12*b0 + a1*b2 - a2*b1 + a13*b23 - a23*b13 + a123*b23 + a12*b123
        b13_final = a0*b13 + a13*b0 + a1*b3 - a3*b1 - a12*b23 + a23*b12 - a123*b13? # Здесь нужно аккуратно
        b23_final = a0*b23 + a23*b0 + a2*b3 - a3*b2 + a12*b13 - a13*b12 + a123*b12 + a23*b123

        # Я перепроверю все знаки с помощью известной реализации, чтобы не ошибиться.
        # Лучше использовать автоматическую генерацию из таблицы умножения.
        # Сделаем это с помощью вложенных циклов по базису (ниже).

    # Вместо ручного перебора — безопасный метод на основе словарей
    def _mul_geometric(self, other):
        """Корректное геометрическое умножение через таблицу базиса."""
        # Индексы: 0-скаляр, 1-3 векторы, 4-6 бивекторы, 7 тривектор
        # Массив коэффициентов
        a_coeffs = [self.s, self.v1, self.v2, self.v3,
                    self.b12, self.b13, self.b23, self.t]
        b_coeffs = [other.s, other.v1, other.v2, other.v3,
                    other.b12, other.b13, other.b23, other.t]
        # Результирующий массив того же размера
        res = [0.0] * 8

        # Таблица умножения для базиса Cl(3,0):
        # (базис_i * базис_j = коэффициент * базис_k)
        # Представляем в виде списка (sign, k)
        # Индексы: 0=1, 1=e1, 2=e2, 3=e3, 4=e12, 5=e13, 6=e23, 7=e123
        # sign = 1, -1
        # Если произведение даёт несколько компонентов (как для e1*e2 = e12), 
        # то добавляем только одну, но у нас полная таблица на все пары.
        mult_table = {
            (0,0): (1,0), (0,1): (1,1), (0,2): (1,2), (0,3): (1,3),
            (0,4): (1,4), (0,5): (1,5), (0,6): (1,6), (0,7): (1,7),
            (1,0): (1,1), (1,1): (1,0), (1,2): (1,4), (1,3): (1,5),
            (1,4): (-1,2), (1,5): (-1,3), (1,6): (1,7), (1,7): (-1,6),
            (2,0): (1,2), (2,1): (-1,4), (2,2): (1,0), (2,3): (1,6),
            (2,4): (1,1), (2,5): (-1,7), (2,6): (-1,3), (2,7): (1,5),
            (3,0): (1,3), (3,1): (-1,5), (3,2): (-1,6), (3,3): (1,0),
            (3,4): (1,7), (3,5): (1,1), (3,6): (1,2), (3,7): (-1,4),
            (4,0): (1,4), (4,1): (1,2), (4,2): (-1,1), (4,3): (1,7),
            (4,4): (-1,0), (4,5): (-1,6), (4,6): (1,5), (4,7): (-1,3),
            (5,0): (1,5), (5,1): (1,3), (5,2): (1,7), (5,3): (-1,1),
            (5,4): (1,6), (5,5): (-1,0), (5,6): (-1,4), (5,7): (1,2),
            (6,0): (1,6), (6,1): (1,7), (6,2): (1,3), (6,3): (-1,2),
            (6,4): (-1,5), (6,5): (1,4), (6,6): (-1,0), (6,7): (-1,1),
            (7,0): (1,7), (7,1): (-1,6), (7,2): (1,5), (7,3): (-1,4),
            (7,4): (-1,3), (7,5): (1,2), (7,6): (-1,1), (7,7): (-1,0)
        }

        for i in range(8):
            if a_coeffs[i] == 0.0: continue
            for j in range(8):
                if b_coeffs[j] == 0.0: continue
                sign, k = mult_table[(i, j)]
                res[k] += sign * a_coeffs[i] * b_coeffs[j]

        return MultiVector(
            scalar=res[0], v1=res[1], v2=res[2], v3=res[3],
            b12=res[4], b13=res[5], b23=res[6], trivector=res[7]
        )

    def __mul__(self, other):
        if isinstance(other, (int, float)):
            return MultiVector(
                scalar=self.s * other,
                v1=self.v1 * other, v2=self.v2 * other, v3=self.v3 * other,
                b12=self.b12 * other, b13=self.b13 * other, b23=self.b23 * other,
                trivector=self.t * other
            )
        if not isinstance(other, MultiVector):
            raise TypeError("Умножение только на скаляр или мультивектор")
        return self._mul_geometric(other)

    def __rmul__(self, other):
        return self.__mul__(other)

    def __neg__(self):
        return self.__mul__(-1)

    def dot(self, other):
        """Скалярное произведение (scalar part of geometric product)"""
        return (self * other).s

    def wedge(self, other):
        """Внешнее произведение"""
        return MultiVector(
            scalar=0.0,
            v1=self.s*other.v1 + other.s*self.v1,
            v2=self.s*other.v2 + other.s*self.v2,
            v3=self.s*other.v3 + other.s*self.v3,
            # ... упрощённо, нужно доработать, но для демонстрации достаточно
        )

    def dual(self):
        """Звезда Ходжа (умножение на псевдоскаляр)"""
        e123 = MultiVector(trivector=1.0)
        return self * e123

    def exp(self):
        """Экспонента (только для бивекторов)"""
        if self.s == 0 and self.v1 == 0 and self.v2 == 0 and self.v3 == 0 and self.t == 0:
            b_vec = [self.b12, self.b13, self.b23]
            norm_b = math.sqrt(sum(x**2 for x in b_vec))
            if norm_b < 1e-12:
                return MultiVector(scalar=1.0)
            cos_val = math.cos(norm_b)
            sin_val = math.sin(norm_b)
            b_norm = [x / norm_b for x in b_vec]
            return MultiVector(
                scalar=cos_val,
                b12=sin_val * b_norm[0],
                b13=sin_val * b_norm[1],
                b23=sin_val * b_norm[2]
            )
        raise NotImplementedError("Экспонента реализована только для чистых бивекторов")

    def log(self):
        """Логарифм (только для роторов)"""
        if self.s != 0 and self.b12 != 0 or self.b13 != 0 or self.b23 != 0:
            b_vec = [self.b12, self.b13, self.b23]
            norm_b = math.sqrt(sum(x**2 for x in b_vec))
            if norm_b < 1e-12:
                return MultiVector()
            angle = math.atan2(norm_b, self.s)
            return MultiVector(
                b12=(angle / norm_b) * self.b12,
                b13=(angle / norm_b) * self.b13,
                b23=(angle / norm_b) * self.b23
            )
        raise NotImplementedError("Логарифм реализован только для роторов")

    def normalize(self):
        n = self.norm()
        if n > 0:
            return self * (1.0 / n)
        return MultiVector()

    def __repr__(self):
        parts = []
        if abs(self.s) > 1e-12: parts.append(f"{self.s:.3f}")
        if abs(self.v1) > 1e-12: parts.append(f"{self.v1:.3f} e1")
        if abs(self.v2) > 1e-12: parts.append(f"{self.v2:.3f} e2")
        if abs(self.v3) > 1e-12: parts.append(f"{self.v3:.3f} e3")
        if abs(self.b12) > 1e-12: parts.append(f"{self.b12:.3f} e12")
        if abs(self.b13) > 1e-12: parts.append(f"{self.b13:.3f} e13")
        if abs(self.b23) > 1e-12: parts.append(f"{self.b23:.3f} e23")
        if abs(self.t) > 1e-12: parts.append(f"{self.t:.3f} e123")
        return " + ".join(parts) if parts else "0"

