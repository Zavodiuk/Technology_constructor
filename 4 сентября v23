# МОДУЛЬ 4: ИНТЕГРИРОВАННЫЙ ОРКЕСТРАТОР V23
# ============================================================================
class MoiréUnifiedOrchestratorV23:
    def __init__(self):
        self.macro_field = MacroFieldV23((7, 7))
        self.bi_core = CounterRotatingBiCore(size=3)
        self.hysteresis = PhaseHysteresisMemory(window_size=4)
        self.time_step: int = 0

    def execute_sync_cycle(self) -> Tuple[int, int, float, float]:
        self.time_step += 1
        current_entropy = self.macro_field.calculate_entropy()
        
        # Интеграция рекуперации при перегреве энтропии
        if current_entropy > 0.65:
            self.macro_field.recover_extremes()

        self.bi_core.update_rotation(current_entropy)
        
        center = (3, 3)
        slice_field = self.macro_field.field[2:5, 2:5]
        
        interaction_sum = 0
        matches = 0
        
        for tx in range(3):
            for ty in range(3):
                val_a = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_a, self.bi_core.matrix_a)
                val_b = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_b, self.bi_core.matrix_b)
                
                # Двойной муар-эффект интерференции тернарных ядер
                core_interference = val_a + val_b
                
                if tx < slice_field.shape[0] and ty < slice_field.shape[1]:
                    p_val = slice_field[tx, ty]
                    product_val = core_interference * p_val
                    interaction_sum += product_val
                    if core_interference == p_val:
                        matches += 1

        # `:` — пороговая квантизация шлюза
        if interaction_sum > 6: raw_gate = 2
        elif interaction_sum > 1: raw_gate = 1
        elif interaction_sum >= -1: raw_gate = 0
        elif interaction_sum >= -6: raw_gate = -1
        else: raw_gate = -2

        # Применение фазового гистерезиса топологической памяти
        stabilized_gate = self.hysteresis.register_state(raw_gate)
        coherence = float(matches / 9.0)
        
        return stabilized_gate, interaction_sum, current_entropy, coherence

    def display_telemetry(self) -> None:
        gate, sum_val, entropy, coherence = self.execute_sync_cycle()
        deg_a = math.degrees(self.bi_core.angle_a) % 360
        deg_b = math.degrees(self.bi_core.angle_b) % 360
        print(f"\n================ [ СИНХРО-МУАР V23: ТАКТ №{self.time_step} ] ================")
        print(f"  -> Энтропия среды: {entropy:.4f}")
        print(f"  -> Углы ядер [Alpha / Beta]: {deg_a:.1f}° / {deg_b:.1f}°")
        print(f"  -> Интегральный индекс муара (Σ): {sum_val:+d}")
        print(f"  -> Когерентность сетки: {coherence:.2f}")
        print(f"  -> Стабилизированный шлюз (Гистерезис): {gate:+d} ({PENTAR_CODE[gate]})")


