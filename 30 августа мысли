import numpy as np

class PentaryLogicTransforms:
    """Операторы трансформации и сдвига полей суждений нижнего слоя BXOS"""

    @staticmethod
    def invert_pentayt(pentayt_vector):
        """
        Оператор идеальной инверсии знака (Пентарное НЕ / NOT).
        Мгновенно разворачивает полярность всего вектора суждений.
        {-2, -1, 0, 1, 2} ---> {2, 1, 0, -1, -2}
        """
        # В симметричном коде это чистый унарный минус без битовых масок
        return -np.array(pentayt_vector, dtype=int)

    @staticmethod
    def cyclic_shift_pentayt(pentayt_vector, shift_steps=1):
        """
        Оператор циклического сдвига разрядов внутри пентайта.
        Используется Длинным Оркестратором для циклического сканирования 
        приоритетов и сдвига фокуса внимания «большого мозга».
        """
        vec = np.array(pentayt_vector, dtype=int)
        # Реализуем круговой сдвиг элементов вектора
        return np.roll(vec, shift_steps)

    @staticmethod
    def полярный_резонанс(pentayt_vector, weight_vector):
        """
        Специфическая брусенцовская свертка: поразрядное умножение вектора суждения
        на вектор весов с сохранением знаковой логики совпадения фаз.
        """
        vec = np.array(pentayt_vector, dtype=int)
        weights = np.array(weight_vector, dtype=int)
        
        # Перемножаем фазы. Если знаки совпадают — получаем плюс (усиление), 
        # если противоположны — минус (взаимное торможение).
        return vec * weights


# --- ТЕСТОВЫЙ ЗАПУСК ОПЕРАТОРОВ ТРАНСФОРМАЦИИ ---
if __name__ == "__main__":
    print("[BXOS] Тестирование операторов трансформации...")
    
    # Исходное состояние пентайта (Вектор суждения)
    исходный_пентайт = np.array([2, 1, 0, -1, -2])
    print(f"Исходный пентайт:          {исходный_пентайт}")
    
    # 1. Тест инверсии
    инвертированный = PentaryLogicTransforms.invert_pentayt(исходный_пентайт)
    print(f"Пентарная инверсия (-NOT): {инвертированный}")
    
    # 2. Тест циклического сдвига
    сдвинутый = PentaryLogicTransforms.cyclic_shift_pentayt(исходный_пентайт, shift_steps=1)
    print(f"Циклический сдвиг (+1):    {сдвинутый}")
    
    # 3. Тест полярного резонанса весов
    вектор_весов = np.array([1, -1, 2, 2, 1])
    резонанс = PentaryLogicTransforms.полярный_резонанс(исходный_пентайт, вектор_весов)
    print(f"Полярный резонанс весов:   {резонанс}")
