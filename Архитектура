class L3:
    """Троичная логика."""
    
    @staticmethod
    def quantize(value: float, low: float = 0.3, high: float = 0.7) -> int:
        if value >= high: return 1
        if value <= low: return -1
        return 0
    
    @staticmethod
    def fold(values: List[int]) -> int:
        s = sum(values)
        if s > 0: return 1
        if s < 0: return -1
        return 0


class BlockX:
    """Ядро принятия решений."""
    
    def __init__(self):
        self.l3_status = 0
        self.memory = []
    
    def evaluate(self, input_data: Dict) -> Dict:
        l3_in = L3.quantize(input_data.get("confidence", 0.5))
        if l3_in == -1:
            return {"status": "veto", "l3": -1, "message": "Блокировано STOP Veto"}
        return {"status": "accepted", "l3": l3_in, "message": "Решение принято"}


