        return self.I.quality(losses)
    
    def architect_create(self, vision: str) -> str:
        """Блок J — создание архитектуры"""
        return self.J.create(vision)
    
    def architect_veto(self) -> str:
        """Блок J — STOP Veto"""
        self.state = "veto"
        return self.J.veto()
    
    # ----------------------------------------------------------
    # МЕТОДЫ ДЕЙСТВИЯ (V6)
    # ----------------------------------------------------------
    
    def evaluate_input(self, confidence: float) -> Dict:
        """L3-оценка входа"""
        return self.block_x.evaluate({"confidence": confidence})
    
    def quantize_value(self, value: float) -> int:
        """Квантование в трит"""
        return self.l3.quantize(value)
    
    # ----------------------------------------------------------
    # ПОЛНЫЙ ЦИКЛ
    # ----------------------------------------------------------
    
    def full_cycle(self, input_data: Dict) -> Dict:
        """
        Полный цикл: философия → решение → действие → результат.
        """
        # 1. Мысль (Блок G)
        thought = self.think()
        
        # 2. Решение (Блок A)
        decision = self.decide(input_data)
        
        # 3. L3-оценка (v6)
        l3_result = self.evaluate_input(input_data.get("confidence", 0.5))
        
        # 4. Проверка на Veto
        if l3_result["status"] == "veto":
            self.architect_veto()
            return {
                "status": "veto",
                "thought": thought,
                "decision": decision,
                "l3": -1,
                "message": "Система остановлена STOP Veto"
            }
        
        # 5. Обновление жизнеспособности
        self.update_viability(0.05)
        
        # 6. Сохранение в историю
        self.history.append({
            "input": input_data,
            "thought": thought,
            "decision": decision,
            "l3": l3_result["l3"],
            "viability": self.Ж.value,
            "time": time.time()
        })
        
        return {
            "status": "success",
            "thought": thought,
            "decision": decision,
            "l3": l3_result["l3"],
            "viability": self.Ж.value,
            "history_size": len(self.history)
        }


