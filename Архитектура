        """Блок D — добавление интересанта"""
        self.D.add(name, priority, pain, potential)
    
    def get_priority_order(self) -> List[str]:
        """Блок D — приоритеты взаимодействия"""
        return self.D.get_priority_order()
    
    def add_patent(self, name: str, description: str):
