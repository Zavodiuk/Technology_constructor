@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_rashomon_120d_evaluate(matrix: np.ndarray, out_results: np.ndarray):
    rows = matrix.shape[0]
    cols = matrix.shape[1]
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = matrix[i, 0]
        max_val = matrix[i, 0]
        for j in range(cols):
            val = matrix[i, j]
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val: min_val = val
            if val > max_val: max_val = val
        mean_val = sum_val / cols
        var_sum = 0.0
        for j in range(cols):
            val = matrix[i, j]
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        
        out_results[i, 0] = mean_val
        out_results[i, 1] = min_val
        out_results[i, 2] = max_val
        out_results[i, 3] = std_val
        out_results[i, 4] = -(abs_sum_val / cols) - std_val


class PentarnyRashomonEngine:
    """120D Rashomon audit engine evaluating tactical risk across full 120-dimensional space."""
    def __init__(self):
        self._audit_buffer = allocate_aligned_array((1, 5), np.float64, alignment=64)

    def evaluate(self, vector_120d: np.ndarray) -> Dict[str, float]:
        mat = np.asarray(vector_120d, dtype=np.float64)
        if mat.ndim == 1:
            mat = mat.reshape(1, -1)
        rows, cols = mat.shape
        
        if cols < DIM_120:
            padded = np.zeros((rows, DIM_120), dtype=np.float64)
            padded[:, :cols] = mat
            for c in range(cols, DIM_120):
                padded[:, c] = mat[:, -1]
            mat = padded
        elif cols > DIM_120:
            mat = mat[:, :DIM_120]

        if self._audit_buffer.shape[0] != rows:
            self._audit_buffer = allocate_aligned_array((rows, 5), np.float64, alignment=64)

        _njit_rashomon_120d_evaluate(mat, self._audit_buffer)
        
        return {
            "technical": float(self._audit_buffer[0, 0]),
            "operational": float(self._audit_buffer[0, 1]),
            "structural": float(self._audit_buffer[0, 2]),
            "boundary": float(self._audit_buffer[0, 3]),
            "risk": float(self._audit_buffer[0, 4])
        }


