class TernaryUniverseW19:
    def __init__(self, dimensions: Tuple[int, ...], node_coordinates: Dict[str, Tuple[int, ...]]):
        self.dimensions = dimensions
        self.tensor_field = TernaryTensorField(dimensions)
        self.tensor_evolution = TernaryTensorEvolution(self.tensor_field)
        self.graph = TernaryUniverseGraph()
        self.node_coords = node_coordinates
        self.telemetry = TernarySystemicTelemetryMonitor()
        self.last_dynamic_radius = 1

        mid = dimensions[0] // 2
        max_idx = dimensions[0] - 1
        p1 = (mid, mid, mid, mid)
        p2 = (0, max_idx, mid, mid)
        p3 = (max_idx, 0, mid, mid)
        
        self.membrane = TernaryDynamicPlaneMembrane(dimensions, p1, p2, p3)

    def add_node(self, name: str, coords: Tuple[int, ...]) -> None:
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str) -> None:
        self.graph.add_edge(src, tgt)

    def step(self) -> None:
        dynamic_radius = 1
        if (active_entropy := self.tensor_field.calculate_field_entropy()) > 0.35:
            dynamic_radius = 2

        self.last_dynamic_radius = dynamic_radius
        active_divergence = self.tensor_evolution.calculate_field_divergence()

        # Пульсация микро-графа
        self.graph.pulse()

        # Проекция решений в макро-поле
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_field.inject_quantum_impulse(coords, impulse_val)

        # Распространение волн узлов с адаптивным радиусом
        for name, coords in self.node_coords.items():
            self.tensor_evolution.propagate_wave(coords, radius=dynamic_radius)

        # Эволюция трехточечной мембранной плоскости
        gradients = self.tensor_evolution.calculate_field_gradient()
        self.membrane.evolve_membrane(self.tensor_field.field, gradients)
        self.membrane.radiate_membrane_front(self.tensor_field, self.tensor_evolution, dynamic_radius=dynamic_radius)

        # Обратная связь поля и телеметрии: воздействие фиксируется в долгосрочной памяти field_suppression
        field_div = self.tensor_evolution.calculate_field_divergence()
        telemetry_triggered = self.telemetry.inspect_system_stability(active_entropy, active_divergence)
        telemetry_multiplier = 0.5 if telemetry_triggered else 1.0
        divergence_multiplier = 1.0 - (field_div * 0.005)

        for edge in self.graph.edges:
            # Эффект подавления накапливается и плавно восстанавливается (релаксация +0.05 за такт)
            edge.field_suppression = min(1.0, edge.field_suppression + 0.05)
            edge.field_suppression = max(0.0, edge.field_suppression * telemetry_multiplier * divergence_multiplier)

    def display_comprehensive_telemetry(self) -> None:
        va, vb, vc = self.membrane.get_vertices()
        print(f"\n================ [ ТРОИЧНЫЙ НАУЧНЫЙ ТАКТ W19.2: СИНХРОН №{self.graph.time_step} ] ================")
        print(f"  -> Глобальная энтропия среды (Base-3): {self.tensor_field.calculate_field_entropy():.6f}")
        print(f"  -> Динамический радиус (:=): {self.last_dynamic_radius}")
        print(f"  -> Метрический тензор напряжения: {self.tensor_field.evaluate_metric_tensor():.6f}")
        print(f"  -> Дивергенция волнового поля: {self.tensor_evolution.calculate_field_divergence():.4f}")
        print(f"  -> Вершины упругой мембраны:")
        print(f"     [Vertex-A/+1]: {va}")
