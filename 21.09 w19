        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({TERNARY_CODE[int(node.decision)]}) | Масса = {node.mass:.2f}")
        print("--- ТЕРМОДИНАМИКА И ПАМЯТЬ РЕБЕР ---")
