    def __init__(self, entropy_threshold: float = 0.70):
        self.entropy_threshold = entropy_threshold
        self.cascade_warnings_issued = 0

    def inspect_system_stability(self, current_entropy: float, current_divergence: float) -> bool:
        if current_entropy > self.entropy_threshold or current_divergence > 40.0:
            self.cascade_warnings_issued += 1
            return True
        return False


