            _ = BXOSGate.validate(p_out)
            
        elapsed = time.perf_counter() - start_time
        total_ops = iterations * 512 * 4
        ops_per_sec = total_ops / elapsed if elapsed > 0 else 0
        
        return {
            "iterations": iterations,
