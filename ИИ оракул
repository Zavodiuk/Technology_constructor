# 5. ЯДРО АГЕНТА V6
# ============================================================

class V6AgentCore:
    """
    Главный класс агента.
    Управляется через L3, Block Z, Rashomon и STOP Veto.
    Готов к подключению любого LLM (Gemini, Claude, локальный).
    """

    def __init__(self):
        self.memory = BlockZ()
        self.l3_status = 0
        self.history = []
        self.active = True
        self.root_hash = ROOT_HASH
        self.architect = ROOT_ARCHITECT
        self.version = VERSION

        # Базовая база ответов
        self._responses = {
            "привет": "Здравствуйте, Root-Architect. Агент готов.",
            "как дела": f"L3 статус: {self.l3_status}. Ожидаю команды.",
            "стоп": "VETO АКТИВИРОВАНО. Агент остановлен.",
            "старт": "Агент возобновлён. L3 статус: 0.",
            "статус": self._status_response,
            "память": self._memory_response,
            "кто ты": self._who_response,
            "команды": self._commands_response
        }

        self.memory.save("init", "Агент инициализирован")
        print(f"[Агент] Инициализация завершена. Root-Architect: {self.architect}")
        print(f"[Агент] SHA-256: {self.root_hash[:16]}...")
        print(f"[Агент] Версия: {self.version}")

    # ----------------------------------------------------------
    # ВНУТРЕННИЕ ОТВЕТЫ
    # ----------------------------------------------------------

    def _status_response(self) -> str:
        return (
            f"Статус: {'Активен' if self.active else 'Остановлен Veto'}\n"
            f"L3 статус: {self.l3_status}\n"
            f"Память: {len(self.memory.memory)} записей\n"
            f"История: {len(self.history)} запросов\n"
            f"Root-Architect: {self.architect}\n"
            f"SHA-256: {self.root_hash[:16]}..."
        )

    def _memory_response(self) -> str:
        last = self.memory.get_last(5)
        if not last:
            return "Память пуста."
        lines = ["Последние 5 записей:"]
        for r in last:
            value_str = str(r['value'])[:60] + "..." if len(str(r['value'])) > 60 else str(r['value'])
            lines.append(f"  - {r['key']}: {value_str}")
        return "\n".join(lines)

    def _who_response(self) -> str:
        return (
            f"Я — агент на архитектуре v6.\n"
            f"Меня создал {self.architect} (Root-Architect).\n"
            f"Я работаю на троичной логике, имею память и подчиняюсь STOP Veto.\n"
            f"Мой SHA-256: {self.root_hash[:16]}..."
        )

    def _commands_response(self) -> str:
        return (
            "Доступные команды:\n"
            "  привет — проверка связи\n"
            "  статус — состояние агента\n"
            "  память — последние записи\n"
            "  кто ты — информация об агенте\n"
            "  команды — этот список\n"
            "  стоп — активация STOP Veto\n"
            "  старт — возобновление работы"
        )

    # ----------------------------------------------------------
    # L3-ФИЛЬТРАЦИЯ
    # ----------------------------------------------------------

    def _evaluate_input(self, text: str) -> int:
        has_subject = any(w in text.lower() for w in ['помоги', 'создай', 'напиши', 'объясни', 'расскажи'])
        has_criteria = any(w in text.lower() for w in ['как', 'почему', 'что', 'где', 'когда'])
        score = (has_subject + has_criteria) / 2
        return quantize(score)

    def _evaluate_output(self, response: str) -> int:
        if not response or len(response) < 5:
            return -1
        if len(response) > 20:
            return 1
        return 0

    # ----------------------------------------------------------
    # ОСНОВНОЙ МЕТОД
    # ----------------------------------------------------------

    def ask(self, user_input: str) -> Dict[str, Any]:
        """
        Основной метод взаимодействия с агентом.
        """
        if not self.active:
            return {
                "status": "veto",
                "message": "Агент остановлен Root-Architect Veto",
                "l3_in": -1,
                "l3_out": -1
            }

        # 1. Оценка входа
        l3_in = self._evaluate_input(user_input)
        self.memory.save("l3_in", l3_in)

        if l3_in == -1:
            return {
                "status": "rejected",
                "message": "Запрос заблокирован (L3_in = -1)",
                "l3_in": -1,
                "l3_out": -1,
                "response": None
            }

        # 2. Поиск ответа в базе
        lower = user_input.lower()
        response_text = None
        for key, value in self._responses.items():
            if key in lower:
                response_text = value() if callable(value) else value
                break

        # 3. Если не найдено — общий ответ
        if response_text is None:
            response_text = (
                f"Запрос принят. L3_in: {l3_in}.\n"
                f"Я — агент v6. Моя задача — помогать Root-Architect.\n"
                f"Для подключения LLM-слоя используйте метод set_llm().\n"
                f"Введите 'команды' для списка доступных команд."
            )

        # 4. Оценка выхода
        l3_out = self._evaluate_output(response_text)

        # 5. Если L3_out = -1 — блокируем
        if l3_out == -1:
            return {
                "status": "veto",
                "message": "Ответ заблокирован (L3_out = -1)",
                "l3_in": l3_in,
                "l3_out": -1,
                "response": None
            }

        # 6. Сохранение в память
        self.memory.save("query", user_input)
        self.memory.save("response", response_text)
        self.memory.save("l3_in", l3_in)
        self.memory.save("l3_out", l3_out)

        # 7. История
        self.history.append({
            "input": user_input,
            "output": response_text,
            "l3_in": l3_in,
            "l3_out": l3_out,
            "time": time.time()
        })

        self.l3_status = l3_out

        return {
            "status": "success",
            "l3_in": l3_in,
            "l3_out": l3_out,
            "response": response_text,
            "memory_hash": self.memory.hashes.get("response", None),
            "history_size": len(self.history)
        }

    # ----------------------------------------------------------
    # УПРАВЛЕНИЕ АГЕНТОМ
    # ----------------------------------------------------------

    def veto(self) -> Dict:
        """Активирует STOP Veto — агент останавливается."""
        self.active = False
        self.l3_status = -1
        self.memory.save("veto", "Агент остановлен")
        return {
            "status": "veto",
            "message": "Агент остановлен Root-Architect Veto",
            "l3_status": -1
        }

    def resume(self) -> Dict:
        """Возобновляет работу агента."""
        self.active = True
        self.l3_status = 0
        self.memory.save("resume", "Агент возобновлён")
        return {
            "status": "resumed",
            "message": "Агент активен",
            "l3_status": 0
        }

    def status(self) -> Dict:
        """Возвращает полный статус агента."""
        return {
            "active": self.active,
            "l3_status": self.l3_status,
            "memory_size": len(self.memory.memory),
            "history_size": len(self.history),
            "root_architect": self.architect,
            "sha_256": self.root_hash,
            "version": self.version
        }

    def memory_dump(self) -> Dict:
        """Возвращает содержимое памяти."""
        return {
            "last_10": self.memory.get_last(10),
            "total": len(self.memory.memory),
            "hashes": list(self.memory.hashes.keys())[-5:]
        }

    # ----------------------------------------------------------
    # ПОДКЛЮЧЕНИЕ LLM (ЗАГОТОВКА)
    # ----------------------------------------------------------

    def set_llm(self, llm_type: str, config: Dict = None):
        """
        Место для подключения внешнего LLM.
        llm_type: 'gemini', 'claude', 'local'
        """
        self._llm_type = llm_type
        self._llm_config = config or {}
        self.memory.save("llm_connected", f"{llm_type} - {self._llm_config}")
        print(f"[Агент] LLM подключён: {llm_type}")


