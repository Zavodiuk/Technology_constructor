@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_guard(signal: np.ndarray) -> np.ndarray:
    np.clip(signal, -2, 2, out=signal)
    return signal


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_translate_to_power_streams(
    cubes_arr: np.ndarray, 
    tiles_y: int, 
    tiles_x: int, 
    out_powers: np.ndarray, 
    out_frequencies: np.ndarray, 
    out_gases: np.ndarray,
    out_thermal_limits: np.ndarray,
    out_coords: np.ndarray,
    mode_hardening: bool
):
    """
    ===================================================================
    BRANCHLESS JIT MODULATION & PHASE-2 ALMAZ HARDENING KERNEL
    ===================================================================
    Fully processes all 4 faces of the 3-4-5 tetrahedral volumetric blocks:
    - FACE_MOTION (0): Trit-based acoustic frequency shift for slag ejection or micro-forging.
    - FACE_ENERGY (1): Quad-based laser diode pump power percentage (25%..100%).
    - FACE_MASK (2): Assist gas pressure modulation (bar) for rapid cooling / quenching.
    - FACE_TRUST (3): Thermal feedback / pyrometer feedback loop for branchless power stabilization.
    ===================================================================
    """
    num_cubes = tiles_y * tiles_x
    
    for idx in prange(num_cubes):
        ty = idx // tiles_x
        tx = idx % tiles_x
        y0 = ty * 5
        x0 = tx * 5
        
        for y in range(5):
            for x in range(5):
                target_y = y0 + y
                target_x = x0 + x
                
                for t in range(5):
                    # 1. Face 0: Motion / Rhythm (Trit extraction)
                    penta_motion = int(cubes_arr[idx, y, x, t, FACE_MOTION]) - 2
                    pm_idx = penta_motion + 2
                    if pm_idx < 0: pm_idx = 0
                    if pm_idx > 4: pm_idx = 4
                    trit = _JIT_UNPACK_LUT[pm_idx, 0]  # -1, 0, or 1
                    
                    # 2. Face 1: Energy / Power (Quad extraction)
                    penta_energy = int(cubes_arr[idx, y, x, t, FACE_ENERGY]) - 2
                    pe_idx = penta_energy + 2
                    if pe_idx < 0: pe_idx = 0
                    if pe_idx > 4: pe_idx = 4
                    quad = _JIT_UNPACK_LUT[pe_idx, 1]
                    if quad < 0: quad = 0
                    elif quad > 3: quad = 3
                    base_power_pct = (quad + 1) * 25
                    
                    # 3. Face 2: Mask / Assist Gas (Dynamic pressure mapping)
                    penta_mask = int(cubes_arr[idx, y, x, t, FACE_MASK]) - 2  # -2 to +2
                    # Map to gas pressure scale: 2.0 to 10.0 bar
                    gas_bar = float(penta_mask + 3) * 2.0
                    
                    # 4. Face 3: Trust / Thermal Feedback (Pyrometer loop simulation)
                    penta_trust = int(cubes_arr[idx, y, x, t, FACE_TRUST]) - 2  # -2 to +2
                    thermal_factor = 1.0 - (float(penta_trust) * 0.05)  # +/- 10% adjustment
                    if thermal_factor < 0.7: thermal_factor = 0.7
                    if thermal_factor > 1.2: thermal_factor = 1.2
                    
                    # Mode selection: Standard Cutting vs. Almaz Hardening
                    final_power_pct = base_power_pct
                    if mode_hardening:
                        # In "Almaz" nanostructuring mode, apply thermal feedback attenuation & micro-pulsing
                        final_power_pct = int(float(base_power_pct) * thermal_factor)
                        if final_power_pct > 100: final_power_pct = 100
                        if final_power_pct < 10: final_power_pct = 10
                        
                    # Frequency offset calculation
                    freq_offset_hz = 0
                    if trit == -1:
                        freq_offset_hz = -500 if not mode_hardening else -1500  # Deep micro-forging shock
                    elif trit == 1:
                        freq_offset_hz = 1000 if not mode_hardening else 3000   # High-speed plasma shock / diamond wave
                        
                    flat_target_idx = idx * (5 * 5 * 5) + (y * 25 + x * 5 + t)
                    out_powers[flat_target_idx] = np.uint8(final_power_pct)
                    out_frequencies[flat_target_idx] = np.int32(20000 + freq_offset_hz)
                    out_gases[flat_target_idx] = np.float32(gas_bar)
                    out_thermal_limits[flat_target_idx] = np.float32(thermal_factor)
                    out_coords[flat_target_idx, 0] = np.int32(target_y)
                    out_coords[flat_target_idx, 1] = np.int32(target_x)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_calculate_mean_energy(data: np.ndarray, semantic_data: np.ndarray) -> float:
    d_flat = data.ravel()
    s_flat = semantic_data.ravel()
    n = d_flat.size
    d_sum = 0.0
    s_sum = 0.0
    for i in range(n):
        d_sum += abs(int(d_flat[i]) - 2)
        s_sum += abs(int(s_flat[i]) - 2)
    return float((d_sum / n + s_sum / n) / 2.0)


