@dataclass
class SolveStep:
    """Один шаг решения"""
    rotation: str
    before_state: RubiksCubeMatrix
    after_state: RubiksCubeMatrix
    progress: float  # как далеко мы от решения (0-1)
    gain: float      # насколько улучшилось
    loss: float      # насколько ухудшилось


class RubiksCubeSolver:
    """Решатель кубика Рубика на основе V9"""
    
    def __init__(self, max_depth: int = 20):
        self.max_depth = max_depth
        self.solution_path: List[str] = []
        self.history: List[SolveStep] = []
    
    def estimate_distance(self, cube: RubiksCubeMatrix) -> int:
        """
        Эвристика: оценка расстояния до решения
        
        На основе:
        - Количества неправильных ячеек
        - Количества конфликтов
        - Энтропии
        """
        unsolved = cube.get_unsolved_count()
        conflicts = cube.get_conflict_count() * 2  # конфликты важнее
        entropy = cube.entropy_3d() * 5
        
        return unsolved + conflicts + int(entropy)
    
    def solve_greedy(self, cube: RubiksCubeMatrix, max_iterations: int = 100) -> bool:
        """
        Жадный алгоритм: на каждом шаге выбрать поворот, который уменьшает расстояние
        
        СМЫСЛ:
        - На каждом шаге пробуем все 6 вращений
        - Выбираем то, которое ближайшее к решению
        - Повторяем, пока не соберём или не достигнем макс итераций
        """
        current = cube.copy()
        
        for iteration in range(max_iterations):
            if current.is_solved():
                return True
            
            current_distance = self.estimate_distance(current)
            best_rotation = None
            best_next_state = None
            best_distance = current_distance
            
            # Пробуем все вращения
            for axis in CubeRotation.all_rotations():
                next_state = CubeRotation.rotate_face_clockwise(current, axis)
                next_distance = self.estimate_distance(next_state)
                
                if next_distance < best_distance:
                    best_distance = next_distance
                    best_rotation = axis
                    best_next_state = next_state
            
            # Если ничего не улучшилось — пробуем случайное вращение
            if best_rotation is None:
                import random
                best_rotation = random.choice(CubeRotation.all_rotations())
                best_next_state = CubeRotation.rotate_face_clockwise(current, best_rotation)
            
            # Записываем шаг
            gain = current_distance - best_distance
            loss = 0 if gain > 0 else -gain
            progress = 1.0 - (best_distance / 81.0)  # максимум 81 ячейка неправильно
            
            step = SolveStep(
                rotation=best_rotation,
                before_state=current.copy(),
                after_state=best_next_state.copy(),
                progress=min(1.0, progress),
                gain=gain,
                loss=loss
            )
            
            self.history.append(step)
            self.solution_path.append(best_rotation)
            current = best_next_state
        
        return current.is_solved()
    
    def get_solution(self) -> List[str]:
        """Получить последовательность вращений для решения"""
        return self.solution_path
    
    def get_analysis(self) -> Dict[str, Any]:
        """Полный анализ процесса решения"""
        if not self.history:
            return {'error': 'Нет истории'}
        
        total_gain = sum(step.gain for step in self.history)
        total_loss = sum(step.loss for step in self.history)
        avg_progress = sum(step.progress for step in self.history) / len(self.history)
        
        return {
            'steps': len(self.history),
            'solution': self.solution_path,
            'total_gain': total_gain,
            'total_loss': total_loss,
            'average_progress': round(avg_progress, 3),
            'solved': self.history[-1].after_state.is_solved() if self.history else False,
            'final_stability': round(self.history[-1].after_state.stability_index(), 3),
            'final_entropy': round(self.history[-1].after_state.entropy_3d(), 3),
            'steps_detail': [
                {
                    'rotation': step.rotation,
                    'progress': round(step.progress, 3),
                    'gain': round(step.gain, 1),
                    'loss': round(step.loss, 1)
                }
                for step in self.history[-10:]  # последние 10 шагов
            ]
        }


