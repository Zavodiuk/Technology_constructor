    # 12 рёбер
    UF = (0, 1, 0)
    UB = (0, 1, 2)
    UL = (0, 0, 1)
    UR = (0, 2, 1)
    DF = (2, 1, 0)
    DB = (2, 1, 2)
    DL = (2, 0, 1)
    DR = (2, 2, 1)
    LF = (1, 0, 0)
