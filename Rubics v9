    # 1 ядро
    CENTER = (1, 1, 1)


class CubeState(Enum):
    """Состояния ячейки кубика в L3"""
    CORRECT = 1      # на месте, правильная ориентация
    UNDEFINED = 0    # переходное состояние
    WRONG = -1       # не на месте или неправильная ориентация


# ============================================================
# 2. ОБЪЕМНАЯ ТРОИЧНАЯ МАТРИЦА 3×3×3
# ============================================================

class RubiksCubeMatrix:
    """
    Куба Рубика как объемная троичная матрица 3×3×3
    
    КОДИРОВАНИЕ:
    [[[a000, a001, a002],
      [a010, a011, a012],
      [a020, a021, a022]],
     
     [[a100, a101, a102],
      [a110, a111, a112],
      [a120, a121, a122]],
     
     [[a200, a201, a202],
      [a210, a211, a212],
      [a220, a221, a222]]]
    
    где каждый элемент a_ijk ∈ {-1, 0, 1}
    """
    
    def __init__(self, data: Optional[List[List[List[int]]]] = None):
        if data is None:
            # Инициализация идеального кубика
            data = [[[1 for _ in range(3)] for _ in range(3)] for _ in range(3)]
        
        self.data = data  # 3D массив [i][j][k]
        self._validate()
    
    def _validate(self):
        """Проверка корректности матрицы"""
        if len(self.data) != 3 or not all(len(row) == 3 for layer in self.data for row in layer):
            raise ValueError("Матрица должна быть 3×3×3")
        
        for i in range(3):
            for j in range(3):
                for k in range(3):
                    if self.data[i][j][k] not in [-1, 0, 1]:
                        raise ValueError(f"Недопустимое значение в [{i}][{j}][{k}]")
    
    def copy(self) -> 'RubiksCubeMatrix':
        """Создать копию"""
        import copy
        return RubiksCubeMatrix(copy.deepcopy(self.data))
    
    def get_cell(self, pos: CubePosition) -> int:
        """Получить значение ячейки"""
        i, j, k = pos.value
        return self.data[i][j][k]
    
    def set_cell(self, pos: CubePosition, val: int):
        """Установить значение ячейки"""
        i, j, k = pos.value
        self.data[i][j][k] = val
    
    def is_solved(self) -> bool:
        """Проверить, собран ли кубик (все 1)"""
        for i in range(3):
            for j in range(3):
                for k in range(3):
                    if self.data[i][j][k] != 1:
                        return False
        return True
    
    def get_unsolved_count(self) -> int:
        """Количество неправильных ячеек"""
        count = 0
        for i in range(3):
            for j in range(3):
                for k in range(3):
                    if self.data[i][j][k] != 1:
                        count += 1
        return count
    
    def get_conflict_count(self) -> int:
        """Количество конфликтов (ячейки = -1)"""
        count = 0
        for i in range(3):
            for j in range(3):
                for k in range(3):
                    if self.data[i][j][k] == -1:
                        count += 1
        return count
    
    def determinant_3d(self) -> int:
        """
        Детерминант 3D матрицы (норм форма, нормализованно в L3)
        
        det > 0  → система стремится к порядку
        det = 0  → система в переходе
        det < 0  → система в конфликте
        
        Результат нормализуется в {-1, 0, 1}
        """
        # Суммируем все элементы (упрощённо)
        total = 0
        for i in range(3):
            for j in range(3):
                for k in range(3):
                    total += self.data[i][j][k]
        
        # Нормализация: всего 27 ячеек
        # max sum = 27 (все 1)
        # min sum = -27 (все -1)
        if total > 0:
            return 1
        elif total < 0:
            return -1
        else:
            return 0
    
    def entropy_3d(self) -> float:
        """
        Энтропия 3D матрицы (мера беспорядка)
        
        entropy = 0   → всё на месте (собран)
        entropy = 1.0 → всё перемешано (максимум хаоса)
        """
        ones = sum(1 for i in range(3) for j in range(3) for k in range(3) 
                   if self.data[i][j][k] == 1)
        zeros = sum(1 for i in range(3) for j in range(3) for k in range(3)
                    if self.data[i][j][k] == 0)
        negs = sum(1 for i in range(3) for j in range(3) for k in range(3)
                   if self.data[i][j][k] == -1)
        
        total = 27
        p1 = ones / total
        p0 = zeros / total
        pn = negs / total
        
        entropy = 0.0
        for p in [p1, p0, pn]:
            if p > 0:
                entropy -= p * math.log2(p) / math.log2(3)  # нормализуем на log2(3)
        
        return entropy
    
    def stability_index(self) -> float:
        """
        Индекс стабильности (0-1)
        
        0.0  → максимум конфликтов (все -1)
        0.5  → переходное состояние (смесь)
        1.0  → идеально собран (все 1)
        """
        conflicts = self.get_conflict_count()
        return 1.0 - (conflicts / 27.0)
    
    def to_dict(self) -> Dict:
        return {
            'data': self.data,
            'unsolved': self.get_unsolved_count(),
            'conflicts': self.get_conflict_count(),
            'determinant': self.determinant_3d(),
            'entropy': round(self.entropy_3d(), 3),
            'stability': round(self.stability_index(), 3),
            'is_solved': self.is_solved()
        }
    
    def __repr__(self):
        unsolved = self.get_unsolved_count()
        return f"RubiksCubeMatrix(unsolved={unsolved}, stability={self.stability_index():.2f})"


