# 3. ОПЕРАЦИИ ВРАЩЕНИЯ КУБИКА
# ============================================================

class CubeRotation:
    """Вращения граней кубика Рубика"""
    
    @staticmethod
    def rotate_face_clockwise(cube: RubiksCubeMatrix, axis: str) -> RubiksCubeMatrix:
        """
        Вращение грани по часовой стрелке
        
        axis: 'U', 'D', 'L', 'R', 'F', 'B'
        
        СМЫСЛ В L3:
        - Ячейки на грани циклически смещаются
        - Некоторые ячейки меняют ориентацию → переходят в 0
        - При правильном вращении → возвращаются в 1
        """
        result = cube.copy()
        
        if axis == 'U':  # верх (i=0)
            # Циклический сдвиг верхнего слоя
            temp = [
                [result.data[0][0][0], result.data[0][0][1], result.data[0][0][2]],
                [result.data[0][1][0], result.data[0][1][1], result.data[0][1][2]],
                [result.data[0][2][0], result.data[0][2][1], result.data[0][2][2]]
            ]
            
            # Поворот верхнего слоя по часовой
            rotated = [
                [temp[2][0], temp[1][0], temp[0][0]],
                [temp[2][1], temp[1][1], temp[0][1]],
                [temp[2][2], temp[1][2], temp[0][2]]
            ]
            
            for j in range(3):
                for k in range(3):
                    result.data[0][j][k] = rotated[j][k]
        
        elif axis == 'D':  # низ (i=2)
            temp = [
                [result.data[2][0][0], result.data[2][0][1], result.data[2][0][2]],
                [result.data[2][1][0], result.data[2][1][1], result.data[2][1][2]],
                [result.data[2][2][0], result.data[2][2][1], result.data[2][2][2]]
            ]
            
            rotated = [
                [temp[0][2], temp[1][2], temp[2][2]],
                [temp[0][1], temp[1][1], temp[2][1]],
                [temp[0][0], temp[1][0], temp[2][0]]
            ]
            
            for j in range(3):
                for k in range(3):
                    result.data[2][j][k] = rotated[j][k]
        
        elif axis == 'F':  # передняя (k=0)
            temp = [
                [result.data[0][0][0], result.data[0][1][0], result.data[0][2][0]],
                [result.data[1][0][0], result.data[1][1][0], result.data[1][2][0]],
                [result.data[2][0][0], result.data[2][1][0], result.data[2][2][0]]
            ]
            
            rotated = [
                [temp[2][0], temp[1][0], temp[0][0]],
                [temp[2][1], temp[1][1], temp[0][1]],
                [temp[2][2], temp[1][2], temp[0][2]]
            ]
            
            for i in range(3):
                for j in range(3):
                    result.data[i][j][0] = rotated[i][j]
        
        elif axis == 'B':  # задняя (k=2)
            temp = [
                [result.data[0][0][2], result.data[0][1][2], result.data[0][2][2]],
                [result.data[1][0][2], result.data[1][1][2], result.data[1][2][2]],
                [result.data[2][0][2], result.data[2][1][2], result.data[2][2][2]]
            ]
            
            rotated = [
                [temp[0][2], temp[1][2], temp[2][2]],
                [temp[0][1], temp[1][1], temp[2][1]],
                [temp[0][0], temp[1][0], temp[2][0]]
            ]
            
            for i in range(3):
                for j in range(3):
                    result.data[i][j][2] = rotated[i][j]
        
        elif axis == 'L':  # левая (j=0)
            temp = [
                [result.data[0][0][0], result.data[0][0][1], result.data[0][0][2]],
                [result.data[1][0][0], result.data[1][0][1], result.data[1][0][2]],
                [result.data[2][0][0], result.data[2][0][1], result.data[2][0][2]]
            ]
            
            rotated = [
                [temp[2][0], temp[1][0], temp[0][0]],
                [temp[2][1], temp[1][1], temp[0][1]],
                [temp[2][2], temp[1][2], temp[0][2]]
            ]
            
            for i in range(3):
                for k in range(3):
                    result.data[i][0][k] = rotated[i][k]
        
        elif axis == 'R':  # правая (j=2)
            temp = [
                [result.data[0][2][0], result.data[0][2][1], result.data[0][2][2]],
                [result.data[1][2][0], result.data[1][2][1], result.data[1][2][2]],
                [result.data[2][2][0], result.data[2][2][1], result.data[2][2][2]]
            ]
            
            rotated = [
                [temp[0][2], temp[1][2], temp[2][2]],
                [temp[0][1], temp[1][1], temp[2][1]],
                [temp[0][0], temp[1][0], temp[2][0]]
            ]
            
            for i in range(3):
                for k in range(3):
                    result.data[i][2][k] = rotated[i][k]
        
        return result
    
    @staticmethod
    def rotate_face_counterclockwise(cube: RubiksCubeMatrix, axis: str) -> RubiksCubeMatrix:
        """Вращение против часовой стрелки (3 раза по часовой)"""
        result = cube.copy()
        for _ in range(3):
            result = CubeRotation.rotate_face_clockwise(result, axis)
        return result
    
    @staticmethod
    def all_rotations() -> List[str]:
        """Все возможные вращения"""
        return ['U', 'D', 'L', 'R', 'F', 'B']


