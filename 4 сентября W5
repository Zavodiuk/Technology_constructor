import numpy as np
from typing import Union

Penta = np.ndarray  # dtype=np.int8, значения -2..2
K = 2  # Параметр домена (пентарная логика: -2, -1, 0, 1, 2)


def _check_penta(arr: Penta) -> Penta:
    """Строгая проверка принадлежности массива пентарному домену {-2, -1, 0, 1, 2}."""
    if not np.all(np.isin(arr, [-2, -1, 0, 1, 2])):
        raise ValueError("Массив содержит значения вне допустимого пентарного диапазона {-2, -1, 0, 1, 2}")
    return arr


def make_penta_array(values) -> Penta:
    """Конвертация входящих данных в проверенный NumPy-массив пентайтов."""
    return _check_penta(np.asarray(values, dtype=np.int8))


# ============================================================================
# 1. ПЕНТАРНЫЕ ОПЕРАЦИИ (Чистая арифметика по формулам Лукасевича)
# ============================================================================

def penta_not(a: Penta) -> Penta:
    """Инверсия пентарного значения: not(a) = -a."""
    return -_check_penta(a)


def penta_impl(a: Penta, b: Penta) -> Penta:
    """Пентарная импликация по формуле: impl(a, b) = min(K, K - a + b)."""
    a, b = _check_penta(a), _check_penta(b)
    if a.shape != b.shape:
        raise ValueError(f"Размеры массивов не совпадают: {a.shape} != {b.shape}")
    return np.minimum(K, K - a + b).astype(np.int8)


def penta_and(a: Penta, b: Penta) -> Penta:
    """Сильная конъюнкция: and(a, b) = not(impl(a, not(b))) = max(-K, a + b - K)."""
    return penta_not(penta_impl(a, penta_not(b)))


def penta_or(a: Penta, b: Penta) -> Penta:
    """Дизъюнкция: or(a, b) = impl(not(a), b) = min(K, a + b + K)."""
    return penta_impl(penta_not(a), b)


# ============================================================================
# 2. БАТЧ-СВЁРТКИ (Древовидная редукция для пентарных векторов)
# ============================================================

def _tree_reduce_batch(matrix: Penta, op, neutral: int) -> np.ndarray:
    m = _check_penta(matrix).copy()
    while m.shape[1] > 1:
        k = m.shape[1]
        if k % 2 == 1:
            m = np.concatenate([m, np.full((m.shape[0], 1), neutral, dtype=np.int8)], axis=1)
        left, right = m[:, 0::2], m[:, 1::2]
        m = op(left, right)
    return m[:, 0]


def fold_and_batch(matrix: Penta) -> np.ndarray:
    """Пакетная свёртка через AND (нейтральный элемент = +2, сильное 'да')."""
    return _tree_reduce_batch(matrix, penta_and, neutral=2)


def fold_or_batch(matrix: Penta) -> np.ndarray:
    """Пакетная свёртка через OR (нейтральный элемент = -2, сильное 'нет')."""
    return _tree_reduce_batch(matrix, penta_or, neutral=-2)


