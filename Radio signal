# 2. ГИПЕРБОЛИЧЕСКАЯ ГЕОМЕТРИЯ (ЛОБАЧЕВСКИЙ)
# ============================================================

def hyperbolic_distance(vec_a, vec_b, radius=1.0):
    if len(vec_a) != len(vec_b):
        raise ValueError("Размерности не совпадают")
    a = [v / radius for v in vec_a]
    b = [v / radius for v in vec_b]
    norm_a = math.sqrt(sum(ai**2 for ai in a))
    norm_b = math.sqrt(sum(bi**2 for bi in b))
    max_safe = 0.999999
    if norm_a >= 1.0: norm_a = max_safe
    if norm_b >= 1.0: norm_b = max_safe
    numerator = sum((ai - bi)**2 for ai, bi in zip(a, b))
    denominator = (1.0 - norm_a**2) * (1.0 - norm_b**2)
    if denominator <= 0: return float('inf')
    arg = 1.0 + 2.0 * numerator / denominator
    if arg < 1.0: arg = 1.0
    return radius * math.acosh(arg)

# ============================================================
# 3. RASHOMON-ДЕКОДЕР
# ============================================================

def rashomon_decode(received_signal, original_length, radius=1.0):
    recovered = []
    for i in range(original_length):
        angle = cmath.phase(received_signal[i])
        target_angles = [-2*math.pi/3, 0.0, 2*math.pi/3]
        best_match = min(target_angles, key=lambda x: abs(x - angle))
        recovered.append(best_match)
    return recovered

