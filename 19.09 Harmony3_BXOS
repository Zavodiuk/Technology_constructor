# 6. EMBEDDED BENCHMARK SUITE (5000 ITERATIONS)
# ============================================================

def run_benchmark():
    print("=" * 70)
    print("HARMONY3 / BXOS — ВСТРОЕННЫЙ БЕНЧМАРК (5000 итераций)")
    print("=" * 70)
    
    pipeline = BXOSPipeline()
    
    mock_scores = [0.85, 0.62, 0.41, 0.15, 0.05]
    mock_l5_vector = [1, 0, -1, 2, -2]
    
    iterations = 5000
    
    # Прогрев (warm-up)
    for _ in range(100):
        pipeline.run(mock_scores, mock_l5_vector)
        
    start_time = time.perf_counter()
    
    for _ in range(iterations):
        pipeline.run(mock_scores, mock_l5_vector)
        
    total_time = time.perf_counter() - start_time
    avg_time_ms = (total_time / iterations) * 1000
    ops_per_sec = iterations / total_time
    
    print(f"[+] Всего итераций: {iterations}")
    print(f"[+] Общее время выполнения: {total_time:.4f} сек")
    print(f"[+] Среднее время одного вызова: {avg_time_ms:.4f} мс")
    print(f"[+] Пропускная способность: {ops_per_sec:,.2f} опер/сек")
    print("=" * 70)


