# МОДУЛЬ 4: ИНТЕГРИРОВАННЫЙ ОРКЕСТРАТОР W23.0
# ============================================================================
class MoiréUnifiedOrchestratorW23:
    def __init__(self):
        self.macro_field = MacroFieldW23((7, 7))
        self.bi_core = CounterRotatingTernaryBiCore(size=3)
        self.hysteresis = PhaseHysteresisMemory(window_size=4)
        self.time_step: int = 0

    def execute_sync_cycle(self) -> Tuple[int, int, float, float, int]:
        self.time_step += 1
        current_entropy = self.macro_field.calculate_entropy()
        recovered_nodes = 0
        
        # Интеграция векторной рекуперации при перегреве энтропии
        if current_entropy > 0.55:
            recovered_nodes = self.macro_field.recover_extremes()

        self.bi_core.update_rotation(current_entropy)
        
        slice_field = self.macro_field.field[2:5, 2:5]
        
        interaction_sum = 0
        matches = 0
        
        for tx in range(3):
            for ty in range(3):
                val_a = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_a, self.bi_core.matrix_a)
                val_b = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_b, self.bi_core.matrix_b)
                
                # Двойной муар-эффект интерференции тернарных ядер (с клиппингом в троичный диапазон)
                core_interference = ternary_clip(val_a + val_b)
                
                if tx < slice_field.shape[0] and ty < slice_field.shape[1]:
                    p_val = int(slice_field[tx, ty])
                    product_val = core_interference * p_val
                    interaction_sum += product_val
                    if core_interference == p_val:
                        matches += 1

        # `:` — пороговая квантизация шлюза
        if interaction_sum > 2: raw_gate = 1
        elif interaction_sum >= -2: raw_gate = 0
        else: raw_gate = -1

        # Применение фазового гистерезиса топологической памяти
        stabilized_gate = self.hysteresis.register_state(raw_gate)
        coherence = float(matches / 9.0)
        
        return stabilized_gate, interaction_sum, current_entropy, coherence, recovered_nodes

    def display_telemetry(self) -> None:
        gate, sum_val, entropy, coherence, recovered = self.execute_sync_cycle()
        deg_a = math.degrees(self.bi_core.angle_a) % 360
        deg_b = math.degrees(self.bi_core.angle_b) % 360
        print(f"\n================ [ СИНХРО-МУАР W23.0: ТАКТ №{self.time_step} ] ================")
        print(f"  -> Энтропия среды (Base-3): {entropy:.4f}")
        print(f"  -> Индексы фазы [Alpha: {self.bi_core.step_index_a} ({deg_a:.1f}°) | Beta: {self.bi_core.step_index_b} ({deg_b:.1f}°)]")
        print(f"  -> Интегральный индекс муара (Σ): {sum_val:+d}")
        print(f"  -> Когерентность сетки: {coherence:.2f}")
        print(f"  -> Восстановлено узлов (NumPy Mask): {recovered}")
        print(f"  -> Стабилизированный шлюз (Гистерезис): {gate:+d} ({TERNARY_CODE[gate]})")


