class MacroFieldV23:
    def __init__(self, dimensions: Tuple[int, int] = (7, 7)):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=int)

    def load_block(self, block_bytes: bytes) -> None:
        flat_vals = []
        for b in block_bytes:
            val = ((b % 5) - 2)
            flat_vals.append(val)
        
        total_cells = self.field.size
        while len(flat_vals) < total_cells:
            flat_vals.append(0)
        
        self.field = np.array(flat_vals[:total_cells], dtype=int).reshape(self.dimensions)

    def extract_block(self) -> bytes:
        flat = self.field.flatten()
        out_bytes = bytearray()
        for val in flat:
            b = int((val + 2) * 51) & 0xFF
            out_bytes.append(b)
        return bytes(out_bytes)

    def calculate_entropy(self) -> float:
        total = self.field.size
        unique, counts = np.unique(self.field, return_counts=True)
        entropy = 0.0
        for count in counts:
            p = count / total
            if p > 0:
                entropy -= p * math.log2(p)
        return float(entropy)

    def recover_extremes(self) -> int:
        count = 0
        it = np.nditer(self.field, flags=['multi_index'], op_flags=['readwrite'])
        while not it.finished:
            if it[0] == -2:
                it[0] = 0
                count += 1
            it.iternext()
        return count


class CounterRotatingBiCore:
    def __init__(self, size: int = 3, initial_angle_a: float = 0.0, initial_angle_b: float = 0.0):
        self.size = size
        self.matrix_a = self._generate_ternary(size)
        self.matrix_b = self._generate_ternary(size)
        self.angle_a: float = initial_angle_a
        self.angle_b: float = initial_angle_b
        self.base_velocity: float = math.pi / 6.0

    def _generate_ternary(self, size: int) -> np.ndarray:
        mat = np.zeros((size, size), dtype=int)
        mid = size // 2
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid: mat[x, y] = 0
                elif (x + y) % 2 == 0: mat[x, y] = 1
                else: mat[x, y] = -1
        return mat

    def update_rotation(self, entropy: float) -> None:
        dynamic_velocity = self.base_velocity / (1.0 + entropy * 2.0)
        self.angle_a += dynamic_velocity
        self.angle_b -= dynamic_velocity * 1.5
        if self.angle_a >= 2 * math.pi: self.angle_a = 0.0
        if self.angle_b <= -2 * math.pi: self.angle_b = 0.0

    def get_combined_state(self, local_coord: Tuple[int, int], angle: float, matrix: np.ndarray) -> int:
        x, y = local_coord
        mid = self.size // 2
        ox, oy = x - mid, y - mid
        cos_a, sin_a = math.cos(angle), math.sin(angle)
        rx = int(round(ox * cos_a - oy * sin_a))
        ry = int(round(ox * sin_a + oy * cos_a))
        tx = max(0, min(self.size - 1, rx + mid))
        ty = max(0, min(self.size - 1, ry + mid))
        return int(matrix[tx, ty])


class PhaseHysteresisMemory:
    def __init__(self, window_size: int = 4):
        self.history = deque(maxlen=window_size)

    def register_state(self, state: int) -> int:
        self.history.append(state)
        avg = sum(self.history) / len(self.history)
        if avg > 1.2: return 2
        elif avg > 0.3: return 1
        elif avg >= -0.3: return 0
        elif avg >= -1.2: return -1
        else: return -2


class MoiréCryptoEngineV23:
    """Криптографический механизм на базе би-ядерного муарового редуктора V23."""
    def __init__(self, seed_angle_a: float = 0.5, seed_angle_b: float = 1.2):
        self.macro_field = MacroFieldV23((7, 7))
        self.bi_core = CounterRotatingBiCore(size=3, initial_angle_a=seed_angle_a, initial_angle_b=seed_angle_b)
        self.hysteresis = PhaseHysteresisMemory(window_size=4)

    def _transform_matrix(self, encrypt: bool = True) -> Tuple[np.ndarray, float]:
        entropy = self.macro_field.calculate_entropy()
        if entropy > 0.65:
            self.macro_field.recover_extremes()
        
        self.bi_core.update_rotation(entropy)
        slice_field = self.macro_field.field[2:5, 2:5]
        
        new_slice = np.copy(slice_field)
        matches = 0
        
        for tx in range(3):
            for ty in range(3):
                val_a = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_a, self.bi_core.matrix_a)
                val_b = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_b, self.bi_core.matrix_b)
                core_interference = val_a + val_b
                
                if tx < slice_field.shape[0] and ty < slice_field.shape[1]:
                    p_val = slice_field[tx, ty]
                    if encrypt:
                        res_val = max(-2, min(2, p_val + core_interference))
                    else:
                        res_val = max(-2, min(2, p_val - core_interference))
                    
                    new_slice[tx, ty] = res_val
                    if core_interference == p_val:
                        matches += 1

        self.macro_field.field[2:5, 2:5] = new_slice
        coherence = float(matches / 9.0)
        return self.macro_field.field, coherence

    def encrypt_block(self, block: bytes) -> bytes:
        self.macro_field.load_block(block)
        self._transform_matrix(encrypt=True)
        return self.macro_field.extract_block()

    def decrypt_block(self, block: bytes) -> bytes:
        self.macro_field.load_block(block)
        self._transform_matrix(encrypt=False)
        return self.macro_field.extract_block()


