# МОДУЛЬ 1: ТРЕХМЕРНЫЙ ТЕНЗОРНЫЙ КУБ (5x5x5) С 6 ГРАНЯМИ-ПОРТАМИ
# ============================================================================
class TensorCube5x5x5:
    """
    Кубическая тензорная сетка 5x5x5 (125 элементов).
    Каждый мини-кубик имеет 6 граней-портов по смысловым осям:
      - Ось X (±X): Намерение / Цель (индексы граней 0, 1)
      - Ось Y (±Y): Контекст / Онтология (индексы граней 2, 3)
      - Ось Z (±Z): Действие / Результат (индексы граней 4, 5)
    """
    def __init__(self, size: int = 5):
        self.size = size
        self.dimensions = (size, size, size)
        self.field = np.zeros(self.dimensions, dtype=int)
        # Матрица пропускной способности для 6 граней каждого кубика
        self.permeability_grid = np.ones((size, size, size, 6), dtype=float)

    def inject_quantum_impulse(self, coordinates: Tuple[int, int, int], value: int):
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно строго лежать в пентарном базисе [-2, 2]")
        if all(0 << coordinates[i] < self.size for i in range(3)) or all(0 <= coordinates[i] < self.size for i in range(3)):
            self.field[coordinates] = value

    def get_face_neighbors(self, coords: Tuple[int, int, int]) -> List[Tuple[Tuple[int, int, int], int]]:
        """Возвращает соседей строго через 6 граней (портов) кубика"""
        x, y, z = coords
        directions = [
            ((-1, 0, 0), 0), # -X (Намерение минус)
            ((1, 0, 0), 1),  # +X (Намерение плюс)
            ((0, -1, 0), 2), # -Y (Контекст минус)
            ((0, 1, 0), 3),  # +Y (Контекст плюс)
            ((0, 0, -1), 4), # -Z (Действие минус)
            ((0, 0, 1), 5)   # +Z (Действие плюс)
        ]
        neighbors = []
        for (dx, dy, dz), face_idx in directions:
            nx, ny, nz = x + dx, y + dy, z + dz
            if 0 <= nx < self.size and 0 <= ny < self.size and 0 <= nz < self.size:
                neighbors.append(((nx, ny, nz), face_idx))
        return neighbors

    def propagate_through_faces(self):
        """Распространение волн строго через 6 граней-портов соседних мини-кубиков"""
        new_grid = self.field.copy()
        for x in range(self.size):
            for y in range(self.size):
                for z in range(self.size):
                    curr_coords = (x, y, z)
                    curr_val = self.field[curr_coords]
                    if curr_val == 0:
                        continue
                    
                    neighbors = self.get_face_neighbors(curr_coords)
                    for n_coords, face_idx in neighbors:
                        perm = self.permeability_grid[curr_coords][face_idx]
                        if perm > 0.1:
                            neighbor_val = self.field[n_coords]
                            # Плавное затухание импульса через грань (с защитой от обнуления)
                            impulse_delta = int(round(curr_val / 2.0))
                            if impulse_delta != 0:
                                updated = max(-2, min(2, neighbor_val + impulse_delta))
                                new_grid[n_coords] = updated
        self.field = new_grid

    def calculate_field_entropy(self) -> float:
        total = self.field.size
        if total == 0:
            return 0.0
        extremes = np.sum(np.abs(self.field) == 2)
        return float(extremes / total)


