# МОДУЛЬ 4: УНИВЕРСАЛЬНОЕ ИНТЕГРИРОВАННОЕ ЯДРО V16.2 (КУБ + АТТРАКТОРЫ)
# ============================================================================
class PentarnyUniverseV16Cube:
    def __init__(self, node_coords: dict, cube_size: int = 5):
        self.cube_size = cube_size
        self.tensor_cube = TensorCube5x5x5(cube_size)
        self.graph = PentarUniverseGraph()
        self.node_coords = node_coords

        # Инициализация двух независимых динамических аттракторов в 3D кубе
        mid = cube_size // 2
        self.attractor_alpha = ConflictAttractor3D("Альфа", (mid, mid, mid), cube_size)
        self.attractor_beta = ConflictAttractor3D("Бета", (cube_size - 1, cube_size - 1, 0), cube_size)

    def add_node(self, name: str, coords: tuple):
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str):
        self.graph.add_edge(src, tgt)

    def step(self):
        # 1. Тактовый импульс микро-графа
        self.graph.pulse()
        
        # 2. Проецирование решений графа в куб 5x5x5
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_cube.inject_quantum_impulse(coords, impulse_val)
        
        # 3. Распространение волн строго через 6 граней-портов кубиков
        self.tensor_cube.propagate_through_faces()

        # 4. Излучение импульсов от динамических аттракторов внутри куба
        alpha_pos = tuple(self.attractor_alpha.coords)
        beta_pos = tuple(self.attractor_beta.coords)
        
        self.tensor_cube.inject_quantum_impulse(alpha_pos, 2)
        self.tensor_cube.inject_quantum_impulse(beta_pos, -2)

        # 5. Вычисление градиентов куба и дрейф аттракторов
        gradient_fields = np.gradient(self.tensor_cube.field.astype(float))
        self.attractor_alpha.drift_by_conflict(self.tensor_cube.field, gradient_fields)
        self.attractor_beta.drift_by_conflict(self.tensor_cube.field, gradient_fields)

        # 6. Обратная связь дивергенции поля на каналы графа
        field_divergence = float(np.sum([np.sum(np.abs(g)) for g in gradient_fields]))
        for edge in self.graph.edges:
            edge.energy_flow = max(0.0, edge.energy_flow * (1.0 - (field_divergence * 0.01)))

    def display_state(self):
        gradient_fields = np.gradient(self.tensor_cube.field.astype(float))
        field_divergence = float(np.sum([np.sum(np.abs(g)) for g in gradient_fields]))
        
        print(f"\n================ [ СИНХРО-ТАКТ V16.2 (КУБ): {self.graph.time_step} ] ================")
        print(f"  -> Энтропия тензорного куба 5x5x5 : {self.tensor_cube.calculate_field_entropy():.4f}")
        print(f"  -> Дивергенция через грани-порты   : {field_divergence:.2f}")
        print(f"  -> Координаты аттрактора [Альфа]   : {self.attractor_alpha.coords}")
        print(f"  -> Координаты аттрактора [Бета]    : {self.attractor_beta.coords}")
        print("--- СОСТОЯНИЕ УЗЛОВ И КАНАЛОВ ГРАФА ---")
        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({PENTAR_CODE[node.decision][:20]}...) | МАССА = {node.mass:.2f}")
        for edge in self.graph.edges:
            print(f"  -> Канал [{edge.source.node_id} -> {edge.target.node_id}]: ПОТОК = {edge.energy_flow:.2f}, ТЕМП = {edge.temp:.2f}")


