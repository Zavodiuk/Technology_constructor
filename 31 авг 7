ТРОИЧНЫЕ МАТРИЦЫ — четвёртый слой схемы
================================================================================
Место в пайплайне:
  ... пентарный блок -> [ТРОИЧНЫЕ МАТРИЦЫ] -> пентарные матрицы -> BXOS -> ...

Отличия от исходной V9.1 (архив: archive/v9_ternary_matrix_original.py):
  - Убраны sign_normalization, dominance_map, stability_map,
    transition_velocity, stabilization — доказано (см. чат), что все пять
    алгебраически равны identity(matrix) на домене {-1,0,1}: "взять знак
    числа, которое и так уже -1/0/1" ничего не меняет.
  - conflict_index убран как дубликат diagonal_projection (идентичный код).
  - transposed_dominance убран: падал на неквадратных матрицах и на
    квадратных дублировал transpose().
  - Убраны recover_from_* — были прямо документированы как заглушки
    (return self.copy()), несущей функции не было.
  - Оставлены: add, multiply (L3-алгебра с клиппингом), transpose,
    determinant, entropy, stability_index — реальная разная математика,
    plus diagonal_projection и energy_presence — единственные две
    "функции состояния/динамики" из восьми, которые делают что-то, кроме
    identity.
  - MatrixBlockChain заменена на ту же лёгкую ограниченную цепочку, что и
    в пентарном блоке (без majning'а, с cap'ом).
  - Добавлен мостик from_pentary(): пентарные состояния (-2..2) с пяти
    L5-слоёв -> троичная диагональная матрица (для стыковки с прошлым
    слоем по схеме).
================================================================================
"""

import json
import time
import hashlib
import math
from typing import List, Dict, Any, Optional, Tuple
from dataclasses import dataclass


# ============================================================
# 1. ТРОИЧНАЯ МАТРИЦА
# ============================================================

class TernaryMatrix:
    """
    Значения: -1 (FALSE), 0 (UNDEFINED), 1 (TRUE).
    Алгебра: клиппинг в [-1, 1] после сложения/умножения (L3-алгебра,
    не стандартная линейная алгебра).
    """

    def __init__(self, data: List[List[int]]):
        self.data = data
        self.rows = len(data)
        self.cols = len(data[0]) if data else 0
        self._validate()

    def _validate(self):
        if not self.data:
            raise ValueError("Матрица не может быть пустой")
        for row in self.data:
            if len(row) != self.cols:
                raise ValueError(f"Все строки должны быть одинаковой длины: ожидается {self.cols}, получено {len(row)}")
            for val in row:
                if val not in (-1, 0, 1):
                    raise ValueError(f"Недопустимое значение {val}. Допустимы -1, 0, 1")

    def __repr__(self):
        return f"TernaryMatrix({self.rows}x{self.cols})"

    def __eq__(self, other):
        return isinstance(other, TernaryMatrix) and self.data == other.data

    def copy(self) -> 'TernaryMatrix':
        return TernaryMatrix([row[:] for row in self.data])

    @property
    def hash(self) -> str:
        return hashlib.sha256(json.dumps(self.data).encode()).hexdigest()

    def to_dict(self) -> Dict:
        return {'rows': self.rows, 'cols': self.cols, 'data': self.data, 'hash': self.hash[:16] + '...'}

    @staticmethod
    def _clip(v: int) -> int:
        return 1 if v > 1 else (-1 if v < -1 else v)

    # ---- L3-АЛГЕБРА ----

    def add(self, other: 'TernaryMatrix') -> 'TernaryMatrix':
        """clip(a+b, -1, 1): -1+1=0 (противоречие), 1+1=1 (насыщение, не 2)."""
        if (self.rows, self.cols) != (other.rows, other.cols):
            raise ValueError(f"Размеры не совпадают: {self.rows}x{self.cols} vs {other.rows}x{other.cols}")
        return TernaryMatrix([[self._clip(self.data[i][j] + other.data[i][j])
                               for j in range(self.cols)] for i in range(self.rows)])

    def multiply(self, other: 'TernaryMatrix') -> 'TernaryMatrix':
        """Стандартное матричное умножение, результат клиппирован в L3."""
        if self.cols != other.rows:
            raise ValueError(f"Несовместимые размеры: {self.cols} != {other.rows}")
        result = []
        for i in range(self.rows):
            row = []
            for j in range(other.cols):
                s = sum(self.data[i][k] * other.data[k][j] for k in range(self.cols))
                row.append(self._clip(s))
            result.append(row)
        return TernaryMatrix(result)

    def transpose(self) -> 'TernaryMatrix':
        return TernaryMatrix([[self.data[j][i] for j in range(self.rows)] for i in range(self.cols)])

    def determinant(self) -> int:
        """Только для 1x1..3x3. Знак результата нормализован в {-1,0,1}:
        1 = внутренне согласована, -1 = конфликт, 0 = вырождена."""
        if self.rows != self.cols:
            raise ValueError("Детерминант только для квадратных матриц")
        if self.rows == 1:
            return self.data[0][0]
        if self.rows == 2:
            det = self.data[0][0] * self.data[1][1] - self.data[0][1] * self.data[1][0]
        elif self.rows == 3:
            a, b, c = self.data[0]
            d, e, f = self.data[1]
            g, h, i = self.data[2]
            det = a * (e*i - f*h) - b * (d*i - f*g) + c * (d*h - e*g)
        else:
            raise ValueError(f"Детерминант для {self.rows}x{self.rows} не реализован")
        return 1 if det > 0 else (-1 if det < 0 else 0)

    def stability_index(self) -> float:
        """(det+1)/2: 1.0 стабильна, 0.5 нейтральна, 0.0 конфликтна."""
        try:
            return (self.determinant() + 1) / 2.0
        except ValueError:
            return 0.5

    def entropy(self) -> float:
        """Энтропия Шеннона по частотам {-1,0,1}."""
        ones = sum(row.count(1) for row in self.data)
        zeros = sum(row.count(0) for row in self.data)
        negs = sum(row.count(-1) for row in self.data)
        total = self.rows * self.cols
        if total == 0:
            return 0.0
        ent = 0.0
        for p in (ones/total, zeros/total, negs/total):
            if p > 0:
                ent -= p * math.log2(p)
        return ent

    # ---- ДВЕ ФУНКЦИИ, КОТОРЫЕ РЕАЛЬНО ЧТО-ТО ДЕЛАЮТ ----

    def diagonal_projection(self) -> 'TernaryMatrix':
        """Обнулить всё, кроме диагонали — 'что система знает о себе'."""
        size = min(self.rows, self.cols)
        result = [[0] * self.cols for _ in range(self.rows)]
        for i in range(size):
            result[i][i] = self.data[i][i]
        return TernaryMatrix(result)

    def energy_presence(self) -> 'TernaryMatrix':
        """1 где значение ненулевое, 0 где ноль — карта 'есть/нет активности'."""
        return TernaryMatrix([[1 if v != 0 else 0 for v in row] for row in self.data])


# ============================================================
# 2. МОСТИК ИЗ ПЕНТАРНОГО СЛОЯ
# ============================================================

def pentary_to_ternary(value: int) -> int:
    """Пентарное значение (-2..2) -> троичное (-1,0,1).
    -2,-1 -> -1 (ложь/слабая ложь схлопываются); 0 -> 0; 1,2 -> 1."""
    if value <= -1:
        return -1
    if value >= 1:
        return 1
    return 0


def from_pentary(l5_values: Dict[str, int]) -> TernaryMatrix:
    """Пять пентарных значений L5-слоёв -> диагональная троичная матрица 5x5.
    Порядок слоёв: intent, goal, ontology, context, action."""
    order = ['intent', 'goal', 'ontology', 'context', 'action']
    n = len(order)
    data = [[0] * n for _ in range(n)]
    for i, layer in enumerate(order):
        v = l5_values.get(layer, 0)
        data[i][i] = pentary_to_ternary(v)
    return TernaryMatrix(data)


