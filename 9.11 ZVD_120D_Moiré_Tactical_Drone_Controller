@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_apply_ew_noise_mask(out_i: np.ndarray, out_q: np.ndarray, seed_val: int):
    """
    Наложение псевдослучайной последовательности (белый шум РЭБ-маскировки) 
    на I/Q квадратуры для физической имитации атмосферного шума противника.
    """
    state = seed_val & 0xFFFFFFFF
    for i in range(DIM_120):
        state = (1103515245 * state + 12345) & 0x7FFFFFFF
        noise_i = (float(state % 1000) / 500.0 - 1.0) * 0.12
        state = (1103515245 * state + 12345) & 0x7FFFFFFF
        noise_q = (float(state % 1000) / 500.0 - 1.0) * 0.12
        
        out_i[i] += noise_i
        out_q[i] += noise_q


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_remove_ew_noise_mask(in_i: np.ndarray, in_q: np.ndarray, seed_val: int, out_i: np.ndarray, out_q: np.ndarray):
    """
    Синхронное снятие РЭБ-маскировки на наземной станции по известному сиду (De-Masking).
