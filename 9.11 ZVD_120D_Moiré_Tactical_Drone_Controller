# 6. GROUND CONTROL STATION (GLOBAL RASHOMON & SDR DE-MASKING)
# =====================================================================

class GroundControlStation:
    def __init__(self, crypto_engine: TacticalCryptoEngine):
        self.crypto = crypto_engine
        self.global_rashomon = PentarnyRashomonEngine()
        self._eval_scratch = allocate_aligned_array((DIM_120,), np.float64, alignment=64)

    def process_downlink_packet(self, packet_bytes: bytes) -> Tuple[bytes, DroneTelemetry, Dict[str, float], Dict[str, float], np.ndarray, np.ndarray, np.ndarray]:
        if len(packet_bytes) < HEADER_SIZE:
            raise ValueError("Invalid packet header")
        
        magic, drone_id, plen = struct.unpack(HEADER_FORMAT, packet_bytes[:HEADER_SIZE])
        if magic != MAGIC_DOWNLINK:
            raise ValueError("Magic header mismatch")
            
        encrypted = packet_bytes[HEADER_SIZE : HEADER_SIZE + plen]
        decrypted = self.crypto.decrypt_payload(encrypted)
        payload = decompress_payload(decrypted)
        
        # 1. Исправлено смещение Распаковки Телеметрии (исправление struct.error 40 -> 24 байта)
        video_len, timestamp_seed = struct.unpack("<II", payload[:8])
        offset = 8
        operator_video_bytes = payload[offset : offset + video_len]
        offset += video_len
        
        TELEMETRY_SIZE = struct.calcsize("<ifffff")  # Ровно 24 байта!
        t_data = struct.unpack("<ifffff", payload[offset : offset + TELEMETRY_SIZE])
        telemetry = DroneTelemetry(
            drone_id=t_data[0], roll=t_data[1], pitch=t_data[2],
            throttle=t_data[3], battery_pct=t_data[4], threat_level=t_data[5]
        )
        offset += TELEMETRY_SIZE
        
        e_data = struct.unpack("<fffff", payload[offset : offset + 20])
        edge_audit = {
            "technical": e_data[0], "operational": e_data[1],
            "structural": e_data[2], "boundary": e_data[3], "risk": e_data[4]
        }
        offset += 20
        
        vector_120d = np.frombuffer(payload[offset : offset + DIM_120], dtype=np.uint8).copy()
        offset += DIM_120
        
        iq_size = DIM_120 * 8  # float64
        masked_iq_i = np.frombuffer(payload[offset : offset + iq_size], dtype=np.float64).copy()
        offset += iq_size
        masked_iq_q = np.frombuffer(payload[offset : offset + iq_size], dtype=np.float64).copy()
        
        # 3. Синхронное снятие РЭБ-маскировки (De-Masking) на Земле
        clean_iq_i = allocate_aligned_array((DIM_120,), np.float64, alignment=64)
        clean_iq_q = allocate_aligned_array((DIM_120,), np.float64, alignment=64)
        _njit_remove_ew_noise_mask(masked_iq_i, masked_iq_q, timestamp_seed, clean_iq_i, clean_iq_q)
        
        t_vec = telemetry.to_vector()
        self._eval_scratch[:5] = t_vec
        self._eval_scratch[5:] = vector_120d.astype(np.float64)[:DIM_120-5]
        global_audit = self.global_rashomon.evaluate(self._eval_scratch)
        
        return operator_video_bytes, telemetry, edge_audit, global_audit, vector_120d, clean_iq_i, clean_iq_q

    def make_tactical_decision(self, telemetry: DroneTelemetry, edge_audit: Dict[str, float], global_audit: Dict[str, float]) -> Optional[GCSCommand]:
        combined_risk = (edge_audit["risk"] + global_audit["risk"]) / 2.0
        
        if telemetry.threat_level > 0.7 or combined_risk < -0.5:
            print(f"[GCS SDR 182KM] Critical Risk detected for Drone #{telemetry.drone_id} (Risk: {combined_risk:.3f}). Issuing RTH.")
            return GCSCommand(command_id=2, target_param_1=0.0, target_param_2=0.0)
        
        if telemetry.battery_pct < 0.2:
            print(f"[GCS SDR 182KM] Low battery on Drone #{telemetry.drone_id}. Issuing Land.")
            return GCSCommand(command_id=3, target_param_1=0.0, target_param_2=0.0)
            
        return None

    def generate_uplink_command(self, cmd: GCSCommand, drone_id: int) -> bytes:
        payload = struct.pack("<iff", cmd.command_id, cmd.target_param_1, cmd.target_param_2)
        compressed = compress_payload(payload)
        encrypted = self.crypto.encrypt_payload(compressed)
        header = struct.pack(HEADER_FORMAT, MAGIC_UPLINK, drone_id, len(encrypted))
        return header + encrypted


