        entropy = self.macro_field.calculate_entropy()
        if entropy > 0.65:
            self.macro_field.recover_extremes()
        self.bi_core.update_rotation(entropy)
        
        # Муаровый фильтр стабильности 120D
        _njit_drone_moiré_filter_120d(st_contiguous, self.bi_core.angle_a, self.bi_core.angle_b, self.vector_120d_buffer)
        
        # 2. Динамический расчет индекса Лобачевского по текущим углам би-ядер (вместо статики [2,2,0])
        lob_idx_y = int(abs(self.bi_core.angle_a) * 2.0) % 5
        lob_idx_x = int(abs(self.bi_core.angle_b) * 2.0) % 5
        lob_shift = float(self.lobachevsky_lut[lob_idx_y, lob_idx_x, 0]) * 0.1
        
        vector_unbiased = self.vector_120d_buffer.astype(np.float64) - 2.0
        interference_mag = float(np.sum(np.abs(vector_unbiased))) / DIM_120
        
        if threat_level > 0.5 or interference_mag > 1.0:
            plasma_energy_boost = 1.35 + (interference_mag * 0.001) + (lob_shift * 0.05)
        else:
            plasma_energy_boost = 1.0 + (lob_shift * 0.02)
            
        # SDR IQ-модулятор для ФАР
        _njit_sdr_moire_iq_modulator(
            self.vector_120d_buffer, 
            self.bi_core.angle_a, 
            self.bi_core.angle_b, 
            self.out_i, 
            self.out_q, 
            plasma_energy_boost
        )
        
        # 3. Синхронизированная РЭБ-маскировка с передачей timestamp_seed на землю
        timestamp_seed = int(time.time() * 1000) & 0xFFFFFFFF
        _njit_apply_ew_noise_mask(self.out_i, self.out_q, timestamp_seed)
            
        return compressed_video_bytes, self.vector_120d_buffer.tobytes(), self.out_i.copy(), self.out_q.copy(), timestamp_seed

    def evaluate_edge_state(self, telemetry: DroneTelemetry, vector_120d: np.ndarray) -> Dict[str, float]:
        t_vec = telemetry.to_vector()
        self._eval_scratch[:5] = t_vec
        self._eval_scratch[5:] = vector_120d.astype(np.float64)[:DIM_120-5]
        return self.edge_rashomon.evaluate(self._eval_scratch)

    def generate_downlink_packet(self, telemetry: DroneTelemetry, vector_bytes: bytes, edge_audit: Dict[str, float], operator_video_bytes: bytes, iq_i: np.ndarray, iq_q: np.ndarray, timestamp_seed: int) -> bytes:
        telemetry_bytes = struct.pack("<ifffff", 
            telemetry.drone_id, telemetry.roll, telemetry.pitch, 
            telemetry.throttle, telemetry.battery_pct, telemetry.threat_level
        )
        audit_bytes = struct.pack("<fffff", 
            edge_audit["technical"], edge_audit["operational"], 
            edge_audit["structural"], edge_audit["boundary"], edge_audit["risk"]
        )
        
        iq_bytes = iq_i.tobytes() + iq_q.tobytes()
        video_len = len(operator_video_bytes)
        
        # Упаковываем видео, телеметрию, аудит Рашомона, вектор 120D, I/Q и сид РЭБ-маски
        payload_header = struct.pack("<II", video_len, timestamp_seed)
        payload = payload_header + operator_video_bytes + telemetry_bytes + audit_bytes + vector_bytes + iq_bytes
        
        compressed = compress_payload(payload)
        encrypted = self.crypto.encrypt_payload(compressed)
        
        header = struct.pack(HEADER_FORMAT, MAGIC_DOWNLINK, self.drone_id, len(encrypted))
        return header + encrypted

    def process_uplink_packet(self, packet_bytes: bytes):
        if len(packet_bytes) < HEADER_SIZE:
            return
        magic, drone_id, plen = struct.unpack(HEADER_FORMAT, packet_bytes[:HEADER_SIZE])
        if magic != MAGIC_UPLINK or drone_id != self.drone_id:
            return
            
        encrypted = packet_bytes[HEADER_SIZE : HEADER_SIZE + plen]
        try:
            decrypted = self.crypto.decrypt_payload(encrypted)
            payload = decompress_payload(decrypted)
            cmd_id, p1, p2 = struct.unpack("<iff", payload)
            
            # Применение нормализованного Пифагорова замка 3-4-5 к команде
            leg_a = cmd_id * 3
            leg_b = (abs(cmd_id) + 1) * 4
            raw_hypot = math.sqrt(float(leg_a * leg_a + leg_b * leg_b))
            locked_param_1 = round(p1 / 5.0) * 5.0
            
            self.active_command_id = cmd_id
            print(f"[DRONE #{self.drone_id} SDR RELATIVISTIC 182KM] Pythagorean Command locked -> ID: {cmd_id}, Param1: {locked_param_1}")
        except Exception as e:
            print(f"[DRONE #{self.drone_id} SECURITY ALERT] Uplink error: {e}")


