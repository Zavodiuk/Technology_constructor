@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_drone_moiré_filter_120d(st_contiguous: np.ndarray, angle_a: float, angle_b: float, out_vector_120d: np.ndarray):
    h, w, t_dim = st_contiguous.shape
    cos_a = math.cos(angle_a)
    sin_a = math.sin(angle_a)
    cos_b = math.cos(angle_b)
    sin_b = math.sin(angle_b)
    
    sample_idx = 0
    for t in range(t_dim):
        for y_sample in range(4):
            for x_sample in range(5):
                if sample_idx < DIM_120:
                    yy = y_sample * (h // 4)
                    xx = x_sample * (w // 5)
                    if yy >= h: yy = h - 1
                    if xx >= w: xx = w - 1
                    
                    raw_val = float(st_contiguous[yy, xx, t])
                    fx = (yy - h // 2) * cos_a - (xx - w // 2) * sin_a
                    fy = (yy - h // 2) * sin_b + (xx - w // 2) * cos_b
                    moire_mod = math.sin(fx * 0.1 + fy * 0.1 + angle_a - angle_b)
                    
                    filtered_val = raw_val * (1.0 + 0.5 * moire_mod)
                    penta_mapped = int(round(filtered_val * 2.0))
                    clipped_val = max(-2, min(2, penta_mapped))
                    
                    out_vector_120d[sample_idx] = np.uint8(clipped_val + 2)
                    sample_idx += 1


