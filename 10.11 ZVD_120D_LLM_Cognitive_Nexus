inline double pythagorean_lock(double leg3, double leg4) {
    double hypot_sq = leg3 * leg3 + leg4 * leg4;
    return std::sqrt(hypot_sq) / 5.0;
}

inline void ingest_raw_bytes_120d(
    std::span<const uint8_t> arr_u8,
    ZvdSupremeMonolith1000B& monolith,
    std::array<double, DIM_120>& exciter_120d,
    double angle_a,
    double angle_b
) {
    size_t n_bytes = arr_u8.size();
    if (n_bytes == 0) return;

    double cos_a = std::cos(angle_a);
    double sin_a = std::sin(angle_a);
    double cos_b = std::cos(angle_b);
    double sin_b = std::sin(angle_b);
    const auto& sin_lut = get_math_lut().sin_lut;

    for (int i = 0; i < DIM_120; ++i) {
        double b_val = static_cast<double>(arr_u8[i % n_bytes]);
        double val = std::fmod(b_val, 5.0) - 2.0;
        int clipped = static_cast<int>(std::clamp(std::round(val), -2.0, 2.0));

        double fx = (i - DIM_120 / 2) * cos_a - (i - DIM_120 / 2) * sin_a;
        double fy = (i - DIM_120 / 2) * sin_b + (i - DIM_120 / 2) * cos_b;
        double moire = std::sin(fx * 0.1 + fy * 0.1 + angle_a - angle_b);

        double leg3 = static_cast<double>((i % 3) + 1) * 3.0;
        double leg4 = static_cast<double>(clipped + 3) * 4.0;
        double pyth_factor = pythagorean_lock(leg3, leg4);

        double excitation_val = sin_lut[i] * static_cast<double>(clipped) * pyth_factor * (1.0 + 0.5 * moire);
        exciter_120d[i] = excitation_val;

        int8_t b_state = (val >= 0.33) ? 1 : ((val <= -0.33) ? -1 : 0);

        if (i < DIM_60) {
            monolith.face_residual[i] = static_cast<int8_t>(clipped);
            monolith.face_bruns[i] = b_state;
            monolith.face_weight[i] = static_cast<int16_t>(excitation_val * 1000.0);
            monolith.face_tension[i] = static_cast<int16_t>(std::abs(moire) * 500.0);
        } else {
            int v_idx = i - DIM_60;
            monolith.vertex_residual[v_idx] = static_cast<int8_t>(clipped);
            monolith.vertex_bruns[v_idx] = b_state;
            monolith.vertex_weight[v_idx] = static_cast<int16_t>(excitation_val * 1000.0);
            monolith.vertex_tension[v_idx] = static_cast<int16_t>(std::abs(moire) * 500.0);
        }
    }
}

class CounterRotatingBiCore120D {
public:
    double angle_a;
    double angle_b;
    double base_velocity;

    CounterRotatingBiCore120D() : angle_a(0.0), angle_b(0.0), base_velocity(M_PI_VAL / 6.0) {}

    void update_rotation(double entropy) {
        double dynamic_velocity = base_velocity / (1.0 + entropy * 2.0);
        angle_a += dynamic_velocity;
        angle_b -= dynamic_velocity * 1.5;
        if (angle_a >= 2 * M_PI_VAL) angle_a = 0.0;
        if (angle_b <= -2 * M_PI_VAL) angle_b = 0.0;
    }
};

class MacroFieldV23 {
public:
    std::array<std::array<int8_t, 7>, 7> field{};

    MacroFieldV23() {
        int mid_x = 3, mid_y = 3;
        for (int x = 0; x < 7; ++x) {
            for (int y = 0; y < 7; ++y) {
                int dist = std::abs(x - mid_x) + std::abs(y - mid_y);
                if (dist == 0) field[x][y] = 2;
                else if (dist == 1) field[x][y] = 1;
                else if (dist == 2) field[x][y] = 0;
                else if (dist == 3) field[x][y] = -1;
                else field[x][y] = -2;
            }
        }
    }

    double calculate_entropy() const {
        std::span<const uint8_t> raw_span(reinterpret_cast<const uint8_t*>(field.data()), sizeof(field));
        return ShannonBitPerfectCodec::calculate_entropy(raw_span);
    }
};

