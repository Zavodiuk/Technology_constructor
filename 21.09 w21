class TernaryRecursiveTetrahedralCapsule:
    def __init__(self, name: str, field_dims: Tuple[int, ...], vertices: tuple, depth: int = 1):
        self.name = name
        self.field_dims = field_dims
        self.coords_list = [list(v) for v in vertices]
        self.depth = depth
        self.sub_capsule: Optional['TernaryRecursiveTetrahedralCapsule'] = None

    def drift(self, tensor_field: np.ndarray, gradient_fields: List[np.ndarray], forbidden_coords: set = None) -> None:
        if forbidden_coords is None:
            forbidden_coords = set()

        dims = len(self.field_dims)
        for idx, vertex in enumerate(self.coords_list):
            best_coords = list(vertex)
            
            current_pos = tuple(vertex)
            local_base = abs(int(tensor_field[current_pos]))
            grad_base = sum(abs(gradient_fields[i][current_pos]) for i in range(dims))
            max_tension = float(local_base) + float(grad_base)

            for d in range(dims):
                for delta in [-1, 1]:
                    test_coords = list(vertex)
                    test_coords[d] += delta
                    if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                        test_pos = tuple(test_coords)
                        if test_pos in forbidden_coords:
                            continue
                        local_val = abs(int(tensor_field[test_pos]))
                        grad_val = sum(abs(gradient_fields[i][test_pos]) for i in range(dims))
                        tension = float(local_val) + float(grad_val)
                        if tension > max_tension:
                            max_tension = tension
                            best_coords = test_coords
            self.coords_list[idx] = best_coords

        if self.sub_capsule:
            parent_coords = {tuple(v) for v in self.coords_list}
            self.sub_capsule.drift(tensor_field, gradient_fields, forbidden_coords | parent_coords)

    def spawn_nested_capsule(self) -> None:
        if not self.sub_capsule and self.depth < 3:
            mid_v = [sum(x)//len(x) for x in zip(*self.coords_list)]
            offset_v = [max(0, c - 1) for c in mid_v]
            sub_verts = (
                tuple(mid_v),
                tuple(offset_v),
                tuple([min(self.field_dims[0]-1, c+1) for c in mid_v]),
                tuple([max(0, c-1) for c in offset_v])
            )
            self.sub_capsule = TernaryRecursiveTetrahedralCapsule(f"{self.name}-Sub", self.field_dims, sub_verts, self.depth + 1)

    def enforce_lattice_containment(self, tensor_field: TernaryTensorField, evolution: TernaryTensorEvolution, graph: TernaryUniverseGraph, node_coords: Dict[str, Tuple[int, ...]], dynamic_radius: int = 1) -> None:
        all_coords = np.array(self.coords_list)
        min_b = np.min(all_coords, axis=0)
        max_b = np.max(all_coords, axis=0)

        v0, v1, v2, v3 = tuple(self.coords_list[0]), tuple(self.coords_list[1]), tuple(self.coords_list[2]), tuple(self.coords_list[3])
        
        tensor_field.inject_quantum_impulse(v0, 1)   # +1
        tensor_field.inject_quantum_impulse(v1, 1)   # +1
        tensor_field.inject_quantum_impulse(v2, -1)  # -1
        
        evolution.propagate_wave(v0, radius=dynamic_radius)
        evolution.propagate_wave(v1, radius=dynamic_radius)
        evolution.propagate_wave(v2, radius=dynamic_radius)

        tensor_field.inject_quantum_impulse(v3, 0)
        dims = len(tensor_field.dimensions)
        damping_ranges = [range(max(0, v3[d] - dynamic_radius), min(tensor_field.dimensions[d], v3[d] + dynamic_radius + 1)) for d in range(dims)]
        for coords in product(*damping_ranges):
            tensor_field.field[coords] = np.int8(0)

        for name, node in graph.nodes.items():
            if name in node_coords:
                n_coords = np.array(node_coords[name])
                in_box = np.all(n_coords >= min_b) and np.all(n_coords <= max_b)
                avg_dist = np.mean([sum(abs(n_coords[d] - v[d]) for d in range(len(self.field_dims))) for v in self.coords_list])
                
                if in_box and avg_dist <= (dynamic_radius * 2.2):
                    node.isolation_depth = self.depth
                else:
                    if node.isolation_depth == self.depth:
                        node.isolation_depth = 0

        if self.sub_capsule:
            self.sub_capsule.enforce_lattice_containment(tensor_field, evolution, graph, node_coords, dynamic_radius=dynamic_radius)


