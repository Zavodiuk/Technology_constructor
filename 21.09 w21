class TernaryUniverseW21:
    def __init__(self, dimensions: Tuple[int, ...], node_coordinates: Dict[str, Tuple[int, ...]]):
        self.dimensions = dimensions
        self.tensor_field = TernaryTensorField(dimensions)
        self.tensor_evolution = TernaryTensorEvolution(self.tensor_field)
        self.graph = TernaryUniverseGraph()
        self.node_coords = node_coordinates
        self.last_dynamic_radius = 1

        max_idx = dimensions[0] - 1
        mid = dimensions[0] // 2
        
        capsule_verts_1 = ((0, 0, 0, 0), (max_idx, max_idx, 0, 0), (max_idx, 0, max_idx, 0), (mid, mid, mid, max_idx))
        capsule_verts_2 = ((1, 1, 1, 1), (max_idx-1, max_idx-1, 1, 1), (max_idx-1, 1, max_idx-1, 1), (mid, mid, mid, max_idx-1))

        self.lattice_capsules = [
            TernaryRecursiveTetrahedralCapsule("Lattice-Alpha", dimensions, capsule_verts_1, depth=1),
            TernaryRecursiveTetrahedralCapsule("Lattice-Beta", dimensions, capsule_verts_2, depth=1)
        ]

    def add_node(self, name: str, coords: Tuple[int, ...]) -> None:
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str) -> None:
        self.graph.add_edge(src, tgt)

    def step(self) -> None:
        recovered_count = 0

        dynamic_radius = 1
        if (current_entropy := self.tensor_field.calculate_field_entropy()) > 0.35:
            dynamic_radius = 2

        self.last_dynamic_radius = dynamic_radius

        if current_entropy > 0.65:
            recovered_count = self.tensor_field.recover_to_laminar_balance()

        # Пульсация микро-графа
        self.graph.pulse()

        # Проекция решений в макро-поле (только для неизолированных узлов)
        for name, node in self.graph.nodes.items():
            if name in self.node_coords and node.isolation_depth == 0:
                coords = self.node_coords[name]
                if int(node.decision) != 0:
                    self.tensor_field.inject_quantum_impulse(coords, int(node.decision))

        # Восстановленный строго детерминированный цикл волнового фронта
        for name, coords in self.node_coords.items():
            if self.graph.nodes[name].isolation_depth == 0:
                self.tensor_evolution.propagate_wave(coords, radius=dynamic_radius)

        gradients = self.tensor_evolution.calculate_field_gradient()
        for cap in self.lattice_capsules:
            cap.drift(self.tensor_field.field, gradients)
            if current_entropy > 0.5:
                cap.spawn_nested_capsule()
            cap.enforce_lattice_containment(self.tensor_field, self.tensor_evolution, self.graph, self.node_coords, dynamic_radius=dynamic_radius)

        field_div = self.tensor_evolution.calculate_field_divergence()
        for edge in self.graph.edges:
            edge.field_suppression = min(1.0, edge.field_suppression + 0.05)
            edge.field_suppression = max(0.0, edge.field_suppression * (1.0 - (field_div * 0.005)))

    def display_telemetry(self) -> None:
        print(f"\n================ [ ТАКТ W21.2: ЛАТИС-СИНХРОН №{self.graph.time_step} ] ================")
        print(f"  -> Энтропия среды (Base-3): {self.tensor_field.calculate_field_entropy():.6f}")
        print(f"  -> Динамический радиус (:=): {self.last_dynamic_radius}")
        print(f"  -> Активных решетчатых капсул: {len(self.lattice_capsules)}")
        print("--- СОСТОЯНИЕ РАСПРЕДЕЛЕННЫХ УЗЛОВ И РЕКУРСИИ ---")
        for name, node in self.graph.nodes.items():
            status = f"💊 РЕКУРСИВНАЯ КАПСУЛА (Уровень {node.isolation_depth})" if node.isolation_depth > 0 else f"Активен ({node.decision:+d})"
            print(f"  -> Узел [{name}]: {status} | Масса = {node.mass:.2f}")


