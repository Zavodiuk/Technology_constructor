TERNARY_CODE: Dict[int, str] = {
    -1: "ЛОЖЬ / БЛОКИРОВКА (Аппаратный обрыв канала / Рекуперационный сток)",
     0: "НЕОПРЕДЕЛЕННОСТЬ / ПОКОЙ (Свободный ламинарный транзит / Регенерация)",
