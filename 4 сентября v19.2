class PentarNode:
    """
    Микроскопический сетевой узел, обрабатывающий дуальные потоки сигналов
    через пороговые разделители (двоеточие `:`).
    """
    def __init__(self, node_id: str):
        self.node_id = node_id
        self.internal_state: int = 0
        self.mass: float = 0.0
        self.decision: int = 0
        self.historical_states: List[int] = []

    def process_signals(self, signal_a: int, signal_b: int) -> int:
        signal_a = int(max(-2, min(2, signal_a)))
        signal_b = int(max(-2, min(2, signal_b)))

        sum_of_decisions = signal_a + signal_b
        conflict = abs(signal_a - signal_b)
        
        # Двоеточие `:` как разделитель режимов перехода
        if conflict >= 3:
            informational_mass = conflict * 3.1415
            self.internal_state = 0
        else:
            informational_mass = conflict * 0.75
            self.internal_state = max(-2, min(2, sum_of_decisions))
            
        self.mass = informational_mass
        self.decision = self.internal_state
        self.historical_states.append(self.decision)
        return self.internal_state


class PentarEdge:
    """Канал связи между узлами с динамической теплоемкостью и волновым потоком."""
    def __init__(self, source: PentarNode, target: PentarNode):
        self.source = source
        self.target = target
        self.energy_flow: float = 1.0
        self.temp: float = 1.0
        self.rhythm: float = 0.0

    def update_dynamics(self) -> None:
        decision_sum = self.source.decision + self.target.decision
        total_mass = self.source.mass + self.target.mass
        old_temp = self.temp
        base_modifier = 1.0 + (decision_sum * 0.2) - (total_mass * 0.15)
        self.temp = max(0.05, base_modifier)
        self.rhythm = self.temp - old_temp
        
        if self.source.decision == -2 or self.target.decision == -2:
            self.energy_flow = 0.0
        else:
            self.energy_flow = (self.temp * 1.618) + (total_mass * 0.5)


class PentarUniverseGraph:
    """Сетевая инфраструктура графа с ассоциативной памятью ({}) суверенных узлов."""
    def __init__(self):
        self.nodes: Dict[str, PentarNode] = {}  # {} — ассоциативная память
        self.edges: List[PentarEdge] = []
        self.time_step: int = 0

    def add_node(self, name: str) -> None:
        self.nodes[name] = PentarNode(name)

    def add_edge(self, src: str, tgt: str) -> None:
        self.edges.append(PentarEdge(self.nodes[src], self.nodes[tgt]))

    def pulse(self) -> None:
        self.time_step += 1
        for name, node in self.nodes.items():
            connected_signals = []
            for edge in self.edges:
                if edge.target == node:
                    norm_val = (edge.energy_flow - 1.5) / 1.5
                    connected_signals.append(quantize_pentarny(norm_val))
                elif edge.source == node:
                    connected_signals.append(quantize_pentarny(edge.energy_flow / 3.0 - 0.5))
            
            if not connected_signals:
                connected_signals = [random.choice(LOGIC_BASIS)]
            
            node.process_signals(int(connected_signals[0]), int(connected_signals[-1]))
            
        for edge in self.edges:
            edge.update_dynamics()


