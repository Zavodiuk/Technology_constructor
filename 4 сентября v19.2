class ConflictAttractorVertex:
    """Отдельная вершина мембраны, дрейфующая по градиентам полевых напряжений."""
    def __init__(self, name: str, initial_coords: Tuple[int, ...], field_dims: Tuple[int, ...]):
        self.name = name
        self.coords = list(initial_coords)
        self.field_dims = field_dims
        self.trajectory_log: List[Tuple[int, ...]] = [tuple(self.coords)]

    def drift(self, tensor_field: np.ndarray, gradient_fields: List[np.ndarray]) -> None:
        dims = len(self.field_dims)
        best_coords = list(self.coords)
        max_tension = -999.0

        for d in range(dims):
            for delta in [-1, 1]:
                test_coords = list(self.coords)
                test_coords[d] += delta
                
                if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                    local_val = abs(tensor_field[tuple(test_coords)])
                    grad_val = sum(abs(gradient_fields[i][tuple(test_coords)]) for i in range(dims))
                    tension = local_val + (grad_val * 1.5)

                    if tension > max_tension:
                        max_tension = tension
                        best_coords = test_coords

        self.coords = best_coords
        self.trajectory_log.append(tuple(self.coords))


class DynamicPlaneMembrane:
    """
    Трехточечный геометрический примитив, образующий деформируемую плоскость 
    внутри многомерной матрицы. Защищен круглами скобками `()` конфайнмента.
    """
    def __init__(self, field_dims: Tuple[int, ...], p1: Tuple[int, ...], p2: Tuple[int, ...], p3: Tuple[int, ...]):
        self.field_dims = field_dims
        self.vertex_a = ConflictAttractorVertex("Alpha", p1, field_dims)
        self.vertex_b = ConflictAttractorVertex("Beta", p2, field_dims)
        self.vertex_c = ConflictAttractorVertex("Gamma", p3, field_dims)

    def evolve_membrane(self, tensor_field: np.ndarray, gradients: List[np.ndarray]) -> None:
        self.vertex_a.drift(tensor_field, gradients)
        self.vertex_b.drift(tensor_field, gradients)
        self.vertex_c.drift(tensor_field, gradients)

    def get_vertices(self) -> Tuple[Tuple[int, ...], Tuple[int, ...], Tuple[int, ...]]:
        return (tuple(self.vertex_a.coords), tuple(self.vertex_b.coords), tuple(self.vertex_c.coords))

    def radiate_membrane_front(self, tensor_field: PentarnyTensorField, evolution: PentarnyTensorEvolution) -> None:
        va = tuple(self.vertex_a.coords)
        vb = tuple(self.vertex_b.coords)
        vc = tuple(self.vertex_c.coords)

        tensor_field.inject_quantum_impulse(va, 2)
        tensor_field.inject_quantum_impulse(vb, 0)
        tensor_field.inject_quantum_impulse(vc, -2)

        evolution.propagate_wave(va, radius=1)
        evolution.propagate_wave(vb, radius=1)
        evolution.propagate_wave(vc, radius=1)


