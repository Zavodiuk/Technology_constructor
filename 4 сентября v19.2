class PentarnyUniverseV19:
    """Главный оркестратор кибернетической среды V19."""
    def __init__(self, dimensions: Tuple[int, ...], node_coordinates: Dict[str, Tuple[int, ...]]):
        self.dimensions = dimensions
        self.tensor_field = PentarnyTensorField(dimensions)
        self.tensor_evolution = PentarnyTensorEvolution(self.tensor_field)
        self.graph = PentarUniverseGraph()
        self.node_coords = node_coordinates
        self.telemetry = SystemicTelemetryMonitor()

        mid = dimensions[0] // 2
        max_idx = dimensions[0] - 1
        p1 = (mid, mid, mid, mid)
        p2 = (0, max_idx, mid, mid)
        p3 = (max_idx, 0, mid, mid)
        
        self.membrane = DynamicPlaneMembrane(dimensions, p1, p2, p3)

    def add_node(self, name: str, coords: Tuple[int, ...]) -> None:
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str) -> None:
        self.graph.add_edge(src, tgt)

    def step(self) -> None:
        # := Моржовый оператор мгновенного захвата энтропии такта
        active_entropy := self.tensor_field.calculate_field_entropy()
        active_divergence := self.tensor_evolution.calculate_field_divergence()

        if self.telemetry.inspect_system_stability(active_entropy, active_divergence):
            # Аварийная стабилизация при угрозе резонанса
            for edge in self.graph.edges:
                edge.energy_flow *= 0.5

        # Пульсация микро-графа
        self.graph.pulse()

        # Проекция решений в макро-поле
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_field.inject_quantum_impulse(coords, impulse_val)

        # Распространение волн узлов
        for name, coords in self.node_coords.items():
            self.tensor_evolution.propagate_wave(coords, radius=1)

        # Эволюция трехточечной мембранной плоскости
        gradients = self.tensor_evolution.calculate_field_gradient()
        self.membrane.evolve_membrane(self.tensor_field.field, gradients)
        self.membrane.radiate_membrane_front(self.tensor_field, self.tensor_evolution)

        # Обратная связь поля на каналы графа
        field_div = self.tensor_evolution.calculate_field_divergence()
        for edge in self.graph.edges:
            edge.energy_flow = max(0.0, edge.energy_flow * (1.0 - (field_div * 0.005)))

    def display_comprehensive_telemetry(self) -> None:
        va, vb, vc = self.membrane.get_vertices()
        print(f"\n================ [ НАУЧНЫЙ ТАКТ V19: СИНХРОН №{self.graph.time_step} ] ================")
        print(f"  -> Глобальная энтропия среды: {self.tensor_field.calculate_field_entropy():.6f}")
        print(f"  -> Метрический тензор напряжения: {self.tensor_field.evaluate_metric_tensor():.6f}")
        print(f"  -> Дивергенция волнового поля: {self.tensor_evolution.calculate_field_divergence():.4f}")
        print(f"  -> Координаты вершин мембраны:")
        print(f"     [Vertex-A]: {va}")
        print(f"     [Vertex-B]: {vb}")
        print(f"     [Vertex-C]: {vc}")
        print("--- СОСТОЯНИЕ РАСПРЕДЕЛЕННЫХ УЗЛОВ И КАНАЛОВ ---")
        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({PENTAR_CODE[node.decision]}) | Масса = {node.mass:.2f}")
        for edge in self.graph.edges:
            print(f"  -> Канал [{edge.source.node_id} -> {edge.target.node_id}]: Поток = {edge.energy_flow:.3f}, Темп = {edge.temp:.3f}")


