# МОДУЛЬ 1: МАКРО-ПОЛЕ И ТЕНЗОРНАЯ МЕТРИКА ( [] )
# ============================================================================
class PentarnyTensorField:
    """
    Макроскопическая тензорная среда высокой размерности. 
    Использует квадратные скобки `[]` для адресного пространства и пространственных срезов.
    """
    def __init__(self, dimensions: Tuple[int, ...]):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=int)
        self.metric_tension_tensor = np.zeros(dimensions, dtype=float)

    def inject_quantum_impulse(self, coordinates: Tuple[int, ...], value: int) -> None:
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение импульса должно строго соответствовать базису [-2, 2]")
        if all(0 <= coordinates[i] < self.dimensions[i] for i in range(len(self.dimensions))):
            self.field[coordinates] = value

    def calculate_field_entropy(self) -> float:
        total_elements = self.field.size
        if total_elements == 0:
            return 0.0
        counts = Counter(self.field.flatten())
        entropy = 0.0
        for count in counts.values():
            p = count / total_elements
            if p > 0:
                entropy -= p * math.log2(p)
        return float(entropy)

    def evaluate_metric_tensor(self) -> float:
        extreme_states = np.sum(np.abs(self.field) == 2)
        return float(extreme_states / self.field.size)


class PentarnyTensorEvolution:
    """Модуль нелинейной волновой эволюции и градиентного анализа макро-среды."""
    def __init__(self, tensor_field: PentarnyTensorField):
        self.field = tensor_field
        self.step_counter = 0

    def propagate_wave(self, origin: Tuple[int, ...], radius: int = 1) -> None:
        dims = len(origin)
        self.step_counter += 1
        ranges = [range(max(0, origin[d] - radius), 
                       min(self.field.dimensions[d], origin[d] + radius + 1)) 
                  for d in range(dims)]
        for coords in product(*ranges):
            dist = sum(abs(coords[d] - origin[d]) for d in range(dims))
            if 0 < dist <= radius:
                impulse_value = self.field.field[origin] // (dist + 1)
                if impulse_value != 0:
                    current = self.field.field[coords]
                    self.field.field[coords] = max(-2, min(2, current + impulse_value))

    def calculate_field_gradient(self) -> List[np.ndarray]:
        return np.gradient(self.field.field.astype(float))

    def calculate_field_divergence(self) -> float:
        gradient = self.calculate_field_gradient()
        return float(np.sum([np.sum(np.abs(g)) for g in gradient]))


