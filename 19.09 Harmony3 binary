node_pipeline = BXOSPipeline()

class BinaryNodePayload(BaseModel):
    interpretations_scores: List[float] = Field(..., example=[0.85, 0.62, 0.41, 0.15, 0.05])
    bxos_token: Optional[int] = Field(None, description="Входной бинарный токен (15 бит / Int16)", example=18463)
    l5_values_list: Optional[List[int]] = Field(None, description="Альтернативный сырой ввод L5", example=[1, 0, -1, 2, -2])


@app.get("/")
def node_status():
    return {
        "author": "Vladimir Zavodiuk",
        "rights": "All rights reserved",
        "node_status": "active",
        "telemetry": node_pipeline.gate.summary()
    }


@app.post("/process-binary")
def process_binary_stream(payload: BinaryNodePayload):
    """
    Эндпоинт дата-центра: принимает двоичный пакет (bxos_token), 
    прогоняет через логику Брусенцова и возвращает свернутый бинарный результат.
    """
    try:
        res = node_pipeline.run_with_token(
            interpretations_scores=payload.interpretations_scores,
            bxos_token_in=payload.bxos_token,
            l5_fallback_list=payload.l5_values_list
        )
        return res
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))


