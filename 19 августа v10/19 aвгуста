class PentarnyGoldenSectionEngine:
    def __init__(self):
        self.f0, self.f1, self.step_counter = 0, 1, 0
        
    def _project_to_pentarny(self, modulo_value: int) -> int:
        return {0: 0, 1: 1, 2: 2, 3: -2, 4: -1}[modulo_value]

    def next_wave_element(self) -> int:
        if self.step_counter < 2:
            val = self.f0 if self.step_counter == 0 else self.f1
            self.step_counter += 1
            return self._project_to_pentarny(val)
        f_next = (self.f0 + self.f1) % 5
        self.f0, self.f1 = self.f1, f_next
        self.step_counter += 1
        return self._project_to_pentarny(f_next)

class PentarnyDnaCompressor:
    def __init__(self):
        self.to_mod = {0: 0, 1: 1, 2: 2, -2: 3, -1: 4}
        self.to_pentarny = {0: 0, 1: 1, 2: 2, 3: -2, 4: -1}

    def compress_history(self, history: list) -> tuple:
        if len(history) < 2:
            raise ValueError("Нужно минимум 2 состояния.")
        fn = self.to_mod[history[-1]]
        fn_minus_1 = self.to_mod[history[-2]]
        for _ in range(len(history) - 2):
            fn_minus_2 = (fn - fn_minus_1) % 5
            fn = fn_minus_1
            fn_minus_1 = fn_minus_2
        return self.to_pentarny[fn_minus_1], self.to_pentarny[fn]

