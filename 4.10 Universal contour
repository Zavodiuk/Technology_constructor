class BXOSCryptoManager:
    """Менеджер шифрования AES-256-GCM для защиты файлов хранилища."""
    def __init__(self, storage_dir: str):
        self.key_path = os.path.join(storage_dir, "_bxos.key")
        self.enabled = HAS_AESGCM
        if self.enabled:
            self.key = self._load_or_generate_key()
            self.aesgcm = AESGCM(self.key)
        else:
            print("[!] Внимание: Библиотека 'cryptography' не найдена. Шифрование AES-GCM отключено.")

    def _load_or_generate_key(self) -> bytes:
        if os.path.exists(self.key_path):
            with open(self.key_path, "rb") as f:
                return f.read()
        else:
            key = AESGCM.generate_key(bit_length=256)
            with open(self.key_path, "wb") as f:
                f.write(key)
            print(f"[BXOS Crypto] Сгенерирован мастер-ключ AES-256-GCM в {self.key_path}")
            return key

    def encrypt(self, plaintext: bytes) -> bytes:
        if not self.enabled:
            return plaintext
        nonce = os.urandom(12)
        ciphertext = self.aesgcm.encrypt(nonce, plaintext, None)
        return nonce + ciphertext

    def decrypt(self, encrypted_data: bytes) -> bytes:
        if not self.enabled:
            return encrypted_data
        nonce = encrypted_data[:12]
        ciphertext = encrypted_data[12:]
        return self.aesgcm.decrypt(nonce, ciphertext, None)


@dataclass
class UniversalSemanticRecord:
    record_id: str
    data_type: str
    schema_version: int
    ontology_vector: List[int]
    compressed_payload: bytes
    original_size: int
    bxos_checksum: str
    timestamp_ns: int

    @classmethod
    def convert_and_pack(cls, record_id: str, raw_data: Any, ontology_vector: List[int] = None) -> "UniversalSemanticRecord":
        if isinstance(raw_data, str):
            data_type = "text"
            payload_bytes = raw_data.encode("utf-8")
        elif isinstance(raw_data, (dict, list)):
            data_type = "json"
            payload_bytes = json.dumps(raw_data, ensure_ascii=False).encode("utf-8")
        elif isinstance(raw_data, np.ndarray):
            data_type = "tensor_np"
            header = {"shape": raw_data.shape, "dtype": str(raw_data.dtype)}
            header_bytes = json.dumps(header).encode("utf-8")
            payload_bytes = len(header_bytes).to_bytes(4, byteorder="big") + header_bytes + raw_data.tobytes()
        else:
            data_type = "text"
            payload_bytes = str(raw_data).encode("utf-8")

        original_size = len(payload_bytes)
        compressed = zlib.compress(payload_bytes, level=9)
        checksum = hashlib.sha256(compressed).hexdigest()

        return cls(
            record_id=record_id,
            data_type=data_type,
            schema_version=1,
            ontology_vector=ontology_vector or [0, 0, 0, 0, 0],
            compressed_payload=compressed,
            original_size=original_size,
            bxos_checksum=checksum,
            timestamp_ns=time.time_ns()
        )

    def unpack_payload(self) -> Any:
        current_checksum = hashlib.sha256(self.compressed_payload).hexdigest()
        if current_checksum != self.bxos_checksum:
            raise ValueError(f"[-] Нарушение целостности BXOS-записи {self.record_id}!")

        raw_bytes = zlib.decompress(self.compressed_payload)
        if self.data_type == "text":
            return raw_bytes.decode("utf-8")
        elif self.data_type == "json":
            return json.loads(raw_bytes.decode("utf-8"))
        elif self.data_type == "tensor_np":
            header_len = int.from_bytes(raw_bytes[:4], byteorder="big")
            header = json.loads(raw_bytes[4:4+header_len].decode("utf-8"))
            array_bytes = raw_bytes[4+header_len:]
            return np.frombuffer(array_bytes, dtype=header["dtype"]).reshape(header["shape"])
        return raw_bytes


class TypeAgnosticStore:
    """Персистентный менеджер хранения с шифрованием AES-GCM для формата .bxos."""
    def __init__(self, storage_dir: str = "./harmony_bxos_storage"):
        self.storage_dir = storage_dir
        os.makedirs(storage_dir, exist_ok=True)
        self.crypto = BXOSCryptoManager(storage_dir)
        self.registry: Dict[str, Dict[str, Any]] = {}
        self._load_registry()

    def _load_registry(self):
        idx_file = os.path.join(self.storage_dir, "_registry.json")
        if os.path.exists(idx_file):
            try:
                with open(idx_file, "r", encoding="utf-8") as f:
                    self.registry = json.load(f)
            except:
                self.registry = {}

    def _save_registry(self):
        idx_file = os.path.join(self.storage_dir, "_registry.json")
        with open(idx_file, "w", encoding="utf-8") as f:
            json.dump(self.registry, f, ensure_ascii=False, indent=2)

    def write_record(self, record: UniversalSemanticRecord) -> str:
        safe_name = hashlib.sha256(record.record_id.encode()).hexdigest()[:32]
        file_path = os.path.join(self.storage_dir, f"{safe_name}.bxos")

        container = {
            "record_id": record.record_id,
            "data_type": record.data_type,
            "schema_version": record.schema_version,
            "ontology_vector": record.ontology_vector,
            "payload_b64": b64_encode(record.compressed_payload),
            "original_size": record.original_size,
            "bxos_checksum": record.bxos_checksum,
            "timestamp_ns": record.timestamp_ns
        }

        container_bytes = json.dumps(container).encode("utf-8")
        encrypted_bytes = self.crypto.encrypt(container_bytes)

        with open(file_path, "wb") as f:
            f.write(encrypted_bytes)

        self.registry[record.record_id] = {"file_path": file_path, "bxos_checksum": record.bxos_checksum}
        self._save_registry()
        return record.bxos_checksum

    def fetch_record(self, record_id: str) -> UniversalSemanticRecord:
        if record_id not in self.registry:
            raise KeyError(f"Запись {record_id} не обнаружена в реестре.")
        meta = self.registry[record_id]
        
        with open(meta["file_path"], "rb") as f:
            encrypted_bytes = f.read()

        decrypted_bytes = self.crypto.decrypt(encrypted_bytes)
        d = json.loads(decrypted_bytes.decode("utf-8"))

        return UniversalSemanticRecord(
            record_id=d["record_id"],
            data_type=d["data_type"],
            schema_version=d["schema_version"],
            ontology_vector=d["ontology_vector"],
            compressed_payload=b64_decode(d["payload_b64"]),
            original_size=d["original_size"],
            bxos_checksum=d["bxos_checksum"],
            timestamp_ns=d["timestamp_ns"]
        )


