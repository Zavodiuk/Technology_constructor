class DataCenterNode:
    """Магистральный Дата-Центр (ЦОД) для приема телеметрии и квитанций."""
    def __init__(self, dc_id: str = "DC-HARMONY-CORE-01"):
        self.dc_id = dc_id
        self.transit_log: List[Dict[str, Any]] = []
        os.makedirs("./dc_storage_buffer", exist_ok=True)

    def process_incoming_transmission(self, record_id: str, payload_bytes: bytes, checksum: str, destination_node: str) -> Dict[str, Any]:
        print(f"  [ЦОД '{self.dc_id}'] Пакет '{record_id}' принят через защищенный оптический шлюз.")
        
        current_hash = hashlib.sha256(payload_bytes).hexdigest()
        if current_hash != checksum:
            raise ValueError(f"[-] КРИТИЧЕСКАЯ ОШИБКА ЦОДА: Несоответствие хэша для {record_id}!")

        buffer_path = os.path.join("./dc_storage_buffer", f"{record_id}_transit.bin")
        with open(buffer_path, "wb") as f:
            f.write(payload_bytes)

        transit_record = {
            "dc_id": self.dc_id,
            "record_id": record_id,
            "transit_timestamp_ns": time.time_ns(),
            "payload_size": len(payload_bytes),
            "bxos_checksum": checksum,
            "status": "ROUTED_AND_DELIVERED",
            "destination": destination_node
        }
        self.transit_log.append(transit_record)
        print(f"  [ЦОД '{self.dc_id}'] Перенаправлено на узел назначения: '{destination_node}'.")
        return transit_record


class OpticalTransportLayerV23:
    """Моделирование ВОЛС с транзитом через магистральный узел ЦОДа."""
    def __init__(self, data_center: DataCenterNode):
        self.dc = data_center

    def transmit_via_dc(self, record_id: str, payload: bytes, checksum: str, destination: str, distance_km: float = 300.0):
        print(f"  [ВОЛС] Передача пакета на расстояние {distance_km} км в Дата-Центр '{self.dc.dc_id}'...")
        return self.dc.process_incoming_transmission(record_id, payload, checksum, destination)
