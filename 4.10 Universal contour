class BXOSDaemonReceipt:
    """Формирует неизменяемую квитанцию о действиях фонового демона."""
    @staticmethod
    def seal(event_id: str, energy: float, threshold: float, state: List[int], action_taken: str) -> Dict[str, Any]:
        payload = {
            "event_id": event_id,
            "timestamp_ns": time.time_ns(),
            "system_energy": round(energy, 4),
            "applied_threshold": round(threshold, 4),
            "l5_state": [int(x) for x in state],
            "action": action_taken
        }
        raw_str = json.dumps(payload, sort_keys=True)
        digest = hashlib.sha3_256(raw_str.encode("utf-8")).hexdigest()
        return {
            "receipt_id": event_id,
            "bxos_digest": digest,
            "payload": payload
        }


