class LomonosovSpiralAdaptation:
    """
    Рекурсивный расчет динамического порога срабатывания демона на основе 
    исторической траектории системной энергии (спиральный тренд).
    """
    def __init__(self, base_threshold: float = 0.30, window_size: int = 6):
        self.base_threshold = base_threshold
        self.window_size = window_size
        self.history: List[float] = []

    def compute_dynamic_threshold(self, current_energy: float) -> float:
        self.history.append(current_energy)
        if len(self.history) > self.window_size:
            self.history.pop(0)

        if len(self.history) < 3:
            return self.base_threshold

        trend = np.gradient(np.array(self.history))
        mean_trend = float(np.mean(trend))

        delta = mean_trend * 0.15
        dynamic_threshold = np.clip(self.base_threshold - delta, 0.15, 0.45)
        
        return float(dynamic_threshold)


