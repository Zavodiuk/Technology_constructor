/**
 * ПЕНТАРНЫЙ БАЗИС ЛОГИКИ [-2, 2]
 */
enum class PentaryValue(val value: Int) {
    STRONG_FALSE(-2),  // Арлекин / Категорическое НЕТ
    FALSE(-1),         // Пьеро / Мягкое НЕТ
    NEUTRAL(0),        // Доктор Грациано / Ламинарный покой
    TRUE(1),           // Коломбина / Мягкое ДА
    STRONG_TRUE(2)     // Бригелла / Категорическое ДА
}

/**
 * Структура данных для фиксации результатов анализа Расёмона.
 */
data class RashomonResult(
    val state: Int,
    val top: String?,
    val margin: Double,
    val reason: String
)

/**
 * Результат обработки данных троичным блоком Брусенцова.
 */
data class TernaryResult(
    val bestCandidate: String?,
    val efficiency: Double,
    val l3In: Int,
    val l3Out: Int,
