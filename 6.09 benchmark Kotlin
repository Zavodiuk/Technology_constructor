enum class GateStatus(val value: String) {
    READY("ready_for_simulation"),
    LOCKED("locked_critical")
}

data class GateResult(
    val status: GateStatus,
    val stage: String,
    val reason: String,
    val timestamp: Long
)

class BXOSGate(
    val marginThreshold: Double = 0.15,
    val minScore: Double = 0.3,
    val minConfidence: Double = 0.4,
    val criticalPentaryStates: Set<Int> = setOf(-2, -1)
) {
    val log = mutableListOf<GateResult>()

    fun checkInput(interpretations: Map<String, Double>): GateResult {
        val analysis = RashomonBlock.analyze(interpretations, marginThreshold, minScore)
        val status = if (analysis.state == -1) GateStatus.LOCKED else GateStatus.READY
        val result = GateResult(status, "input", analysis.reason, System.currentTimeMillis())
        log.add(result)
        return result
    }

    fun checkOutput(pentaryValue: Int, confidence: Double): GateResult {
        val status: GateStatus
        val reason: String
        
        if (pentaryValue in criticalPentaryStates) {
            status = GateStatus.LOCKED
            reason = "критическое состояние на выходе: $pentaryValue"
        } else if (confidence < minConfidence) {
            status = GateStatus.LOCKED
            reason = "уверенность ниже порога: $confidence < $minConfidence"
        } else {
            status = GateStatus.READY
            reason = "выход прошёл проверку"
        }
        
        val result = GateResult(status, "output", reason, System.currentTimeMillis())
        log.add(result)
        return result
    }

    fun summary(): Map<String, Int> {
        val locked = log.count { it.status == GateStatus.LOCKED }
        val ready = log.size - locked
        return mapOf("total" to log.size, "ready" to ready, "locked" to locked)
    }
}


// ============================================================
// 7. FULL PIPELINE ORCHESTRATOR & BENCHMARKS
// ============================================================

data class FullPipelineResult(
    val status: String,
    val ternary: TernaryResult?,
    val consolidatedTrit: Int?,
    val pentaryConfidence: Double?,
    val pentaryState: PentarnyStateData?,
    val matrix: TernaryMatrix?,
    val auditHash: String?,
    val l5Used: Boolean,
    val gateInput: GateResult?,
    val gateOutput: GateResult?
)

class FullPipeline(val useTraitTable: Boolean = false) {
    val ternary = TernaryBlock
    val pentary = PentaryBlock()
    val matrixBlock = TernaryMatrixBlockWithAudit()
    val gate = BXOSGate()

    fun process(
        query: String,
        interpretations: Map<String, Double>,
        l5Values: Map<String, Int>? = null
    ): FullPipelineResult {
        val gateIn = gate.checkInput(interpretations)
        if (gateIn.status == GateStatus.LOCKED) {
            return FullPipelineResult("locked_input", null, null, null, null, null, null, false, gateIn, null)
        }

        val tr = ternary.process(query, interpretations)
        if (tr.finalDecision == "REJECT") {
            return FullPipelineResult("rejected", tr, null, null, null, null, null, false, gateIn, null)
        }

        val trits = intArrayOf(tr.l3In, tr.l3Out, tr.efficiencyTrit)
        val consolidated = if (useTraitTable) {
            BrusentsovLogic.foldAndViaTraitTable(trits)
        } else {
            BrusentsovLogic.foldAndScalar(trits)
        }

        val confidence = when (consolidated) {
            -1 -> 0.3
            0 -> 0.55
            else -> 0.85
        }

        val pentaryStateData = pentary.receiveFromTernary(tr.bestCandidate!!, tr.efficiency, confidence)

        var matrixResult: TernaryMatrix? = null
        var auditHash: String? = null
        var l5Used = false

        if (l5Values != null && l5Values.keys == setOf("intent", "goal", "ontology", "context", "action")) {
            for ((layer, value) in l5Values) {
                pentary.setL5State(layer, value)
            }
            l5Used = true
            matrixBlock.fromPentaryMapping(l5Values)
            auditHash = matrixBlock.apply("diagonal_projection", mapOf("query" to query))
            matrixResult = matrixBlock.state
        }

        val gateOut = gate.checkOutput(pentaryStateData.value.value, confidence)
        val status = if (gateOut.status == GateStatus.LOCKED) "locked_output" else "ok"

        return FullPipelineResult(
            status, tr, consolidated, confidence, pentaryStateData, matrixResult, auditHash, l5Used, gateIn, gateOut
        )
    }
}

