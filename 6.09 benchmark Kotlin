/**
 * Пентарный блок управления семантическими слоями L5.
 * Переводит троичные сигналы уверенности в пентарные значения [-2, 2].
 */
class PentaryBlock {
    val l5State = mutableMapOf(
        "intent" to 0,
        "goal" to 0,
        "ontology" to 0,
        "context" to 0,
        "action" to 0
    )

    fun setL5State(layer: String, value: Int) {
        if (l5State.containsKey(layer) && value in -2..2) {
            l5State[layer] = value
        }
    }

    fun receiveFromTernary(bestCandidate: String, score: Double, confidence: Double): PentarnyStateData {
        val valPentary = when {
            confidence >= 0.8 && score >= 0.8 -> PentaryValue.STRONG_TRUE
            confidence >= 0.6 -> PentaryValue.TRUE
            confidence >= 0.4 -> PentaryValue.NEUTRAL
            confidence >= 0.2 -> PentaryValue.FALSE
            else -> PentaryValue.STRONG_FALSE
        }
        return PentarnyStateData(value = valPentary, confidence = confidence, sourceCandidate = bestCandidate)
    }
}


// ============================================================
// 5. TERNARY MATRIX & SHA-256 AUDIT CHAIN
// ============================================================

data class TernaryMatrix(val data: Array<IntArray>) {
    fun applyProjection(mode: String = "diagonal_projection"): TernaryMatrix {
        if (mode == "diagonal_projection") {
            val matrixCopy = Array(5) { i -> data[i].clone() }
            for (i in 0 until 5) {
                for (j in 0 until 5) {
                    if (i != j) {
                        matrixCopy[i][j] = 0
                    }
                }
            }
            return TernaryMatrix(matrixCopy)
        }
        return this
    }

    override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (javaClass != other?.javaClass) return false
        other as TernaryMatrix
        return data.contentDeepEquals(other.data)
    }

    override fun hashCode(): Int {
        return data.contentDeepHashCode()
    }
}

/**
 * Неразрывный SHA-256 хэш-реестр (MatrixAuditChain) для фиксации 
 * матричных состояний в контурах пром. автоматизации и телеметрии.
 */
class MatrixAuditChain {
    data class Block(val hash: String, val data: Map<String, Any>)
    
    val chain = mutableListOf<Block>()
    var previousHash: String = "0".repeat(64)

    fun recordState(matrixData: Array<IntArray>, metadata: Map<String, Any> = emptyMap()): String {
        val timestamp = System.currentTimeMillis()
        val matrixList = matrixData.map { it.toList() }
        val blockString = "ts:$timestamp|mat:$matrixList|meta:$metadata|prev:$previousHash"
        val currentHash = sha256(blockString)
        
        chain.add(Block(currentHash, mapOf(
            "timestamp" to timestamp,
            "matrix" to matrixList,
            "metadata" to metadata,
            "previous_hash" to previousHash
        )))
        previousHash = currentHash
        return currentHash
    }

    fun verifyIntegrity(): Boolean {
        var prevH = "0".repeat(64)
        for (block in chain) {
            val dataMap = block.data
            val timestamp = dataMap["timestamp"]
            val matrixList = dataMap["matrix"]
            val metadata = dataMap["metadata"]
            val prev = dataMap["previous_hash"]
            
            if (prev != prevH) return false
            val blockString = "ts:$timestamp|mat:$matrixList|meta:$metadata|prev:$prev"
            val computedHash = sha256(blockString as String)
            if (computedHash != block.hash) return false
            prevH = block.hash
        }
        return true
    }

    private fun sha256(input: String): String {
        val bytes = MessageDigest.getInstance("SHA-256").digest(input.toByteArray())
        return bytes.joinToString("") { "%02x".format(it) }
    }
}

class TernaryMatrixBlockWithAudit {
    var state = TernaryMatrix(Array(5) { IntArray(5) })
    val auditChain = MatrixAuditChain()

    fun fromPentaryMapping(l5Values: Map<String, Int>): TernaryMatrix {
        val matrixData = Array(5) { IntArray(5) }
        val layers = listOf("intent", "goal", "ontology", "context", "action")
        
        layers.forEachIndexed { idx, layer ->
            val value = l5Values[layer] ?: 0
            val trit = if (value > 0) 1 else if (value < 0) -1 else 0
            matrixData[idx][idx] = trit
        }
        
        state = TernaryMatrix(matrixData)
        return state
    }

    fun apply(mode: String, metadata: Map<String, Any> = emptyMap()): String {
        state = state.applyProjection(mode)
        return auditChain.recordState(state.data, metadata)
    }
}


