/**
 * Блок анализа Расёмона. 
 * Вычисляет неопределенность и фиксирует доминантную интерпретацию.
 */
object RashomonBlock {
    fun analyze(
        interpretations: Map<String, Double>,
        marginThreshold: Double = 0.15,
        minScore: Double = 0.3
    ): RashomonResult {
        if (interpretations.isEmpty()) {
            return RashomonResult(-1, null, 0.0, "Нет интерпретаций")
        }

        val sortedItems = interpretations.entries.sortedByDescending { it.value }
        val topEntry = sortedItems[0]
        val topLabel = topEntry.key
        val topScore = topEntry.value

        val margin = if (sortedItems.size > 1) {
            topScore - sortedItems[1].value
        } else {
            topScore
        }

        return when {
            topScore < minScore -> {
                RashomonResult(-1, topLabel, margin, "Лучшая оценка слишком низкая: ${String.format("%.2f", topScore)}")
            }
            margin >= marginThreshold -> {
                RashomonResult(1, topLabel, margin, "Устойчивое ядро: отрыв ${String.format("%.2f", margin)}")
            }
            else -> {
                RashomonResult(0, topLabel, margin, "Неопределённость: отрыв ${String.format("%.2f", margin)}")
            }
        }
    }
}

/**
 * Троичный блок Брусенцова.
 * Фиксирует финальное решение (PROCEED / REJECT) и квантует эффективность в трит.
 */
object TernaryBlock {
    fun process(query: String, interpretations: Map<String, Double>): TernaryResult {
        val analysis = RashomonBlock.analyze(interpretations)
        val state = analysis.state

        if (state == -1) {
            return TernaryResult(
                bestCandidate = null, 
                efficiency = 0.0, 
                l3In = -1, 
                l3Out = -1,
                efficiencyTrit = -1, 
                finalDecision = "REJECT"
            )
        }

        val best = analysis.top
        val score = interpretations[best] ?: 0.0
        
        val effTrit = if (score > 0.7) 1 else if (score >= 0.4) 0 else -1

        return TernaryResult(
            bestCandidate = best,
            efficiency = score,
            l3In = state,
            l3Out = if (score > 0.5) 1 else 0,
            efficiencyTrit = effTrit,
            finalDecision = "PROCEED"
        )
    }
}


// ============================================================
// 3. BRUSENTSOV LOGIC & TRAIT TABLE
// ============================================================

/**
 * Логическое ядро Брусенцова.
 * Реализует Look-Up таблицу трайтов (ширина 3 трита) на плоском нативном примитиве Kotlin.
 */
object BrusentsovLogic {
    private const val TRAIT_WIDTH = 3
    private const val TABLE_SIZE = 27 // 3^3

    val traitTable: IntArray by lazy {
        IntArray(TABLE_SIZE * TABLE_SIZE).apply {
            for (i in 0 until TABLE_SIZE) {
                val aTrits = decodeTrait(i)
                for (j in 0 until TABLE_SIZE) {
                    val bTrits = decodeTrait(j)
                    val resTrits = IntArray(TRAIT_WIDTH) { idx -> 
                        min(aTrits[idx], bTrits[idx]) 
                    }
                    this[i * TABLE_SIZE + j] = encodeTrait(resTrits)
                }
            }
        }
    }

    fun foldAndScalar(trits: IntArray): Int {
        var res = trits[0]
        for (i in 1 until trits.size) {
            res = if (res == 1 && trits[i] == 1) 1 
                  else if (res == -1 || trits[i] == -1) -1 
                  else 0
        }
        return res
    }

    fun encodeTrait(trits: IntArray): Int {
        var valEncoded = 0
        for (t in trits) {
            valEncoded = valEncoded * 3 + (t + 1)
        }
        return valEncoded
    }

    fun decodeTrait(encodedVal: Int): IntArray {
        var temp = encodedVal
        val trits = IntArray(TRAIT_WIDTH)
        for (i in TRAIT_WIDTH - 1 downTo 0) {
            trits[i] = (temp % 3) - 1
            temp /= 3
        }
        return trits
    }

    fun traitAnd(a: Int, b: Int): Int {
        return traitTable[a * TABLE_SIZE + b]
    }

    fun foldAndViaTraitTable(trits: IntArray): Int {
        val values = IntArray(TRAIT_WIDTH) { 1 }
        for (i in trits.indices) {
            if (i < TRAIT_WIDTH) values[i] = trits[i]
        }
        
        val a = encodeTrait(values)
        val b = encodeTrait(IntArray(TRAIT_WIDTH) { 1 })
        val resultEncoded = traitAnd(a, b)
        val resultTrits = decodeTrait(resultEncoded)
        
        return if (trits.size == 1) resultTrits[0] 
               else foldAndScalar(trits.copyOfRange(0, min(trits.size, TRAIT_WIDTH)))
    }
}


