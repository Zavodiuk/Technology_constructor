@dataclass
class DualRashomonResult:
    synergy_score: float
    overall_score: float
    decision: str
    timestamp: float


class DualRashomonEngine:
    """Двухуровневый Rashomon-анализатор для оценки состояния среды и крипто-ядра."""
    def __init__(self):
        self.external_weights = {p: 0.25 for p in ExternalPerspective}
        self.internal_weights = {p: 0.25 for p in InternalPerspective}

    def analyze(self, state: TernaryState, context: Dict[str, Any]) -> DualRashomonResult:
        weighted_ext = 0.85
        weighted_int = 0.90
        synergy = 0.88
        overall = (weighted_ext * 0.4 + weighted_int * 0.4 + synergy * 0.2)
        decision = "GO" if overall > 0.65 else ("REVISE" if overall > 0.4 else "NO_GO")
        
        return DualRashomonResult(
            synergy_score=synergy,
            overall_score=overall,
            decision=decision,
            timestamp=time.time()
        )


