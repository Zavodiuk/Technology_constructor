class OpticalTransportPAM5:
    """Фаза 2: Проецирование пентарных значений на оптические уровни лазера (PAM-5) и передача."""
    
    LEVEL_MAP = {-2: 0.1, -1: 0.3, 0: 0.5, 1: 0.7, 2: 0.9}
    INV_MAP = {0.1: -2, 0.3: -1, 0.5: 0, 0.7: 1, 0.9: 2}

    @staticmethod
    def modulate(compressed_bytes: bytes) -> List[float]:
        optical_signals = []
        for b in compressed_bytes:
            pentar_val = int((b / 51.0) - 2)
            pentar_val = max(-2, min(2, pentar_val))
            intensity = OpticalTransportPAM5.LEVEL_MAP[pentar_val]
            optical_signals.append(intensity)
        return optical_signals

    @staticmethod
    def transmit(signals: List[float], noise_level: float = 0.0) -> List[float]:
        transmitted = []
        for sig in signals:
            noise = np.random.normal(0, noise_level) if noise_level > 0 else 0.0
            corrupted = max(0.0, min(1.0, sig + noise))
            transmitted.append(corrupted)
        return transmitted

    @staticmethod
    def demodulate(signals: List[float]) -> bytes:
        out_bytes = bytearray()
        levels = list(OpticalTransportPAM5.INV_MAP.keys())
        for sig in signals:
            closest_level = min(levels, key=lambda l: abs(l - sig))
            pentar_val = OpticalTransportPAM5.INV_MAP[closest_level]
            b = int((pentar_val + 2) * 51) & 0xFF
            out_bytes.append(b)
        return bytes(out_bytes)


