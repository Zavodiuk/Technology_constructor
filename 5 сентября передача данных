class MoireOpticalPipelineV23:
    """Объединенный трехфазный конвейер: Кодирование -> Оптический Транспорт -> Декодирование."""
    def __init__(self, seed_a: float = 0.78, seed_b: float = 2.35):
        self.encoder_dec = MoireEncoderDecoderV23(seed_a, seed_b)
        self.transport = OpticalTransportPAM5()

    def process_transmission_cycle(self, data: bytes, block_size: int = 49) -> Tuple[bytes, List[str]]:
        padded = data + b"\x00" * (block_size - (len(data) % block_size))
        decisions = []
        
        # ФАЗА 1: Кодирование и сжатие
        encrypted_stream = bytearray()
        for i in range(0, len(padded), block_size):
            block = padded[i:i+block_size]
            enc_block, decision = self.encoder_dec.encode_block(block)
            decisions.append(decision)
            encrypted_stream.extend(enc_block)

        # ФАЗА 2: Оптическая модуляция и передача по каналу (PAM-5)
        optical_pulses = self.transport.modulate(bytes(encrypted_stream))
        transmitted_pulses = self.transport.transmit(optical_pulses, noise_level=0.01)
        demodulated_stream = self.transport.demodulate(transmitted_pulses)

        # ФАЗА 3: Обратное декодирование и верификация
        decrypted_stream = bytearray()
        for i in range(0, len(demodulated_stream), block_size):
            block = demodulated_stream[i:i+block_size]
            dec_block, _ = self.encoder_dec.decode_block(block)
            decrypted_stream.extend(dec_block)

        original_data = decrypted_stream.rstrip(b"\x00")
        return bytes(original_data), decisions


