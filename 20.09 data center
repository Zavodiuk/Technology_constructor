# 1. TERNARY PROCESSOR (L3) & BATCH VECTOR ANALYSIS
# ============================================================

class TernaryProcessor:
    """Оптимизированный троичный блок (L3) на NumPy для пакетной обработки без циклов."""
    
    @staticmethod
    def analyze_interpretations(scores: np.ndarray, margin_threshold: float = 0.15, min_score: float = 0.3) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
        """Обрабатывает двумерный массив скоров формы (BatchSize, NumScores) векторизованно."""
        if scores.size == 0:
            return np.array([-1]), np.array([-1]), np.array([0.0])
            
        if scores.shape[-1] > 1:
            top_2_idx = np.argpartition(scores, -2, axis=-1)[..., -2:]
            sorted_vals = np.take_along_axis(scores, top_2_idx, axis=-1)
            sorted_order = np.argsort(sorted_vals, axis=-1)[..., ::-1]
            top_2_idx = np.take_along_axis(top_2_idx, sorted_order, axis=-1)
            best_idx = top_2_idx[..., 0]
            second_idx = top_2_idx[..., 1]
            best_score = np.take_along_axis(scores, best_idx[..., None], axis=-1).squeeze(-1)
            second_score = np.take_along_axis(scores, second_idx[..., None], axis=-1).squeeze(-1)
            margin = best_score - second_score
        else:
            best_idx = np.zeros(scores.shape[0], dtype=np.intp)
            best_score = scores[:, 0]
            margin = best_score
            
        state = np.where(best_score < min_score, -1, np.where(margin >= margin_threshold, 1, 0))
        return state, best_idx, margin


# ============================================================
# 2. BRUSENTSOV LOGIC & CACHED TRAIT TABLE
# ============================================================

class BrusentsovLogic:
    """Логика Брусенцова с кэшированием (синглтон трайт-таблицы) и бродкастингом."""
    
    _trait_table_cache: Optional[np.ndarray] = None

    def __init__(self, width: int = 3):
        self.width = width
        self.size = 3 ** width
        
        if BrusentsovLogic._trait_table_cache is None:
            steps = np.arange(self.size, dtype=np.int16)
            power_weights = 3 ** np.arange(width - 1, -1, -1)
            trits_matrix = (steps[:, None] // power_weights) % 3 - 1
            min_trits = np.minimum(trits_matrix[:, None, :], trits_matrix[None, :, :])
            encoded = np.sum((min_trits + 1) * power_weights, axis=-1)
            BrusentsovLogic._trait_table_cache = encoded
            
        self.trait_table = BrusentsovLogic._trait_table_cache

    @staticmethod
    def fold_and_vector(trits: np.ndarray) -> np.ndarray:
        """Векторизованная редукция тритов по последней оси без циклов."""
        return np.min(trits, axis=-1)


# ============================================================
# 3. PENTARY LINEAR MATRIX ENGINE (Tensor 5x5)
# ============================================================

class PentaryMatrixEngine:
    """Пентарный блок и генерация плоских линейных матриц 5x5 (Автор: Владимир Заводюк)."""
    
    LAYERS = ['intent', 'goal', 'ontology', 'context', 'action']
    
    @staticmethod
    def build_linear_matrix(l5_vector: np.ndarray) -> np.ndarray:
        """Строит двумерную линейную матрицу 5x5 через тензорный бродкастинг для батча."""
        ternary_vector = np.sign(l5_vector).astype(np.int8)
        if ternary_vector.ndim == 1:
            v1 = ternary_vector[:, None]
            v2 = ternary_vector[None, :]
            return np.minimum(v1, v2).astype(np.int8)
        else:
            v1 = ternary_vector[:, :, None] # (BatchSize, 5, 1)
            v2 = ternary_vector[:, None, :] # (BatchSize, 1, 5)
            return np.minimum(v1, v2).astype(np.int8)


# ============================================================
# 4. BXOS GATE (SECURITY & TELEMETRY)
# ============================================================

class BXOSGate:
    """Высокоскоростной предохранитель контура с микросекундной точностью."""
    
    def __init__(self, min_confidence: float = 0.4, critical_states: Tuple[int, ...] = (-2, -1), max_log: int = 1000):
        self.min_confidence = min_confidence
        self.critical_states = set(critical_states)
        self.log: deque = deque(maxlen=max_log)

    def verify_input_shape(self, data: np.ndarray, expected_dim: int):
        if data.ndim != expected_dim:
            raise ValueError(f"Критическая ошибка размерности! Ожидалось осей: {expected_dim}, получено: {data.ndim}")

    def summary(self) -> Dict[str, Any]:
        locked = sum(1 for r in self.log if r["status"] == "LOCKED")
        ready = len(self.log) - locked
        return {'total': len(self.log), 'ready': ready, 'locked': locked}


# ============================================================
# 5. BXOS PIPELINE ORCHESTRATOR (BATCHED)
# ============================================================

class BXOSPipeline:
    """Сквозной оркестратор пакетных троично-пентарных вычислений узла без циклов."""
    
    def __init__(self):
        self.ternary = TernaryProcessor()
        self.brusentsov = BrusentsovLogic(width=3)
        self.matrix_engine = PentaryMatrixEngine()
        self.gate = BXOSGate()

    def run(self, interpretations_scores: List[List[float]], l5_values_list: List[List[int]]) -> dict:
        scores = np.array(interpretations_scores, dtype=np.float64)
        l5_vector = np.array(l5_values_list, dtype=np.int8)
        
        self.gate.verify_input_shape(scores, expected_dim=2)
        self.gate.verify_input_shape(l5_vector, expected_dim=2)
        if l5_vector.shape[1] != 5:
            raise ValueError("Пентарный вектор L5 должен содержать ровно 5 элементов по последней оси.")

        states, best_idx, margins = self.ternary.analyze_interpretations(scores)
        
        batch_size = scores.shape[0]
        row_indices = np.arange(batch_size)
        best_scores = scores[row_indices, best_idx]
        
        second_trit = np.where(best_scores > 0.5, 1, 0).astype(np.int8)
        third_trit = np.ones_like(second_trit, dtype=np.int8)
        
        feature_trits = np.stack([states, second_trit, third_trit], axis=-1)
        consolidated_trits = self.brusentsov.fold_and_vector(feature_trits)
        
        confidence_map = {-1: 0.3, 0: 0.55, 1: 0.85}
        confidences = np.array([confidence_map.get(t, 0.5) for t in consolidated_trits], dtype=np.float64)
        
        matrices_5x5 = self.matrix_engine.build_linear_matrix(l5_vector)
        
        pentary_values = l5_vector[:, 0]
        timestamp = time.perf_counter()
        
        statuses = []
        for i in range(batch_size):
            if states[i] == -1:
                status = "LOCKED_INPUT"
            elif pentary_values[i] in self.gate.critical_states or confidences[i] < self.gate.min_confidence:
                status = "LOCKED_OUTPUT"
                self.gate.log.append({"status": "LOCKED", "ts": timestamp})
            else:
                status = "OK"
                self.gate.log.append({"status": "READY", "ts": timestamp})
            statuses.append(status)

        return {
            "statuses": statuses,
            "best_candidate_indices": best_idx.tolist(),
            "confidences": confidences.tolist(),
            "matrices_5x5": matrices_5x5
        }


