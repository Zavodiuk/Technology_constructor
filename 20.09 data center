)

node_pipeline = BXOSPipeline()

class NodePayload(BaseModel):
    interpretations_scores: List[List[float]] = Field(..., example=[[0.85, 0.62, 0.41, 0.15, 0.05], [0.91, 0.44, 0.22, 0.1, 0.02]])
    l5_values_list: List[List[int]] = Field(..., example=[[1, 0, -1, 2, -2], [2, 1, 0, -1, -2]])


@app.get("/")
def node_status():
    return {
        "author": "Vladimir Zavodiuk",
        "rights": "All rights reserved",
        "node_status": "active",
        "architecture": "linear 5x5 batch pipeline",
        "telemetry": node_pipeline.gate.summary()
    }


@app.post("/compute-linear-batch")
def compute_linear_batch(payload: NodePayload):
    """Главный эндпоинт дата-центра для пакетного расчета линейного тензора 5x5."""
    try:
        res = node_pipeline.run(payload.interpretations_scores, payload.l5_values_list)
        matrices_list = res["matrices_5x5"].tolist() if res["matrices_5x5"] is not None else None
        return {
            "statuses": res["statuses"],
            "best_candidate_indices": res["best_candidate_indices"],
            "confidences": res["confidences"],
            "matrix_shape": [5, 5],
            "linear_matrices_5x5": matrices_list
        }
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))


