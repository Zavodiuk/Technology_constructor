class BalancedTernaryEncoder {

    fun intToBalancedTernary(inputNumber: Int): List<Int> {
        var n = inputNumber
        if (n == 0) return listOf(0)

        val ternaryDigits = mutableListOf<Int>()
        while (n != 0) {
            var remainder = n % 3
            n /= 3

            if (remainder == 2) {
                remainder = -1
                n += 1
            } else if (remainder == -2) {
                remainder = 1
                n -= 1
            }
            ternaryDigits.add(remainder)
        }
        return ternaryDigits.reversed()
    }

    fun balancedTernaryToInt(ternaryDigits: List<Int>): Int {
        var value = 0
        for (digit in ternaryDigits) {
            value = value * 3 + digit
        }
        return value
    }

    fun generateBarcodeLayout(
        ternaryDigits: List<Int>, 
        baseWidthMm: Double = 0.25
    ): List<Pair<Int, Double>> {
        return ternaryDigits.map { t ->
            val multiplier = when (t) {
                -1 -> 1.0
                0 -> 2.0
                1 -> 3.0
                else -> 2.0
            }
            Pair(t, multiplier * baseWidthMm)
        }
    }
}

fun main() {
    val encoder = BalancedTernaryEncoder()
    val testNumber = 42
    
    val bTernary = encoder.intToBalancedTernary(testNumber)
    val layout = encoder.generateBarcodeLayout(bTernary)
    
    println("Исходное число: $testNumber")
    println("Сбалансированные триты: $bTernary")
    println("Физический макет штрих-кода (трит, мм): $layout")
    println("Декодированная проверка: ${encoder.balancedTernaryToInt(bTernary)}")
}
