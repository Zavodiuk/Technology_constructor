def int_to_balanced_ternary(n: int) -> list[int]:
    """
    Преобразует целое число в массив сбалансированных тритов (-1, 0, 1).
    Используется остаточный метод с симметричным смещением относительно нуля.
    """
    if n == 0:
        return [0]
    
    ternary_digits = []
    while n != 0:
        remainder = n % 3
        n //= 3
        
        if remainder == 2:
            remainder = -1
            n += 1
        elif remainder == -2:
            remainder = 1
            n -= 1
            
        ternary_digits.append(remainder)
        
    return ternary_digits[::-1]

def balanced_ternary_to_int(ternary_digits: list[int]) -> int:
    """
    Обратное преобразование массива сбалансированных тритов в десятичное число.
    """
    value = 0
    for digit in ternary_digits:
        value = value * 3 + digit
    return value

def generate_balanced_barcode_line(ternary_digits: list[int], base_width_mm: float = 0.25) -> list[tuple[int, float]]:
    """
    Проецирует сбалансированные триты на физическую ширину штрихов:
    -1 -> тонкая линия (1 * base)
     0 -> средняя/базовая линия (2 * base)
    +1 -> толстая линия (3 * base)
    """
    width_mapping = {
        -1: 1 * base_width_mm,
         0: 2 * base_width_mm,
         1: 3 * base_width_mm
    }
    
    barcode_layout = []
    for t in ternary_digits:
        barcode_layout.append((t, width_mapping[t]))
        
    return barcode_layout

if __name__ == "__main__":
    test_number = 42
    b_ternary = int_to_balanced_ternary(test_number)
    layout = generate_balanced_barcode_line(b_ternary)
    
    print(f"Исходное число: {test_number}")
    print(f"Сбалансированные триты: {b_ternary}")
    print(f"Физический макет штрих-кода (трит, мм): {layout}")
    print(f"Декодированная проверка: {balanced_ternary_to_int(b_ternary)}")


