class Ternary(Enum):
    """Троичная логика состояний системы [-1, 0, 1] с расширением до пентарного контура."""
    FALSE = -1       # Критическое отклонение / Блокировка (NO_GO)
    UNDEFINED = 0    # Зона неопределенности / Требуется ревизия (REVISE)
    TRUE = 1         # Штатное стабильное состояние / Разрешено (GO)


