# 4. МУАРОВОЕ ЯДРО И БИ-ЯДЕРНОЕ СЖАТИЕ ПАМЯТИ (COUNTER-ROTATING BI-CORES)
# ============================================================================

class CounterRotatingBiCore:
    """
    Контрвращающиеся би-ядра для муарового сжатия двумерных матриц кэш-памяти 
    в пентарном пространстве значений [-2, -1, 0, 1, 2].
    """
    def __init__(self, size: int = 3):
        self.size = size
        self.matrix_a = self._generate_ternary_matrix(1)
        self.matrix_b = self._generate_ternary_matrix(-1)
        self.phase_shift = 0.0

    def _generate_ternary_matrix(self, seed_val: int) -> np.ndarray:
        mat = np.zeros((self.size, self.size), dtype=int)
        mid = self.size // 2
        for x in range(self.size):
            for y in range(self.size):
                if x == mid and y == mid:
                    mat[x, y] = 0
                else:
                    mat[x, y] = seed_val * (((x + y) % 3) - 1)
        return mat

    def apply_moire_compression(self, memory_grid: np.ndarray) -> np.ndarray:
        # Динамический фазовый сдвиг вращения матриц памяти
        self.phase_shift += 0.523 
        rotation_mask = np.sin(self.phase_shift)
        compressed = memory_grid * np.mean(self.matrix_a) - memory_grid * np.mean(self.matrix_b) * rotation_mask
        return np.clip(np.round(compressed), -2, 2).astype(int)


class AndroidMacroFieldV23:
    """Управление двумерными матричными средами оперативной памяти смартфона."""
    def __init__(self, width: int = 3, height: int = 3):
        self.width = width
        self.height = height
        self.cache_grid = np.zeros((height, width), dtype=int)
        self.bicore = CounterRotatingBiCore(size=3)

    def optimize_memory_field(self, raw_vector: List[int]) -> np.ndarray:
        idx = 0
        for r in range(self.height):
            for c in range(self.width):
                if idx < len(raw_vector):
                    self.cache_grid[r, c] = max(-2, min(2, raw_vector[idx]))
                    idx += 1
        return self.bicore.apply_moire_compression(self.cache_grid)


