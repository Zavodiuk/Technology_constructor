def quantize_pentarny(value: float) -> int:
    """Квантование непрерывного значения в дискретный пентарный базис [-2, 2]"""
    if value > 0.75:
        return 2
    elif value > 0.25:
        return 1
    elif value >= -0.25:
        return 0
    elif value >= -0.75:
        return -1
    else:
        return -2


