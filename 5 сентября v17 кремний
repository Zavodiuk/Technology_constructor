class ConflictAttractorPoint:
    """Одиночная плавающая точка-вершина, дрейфующая по градиентам энтропии."""
    def __init__(self, name: str, initial_coords: tuple, field_dims: tuple):
        self.name = name
        self.coords = list(initial_coords)
        self.field_dims = field_dims

    def drift_by_conflict(self, tensor_field: np.ndarray, gradient_fields: list):
        dims = len(self.field_dims)
        best_coords = list(self.coords)
        max_tension = -1.0

        for d in range(dims):
            for delta in [-1, 1]:
                test_coords = list(self.coords)
                test_coords[d] += delta
                
                if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                    local_val = abs(tensor_field[tuple(test_coords)])
                    grad_val = sum(abs(gradient_fields[i][tuple(test_coords)]) for i in range(dims))
                    tension = local_val + grad_val

                    if tension > max_tension:
                        max_tension = tension
                        best_coords = test_coords

        self.coords = best_coords


class DynamicPlaneMembrane:
    """
    Образует динамическую плоскость (геометрический треугольник-мембрану) 
    из трех независимых точек-аттракторов, которая деформируется и перемещается 
    в матрице под воздействием внутренних конфликтов.
    """
    def __init__(self, field_dims: tuple, p1: tuple, p2: tuple, p3: tuple):
        self.field_dims = field_dims
        self.vertex_a = ConflictAttractorPoint("Vertex-A", p1, field_dims)
        self.vertex_b = ConflictAttractorPoint("Vertex-B", p2, field_dims)
        self.vertex_c = ConflictAttractorPoint("Vertex-C", p3, field_dims)

    def update_membrane_position(self, tensor_field: np.ndarray, gradients: list):
        # Каждая точка независимо сдвигается в зону максимального напряжения
        self.vertex_a.drift_by_conflict(tensor_field, gradients)
        self.vertex_b.drift_by_conflict(tensor_field, gradients)
        self.vertex_c.drift_by_conflict(tensor_field, gradients)

    def get_plane_vertices(self) -> tuple:
        return (tuple(self.vertex_a.coords), tuple(self.vertex_b.coords), tuple(self.vertex_c.coords))

    def apply_membrane_barrier(self, tensor_field: PentarnyTensorField, evolution: PentarnyTensorEvolution):
        """
        Инжектирует волновые импульсы по вершинам и ребрам деформирующейся плоскости,
        создавая активный полевой барьер внутри тензорной матрицы.
        """
        va = tuple(self.vertex_a.coords)
        vb = tuple(self.vertex_b.coords)
        vc = tuple(self.vertex_c.coords)

        # Импульсы по вершинам треугольника плоскости
        tensor_field.inject_quantum_impulse(va, 2)
        tensor_field.inject_quantum_impulse(vb, 0)
        tensor_field.inject_quantum_impulse(vc, -2)

        evolution.propagate_wave(va, radius=1)
        evolution.propagate_wave(vb, radius=1)
        evolution.propagate_wave(vc, radius=1)


