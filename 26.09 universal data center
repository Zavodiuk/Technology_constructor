# 3. Оптический транспортный слой (облегчённая встроенная версия)
# ==============================================================================

class FiberRashomonEngine:
    def analyze(self, context: Dict[str, Any]) -> str:
        cd = float(context.get("chromatic_dispersion", 0.1))
        kerr = float(context.get("kerr_nonlinearity", 0.05))
        osnr = float(context.get("osnr_db", 25.0))
        stability = (osnr / 30.0) - (cd * 0.4 + kerr * 0.4)
        if stability > 0.55:
            return "GO"
        elif stability > 0.30:
            return "REVISE"
        return "NO_GO"


class OpticalTransportLayer:
    """Упрощённый, быстрый оптический транспорт для интеграции."""

    def __init__(self):
        self.rashomon = FiberRashomonEngine()

    def transmit(
        self,
        payload: bytes,
        distance_km: float = 100.0,
        chromatic_dispersion: float = 0.04,
        kerr_nonlinearity: float = 0.015,
        osnr_db: float = 26.0
    ) -> Dict[str, Any]:
        context = {
            "chromatic_dispersion": chromatic_dispersion,
            "kerr_nonlinearity": kerr_nonlinearity,
            "osnr_db": osnr_db,
            "distance_km": distance_km
        }
        decision = self.rashomon.analyze(context)

        # Имитация небольшой задержки и возможных потерь (упрощённо)
        # В реальной версии здесь полный encode → fiber → decode
        success = decision != "NO_GO"
        recovered = payload if success else payload  # в полной версии — после компенсации

        return {
            "success": success,
            "decision": decision,
            "distance_km": distance_km,
            "recovered_payload": recovered,
            "message": "Optical transmission " + ("OK" if success else "degraded")
        }


