@dataclass
class FullPipelineResult:
    compute: dict
    compressed_size: int
    original_size: int
    compression_ratio: float
    optical: dict
    total_latency_ms: float


class FullDatacenterNode:
    def __init__(self):
        self.pipeline = BXOSPipeline(strategy="luka")
        self.compressor = PentaryStructuredCompressor(level=6)
        self.optical = OpticalTransportLayer()

    def compute_compress_transmit(
        self,
        interpretations_scores: List[List[float]],
        l5_values_list: List[List[int]],
        distance_km: float = 150.0,
        chromatic_dispersion: float = 0.04,
        kerr_nonlinearity: float = 0.015,
        osnr_db: float = 26.5
    ) -> FullPipelineResult:
        t0 = time.perf_counter()

        # 1. Вычисление
        compute_result = self.pipeline.run(interpretations_scores, l5_values_list)

        # 2. Сериализация + сжатие
        raw = json.dumps(compute_result, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        compressed = self.compressor.compress(raw)
        ratio = self.compressor.compress_ratio(raw, compressed)

        # 3. Оптическая передача
        optical_result = self.optical.transmit(
            payload=compressed,
            distance_km=distance_km,
            chromatic_dispersion=chromatic_dispersion,
            kerr_nonlinearity=kerr_nonlinearity,
            osnr_db=osnr_db
        )

        total_ms = (time.perf_counter() - t0) * 1000

        return FullPipelineResult(
            compute=compute_result,
            compressed_size=len(compressed),
            original_size=len(raw),
            compression_ratio=ratio,
            optical=optical_result,
            total_latency_ms=total_ms
        )


