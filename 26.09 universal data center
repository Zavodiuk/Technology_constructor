class PentaryStructuredCompressor:
    """
    Лёгкий компрессор для дата-центра.
    Вдохновлён ZVD / пентарным подходом, но оптимизирован под:
      - JSON-результаты вычислений
      - тензоры и управляющие пакеты
      - высокую скорость + хорошее сжатие на структурированных данных
    """

    def __init__(self, level: int = 6):
        self.level = level  # zlib level

    def compress(self, data: bytes) -> bytes:
        """Сжатие с заголовком."""
        if not data:
            return b""
        compressed = zlib.compress(data, level=self.level)
        # Заголовок: magic (4) + original_size (4) + compressed_size (4)
        header = b"ZVD\x01" + struct.pack(">II", len(data), len(compressed))
        return header + compressed

    def decompress(self, data: bytes) -> bytes:
        if len(data) < 12 or data[:4] != b"ZVD\x01":
            raise ValueError("Invalid compressed format")
        orig_size, comp_size = struct.unpack(">II", data[4:12])
        payload = data[12:12 + comp_size]
        restored = zlib.decompress(payload)
        if len(restored) != orig_size:
            raise ValueError("Size mismatch after decompress")
        return restored

    def compress_ratio(self, original: bytes, compressed: bytes) -> float:
        if not compressed:
            return 0.0
        return len(original) / len(compressed)


