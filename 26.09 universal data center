@dataclass
class FastPipelineResult:
    mode_used: str
    statuses: List[str]
    folded_results: List[int]
    rejected_by_triage: int
    passed_to_full: int
    compression_ratio: float
    original_bytes: int
    compressed_bytes: int
    optical_decision: str
    total_latency_ms: float
    early_exit: bool


class FastDatacenterNode:
    """
    Режимы:
      - "fast"     : только L3 triage, ранний выход
      - "standard" : L3 → при необходимости L5 + fold
      - "full"     : всегда полный путь + compression + optical
    """

    def __init__(self, strategy: str = "luka"):
        self.logic = MultivaluedLogicEngine(strategy=strategy)
        self.compressor = PentaryStructuredCompressor(level=6)
        self.optical = OpticalTransportLayer()
        self.rashomon = PentarnyRashomon()

        # Прогрев JIT
        _ = bxos_guard_numba(np.zeros((64, 5), dtype=np.float64))
        _ = godel_reduce_batch(np.zeros((64, 5), dtype=np.int8))
        _ = luka_reduce_batch(np.zeros((64, 5), dtype=np.int8))
        _ = l3_triage_batch(np.random.rand(64, 4).astype(np.float64))

    def process(
        self,
        interpretations_scores: List[List[float]],
        l5_values_list: List[List[int]],
        mode: Literal["fast", "standard", "full"] = "standard",
        distance_km: float = 150.0
    ) -> FastPipelineResult:

        t0 = time.perf_counter()
        scores = np.asarray(interpretations_scores, dtype=np.float64)
        l5 = np.asarray(l5_values_list, dtype=np.int8)
        n = scores.shape[0]

        # ---------- STAGE 1: L3 Fast-Path (очень дёшево) ----------
        triage = l3_triage_batch(scores)          # -1 / 0 / 1
        rejected_mask = triage == -1
        rejected_count = int(np.sum(rejected_mask))
        passed_count = n - rejected_count

        statuses = []
        for t in triage:
            if t == -1:
                statuses.append("REJECTED_BY_TRIAGE")
            elif t == 0:
                statuses.append("CLARIFY")
            else:
                statuses.append("OK")

        # Fast mode — выходим сразу
        if mode == "fast" or passed_count == 0:
            latency = (time.perf_counter() - t0) * 1000
            return FastPipelineResult(
                mode_used="fast",
                statuses=statuses,
                folded_results=[-2] * n,
                rejected_by_triage=rejected_count,
                passed_to_full=0,
                compression_ratio=0.0,
                original_bytes=0,
                compressed_bytes=0,
                optical_decision="SKIPPED",
                total_latency_ms=latency,
                early_exit=True
            )

        # ---------- STAGE 2: L5 + Numba fold (только для прошедших) ----------
        folded = self.logic.fold_batch(l5)

        # ---------- STAGE 3: Compression + Optical (только в full / standard при необходимости) ----------
        if mode == "full":
            payload = {
                "statuses": statuses,
                "folded": folded.tolist(),
                "triage": triage.tolist()
            }
            raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
            compressed = self.compressor.compress(raw)
            ratio = self.compressor.ratio(raw, compressed)
            opt = self.optical.transmit(compressed, distance_km=distance_km)
            optical_decision = opt["decision"]
            orig_b, comp_b = len(raw), len(compressed)
        else:
            # standard — без сжатия/оптики, только compute
            ratio = 0.0
            optical_decision = "SKIPPED"
            orig_b = comp_b = 0

        latency = (time.perf_counter() - t0) * 1000

        return FastPipelineResult(
            mode_used=mode,
            statuses=statuses,
            folded_results=folded.tolist(),
            rejected_by_triage=rejected_count,
            passed_to_full=passed_count,
            compression_ratio=ratio,
            original_bytes=orig_b,
            compressed_bytes=comp_b,
            optical_decision=optical_decision,
            total_latency_ms=latency,
            early_exit=False
        )


