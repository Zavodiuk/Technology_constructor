def run_benchmark():
    print("=" * 78)
    print("Universal Datacenter Node FULL V23 FAST — Benchmark")
    print("Numba kernels + Cascade Fast-Path")
    print("Author: Vladimir Zavodiuk")
    print("=" * 78)

    node = FastDatacenterNode(strategy="luka")
    np.random.seed(42)

    # Создаём смешанный поток: 40% явно плохих, 60% нормальных
    def make_mixed_batch(bs, reject_ratio=0.4):
        scores = np.random.rand(bs, 4)
        # Делаем часть строк заведомо слабыми
        n_reject = int(bs * reject_ratio)
        scores[:n_reject] *= 0.25          # низкие скоры → REJECT
        l5 = np.random.randint(-2, 3, size=(bs, 5)).astype(np.int8)
        return scores.tolist(), l5.tolist()

    print(f"\n{'Batch':>7} | {'Mode':>10} | {'Latency (ms)':>12} | {'Rejected':>10} | {'Early exit':>11} | {'Ratio':>7}")
    print("-" * 75)

    for bs in [32, 128, 512, 1024]:
        scores, l5 = make_mixed_batch(bs, reject_ratio=0.4)

        for mode in ["fast", "standard", "full"]:
            # warmup
            for _ in range(5):
                node.process(scores, l5, mode=mode)

            times = []
            rejected = []
            early = []
            ratios = []
            for _ in range(40):
                res = node.process(scores, l5, mode=mode)
                times.append(res.total_latency_ms)
                rejected.append(res.rejected_by_triage)
                early.append(res.early_exit)
                ratios.append(res.compression_ratio)

            print(f"{bs:>7} | {mode:>10} | {np.mean(times):>10.3f} ms | "
                  f"{int(np.mean(rejected)):>10} | {str(any(early)):>11} | {np.mean(ratios):>5.2f}x")

    print("\n" + "=" * 78)
    print("Сравнение режимов (batch=512, 40% мусорных запросов)")
    print("=" * 78)
    scores, l5 = make_mixed_batch(512, 0.4)

    for mode in ["fast", "standard", "full"]:
        for _ in range(10):
            node.process(scores, l5, mode=mode)
        t0 = time.perf_counter()
        for _ in range(50):
            node.process(scores, l5, mode=mode)
        dt = (time.perf_counter() - t0) / 50 * 1000
        print(f"  {mode:10} : {dt:.3f} ms/batch")

    print("\nГотово. Fast-Path + Numba работают.")
    print("=" * 78)


if __name__ == "__main__":
