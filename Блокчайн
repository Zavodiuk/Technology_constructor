class ValidatorState(Enum):
    """Состояние валидатора."""
    ACTIVE = "active"
    SUSPENDED = "suspended"
    BANNED = "banned"


@dataclass
class Validator:
    """
    Модель валидатора в троичной системе.
    """
    id: int
    stake: float = 0.5          # доля в сети (0..1)
    uptime: float = 0.9         # время работы (0..1)
    latency: float = 0.1        # задержка (0..1, чем меньше, тем лучше)
    success_rate: float = 0.95  # доля успешных валидаций (0..1)
    reputation: float = 0.8     # общая репутация (0..1)
    state: ValidatorState = ValidatorState.ACTIVE

    def get_metrics_vector(self) -> Tuple[int, ...]:
        """
        Возвращает вектор тритов для данного валидатора.
        """
        return (
            quantize(self.stake),
            quantize(self.uptime),
            quantize(1 - self.latency),  # чем меньше задержка, тем лучше
            quantize(self.success_rate),
            quantize(self.reputation)
        )

    def get_reliability_score(self) -> int:
        """
        Интегральная оценка надёжности валидатора (один трит).
        """
        return ternary_fold(self.get_metrics_vector())

    def __repr__(self):
        return f"Validator(id={self.id}, reliability={self.get_reliability_score()}, state={self.state.value})"


@dataclass
class Transaction:
    """
    Модель транзакции.
    """
    id: str
    sender: int
    receiver: int
    amount: float
    timestamp: float
    signature_valid: bool = True
    balance_sufficient: bool = True
    not_blacklisted: bool = True
    contract_ok: bool = True

    def get_validation_vector(self) -> Tuple[int, ...]:
        """
        Возвращает вектор тритов для проверки транзакции.
        """
        return (
            1 if self.signature_valid else -1,
            1 if self.balance_sufficient else -1,
            1 if self.not_blacklisted else -1,
            1 if self.contract_ok else -1
        )

    def is_valid(self) -> int:
        """
        Проверяет транзакцию (один трит).
        """
        return ternary_fold(self.get_validation_vector())


@dataclass
class Block:
    """
    Модель блока.
    """
    height: int
    transactions: List[Transaction]
    timestamp: float
    proposer_id: int
    hash: str = ""
    prev_hash: str = ""


# =============================================================================
# ОСНОВНОЙ КЛАСС — ТРОИЧНЫЙ КОНСЕНСУС
# =============================================================================

class TernaryConsensus:
    """
    Троичный консенсусный механизм для блокчейна.
    """

    def __init__(
        self,
        num_validators: int = 10,
        consensus_threshold: float = 0.6,
        uncertainty_threshold: float = 0.3,
        low: float = 0.3,
        high: float = 0.7
    ):
        """
        Инициализация сети.

        Аргументы:
            num_validators: количество валидаторов
            consensus_threshold: доля +1 для принятия блока (0..1)
            uncertainty_threshold: доля 0 для перехода в режим уточнения (0..1)
            low, high: пороги для квантования
        """
        self.validators: Dict[int, Validator] = {}
        self.consensus_threshold = consensus_threshold
        self.uncertainty_threshold = uncertainty_threshold
        self.low = low
        self.high = high
        self.blocks: List[Block] = []
        self.pending_transactions: List[Transaction] = []
        self.blacklist: Set[int] = set()

        # Создаём валидаторов
        for i in range(num_validators):
            self.validators[i] = Validator(
                id=i,
                stake=random.uniform(0.3, 1.0),
                uptime=random.uniform(0.7, 0.99),
                latency=random.uniform(0.01, 0.3),
                success_rate=random.uniform(0.8, 0.98),
                reputation=random.uniform(0.5, 0.95)
            )

    # -------------------------------------------------------------------------
    # Репутация и отбор валидаторов
    # -------------------------------------------------------------------------

    def get_active_validators(self) -> List[Validator]:
        """Возвращает список активных валидаторов."""
        return [v for v in self.validators.values() if v.state == ValidatorState.ACTIVE]

    def get_reliable_validators(self) -> List[Validator]:
        """Возвращает валидаторов с рейтингом +1."""
        return [v for v in self.get_active_validators() if v.get_reliability_score() == 1]

    def get_neutral_validators(self) -> List[Validator]:
        """Возвращает валидаторов с рейтингом 0."""
        return [v for v in self.get_active_validators() if v.get_reliability_score() == 0]

    def update_validator_reputation(self, validator_id: int, success: bool):
        """
        Обновляет репутацию валидатора на основе успешности.
        """
        v = self.validators.get(validator_id)
        if not v:
            return
        # Простое обновление: если успешно, увеличиваем, иначе уменьшаем
        if success:
            v.reputation = min(1.0, v.reputation + 0.05)
            v.success_rate = min(1.0, v.success_rate + 0.02)
        else:
            v.reputation = max(0.1, v.reputation - 0.1)
            v.success_rate = max(0.1, v.success_rate - 0.05)

        # Если репутация упала ниже порога, баним
        if v.reputation < 0.2:
            v.state = ValidatorState.BANNED
            self.blacklist.add(validator_id)
        elif v.reputation < 0.4:
            v.state = ValidatorState.SUSPENDED

    # -------------------------------------------------------------------------
    # Валидация транзакций
    # -------------------------------------------------------------------------

    def validate_transaction(self, tx: Transaction) -> int:
        """
        Проверяет одну транзакцию и возвращает трит.
        """
        # Проверяем, не в чёрном списке ли отправитель
        if tx.sender in self.blacklist:
            return -1
        return tx.is_valid()

    def validate_transactions(self, transactions: List[Transaction]) -> Tuple[int, List[Transaction]]:
        """
        Проверяет список транзакций.
        Возвращает (результат, список валидных транзакций).
        """
        valid_txs = []
        invalid_txs = []
        results = []

        for tx in transactions:
            result = self.validate_transaction(tx)
            results.append(result)
            if result == 1:
                valid_txs.append(tx)
            else:
                invalid_txs.append(tx)

        # Свёртка всех проверок
        overall = ternary_fold(tuple(results))
        return overall, valid_txs

    # -------------------------------------------------------------------------
    # Консенсусное голосование
    # -------------------------------------------------------------------------

    def propose_block(self, block: Block) -> Dict[str, Any]:
        """
        Предлагает блок и запускает консенсусное голосование.

        Аргументы:
            block: блок для утверждения

        Возвращает:
            dict: {'decision': 'COMMIT'/'REJECT'/'REVIEW', 'votes': {...}, 'details': {...}}
        """
        active = self.get_active_validators()
        if not active:
            return {'decision': 'REJECT', 'reason': 'NO_ACTIVE_VALIDATORS'}

        # Сначала проверяем все транзакции в блоке
        tx_result, valid_txs = self.validate_transactions(block.transactions)
        if tx_result == -1:
            return {'decision': 'REJECT', 'reason': 'INVALID_TRANSACTIONS'}

        # Голосование валидаторов
        votes = []
        vote_details = {}

        for v in active:
            # Каждый валидатор голосует на основе своей оценки блока
            # (здесь можно добавить сложную логику)
            reliability = v.get_reliability_score()
            # Если валидатор ненадёжен, его голос -1
            if reliability == -1:
                vote = -1
            else:
                # Иначе оцениваем блок по нескольким критериям
                # (упрощённо: используем случайный фактор + репутацию)
                quality = (v.reputation + random.uniform(0.7, 0.9)) / 2
                vote = quantize(quality, self.low, self.high)
            votes.append(vote)
            vote_details[v.id] = {'vote': vote, 'reliability': reliability}

        # Агрегация голосов
        consensus = ternary_fold(tuple(votes))

        # Анализ распределения
        count_1 = sum(1 for v in votes if v == 1)
        count_0 = sum(1 for v in votes if v == 0)
        count_minus_1 = sum(1 for v in votes if v == -1)
        total = len(votes)

        # Проверяем антагонизмы между валидаторами
        has_disagreement = False
        active_list = list(active)
        for i in range(len(active_list)):
            for j in range(i + 1, len(active_list)):
                vec_i = active_list[i].get_metrics_vector()
                vec_j = active_list[j].get_metrics_vector()
                if disagreement_detected(vec_i, vec_j):
                    has_disagreement = True
                    break
            if has_disagreement:
                break

        # Принимаем решение
        if has_disagreement:
            decision = 'REVIEW'
            reason = 'DISAGREEMENT_DETECTED'
        elif consensus == 1 and count_1 / total >= self.consensus_threshold:
            decision = 'COMMIT'
            reason = 'STRONG_CONSENSUS'
        elif consensus == -1 or count_minus_1 / total >= self.consensus_threshold:
            decision = 'REJECT'
            reason = 'STRONG_REJECTION'
        elif count_0 / total >= self.uncertainty_threshold:
            decision = 'REVIEW'
            reason = 'UNCERTAINTY'
        else:
            # Всё остальное — идём по консенсусу
            if consensus == 1:
                decision = 'COMMIT'
                reason = 'WEAK_CONSENSUS'
            elif consensus == -1:
                decision = 'REJECT'
                reason = 'WEAK_REJECTION'
            else:
                decision = 'REVIEW'
                reason = 'BALANCED'

        # Если решение COMMIT, фиксируем блок и обновляем репутации
        if decision == 'COMMIT':
            self.blocks.append(block)
            # Обновляем репутацию proposer'а
            self.update_validator_reputation(block.proposer_id, True)
            # Обновляем репутации голосовавших за
            for v_id, detail in vote_details.items():
                if detail['vote'] == 1:
                    self.update_validator_reputation(v_id, True)
        else:
            # Если REJECT или REVIEW, proposer теряет репутацию
            self.update_validator_reputation(block.proposer_id, False)

        return {
            'decision': decision,
            'reason': reason,
            'votes': vote_details,
            'summary': {'+1': count_1, '0': count_0, '-1': count_minus_1},
            'consensus': consensus,
            'has_disagreement': has_disagreement,
            'block_height': block.height
        }

    # -------------------------------------------------------------------------
    # Обнаружение атак
    # -------------------------------------------------------------------------

    def detect_attack(self) -> Dict[str, Any]:
        """
        Анализирует сеть на предмет атак (сивилла, двойная трата).
        Возвращает статус и рекомендации.
        """
        active = self.get_active_validators()
        if len(active) < 3:
            return {'status': 'VULNERABLE', 'reason': 'TOO_FEW_VALIDATORS'}

        # Проверяем, нет ли группы с одинаковыми паттернами (сивилла)
        patterns = {}
        for v in active:
            vec = v.get_metrics_vector()
            if vec in patterns:
                patterns[vec].append(v.id)
            else:
                patterns[vec] = [v.id]

        suspicious_groups = [group for group in patterns.values() if len(group) > 1]
        if suspicious_groups:
            return {
                'status': 'SUSPICIOUS',
                'reason': 'SYBIL_ATTACK_DETECTED',
                'groups': suspicious_groups
            }

        # Проверяем, нет ли конфликта интересов (двойная трата)
        # (упрощённо: смотрим на расхождения в голосованиях)
        reliable = self.get_reliable_validators()
        neutral = self.get_neutral_validators()
        if len(reliable) < len(active) * 0.3:
            return {
                'status': 'WARNING',
                'reason': 'LOW_RELIABILITY',
                'reliable_count': len(reliable),
                'total': len(active)
            }

        return {'status': 'OK', 'reason': 'NO_ATTACK_DETECTED'}

    # -------------------------------------------------------------------------
    # Откат (Rollback)
    # -------------------------------------------------------------------------

    def rollback(self, height: int) -> bool:
        """
        Откатывает цепочку к указанной высоте.
        """
        if height < 0 or height >= len(self.blocks):
            return False
        self.blocks = self.blocks[:height]
        print(f"Rollback to height {height}")
        return True

    # -------------------------------------------------------------------------
    # Статистика
    # -------------------------------------------------------------------------

    def get_stats(self) -> Dict[str, Any]:
        """
        Возвращает статистику сети.
        """
        active = self.get_active_validators()
        reliable = self.get_reliable_validators()
        neutral = self.get_neutral_validators()
        return {
            'total_validators': len(self.validators),
            'active_validators': len(active),
            'reliable_validators': len(reliable),
            'neutral_validators': len(neutral),
            'blocks': len(self.blocks),
            'pending_txs': len(self.pending_transactions),
            'blacklist_size': len(self.blacklist),
            'consensus_threshold': self.consensus_threshold,
            'uncertainty_threshold': self.uncertainty_threshold
        }


