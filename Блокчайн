            contract_ok=random.random() > 0.08
        )
        for i in range(10)
    ]

    # 3. Создаём блок
    block = Block(
        height=1,
        transactions=txs,
        timestamp=time.time(),
        proposer_id=0
    )

    print(f"\n[2] Предложен блок #{block.height} с {len(txs)} транзакциями")

    # 4. Проводим голосование
    result = consensus.propose_block(block)
    print(f"\n[3] Результат голосования: {result['decision']} ({result['reason']})")
    print(f"    Голоса: +1={result['summary']['+1']}, 0={result['summary']['0']}, -1={result['summary']['-1']}")
    print(f"    Консенсус: {result['consensus']}")
    print(f"    Расхождение: {result['has_disagreement']}")

    # 5. Проверяем атаки
    attack_check = consensus.detect_attack()
    print(f"\n[4] Проверка атак: {attack_check['status']} ({attack_check['reason']})")

    # 6. Показываем статистику
    print(f"\n[5] Текущая статистика:")
    stats = consensus.get_stats()
    for k, v in stats.items():
        print(f"    {k}: {v}")

    # 7. Эмулируем плохой блок (для демонстрации отката)
    print("\n[6] Эмуляция плохого блока...")
    bad_txs = [
        Transaction(
            id=f"bad_{i}",
            sender=i,
            receiver=i+1,
            amount=1000,
            timestamp=time.time(),
            signature_valid=False,  # невалидная подпись
            balance_sufficient=True,
            not_blacklisted=True,
            contract_ok=True
        )
        for i in range(3)
    ]
    bad_block = Block(height=2, transactions=bad_txs, timestamp=time.time(), proposer_id=1)
    bad_result = consensus.propose_block(bad_block)
    print(f"    Результат: {bad_result['decision']} ({bad_result['reason']})")

    if bad_result['decision'] == 'REJECT':
        print("    Откат...")
        consensus.rollback(1)

    # 8. Итог
    print("\n[7] Итоговая статистика:")
    stats = consensus.get_stats()
    for k, v in stats.items():
        print(f"    {k}: {v}")

    print("\n" + "=" * 70)
    print("ДЕМОНСТРАЦИЯ ЗАВЕРШЕНА")
    print("=" * 70)


if __name__ == "__main__":
    demo()
