def quantize(value: float, low: float = 0.3, high: float = 0.7) -> int:
    """
    Квантует непрерывное значение в трит {-1, 0, +1}.
    Используется для преобразования любых метрик в троичную форму.

    Аргументы:
        value (float): входное значение в диапазоне [0, 1]
        low (float): нижний порог (по умолчанию 0.3)
        high (float): верхний порог (по умолчанию 0.7)

    Возвращает:
        int: -1, 0 или +1

    Пример:
        >>> quantize(0.85)
        1
        >>> quantize(0.5)
        0
        >>> quantize(0.2)
        -1
    """
    if value >= high:
        return 1
    elif value <= low:
        return -1
    else:
        return 0


def normalize_sign(x: int) -> int:
    """Нормализация знака: x>0 → +1, x=0 → 0, x<0 → -1."""
    if x > 0:
        return 1
    elif x < 0:
        return -1
    else:
        return 0


def ternary_fold(vector: Tuple[int, ...]) -> int:
    """
    Свёртка вектора тритов в один трит.
    Вычисляется как нормализация знака суммы компонент.

    Аргументы:
        vector: кортеж из тритов (-1, 0, +1)

    Возвращает:
        int: один трит

    Пример:
        >>> ternary_fold((1, 1, -1))
        1
        >>> ternary_fold((1, -1, 0))
        0
    """
    return normalize_sign(sum(vector))


def ternary_diff(vec_a: Tuple[int, ...], vec_b: Tuple[int, ...]) -> Tuple[int, ...]:
    """
    Поэлементная разность двух векторов тритов без нормализации.
    Результат в диапазоне [-2, 2] — переход к пятеричной логике,
    используется для выявления антагонизмов.

    Пример:
        >>> ternary_diff((1, 0, 1), (-1, 1, 0))
        (2, -1, 1)
    """
    return tuple(a - b for a, b in zip(vec_a, vec_b))


def disagreement_detected(vec_a: Tuple[int, ...], vec_b: Tuple[int, ...], threshold: int = 2) -> bool:
    """
    Проверяет, есть ли антагонизм между двумя векторами.
    Антагонизм — если хотя бы по одной оси разность >= threshold.

    Аргументы:
        vec_a, vec_b: векторы тритов
        threshold: порог антагонизма (обычно 2)

    Возвращает:
        bool: True если обнаружен антагонизм
    """
    diff = ternary_diff(vec_a, vec_b)
    return any(abs(d) >= threshold for d in diff)


