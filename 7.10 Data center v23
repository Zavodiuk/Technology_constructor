class BXOSGate:
    """Детерминированный входной/выходной фильтр критических состояний."""
    @staticmethod
    def guard(signal: np.ndarray) -> np.ndarray:
        return np.clip(signal, -2.0, 2.0)

    def __init__(self, min_confidence: float = 0.4,
                 critical_states: Tuple[int, ...] = (-2, -1), max_log: int = 1000):
        self.min_confidence = min_confidence
        self.critical_states = set(critical_states)
        self.log: deque = deque(maxlen=max_log)

    def record(self, batch_statuses: List[str]) -> None:
        """Запись статусов батча в телеметрию гейта."""
        for s in batch_statuses:
            self.log.append({"status": s})

    def summary(self) -> Dict[str, Any]:
        locked = sum(1 for r in self.log if r.get("status") == "LOCKED")
        revise = sum(1 for r in self.log if r.get("status") == "REVISE")
        ready = len(self.log) - locked - revise
        return {
            "total": len(self.log),
            "ready": ready,
            "locked": locked,
            "revise": revise
        }


