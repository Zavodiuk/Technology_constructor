def penta_not(a: Union[int, float, np.ndarray]) -> Union[int, float, np.ndarray]:
    """Пентарное отрицание Лукасевича."""
    return -a

def penta_impl(a: Union[int, float, np.ndarray], b: Union[int, float, np.ndarray]) -> Union[int, float, np.ndarray]:
    """Пентарная импликация Лукасевича."""
    return np.minimum(2, 2 - a + b)

def penta_and(a: Union[int, float, np.ndarray], b: Union[int, float, np.ndarray]) -> Union[int, float, np.ndarray]:
    """Пентарная конъюнкция (И) через импликацию и отрицание."""
    return penta_not(penta_impl(a, penta_not(b)))

def evaluate_ontology_vector(ontology_vector: Optional[List[int]]) -> int:
    """
    Свёртка 5-слойного онтологического вектора L5 через последовательный penta_and.
    Если вектор пустой или None, возвращает нейтральное состояние 2 (NEUTRAL_TRUE).
    """
    if not ontology_vector:
        return 2
    
    current = ontology_vector[0]
    for val in ontology_vector[1:]:
        current = penta_and(current, val)
    return int(current)


