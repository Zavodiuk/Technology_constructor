# ВЫСОКОПРОИЗВОДИТЕЛЬНОЕ МАТЕМАТИЧЕСКОЕ ЯДРО (NUMPY FLOAT64)
# =====================================================================

class NumPyVectorizedEngine:
    """
    Высокопроизводительное математическое ядро для финансового бота.
    Строго использует двойную точность (np.float64) и защищено от рыночных аномалий.
    """
    
    @staticmethod
    def calculate_sma(prices: np.ndarray, window: int = 5) -> np.ndarray:
        """Векторизованный расчет простого скользящего среднего (SMA) на float64."""
        if prices.size < window:
            return np.array([], dtype=np.float64)
        
        prices_f64 = prices.astype(np.float64, copy=False)
        ret = np.cumsum(prices_f64, dtype=np.float64)
        ret[window:] = ret[window:] - ret[:-window]
        return ret[window - 1:] / window

    @staticmethod
    def evaluate_orderbook_metrics(bids: np.ndarray, asks: np.ndarray) -> Dict[str, float]:
        """Мгновенный расчет метрик стакана с двойной точностью float64 и безопасной обработкой размерностей."""
        if bids.size == 0 or asks.size == 0:
            return {"spread": 0.0, "mid_price": 0.0, "imbalance": 0.0, "total_liquidity": 0.0}
        
        bids_f64 = bids.astype(np.float64, copy=False)
        asks_f64 = asks.astype(np.float64, copy=False)
        
        best_bid = float(np.max(bids_f64[:, 0])) if bids_f64.ndim > 1 and bids_f64.shape[1] > 0 else float(np.max(bids_f64))
        best_ask = float(np.min(asks_f64[:, 0])) if asks_f64.ndim > 1 and asks_f64.shape[1] > 0 else float(np.min(asks_f64))
        
        spread = best_ask - best_bid
        mid_price = (best_bid + best_ask) / 2.0
        
        total_bid_vol = float(np.sum(bids_f64[:, 1])) if bids_f64.ndim > 1 and bids_f64.shape[1] > 1 else float(bids_f64.shape[0])
        total_ask_vol = float(np.sum(asks_f64[:, 1])) if asks_f64.ndim > 1 and asks_f64.shape[1] > 1 else float(asks_f64.shape[0])
        
        denominator = total_bid_vol + total_ask_vol
        imbalance = (total_bid_vol - total_ask_vol) / denominator if denominator > 0 else 0.0

        return {
            "spread": round(spread, 8),
            "mid_price": round(mid_price, 8),
            "imbalance": round(imbalance, 6),
            "total_liquidity": round(total_bid_vol + total_ask_vol, 6)
        }

    @staticmethod
    def calculate_risk_metrics(returns: np.ndarray) -> Dict[str, float]:
        """
        Расчет волатильности и максимальной просадки с двойной точностью (np.float64) 
        и защитой от полного коллапса счета (клиппирование доходности снизу на уровне -0.9999).
        """
        if returns.size == 0:
            return {"volatility": 0.0, "max_drawdown": 0.0}
        
        returns_f64 = returns.astype(np.float64, copy=False)
        safe_returns = np.clip(returns_f64, -0.9999, None)
        
        volatility = float(np.std(safe_returns))
        cumulative = np.cumprod(1.0 + safe_returns)
        
        peak = np.maximum.accumulate(cumulative)
        drawdown = (cumulative - peak) / (peak + 1e-12)
        max_drawdown = float(np.min(drawdown))

        return {
            "volatility": round(volatility, 8),
            "max_drawdown": round(max_drawdown, 8)
        }


