@dataclass
class FinancialDataContainer:
    """
    Полиморфный контейнер для любых финансовых данных (котировки, стаканы, 
    логи, тензоры признаков), упакованный в плотный байтовый поток.
    """
    record_id: str
    data_type: str            # "json_orderbook", "tensor_ticks", "text_log", "binary"
    schema_version: int
    ontology_vector: List[int] # L1-L5 онтологические оси
    compressed_payload: bytes # Плотный бинарный блок (zlib level 9)
    original_size: int
    bxos_checksum: str
    timestamp_ns: int

    @classmethod
    def pack(cls, record_id: str, raw_data: Any, data_type: str = "json_orderbook", ontology_vector: List[int] = None) -> "FinancialDataContainer":
        """Принимает произвольные финансовые данные и упаковывает их в защищенный контейнер."""
        if isinstance(raw_data, str):
            payload_bytes = raw_data.encode("utf-8")
        elif isinstance(raw_data, (dict, list)):
            payload_bytes = json.dumps(raw_data, ensure_ascii=False).encode("utf-8")
        elif isinstance(raw_data, np.ndarray):
            header = {"shape": raw_data.shape, "dtype": str(raw_data.dtype)}
            header_bytes = json.dumps(header).encode("utf-8")
            payload_bytes = len(header_bytes).to_bytes(4, byteorder="big") + header_bytes + raw_data.tobytes()
            data_type = "tensor_ticks"
        elif isinstance(raw_data, bytes):
            payload_bytes = raw_data
        else:
            payload_bytes = str(raw_data).encode("utf-8")

        original_size = len(payload_bytes)
        compressed = zlib.compress(payload_bytes, level=DEFAULT_COMPRESSION_LEVEL)
        checksum = hashlib.sha256(compressed).hexdigest()

        return cls(
            record_id=record_id,
            data_type=data_type,
            schema_version=1,
            ontology_vector=ontology_vector or [2, 2, 2, 2, 2],
            compressed_payload=compressed,
            original_size=original_size,
            bxos_checksum=checksum,
            timestamp_ns=time.time_ns()
        )

    def unpack(self) -> Any:
        """Распаковывает контейнер с проверкой целостности по BXOS-хэшу."""
        current_checksum = hashlib.sha256(self.compressed_payload).hexdigest()
        if current_checksum != self.bxos_checksum:
            raise ValueError(f"[-] КРИТИЧЕСКАЯ ОШИБКА: Нарушение целостности данных для ID {self.record_id}!")

        raw_bytes = zlib.decompress(self.compressed_payload)

        if self.data_type in ("json_orderbook", "json"):
            return json.loads(raw_bytes.decode("utf-8"))
        elif self.data_type == "text_log":
            return raw_bytes.decode("utf-8")
        elif self.data_type == "tensor_ticks":
            header_len = int.from_bytes(raw_bytes[:4], byteorder="big")
            header = json.loads(raw_bytes[4:4+header_len].decode("utf-8"))
            array_bytes = raw_bytes[4+header_len:]
            return np.frombuffer(array_bytes, dtype=header["dtype"]).reshape(header["shape"])
        else:
            return raw_bytes


class TypeAgnosticStore:
    """
    Персистентный движок тип-независимого хранения. Позволяет боту сохранять 
    и мгновенно находить любые рыночные данные без миграции схем БД.
    Защищен от Race Condition (threading.RLock) и повреждения индекса (атомарный os.replace).
    """
    def __init__(self, storage_dir: str = STORAGE_BUFFER_DIR):
        self.storage_dir = storage_dir
        os.makedirs(storage_dir, exist_ok=True)
        self.registry: Dict[str, Dict[str, Any]] = {}
        self.lock = threading.RLock()
        self._load_registry()

    def _get_file_path(self, record_id: str) -> str:
        safe_hash = hashlib.sha256(record_id.encode()).hexdigest()[:32]
        return os.path.join(self.storage_dir, f"{safe_hash}.bxos")

    def _load_registry(self):
        with self.lock:
            index_file = os.path.join(self.storage_dir, "_bot_store_index.json")
            if os.path.exists(index_file):
                try:
                    with open(index_file, "r", encoding="utf-8") as f:
                        self.registry = json.load(f)
                except Exception:
                    self.registry = {}

    def _save_registry(self):
        with self.lock:
            index_file = os.path.join(self.storage_dir, "_bot_store_index.json")
            tmp_file = f"{index_file}.tmp"
            
            with open(tmp_file, "w", encoding="utf-8") as f:
                json.dump(self.registry, f, ensure_ascii=False, indent=2)
            
            os.replace(tmp_file, index_file)

    def save(self, record_id: str, raw_data: Any, data_type: str = "json_orderbook", ontology_vector: List[int] = None) -> str:
        """Потокобезопасная упаковка и персистентное сохранение данных."""
        container = FinancialDataContainer.pack(record_id, raw_data, data_type, ontology_vector)
        file_path = self._get_file_path(record_id)

        payload_container = {
            "record_id": container.record_id,
            "data_type": container.data_type,
            "schema_version": container.schema_version,
            "ontology_vector": container.ontology_vector,
            "payload_b64": base64.b64encode(container.compressed_payload).decode("utf-8"),
            "original_size": container.original_size,
            "bxos_checksum": container.bxos_checksum,
            "timestamp_ns": container.timestamp_ns
        }

        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(payload_container, f)

        with self.lock:
            self.registry[record_id] = {
                "file_path": file_path,
                "data_type": container.data_type,
                "ontology_vector": container.ontology_vector,
                "bxos_checksum": container.bxos_checksum
            }
            self._save_registry()

        return container.bxos_checksum

    def load(self, record_id: str) -> Any:
        """Потокобезопасная загрузка и восстановление объекта по ID."""
        with self.lock:
            if record_id not in self.registry:
                raise KeyError(f"Запись {record_id} отсутствует в хранилище финансового бота.")
            meta = self.registry[record_id]
        
        with open(meta["file_path"], "r", encoding="utf-8") as f:
            d = json.load(f)

        container = FinancialDataContainer(
            record_id=d["record_id"],
            data_type=d["data_type"],
            schema_version=d["schema_version"],
            ontology_vector=d["ontology_vector"],
            compressed_payload=base64.b64decode(d["payload_b64"]),
            original_size=d["original_size"],
            bxos_checksum=d["bxos_checksum"],
            timestamp_ns=d.get("timestamp_ns", time.time_ns())
        )
        return container.unpack()


