class BXOSReceiptGenerator:
    """Генератор криптографических аудиторских квитанций с цифровой подписью."""
    
    @classmethod
    def generate(cls, record_id: str, operation: str, payload_summary: Dict[str, Any]) -> Dict[str, Any]:
        body = {
            "record_id": record_id,
            "operation": operation,
            "timestamp_ns": time.time_ns(),
            "payload_digest": hashlib.sha256(str(payload_summary).encode()).hexdigest(),
            "authority_signature": MASTER_AUTHORITY_SIGNATURE
        }
        serialized = json.dumps(body, sort_keys=True).encode()
        body["bxos_receipt_hash"] = hashlib.sha256(serialized).hexdigest()
        return body


class DataCenterNode:
    """
    Магистральный Дата-Центр (ЦОД). Принимает зашифрованные пакеты через ВОЛС,
    проверяет их целостность по BXOS-хэшу, логирует транзит и маршрутизирует дальше.
    """
    def __init__(self, dc_id: str = "DC-FINANCIAL-CORE-01"):
        self.dc_id = dc_id
        self.transit_log: List[Dict[str, Any]] = []
        os.makedirs(DATACENTER_BUFFER_DIR, exist_ok=True)

    def process_incoming_transmission(self, record_id: str, compressed_payload: bytes, expected_checksum: str, destination_node: str) -> Dict[str, Any]:
        current_hash = hashlib.sha256(compressed_payload).hexdigest()
        if current_hash != expected_checksum:
            raise ValueError(f"[-] КРИТИЧЕСКАЯ ОШИБКА В ЦОДЕ {self.dc_id}: Несоответствие BXOS-хэша для записи {record_id}!")

        buffer_file = os.path.join(DATACENTER_BUFFER_DIR, f"{record_id}_transit.bin")
        with open(buffer_file, "wb") as f:
            f.write(compressed_payload)

        transit_record = {
            "dc_id": self.dc_id,
            "record_id": record_id,
            "transit_timestamp_ns": time.time_ns(),
            "payload_size_bytes": len(compressed_payload),
            "bxos_checksum": expected_checksum,
            "status": "ROUTED_AND_VERIFIED",
            "destination": destination_node
        }
        self.transit_log.append(transit_record)
        return transit_record


class OpticalTransportLayerV23:
    """Симулятор ВОЛС (волоконно-оптической линии связи) с прохождением через Дата-Центр."""
    def __init__(self, data_center: DataCenterNode):
        self.dc = data_center

    def transmit_via_dc(self, record_id: str, compressed_payload: bytes, checksum: str, destination_node: str, distance_km: float = 250.0) -> Dict[str, Any]:
        return self.dc.process_incoming_transmission(record_id, compressed_payload, checksum, destination_node)


