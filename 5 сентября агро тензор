from typing import Dict, Any, List
from dataclasses import dataclass
from enum import Enum

class Ternary(Enum):
    FALSE = -1
    UNDEFINED = 0
    TRUE = 1

@dataclass
class TargetEntity:
    entity_id: str
    object_type: str  # "slug", "aphid", "bee", "earthworm"
    confidence: float
    moisture_content: float
    surface_velocity: float
    x: float
    y: float

class BioRashomonEngine:
    """Двойной контур Рашимона для проверки безопасности биоты и оценки угрозы."""
    PROTECTED_SPECIES = {"bee", "earthworm", "ladybug", "pollinator"}

    def analyze_target(self, target: TargetEntity, system_energy_reserve: float) -> str:
        # Внешний контур: защита полезной фауны и проверка порога уверенности
        if target.object_type in self.PROTECTED_SPECIES or target.confidence < 0.85:
            return "NO_GO_PROTECTED_BIOTA"

        # Внутренний контур: расчет индекса угрозы и энергетического баланса
        threat_index = target.moisture_content * 0.6 + (1.0 - target.surface_velocity) * 0.4
        system_index = system_energy_reserve * threat_index

        if system_index > 0.55:
            return "GO_STRIKE"
        elif system_index > 0.3:
            return "REVISE_LOW_POWER"
        else:
            return "NO_GO_INEFFICIENT"

class PhasedArrayStriker:
    """Управление фазами излучателей решетки для точечной волновой нейтрализации."""
    def __init__(self, elements_count: int = 64):
        self.elements_count = elements_count

    def compute_and_strike(self, target_coords: tuple, moisture: float, power_multiplier: float = 1.0) -> Dict[str, Any]:
        # Расчет фазовых задержек для фокусировки энергии строго в точке (x, y) вредителя
        focus_energy = 1.05 * (1.0 + moisture * 0.2) * power_multiplier
        return {
            "status": "TARGET_NEUTRALIZED",
            "method": "FOCUSED_PHASED_ARRAY_RESONANCE",
            "energy_delivered_joules": round(focus_energy * 15.0, 2),
            "target_position": target_coords,
            "execution_time_ms": 3.8
        }

class UnifiedAgroTensorPipeline:
    """Единый конвейер: Сканирование -> Био-Рашимон -> Селективное действие ФАР."""
    def __init__(self, elements_count: int = 64):
        self.bio_rashomon = BioRashomonEngine()
        self.striker = PhasedArrayStriker(elements_count)

    def process_field_frame(self, targets: List[TargetEntity], energy_reserve: float) -> List[Dict[str, Any]]:
        operational_log = []
        
        for target in targets:
            # Шаг 1: Проверка через двойной контур Рашимона
            verdict = self.bio_rashomon.analyze_target(target, energy_reserve)
            
            # Шаг 2: Исполнительная реакция фазированной решетки
            if verdict == "GO_STRIKE":
                strike_report = self.striker.compute_and_strike(
                    target_coords=(target.x, target.y),
                    moisture=target.moisture_content,
                    power_multiplier=1.0
                )
                operational_log.append({
                    "entity_id": target.entity_id,
                    "type": target.object_type,
                    "rashomon_verdict": verdict,
                    "action": "DESTROYED_INSTANTLY",
                    "details": strike_report
                })
            elif verdict == "REVISE_LOW_POWER":
                strike_report = self.striker.compute_and_strike(
                    target_coords=(target.x, target.y),
                    moisture=target.moisture_content,
                    power_multiplier=0.5
                )
                operational_log.append({
                    "entity_id": target.entity_id,
                    "type": target.object_type,
                    "rashomon_verdict": verdict,
                    "action": "SUPPRESSED_LOW_POWER",
                    "details": strike_report
                })
            else:
                # Импортная защита: полезные организмы не трогаем
                operational_log.append({
                    "entity_id": target.entity_id,
                    "type": target.object_type,
                    "rashomon_verdict": verdict,
                    "action": "PRESERVED_AND_SKIPPED",
                    "details": {"status": "IMMUNE", "position": (target.x, target.y)}
                })
                
        return operational_log

