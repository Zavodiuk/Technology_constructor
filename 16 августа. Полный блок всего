class PentarnySystem:
    def __init__(self, value: int):
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно быть в диапазоне от -2 до 2")
        self.value = value
        self.mask = MASKS[value]
    
    def as_logic(self) -> str:
        states = {2: "Истина", 1: "Вероятность", 0: "Тождество / Баланс", -1: "Сомнение", -2: "Ложь"}
        return states[self.value]
    
    def as_psychology(self) -> str:
        states = {2: "Мания / Действие", 1: "Интерес", 0: "Рефлексия / Покой", -1: "Апатия / Сомнение", -2: "Депрессия / Отказ"}
        return states[self.value]
    
    def as_physics(self) -> str:
        states = {2: "Гребень волны (Максимум)", 1: "Восходящий фронт", 0: "Узел покоя", -1: "Спад", -2: "Впадина (Минимум)"}
        return states[self.value]
    
    def as_sociology(self) -> str:
        states = {2: "Инвестиция / Эмиссия", 1: "Рост рынка", 0: "Стабилизация", -1: "Рецессия", -2: "Кризис / Сток"}
        return states[self.value]
    
    def as_economics(self) -> str:
        states = {2: "Бум / Перегрев", 1: "Рост", 0: "Стагнация", -1: "Спад", -2: "Дефолт / Обвал"}
        return states[self.value]
    
    def as_energy(self) -> str:
        states = {2: "Максимум энергии", 1: "Высокий потенциал", 0: "Нейтраль", -1: "Низкий потенциал", -2: "Минимум энергии"}
        return states[self.value]
    
    def as_ethics(self) -> str:
        states = {2: "Добро / Справедливость", 1: "Сочувствие", 0: "Нейтральность", -1: "Сомнение в морали", -2: "Зло / Несправедливость"}
        return states[self.value]
    
    def get_all_interpretations(self) -> dict:
        return {
            "logic": self.as_logic(),
            "psychology": self.as_psychology(),
            "physics": self.as_physics(),
            "sociology": self.as_sociology(),
            "economics": self.as_economics(),
            "energy": self.as_energy(),
            "ethics": self.as_ethics()
        }
    
    def strength(self) -> float:
        return abs(self.value) / 2.0
    
    def sign(self) -> int:
        return 1 if self.value > 0 else (-1 if self.value < 0 else 0)
    
    def is_positive(self) -> bool:
        return self.value > 0
    
    def is_negative(self) -> bool:
        return self.value < 0
    
    def is_zero(self) -> bool:
        return self.value == 0
    
    def is_extreme(self) -> bool:
        return abs(self.value) == 2
    
    def invert(self) -> 'PentarnySystem':
        return PentarnySystem(-self.value)
    
    def __add__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        result = self.value + other.value
        return PentarnySystem(max(-2, min(2, result)))
    
    def __sub__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        result = self.value - other.value
        return PentarnySystem(max(-2, min(2, result)))
    
    def __mul__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        result = self.value * other.value
        return PentarnySystem(max(-2, min(2, result)))
    
    def __truediv__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        if other.value == 0:
            raise ZeroDivisionError("Деление на ноль в пентарной логике")
        result = int(self.value / other.value)
        return PentarnySystem(max(-2, min(2, result)))
    
    def __repr__(self):
        return f"PentarnySystem({self.value})"
    
    def __str__(self):
        return f"{self.value} → {self.mask}"
    
    def __eq__(self, other):
        if not isinstance(other, PentarnySystem):
            return False
        return self.value == other.value
    
    def __lt__(self, other):
        if not isinstance(other, PentarnySystem):
            return False
        return self.value < other.value
    
    def __gt__(self, other):
        if not isinstance(other, PentarnySystem):
            return False
        return self.value > other.value
    
    def to_vector(self) -> list:
        vec = [0, 0, 0, 0, 0]
        vec[self.value + 2] = 1
        return vec
    
    def distance_to(self, other: 'PentarnySystem') -> int:
        return abs(self.value - other.value)


def quantize_pentarny(value: float) -> int:
    if value > 0.75:
        return 2
    elif value > 0.25:
        return 1
    elif value >= -0.25:
        return 0
    elif value >= -0.75:
        return -1
    else:
        return -2


def pentarny_consensus(values: list) -> int:
    if not values:
        return 0
    return quantize_pentarny(sum(values) / len(values))


def pentarny_majority(values: list) -> int:
    if not values:
        return 0
    return Counter(values).most_common(1)[0][0]


