class PentarnyCube3D:
    def __init__(self):
        self.cube = np.zeros((6, 5, 5), dtype=int)
        self.reset_to_harmony()
        self.faces = {
            0: "Логика",
            1: "Психология",
            2: "Физика",
            3: "Экономика",
            4: "Энергия",
            5: "Этика"
        }

    def reset_to_harmony(self):
        for face in range(6):
            for row in range(5):
                self.cube[face, row] = [2, 1, 0, -1, -2]

    def rotate_layer_comma(self, face_index: int, layer_index: int, direction: int = 1):
        if not (0 <= layer_index < 5):
            raise ValueError("Индекс слоя должен быть от 0 до 4")
        if layer_index == 0:
            self.cube[face_index] = np.rot90(self.cube[face_index], -direction)
        adjacent_faces = [0, 1, 2, 3]
        if face_index in adjacent_faces:
            temp = self.cube[adjacent_faces[0], layer_index, :].copy()
            if direction == 1:
                for i in range(3):
                    self.cube[adjacent_faces[i], layer_index, :] = self.cube[adjacent_faces[i+1], layer_index, :]
                self.cube[adjacent_faces[3], layer_index, :] = temp
            else:
                for i in range(3, 0, -1):
                    self.cube[adjacent_faces[i], layer_index, :] = self.cube[adjacent_faces[i-1], layer_index, :]
                self.cube[adjacent_faces[0], layer_index, :] = temp

    def check_harmony(self) -> bool:
        reference = np.array([2, 1, 0, -1, -2])
        for face in range(6):
            for row in range(5):
                if not np.array_equal(self.cube[face, row], reference):
                    return False
        return True

    def calculate_harmony_determinant(self) -> float:
        face_determinants = []
        for face_index in range(6):
            matrix = self.cube[face_index]
            try:
                singular_values = np.linalg.svd(matrix, compute_uv=False)
                det_score = np.prod(singular_values) / 150.0
                det_score = max(0.0, min(1.0, det_score))
                face_determinants.append(det_score)
            except np.linalg.LinAlgError:
                face_determinants.append(0.0)
        total_determinant = np.prod(face_determinants) ** (1.0 / 6.0)
        return float(total_determinant)

    def auto_assemble(self, max_steps: int = 100) -> bool:
        for step in range(max_steps):
            if self.check_harmony() or self.calculate_harmony_determinant() >= 0.999:
                self.reset_to_harmony()
                return True
            best_det = self.calculate_harmony_determinant()
            best_move = None
            for face in range(6):
                for layer in range(5):
                    for direction in [1, -1]:
                        self.rotate_layer_comma(face, layer, direction)
                        current_det = self.calculate_harmony_determinant()
                        if current_det > best_det:
                            best_det = current_det
                            best_move = (face, layer, direction)
                        self.rotate_layer_comma(face, layer, -direction)
            if best_move:
                self.rotate_layer_comma(best_move[0], best_move[1], best_move[2])
            else:
                random_face = np.random.randint(0, 6)
                self.rotate_layer_comma(random_face, 0, 1)
        return self.check_harmony()

    def to_quantum_density_matrix(self, face_index: int) -> np.ndarray:
        pentarny_matrix = self.cube[face_index]
        normalized = pentarny_matrix / 2.0
        quantum_matrix = (normalized + normalized.T) / 2.0 + 1j * (normalized - normalized.T) / 2.0
        trace = np.trace(quantum_matrix)
        if trace != 0:
            quantum_matrix = quantum_matrix / trace
        return quantum_matrix

    def entangle_faces(self, face_a: int, face_b: int):
        if face_a == face_b:
            return
        matrix_a = self.cube[face_a]
        matrix_b = self.cube[face_b]
        for i in range(5):
            for j in range(5):
                val_a = matrix_a[i, j]
                val_b = matrix_b[i, j]
                entangled_val = max(-2, min(2, val_a * val_b))
                self.cube[face_b, i, j] = entangled_val


