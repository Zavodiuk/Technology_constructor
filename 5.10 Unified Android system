# 3. ТЕНЗОРНОЕ ПОЛЕ ПАМЯТИ И ВОЛНОВАЯ ДИФФУЗИЯ
# ============================================================================
class AndroidTensorMemoryField:
    """Многомерное тензорное поле оперативной памяти для распределения кэша."""
    def __init__(self, dimensions: tuple = (3, 3, 3)):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=int)

    def inject_impulse(self, coordinates: tuple, value: int):
        clipped = max(-2, min(2, value))
        if all(0 <= coordinates[i] < self.dimensions[i] for i in range(len(self.dimensions))):
            self.field[coordinates] = clipped

    def calculate_entropy(self) -> float:
        total = self.field.size
        if total == 0:
            return 0.0
        active_states = np.sum(np.abs(self.field) > 0)
        return float(active_states / total)


class AndroidWaveMemoryEvolution:
    """Модуль волнового распространения импульсов нагрузки в памяти устройства."""
    def __init__(self, tensor_memory: AndroidTensorMemoryField):
        self.tensor_memory = tensor_memory

    def propagate_wave(self, origin: tuple, radius: int = 1):
        dims = len(origin)
        ranges = [range(max(0, origin[d] - radius), 
                       min(self.tensor_memory.dimensions[d], origin[d] + radius + 1)) 
                  for d in range(dims)]
        for coords in product(*ranges):
            dist = sum(abs(coords[d] - origin[d]) for d in range(dims))
            if 0 < dist <= radius:
                orig_val = int(self.tensor_memory.field[origin])
                float_val = float(orig_val) / (dist + 1)
                impulse = int(round(float_val))
                if impulse != 0:
                    current = int(self.tensor_memory.field[coords])
                    self.tensor_memory.field[coords] = max(-2, min(2, current + impulse))


