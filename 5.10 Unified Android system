class Ternary(Enum):
    """Троично-пентарная логика системных векторов [-1, 0, 1]."""
    FALSE = -1       # Критическое отклонение / Блокировка (NO_GO)
    UNDEFINED = 0    # Зона пограничной энтропии (REVISE)
    TRUE = 1         # Штатное стабильное состояние (GO)


