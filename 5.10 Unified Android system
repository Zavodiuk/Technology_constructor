# 5. МОДУЛЬ ПЕРСИСТЕНТНОСТИ И СЖАТИЯ ДЕЛЬТ (ZLIB)
# ============================================================================
class AndroidDeltaLedgerPersistence:
    """Модуль сжатия и персистентности дельт памяти и телеметрии в бинарный архив."""
    @staticmethod
    def pack_and_compress(ledger_data: list, filename: str) -> int:
        json_str = json.dumps(ledger_data, ensure_ascii=False)
        compressed_data = zlib.compress(json_str.encode('utf-8'), level=9)
        with open(filename, 'wb') as f:
            f.write(compressed_data)
        return len(compressed_data)

    @staticmethod
    def decompress_and_unpack(filename: str) -> list:
        with open(filename, 'rb') as f:
            compressed_data = f.read()
        json_str = zlib.decompress(compressed_data).decode('utf-8')
        return json.loads(json_str)


