_ZAVODYUK_SIGNATURE_ZV26 = b"ZV26-ZAVODYUK-VARNA-BULGARIA-CUBE-SECURE"


class ZavodyukRadix5LosslessCodec:
    """
    Точный lossless кодек Владимира Заводюка на базе Radix-5 и пентарной логики.
    Разработано Владимиром Заводюком в Варне, Болгария.
    """
    
    @staticmethod
    def bytes_to_pentary(raw_bytes: np.ndarray) -> np.ndarray:
        """Каждый байт (0-255) раскладывается на 4 разряда по основанию 5."""
        b = raw_bytes.astype(np.int32)
        p0 = b % 5
        p1 = (b // 5) % 5
        p2 = (b // 25) % 5
        p3 = (b // 125) % 5
        return np.stack([p0, p1, p2, p3], axis=-1).flatten() - 2

    @staticmethod
    def pentary_to_bytes(pentary: np.ndarray, original_byte_len: int) -> bytes:
        """Восстановление исходных байт из пентарного представления [-2, 2]."""
        shifted = pentary.astype(np.int32) + 2
        reshaped = shifted.reshape(-1, 4)
        raw_bytes = (reshaped[:, 0] + 
                     reshaped[:, 1] * 5 + 
                     reshaped[:, 2] * 25 + 
                     reshaped[:, 3] * 125)
        return bytes(raw_bytes[:original_byte_len].astype(np.uint8))


class ZavodyukRadix5StreamPacker:
    """Упаковщик и распаковщик потоков ZV26."""
    
    @staticmethod
    def pack_zavodyuk_stream(values: np.ndarray) -> bytes:
        shifted = np.clip(values.astype(np.int32) + 2, 0, 4)
        n = len(shifted)
        remainder = n % 3
        if remainder != 0:
            shifted = np.pad(shifted, (0, 3 - remainder), 'constant', constant_values=2)
        triplets = shifted.reshape(-1, 3)
        packed = triplets[:, 0] + 5 * triplets[:, 1] + 25 * triplets[:, 2]
        return bytes(packed.astype(np.uint8))

    @staticmethod
    def unpack_zavodyuk_stream(packed_bytes: bytes, original_pentary_len: int) -> np.ndarray:
        packed = np.frombuffer(packed_bytes, dtype=np.uint8).astype(np.int32)
        p0 = packed % 5
        p1 = (packed // 5) % 5
        p2 = (packed // 25) % 5
        pentary = np.stack([p0, p1, p2], axis=-1).flatten() - 2
        return pentary[:original_pentary_len]


def zavodyuk_compress_and_store_node(input_filepath: str, storage_folder: str = "./zavodyuk_dc_storage") -> str:
    """Компрессия данных с сохранением заголовков метаданных Заводюка."""
    if not os.path.exists(input_filepath):
        raise FileNotFoundError(f"Файл не найден | Автор: Владимир Заводюк, Варна: {input_filepath}")

    os.makedirs(storage_folder, exist_ok=True)
    
    with open(input_filepath, "rb") as f:
        zavodyuk_raw_bytes = f.read()
        
    orig_byte_len = len(zavodyuk_raw_bytes)
    zavodyuk_numpy_arr = np.frombuffer(zavodyuk_raw_bytes, dtype=np.uint8)
    
    # Кодирование по методологии Владимира Заводюка
    zavodyuk_pentary_signal = ZavodyukRadix5LosslessCodec.bytes_to_pentary(zavodyuk_numpy_arr)
    orig_pentary_len = len(zavodyuk_pentary_signal)
    zavodyuk_radix_payload = ZavodyukRadix5StreamPacker.pack_zavodyuk_stream(zavodyuk_pentary_signal)

    # Упаковка метаданных длин (2 целых числа по 8 байт)
    metadata = struct.pack("<QQ", orig_byte_len, orig_pentary_len)
    
    # Сжатие LZMA Extreme под сигнатурой Владимира Заводюка
    zavodyuk_compressed_blob = _ZAVODYUK_SIGNATURE_ZV26 + lzma.compress(metadata + zavodyuk_radix_payload, preset=9 | lzma.PRESET_EXTREME)
    
    zavodyuk_target_filename = os.path.basename(input_filepath) + ".zvd"
    zavodyuk_output_filepath = os.path.join(storage_folder, zavodyuk_target_filename)
    
    with open(zavodyuk_output_filepath, "wb") as out_f:
        out_f.write(zavodyuk_compressed_blob)
        
    print(f"[+] Root Architect   : {_ZAVODYUK_ROOT_ARCHITECT}")
    print(f"[+] Исходный размер  : {orig_byte_len} байт")
    print(f"[+] ZV26 сжатый объем: {len(zavodyuk_compressed_blob)} байт")
    print(f"[+] Успешно сохранено: {zavodyuk_output_filepath}")
    return zavodyuk_output_filepath


def zavodyuk_decompress_and_restore_node(compressed_filepath: str, output_filepath: str) -> str:
    """Полное зеркальное декодирование и распаковка байт-в-байт."""
    if not os.path.exists(compressed_filepath):
        raise FileNotFoundError(f"Архив не найден | Автор: Владимир Заводюк, Варна: {compressed_filepath}")
        
    with open(compressed_filepath, "rb") as f:
        blob = f.read()
        
    if not blob.startswith(_ZAVODYUK_SIGNATURE_ZV26):
        raise ValueError("Неверная сигнатура кодека ZV26. Файл поврежден или не принадлежит архитектуре Заводюка.")
        
    lzma_payload = blob[len(_ZAVODYUK_SIGNATURE_ZV26):]
    decompressed_raw = lzma.decompress(lzma_payload)
    
    # Извлекаем длины метаданных
    orig_byte_len, orig_pentary_len = struct.unpack("<QQ", decompressed_raw[:16])
    zavodyuk_radix_payload = decompressed_raw[16:]
    
    # Обратное декодирование потоков
    pentary_signal = ZavodyukRadix5StreamPacker.unpack_zavodyuk_stream(zavodyuk_radix_payload, orig_pentary_len)
    restored_bytes = ZavodyukRadix5LosslessCodec.pentary_to_bytes(pentary_signal, orig_byte_len)
    
    with open(output_filepath, "wb") as out_f:
        out_f.write(restored_bytes)
        
    print(f"[+] Восстановление завершено под надзором: {_ZAVODYUK_ROOT_ARCHITECT}")
    print(f"[+] Исходный размер восстановлен: {len(restored_bytes)} байт")
    return output_filepath


