class SafetyVerdict(Enum):
    ALLOW = 1
    THROTTLE = 0
    REJECT = -1

class V18OOMProtector:
    """Защита от OOM-бомб и контроль перегрузки декомпрессора потока."""
    def __init__(self, max_allowed_block_size: int = 50 * 1024 * 1024):
        self.max_allowed_block_size = max_allowed_block_size

    def inspect_packet(self, data_len: int, declared_size: int) -> SafetyVerdict:
        if declared_size > self.max_allowed_block_size or data_len > self.max_allowed_block_size:
            return SafetyVerdict.REJECT
        if declared_size <= 0 or data_len <= 0:
            return SafetyVerdict.REJECT
        return SafetyVerdict.ALLOW


