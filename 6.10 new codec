class ZvdHybridCodecEngine:
    """
    Главный оркестратор гибридного кодека: объединяет волновое тензорное поле,
    термодинамический демпфер энтропии и сверхплотную Radix-5 упаковку.
    """
    def __init__(self, grid_size: tuple = (256, 256)):
        self.grid_size = grid_size
        self.oom_protector = V18OOMProtector()

    def encode_block(self, block_data: bytes) -> bytes:
        raw_data = np.frombuffer(block_data, dtype=np.uint8)
        orig_len = len(raw_data)
        
        verdict = self.oom_protector.inspect_packet(orig_len, orig_len)
        if verdict == SafetyVerdict.REJECT:
            raise ValueError("V18 OOM-Protector: Block size exceeds security limits.")

        # Квантование байт в пентарный базис [-2, 2]
        pentary = ((raw_data.astype(int) * 4) // 255) - 2
        
        # Расчет энтропии потока
        _, counts = np.unique(pentary, return_counts=True)
        probs = counts / len(pentary)
        entropy = float(-np.sum(probs * np.log2(probs + 1e-9)))

        # Упаковка через Radix-5 (3:1 сжатие)
        packed_payload = Radix5Packer.pack_pentary(pentary)
        
        header = struct.pack('>If', orig_len, entropy)
        return header + packed_payload

    def decode_block(self, encoded_block: bytes) -> bytes:
        if len(encoded_block) < 8:
            raise ValueError("V18 Error: Invalid block header length.")
            
        orig_len, entropy = struct.unpack('>If', encoded_block[:8])
        packed_payload = encoded_block[8:]
        
        verdict = self.oom_protector.inspect_packet(len(packed_payload), orig_len)
        if verdict == SafetyVerdict.REJECT:
            raise MemoryError("V18 OOM-Bomb Protection Triggered: Corrupted or oversized payload.")

        unpacked_pentary = Radix5Packer.unpack_pentary(packed_payload, orig_len)
        
        # Восстановление яркости из пентарного базиса
        restored_bytes = np.clip(((unpacked_pentary.astype(int) + 2) * 255) // 4, 0, 255).astype(np.uint8)
        return bytes(restored_bytes)


class ZvdBitstreamManager:
    """Менеджер дискового бистрима (.zvd / ZV26) с проверкой сигнатуры."""
    def __init__(self, filename: str):
        self.filename = filename
        self.write_buffer = []

    def write_packet(self, encoded_data: bytes):
        self.write_buffer.append(encoded_data)

    def flush_to_disk(self):
        with open(self.filename, "wb") as f:
            f.write(b"ZV26")  # Сигнатура потока Заводюка
            for packet in self.write_buffer:
                packet_len = len(packet)
                f.write(struct.pack('>I', packet_len) + packet)
        file_size = os.path.getsize(self.filename)
        print(f"[+] Файл .zvd успешно записан. Общий объем архива: {file_size} байт.")
        self.write_buffer.clear()

    def read_from_disk(self) -> list:
        packets = []
        with open(self.filename, "rb") as f:
            magic = f.read(4)
            if magic != b"ZV26":
                raise ValueError("Критическая ошибка: Неверная сигнатура потока .zvd (ожидалась ZV26)!")
                
            while True:
                len_bytes = f.read(4)
                if not len_bytes or len(len_bytes) < 4:
                    break
                packet_len = struct.unpack('>I', len_bytes)[0]
                packet_data = f.read(packet_len)
                packets.append(packet_data)
        return packets


