# RADIX-5 ПЕНТАРНЫЙ УПАКОВЩИК (СЖАТИЕ БЕЗ ПОТЕРЬ 3:1)
# ============================================================================
class Radix5Packer:
    """
    Математическая упаковка 3 пентарных значений [-2, 2] (смещенных в [0, 4]) 
    в 1 байт (5^3 = 125 <= 256). Плотность потока возрастает ровно в 3 раза.
    """
    @staticmethod
    def pack_pentary(values: np.ndarray) -> bytes:
        shifted = np.clip(values.astype(np.int32) + 2, 0, 4)
        n = len(shifted)
        remainder = n % 3
        if remainder != 0:
            pad_len = 3 - remainder
            shifted = np.pad(shifted, (0, pad_len), 'constant', constant_values=2) # 2 соответствует 0
        
        triplets = shifted.reshape(-1, 3)
        packed = triplets[:, 0] + 5 * triplets[:, 1] + 25 * triplets[:, 2]
        return bytes(packed.astype(np.uint8))

    @staticmethod
    def unpack_pentary(packed_bytes: bytes, original_length: int) -> np.ndarray:
        raw = np.frombuffer(packed_bytes, dtype=np.uint8)
        if len(raw) == 0:
            return np.array([], dtype=int)
        
        c = raw // 25
        b = (raw % 25) // 5
        a = raw % 5
        
        unpacked = np.column_stack((a, b, c)).flatten()
        result = (unpacked[:original_length] - 2).astype(int)
        return result


