@dataclass
class OrchestratorRequest:
    """Запрос к оркестратору"""
    query: str
    request_type: RequestType
    interpretations: Dict[str, float]  # {name: confidence}
    priority: int = 0  # 0 = normal, 1+ = urgent


@dataclass
class OrchestratorResponse:
    """Ответ от оркестратора"""
    success: bool
    request_type: RequestType
    selected_component: ComponentType
    component_response: Dict[str, Any]
    latency_ms: float
    quality_score: float
    cached: bool = False


class OrchestratorV6:
    """
    Главный маршрутизатор V6
    
    ФУНКЦИИ:
    1. L3-анализ запроса (-1, 0, 1)
    2. Выбор компонента по истории успехов
    3. API маршрутизация
    4. Оптимизация скорости (кэширование, батчинг)
    5. Сохранение состояний в Block X
    """
    
    def __init__(self):
        self.registry = ComponentRegistry()
        self.history = SuccessHistory()
        self.processor = FastProcessor(cache_size=10000, batch_size=20)
        self.blockchain = StateBlockchain()
        
        self.request_counter = 0
        self.start_time = time.time()
        self.lock = threading.Lock()
    
    def _log(self, msg: str):
        """Логирование"""
        elapsed = time.time() - self.start_time
        print(f"[OrchestratorV6 {elapsed:.1f}s] {msg}")
    
    # ---- МАРШРУТИЗАЦИЯ ----
    
    def _map_request_type(self, query: str, interpretations: Dict[str, float]) -> RequestType:
        """
        Определить тип запроса на основе L3 логики
        
        Анализируем avg confidence:
        > 0.7  → TRUE   → DECISION/COMBINED
        0.3-0.7 → UNDEFINED → CONSENSUS/LEARNING
        < 0.3  → FALSE  → ANALYSIS
        """
        if not interpretations:
            return RequestType.ANALYSIS
        
        avg_confidence = sum(interpretations.values()) / len(interpretations)
        
        if avg_confidence > 0.7:
            return RequestType.DECISION  # уверены в выборе
        elif avg_confidence > 0.5:
            return RequestType.CONSENSUS  # нужно согласие
        elif avg_confidence > 0.3:
            return RequestType.LEARNING  # нужна защита
        else:
            return RequestType.ANALYSIS  # неуверены, анализируем
    
    def _select_component(self, request_type: RequestType) -> ComponentType:
        """
        Выбрать компонент по типу запроса и истории успехов
        
        Маппинг:
        DECISION → Game Engine (выбор лучше всего делает)
        CONSENSUS → Byzantine Consensus
        LEARNING → Learning Guard
        TRAJECTORY → Hyperbolic Graph
        ANALYSIS → Lomonosov Spiral
        """
        type_to_component = {
            RequestType.DECISION: ComponentType.GAME_ENGINE,
            RequestType.CONSENSUS: ComponentType.CONSENSUS,
            RequestType.LEARNING: ComponentType.LEARNING_GUARD,
            RequestType.TRAJECTORY: ComponentType.HYPERBOLIC_GRAPH,
            RequestType.ANALYSIS: ComponentType.LOMONOSOV_SPIRAL,
            RequestType.COMBINED: ComponentType.INTEGRATION,
        }
        
        default_component = type_to_component[request_type]
        
        # Проверяем историю успехов
        best_component = self.history.get_best_component(request_type)
        
        if best_component and self.registry.is_available(best_component):
            self._log(f"✅ Выбран компонент по истории: {best_component.value}")
            return best_component
        
        # Резервный вариант
        self._log(f"📌 Выбран компонент по умолчанию: {default_component.value}")
        return default_component
    
    # ---- ОБРАБОТКА ЗАПРОСА ----
    
    def route_request(self, orchestrator_request: OrchestratorRequest) -> Optional[OrchestratorResponse]:
        """
        Главный метод маршрутизации
        
        Архитектура:
        1. Определить тип запроса (L3-анализ)
        2. Выбрать компонент (по истории)
        3. Проверить кэш
        4. Вызвать API компонента
        5. Сохранить результат в Block X
        6. Записать метрики
        """
        with self.lock:
            self.request_counter += 1
            request_id = self.request_counter
        
        start_time = time.time()
        self._log(f"\n{'='*60}")
        self._log(f"REQUEST #{request_id}: {orchestrator_request.query}")
        self._log(f"{'='*60}")
        
        try:
            # 1. ОПРЕДЕЛИТЬ ТИП ЗАПРОСА
            request_type = self._map_request_type(
                orchestrator_request.query,
                orchestrator_request.interpretations
            )
            self._log(f"📍 Тип запроса: {request_type.value}")
            
            # 2. ВЫБРАТЬ КОМПОНЕНТ
            component = self._select_component(request_type)
            endpoint = self.registry.get_endpoint(component)
            
            if not endpoint:
                self._log(f"❌ Компонент не зарегистрирован: {component.value}")
                return None
            
            # 3. ПРОВЕРИТЬ КЭШ (оптимизация скорости)
            request_payload = {
                'query': orchestrator_request.query,
                'interpretations': orchestrator_request.interpretations
            }
            
            cached_response = self.processor.get_cached(request_payload, ttl_seconds=300.0)
            if cached_response:
                self._log(f"⚡ Результат найден в кэше!")
                latency_ms = 0.1
                
                return OrchestratorResponse(
                    success=True,
                    request_type=request_type,
                    selected_component=component,
                    component_response=cached_response,
                    latency_ms=latency_ms,
                    quality_score=0.9,
                    cached=True
                )
            
            # 4. ВЫЗВАТЬ API КОМПОНЕНТА
            self._log(f"🔗 Вызываем API: {component.value}")
            success, response, latency_ms = endpoint.call_endpoint('process', request_payload)
            
            if not success:
                self._log(f"❌ API ошибка: {response.get('error')}")
                self.history.record_call(component, request_type, False, latency_ms, quality_score=0.0)
                return None
            
            quality_score = response.get('quality_score', 0.5)
            
            # 5. СОХРАНИТЬ В BLOCK X
            request_hash = hashlib.sha256(
                json.dumps(request_payload, sort_keys=True).encode()
            ).hexdigest()[:16]
            
            state_block = self.blockchain.add_state(
                component=component,
                state={
                    'response': response,
                    'latency_ms': latency_ms,
                    'quality_score': quality_score
                },
                request_hash=request_hash
            )
            
            self._log(f"📦 Состояние сохранено в Block X #{state_block.index}")
            
            # 6. ЗАПИСАТЬ МЕТРИКИ
            self.history.record_call(
                component=component,
                request_type=request_type,
                success=True,
                latency_ms=latency_ms,
                quality_score=quality_score
            )
            
            self._log(f"✅ Обработка завершена (latency: {latency_ms:.1f}ms, quality: {quality_score:.2f})")
            
            # КЭШИРОВАТЬ РЕЗУЛЬТАТ
            self.processor.cache_response(request_payload, response)
            
            # ВОЗВРАЩАЕМ РЕЗУЛЬТАТ
            latency = (time.time() - start_time) * 1000
            
            return OrchestratorResponse(
                success=True,
                request_type=request_type,
                selected_component=component,
                component_response=response,
                latency_ms=latency,
                quality_score=quality_score,
                cached=False
            )
        
        except Exception as e:
            self._log(f"❌ КРИТИЧЕСКАЯ ОШИБКА: {e}")
            return None
    
    # ---- АДМИНИСТРИРОВАНИЕ ----
    
    def register_component(self, component_type: ComponentType, 
                          base_url: str, port: int,
                          endpoints: Dict[str, str]):
        """Зарегистрировать компонент V9"""
        endpoint = ComponentEndpoint(
            component_type=component_type,
            base_url=base_url,
            port=port,
            endpoints=endpoints
        )
        self.registry.register(endpoint)
        self._log(f"✅ Компонент зарегистрирован: {component_type.value} ({base_url}:{port})")
    
    def get_status(self) -> Dict[str, Any]:
        """Статус оркестратора"""
        return {
            'version': 'V6.0',
            'uptime_seconds': time.time() - self.start_time,
            'requests_processed': self.request_counter,
            'components_registered': len(self.registry.endpoints),
            'blockchain': self.blockchain.to_dict(),
            'history': self.history.to_dict(),
            'cache_size': len(self.processor.cache),
        }
    
    def get_metrics(self) -> Dict[str, Any]:
        """Детальные метрики"""
        return {
            'history': self.history.to_dict(),
            'blockchain_verified': self.blockchain.verify_chain(),
            'cache': {
                'size': len(self.processor.cache),
                'max_size': self.processor.cache_size
            }
        }


