@dataclass
class SuccessMetrics:
    """Метрики успеха для компонента"""
    component: ComponentType
    request_type: RequestType
    total_calls: int = 0
    successful_calls: int = 0
    avg_latency_ms: float = 0.0
    avg_quality_score: float = 0.5
    last_used: float = field(default_factory=time.time)
    
    @property
    def success_rate(self) -> float:
        """Процент успешных вызовов"""
        if self.total_calls == 0:
            return 0.5  # нейтральный по умолчанию
        return self.successful_calls / self.total_calls
    
    @property
    def priority_score(self) -> float:
        """Приоритет использования (0-1)"""
        # Факторы:
        # - success_rate (40%)
        # - speed (30%, меньше latency = выше)
        # - quality (20%)
        # - recency (10%, недавно использованные предпочтительнее)
        
        now = time.time()
        time_factor = 1.0 / (1.0 + (now - self.last_used) / 3600.0)  # экспоненциально затухает за часы
        
        score = (
            0.40 * self.success_rate +
            0.30 * (1.0 / (1.0 + self.avg_latency_ms / 100.0)) +  # быстрее = выше
            0.20 * self.avg_quality_score +
            0.10 * time_factor
        )
        return min(1.0, max(0.0, score))
    
    def to_dict(self) -> Dict:
        return {
            'component': self.component.value,
            'request_type': self.request_type.value,
            'total_calls': self.total_calls,
            'successful': self.successful_calls,
            'success_rate': round(self.success_rate, 3),
            'avg_latency_ms': round(self.avg_latency_ms, 1),
            'quality_score': round(self.avg_quality_score, 3),
            'priority_score': round(self.priority_score, 3)
        }


class SuccessHistory:
    """Умная история успехов для выбора компонентов"""
    
    def __init__(self, max_history: int = 10000):
        self.metrics: Dict[Tuple[ComponentType, RequestType], SuccessMetrics] = {}
        self.history_queue: deque = deque(maxlen=max_history)
        self.lock = threading.Lock()
    
    def record_call(self, 
                   component: ComponentType,
                   request_type: RequestType,
                   success: bool,
                   latency_ms: float,
                   quality_score: float = 0.5):
        """Записать результат вызова компонента"""
        with self.lock:
            key = (component, request_type)
            
            if key not in self.metrics:
                self.metrics[key] = SuccessMetrics(component, request_type)
            
            metrics = self.metrics[key]
            metrics.total_calls += 1
            if success:
                metrics.successful_calls += 1
            
            # Скользящее среднее для latency
            old_latency = metrics.avg_latency_ms
            metrics.avg_latency_ms = (old_latency * 0.7 + latency_ms * 0.3)
            
            # Скользящее среднее для качества
            old_quality = metrics.avg_quality_score
            metrics.avg_quality_score = (old_quality * 0.7 + quality_score * 0.3)
            
            metrics.last_used = time.time()
            
            # Добавляем в очередь истории
            self.history_queue.append({
                'component': component.value,
                'request_type': request_type.value,
                'success': success,
                'latency_ms': latency_ms,
                'quality': quality_score,
                'timestamp': time.time()
            })
    
    def get_best_component(self, request_type: RequestType) -> Optional[ComponentType]:
        """Найти компонент с наивысшим приоритетом для типа запроса"""
        with self.lock:
            candidates = [
                (metrics, metrics.priority_score)
                for (comp, req), metrics in self.metrics.items()
                if req == request_type
            ]
            
            if not candidates:
                return None
            
            best_metrics, _ = max(candidates, key=lambda x: x[1])
            return best_metrics.component
    
    def get_metrics(self, component: ComponentType, request_type: RequestType) -> Optional[SuccessMetrics]:
        """Получить метрики компонента"""
        return self.metrics.get((component, request_type))
    
    def to_dict(self) -> Dict:
        """Сохранить историю"""
        with self.lock:
            return {
                'metrics': {
                    f"{k[0].value}:{k[1].value}": v.to_dict()
                    for k, v in self.metrics.items()
                },
                'recent_history': list(self.history_queue)[-100:]  # последние 100
            }


