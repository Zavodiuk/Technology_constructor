# 4. FAST PROCESSOR (ОПТИМИЗАЦИЯ СКОРОСТИ)
# ============================================================

class FastProcessor:
    """Оптимизация обработки: кэширование, батчинг,预测"""
    
    def __init__(self, cache_size: int = 1000, batch_size: int = 10):
        self.cache: Dict[str, Tuple[Dict, float]] = {}  # {request_hash: (response, timestamp)}
        self.cache_size = cache_size
        self.batch_queue: List[Dict] = []
        self.batch_size = batch_size
        self.lock = threading.Lock()
    
    def _hash_request(self, request: Dict) -> str:
        """Хеш запроса для кэширования"""
        content = json.dumps(request, sort_keys=True)
        return hashlib.sha256(content.encode()).hexdigest()[:16]
    
    def get_cached(self, request: Dict, ttl_seconds: float = 60.0) -> Optional[Dict]:
        """Получить результат из кэша (если есть и не устарел)"""
        request_hash = self._hash_request(request)
        
        with self.lock:
            if request_hash in self.cache:
                response, timestamp = self.cache[request_hash]
                if (time.time() - timestamp) < ttl_seconds:
                    return response
                else:
                    del self.cache[request_hash]
        
        return None
    
    def cache_response(self, request: Dict, response: Dict):
        """Кэшировать ответ"""
        request_hash = self._hash_request(request)
        
        with self.lock:
            self.cache[request_hash] = (response, time.time())
            
            # Ограничиваем размер кэша
            if len(self.cache) > self.cache_size:
                # Удаляем самый старый
                oldest_key = min(self.cache.keys(), 
                                key=lambda k: self.cache[k][1])
                del self.cache[oldest_key]
    
    def add_to_batch(self, request: Dict) -> bool:
        """Добавить запрос в батч"""
        with self.lock:
            self.batch_queue.append(request)
            if len(self.batch_queue) >= self.batch_size:
                return True  # батч полный
        return False
    
    def get_batch(self) -> Optional[List[Dict]]:
        """Получить батч запросов"""
        with self.lock:
            if self.batch_queue:
                batch = self.batch_queue[:]
                self.batch_queue = []
                return batch
        return None


