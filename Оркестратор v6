@dataclass
class ComponentEndpoint:
    """Описание API endpoint компонента"""
    component_type: ComponentType
    base_url: str
    port: int
    endpoints: Dict[str, str] = field(default_factory=dict)
    
    @property
    def url(self) -> str:
        return f"http://{self.base_url}:{self.port}"
    
    def call_endpoint(self, endpoint_name: str, payload: Dict) -> Tuple[bool, Dict, float]:
        """
        Вызвать endpoint компонента
        
        Returns:
            (success, response, latency_ms)
        """
        if endpoint_name not in self.endpoints:
            return (False, {'error': f'Unknown endpoint: {endpoint_name}'}, 0.0)
        
        endpoint_path = self.endpoints[endpoint_name]
        full_url = f"{self.url}/{endpoint_path}"
        
        try:
            start_time = time.time()
            response = requests.post(full_url, json=payload, timeout=5.0)
            latency_ms = (time.time() - start_time) * 1000
            
            if response.status_code == 200:
                return (True, response.json(), latency_ms)
            else:
                return (False, {'error': f'HTTP {response.status_code}'}, latency_ms)
        
        except requests.exceptions.RequestException as e:
            return (False, {'error': str(e)}, 0.0)


class ComponentRegistry:
    """Реестр всех компонентов V9"""
    
    def __init__(self):
        self.endpoints: Dict[ComponentType, ComponentEndpoint] = {}
    
    def register(self, endpoint: ComponentEndpoint):
        """Зарегистрировать компонент"""
        self.endpoints[endpoint.component_type] = endpoint
    
    def get_endpoint(self, component_type: ComponentType) -> Optional[ComponentEndpoint]:
        """Получить endpoint компонента"""
        return self.endpoints.get(component_type)
    
    def is_available(self, component_type: ComponentType) -> bool:
        """Проверить доступность компонента"""
        endpoint = self.get_endpoint(component_type)
        if not endpoint:
            return False
        
        # Проверяем health endpoint
        try:
            response = requests.get(f"{endpoint.url}/health", timeout=2.0)
            return response.status_code == 200
        except:
            return False


