@dataclass
class StateBlock:
    """Блок состояния компонента"""
    index: int
    timestamp: float
    component: ComponentType
    state: Dict[str, Any]
    request_hash: str
    prev_hash: str
    
    @property
    def hash(self) -> str:
        content = f"{self.index}{self.timestamp}{self.component.value}{json.dumps(self.state, sort_keys=True)}{self.prev_hash}"
        return hashlib.sha256(content.encode()).hexdigest()[:16]
    
    def to_dict(self) -> Dict:
        return {
            'index': self.index,
            'timestamp': self.timestamp,
            'component': self.component.value,
            'state': self.state,
            'hash': self.hash[:8] + '...'
        }


class StateBlockchain:
    """Блокчейн состояний компонентов"""
    
    def __init__(self):
        self.blocks: List[StateBlock] = []
    
    def add_state(self, component: ComponentType, state: Dict, request_hash: str) -> StateBlock:
        """Добавить состояние компонента в блокчейн"""
        prev_hash = self.blocks[-1].hash if self.blocks else 'GENESIS'
        
        block = StateBlock(
            index=len(self.blocks),
            timestamp=time.time(),
            component=component,
            state=state,
            request_hash=request_hash,
            prev_hash=prev_hash
        )
        
        self.blocks.append(block)
        return block
    
    def get_latest_state(self, component: ComponentType) -> Optional[Dict]:
        """Получить последнее состояние компонента"""
        for block in reversed(self.blocks):
            if block.component == component:
                return block.state
        return None
    
    def verify_chain(self) -> bool:
        """Проверить целостность цепи"""
        for i in range(1, len(self.blocks)):
            if self.blocks[i].prev_hash != self.blocks[i-1].hash:
                return False
        return True
    
    def to_dict(self) -> Dict:
        return {
            'length': len(self.blocks),
            'verified': self.verify_chain(),
            'blocks': [b.to_dict() for b in self.blocks[-10:]]  # последние 10
        }


