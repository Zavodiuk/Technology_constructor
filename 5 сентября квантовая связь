class QuditQuantumTransport:
    """Моделирование 5-уровневого квантового канала (кудиты) с декогеренцией и перехватом."""
    
    QUPENTA_MAP = {-2: 0.1, -1: 0.3, 0: 0.5, 1: 0.7, 2: 0.9}
    INV_MAP = {0.1: -2, 0.3: -1, 0.5: 0, 0.7: 1, 0.9: 2}

    @staticmethod
    def prepare_qudits(data_bytes: bytes) -> List[float]:
        qudits = []
        for b in data_bytes:
            val = int((b / 51.0) - 2)
            val = max(-2, min(2, val))
            qudits.append(QuditQuantumTransport.QUPENTA_MAP[val])
        return qudits

    @staticmethod
    def transmit_quantum_channel(qudits: List[float], decoherence: float = 0.02, eve_risk: float = 0.0) -> List[float]:
        transmitted = []
        for q in qudits:
            # Если активна атака Евы (Intercept-Resend), она вносит возмущение в квантовые состояния
            eve_noise = np.random.choice([0.0, 0.2, -0.2], p=[1-eve_risk, eve_risk/2, eve_risk/2]) if eve_risk > 0 else 0.0
            noise = np.random.normal(0, decoherence)
            corrupted = max(0.05, min(0.95, q + noise + eve_noise))
            transmitted.append(corrupted)
        return transmitted

    @staticmethod
    def measure_qudits(qudits: List[float]) -> bytes:
        out_bytes = bytearray()
        levels = list(QuditQuantumTransport.INV_MAP.keys())
        for q in qudits:
            closest = min(levels, key=lambda l: abs(l - q))
            val = QuditQuantumTransport.INV_MAP[closest]
            out_bytes.append(int((val + 2) * 51) & 0xFF)
        return bytes(out_bytes)


