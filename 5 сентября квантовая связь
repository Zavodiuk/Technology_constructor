class MacroFieldV23:
    def __init__(self, dimensions: Tuple[int, int] = (7, 7)):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=int)

    def load_block(self, block_bytes: bytes) -> None:
        flat_vals = [((b % 5) - 2) for b in block_bytes]
        total_cells = self.field.size
        while len(flat_vals) < total_cells:
            flat_vals.append(0)
        self.field = np.array(flat_vals[:total_cells], dtype=int).reshape(self.dimensions)

    def extract_block(self) -> bytes:
        flat = self.field.flatten()
        return bytes(int((val + 2) * 51) & 0xFF for val in flat)

    def calculate_entropy(self) -> float:
        total = self.field.size
        _, counts = np.unique(self.field, return_counts=True)
        return float(-sum((c / total) * math.log2(c / total) for c in counts if c > 0))

    def recover_extremes(self) -> int:
        count = 0
        it = np.nditer(self.field, flags=['multi_index'], op_flags=['readwrite'])
        while not it.finished:
            if it[0] == -2:
                it[0] = 0
                count += 1
            it.iternext()
        return count


class CounterRotatingBiCore:
    def __init__(self, size: int = 3, initial_angle_a: float = 0.0, initial_angle_b: float = 0.0):
        self.size = size
        self.matrix_a = self._generate_ternary(size)
        self.matrix_b = self._generate_ternary(size)
        self.angle_a = initial_angle_a
        self.angle_b = initial_angle_b
        self.base_velocity = math.pi / 6.0

    def _generate_ternary(self, size: int) -> np.ndarray:
        mat = np.zeros((size, size), dtype=int)
        mid = size // 2
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid: mat[x, y] = 0
                elif (x + y) % 2 == 0: mat[x, y] = 1
                else: mat[x, y] = -1
        return mat

    def update_rotation(self, entropy: float, synergy_modulator: float) -> None:
        dynamic_velocity = (self.base_velocity * synergy_modulator) / (1.0 + entropy * 2.0)
        self.angle_a += dynamic_velocity
        self.angle_b -= dynamic_velocity * 1.5
        if self.angle_a >= 2 * math.pi: self.angle_a = 0.0
        if self.angle_b <= -2 * math.pi: self.angle_b = 0.0

    def get_combined_state(self, local_coord: Tuple[int, int], angle: float, matrix: np.ndarray) -> int:
        x, y = local_coord
        mid = self.size // 2
        ox, oy = x - mid, y - mid
        cos_a, sin_a = math.cos(angle), math.sin(angle)
        rx = int(round(ox * cos_a - oy * sin_a))
        ry = int(round(ox * sin_a + oy * cos_a))
        tx = max(0, min(self.size - 1, rx + mid))
        ty = max(0, min(self.size - 1, ry + mid))
        return int(matrix[tx, ty])


class QuantumQuditEncoderDecoder:
    def __init__(self, seed_a: float = 0.78, seed_b: float = 2.35):
        self.macro_field = MacroFieldV23((7, 7))
        self.bi_core = CounterRotatingBiCore(size=3, initial_angle_a=seed_a, initial_angle_b=seed_b)
        self.rashomon = QuantumRashomonEngine()

    def encode_block(self, block_bytes: bytes, context: Dict[str, Any] = None) -> Tuple[bytes, str]:
        self.macro_field.load_block(block_bytes)
        state = TernaryState(Ternary.TRUE, 0.9, time.time())
        decision = self.rashomon.analyze(state, context or {})

        if decision == "NO_GO":
            self.macro_field.field.fill(-2) # Защитный сброс при угрозе перехвата
            return self.macro_field.extract_block(), "NO_GO_EVE_DETECTED"

        entropy = self.macro_field.calculate_entropy()
        if entropy > 0.65:
            self.macro_field.recover_extremes()

        self.bi_core.update_rotation(entropy, synergy_modulator=0.95)
        slice_field = self.macro_field.field[2:5, 2:5]
        new_slice = np.copy(slice_field)

        for tx in range(3):
            for ty in range(3):
                va = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_a, self.bi_core.matrix_a)
                vb = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_b, self.bi_core.matrix_b)
                if tx < slice_field.shape[0] and ty < slice_field.shape[1]:
                    new_slice[tx, ty] = max(-2, min(2, slice_field[tx, ty] + (va + vb)))

        self.macro_field.field[2:5, 2:5] = new_slice
        return self.macro_field.extract_block(), decision

    def decode_block(self, block_bytes: bytes, context: Dict[str, Any] = None) -> Tuple[bytes, str]:
        self.macro_field.load_block(block_bytes)
        state = TernaryState(Ternary.TRUE, 0.9, time.time())
        decision = self.rashomon.analyze(state, context or {})

        if decision == "NO_GO":
            return self.macro_field.extract_block(), "NO_GO_EVE_DETECTED"

        entropy = self.macro_field.calculate_entropy()
        self.bi_core.update_rotation(entropy, synergy_modulator=0.95)
        slice_field = self.macro_field.field[2:5, 2:5]
        new_slice = np.copy(slice_field)

        for tx in range(3):
            for ty in range(3):
                va = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_a, self.bi_core.matrix_a)
                vb = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_b, self.bi_core.matrix_b)
                if tx < slice_field.shape[0] and ty < slice_field.shape[1]:
                    new_slice[tx, ty] = max(-2, min(2, slice_field[tx, ty] - (va + vb)))

        self.macro_field.field[2:5, 2:5] = new_slice
        self.macro_field.recover_extremes()
        return self.macro_field.extract_block(), decision


