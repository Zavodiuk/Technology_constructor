class ZVD_120D_Pico_Wavefront_Projection_Engine:
    """
    Контроллер проекции паттерна внутри лазерного луча:
    Использует глобальную неевклидовую матрицу Лобачевского для синхронной деформации 
    всего фронта волны и компилирует покадровые G-код программы с мгновенной ШИМ-модуляцией.
    """
    def __init__(self, spatial_hw: Tuple[int, int] = (100, 100)) -> None:
        h, w = spatial_hw
        self.h = (h // CUBE) * CUBE
        self.w = (w // CUBE) * CUBE
        self.tiles_y = self.h // CUBE
        self.tiles_x = self.w // CUBE
        self.num_cubes = self.tiles_y * self.tiles_x
        self.macro_field = MacroFieldV23((7, 7))
        self.bi_core = CounterRotatingBiCore120D(size=CUBE)
        self.hysteresis = PhaseHysteresisMemory(window_size=4)
        
        # Глобальная матрица искажений Лобачевского (AVX-512 aligned)
        self.global_lobachevsky_lut = self._generate_global_lobachevsky_lut(self.h, self.w)

    @staticmethod
    def _generate_global_lobachevsky_lut(height: int, width: int) -> np.ndarray:
        lut = allocate_aligned_array((height, width, 2), np.int8, alignment=64)
        mid_y = height / 2.0
        mid_x = width / 2.0
        for y in range(height):
            for x in range(width):
                dy = float(y) - mid_y
                dx = float(x) - mid_x
                dist = math.sqrt(dx*dx + dy*dy)
                # Гиперболическое сжатие/искривление Пуанкаре для компенсации термического наплыва
                factor = 1.0 - 0.002 * dist
                offset_y = int(round(dy * (1.0 - factor)))
                offset_x = int(round(dx * (1.0 - factor)))
                lut[y, x, 0] = np.int8(max(-128, min(127, offset_y)))
                lut[y, x, 1] = np.int8(max(-128, min(127, offset_x)))
        return lut

    def emit_wavefront_projection_frames(self, cubes: List[TetraCube120D]) -> Dict[str, np.ndarray]:
        if not cubes:
            raise ValueError("Empty cube list provided to Pico Wavefront Projection Engine.")

        n_cubes = len(cubes)
        voxels_per_cube = CUBE * CUBE
        total_voxels = n_cubes * voxels_per_cube
        
        # Строгое 64-байтное выравнивание памяти (AVX-512)
        out_phases = allocate_aligned_array((total_voxels,), np.int16, alignment=64)
        out_powers = allocate_aligned_array((total_voxels,), np.uint8, alignment=64)
        out_coords = allocate_aligned_array((total_voxels, 2), np.int32, alignment=64)

        for idx in range(min(n_cubes, self.num_cubes)):
            cube = cubes[idx]
            entropy = self.macro_field.calculate_entropy()
            if entropy > 0.65:
                self.macro_field.recover_extremes()
            self.bi_core.update_rotation(entropy)
            
            cube.meta_angle_a = self.bi_core.angle_a
            cube.meta_angle_b = self.bi_core.angle_b
            
            ty = idx // self.tiles_x
            tx = idx % self.tiles_x
            y0 = ty * CUBE
            x0 = tx * CUBE
            
            face_slice = cube.face_data[:, :, 0, 0]
            vertex_slice = cube.vertex_data[:, :, 0, 0]
            
            _njit_pico_wavefront_projection_kernel(
                face_slice, vertex_slice, cube.meta_angle_a, cube.meta_angle_b,
                self.global_lobachevsky_lut, out_phases, out_powers, out_coords, y0, x0, idx
            )

        return {
            "aom_phase_shifts_deg": out_phases,
            "diode_power_levels_pct": out_powers,
            "substrate_coordinates": out_coords
        }

    def export_to_machine_gcode(self, instructions: Dict[str, np.ndarray], output_filepath: str, feed_rate: float = 2400.0) -> None:
        phases = instructions["aom_phase_shifts_deg"]
        powers = instructions["diode_power_levels_pct"]
        coords = instructions["substrate_coordinates"]
        
        with open(output_filepath, "w", encoding="utf-8") as f:
