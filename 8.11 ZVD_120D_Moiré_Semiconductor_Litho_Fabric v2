@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_pico_wavefront_projection_kernel(
    face_matrix: np.ndarray, vertex_matrix: np.ndarray, 
    angle_a: float, angle_b: float, global_lobachevsky_lut: np.ndarray,
    out_phases: np.ndarray, out_powers: np.ndarray, out_coords: np.ndarray, 
    cube_offset_y: int, cube_offset_x: int, cube_idx: int
):
    """
    Субкосмический пико-волновой интерференционный движок с глобальной деформацией Лобачевского:
    Формирует квантовую картинку паттерна прямо внутри луча лазера.
    """
    rows = face_matrix.shape[0]
    cols = face_matrix.shape[1]
    
    cos_a = math.cos(angle_a)
    sin_a = math.sin(angle_a)
    cos_b = math.cos(angle_b)
    sin_b = math.sin(angle_b)
    
    for y in range(rows):
        for x in range(cols):
            val_a = int(face_matrix[y, x])
            val_b = int(vertex_matrix[y, x])
            
            fx = (y - rows // 2) * cos_a - (x - cols // 2) * sin_a
            fy = (y - rows // 2) * sin_b + (x - cols // 2) * cos_b
            phase_mod = int(round(fx + fy)) % 5 - 2
            
            core_interference = val_a + val_b + phase_mod
            
            # Применение глобальной неевклидовой матрицы искажений Лобачевского
            global_y = cube_offset_y + y
            global_x = cube_offset_x + x
            lut_h, lut_w = global_lobachevsky_lut.shape[:2]
            ly = max(0, min(lut_h - 1, global_y))
            lx = max(0, min(lut_w - 1, global_x))
            
            warp_dy = global_lobachevsky_lut[ly, lx, 0]
            warp_dx = global_lobachevsky_lut[ly, lx, 1]
            
            target_y = max(0, min(10000, global_y + warp_dy))
            target_x = max(0, min(10000, global_x + warp_dx))
            
            # Пифагоровы шаги фазы (3°, 4°, 5°) для подавления шума AOM
            leg_a = core_interference * 3
            leg_b = (abs(core_interference) + 1) * 4
            raw_hypot = math.sqrt(leg_a * leg_a + leg_b * leg_b)
            phase_deg = int(round(raw_hypot / 5.0) * 5.0) * (-1 if core_interference < 0 else 1)
            
            # Мгновенная модуляция мощности ШИМ диода в %
            power_pct = min(100, max(10, (abs(core_interference) + 1) * 25))
            
            flat_idx = cube_idx * 25 + (y * 5 + x)
            out_phases[flat_idx] = np.int16(phase_deg)
            out_powers[flat_idx] = np.uint8(power_pct)
            out_coords[flat_idx, 0] = np.int32(target_y)
