def rashomon_evaluate(candidate_data: Dict) -> Dict:
    """
    Эмуляция rashomon_evaluate из модуля rashomon.
    Вычисляет консенсус (среднее) и флаг расхождения (если std > порога).
    """
    opinions = candidate_data.get("consensus_opinions", [])
    if not opinions:
        return {"Consensus": 0.5, "Disagreement": False, "StdDev": 0.0}
    mean = sum(opinions) / len(opinions)
    variance = sum((x - mean) ** 2 for x in opinions) / len(opinions)
    std = math.sqrt(variance)
    disagreement = std > 0.15
    return {"Consensus": mean, "Disagreement": disagreement, "StdDev": std}

def meta_rashomon_evaluate(res_a: Dict, res_b: Dict) -> Dict:
    """Эмуляция мета-анализа двух решений."""
    stable = not (res_a.get("Disagreement", False) or res_b.get("Disagreement", False))
    return {"meta_status": "STABLE" if stable else "UNSTABLE"}

def candidate_agreement_matrix(R_matrix: List[List[int]], names_ordered: List[str]) -> Dict:
    """
    Эмуляция попарного матричного анализа согласия из ternary_matrix.
    Вычисляет, есть ли хотя бы одна пара векторов с антагонизмом по осям.
    """
    n = len(R_matrix)
    if n < 2:
        return {"agreement": [], "disagreement": False}
    
    agreement_pairs = []
    for i in range(n):
        for j in range(i+1, n):
            vec_a = R_matrix[i]
            vec_b = R_matrix[j]
            diff = [a - b for a, b in zip(vec_a, vec_b)]
            conflict_axis = [idx for idx, d in enumerate(diff) if abs(d) >= 2]
            agreement_pairs.append({
                "pair": (names_ordered[i], names_ordered[j]),
                "diff": diff,
                "conflict_axis": conflict_axis,
                "disagreement": bool(conflict_axis)
            })
    
    overall_disagreement = any(pair["disagreement"] for pair in agreement_pairs)
    return {"agreement": agreement_pairs, "disagreement": overall_disagreement}

def disagreement_from_agreement_matrix(agreement_result: Dict, n_axes: int) -> Dict:
    """Извлекает флаг расхождения и детали из результата матрицы."""
    return {
        "disagreement": agreement_result.get("disagreement", False),
        "details": agreement_result.get("agreement", [])
    }

def geometric_mean(values: List[float]) -> float:
    """Эмуляция геометрического среднего из aggregate.py."""
    if not values:
        return 0.0
    product = 1.0
    for v in values:
        v = max(v, 0.001)
        product *= v
    return product ** (1.0 / len(values))

# ==============================================================================
# БАЗОВЫЕ ТРОИЧНЫЕ ОПЕРАЦИИ (Часть 6)
# ==============================================================================

def quantize(value: float, threshold_low: float = 0.3, threshold_high: float = 0.7) -> int:
    if value >= threshold_high:
        return 1
    elif value <= threshold_low:
        return -1
    else:
        return 0

def _normalize_sign(x: int) -> int:
    if x > 0:
        return 1
    elif x < 0:
        return -1
    return 0

def ternary_sum(vec_a: Tuple[int, ...], vec_b: Tuple[int, ...]) -> Tuple[int, ...]:
    return tuple(_normalize_sign(a + b) for a, b in zip(vec_a, vec_b))

def ternary_diff(vec_a: Tuple[int, ...], vec_b: Tuple[int, ...]) -> Tuple[int, ...]:
    return tuple(a - b for a, b in zip(vec_a, vec_b))

def ternary_mul(vec_a: Tuple[int, ...], vec_b: Tuple[int, ...]) -> Tuple[int, ...]:
    return tuple(a * b for a, b in zip(vec_a, vec_b))

def ternary_sqrt(trit: int) -> Dict:
    if trit == 1:
        return {"value": 1, "flag": None}
    elif trit == 0:
        return {"value": 0, "flag": None}
    elif trit == -1:
        return {"value": -1, "flag": "CONFLICT"}
    else:
        raise ValueError(f"Трит должен быть -1, 0 или 1, получено {trit}")

def ternary_fold(vector: Tuple[int, ...]) -> int:
    return _normalize_sign(sum(vector))

# ==============================================================================
# ЧАСТЬ 2: L3_in — ГОТОВНОСТЬ ВХОДА
# ==============================================================================

def evaluate_l3_in(field_trits: Dict[str, int]) -> Dict:
    values = list(field_trits.values())
    l3_in = ternary_fold(tuple(values))
    if l3_in == 1:
        action = "PROCEED_TO_RASHOMON_1"
    elif l3_in == 0:
        action = "INTERACTION_LAYER"
    else:
        action = "CORRECTION_OR_STOP_VETO"
    return {"L3_in": l3_in, "Action": action, "Fields": field_trits}

# ==============================================================================
# ЧАСТЬ 3: RASHOMON-1 — ИНТЕРПРЕТАЦИОННЫЙ КОНТУР
# ==============================================================================

def rashomon_1(interpretations: Dict[str, float], margin_threshold: float = 0.15) -> Dict:
    if not interpretations:
        return {"Intent_resolved": None, "Intent_state": 0, "Rashomon_detail": None}
    sorted_items = sorted(interpretations.items(), key=lambda x: x[1], reverse=True)
    best_label, best_score = sorted_items[0]
    if len(sorted_items) == 1:
        margin = best_score
    else:
        second_score = sorted_items[1][1]
        margin = best_score - second_score
    detail = {
        "Top": best_label,
        "TopScore": best_score,
        "Margin": margin,
        "AllScores": dict(sorted_items)
    }
    if best_score < 0.3:
        intent_state = -1
    elif margin >= margin_threshold and best_score >= 0.6:
        intent_state = 1
    else:
        intent_state = 0
    return {
        "Intent_resolved": best_label if intent_state == 1 else None,
        "Intent_state": intent_state,
        "Rashomon_detail": detail
    }

# ==============================================================================
# ЧАСТЬ 4: ПРОСТРАНСТВО РЕШЕНИЙ R
# ==============================================================================

def build_solution_vector(z_match: float, efficiency: float, reliability: float,
                          tempo_factor: float, strategic_alignment: float) -> Tuple[int, ...]:
    return (
        quantize(z_match),
        quantize(efficiency),
        quantize(reliability),
        quantize(tempo_factor),
        quantize(strategic_alignment)
    )

# ==============================================================================
# ЧАСТЬ 5: RASHOMON-2 + META-RASHOMON — ВЫБОР РЕШЕНИЯ
# ==============================================================================

def rashomon_2(candidates: Dict[str, Dict], solution_vectors: Optional[Dict[str, Tuple[int, ...]]] = None) -> Dict:
    results = {}
    matrix_disagreement = False
    matrix_detail = None
    
    if solution_vectors and 2 <= len(solution_vectors) <= 4:
        names_ordered = list(solution_vectors.keys())
        R_matrix = [list(solution_vectors[n]) for n in names_ordered]
        agreement = candidate_agreement_matrix(R_matrix, names_ordered)
        matrix_detail = disagreement_from_agreement_matrix(agreement, n_axes=len(R_matrix[0]))
        matrix_disagreement = matrix_detail["disagreement"]
    
    for name, data in candidates.items():
        rashomon_result = rashomon_evaluate(data)
        disagreement_flag = rashomon_result.get("Disagreement", False) or matrix_disagreement
        
        if disagreement_flag:
            decision_score = rashomon_result.get("Consensus", 0.0)
            l3_decision = 0
        else:
            decision_score = geometric_mean([
                data.get("z_match", 0.0),
                data.get("efficiency", 0.0),
                data.get("reliability", 0.0),
                rashomon_result.get("Consensus", 0.0)
            ])
            l3_decision = quantize(decision_score)
        
        results[name] = {
            "Decision_score": decision_score,
            "L3_decision": l3_decision,
            "Disagreement": disagreement_flag,
            "Rashomon_detail": rashomon_result,
            "Matrix_detail": matrix_detail
        }
    
    return results

def select_best_r(rashomon_2_results: Dict) -> Optional[str]:
    eligible = {k: v for k, v in rashomon_2_results.items() if v["L3_decision"] != -1}
    if not eligible:
        return None
    return max(eligible, key=lambda k: eligible[k]["Decision_score"])

def meta_rashomon_check(result_a: Dict, result_b: Dict) -> Dict:
    stable = not (result_a.get("Disagreement", False) or result_b.get("Disagreement", False))
    return {"meta_status": "STABLE" if stable else "UNSTABLE"}

