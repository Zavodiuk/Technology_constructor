    def execute_sync_cycle(self, raw_frame: np.ndarray) -> Tuple[int, int, float, float, int, np.ndarray]:
        t_start = time.perf_counter()
        self.time_step += 1
        current_entropy = self.macro_field.calculate_entropy()
        recovered_nodes = 0
        
        if current_entropy > 0.55:
            recovered_nodes = self.macro_field.recover_extremes()

        self.bi_core.update_rotation(current_entropy)
        
        rot_a = self.bi_core.rotate_matrix(self.bi_core.matrix_a, self.bi_core.angle_a)
        rot_b = self.bi_core.rotate_matrix(self.bi_core.matrix_b, self.bi_core.angle_b)
        
        moire_matrix_3x3 = np.clip(rot_a.astype(np.int32) + rot_b.astype(np.int32), -1, 1).astype(np.int8)
        
        slice_field = self.macro_field.field[2:5, 2:5]
        product_matrix = moire_matrix_3x3.astype(np.int32) * slice_field.astype(np.int32)
        interaction_sum = int(np.sum(product_matrix))
        matches = int(np.sum(moire_matrix_3x3 == slice_field))

        if interaction_sum > 2: raw_gate = 1
        elif interaction_sum >= -2: raw_gate = 0
        else: raw_gate = -1

        stabilized_gate = self.hysteresis.register_state(raw_gate)
        coherence = float(matches / 9.0)

        attractors = V18CoreEncoder.extract_attractors(raw_frame)
        condensed_vector = V18CoreCondenser.condense(attractors)
        
        encrypted_packet = self.crypto_engine.encrypt_packet(condensed_vector, moire_matrix_3x3)
        decrypted_packet = self.crypto_engine.decrypt_packet(encrypted_packet, moire_matrix_3x3)
        decoded_view = PentarnyVideoDecoder.decode_frame(decrypted_packet, target_shape=raw_frame.shape[:2])

        # Расчет дивергенции поля
        try:
            grad = np.gradient(self.macro_field.field.astype(np.float32))
            field_divergence = float(np.sum([np.sum(np.abs(g)) for g in grad]))
        except Exception:
            diffs = [np.sum(np.abs(np.diff(self.macro_field.field, axis=i))) for i in range(self.macro_field.field.ndim)]
            field_divergence = float(np.sum(diffs))
            
        # Оптимизация демпфирования: подкачка энергии от когерентности фаз
        self.edge.energy_flow = max(0.01, self.edge.energy_flow * (1.0 - (field_divergence * 0.01)) + (coherence * 0.05))
        
        t_duration = time.perf_counter() - t_start
        self.fps = 1.0 / max(t_duration, 1e-6)
        
        return stabilized_gate, interaction_sum, current_entropy, coherence, recovered_nodes, decoded_view

