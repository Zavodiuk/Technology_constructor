# МОДУЛЬ 4: КОМПЛЕКС V18 (ENCODER, CONDENSER, DECODER)
# ============================================================================
class V18CoreEncoder:
    @staticmethod
    def extract_attractors(frame: np.ndarray) -> List[Tuple[int, int]]:
        h, w = frame.shape[:2]
        v_a = (w // 4, h // 4)
        v_b = (3 * w // 4, h // 4)
        v_c = (w // 2, 3 * h // 4)
        return [v_a, v_b, v_c]


class V18CoreCondenser:
    @staticmethod
    def condense(attractors: List[Tuple[int, int]]) -> np.ndarray:
        return np.array(attractors, dtype=np.int32)


class PentarnyVideoDecoder:
    @staticmethod
    def decode_frame(attractors: np.ndarray, target_shape: Tuple[int, int] = (120, 160)) -> np.ndarray:
        h, w = target_shape
        canvas = np.zeros((h, w, 3), dtype=np.uint8)
        if not OPENCV_AVAILABLE:
            return canvas
            
        for pt in attractors:
            x, y = int(pt[0]), int(pt[1])
            if 0 <= x < w and 0 <= y < h:
                cv2.circle(canvas, (x, y), 5, (0, 255, 128), -1)
        return canvas


