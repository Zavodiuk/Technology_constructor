# МОДУЛЬ 5: КРИПТОГРАФИЧЕСКИЙ ЗАЦЕПИТЕЛЬ «ZVD-MOIRE-CRYPTO»
# ============================================================================
class ZvdMoireCryptoEngine:
    @staticmethod
    def encrypt_packet(attractors: np.ndarray, moire_mask_3x3: np.ndarray) -> np.ndarray:
        flat = moire_mask_3x3.flatten()
        n = len(attractors)
        idx = np.arange(n)
        shift_x = flat[idx % 3].reshape(-1, 1) * 10
        shift_y = flat[(idx + 1) % 3].reshape(-1, 1) * 10
        shifts = np.hstack((shift_x, shift_y)).astype(attractors.dtype)
        return attractors + shifts

    @staticmethod
    def decrypt_packet(encrypted_attractors: np.ndarray, moire_mask_3x3: np.ndarray) -> np.ndarray:
        flat = moire_mask_3x3.flatten()
        n = len(encrypted_attractors)
        idx = np.arange(n)
        shift_x = flat[idx % 3].reshape(-1, 1) * 10
        shift_y = flat[(idx + 1) % 3].reshape(-1, 1) * 10
        shifts = np.hstack((shift_x, shift_y)).astype(encrypted_attractors.dtype)
        return encrypted_attractors - shifts


