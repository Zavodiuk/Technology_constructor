# ============================================================================
class MacroFieldW23:
    def __init__(self, dimensions: Tuple[int, int] = (7, 7)):
        self.dimensions = dimensions
        # ⚡ Векторизованная инициализация Манхэттенской матрицы без циклов
        mid_x, mid_y = dimensions[0] // 2, dimensions[1] // 2
        x = np.arange(dimensions[0])[:, None]
        y = np.arange(dimensions[1])[None, :]
        dist = np.abs(x - mid_x) + np.abs(y - mid_y)
        
        self.field = np.where(dist == 0, np.int8(1), 
                              np.where(dist <= 2, np.int8(0), np.int8(-1)))

    def calculate_entropy(self) -> float:
        """⚡ Безопасная векторизованная энтропия Base-3 на np.bincount."""
        total = self.field.size
        if total == 0:
            return 0.0
        # Защита от выхода за границы троичного базиса
        flat_shifted = np.clip(self.field.flatten().astype(np.intp) + 1, 0, 2)
        counts = np.bincount(flat_shifted, minlength=3)[:3]
        
        p = counts / total
        nonzero_p = p[p > 0]
        if nonzero_p.size > 0:
            return float(-np.sum(nonzero_p * (np.log(nonzero_p) / np.log(3))))
        return 0.0

    def recover_extremes(self) -> int:
        """⚡ Векторизованный сброс заблокированных состояний (-1) в баланс (0)."""
        mask = (self.field == -1)
        count = np.sum(mask).item()
        if count > 0:
            self.field[mask] = np.int8(0)
        return count


