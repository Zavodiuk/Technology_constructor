# БЛОК 3: Файловая система и HAL
print("[3/10] Инициализация PentanaryFileSystem & HAL...")
class PentanaryFileSystem:
    def __init__(self):
        self.storage = {}
        
    def _trit_to_string_address(self, trit_vector):
        return "".join(str(t) for t in trit_vector)

    def create_file(self, address_vector, filename, size_blocks, access_trit):
        str_addr = self._trit_to_string_address(address_vector)
        if str_addr in self.storage:
            return "Error: Address collision in Pentanary Tree"
        self.storage[str_addr] = {
            "name": filename,
            "size": size_blocks,
            "access": access_trit,
            "data": [0] * size_blocks
        }
        return f"File '{filename}' successfully allocated at PFS address [{str_addr}]"

class OS_HardwareAbstractionLayer:
    def __init__(self, host_platform):
        self.host = host_platform
        self.pfs = PentanaryFileSystem()

    def bridge_read_request(self, address_vector, current_user_privilege):
        str_addr = self.pfs._trit_to_string_address(address_vector)
        if str_addr not in self.pfs.storage:
            return "OS Error: 404 File Not Found"
        file_meta = self.pfs.storage[str_addr]
        if current_user_privilege < file_meta["access"]:
            return "OS Security Violation: Insufficient Pentanary Privilege Level"
        return f"[HAL_{self.host}] Streaming data from file: {file_meta['name']}"

