# БЛОК 5: Графический движок (V-Matrix UI)
print("[5/10] Инициализация VMatrixGraphicsEngine...")
class VMatrixGraphicsEngine:
    def __init__(self, width=5, height=5):
        self.half_w = width // 2
        self.half_h = height // 2
        self.canvas = {}
        for x in range(-self.half_w, self.half_w + 1):
            for y in range(-self.half_h, self.half_h + 1):
                self.canvas[(x, y)] = 0
    def draw_pixel(self, x, y, intensity_trit):
        if not (-self.half_w <= x <= self.half_w) or not (-self.half_h <= y <= self.half_h):
            return "UI Error: Out of V-Matrix canvas bounds"
        if intensity_trit not in {-2, -1, 0, 1, 2}:
            return "UI Error: Invalid intensity trit"
        self.canvas[(x, y)] = intensity_trit
        return f"Pixel rendered at ({x}, {y}) with value {intensity_trit}"
    def render_to_host_rgba(self):
        binary_rgba_buffer = {}
        trit_to_brightness = {-2: 0, -1: 64, 0: 128, 1: 192, 2: 255}
        for coords, trit_val in self.canvas.items():
            brightness = trit_to_brightness.get(trit_val, 128)
            binary_rgba_buffer[coords] = (brightness, brightness, brightness, 255)
        return binary_rgba_buffer

