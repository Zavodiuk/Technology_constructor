print("[2/10] Инициализация PentanaryHardwareCell...")
class PentanaryHardwareCell:
    def __init__(self):
        self.voltage_levels = {-2: -2.0, -1: -1.0, 0: 0.0, 1: 1.0, 2: 2.0}
        self.current_state = 0

    def apply_voltage(self, voltage):
        closest_trit = min(self.voltage_levels.keys(), key=lambda k: abs(self.voltage_levels[k] - voltage))
        if abs(self.voltage_levels[closest_trit] - voltage) > 0.4:
            self.current_state = 0
            return f"Signal Noise Detected! Cell reset to Neutral (0)."
        self.current_state = closest_trit
        return f"Cell stabilized at state {closest_trit} ({self.voltage_levels[closest_trit]}V)"

    def read_physical_value(self):
        return self.current_state

