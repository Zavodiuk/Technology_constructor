# 1. Базовые компоненты и АЛУ
class MockTechnologyConstructor:
    def binary_stream_to_pentanary(self, binary_data):
        return [b % 5 - 2 for b in binary_data]

class PentanaryALU:
    def balanced_add(self, a, b):
        s = a + b
        carry = 0
        if s > 2:
            s -= 5
            carry = 1
        elif s < -2:
            s += 5
            carry = -1
        return s, carry

    def trit_invert(self, trit):
        return -trit

