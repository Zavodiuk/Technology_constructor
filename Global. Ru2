print("[6/10] Инициализация PentanaryIOBridge...")
class PentanaryIOBridge:
    def __init__(self, technology_constructor):
        self.translator = technology_constructor
        self.device_ports = {"USB_0": 0, "INPUT_DEVICE": 0, "NETWORK_CARD": 0}
    def register_peripheral_event(self, port_name, binary_event_data):
        if port_name not in self.device_ports:
            return "IO Error: Unknown peripheral port"
        if self.device_ports[port_name] == -2:
            return f"IO Error: Port {port_name} is CRITICALLY_BLOCKED"
        if not binary_event_data or len(binary_event_data) == 0:
            self.device_ports[port_name] = -2
            return f"IO Alert: Malformed stream. Port {port_name} isolated."
        self.device_ports[port_name] = 1
        pentanary_vector = self.translator.binary_stream_to_pentanary(binary_event_data)
        self.device_ports[port_name] = 0
        return {
            "status": "Event Processed",
            "port": port_name,
            "interpreted_trit_vector": pentanary_vector,
            "kernel_interrupt_ready": True
        }

