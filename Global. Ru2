# БЛОК 7 & 8: Криптография и Блокчейн (P-Chain)
print("[7/10 & 8/10] Инициализация PentanaryCryptography & Blockchain...")
class PentanaryCryptography:
    def __init__(self):
        self.alu = PentanaryALU()
    def generate_p_hash(self, trit_stream):
        hash_vector = [0, -1, 2, -2, 1, 0, 1, -1, 2]
        if not trit_stream:
            return hash_vector
        for i, trit in enumerate(trit_stream):
            target_index = i % len(hash_vector)
            res, carry = self.alu.balanced_add(hash_vector[target_index], trit)
            hash_vector[target_index] = self.alu.trit_invert(res)
            next_index = (target_index + 1) % len(hash_vector)
            hash_vector[next_index], _ = self.alu.balanced_add(hash_vector[next_index], carry)
        return hash_vector

class PentanaryBlockchain:
    def __init__(self):
        self.crypto = PentanaryCryptography()
        self.chain = []
        self.create_genesis_block()
    def create_genesis_block(self):
        genesis_hash = [0] * 9
        genesis_payload = [1, 2, -2, -1, 0]
        block_hash = self.crypto.generate_p_hash(genesis_payload)
        self.chain.append({
            "index": 0,
            "prev_hash": genesis_hash,
            "payload": genesis_payload,
            "nonce": [0, 0, 0],
            "hash": block_hash
        })
    def add_block(self, transaction_trits, nonce_vector):
        prev_block = self.chain[-1]
        prev_hash = prev_block["hash"]
        raw_block_data = prev_hash + transaction_trits + nonce_vector
        current_hash = self.crypto.generate_p_hash(raw_block_data)
        new_block = {
            "index": len(self.chain),
            "prev_hash": prev_hash,
            "payload": transaction_trits,
            "nonce": nonce_vector,
            "hash": current_hash
        }
        self.chain.append(new_block)
        return f"Block #{new_block['index']} successfully mined and locked."
    def verify_chain_integrity(self):
        for i in range(1, len(self.chain)):
            current = self.chain[i]
            previous = self.chain[i-1]
            if current["prev_hash"] != previous["hash"]:
                return f"ALERT: Chain broken at block {i}!"
            raw_data = current["prev_hash"] + current["payload"] + current["nonce"]
            recalculated_hash = self.crypto.generate_p_hash(raw_data)
            if current["hash"] != recalculated_hash:
                return f"ALERT: Data tampering detected in block {i}!"
        return "Blockchain Integrity: VERIFIED. Secure."

