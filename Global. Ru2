# БЛОК 4: Сетевой стек (PTCP)
print("[4/10] Инициализация PentanaryNetworkStack (PTCP)...")
class PentanaryNetworkStack:
    def __init__(self):
        self.network_states = {
            -2: "ROUTE_BLOCKED", -1: "PACKET_DROPPED", 0: "IDLE_CHANNEL", 1: "ROUTING_SUCCESS", 2: "BROADCAST_MODE"
        }
    def calculate_checksum(self, trit_stream):
        return sum(trit_stream)
    def create_packet(self, address_vector, payload_trits):
        checksum = self.calculate_checksum(payload_trits)
        compressed_checksum = max(-2, min(2, checksum))
        packet = address_vector + payload_trits + [compressed_checksum]
        return packet
    def receive_and_route(self, packet_stream):
        if not packet_stream:
            return self.network_states[0], "Channel Empty"
        payload = packet_stream[:-1]
        declared_checksum = packet_stream[-1]
        actual_checksum = self.calculate_checksum(payload)
        actual_checksum_trit = max(-2, min(2, actual_checksum))
        if actual_checksum_trit != declared_checksum:
            return self.network_states[-1], "Error: Network Packet Corrupted"
        return self.network_states[1], f"Packet routed successfully. Payload size: {len(payload)} trits"

