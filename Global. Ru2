# БЛОК 1: Компилятор
print("[1/10] Инициализация PentanaryCompiler...")
class PentanaryCompiler:
    def __init__(self):
        self.token_map = {
            "IF_NEGATIVE": -1,
            "IF_NEUTRAL": 0,
            "IF_POSITIVE": 1,
            "MAX_NEG": -2,
            "MAX_POS": 2
        }

    def compile_conditional(self, expression_string):
        clean_expr = expression_string.upper().strip()
        if "LESS THAN ZERO" in clean_expr:
            return self.token_map["IF_NEGATIVE"]
        elif "GREATER THAN ZERO" in clean_expr:
            return self.token_map["IF_POSITIVE"]
        elif "EQUALS ZERO" in clean_expr:
            return self.token_map["IF_NEUTRAL"]
        elif "CRITICAL FAILURE" in clean_expr:
            return self.token_map["MAX_NEG"]
        else:
            return self.token_map["MAX_POS"]

    def optimize_abstract_syntax_tree(self, operation_list):
        optimized_instructions = []
        for op in operation_list:
            if op in ["round", "floor", "ceil"]:
                optimized_instructions.append("TRIT_TRUNCATE")
            else:
                optimized_instructions.append(f"EXEC_{op.upper()}")
        return optimized_instructions

