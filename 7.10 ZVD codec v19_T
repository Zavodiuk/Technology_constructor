FACE_MOTION = 0   # движение / ритм
FACE_ENERGY = 1   # энергия / контраст
FACE_MASK = 2     # семантика / маска
FACE_TRUST = 3    # доверие / нужность residual


def q_pent(v: float) -> int:
    if v > 0.75:
        return 2
    if v > 0.25:
        return 1
    if v >= -0.25:
        return 0
    if v >= -0.75:
        return -1
    return -2


def q_field(a: np.ndarray) -> np.ndarray:
    out = np.zeros(a.shape, dtype=np.int8)
    out[a > 0.75] = 2
    out[(a > 0.25) & (a <= 0.75)] = 1
    out[(a >= -0.25) & (a <= 0.25)] = 0
    out[(a >= -0.75) & (a < -0.25)] = -1
    out[a < -0.75] = -2
    return out


