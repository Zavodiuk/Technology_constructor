def demo(out_path: str = "/home/workdir/artifacts/demo_tetra_cube.zvd5t") -> dict:
    # unit test tetra
    t = TetraCell([2, -1, 0, 1])
    assert TetraCell.unpack(t.pack()).faces.tolist() == [2, -1, 0, 1]
    c = TetraCube5()
    c.data[0, 0, 0, :] = [2, 1, 0, -1]
    assert TetraCube5.unpack(c.pack()).data[0, 0, 0].tolist() == [2, 1, 0, -1]

    if not HAS_CV2:
        return {"status": "unit_ok_no_cv2"}

    vol = TetraCubeVolumeCodec((80, 80))
    w = TetraBitstreamWriter(out_path)
    gops = 0
    for i in range(15):
        img = np.zeros((240, 320, 3), dtype=np.uint8)
        cv2.rectangle(img, (20 + i * 5, 30), (100 + i * 5, 120), (0, 255, 128), -1)
        cubes = vol.push_frame(img)
        if cubes is not None:
            w.write_gop(cubes, vol.tiles_y, vol.tiles_x)
            gops += 1
    w.close()
    r = TetraBitstreamReader(out_path)
    first = r.read_gop()
    r.close()
    # capacity note
    scalar_cube_bytes = 125
    tetra_cube_bytes = 500
    return {
        "status": "ok",
        "gops": gops,
        "out_bytes": os.path.getsize(out_path),
        "cubes_first_gop": len(first[0]) if first else 0,
        "entropy": first[3] if first else None,
        "raw_bytes_per_cube_scalar": scalar_cube_bytes,
        "raw_bytes_per_cube_tetra": tetra_cube_bytes,
        "info_channels_per_node": N_FACES,
        "out_path": out_path,
    }


