@app.post("/compute-cube")
def compute_cube(payload: NodePayload):
    """Главный эндпоинт дата-центра для расчета кубического тензора 5x5x5."""
    try:
        res = node_pipeline.run(payload.interpretations_scores, payload.l5_values_list)
        matrix_list = res["matrix_l5"].tolist() if res["matrix_l5"] is not None else None
        return {
            "status": res["status"],
            "best_candidate_idx": res["best_candidate_idx"],
            "confidence": res["confidence"],
            "matrix_shape": [5, 5, 5] if matrix_list else None,
            "cubic_matrix_5x5x5": matrix_list
        }
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))


