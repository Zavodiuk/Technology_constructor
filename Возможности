def detect_sybil_attack(validators):
    """Обнаружение атаки сивилла."""
    patterns = {}
    for v in validators:
        vec = (v.get('stake',0), v.get('uptime',0), v.get('success_rate',0))
        patterns.setdefault(vec, []).append(v.get('id',0))
    suspicious = [g for g in patterns.values() if len(g) > 2]
    return len(suspicious) > 0

