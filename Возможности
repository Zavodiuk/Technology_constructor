def quality_check(defects, accuracy, speed):
    """Оценка качества продукции."""
    vec = (
        quantize(1 - defects / 100),
        quantize(accuracy / 100),
        quantize(speed / 100)
    )
    result = ternary_fold(vec)
    if result == 1: return "ГОДЕН"
    if result == 0: return "ТРЕБУЕТ ПРОВЕРКИ"
    return "БРАК"

