def credit_score(applicant):
    """Оценка кредитного риска."""
    vec = (
        quantize(applicant.get('income', 5000) / 10000),
        quantize(1 - applicant.get('debt_ratio', 0.5)),
        quantize(applicant.get('history', 5) / 10),
        quantize(applicant.get('employment', 3) / 5)
    )
    return ternary_fold(vec)  # +1 одобрить, 0 проверить, -1 отказать

