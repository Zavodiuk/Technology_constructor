# 16. ОБРАБОТКА ВРЕМЕННЫХ РЯДОВ
# ============================================================================

def trend_signal(data):
    """Выявление тренда в данных."""
    changes = [data[i+1] - data[i] for i in range(len(data)-1)]
    signals = [quantize(1 if x > 0 else (0 if x == 0 else -1)) for x in changes]
    return sum(signals) / len(signals)

