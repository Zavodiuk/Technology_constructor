def drone_decision(obstacle_distance, battery, signal_strength):
    """Принятие решений для автономного дрона."""
    d = quantize(obstacle_distance / 10)
    b = quantize(battery / 100)
    s = quantize(signal_strength / 100)
    if d == 1 and b == 1 and s == 1:
        return "PROCEED"
    if d == -1 or b == -1 or s == -1:
        return "RETURN_TO_BASE"
    return "HOVER_AND_WAIT"

# ============================================================================
# 12. ЛОГИСТИКА И МАРШРУТИЗАЦИЯ
# ============================================================================

def route_decision(traffic, distance, cost):
    """Выбор маршрута на основе трафика, расстояния и стоимости."""
    t = quantize(1 - traffic)
    d = quantize(1 - distance / 100)
    c = quantize(1 - cost / 1000)
    return (t + d + c) >= 1

