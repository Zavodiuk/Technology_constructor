def recommend_product(product, user):
    """Персональная рекомендация товара."""
    vec = (
        quantize(user.get('rating', 3) / 5),
        quantize(user.get('budget', 100) / product.get('price', 100)),
        quantize(product.get('popularity', 50) / 100)
    )
    return sum(vec) >= 1

# ============================================================================
# 19. ФИЛЬТРАЦИЯ ДАННЫХ (УДАЛЕНИЕ ШУМА)
# ============================================================================

def filter_noise(raw_data):
    """Фильтрация данных с удалением шума."""
    filtered = []
    for x in raw_data:
        q = quantize(x)
        if q != 0:
            filtered.append(q)
    return filtered

# ============================================================================
# 20. ПРОСТАЯ ЭКСПЕРТНАЯ СИСТЕМА
# ============================================================================

def expert_system(rules, facts):
    """Лёгкая экспертная система на троичной логике."""
    results = []
    for rule in rules:
        matches = [facts.get(cond, 0) for cond in rule['conditions']]
        confidence = ternary_fold(tuple(matches))
        if confidence == 1:
            results.append(rule['conclusion'])
    return results if results else "НЕТ РЕШЕНИЯ"

