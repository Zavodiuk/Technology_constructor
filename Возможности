def access_decision(user_role, file_class, time_of_day):
    """Контроль доступа на основе роли, класса файла и времени."""
    vec = (
        quantize(user_role),
        quantize(file_class),
        quantize(time_of_day)
    )
    decision = ternary_fold(vec)
    if decision == 1: return "✅ ДОСТУП РАЗРЕШЁН"
    if decision == 0: return "🔒 ОГРАНИЧЕННЫЙ ДОСТУП"
    return "🚫 ДОСТУП ЗАПРЕЩЁН"

