def npc_decision(player_distance, health, ammo):
    """Поведение NPC в игре."""
    d = quantize(1 - player_distance / 100)
    h = quantize(health / 100)
    a = quantize(ammo / 100)
    if d == 1 and h == 1 and a == 1:
        return "ATTACK"
    if d == -1 or h == -1 or a == -1:
        return "RETREAT"
    return "HOLD_POSITION"

