def node_reliability(metrics):
    """Оценка надёжности узла."""
    vec = (
        quantize(metrics.get('uptime', 0.5)),
        quantize(1 - metrics.get('latency', 0.5)),
        quantize(metrics.get('stake', 0.5)),
        quantize(metrics.get('success_rate', 0.5))
    )
    return ternary_fold(vec)  # +1 надёжен, 0 нейтрален, -1 ненадёжен

