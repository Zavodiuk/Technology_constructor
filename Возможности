def medical_triage(pain_level, temperature, is_chronic):
    """Сортировка пациентов по срочности."""
    severity = quantize(pain_level / 10)
    urgency = quantize(temperature / 40)
    chronic = quantize(1 if is_chronic else 0)
    if severity == 1 and urgency == 1:
        return "🔴 КРАСНЫЙ (немедленно)"
    if severity == -1 and urgency == -1:
        return "🟢 ЗЕЛЁНЫЙ (планово)"
    return "🟡 ЖЁЛТЫЙ (наблюдение)"

