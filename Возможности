# 9. ПЛАНИРОВЩИК ЗАДАЧ (ОС)
# ============================================================================

def schedule_tasks(tasks):
    """Выбирает задачу с наивысшим приоритетом."""
    for t in tasks:
        vec = (
            quantize(1 - t.get('cpu_usage', 0.5)),
            quantize(1 - t.get('mem_usage', 0.5)),
            quantize(t.get('priority', 0.5)),
            quantize(1 - t.get('io_wait', 0.5))
        )
        t['score'] = ternary_fold(vec)
    best = max(tasks, key=lambda t: t['score'])
    return best.get('name', 'unknown')

# ============================================================================
# 10. ОЦЕНКА РИСКОВ (ФИНАНСЫ)
# ============================================================================

def risk_level(value_at_risk, volatility, liquidity):
    """Оценка финансового риска."""
    risk = quantize(1 - value_at_risk) + quantize(1 - volatility) + quantize(liquidity)
    if risk >= 1: return 1
    if risk <= -1: return -1
    return 0

