# 1. ИНТЕЛЛЕКТУАЛЬНЫЕ АССИСТЕНТЫ (ЧАТ-БОТЫ)
# ============================================================================

def classify_query(text):
    """Классифицирует запрос пользователя."""
    has_subject = any(w in text for w in ['телефон','ноутбук','компьютер'])
    has_criteria = any(w in text for w in ['камера','цена','память','скорость'])
    has_constraint = any(w in text for w in ['до','бюджет','хочу','нужен'])
    coverage = (has_subject + has_criteria + has_constraint) / 3
    l3 = quantize(coverage)
    if l3 == 1: return "✅ ПРЯМОЙ ОТВЕТ: Отвечаю напрямую"
    if l3 == 0: return "❓ УТОЧНЕНИЕ: Уточните, что именно"
    return "⚠️ КОНФЛИКТ: Противоречие в запросе"

# ============================================================================
# 2. СЖАТИЕ ИЗОБРАЖЕНИЙ
# ============================================================================

def compress_image(pixels):
    """Сжимает изображение (2 бита/пиксель, до 4x)."""
    import numpy as np
    trits = np.vectorize(quantize)(pixels)  # -1,0,1
    codes = np.where(trits == -1, 0, np.where(trits == 1, 2, 1))
    packed = bytearray()
    for i in range(0, len(codes), 4):
        byte = 0
        for j in range(4):
            if i + j < len(codes):
                byte |= (codes[i+j] & 0x03) << (6 - j*2)
        packed.append(byte)
    return packed

# ============================================================================
# 3. СЖАТИЕ ВИДЕО (ПОКАДРОВО)
# ============================================================================

def compress_video(input_path, output_path):
    """Сжимает видео через H.264 с 3 градациями."""
    import cv2
    import numpy as np
    cap = cv2.VideoCapture(input_path)
    fps = cap.get(cv2.CAP_PROP_FPS)
    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    out = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (w,h), False)
    while True:
        ret, frame = cap.read()
        if not ret: break
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        quant = np.vectorize(quantize)(gray / 255.0)
        restored = np.where(quant == -1, 0, np.where(quant == 1, 255, 128)).astype(np.uint8)
        out.write(restored)
    cap.release()
    out.release()

