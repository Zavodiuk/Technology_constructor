class PentarnyUniverseV16:
    def __init__(self, dimensions: tuple, node_coords: dict):
        self.dimensions = dimensions
        self.tensor_field = PentarnyTensorField(dimensions)
        self.tensor_evolution = PentarnyTensorEvolution(self.tensor_field)
        self.graph = PentarUniverseGraph()
        self.node_coords = node_coords

        # Инициализация двух независимых плавающих запятых (аттракторов)
        # Располагаем их на противоположных участках пространства
        mid_d = [dim // 2 for dim in dimensions]
        self.attractor_alpha = ConflictAttractor("Альфа", tuple(mid_d), dimensions)
        
        beta_coords = [dim - 1 if dim > 1 else 0 for dim in dimensions]
        self.attractor_beta = ConflictAttractor("Бета", tuple(beta_coords), dimensions)

    def add_node(self, name: str, coords: tuple):
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str):
        self.graph.add_edge(src, tgt)

    def step(self):
        # 1. Шаг микро-динамики графовой сети (V10.2)
        self.graph.pulse()
        
        # 2. Проецирование решений узлов графа в тензорное поле (Граф -> Поле)
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_field.inject_quantum_impulse(coords, impulse_val)
        
        # 3. Распространение волн от узлов в макро-среде (V11)
        for name, coords in self.node_coords.items():
            self.tensor_evolution.propagate_wave(coords, radius=1)

        # 4. Взаимное излучение импульсов от двух плавающих запятых (Аттракторов)
        alpha_pos = tuple(self.attractor_alpha.coords)
        beta_pos = tuple(self.attractor_beta.coords)
        
        self.tensor_field.inject_quantum_impulse(alpha_pos, 2)
        self.tensor_field.inject_quantum_impulse(beta_pos, -2)
        
        self.tensor_evolution.propagate_wave(alpha_pos, radius=1)
        self.tensor_evolution.propagate_wave(beta_pos, radius=1)

        # 5. Анализ градиентов и дрейф аттракторов по внутренним конфликтам
        gradients = self.tensor_evolution.calculate_field_gradient()
        self.attractor_alpha.drift_by_conflict(self.tensor_field.field, gradients)
        self.attractor_beta.drift_by_conflict(self.tensor_field.field, gradients)

        # 6. Обратная связь тензорного поля на каналы графа (Поле -> Граф)
        field_divergence = self.tensor_evolution.calculate_field_divergence()
        for edge in self.graph.edges:
            edge.energy_flow = max(0.0, edge.energy_flow * (1.0 - (field_divergence * 0.01)))

    def display_state(self):
        print(f"\n================ [ СИНХРО-ТАКТ V16: {self.graph.time_step} ] ================")
        print(f"  -> Энтропия тензорного поля: {self.tensor_field.calculate_field_entropy():.4f}")
        print(f"  -> Дивергенция поля: {self.tensor_evolution.calculate_field_divergence():.2f}")
        print(f"  -> Координаты аттрактора [Альфа]: {self.attractor_alpha.coords}")
        print(f"  -> Координаты аттрактора [Бета]:  {self.attractor_beta.coords}")
        print("--- СОСТОЯНИЕ УЗЛОВ И КАНАЛОВ ---")
        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({PENTAR_CODE[node.decision][:20]}...) | МАССА = {node.mass:.2f}")
        for edge in self.graph.edges:
            print(f"  -> Канал [{edge.source.node_id} -> {edge.target.node_id}]: ПОТОК = {edge.energy_flow:.2f}, ТЕМП = {edge.temp:.2f}")


