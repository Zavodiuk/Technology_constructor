class ConflictAttractor:
    """
    Представляет собой «плавающую запятую», которая перемещается в пространстве
    тензорного поля исключительно под воздействием зон напряжения, локальных
    конфликтов и градиентов энтропии.
    """
    def __init__(self, name: str, initial_coords: tuple, field_dims: tuple):
        self.name = name
        self.coords = list(initial_coords)
        self.field_dims = field_dims
        self.drift_history = [tuple(self.coords)]

    def drift_by_conflict(self, tensor_field: np.ndarray, gradient_fields: list):
        """
        Сканирует окрестности и смещает координаты аттрактора в сторону 
        наибольшего градиента возмущений (конфликтных зон).
        """
        dims = len(self.field_dims)
        best_coords = list(self.coords)
        max_tension = -1.0

        # Оцениваем соседние точки (по горизонтали, вертикали и глубине осей)
        for d in range(dims):
            for delta in [-1, 1]:
                test_coords = list(self.coords)
                test_coords[d] += delta
                
                # Проверка выхода за границы тензорного пространства
                if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                    # Вычисляем напряжение на основе абсолютного значения тензора и градиента
                    local_val = abs(tensor_field[tuple(test_coords)])
                    grad_val = sum(abs(gradient_fields[i][tuple(test_coords)]) for i in range(dims))
                    tension = local_val + grad_val

                    if tension > max_tension:
                        max_tension = tension
                        best_coords = test_coords

        self.coords = best_coords
        self.drift_history.append(tuple(self.coords))


