def safe_zlib_decompress(compressed_bytes: bytes, max_mb: int = 50) -> bytes:
    """Безопасная распаковка с защитой от zlib-бомб и исчерпания памяти."""
    max_bytes = max_mb * 1024 * 1024
    decompressor = zlib.decompressobj()
    data = decompressor.decompress(compressed_bytes, max_bytes)
    
    if decompressor.unconsumed_tail or decompressor.unused_data:
        raise ValueError("Превышен лимит выделения памяти: пакет заблокирован защитой.")
    return data


def restored_data_triage(raw_json_bytes: bytes, expected_size: int, decompressed_size: int) -> dict:
    """Десериализация, проверка целостности и финальный триаж данных."""
    try:
        restored_data = json.loads(raw_json_bytes.decode("utf-8"))
        return {
            "decoder_status": "SUCCESS",
            "integrity_check": {
                "expected_size_bytes": expected_size,
                "restored_size_bytes": decompressed_size,
                "match": expected_size == decompressed_size
            },
            "restored_matrices": restored_data
        }
    except json.JSONDecodeError as jde:
        raise HTTPException(
            status_code=422,
            detail=f"Ошибка структуры данных при десериализации кадра: {jde}"
        )
    except Exception as e:
        raise HTTPException(
            status_code=400,
            detail=f"Критический сбой триажа декодера: {e}"
        )


