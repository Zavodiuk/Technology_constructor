class PentarnyUniverseV20:
    def __init__(self, dimensions: Tuple[int, ...], node_coordinates: Dict[str, Tuple[int, ...]]):
        self.dimensions = dimensions
        self.tensor_field = PentarnyTensorField(dimensions)
        self.tensor_evolution = PentarnyTensorEvolution(self.tensor_field)
        self.graph = PentarUniverseGraph()
        self.node_coords = node_coordinates

        max_idx = dimensions[0] - 1
        mid = dimensions[0] // 2
        
        # Инициализация 4 вершин тетраэдральной капсулы в 4D пространстве
        p1 = (0, 0, 0, 0)
        p2 = (max_idx, max_idx, 0, 0)
        p3 = (max_idx, 0, max_idx, 0)
        p4 = (mid, mid, mid, max_idx)
        
        self.capsule = TetrahedralConfinedCapsule(dimensions, p1, p2, p3, p4)

    def add_node(self, name: str, coords: Tuple[int, ...]) -> None:
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str) -> None:
        self.graph.add_edge(src, tgt)

    def step(self) -> None:
        # := Моржовый захват тактовой энтропии
        active_entropy := self.tensor_field.calculate_field_entropy()

        self.graph.pulse()

        for name, node in self.graph.nodes.items():
            if name in self.node_coords and not node.isolated:
                coords = self.node_coords[name]
                if node.decision != 0:
                    self.tensor_field.inject_quantum_impulse(coords, int(node.decision))

        for name, coords in self.node_coords.items():
            if not self.graph.nodes[name].isolated:
                self.tensor_evolution.propagate_wave(coords, radius=1)

        # Эволюция тетраэдральной капсулы конфайнмента
        gradients = self.tensor_evolution.calculate_field_gradient()
        self.capsule.evolve_capsule(self.tensor_field.field, gradients)
        self.capsule.enforce_containment(self.tensor_field, self.tensor_evolution, self.graph, self.node_coords)

    def display_telemetry(self) -> None:
        va, vb, vc, vd = self.capsule.get_vertices()
        print(f"\n================ [ ТАКТ V20: СИНХРОН №{self.graph.time_step} ] ================")
        print(f"  -> Энтропия среды: {self.tensor_field.calculate_field_entropy():.6f}")
        print(f"  -> Тетраэдральная капсула [Alpha..Delta]:")
        print(f"     {va} | {vb} | {vc} | {vd}")
        print("--- СОСТОЯНИЕ УЗЛОВ И КАПСУЛЯЦИИ ---")
        for name, node in self.graph.nodes.items():
            status = "💊 ИЗОЛИРОВАН В КАПСУЛЕ" if node.isolated else f"Активен ({node.decision:+d})"
            print(f"  -> Узел [{name}]: {status} | Масса = {node.mass:.2f}")


