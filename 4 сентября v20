class TetrahedralVertex:
    """Вершина тетраэдральной капсулы, дрейфующая по градиентам напряжения."""
    def __init__(self, name: str, initial_coords: Tuple[int, ...], field_dims: Tuple[int, ...]):
        self.name = name
        self.coords = list(initial_coords)
        self.field_dims = field_dims

    def drift(self, tensor_field: np.ndarray, gradient_fields: List[np.ndarray]) -> None:
        dims = len(self.field_dims)
        best_coords = list(self.coords)
        max_tension = -999.0

        for d in range(dims):
            for delta in [-1, 1]:
                test_coords = list(self.coords)
                test_coords[d] += delta
                
                if all(0 <= test_coords[i] < self.field_dims[i] for i in range(dims)):
                    local_val = abs(tensor_field[tuple(test_coords)])
                    grad_val = sum(abs(gradient_fields[i][tuple(test_coords)]) for i in range(dims))
                    tension = local_val + (grad_val * 2.0)

                    if tension > max_tension:
                        max_tension = tension
                        best_coords = test_coords

        self.coords = best_coords


class TetrahedralConfinedCapsule:
    """
    Объемная тетраэдральная капсула изоляции из 4 вершин (Alpha, Beta, Gamma, Delta).
    Защищена круглыми скобками `()` конфайнмента среды.
    """
    def __init__(self, field_dims: Tuple[int, ...], p1: tuple, p2: tuple, p3: tuple, p4: tuple):
        self.field_dims = field_dims
        self.v_alpha = TetrahedralVertex("Alpha", p1, field_dims)
        self.v_beta = TetrahedralVertex("Beta", p2, field_dims)
        self.v_gamma = TetrahedralVertex("Gamma", p3, field_dims)
        self.v_delta = TetrahedralVertex("Delta", p4, field_dims)

    def evolve_capsule(self, tensor_field: np.ndarray, gradients: List[np.ndarray]) -> None:
        self.v_alpha.drift(tensor_field, gradients)
        self.v_beta.drift(tensor_field, gradients)
        self.v_gamma.drift(tensor_field, gradients)
        self.v_delta.drift(tensor_field, gradients)

    def get_vertices(self) -> Tuple[tuple, tuple, tuple, tuple]:
        return (
            tuple(self.v_alpha.coords), 
            tuple(self.v_beta.coords), 
            tuple(self.v_gamma.coords), 
            tuple(self.v_delta.coords)
        )

    def enforce_containment(self, tensor_field: PentarnyTensorField, evolution: PentarnyTensorEvolution, graph: PentarUniverseGraph, node_coords: Dict[str, Tuple[int, ...]]) -> None:
        va = tuple(self.v_alpha.coords)
        vb = tuple(self.v_beta.coords)
        vc = tuple(self.v_gamma.coords)
        vd = tuple(self.v_delta.coords)

        # Инъекция защитных экранирующих импульсов по вершинам тетраэдра
        tensor_field.inject_quantum_impulse(va, -2)
        tensor_field.inject_quantum_impulse(vb, -2)
        tensor_field.inject_quantum_impulse(vc, -2)
        tensor_field.inject_quantum_impulse(vd, -2)

        evolution.propagate_wave(va, radius=1)
        evolution.propagate_wave(vb, radius=1)
        evolution.propagate_wave(vc, radius=1)
        evolution.propagate_wave(vd, radius=1)

        # Проверка и изоляция узлов, попавших внутрь тетраэдрального объема
        # (упрощенная геометрическая проверка bounding box по вершинам)
        all_coords = np.array([va, vb, vc, vd])
        min_b = np.min(all_coords, axis=0)
        max_b = np.max(all_coords, axis=0)

        for name, node in graph.nodes.items():
            if name in node_coords:
                n_coords = np.array(node_coords[name])
                if np.all(n_coords >= min_b) and np.all(n_coords <= max_b):
                    node.isolated = True
                else:
                    node.isolated = False


