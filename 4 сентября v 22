# МОДУЛЬ 3: ОРКЕСТРАТОР ФАЗОВОГО МУАРА И РЕДУКТОРА V22
# ============================================================================
class MoiréPhaseReducerV22:
    """
    Интегрированный контур фазового редуктора. Сопоставляет вращающееся тернарное ядро 
    с внешним пентарным полем через оператор порогового барьера (:).
    """
    def __init__(self, macro_field_dims: Tuple[int, int] = (7, 7)):
        self.macro_field = PentarnyMacroField(macro_field_dims)
        self.ternary_core = RotatingTernaryCore(size=3)
        self.time_step: int = 0
        self.gate_transmission_state: int = 0

    def evaluate_phase_gate(self) -> Tuple[int, int, float]:
        """
        Вычисление точки интерференционного муара: умножение вращающегося 
        тернарного значения на подмножество внешнего пентарного поля.
        """
        self.time_step += 1
        self.ternary_core.rotate_step()
        
        # Центр взаимодействия полей
        center = (self.macro_field.dimensions[0] // 2, self.macro_field.dimensions[1] // 2)
        macro_slice = self.macro_field.get_field_slice(center, radius=1)
        
        interaction_sum = 0
        match_count = 0
        
        # Попиксельное перекрытие матриц с учетом вращения тернарного слоя
        for tx in range(3):
            for ty in range(3):
                t_val = self.ternary_core.get_effective_state_at((tx, ty))
                if tx < macro_slice.shape[0] and ty < macro_slice.shape[1]:
                    p_val = macro_slice[tx, ty]
                    # Фазовое перемножение (муар-эффект)
                    product_val = t_val * p_val
                    interaction_sum += product_val
                    if t_val == p_val:
                        match_count += 1

        # `:` — пороговый барьер фильтрации редуктора
        if interaction_sum > 5:
            self.gate_transmission_state = 2  # Резонансное открытие
        elif interaction_sum > 0:
            self.gate_transmission_state = 1  # Мягкий пропуск
        elif interaction_sum == 0:
            self.gate_transmission_state = 0  # Ламинарный баланс
        elif interaction_sum >= -5:
            self.gate_transmission_state = -1 # Демпфирование
        else:
            self.gate_transmission_state = -2 # Аппаратный обрыв муара

        coherence_factor = float(match_count / 9.0)
        return self.gate_transmission_state, interaction_sum, coherence_factor

    def display_telemetry(self) -> None:
        state, sum_val, coherence = self.evaluate_phase_gate()
        angle_deg = math.degrees(self.ternary_core.rotation_angle_rad)
        print(f"\n================ [ МУАР-ТАКТ V22: ШАГ №{self.time_step} ] ================")
        print(f"  -> Угол вращения тернарного ядра: {angle_deg:.1f}°")
        print(f"  -> Интегральный индекс муара (Σ): {sum_val:+d}")
        print(f"  -> Коэффициент фазовой когерентности: {coherence:.2f}")
        print(f"  -> Состояние полевого шлюза: {state:+d} ({PENTAR_CODE[state]})")


