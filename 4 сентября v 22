# МОДУЛЬ 2: ВНУТРЕННЕЕ ВРАЩАЮЩЕЕСЯ ТЕРНАРНОЕ ЯДРО ( {} )
# ============================================================================
class RotatingTernaryCore:
    """
    Симметричное тернарное ядро [-1, 0, 1], совершающее угловое вращение 
    внутри пентарного макро-поля с генерацией эффекта фазового муара.
    """
    def __init__(self, size: int = 3):
        self.size = size
        self.core_matrix = np.zeros((size, size), dtype=int)
        # Заполнение симметричной тернарной структуры
        mid = size // 2
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid:
                    self.core_matrix[x, y] = 0
                elif (x + y) % 2 == 0:
                    self.core_matrix[x, y] = 1
                else:
                    self.core_matrix[x, y] = -1
        
        self.rotation_angle_rad: float = 0.0
        self.angular_velocity: float = math.pi / 6.0  # Шаг вращения 30 градусов

    def rotate_step(self) -> None:
        """Поворот тернарного ядра на один дискретный угловой шаг."""
        self.rotation_angle_rad += self.angular_velocity
        if self.rotation_angle_rad >= 2 * math.pi:
            self.rotation_angle_rad = 0.0

    def get_effective_state_at(self, local_coord: Tuple[int, int]) -> int:
        """Расчет проекции ядра с учетом угла поворота (тригонометрический маппинг)."""
        x, y = local_coord
        mid = self.size // 2
        ox, oy = x - mid, y - mid
        
        # Применение матрицы поворота 2D
        cos_a = math.cos(self.rotation_angle_rad)
        sin_a = math.sin(self.rotation_angle_rad)
        
        rx = int(round(ox * cos_a - oy * sin_a))
        ry = int(round(ox * sin_a + oy * cos_a))
        
        tx = max(0, min(self.size - 1, rx + mid))
        ty = max(0, min(self.size - 1, ry + mid))
        
        return int(self.core_matrix[tx, ty])


