TERNARY_BASIS: List[int] = [1, 0, -1]  # Симметричное ядро
PENTAR_BASIS: List[int] = [2, 1, 0, -1, -2]  # Внешнее макро-поле

PENTAR_CODE: Dict[int, str] = {
    -2: "КАТЕГОРИЧЕСКОЕ НЕТ (Аппаратная блокировка / Обрыв фазы)",
    -1: "МЯГКОЕ НЕТ (Демпфирование потока)",
     0: "НЕОПРЕДЕЛЕННОСТЬ / ПОКОЙ (Ламинарный фазовый ноль)",
     1: "МЯГКОЕ ДА (Индукционный подъем)",
     2: "КАТЕГОРИЧЕСКОЕ ДА (Резонансная сверхпроводимость)"
}


