# --- БАЗИС И СЛОВАРИ ТРОИЧНОЙ ЛОГИКИ ---
LOGIC_BASIS = np.array([1, 0, -1], dtype=np.int8)

TERNARY_CODE = {
    -1: "ЛОЖЬ / БЛОКИРОВКА (Отрицательный фронт / Обрыв канала)",
     0: "НЕОПРЕДЕЛЕННОСТЬ / ПОКОЙ (Свободный транзит / Баланс)",
     1: "ИСТИНА / АКТИВАЦИЯ (Положительный фронт / Сверхпроводимость)"
}

def quantize_ternary(value: float) -> np.int8:
    """Квантование непрерывного значения в строгий троичный базис [-1, 1]"""
    if value > 0.33:
        return np.int8(1)
    elif value >= -0.33:
        return np.int8(0)
    else:
        return np.int8(-1)

def ternary_clip(val: int) -> np.int8:
    """Строгое ограничение в рамках троичного базиса [-1, 1]"""
    return np.int8(max(-1, min(1, val)))


