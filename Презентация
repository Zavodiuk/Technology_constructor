    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0B0D11;
            --panel: #14161B;
            --panel-hi: #1C1F26;
            --line: #2C3038;
            --text: #EAE8E3;
            --text-dim: #8A8F99;
            --plus: #4ADE80;
            --zero: #FBBF24;
            --minus: #F87171;
            --mono: 'IBM Plex Mono', monospace;
            --sans: 'Manrope', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--sans);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .slide-container {
            width: 100%;
            max-width: 1100px;
            height: 90vh;
            max-height: 700px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 20px 40px;
            position: relative;
            background: var(--panel);
            border-radius: 20px;
            border: 1px solid var(--line);
            box-shadow: 0 20px 60px rgba(0,0,0,0.8);
            transition: background 0.3s;
        }

        .slide {
            display: none;
            flex-direction: column;
            justify-content: center;
            height: 100%;
            animation: fade 0.4s ease;
        }
        .slide.active { display: flex; }

        @keyframes fade {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide h1 {
            font-size: 42px;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.2;
            margin-bottom: 12px;
        }
        .slide h1 .highlight {
            background: linear-gradient(135deg, var(--plus), var(--zero));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .slide h2 {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 16px;
        }
        .slide p {
            font-size: 18px;
            color: var(--text-dim);
            max-width: 720px;
            line-height: 1.6;
        }
        .slide .sub {
            font-size: 14px;
            color: var(--text-dim);
            margin-top: 8px;
            font-family: var(--mono);
        }
        .slide ul {
            list-style: none;
            padding: 0;
            margin: 12px 0;
        }
        .slide ul li {
            font-size: 17px;
            padding: 6px 0;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
        }
        .slide ul li::before {
            content: "▹";
            color: var(--zero);
            font-size: 18px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px 30px;
            margin: 10px 0;
        }
        .grid-2 .item {
            background: var(--panel-hi);
            padding: 14px 18px;
            border-radius: 10px;
            border: 1px solid var(--line);
        }
        .grid-2 .item strong { color: var(--text); display: block; font-size: 16px; }
        .grid-2 .item span { color: var(--text-dim); font-size: 14px; }

        .badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 16px;
            margin: 12px 0;
        }
        .badge {
            font-family: var(--mono);
            font-size: 13px;
            color: var(--text-dim);
            background: var(--panel-hi);
            padding: 4px 14px;
            border-radius: 40px;
            border: 1px solid var(--line);
        }

        .nav {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
            align-items: center;
            background: var(--panel-hi);
            padding: 8px 18px;
            border-radius: 40px;
            border: 1px solid var(--line);
            z-index: 10;
        }
        .nav button {
            background: none;
            border: none;
            color: var(--text);
            font-size: 20px;
            cursor: pointer;
            padding: 0 8px;
            transition: color .2s;
        }
        .nav button:hover { color: var(--zero); }
        .nav .counter {
            font-family: var(--mono);
            font-size: 13px;
            color: var(--text-dim);
            min-width: 50px;
            text-align: center;
        }

        .l3-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--plus);
            margin-right: 8px;
            box-shadow: 0 0 12px rgba(74,222,128,.4);
