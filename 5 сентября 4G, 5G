class CellularOFDMTransport:
    """Моделирование сотового радиоинтерфейса OFDM (4G+/5G) с маппингом поднесущих и интерференцией."""
    
    LEVEL_MAP = {-2: 0.1, -1: 0.3, 0: 0.5, 1: 0.7, 2: 0.9}
    INV_MAP = {0.1: -2, 0.3: -1, 0.5: 0, 0.7: 1, 0.9: 2}

    @staticmethod
    def modulate_ofdm(data_bytes: bytes) -> List[float]:
        subcarriers = []
        for b in data_bytes:
            val = int((b / 51.0) - 2)
            val = max(-2, min(2, val))
            subcarriers.append(CellularOFDMTransport.LEVEL_MAP[val])
        return subcarriers

    @staticmethod
    def transmit_cellular_channel(subcarriers: List[float], multipath_noise: float = 0.04) -> List[float]:
        transmitted = []
        n = len(subcarriers)
        for i, amp in enumerate(subcarriers):
            # Рэлеевские замирания и межсимвольная интерференция соседних поднесущих OFDM
            fading = np.random.normal(0, multipath_noise)
            neighbor_ ISI = 0.0
            if i > 0: neighbor_ ISI += subcarriers[i-1] * 0.02
            if i < n - 1: neighbor_ ISI += subcarriers[i+1] * 0.02
            
            corrupted = amp + neighbor_ ISI + fading
            transmitted.append(max(0.05, min(0.95, corrupted)))
        return transmitted

    @staticmethod
    def demodulate_ofdm(subcarriers: List[float]) -> bytes:
        out_bytes = bytearray()
        standard_levels = list(CellularOFDMTransport.INV_MAP.keys())
        for amp in subcarriers:
            closest = min(standard_levels, key=lambda l: abs(l - amp))
            val = CellularOFDMTransport.INV_MAP[closest]
            out_bytes.append(int((val + 2) * 51) & 0xFF)
        return bytes(out_bytes)


