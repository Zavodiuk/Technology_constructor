class ShannonBitPerfectCodec:
    @staticmethod
    def calculate_entropy(data: bytes) -> float:
        if not data: return 0.0
        arr_u8 = np.frombuffer(data, dtype=np.uint8)
        return float(_njit_shannon_entropy(arr_u8))

    @staticmethod
    def compress(data: bytes) -> bytes:
        if HAS_ZSTD:
            return zstd.ZstdCompressor(level=3, threads=-1).compress(data)
        return zlib.compress(data, level=6)

    @staticmethod
    def decompress(compressed_data: bytes) -> bytes:
        if HAS_ZSTD:
            return zstd.ZstdDecompressor().decompress(compressed_data)
        return zlib.decompress(compressed_data)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_stride_collapse_to_120(arr_u8: np.ndarray) -> np.ndarray:
    n = arr_u8.size
    out = np.zeros(DIM_120, dtype=np.float64)
    if n <= DIM_120:
        for i in range(n):
            out[i % DIM_120] = float(arr_u8[i])
    else:
        chunk_size = n // DIM_120
        for i in range(DIM_120):
            start = i * chunk_size
            end = start + chunk_size if i < DIM_120 - 1 else n
            s = 0.0
            for j in range(start, end):
                s += float(arr_u8[j])
            out[i] = s / float(end - start)
    return out


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_rashomon_evaluate_120d(matrix_120d: np.ndarray, out_results: np.ndarray):
    rows = matrix_120d.shape[0]
    cols = matrix_120d.shape[1]
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = matrix_120d[i, 0]
        max_val = matrix_120d[i, 0]
        for j in range(cols):
            val = matrix_120d[i, j]
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val: min_val = val
            if val > max_val: max_val = val
        mean_val = sum_val / cols
        var_sum = 0.0
        for j in range(cols):
            val = matrix_120d[i, j]
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        out_results[i, 0] = mean_val
        out_results[i, 1] = min_val
        out_results[i, 2] = max_val
        out_results[i, 3] = std_val
        out_results[i, 4] = -(abs_sum_val / cols) - (std_val * 0.15)


