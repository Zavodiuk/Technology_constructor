@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_shannon_entropy(arr_u8: np.ndarray) -> float:
    """Вычисление энтропии Шеннона на чистом машинном коде Numba без циклов Python."""
    length = arr_u8.size
    if length == 0:
        return 0.0
    counts = np.zeros(256, dtype=np.int64)
    for i in range(length):
        counts[arr_u8[i]] += 1
    
    entropy = 0.0
    f_len = float(length)
    for c in counts:
        if c > 0:
            p = float(c) / f_len
            entropy -= p * np.log2(p)
    return entropy


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_pythagorean_lock(leg3: float, leg4: float) -> float:
    """Священный египетский треугольник 3-4-5: аппаратный расчет гипотенузы для фазового замка."""
    hypot_sq = leg3 * leg3 + leg4 * leg4
    return np.sqrt(hypot_sq) / 5.0


