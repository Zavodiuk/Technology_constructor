    ok = run_self_checks()
    if not ok:
        print("\nОстановлено: самопроверка провалена после слияния в один файл.")
        sys.exit(1)

    compare_behavior()

    if "--benchmark" in sys.argv:
        benchmark_speed()

    print("\n✅ Единый файл: демонстрация завершена")
