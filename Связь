// Шаг 4 (финал): Контур «Гармония» для радио и космической связи
class HarmoniaCosmicTransmissionCore(private val arbiter: CosmicReshimonArbiter) {
    private val ternaryWeight = 0.20
    private val pentanaryWeight = 0.30
    private val matrixWeight = 0.50

    fun transmitCosmicData(
        radioTrits: List<Int>,
        cosmicTree: LomonosovCosmicTree,
        matrixChecksums: List<Double>,
        radiationLevel: Int
