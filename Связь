        val cosmicBalanceFactor = (radioTrits.size * ternaryWeight) +
                                  (cosmicTree.getTotalCosmicWeight() * pentanaryWeight) +
                                  (totalChecksum * matrixWeight)

        return finalizeCosmicStream(cosmicBalanceFactor)
