def main():
    parser = argparse.ArgumentParser(
        description="Троичное квантование медиа — сжатие изображений и видео (Block X)",
        epilog="Полную документацию см. в начале файла."
    )
    subparsers = parser.add_subparsers(dest='command', help='Команды')

    # ---- Изображения ----
    img_parser = subparsers.add_parser('image', help='Работа с изображениями')
    img_subparsers = img_parser.add_subparsers(dest='action', help='Действие')

    compress_img = img_subparsers.add_parser('compress', help='Сжать одно изображение')
    compress_img.add_argument('--input', required=True, help='Входной файл')
    compress_img.add_argument('--output', default='compressed.bin', help='Выходной .bin')
    compress_img.add_argument('--adaptive', action='store_true', help='Адаптивные пороги')
    compress_img.add_argument('--low', type=float, default=0.3, help='Нижний порог (0..1)')
    compress_img.add_argument('--high', type=float, default=0.7, help='Верхний порог (0..1)')
    compress_img.add_argument('--color', action='store_true', help='Цветной режим (RGB)')

    decompress_img = img_subparsers.add_parser('decompress', help='Восстановить изображение')
    decompress_img.add_argument('--input', required=True, help='Входной .bin')
    decompress_img.add_argument('--output', default='restored.jpg', help='Выходной файл')
    decompress_img.add_argument('--width', type=int, help='Ширина (если не указана в заголовке)')
    decompress_img.add_argument('--height', type=int, help='Высота (если не указана)')

    batch = img_subparsers.add_parser('batch', help='Пакетная обработка папки')
    batch.add_argument('--input-dir', required=True, help='Папка с изображениями')
    batch.add_argument('--output-dir', required=True, help='Папка для .bin файлов')
    batch.add_argument('--adaptive', action='store_true', help='Адаптивные пороги')
    batch.add_argument('--color', action='store_true', help='Цветной режим')

    # ---- Видео ----
    video_parser = subparsers.add_parser('video', help='Работа с видео')
    video_subparsers = video_parser.add_subparsers(dest='action', help='Действие')

    h264 = video_subparsers.add_parser('h264', help='Сжатие через H.264 (3 градации)')
    h264.add_argument('--input', required=True, help='Входное видео')
    h264.add_argument('--output', required=True, help='Выходное видео (MP4)')
    h264.add_argument('--adaptive', action='store_true', help='Адаптивные пороги')
    h264.add_argument('--low', type=float, default=0.3, help='Нижний порог')
    h264.add_argument('--high', type=float, default=0.7, help='Верхний порог')

    raw = video_subparsers.add_parser('raw', help='Сверхсжатие в RAW .bin')
    raw.add_argument('--input', required=True, help='Входное видео')
    raw.add_argument('--output', required=True, help='Выходной .bin')
    raw.add_argument('--adaptive', action='store_true', help='Адаптивные пороги')
    raw.add_argument('--low', type=float, default=0.3, help='Нижний порог')
    raw.add_argument('--high', type=float, default=0.7, help='Верхний порог')

    decode = video_subparsers.add_parser('decode', help='Декодировать RAW .bin в видео')
    decode.add_argument('--input', required=True, help='Входной .bin')
    decode.add_argument('--output', required=True, help='Выходное видео (MP4)')

    args = parser.parse_args()

    if args.command == 'image':
        if args.action == 'compress':
            stats = compress_image(args.input, args.output, adaptive=args.adaptive,
                                   low=args.low, high=args.high, color=args.color)
            print(f"Сжато: {stats['orig_bytes']} -> {stats['comp_bytes']} байт, коэф. {stats['ratio']:.2f}x")
            print(f"Пороги: low={stats['low']:.2f}, high={stats['high']:.2f}")
        elif args.action == 'decompress':
            decompress_image(args.input, args.output, args.width, args.height)
        elif args.action == 'batch':
            batch_compress_images(args.input_dir, args.output_dir, adaptive=args.adaptive, color=args.color)
        else:
            parser.print_help()

    elif args.command == 'video':
        if args.action == 'h264':
            compress_video_h264(args.input, args.output, low=args.low, high=args.high, adaptive=args.adaptive)
        elif args.action == 'raw':
            compress_video_raw(args.input, args.output, low=args.low, high=args.high, adaptive=args.adaptive)
        elif args.action == 'decode':
            decode_video_raw(args.input, args.output)
        else:
            parser.print_help()
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
