    print("=" * 60)

    kernel = BXKernel()

    # --- 1. Создание процессов ---
    p1 = kernel.create_process("Анализатор")
    p2 = kernel.create_process("Планировщик_задач")
    p3 = kernel.create_process("Фоновый_монитор")
    kernel.set_priority(p1, 5)
    kernel.set_priority(p2, 3)
    kernel.set_priority(p3, 1)

    # Обновим метрики процессов (имитация их состояния)
    kernel.update_process_state(p1, [0.9, 0.8, 0.7, 0.6])  # близок к идеалу
    kernel.update_process_state(p2, [0.5, 0.5, 0.5, 0.5])  # средний
    kernel.update_process_state(p3, [0.1, 0.2, 0.3, 0.4])  # далёк от центра

    # --- 2. Rashomon-анализ готовых процессов (вход) ---
    print("\n[Тест 1] Рашимон на входе (какой процесс готов к выполнению):")
    result = kernel.rashomon_analyze_processes()
    print(f"  Состояние: {result['state']}, Лучший: {result['top']}, Причина: {result['reason']}")

    # --- 3. Работа с файловой системой ---
    print("\n[Тест 2] Файловая система:")
    data1 = b"Hello, BXOS v1.4! This is a test file."
    data2 = b"Hello, BXOS v1.4! Another file for testing."
    kernel.fs_save("doc1.txt", data1)
    kernel.fs_save("doc2.txt", data2)

    # Проверка целостности: загружаем и сравниваем хеш
    loaded1 = kernel.fs_load("doc1.txt")
    hash_orig = hashlib.sha256(data1).hexdigest()
    hash_loaded = hashlib.sha256(loaded1).hexdigest() if loaded1 else "ERROR"
    print(f"  Целостность doc1.txt: {'✅' if hash_orig == hash_loaded else '❌'} (SHA256: {hash_orig[:8]}...)")

    # Поиск похожих файлов
    similar = kernel.fs_find_similar(b"Hello, BXOS", n=2)
    print("  Похожие файлы на 'Hello, BXOS':")
    for name, dist in similar:
        print(f"    - {name} (расстояние {dist:.4f})")

    # --- 4. Планировщик ---
    print("\n[Тест 3] Планировщик (5 тиков):")
    kernel.run(steps=5)

    # --- 5. Имитация выполнения процесса и анализ выхода ---
    print("\n[Тест 4] Имитация работы процесса PID=1 и Rashomon выхода:")
    sample_output = [1, -1, 0, 1, 0]  # пример результата
    out_analysis = kernel.rashomon_analyze_output(p1, sample_output)
    print(f"  Результаты: {sample_output}")
    print(f"  Состояние: {out_analysis['state']}, Лучший критерий: {out_analysis['top']}, Причина: {out_analysis['reason']}")

    # --- 6. Статистика графа ---
    print("\n[Тест 5] Статистика гиперболического графа:")
    stats = kernel.graph.get_stats()
    print(f"  Узлов: {stats['nodes']}, Рёбер: {stats['edges']}, Среднее расстояние: {stats['avg_distance']:.3f}")

    print("\n✅ BXOS v1.4 успешно завершила демонстрацию.")
