class GeometryMode(Enum):
    EUCLIDEAN = "евклидова"
    HYPERBOLIC = "гиперболическая (Лобачевский)"
    ELLIPTIC = "эллиптическая (Риман)"


class GeometryEngine:
    def __init__(self, mode: GeometryMode = GeometryMode.HYPERBOLIC):
        self.mode = mode
        self.curvature = -1.0

    def set_mode(self, mode: GeometryMode):
        self.mode = mode
        if mode == GeometryMode.EUCLIDEAN: self.curvature = 0.0
        elif mode == GeometryMode.HYPERBOLIC: self.curvature = -1.0
        else: self.curvature = 1.0

    def distance(self, p1: Tuple[float, float], p2: Tuple[float, float]) -> float:
        dx, dy = p1[0] - p2[0], p1[1] - p2[1]
        euclidean_dist = math.sqrt(dx*dx + dy*dy)
        if self.curvature == 0: return float(euclidean_dist)
        elif self.curvature < 0: return float(math.sinh(euclidean_dist))
        else: return float(math.sin(euclidean_dist))

    def select_mode_by_task(self, query: str, interpretations: Dict[str, float]) -> GeometryMode:
        if len(interpretations) > 5: return GeometryMode.HYPERBOLIC
        if any(w in query.lower() for w in ['цикл', 'обучение', 'возврат']): return GeometryMode.ELLIPTIC
        return GeometryMode.EUCLIDEAN


@dataclass
class WaveNode:
    id: int
    amplitude: float
    phase: float
    position: Tuple[float, float]
    children: List[int] = field(default_factory=list)
    parents: List[int] = field(default_factory=list)

    def generate_wave(self, time_val: float) -> float:
        omega = 2.0
        return float(self.amplitude * math.sin(omega * time_val + self.phase))

    def spread(self, time_val: float, nodes: Dict[int, 'WaveNode'], geometry: GeometryEngine) -> Dict[int, float]:
        result = {}
        for cid in self.children:
            if cid in nodes:
                child = nodes[cid]
                dist = geometry.distance(self.position, child.position)
                attenuation = 1.0 / (1.0 + dist)
                result[cid] = self.generate_wave(time_val) * attenuation
        return result


class InterferenceMatrix:
    def __init__(self, geometry: GeometryEngine):
        self.nodes: Dict[int, WaveNode] = {}
        self.waves: Dict[int, float] = {}
        self.geometry = geometry

    def add_node(self, node: WaveNode): self.nodes[node.id] = node

    def propagate_waves(self, time_val: float) -> Dict[int, float]:
        result = {}
        for _, node in self.nodes.items():
            for cid, amp in node.spread(time_val, self.nodes, self.geometry).items():
                result[cid] = result.get(cid, 0.0) + amp
        self.waves = result
        return result

    def interference_pattern(self, time_val: float) -> Dict[int, float]:
        result = {}
        for node_id, node in self.nodes.items():
            incoming = self.waves.get(node_id, 0.0)
            own = node.generate_wave(time_val)
            result[node_id] = incoming + own
        return result

    def find_conflicts(self, time_val: float, threshold: float = 0.3) -> List[int]:
        pattern = self.interference_pattern(time_val)
        return [nid for nid, val in pattern.items() if abs(val) > threshold]

    def stability_index(self, time_val: float) -> float:
        conflicts = self.find_conflicts(time_val)
        total = len(self.nodes) if self.nodes else 1
        return 1.0 - len(conflicts) / total


class KirchhoffBalance:
    def __init__(self):
        self.cycles: List[List[int]] = []

    def find_cycles(self, graph: Dict[int, List[int]]) -> List[List[int]]:
        cycles = []
        visited = set()

        def dfs(node: int, path: List[int]):
            if node in visited:
                if len(path) > 2:
                    cycle_start = path.index(node)
                    cycles.append(path[cycle_start:])
                return
            visited.add(node)
            for neighbor in graph.get(node, []):
                if neighbor not in path or neighbor == path[0]:
                    dfs(neighbor, path + [neighbor])
            visited.remove(node)

        for node in graph:
            if node not in visited:
                dfs(node, [node])
        self.cycles = cycles
        return cycles

    def system_balance(self, waves: Dict[int, float]) -> float: return float(sum(waves.values()))
    def is_balanced(self, waves: Dict[int, float], tolerance: float = 0.01) -> bool:
        return abs(self.system_balance(waves)) < tolerance


class LomonosovSpiral:
    def __init__(self):
        self.history: List[Dict] = []
        self.spiral_level = 0
        self.direction = 0

    def analyze_event(self, event: Dict) -> Dict:
        loss_val = float(event.get("loss", 0.0))
        gain_val = float(event.get("gain", 0.0))
        if gain_val > loss_val: self.direction = 1
        elif loss_val > gain_val: self.direction = -1
        else: self.direction = 0
        self.spiral_level += self.direction
        res = {
            "why": event.get("reason", "неизвестно"),
            "location": event.get("location", "GameEngine V9.6"),
            "timestamp": event.get("timestamp", time.time()),
            "loss": loss_val,
            "gain": gain_val,
            "spiral_level": self.spiral_level,
            "direction": self.direction,
            "status": "complete"
        }
        self.history.append(res)
        return res

    def get_trend(self) -> str:
        if not self.history: return "неизвестно"
        d = self.history[-1]["direction"]
        return "восходящая" if d == 1 else ("нисходящая" if d == -1 else "горизонтальная")

    def get_level(self) -> int: return self.spiral_level


