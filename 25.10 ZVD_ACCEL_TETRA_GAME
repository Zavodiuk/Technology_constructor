    system_energy: float
    bxos_digest: str
    decision: str
    latency_ms: float
    version: str = "Game V9.6 + ZVD Oct-22 Bare-Metal Monolith"


def game_to_w55_inputs(game_out: dict, interpretations: dict):
    names = list(interpretations.keys())
    scores_row = [float(interpretations[n]) for n in names[:8]]
    while len(scores_row) < 4: scores_row.append(0.5)
    
    comp = float(game_out.get("best_composite_score", 0.5))
    stab = float(game_out.get("stability_index", 0.5))
    coher = 1.0 if game_out.get("teatro", {}).get("coherence") else 0.0
    bal = 1.0 if game_out.get("is_balanced") else 0.0
    
    def to_penta(x): return max(-2, min(2, int(round(x * 4.0 - 2.0))))
    l5 = [to_penta(comp), to_penta(stab), to_penta(coher), to_penta(bal), 2]
    return [scores_row], l5, comp, 0.45


class GameW55UnifiedContour:
    def __init__(self):
        self.game = GameEngineV9Improved()
        self.w55 = W5AdaptiveProductionPipeline()

    def run(self, query: str, interpretations: dict) -> UnifiedContourResult:
        t0 = time.perf_counter()
        game_out = self.game.process(query, interpretations)
        _, l5_inputs, raw_score, stress = game_to_w55_inputs(game_out, interpretations)
        
        w55_res = self.w55.process(f"REQ-{int(time.time_ns()%1000000)}", raw_score, l5_inputs, current_stress=stress)
        
        decision = "PASS"
        if w55_res.triage_state == -1 or w55_res.status == "REJECTED_BY_TRIAGE": decision = "REJECT"
        elif w55_res.triage_state == 0 or game_out.get("best_composite_score", 0) < 0.45: decision = "CLARIFY"

        latency = (time.perf_counter() - t0) * 1000.0
        digest = w55_res.bxos_receipt.get("bxos_digest", "") if hasattr(w55_res, "bxos_receipt") and w55_res.bxos_receipt else ""

        return UnifiedContourResult(
            query=query,
            best_candidate=game_out.get("best_candidate"),
            composite_score=game_out.get("best_composite_score", 0.0),
            geometry_mode=game_out.get("geometry_mode", ""),
            leading_maschera=game_out.get("teatro", {}).get("leading_maschera"),
            stability_index=game_out.get("stability_index", 0.0),
            lomonosov_trend=game_out.get("lomonosov", {}).get("trend", ""),
            lomonosov_level=game_out.get("lomonosov", {}).get("level", 0),
            w55_status=w55_res.status,
            triage_state=w55_res.triage_state,
            active_strategy=getattr(w55_res, "active_strategy", "godel"),
            folded_result=w55_res.folded_result,
            system_energy=w55_res.system_energy,
            bxos_digest=digest,
            decision=decision,
            latency_ms=latency
        )


