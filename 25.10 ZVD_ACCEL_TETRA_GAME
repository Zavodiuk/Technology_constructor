        self.maschere.append(MascheraProfile(Maschera.INNAMORATI, "человек", "Красота?", ["красив", "привлек", "нрави"]))
        self.maschere.append(MascheraProfile(Maschera.COLOMBINA, "человек", "Истина?", ["истин", "скрыт", "реальн"]))
        self.maschere.append(MascheraProfile(Maschera.PULCINELLA, "человек", "Народ?", ["народ", "мнени", "обществ"]))
        self.maschere.append(MascheraProfile(Maschera.SCAPINO, "человек", "Гибкость?", ["гибк", "манев", "адапт"]))
        self.maschere.append(MascheraProfile(Maschera.GIANDUJA, "человек", "Искренность?", ["искренн", "честн"]))
        self.maschere.append(MascheraProfile(Maschera.BALANZONE, "власть", "Точность?", ["точн", "коррект", "формаль"]))

    def evaluate(self, facts: Dict[str, Any]) -> Dict[str, Any]:
        results = {}
        w_sum, t_w = 0.0, 0.0
        for m in self.maschere:
            if not m.active: continue
            score = m.evaluate(facts)
            weighted = score * m.weight
            results[m.name.value] = {"score": round(score, 3), "weight": m.weight, "weighted": round(weighted, 3), "group": m.group, "description": m.description}
            w_sum += weighted
            t_w += m.weight
        if t_w == 0: return {"error": "Нет активных масок"}
        scores = [r["score"] for r in results.values()]
        avg = sum(scores) / len(scores) if scores else 0.5
        std_dev = math.sqrt(sum((s - avg)**2 for s in scores) / len(scores)) if scores else 0.0
        return {"results": results, "weighted_sum": round(w_sum / t_w, 3), "coherence": std_dev < 0.15, "std_dev": round(std_dev, 3), "avg_score": round(avg, 3)}

    def find_leading_maschera(self, eval_res: Dict[str, Any]) -> Optional[str]:
        res = eval_res.get("results", {})
        if not res: return None
        return max(res.items(), key=lambda x: x[1]["weighted"])[0]


class ExperienceModule:
    """Модуль опыта: сохранение решений, исходов и накопление статистики для обучения машины."""
    def __init__(self, max_size: int = 1000):
        self.records: List[Dict] = []
        self.max_size = max_size

    def add(self, decision: Dict, outcome: float, confidence: float = 0.5):
        self.records.append({
            "decision": decision,
            "outcome": outcome,
            "confidence": confidence,
            "timestamp": time.time()
        })
        if len(self.records) > self.max_size:
            self.records.pop(0)

    def predict(self, interpretation_name: str) -> float:
        if not self.records:
            return 0.5
        similar = [
            r["outcome"] for r in self.records
            if interpretation_name.lower() in str(r["decision"]).lower()
        ]
        if similar:
            return sum(similar) / len(similar)
        successful = [r["outcome"] for r in self.records if r["outcome"] > 0.5]
        return len(successful) / len(self.records) if self.records else 0.5


