_JIT_PACK_LUT = np.array([
    [-2, -2, -1, -1],  # trit -1
    [-1,  0,  0,  1],  # trit 0
    [ 0,  1,  2,  2]   # trit +1
], dtype=np.int8)

_JIT_UNPACK_LUT = np.array([
    [-1, 0],  # penta -2
    [-1, 2],  # penta -1
    [ 0, 1],  # penta  0
    [ 0, 3],  # penta  1
    [ 1, 2]   # penta  2
], dtype=np.int8)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_trit_from_float(x: float) -> int:
    if x >= 0.33:
        return 1
    if x <= -0.33:
        return -1
    return 0


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_quad_from_float(x: float) -> int:
    v = int(x * 4.0)
    if v < 0:
        return 0
    if v > 3:
        return 3
    return v


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_pack_345(trit: int, quad: int) -> int:
    t_idx = trit + 1
    if t_idx < 0: t_idx = 0
    if t_idx > 2: t_idx = 2
    
    q_idx = quad
    if q_idx < 0: q_idx = 0
    if q_idx > 3: q_idx = 3
    
    return int(_JIT_PACK_LUT[t_idx, q_idx])


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_unpack_345(penta: int) -> Tuple[int, int]:
    p_idx = penta + 2
    if p_idx < 0: p_idx = 0
    if p_idx > 4: p_idx = 4
    res = _JIT_UNPACK_LUT[p_idx]
    return int(res[0]), int(res[1])


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_guard(signal: np.ndarray) -> np.ndarray:
    np.clip(signal, -2, 2, out=signal)
    return signal


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_l3_triage_vector(arr: np.ndarray, low: float, high: float) -> np.ndarray:
    res = np.empty_like(arr, dtype=np.int8)
    flat_in = arr.ravel()
    flat_out = res.ravel()
    for i in range(flat_in.shape[0]):
        val = flat_in[i]
        if val >= high:
            flat_out[i] = 1
        elif val <= low:
            flat_out[i] = -1
        else:
            flat_out[i] = 0
    return res.reshape(arr.shape)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_reduce_1d(arr: np.ndarray, strategy_is_godel: bool) -> int:
    n = arr.shape[0]
    if strategy_is_godel:
        min_val = 127
        for j in range(n):
            if arr[j] < min_val:
                min_val = arr[j]
        return int(min_val)
    else:
        if n == 0:
            return -2
        total_sum = 0
        for j in range(n):
            total_sum += arr[j]
        luka_val = total_sum - 2 * (n - 1)
        return int(max(-2, luka_val))


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_reduce_batch(batch: np.ndarray, strategy_is_godel: bool) -> np.ndarray:
    rows = batch.shape[0]
    cols = batch.shape[1]
    res = np.empty(rows, dtype=np.int8)
    for i in range(rows):
        if strategy_is_godel:
            min_val = 127
            for j in range(cols):
                val = batch[i, j]
                if val < min_val:
                    min_val = val
            res[i] = min_val
        else:
            total_sum = 0
            for j in range(cols):
                total_sum += batch[i, j]
            luka_val = total_sum - 2 * (cols - 1)
            if luka_val < -2:
                luka_val = -2
            res[i] = np.int8(luka_val)
    return res


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_rashomon_evaluate_zero_alloc(matrix: np.ndarray, out_results: np.ndarray):
    rows = matrix.shape[0]
    cols = matrix.shape[1]
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = matrix[i, 0]
        max_val = matrix[i, 0]
        for j in range(cols):
            val = matrix[i, j]
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val: min_val = val
            if val > max_val: max_val = val
        mean_val = sum_val / cols
        var_sum = 0.0
        for j in range(cols):
            val = matrix[i, j]
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        out_results[i, 0] = mean_val
        out_results[i, 1] = min_val
        out_results[i, 2] = max_val
        out_results[i, 3] = std_val
        out_results[i, 4] = -(abs_sum_val / cols)


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_build_all_cubes(st_contiguous: np.ndarray, tiles_y: int, tiles_x: int, out_cubes: np.ndarray):
    num_cubes = tiles_y * tiles_x
    lut = np.array([
        [-2, -2, -1, -1],
        [-1,  0,  0,  1],
        [ 0,  1,  2,  2]
    ], dtype=np.int8)
    
    for idx in prange(num_cubes):
        ty = idx // tiles_x
        tx = idx % tiles_x
        y0 = ty * 5
        x0 = tx * 5
        
        for y in range(5):
            for x in range(5):
                for t in range(5):
                    raw_v = st_contiguous[y0 + y, x0 + x, t]
                    e = abs(raw_v)
                    
                    m0 = raw_v
                    e0 = e
                    t0 = 1 if m0 >= 0.33 else (-1 if m0 <= -0.33 else 0)
                    q0 = int(e0 * 4.0)
                    if q0 < 0: q0 = 0
                    elif q0 > 3: q0 = 3
                    p0 = lut[t0 + 1, q0]
                    
                    m1 = (1.0 if raw_v > 0.0 else (-1.0 if raw_v < 0.0 else 0.0)) * e
                    e1 = e * 1.5
                    if e1 > 0.999: e1 = 0.999
                    t1 = 1 if m1 >= 0.33 else (-1 if m1 <= -0.33 else 0)
                    q1 = int(e1 * 4.0)
                    if q1 < 0: q1 = 0
                    elif q1 > 3: q1 = 3
                    p1 = lut[t1 + 1, q1]
                    
                    m2 = raw_v * 0.5
                    e2 = 0.25 + (0.5 if raw_v > 0.0 else 0.0)
                    if e2 > 0.999: e2 = 0.999
                    t2 = 1 if m2 >= 0.33 else (-1 if m2 <= -0.33 else 0)
                    q2 = int(e2 * 4.0)
                    if q2 < 0: q2 = 0
                    elif q2 > 3: q2 = 3
                    p2 = lut[t2 + 1, q2]
                    
                    m3 = 1.0 - e
                    e3 = 1.0 - e
                    if m3 < -1.0: m3 = -1.0
                    elif m3 > 1.0: m3 = 1.0
                    if e3 < 0.0: e3 = 0.0
                    elif e3 > 0.999: e3 = 0.999
                    t3 = 1 if m3 >= 0.33 else (-1 if m3 <= -0.33 else 0)
                    q3 = int(e3 * 4.0)
                    if q3 < 0: q3 = 0
                    elif q3 > 3: q3 = 3
                    p3 = lut[t3 + 1, q3]
                    
                    out_cubes[idx, y, x, t, 0] = np.uint8(p0 + 2)
                    out_cubes[idx, y, x, t, 1] = np.uint8(p1 + 2)
                    out_cubes[idx, y, x, t, 2] = np.uint8(p2 + 2)
                    out_cubes[idx, y, x, t, 3] = np.uint8(p3 + 2)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_calculate_text_residual(source_tokens: np.ndarray, reconstructed_tokens: np.ndarray) -> np.ndarray:
    n = source_tokens.shape[0]
    residual = np.empty(n, dtype=np.int16)
    for i in range(n):
        residual[i] = source_tokens[i] - reconstructed_tokens[i]
    return residual


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_calculate_video_residual(original_block: np.ndarray, predicted_block: np.ndarray) -> np.ndarray:
    n = original_block.size
    orig_flat = original_block.ravel()
    pred_flat = predicted_block.ravel()
    residual = np.empty(n, dtype=np.int16)
    for i in range(n):
        residual[i] = int(orig_flat[i]) - int(pred_flat[i])
    return residual


