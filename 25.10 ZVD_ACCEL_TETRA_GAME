            if to_id not in self.nodes[from_id].children: self.nodes[from_id].children.append(to_id)
            if from_id not in self.nodes[to_id].parents: self.nodes[to_id].parents.append(from_id)

    def _distribute_nodes_in_space(self, count: int) -> List[Tuple[float, float]]:
        positions = []
        for i in range(count):
            angle = 2 * math.pi * i / count
            positions.append((0.5 * math.cos(angle), 0.5 * math.sin(angle)))
        return positions

    def process(self, query: str, interpretations: Dict[str, float]) -> Dict[str, Any]:
