================================================================================
Особенности сборки:
  1. Нативные JIT-функции с компиляцией в машинный код (Numba `@njit`).
  2. Параллельный многопоточный Rashomon-аудит через `prange` без блокировки GIL.
  3. Loop Fusion и векторизованная фильтрация памяти `BXOSGate` in-place (`out=signal`).
  4. Устранение накладных расходов на `.astype()` при батчевых свёртках Лукасевича.
  5. Предварительный JIT-разогрев (Warmup) для чистых метрик GOPS в бенчмарке.
================================================================================
"""

import numpy as np
import time
from typing import Literal, Dict, Union, Sequence
from dataclasses import dataclass
from numba import njit, prange


# ============================================================================
# НАДЯДЕРНЫЕ JIT-ФУНКЦИИ (ВЫСОКОСКОРОСТНОЙ МАШИННЫЙ КОД)
# ============================================================================

@njit(fastmath=True, cache=True)
def _njit_guard(signal: np.ndarray) -> np.ndarray:
    """Целочисленный ин-плейс фильтр критических состояний."""
    np.clip(signal, -2, 2, out=signal)
    return signal


@njit(fastmath=True, cache=True)
def _njit_l3_triage_vector(arr: np.ndarray, low: float, high: float) -> np.ndarray:
    """Плоский триаж с Loop Fusion без промежуточных булевых масок NumPy."""
    res = np.empty_like(arr, dtype=np.int8)
    flat_in = arr.ravel()
    flat_out = res.ravel()
    for i in range(flat_in.shape[0]):
        val = flat_in[i]
        if val >= high:
            flat_out[i] = 1
        elif val <= low:
            flat_out[i] = -1
        else:
            flat_out[i] = 0
    return res


@njit(fastmath=True, cache=True)
def _njit_reduce_1d(arr: np.ndarray, strategy_is_godel: bool) -> int:
    """Одномерная свёртка Гёделя или Лукасевича."""
    n = arr.shape[0]
    if strategy_is_godel:
        min_val = 127
        for j in range(n):
            if arr[j] < min_val:
                min_val = arr[j]
        return int(min_val)
    else:
        if n == 0:
            return -2
        total_sum = 0
        for j in range(n):
            total_sum += arr[j]
        luka_val = total_sum - 2 * (n - 1)
        return int(max(-2, luka_val))


@njit(fastmath=True, cache=True)
def _njit_reduce_batch(batch: np.ndarray, strategy_is_godel: bool) -> np.ndarray:
    """Пакетная батч-свёртка без аллокационного мусора и astype-копий."""
    rows = batch.shape[0]
    cols = batch.shape[1]
    res = np.empty(rows, dtype=np.int8)
    for i in range(rows):
        if strategy_is_godel:
            min_val = 127
            for j in range(cols):
                val = batch[i, j]
                if val < min_val:
                    min_val = val
            res[i] = min_val
        else:
            total_sum = 0
            for j in range(cols):
                total_sum += batch[i, j]
            luka_val = total_sum - 2 * (cols - 1)
            if luka_val < -2:
                luka_val = -2
            res[i] = np.int8(luka_val)
    return res


@njit(parallel=True, fastmath=True, cache=True)
def _njit_rashomon_evaluate(matrix: np.ndarray):
    """Параллельный многопоточный Rashomon-аудит за один проход с prange."""
    if matrix.ndim == 1:
        mat = matrix.reshape(1, -1)
    else:
        mat = matrix
    rows = mat.shape[0]
    cols = mat.shape[1]
    
    technical = np.empty(rows, dtype=np.float64)
    operational = np.empty(rows, dtype=np.float64)
    structural = np.empty(rows, dtype=np.float64)
    boundary = np.empty(rows, dtype=np.float64)
    risk = np.empty(rows, dtype=np.float64)
    
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = 1e9
        max_val = -1e9
        
        for j in range(cols):
            val = float(mat[i, j])
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val:
                min_val = val
            if val > max_val:
                max_val = val
        
        mean_val = sum_val / cols
        
        var_sum = 0.0
        for j in range(cols):
            val = float(mat[i, j])
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        
        technical[i] = mean_val
        operational[i] = min_val
        structural[i] = max_val
        boundary[i] = std_val
        risk[i] = -(abs_sum_val / cols)
        
    if matrix.ndim == 1:
        return technical[0], operational[0], structural[0], boundary[0], risk[0]
    return technical, operational, structural, boundary, risk


