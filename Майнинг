## Complete Source Code (`miner.py`)

```python
#!/usr/bin/env python3
import random
import time
import sys

# Возможные состояния сбалансированного трита
TRITS = [-1, 0, 1]
MATRIX_SIZE = 3  # Размер матрицы для быстрого демонстрационного перебора

def generate_ternary_matrix(size):
    """Генерация случайной матрицы из тритов {-1, 0, 1}"""
    return [[random.choice(TRITS) for _ in range(size)] for _ in range(size)]

def evaluate_matrix(matrix):
    """Оценка 'сбалансированности' матрицы (наш аналог сложности)"""
    total_sum = sum(sum(row) for row in matrix)
    score = abs(total_sum)
    return score

def rebel_mine():
    print("=" * 60)
    print(" [!] TERNARY REBEL MINER v0.1-alpha")
    print(" [!] Reject electricity burning. Embrace matrix balance.")
    print("=" * 60)
    
    nonce = 0
    target_score = 0  # Идеальный баланс системы
    start_time = time.time()
    
    try:
        while True:
            nonce += 1
            matrix = generate_ternary_matrix(MATRIX_SIZE)
            score = evaluate_matrix(matrix)
            
            # Имитируем нахождение валидного блока при достижении идеального баланса
            if score == target_score:
                elapsed = time.time() - start_time
                print(f"[BLOCK FOUND!] Nonce: {nonce} | Time: {elapsed:.2f}s")
                print("Balanced Matrix Structure:")
                for row in matrix:
                    print(row)
                print("-" * 40)
                start_time = time.time()
                nonce = 0
                
            # Вывод прогресса каждые 500 000 итераций
            if nonce % 500000 == 0:
                print(f"[*] Scanning... Checked {nonce} variants. Current deviation score: {score}")
                
    except KeyboardInterrupt:
        print("\n[!] Mining stopped by user. Stay rebel.")
        sys.exit(0)

if __name__ == "__main__":
    rebel_mine()
```

