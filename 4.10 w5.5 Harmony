class DataCenterNode:
    def __init__(self, dc_id: str = "DC-HARMONY-ENTERPRISE-01"):
        self.dc_id = dc_id
        os.makedirs("./dc_storage_buffer", exist_ok=True)

    def process_incoming_transmission(self, record_id: str, payload_bytes: bytes, checksum: str, destination_node: str) -> Dict[str, Any]:
        if hashlib.sha256(payload_bytes).hexdigest() != checksum:
            raise ValueError(f"[-] Ошибка хэша ЦОДа для {record_id}!")
        with open(os.path.join("./dc_storage_buffer", f"{record_id}_transit.bin"), "wb") as f:
            f.write(payload_bytes)
        return {"dc_id": self.dc_id, "record_id": record_id, "status": "ROUTED_AND_DELIVERED", "destination": destination_node}


class OpticalTransportLayerV23:
    def __init__(self, data_center: DataCenterNode):
        self.dc = data_center

    def transmit_via_dc(self, record_id: str, payload: bytes, checksum: str, destination: str):
        return self.dc.process_incoming_transmission(record_id, payload, checksum, destination)
