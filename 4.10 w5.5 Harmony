        self.event_counter = 0

    def collect_telemetry(self) -> List[int]:
        cpu = psutil.cpu_percent(interval=0.1)
        ram = psutil.virtual_memory().percent
        swap = psutil.swap_memory().percent
        try:
            io_bytes = psutil.disk_io_counters().read_bytes if psutil.disk_io_counters() else 0
            io = min(100.0, (io_bytes / (1024 * 1024 * 10)) % 100)
        except Exception:
            io = 0.0
        threads = min(100.0, (len(psutil.pids()) / 10.0) % 100)

        return [
            L3Triage.process_metric(cpu, 20.0, 80.0),
            L3Triage.process_metric(ram, 40.0, 85.0),
            L3Triage.process_metric(swap, 5.0, 50.0),
            L3Triage.process_metric(io, 10.0, 70.0),
            L3Triage.process_metric(threads, 30.0, 75.0)
        ]

    def enforce_system_optimization(self) -> str:
        status = "SUCCESS"
        try:
            if sys.platform == "win32":
                kernel32 = ctypes.WinDLL('kernel32')
                psapi = ctypes.WinDLL('psapi')
                for proc in psutil.process_iter(['pid']):
                    try:
                        pid = proc.info['pid']
                        if pid == 0: continue
                        h_proc = kernel32.OpenProcess(0x1F0FFF, False, pid)
                        if h_proc:
                            psapi.EmptyWorkingSet(h_proc)
                            kernel32.CloseHandle(h_proc)
                    except:
                        continue
                print("[OS Governor] Windows API: Выполнен сброс EmptyWorkingSet.")
            else:
                if os.getuid() == 0:
                    os.system("sync; echo 3 > /proc/sys/vm/drop_caches")
                print("[OS Governor] Linux: Выполнен сброс drop_caches.")
        except Exception as e:
            status = f"FAIL: {str(e)}"
        return status

