class BXOSGate:
    """Детерминированный шлюз контроля пограничных состояний."""
    @staticmethod
    def guard(signal: np.ndarray) -> np.ndarray:
        return np.clip(signal, -2.0, 2.0)


class LukasiewiczLogic:
    """Многозначная логика Лукасевича для тернарных векторов {-1, 0, 1}."""
    @staticmethod
    def bounded_sum(a: int, b: int) -> int:
        return int(np.clip(a + b, -1, 1))

    @staticmethod
    def implication(a: int, b: int) -> int:
        fa = (a + 1) / 2.0
        fb = (b + 1) / 2.0
        res_float = min(1.0, 1.0 - fa + fb)
        if res_float > 0.66:
            return 1
        elif res_float < 0.33:
            return -1
        return 0


class L3Triage:
    """Квантование непрерывных физических метрик ПК в тернарные состояния {-1, 0, 1}."""
    @staticmethod
    def process_metric(value: float, low_threshold: float, high_threshold: float) -> int:
        if value >= high_threshold:
            return 1   # Критическая перегрузка
        if value <= low_threshold:
            return -1  # Простой
        return 0       # Стабильный баланс


class L5SystemOntology:
    """5 векторизованных слоев телеметрии ПК для оценки системной энергии (Контур 4.10)."""
    LAYERS = ("cpu_load", "ram_used", "swap_activity", "io_intensity", "thread_count")
    
    def __init__(self):
        self.state = np.zeros(5, dtype=np.int8)
        
    def update(self, metrics: List[int]) -> np.ndarray:
        self.state = BXOSGate.guard(np.array(metrics, dtype=np.int8))
        return self.state
        
    @property
    def system_energy(self) -> float:
        # Фирменная нормировка Владимира Заводюка для 5 слоёв
        return float(np.sum(np.abs(self.state)) / 10.0)

    def evaluate_logical_coherence(self) -> int:
        return LukasiewiczLogic.implication(int(self.state[0]), int(self.state[1]))


