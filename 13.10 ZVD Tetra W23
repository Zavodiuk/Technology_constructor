class TetraCell:
    __slots__ = ("faces",)

    def __init__(self, faces: Optional[np.ndarray] = None) -> None:
        if faces is None:
            self.faces = np.zeros(N_FACES, dtype=np.int8)
        else:
            f = np.asarray(faces, dtype=np.int8).reshape(N_FACES)
            self.faces = np.clip(f, -2, 2).astype(np.int8)

    def pack(self) -> bytes:
        return (self.faces.astype(np.int16) + 2).astype(np.uint8).tobytes()

    @classmethod
    def unpack(cls, raw: bytes) -> "TetraCell":
        arr = np.frombuffer(raw[:N_FACES], dtype=np.uint8).astype(np.int16) - 2
        return cls(arr.astype(np.int8))


class TetraCube5:
    """
    Двухслойный куб 5×5×5 (1000 байт монолит):
    Layer 1 (data): Физика / Lossless-остаток (500 байт с фреймированием длины)
    Layer 2 (semantic): Смыслы и суждения ИИ (500 байт)
    """
    __slots__ = ("data", "semantic_data")

    def __init__(self, data: Optional[np.ndarray] = None, semantic_data: Optional[np.ndarray] = None) -> None:
        if data is None:
            self.data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
        else:
            self.data = data if data.dtype == np.int8 else np.clip(data, -2, 2).astype(np.int8)
            
        if semantic_data is None:
            self.semantic_data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
        else:
            self.semantic_data = np.clip(semantic_data, -2, 2).astype(np.int8)

    def pack_monolith(self, lossless: bool = False) -> bytes:
        if lossless:
            flat_phys = self.data.view(np.uint8).reshape(-1)
        else:
            flat_phys = (self.data.reshape(-1).astype(np.int16) + 2).astype(np.uint8)
        flat_sem = (self.semantic_data.reshape(-1).astype(np.int16) + 2).astype(np.uint8)
        return flat_phys.tobytes() + flat_sem.tobytes()

    @classmethod
    def unpack_monolith(cls, raw: bytes, lossless: bool = False) -> "TetraCube5":
        need = 1000
        if len(raw) < need:
            raise ValueError("monolithic dual-layer payload too short")
        if lossless:
            arr_phys = np.frombuffer(raw[:500], dtype=np.uint8).view(np.int8).reshape(CUBE, CUBE, CUBE, N_FACES)
            arr_sem = np.frombuffer(raw[500:1000], dtype=np.uint8).astype(np.int16) - 2
            cube = cls(semantic_data=arr_sem.reshape(CUBE, CUBE, CUBE, N_FACES).astype(np.int8))
            cube.data = arr_phys
            return cube
        else:
            arr_phys = np.frombuffer(raw[:500], dtype=np.uint8).astype(np.int16) - 2
            arr_sem = np.frombuffer(raw[500:1000], dtype=np.uint8).astype(np.int16) - 2
            return cls(
                data=arr_phys.reshape(CUBE, CUBE, CUBE, N_FACES).astype(np.int8),
                semantic_data=arr_sem.reshape(CUBE, CUBE, CUBE, N_FACES).astype(np.int8)
            )

    def mean_energy(self) -> float:
        return float((np.mean(np.abs(self.data)) + np.mean(np.abs(self.semantic_data))) / 2.0)
