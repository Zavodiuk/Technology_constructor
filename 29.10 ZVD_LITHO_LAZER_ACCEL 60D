# 4. ZVD NANO-LASING EMITTER & MACHINE PROGRAM COMPILER
# =====================================================================

class ZVD_Nano_Lasing_Emitter:
    """
    ===================================================================
    ZVD NANO-LASING EMITTER & MACHINE PROGRAM COMPILER
    ===================================================================
    Bridges 60D tetrahedral volumes to physical AOM modulators and compiles 
    industrial G-code / .NC machine programs for laser exposure systems.
    ===================================================================
    """
    def __init__(self, spatial_hw: Tuple[int, int] = (80, 80)) -> None:
        h, w = spatial_hw
        self.h = (h // CUBE) * CUBE
        self.w = (w // CUBE) * CUBE
        self.tiles_y = self.h // CUBE
        self.tiles_x = self.w // CUBE
        self.num_cubes = self.tiles_y * self.tiles_x
        self._hyperbolic_lut = self._generate_hyperbolic_lut()

    @staticmethod
    def _generate_hyperbolic_lut() -> np.ndarray:
        lut = np.empty((5, 5, 2), dtype=np.int8)
        for y in range(5):
            for x in range(5):
                dy = float(y) - 2.0
                dx = float(x) - 2.0
                dist = math.sqrt(dx*dx + dy*dy)
                step_scale = (math.sinh(dist) / dist) if dist > 1e-6 else 1.0
                contraction_scale = 1.0 / step_scale if step_scale > 1.0 else 1.0
                
                offset_y = int(round(2.0 + dy * contraction_scale)) - 2
                offset_x = int(round(2.0 + dx * contraction_scale)) - 2
                lut[y, x, 0] = np.int8(offset_y)
                lut[y, x, 1] = np.int8(offset_x)
        return lut

    def emit_lasing_instructions(self, cubes: List[TetraCube5]) -> Dict[str, np.ndarray]:
        if not cubes:
            raise ValueError("Empty cube list provided to ZVD_Nano_Lasing_Emitter")
            
        n_cubes = len(cubes)
        cubes_arr = np.empty((n_cubes, CUBE, CUBE, CUBE, N_FACES), dtype=np.uint8)
        for idx, c in enumerate(cubes):
            cubes_arr[idx] = c.data
            
        total_voxels = n_cubes * (CUBE * CUBE * CUBE)
        out_phases = np.empty(total_voxels, dtype=np.int16)
        out_powers = np.empty(total_voxels, dtype=np.uint8)
        out_coords = np.empty((total_voxels, 2), dtype=np.int32)
        
        _njit_translate_to_aom_instructions(
            cubes_arr, 
            self.tiles_y, 
            self.tiles_x, 
            self._hyperbolic_lut, 
            out_phases, 
            out_powers, 
            out_coords
        )
        
        return {
            "aom_phase_shifts_deg": out_phases,
            "diode_power_levels_pct": out_powers,
            "substrate_coordinates": out_coords
        }

    def export_to_machine_gcode(self, instructions: Dict[str, np.ndarray], output_filepath: str, feed_rate: float = 1200.0) -> None:
        """
        Compiles raw AOM and spatial instructions into an industrial G-code (.NC) program 
        file for direct loading into laser exposure rigs and CNC lithography machines.
        """
        phases = instructions["aom_phase_shifts_deg"]
        powers = instructions["diode_power_levels_pct"]
        coords = instructions["substrate_coordinates"]
        
        with open(output_filepath, "w", encoding="utf-8") as f:
            f.write("(--- ZVD-ACCEL-TETRA 60D LITHOGRAPHY CONTROL PROGRAM ---)\n")
            f.write("(--- ARCHITECT: VLADIMIR ZAVODIUK (ВЛАДИМИР ЗАВОДЮК) ---)\n")
            f.write("G21 (Metric units - millimeters)\n")
            f.write("G90 (Absolute positioning coordinate mode)\n")
            f.write(f"F{feed_rate:.1f} (Set operational feed rate)\n")
            f.write("M3 S0 (Spindle / Diode Laser standby)\n")
            f.write("G4 P50 (Thermal stabilization dwell)\n\n")
            
            for i in range(len(phases)):
                y = coords[i, 0]
                x = coords[i, 1]
                power = powers[i]
                phase = phases[i]
                
                # Convert power percentage (25..100) into standard PWM scale (0..1000)
                s_pwm = int((float(power) / 100.0) * 1000.0)
                
                # Format G-code motion and laser modulation line
                # Custom comment embeds the AOM phase shift for advanced optics
                line = f"G1 X{x}.000 Y{y}.000 S{s_pwm} (AOM Phase: {phase:+d}deg, Power: {power}%)\n"
                f.write(line)
                
            f.write("\nM5 (Laser Diode Off)\n")
            f.write("G0 X0.000 Y0.000 (Return to home position)\n")
            f.write("M30 (Program end and rewind)\n")


