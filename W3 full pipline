if __name__ == "__main__":
    print("=" * 70)
    print("ПОЛНАЯ СБОРКА — ДЕМОНСТРАЦИЯ")
    print("=" * 70)

    pipeline = FullPipeline(use_trait_table=False)

    r = pipeline.process(
        "Хочу телефон с хорошей камерой",
        {"Камера": 0.9, "Цена": 0.4, "Автономность": 0.6, "Бренд": 0.7},
    )
    print(f"\nСтатус: {r.status}")
    print(f"Входной гейт: {r.gate_input.status.value}")
    print(f"Троичный: L3_in={r.ternary.l3_in}, L3_out={r.ternary.l3_out}, кандидат={r.ternary.best_candidate}")
    print(f"Консолидированный трит (через трайт-таблицу): {r.consolidated_trit}")
    print(f"Пентарное состояние: {r.pentary_state.value.name}, confidence={r.pentary_confidence}")
    print(f"Выходной гейт: {r.gate_output.status.value}: {r.gate_output.reason}")

    # ---- END-TO-END БЕНЧМАРК: с трайт-таблицей vs без ----
    print("\n" + "=" * 70)
    print("END-TO-END БЕНЧМАРК: влияет ли трайт-таблица на весь пайплайн?")
    print("=" * 70)

    N = 5000
    query, interp = "Хочу телефон с хорошей камерой", {"Камера": 0.9, "Цена": 0.4, "Автономность": 0.6, "Бренд": 0.7}

    pipeline_fast = FullPipeline(use_trait_table=True)
    t0 = time.perf_counter()
    for _ in range(N):
        pipeline_fast.process(query, interp)
    time_fast = time.perf_counter() - t0

    pipeline_slow = FullPipeline(use_trait_table=False)
    t0 = time.perf_counter()
    for _ in range(N):
        pipeline_slow.process(query, interp)
    time_slow = time.perf_counter() - t0

    print(f"\nС трайт-таблицей:    {time_fast:.4f} сек за {N:,} вызовов -> {time_fast/N*1e6:.2f} мкс/вызов")
    print(f"Без трайт-таблицы:   {time_slow:.4f} сек за {N:,} вызовов -> {time_slow/N*1e6:.2f} мкс/вызов")
    print(f"Разница: {(time_slow/time_fast - 1)*100:+.1f}%")
    print("\nЕсли разница мала или отрицательна — значит на уровне ПОЛНОГО пайплайна")
    print("(а не изолированного микро-бенчмарка) оптимизация свёртки Брусенцова не")
    print("является узким местом: остальные шаги (Rashomon-триаж, пентарный блок,")
    print("гейты) доминируют в общем времени вызова.")

    # ---- Дополнительная проверка: где именно теряется время ----
    print("\n" + "=" * 70)
    print("ДИАГНОСТИКА: накладные расходы NumPy на ОДИН вызов трайт-таблицы")
    print("=" * 70)
    N2 = 5000
    t0 = time.perf_counter()
    for _ in range(N2):
        fold_and_via_trait_table((1, 1, 1))
    time_table_single = time.perf_counter() - t0

    t0 = time.perf_counter()
    for _ in range(N2):
        fold_and_scalar((1, 1, 1))
    time_scalar_single = time.perf_counter() - t0

    print(f"fold_and через трайт-таблицу (по одному вызову): {time_table_single/N2*1e6:.2f} мкс/вызов")
    print(f"fold_and обычный скаляр (по одному вызову):       {time_scalar_single/N2*1e6:.2f} мкс/вызов")
    print(f"Скалярный вариант быстрее в {time_table_single/time_scalar_single:.2f}x на ОДИНОЧНЫХ вызовах")
    print("\nВывод: трайт-таблица — инструмент для батчей (миллионы значений разом),")
    print("не для одиночных вызовов внутри цикла запрос-за-запросом. В текущей")
    print("схеме пайплайна (1 запрос = 1 свёртка) её включать не стоит.")
