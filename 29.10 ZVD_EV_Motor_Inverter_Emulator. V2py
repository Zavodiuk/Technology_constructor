import math
from typing import Optional, Tuple

import numpy as np
from numba import njit, prange

DIM_60 = 60  # Triple 60-dimensional icosahedral basis ($3 \times 4 \times 5 = 60$)


# =====================================================================
# 1. DISCRETE 3-4-5 GEOMETRY & UNPACK LOOKUP TABLES
# =====================================================================

_JIT_UNPACK_LUT = np.array([
    [-1, 0],  # penta -2 -> trit -1, quad 0
    [-1, 2],  # penta -1 -> trit -1, quad 2
    [ 0, 1],  # penta  0 -> trit  0, quad 1
    [ 0, 3],  # penta  1 -> trit  0, quad 3
    [ 1, 2]   # penta  2 -> trit +1, quad 2
], dtype=np.int8)


# =====================================================================
# 2. BARE-METAL JIT KERNELS (ZERO-ALLOCATION, BRANCHLESS FOC & SVPWM)
# =====================================================================

@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_inverter_foc_step(
    normalized_currents: np.ndarray, 
    driver_demand: float, 
    hyperbolic_lut: np.ndarray,
    out_pwm_gates: np.ndarray,
    metric_map_60d: np.ndarray,
    pwm_res: int
):
    """
    Zero-Allocation JIT FOC & SVPWM step operating on normalized currents [-1.0, 1.0].
    - Maps normalized inputs into DIM_60 space.
    - Applies Hyperbolic LUT saturation overdrive when driver_demand > 0.85.
    - Emits scalable hardware timer gate triggers with branchless dead-time guard bands.
    """
    # 1. Map normalized phase currents into DIM_60 metric tensor space
    for i in range(DIM_60):
        c_idx = i % 3
        raw_val = normalized_currents[c_idx]  # Already normalized to [-1.0, 1.0]
        p_val = int(round(raw_val * 2.0))
        if p_val < -2: p_val = -2
        if p_val > 2:  p_val = 2
        metric_map_60d[i] = np.int8(p_val + 2)

    # 2. Hyperbolic Vector Warp (Saturation Overdrive for intensive acceleration)
    is_high_demand = 1.0 if driver_demand > 0.85 else 0.0
    
    # 3. Process 60D vector states through 3-4-5 unpack LUT & compute SVPWM duties
    accum_a = 0.0
    accum_b = 0.0
    accum_c = 0.0

    for i in range(DIM_60):
        penta_byte = metric_map_60d[i]
        penta_val = int(penta_byte) - 2
        p_idx = penta_val + 2
        if p_idx < 0: p_idx = 0
        if p_idx > 4: p_idx = 4
        
        trit = _JIT_UNPACK_LUT[p_idx, 0]
        quad = _JIT_UNPACK_LUT[p_idx, 1]
        
        warp_mod = 1.0
        if is_high_demand > 0.5:
            lut_y = i % 5
            lut_x = (i // 5) % 5
            warp_mod = 1.0 + float(hyperbolic_lut[lut_y, lut_x, 0]) * 0.05

        phase_weight = float(trit * (quad + 1)) * warp_mod
        
        if i % 3 == 0:
            accum_a += phase_weight
        elif i % 3 == 1:
            accum_b += phase_weight
        else:
            accum_c += phase_weight

    # Scale duty cycles to the parameterized hardware timer resolution (pwm_res)
    half_res = float(pwm_res) / 2.0
    duty_a = int(half_res + (accum_a / 20.0) * half_res * driver_demand)
    duty_b = int(half_res + (accum_b / 20.0) * half_res * driver_demand)
    duty_c = int(half_res + (accum_c / 20.0) * half_res * driver_demand)

    # Clamp duties strictly between 0 and pwm_res
    if duty_a < 0: duty_a = 0
    elif duty_a > pwm_res: duty_a = pwm_res
    if duty_b < 0: duty_b = 0
    elif duty_b > pwm_res: duty_b = pwm_res
    if duty_c < 0: duty_c = 0
    elif duty_c > pwm_res: duty_c = pwm_res

    # 4. Write gate states into out_pwm_gates with branchless Dead-Time Guard-Band
    out_pwm_gates[0] = np.uint16(duty_a)
    out_pwm_gates[1] = np.uint16(pwm_res - duty_a)
    
    out_pwm_gates[2] = np.uint16(duty_b)
    out_pwm_gates[3] = np.uint16(pwm_res - duty_b)
    
    out_pwm_gates[4] = np.uint16(duty_c)
    out_pwm_gates[5] = np.uint16(pwm_res - duty_c)


# =====================================================================
# 3. SOFTWARE-DEFINED INVERTER CLASS (INVARIANT SCALE GOVERNOR)
# =====================================================================

class ZVD_SoftwareInverter_60D:
    """
    ===================================================================
    ZVD SOFTWARE-DEFINED INVERTER CORE (60D) - INVARIANT SCALE GOVERNOR
    ===================================================================
    Parameterized for any motor power rating (48V to 1200V) with pre-allocated
    buffers ensuring zero heap allocations during real-time execution.
    ===================================================================
    """
    def __init__(self, v_bus: float = 800.0, i_max: float = 1000.0, pwm_resolution: int = 1000) -> None:
        self.v_bus = float(v_bus)
        self.i_max = float(i_max)
        self.pwm_resolution = int(pwm_resolution)
        
        # Pre-allocated Input Buffers (Raw ADC feedback & Normalized tensor inputs)
        self.currents_abc = np.zeros(3, dtype=np.float32)
        self.normalized_currents = np.zeros(3, dtype=np.float32)
        
        # Pre-allocated 60D Metric Map Tensor & PWM Output Register
        self.metric_map_60d = np.zeros(DIM_60, dtype=np.uint8)
        self.out_pwm_gates = np.zeros(6, dtype=np.uint16)
        
        # Pre-allocated Hyperbolic LUT based on sinh curvature scaling
        self.hyperbolic_lut = self._generate_hyperbolic_lut()

    @staticmethod
    def _generate_hyperbolic_lut() -> np.ndarray:
        lut = np.empty((5, 5, 2), dtype=np.int8)
        for y in range(5):
            for x in range(5):
                dy = float(y) - 2.0
                dx = float(x) - 2.0
                dist = math.sqrt(dx*dx + dy*dy)
                step_scale = (math.sinh(dist) / dist) if dist > 1e-6 else 1.0
                contraction_scale = 1.0 / step_scale if step_scale > 1.0 else 1.0
                
                offset_y = int(round(2.0 + dy * contraction_scale)) - 2
                offset_x = int(round(2.0 + dx * contraction_scale)) - 2
                lut[y, x, 0] = np.int8(offset_y)
                lut[y, x, 1] = np.int8(offset_x)
        return lut

    def execute_foc_step(self, ia: float, ib: float, ic: float, driver_demand: float) -> np.ndarray:
        """
        Executes branchless input normalization by i_max, then runs the invariant JIT core.
        """
        self.currents_abc[0] = ia
        self.currents_abc[1] = ib
        self.currents_abc[2] = ic
        
        # Branchless input normalization to ensure bounds strictly within [-1.0, 1.0]
        # Regardless of whether i_max is 50A (scooter) or 1200A (hypercar)
        for i in range(3):
            self.normalized_currents[i] = self.currents_abc[i] / self.i_max
        
        # Call the bare-metal Numba JIT kernel
        _njit_inverter_foc_step(
            self.normalized_currents, 
            driver_demand, 
            self.hyperbolic_lut, 
            self.out_pwm_gates, 
            self.metric_map_60d,
            self.pwm_resolution
        )
        return self.out_pwm_gates


