class PentarnyProjectiveGeometry:
    def __init__(self):
        self.state_to_angle = {
             2: np.pi / 2,
             1: np.pi / 4,
             0: 0.0,
            -1: -np.pi / 4,
            -2: -np.pi / 2
        }
        
    def tangent_distance(self, state: int) -> float:
        if abs(state) == 2:
            return np.sign(state) * 999.0 
        return float(np.tan(self.state_to_angle[state]))

    def arctan_involution(self, distance: float) -> int:
        raw_angle = np.arctan(distance)
        if raw_angle > np.pi / 3:
            return 2
        elif raw_angle > np.pi / 8:
            return 1
        elif raw_angle >= -np.pi / 8:
            return 0
        elif raw_angle >= -np.pi / 3:
            return -1
        else:
            return -2


