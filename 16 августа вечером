class UnifiedGraphNode:
    def __init__(self, node_id: str):
        self.node_id = node_id
        self.internal_state: int = 0
        self.mass: float = 0.0
        self.decision: int = 0
        self.veto_active: bool = False

    def process_signals(self, incoming_signals: List[int]) -> int:
        if self.veto_active:
            self.decision = -2
            self.mass = 99.9
            return self.decision

        if not incoming_signals:
            self.decision = 0
            self.mass = 0.0
            return self.decision

        avg_signal = sum(incoming_signals) / len(incoming_signals)
        conflict = max(incoming_signals) - min(incoming_signals)

        if conflict >= 3 or -2 in incoming_signals:
            self.veto_active = True
            self.decision = -2
            self.mass = float(conflict * 2.5)
        else:
            self.internal_state = quantize_pentarny(avg_signal)
            self.decision = self.internal_state
            self.mass = float(conflict * 0.5)

        return self.decision


class UnifiedGraphEdge:
    def __init__(self, source: UnifiedGraphNode, target: UnifiedGraphNode):
        self.source = source
        self.target = target
        self.energy_flow: float = 1.0
        self.temp: float = 1.0
        self.rhythm: float = 0.0

    def update_dynamics(self):
        if self.source.veto_active or self.target.veto_active or self.source.decision == -2 or self.target.decision == -2:
            self.energy_flow = 0.0
            self.temp = 0.0
            return

        decision_sum = self.source.decision + self.target.decision
        total_mass = self.source.mass + self.target.mass
        old_temp = self.temp
        
        base_modifier = 1.0 + (decision_sum * 0.25) - (total_mass * 0.2)
        self.temp = max(0.05, base_modifier)
        self.rhythm = self.temp - old_temp
        self.energy_flow = (self.temp * 1.5) + (total_mass * 0.5)


