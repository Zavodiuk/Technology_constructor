class PentarnyMatrix:
    def __init__(self, grid: list):
        if len(grid) != 5 or any(len(row) != 5 for row in grid):
            raise ValueError("Пентарная матрица должна иметь размер строго 5x5")
        self.grid = [[el if isinstance(el, PentarnySystem) else PentarnySystem(el) for el in row] for row in grid]

    def multiply_vector(self, system_element: PentarnySystem) -> PentarnySystem:
        vec = system_element.to_vector()
        active_index = vec.index(1)
        values_to_average = [el.value for el in self.grid[active_index]]
        return PentarnySystem(pentarny_consensus(values_to_average))


class PentarnyDnaCompressor:
    def __init__(self):
        self.to_mod = {0: 0, 1: 1, 2: 2, -2: 3, -1: 4}
        self.to_pentarny = {0: 0, 1: 1, 2: 2, 3: -2, 4: -1}

    def compress_history(self, history: list) -> tuple:
        if len(history) < 2:
            raise ValueError("Для формирования ДНК-кода нужно минимум 2 состояния.")
        fn = self.to_mod[history[-1]]
        fn_minus_1 = self.to_mod[history[-2]]
        for _ in range(len(history) - 2):
            fn_minus_2 = (fn - fn_minus_1) % 5
            fn = fn_minus_1
            fn_minus_1 = fn_minus_2
        return self.to_pentarny[fn_minus_1], self.to_pentarny[fn]

    def decompress_dna(self, dna: tuple, length: int) -> list:
        f0_mod = self.to_mod[dna[0]]
        f1_mod = self.to_mod[dna[1]]
        reconstructed_mod = [f0_mod, f1_mod]
        for _ in range(length - 2):
            f_next = (reconstructed_mod[-1] + reconstructed_mod[-2]) % 5
            reconstructed_mod.append(f_next)
        return [self.to_pentarny[x] for x in reconstructed_mod]


