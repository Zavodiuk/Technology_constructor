class U01UnifiedOrchestrator:
    def __init__(self):
        self.nodes: Dict[str, UnifiedGraphNode] = {}
        self.edges: List[UnifiedGraphEdge] = []
        self.compressor = PentarnyDnaCompressor()
        self.cube_3d = PentarnyCube3D()
        self.geometry = PentarnyProjectiveGeometry()
        self.time_step = 0

    def add_node(self, node_id: str):
        if node_id not in self.nodes:
            self.nodes[node_id] = UnifiedGraphNode(node_id)

    def add_edge(self, src: str, tgt: str):
        self.add_node(src)
        self.add_node(tgt)
        self.edges.append(UnifiedGraphEdge(self.nodes[src], self.nodes[tgt]))

    def pulse(self):
        self.time_step += 1
        for node_id, node in self.nodes.items():
            incoming = []
            for edge in self.edges:
                if edge.target == node:
                    incoming.append(int(edge.source.decision))
                elif edge.source == node:
                    incoming.append(int(edge.target.decision * 0.5))
            node.process_signals(incoming)

        for edge in self.edges:
            edge.update_dynamics()

    def export_state_json(self) -> dict:
        return {
            "time_step": self.time_step,
            "harmony_det": self.cube_3d.calculate_harmony_determinant(),
            "nodes": {nid: {"decision": n.decision, "mass": n.mass, "veto": n.veto_active} for nid, n in self.nodes.items()},
            "edges": [{"from": e.source.node_id, "to": e.target.node_id, "flow": e.energy_flow} for e in self.edges]
        }


