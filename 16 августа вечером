class PentarnyCube3D:
    def __init__(self):
        self.cube = np.zeros((6, 5, 5), dtype=int)
        self.reset_to_harmony()
        self.faces = {0: "Логика", 1: "Психология", 2: "Физика", 3: "Экономика", 4: "Энергия", 5: "Этика"}

    def reset_to_harmony(self):
        for face in range(6):
            for row in range(5):
                self.cube[face, row] = [2, 1, 0, -1, -2]

    def calculate_harmony_determinant(self) -> float:
        face_determinants = []
        for face_index in range(6):
            try:
                singular_values = np.linalg.svd(self.cube[face_index], compute_uv=False)
                det_score = max(0.0, min(1.0, np.prod(singular_values) / 150.0))
                face_determinants.append(det_score)
            except np.linalg.LinAlgError:
                face_determinants.append(0.0)
        return float(np.prod(face_determinants) ** (1.0 / 6.0))


