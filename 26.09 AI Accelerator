def run_benchmark() -> None:
    print("=" * 78)
    print("AI ACCELERATOR — LLM PRE-FILTER V23")
    print("Author: Vladimir Zavodiuk | All Rights Reserved")
    print("=" * 78)

    acc = AIAcceleratorLLMPreFilter(low_threshold=0.30, high_threshold=0.70)
    np.random.seed(42)

    print("\n[*] Synthetic load (mixed quality requests)")
    print(f"{'Batch':>8} | {'Latency':>10} | {'QPS':>12} | {'Reject%':>9} | {'PASS':>8}")
    print("-" * 60)

    for bs in [64, 256, 1024, 4096, 16384]:
        # 35% low-confidence, 65% normal
        scores = np.random.rand(bs, 4)
        scores[:int(bs * 0.35)] *= 0.28
        scores_list = scores.tolist()

        # warmup
        for _ in range(3):
            acc.filter(scores_list)

        times = []
        rejects = []
        for _ in range(20):
            r = acc.filter(scores_list)
            times.append(r.latency_ms)
            rejects.append(r.reject_ratio)

        avg_ms = float(np.mean(times))
        avg_rej = float(np.mean(rejects)) * 100
        qps = bs / (avg_ms / 1000.0)
        print(f"{bs:>8} | {avg_ms:>8.3f} ms | {qps:>10.0f} | {avg_rej:>7.1f}% | {100-avg_rej:>6.1f}%")

    # Savings example
    print("\n" + "=" * 78)
    print("ПРИМЕР ОЦЕНКИ ЭКОНОМИИ (иллюстративный)")
    print("=" * 78)
    daily_requests = 10_000_000
    reject_rate = 0.30
    tokens_per_req = 1500
    saved_requests = int(daily_requests * reject_rate)
    saved_tokens = saved_requests * tokens_per_req
    print(f"  Запросов в сутки          : {daily_requests:,}")
    print(f"  Доля REJECT pre-filter    : {reject_rate*100:.0f}%")
    print(f"  Запросов не ушло в LLM    : {saved_requests:,}")
    print(f"  Токенов сэкономлено       : {saved_tokens:,}")
    print(f"  (при ~{tokens_per_req} токенов на запрос)")
    print("\n  Примечание: цифры зависят от качества upstream-скоров")
    print("  и порогов low/high. Это оценка порядка, не гарантия.")
    print("=" * 78)

    print("\n[+] AI Accelerator LLM Pre-Filter V23 готов.")
    print("    Использование: accelerator.filter(confidence_scores)")
    print("=" * 78)


if __name__ == "__main__":
    run_benchmark()
