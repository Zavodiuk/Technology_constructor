        for i in range(self.num_nodes):
            incoming_signals = []
            for j in range(self.num_nodes):
                base_weight = self.base_topology[j, i]
                if base_weight != 0:
                    modulated_weight = base_weight + fib_shift
                    modulated_weight = max(-2, min(2, modulated_weight))
                    signal = self.node_states[j] * modulated_weight
                    signal = max(-2, min(2, signal))
                    incoming_signals.append(signal)
            if incoming_signals:
                avg_signal = sum(incoming_signals) / len(incoming_signals)
                if avg_signal > 0.75:
                    new_states[i] = 2
                elif avg_signal > 0.25:
                    new_states[i] = 1
                elif avg_signal >= -0.25:
                    new_states[i] = 0
                elif avg_signal >= -0.75:
                    new_states[i] = -1
                else:
                    new_states[i] = -2
            else:
                new_states[i] = 0
        self.node_states = new_states

    def get_network_state(self) -> list:
        return self.node_states.tolist()

class PentarnyGoldenSectionEngine:
    def __init__(self):
        self.f0 = 0
        self.f1 = 1
        self.step_counter = 0
        
    def _project_to_pentarny(self, modulo_value: int) -> int:
        projection = {0: 0, 1: 1, 2: 2, 3: -2, 4: -1}
        return projection[modulo_value]

    def next_wave_element(self) -> int:
        if self.step_counter == 0:
            self.step_counter += 1
            return self._project_to_pentarny(self.f0)
        elif self.step_counter == 1:
            self.step_counter += 1
            return self._project_to_pentarny(self.f1)
        f_next = (self.f0 + self.f1) % 5
        self.f0 = self.f1
        self.f1 = f_next
        self.step_counter += 1
        return self._project_to_pentarny(f_next)
    
    def reset(self):
        self.f0 = 0
        self.f1 = 1
        self.step_counter = 0

