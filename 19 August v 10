class PentarnySystem:
    def __init__(self, value: int):
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно быть в диапазоне от -2 до 2")
        self.value = value
        self.mask = MASKS[value]
    
    def as_logic(self) -> str:
        states = {2: "Истина", 1: "Вероятность", 0: "Тождество / Баланс", -1: "Сомнение", -2: "Ложь"}
        return states[self.value]
    
    def as_psychology(self) -> str:
        states = {2: "Мания / Действие", 1: "Интерес", 0: "Рефлексия / Покой", -1: "Апатия / Сомнение", -2: "Депрессия / Отказ"}
        return states[self.value]
    
    def as_physics(self) -> str:
        states = {2: "Гребень волны (Максимум)", 1: "Восходящий фронт", 0: "Узел покоя", -1: "Спад", -2: "Впадина (Минимум)"}
        return states[self.value]
    
    def as_sociology(self) -> str:
        states = {2: "Инвестиция / Эмиссия", 1: "Рост рынка", 0: "Стабилизация", -1: "Рецессия", -2: "Кризис / Сток"}
        return states[self.value]
    
    def as_economics(self) -> str:
        states = {2: "Бум / Перегрев", 1: "Рост", 0: "Стагнация", -1: "Спад", -2: "Дефолт / Обвал"}
        return states[self.value]
    
    def as_energy(self) -> str:
        states = {2: "Максимум энергии", 1: "Высокий потенциал", 0: "Нейтраль", -1: "Низкий потенциал", -2: "Минимум энергии"}
        return states[self.value]
    
    def as_ethics(self) -> str:
        states = {2: "Добро / Справедливость", 1: "Сочувствие", 0: "Нейтральность", -1: "Сомнение в морали", -2: "Зло / Несправедливость"}
        return states[self.value]
    
    def get_all_interpretations(self) -> dict:
        return {
            "logic": self.as_logic(),
            "psychology": self.as_psychology(),
            "physics": self.as_physics(),
            "sociology": self.as_sociology(),
            "economics": self.as_economics(),
            "energy": self.as_energy(),
            "ethics": self.as_ethics()
        }
    
    def strength(self) -> float:
        return abs(self.value) / 2.0
    
    def sign(self) -> int:
        return 1 if self.value > 0 else (-1 if self.value < 0 else 0)
    
    def is_positive(self) -> bool:
        return self.value > 0
    
    def is_negative(self) -> bool:
        return self.value < 0
    
    def is_zero(self) -> bool:
        return self.value == 0
    
    def is_extreme(self) -> bool:
        return abs(self.value) == 2
    
    def invert(self) -> 'PentarnySystem':
        return PentarnySystem(-self.value)
    
    def __add__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        result = self.value + other.value
        result = max(-2, min(2, result))
        return PentarnySystem(result)
    
    def __sub__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        result = self.value - other.value
        result = max(-2, min(2, result))
        return PentarnySystem(result)
    
    def __mul__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        result = self.value * other.value
        result = max(-2, min(2, result))
        return PentarnySystem(result)
    
    def __truediv__(self, other: 'PentarnySystem') -> 'PentarnySystem':
        if other.value == 0:
            raise ZeroDivisionError("Деление на ноль в пентарной логике")
        result = int(self.value / other.value)
        result = max(-2, min(2, result))
        return PentarnySystem(result)
    
    def __repr__(self):
        return f"PentarnySystem({self.value})"
    
    def __str__(self):
        return f"{self.value} → {self.mask}"
    
    def __eq__(self, other):
        if not isinstance(other, PentarnySystem):
            return False
        return self.value == other.value
    
    def __lt__(self, other):
        if not isinstance(other, PentarnySystem):
            return False
        return self.value < other.value
    
    def __gt__(self, other):
        if not isinstance(other, PentarnySystem):
            return False
        return self.value > other.value
    
    def to_vector(self) -> list:
        vec = [0, 0, 0, 0, 0]
        vec[self.value + 2] = 1
        return vec
    
    def distance_to(self, other: 'PentarnySystem') -> int:
        return abs(self.value - other.value)

def quantize_pentarny(value: float) -> int:
    if value > 0.75:
        return 2
    elif value > 0.25:
        return 1
    elif value >= -0.25:
        return 0
    elif value >= -0.75:
        return -1
    else:
        return -2

def pentarny_consensus(values: list) -> int:
    if not values:
        return 0
    return quantize_pentarny(sum(values) / len(values))

def pentarny_majority(values: list) -> int:
    if not values:
        return 0
    return Counter(values).most_common(1)[0][0]

class PentarnyMatrix:
    def __init__(self, grid: list):
        if len(grid) != 5 or any(len(row) != 5 for row in grid):
            raise ValueError("Пентарная матрица переходов должна иметь размер строго 5x5")
        self.grid = []
        for row in grid:
            new_row = [el if isinstance(el, PentarnySystem) else PentarnySystem(el) for el in row]
            self.grid.append(new_row)

    def __add__(self, other: 'PentarnyMatrix') -> 'PentarnyMatrix':
        new_grid = []
        for i in range(5):
            row = [self.grid[i][j] + other.grid[i][j] for j in range(5)]
            new_grid.append(row)
        return PentarnyMatrix(new_grid)

    def multiply_vector(self, system_element: PentarnySystem) -> PentarnySystem:
        vec = system_element.to_vector()
        active_index = vec.index(1)
        transformation_row = self.grid[active_index]
        values_to_average = [el.value for el in transformation_row]
        result_value = pentarny_consensus(values_to_average)
        return PentarnySystem(result_value)

    def __str__(self):
        res = []
        for row in self.grid:
            res.append(" | ".join(f"{el.value:2d}" for el in row))
        return "\n".join(res)

class PentarnyCube3D:
    def __init__(self):
        self.cube = np.zeros((6, 5, 5), dtype=int)
        self.reset_to_harmony()
        self.faces = {
            0: "Логика",
            1: "Психология",
            2: "Физика",
            3: "Экономика",
            4: "Энергия",
            5: "Этика"
        }

    def reset_to_harmony(self):
        for face in range(6):
            for row in range(5):
                self.cube[face, row] = [2, 1, 0, -1, -2]

    def rotate_layer_comma(self, face_index: int, layer_index: int, direction: int = 1):
        if not (0 <= layer_index < 5):
            raise ValueError("Индекс слоя должен быть от 0 до 4")
        if layer_index == 0:
            self.cube[face_index] = np.rot90(self.cube[face_index], -direction)
        adjacent_faces = [0, 1, 2, 3]
        if face_index in adjacent_faces:
            temp = self.cube[adjacent_faces[0], layer_index, :].copy()
            if direction == 1:
                for i in range(3):
                    self.cube[adjacent_faces[i], layer_index, :] = self.cube[adjacent_faces[i+1], layer_index, :]
                self.cube[adjacent_faces[3], layer_index, :] = temp
            else:
                for i in range(3, 0, -1):
                    self.cube[adjacent_faces[i], layer_index, :] = self.cube[adjacent_faces[i-1], layer_index, :]
                self.cube[adjacent_faces[0], layer_index, :] = temp

    def check_harmony(self) -> bool:
        reference = np.array([2, 1, 0, -1, -2])
        for face in range(6):
            for row in range(5):
                if not np.array_equal(self.cube[face, row], reference):
                    return False
        return True

    def calculate_harmony_determinant(self) -> float:
        face_determinants = []
        for face_index in range(6):
            matrix = self.cube[face_index]
            try:
                singular_values = np.linalg.svd(matrix, compute_uv=False)
                det_score = np.prod(singular_values) / 150.0
                det_score = max(0.0, min(1.0, det_score))
                face_determinants.append(det_score)
            except np.linalg.LinAlgError:
                face_determinants.append(0.0)
        total_determinant = np.prod(face_determinants) ** (1.0 / 6.0)
        return float(total_determinant)

    def auto_assemble(self, max_steps: int = 100) -> bool:
        for step in range(max_steps):
            if self.check_harmony() or self.calculate_harmony_determinant() >= 0.999:
                print(f"  [Автосборка]: Система приведена к гармонии за {step} шагов!")
                self.reset_to_harmony()
                return True
            best_det = self.calculate_harmony_determinant()
            best_move = None
            for face in range(6):
                for layer in range(5):
                    for direction in [1, -1]:
                        self.rotate_layer_comma(face, layer, direction)
                        current_det = self.calculate_harmony_determinant()
                        if current_det > best_det:
                            best_det = current_det
                            best_move = (face, layer, direction)
                        self.rotate_layer_comma(face, layer, -direction)
            if best_move:
                self.rotate_layer_comma(best_move[0], best_move[1], best_move[2])
            else:
                random_face = np.random.randint(0, 6)
                self.rotate_layer_comma(random_face, 0, 1)
        return self.check_harmony()

    def to_quantum_density_matrix(self, face_index: int) -> np.ndarray:
        pentarny_matrix = self.cube[face_index]
        normalized = pentarny_matrix / 2.0
        quantum_matrix = (normalized + normalized.T) / 2.0 + 1j * (normalized - normalized.T) / 2.0
        trace = np.trace(quantum_matrix)
        if trace != 0:
            quantum_matrix = quantum_matrix / trace
        return quantum_matrix

    def entangle_faces(self, face_a: int, face_b: int):
        if face_a == face_b:
            return
        matrix_a = self.cube[face_a]
        matrix_b = self.cube[face_b]
        for i in range(5):
            for j in range(5):
                val_a = matrix_a[i, j]
                val_b = matrix_b[i, j]
                entangled_val = val_a * val_b
                if entangled_val > 2:
                    entangled_val = 2
                elif entangled_val < -2:
                    entangled_val = -2
                self.cube[face_b, i, j] = entangled_val
        print(f"  [Квантовый Мост]: Грани '{self.faces[face_a]}' и '{self.faces[face_b]}' теперь квантово запутаны.")

class PentarnyGraphNetwork:
    def __init__(self, num_nodes: int):
        self.num_nodes = num_nodes
        self.node_states = np.zeros(num_nodes, dtype=int)
        self.adjacency_matrix = np.random.randint(-2, 3, size=(num_nodes, num_nodes))
        np.fill_diagonal(self.adjacency_matrix, 0)

    def set_node_state(self, node_id: int, value: int):
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно быть в базисе [-2, 2]")
        self.node_states[node_id] = value

    def pulse_propagation(self):
        new_states = np.zeros(self.num_nodes, dtype=int)
        for i in range(self.num_nodes):
            incoming_signals = []
            for j in range(self.num_nodes):
                weight = self.adjacency_matrix[j, i]
                if weight != 0:
                    signal = self.node_states[j] * weight
                    signal = max(-2, min(2, signal))
                    incoming_signals.append(signal)
            if incoming_signals:
                avg_signal = sum(incoming_signals) / len(incoming_signals)
                if avg_signal > 0.75:
                    new_states[i] = 2
                elif avg_signal > 0.25:
                    new_states[i] = 1
                elif avg_signal >= -0.25:
                    new_states[i] = 0
                elif avg_signal >= -0.75:
                    new_states[i] = -1
                else:
                    new_states[i] = -2
            else:
                new_states[i] = 0
        self.node_states = new_states

    def get_network_state(self) -> list:
        return self.node_states.tolist()

class PentarNode:
    def __init__(self, node_id):
        self.node_id = node_id
        self.internal_state = 0
        self.mass = 0.0
        self.decision = 0
        self.history_temp = []

    def process_signals(self, signal_matrix_A, signal_matrix_B):
        print(f"\n--- [Узел {self.node_id}] Точка пересечения матриц ---")
        print(f"Сигнал Матрицы А: {signal_matrix_A} ({PENTAR_CODE[signal_matrix_A]})")
        print(f"Сигнал Матрицы Б: {signal_matrix_B} ({PENTAR_CODE[signal_matrix_B]})")
        
        sum_of_decisions = signal_matrix_A + signal_matrix_B
        conflict = abs(signal_matrix_A - signal_matrix_B)
        
        base_temp = 1.0 + (sum_of_decisions * 0.2)
        actual_temp = max(0.1, base_temp - (conflict * 0.2))
        rhythm = sum_of_decisions * 0.5
        
        if conflict >= 3:
            informational_mass = conflict * 2.5
            self.internal_state = 0
        else:
            informational_mass = conflict * 0.5
            self.internal_state = max(-2, min(2, sum_of_decisions))
            
        self.mass = informational_mass
        self.decision = self.internal_state
        
        processing_delay = informational_mass * 0.1
        time.sleep(processing_delay)
        
        print(f"-> Итоговое состояние узла: {self.internal_state} ({PENTAR_CODE[self.internal_state]})")
        print(f"-> ТЕМП (1-я производная времени): {actual_temp:.2f} шагов/сек")
        print(f"-> РИТМ (2-я производная времени): {rhythm:+.2f} ускорение")
        print(f"-> ИНФОРМАЦИОННАЯ МАССА (Инерция узла): {informational_mass:.2f} у.е. (Задержка: {processing_delay:.2f} сек)")
        return self.internal_state

class PentarEdge:
    def __init__(self, source, target):
        self.source = source
        self.target = target
        self.energy_flow = 1.0
        self.temp = 1.0
        self.rhythm = 0.0

    def update_dynamics(self):
        decision_sum = self.source.decision + self.target.decision
        total_mass = self.source.mass + self.target.mass
        old_temp = self.temp
        base_modifier = 1.0 + (decision_sum * 0.25) - (total_mass * 0.2)
        self.temp = max(0.05, base_modifier)
        self.rhythm = self.temp - old_temp
        if self.source.decision == -2 or self.target.decision == -2:
            self.energy_flow = 0.0
        else:
            self.energy_flow = (self.temp * 1.5) + (total_mass * 0.5)

class PentarUniverseGraph:
    def __init__(self):
        self.nodes = {}
        self.edges = []
        self.time_step = 0

    def add_node(self, name):
        self.nodes[name] = PentarNode(name)

    def add_edge(self, src, tgt):
        self.edges.append(PentarEdge(self.nodes[src], self.nodes[tgt]))

    def pulse(self):
        self.time_step += 1
        for name, node in self.nodes.items():
            connected_signals = []
            for edge in self.edges:
                if edge.target == node:
                    connected_signals.append(edge.energy_flow)
                elif edge.source == node:
                    connected_signals.append(edge.energy_flow * 0.5)
            if not connected_signals:
                connected_signals = [random.choice([-2, -1, 0, 1, 2])]
            node.process_signals(
                signal_matrix_A=connected_signals[0] if len(connected_signals) > 0 else 0,
                signal_matrix_B=connected_signals[-1] if len(connected_signals) > 1 else 0
            )
        for edge in self.edges:
            edge.update_dynamics()

    def display_state(self):
        print(f"\n================ [ ТАКТ ВРЕМЕНИ (Скаляр): {self.time_step} ] ================")
        print("\n--- СОСТОЯНИЕ УЗЛОВ ---")
        for name, node in self.nodes.items():
            print(f"Узел [{name}]: Решение = {node.decision:+d} ({PENTAR_CODE[node.decision][:20]}...) | МАССА = {node.mass:.2f}")
        print("\n--- ДИНАМИКА ПОТОКОВ В КАНАЛАХ ---")
        for edge in self.edges:
            print(f"Канал [{edge.source.node_id} -> {edge.target.node_id}]:")
            print(f"  -> ТЕМП = {edge.temp:.2f} шагов/такт")
            print(f"  -> РИТМ = {edge.rhythm:+.2f} изменение")
            print(f"  -> ПОТОК ЭНЕРГИИ = {edge.energy_flow:.2f} у.е.")

class PentarnyFibonacciGenerator:
