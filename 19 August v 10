    fun addNode(name: String) {
        nodes[name] = PentarNode(name)
    }

    fun addEdge(srcName: String, tgtName: String) {
        val src = nodes[srcName] ?: throw IllegalArgumentException("Узел $srcName не найден")
        val tgt = nodes[tgtName] ?: throw IllegalArgumentException("Узел $tgtName не найден")
        edges.add(PentarEdge(src, tgt))
    }

    fun pulse() {
        timeStep++
        val random = Random()
        val statesList = PentarState.entries.toTypedArray()

        for ((name, node) in nodes) {
            val connectedSignals = mutableListOf<PentarState>()
            for (edge in edges) {
                if (edge.target == node) {
                    connectedSignals.add(node.internalState)
                }
            }

            val sigA = if (connectedSignals.isNotEmpty()) connectedSignals[0] else statesList[random.nextInt(statesList.size)]
            val sigB = if (connectedSignals.size > 1) connectedSignals[1] else sigA

            node.processSignals(sigA, sigB)
        }

        for (edge in edges) {
            edge.updateDynamics()
        }
    }

    fun displayState() {
        println("\n================ [ ТАКТ ВРЕМЕНИ: $timeStep ] ================")
