class PentarnyProjectiveGeometry:
    def __init__(self):
        self.state_to_angle = {
             2: np.pi / 2,
             1: np.pi / 4,
             0: 0.0,
            -1: -np.pi / 4,
            -2: -np.pi / 2
        }
        
    def tangent_distance(self, state: int) -> float:
        angle = self.state_to_angle[state]
        if abs(state) == 2:
            return np.sign(state) * 999.0 
        return float(np.tan(angle))

    def arctan_involution(self, distance: float) -> int:
        raw_angle = np.arctan(distance)
        if raw_angle > np.pi / 3:
            return 2
        elif raw_angle > np.pi / 8:
            return 1
        elif raw_angle >= -np.pi / 8:
            return 0
        elif raw_angle >= -np.pi / 3:
            return -1
        else:
            return -2

class PentarnyTrigonometricGraph:
    def __init__(self, num_nodes: int):
        self.num_nodes = num_nodes
        self.geometry = PentarnyProjectiveGeometry()
        self.node_phases = np.zeros(num_nodes)
        self.distance_matrix = np.zeros((num_nodes, num_nodes))

    def set_node_trig_state(self, node_id: int, pentarny_state: int):
        self.node_phases[node_id] = self.geometry.state_to_angle[pentarny_state]

    def calculate_kirchhoff_flow(self):
        simulated_states = np.zeros(self.num_nodes, dtype=int)
        for i in range(self.num_nodes):
            total_pressure = 0.0
            incoming_count = 0
            for j in range(self.num_nodes):
                if i != j:
                    phase_delta = self.node_phases[j] - self.node_phases[i]
                    if abs(phase_delta) >= np.pi / 2:
                        spatial_distance = np.sign(phase_delta) * 5.0
                    else:
                        spatial_distance = np.tan(phase_delta)
                    total_pressure += spatial_distance
                    incoming_count += 1
            if incoming_count > 0:
                avg_pressure = total_pressure / incoming_count
                simulated_states[i] = self.geometry.arctan_involution(avg_pressure)
        return simulated_states.tolist()

