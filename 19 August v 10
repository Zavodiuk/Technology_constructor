        face_determinants = []
        for face_index in range(6):
            matrix = self.cube[face_index]
            try:
                singular_values = np.linalg.svd(matrix, compute_uv=False)
                det_score = np.prod(singular_values) / 150.0
                det_score = max(0.0, min(1.0, det_score))
                face_determinants.append(det_score)
            except np.linalg.LinAlgError:
                face_determinants.append(0.0)
        return float(np.prod(face_determinants) ** (1.0 / 6.0))

    def evolve_by_fibonacci(self) -> tuple:
        fib_val = self.fib_engine.next_wave_element()
        layer_index = fib_val + 2
        face_index = (self.fib_engine.step_counter - 1) % 6
        direction = 1 if (self.fib_engine.step_counter % 2 == 0) else -1
        self.rotate_layer_comma(face_index, layer_index, direction)
        return face_index, layer_index, direction

class PentarnyDnaCompressor:
    def __init__(self):
        self.to_mod = {0: 0, 1: 1, 2: 2, -2: 3, -1: 4}
        self.to_pentarny = {0: 0, 1: 1, 2: 2, 3: -2, 4: -1}

    def compress_history(self, history: list) -> tuple:
        if len(history) < 2:
            raise ValueError("Для формирования ДНК-кода нужно минимум 2 состояния.")
        fn = self.to_mod[history[-1]]
        fn_minus_1 = self.to_mod[history[-2]]
        for _ in range(len(history) - 2):
            fn_minus_2 = (fn - fn_minus_1) % 5
            fn = fn_minus_1
            fn_minus_1 = fn_minus_2
        dna_f0 = self.to_pentarny[fn_minus_1]
        dna_f1 = self.to_pentarny[fn]
        return dna_f0, dna_f1

    def decompress_dna(self, dna: tuple, length: int) -> list:
        f0_mod = self.to_mod[dna[0]]
        f1_mod = self.to_mod[dna[1]]
        reconstructed_mod = [f0_mod, f1_mod]
        for _ in range(length - 2):
            f_next = (reconstructed_mod[-1] + reconstructed_mod[-2]) % 5
            reconstructed_mod.append(f_next)
        return [self.to_pentarny[x] for x in reconstructed_mod]

