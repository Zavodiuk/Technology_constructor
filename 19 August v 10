        self.wave_sequence = [0, 1, 1, 2, -2, 0, -2, -2, 1, -1, 0, -1, -1, -2, 2, 0, 2, 2, -1, 1]
        self.current_index = 0

    def next_step(self) -> int:
        val = self.wave_sequence[self.current_index]
        self.current_index = (self.current_index + 1) % 20
        return val
    
    def reset(self):
        self.current_index = 0

class PentarnyFibonacciNetwork:
    def __init__(self, num_nodes: int):
        self.num_nodes = num_nodes
        self.node_states = np.zeros(num_nodes, dtype=int)
        self.base_topology = np.random.choice([-1, 0, 1], size=(num_nodes, num_nodes))
