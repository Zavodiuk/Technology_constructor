enum class PentarState(val value: Int, val description: String) {
    HARLEKIN(-2, "КАТЕГОРИЧЕСКОЕ НЕТ (Полная блокировка / Обрыв канала)"),
    PIERO(-1, "МЯГКОЕ НЕТ (Торможение потока)"),
    GRACIANO(0, "НЕОПРЕДЕЛЕННОСТЬ / ПОКОЙ (Свободный транзит)"),
    COLOMBINA(1, "МЯГКОЕ ДА (Активация / Рост проводимости)"),
    BRIGELLA(2, "КАТЕГОРИЧЕСКОЕ ДА (Максимальное ускорение / Сверхпроводимость)");

    companion object {
        fun from(v: Int): PentarState = entries.firstOrNull { it.value == v } ?: GRACIANO
        fun quantize(value: Float): PentarState {
            return when {
                value > 0.75f -> BRIGELLA
                value > 0.25f -> COLOMBINA
                value >= -0.25f -> GRACIANO
                value >= -0.75f -> PIERO
                else -> HARLEKIN
            }
        }
    }
}

class PentarNode(val nodeId: String) {
    var internalState: PentarState = PentarState.GRACIANO
        private set
    var mass: Float = 0.0f
        private set
    var temp: Float = 1.0f
        private set
    var rhythm: Float = 0.0f
        private set
    var decision: PentarState = PentarState.GRACIANO
        private set

    fun processSignals(signalA: PentarState, signalB: PentarState): PentarState {
        val sumVal = signalA.value + signalB.value
        val conflict = abs(signalA.value - signalB.value)

        val baseTemp = 1.0f + (sumVal * 0.2f)
        temp = max(0.1f, baseTemp - (conflict * 0.2f))
        rhythm = sumVal * 0.5f

        val informationalMass = if (conflict >= 3) {
            conflict * 2.5f
        } else {
            conflict * 0.5f
        }

        mass = informationalMass

        val resolvedValue = if (conflict >= 3) {
            0
        } else {
            max(-2, min(2, sumVal))
        }

        internalState = PentarState.from(resolvedValue)
        decision = internalState

        return internalState
    }
}

class PentarEdge(val source: PentarNode, val target: PentarNode) {
    var energyFlow: Float = 1.0f
        private set
    var temp: Float = 1.0f
        private set
    var rhythm: Float = 0.0f
        private set

    fun updateDynamics() {
        val decisionSum = source.decision.value + target.decision.value
        val totalMass = source.mass + target.mass
        val oldTemp = temp
        
        val baseModifier = 1.0f + (decisionSum * 0.25f) - (totalMass * 0.2f)
        temp = max(0.05f, baseModifier)
        rhythm = temp - oldTemp

        energyFlow = if (source.decision == PentarState.HARLEKIN || target.decision == PentarState.HARLEKIN) {
            0.0f
        } else {
            (temp * 1.5f) + (totalMass * 0.5f)
        }
    }
}

class PentarUniverseGraph {
    private val nodes = mutableMapOf<String, PentarNode>()
    private val edges = mutableListOf<PentarEdge>()
