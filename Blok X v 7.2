# 5. GAME НА 5 УРОВНЯХ
# ============================================================

class GamePenta:
    """
    Теория игр на пятеричном базисе.

    Стратегии:

        -2 = жёсткий конфликт
        -1 = конкурентная стратегия
         0 = нейтральная стратегия
        +1 = сотрудничество
        +2 = активное сотрудничество
    """

    STRATEGIES = (-2, -1, 0, 1, 2)

    def __init__(self):
        self.players: Dict[str, Dict[str, Any]] = {}
        self.history: List[Dict[str, Any]] = []

    def add_player(
        self,
        name: str,
        role: str,
        resources: float,
        strategy: int
    ):
        """Добавляет игрока."""

        validate_l5(strategy)

        if resources < 0:
            raise ValueError("Ресурсы не могут быть отрицательными.")

        self.players[name] = {
            "role": role,
            "resources": resources,
            "strategy": strategy,
            "payoff": 0.0,
            "l5_status": 0,
        }

    def set_strategy(self, name: str, strategy: int):
        """Изменяет стратегию игрока."""

        if name not in self.players:
            raise KeyError(f"Игрок '{name}' не найден.")

        validate_l5(strategy)

        self.players[name]["strategy"] = strategy

    def simulate(self, steps: int = 5) -> List[Dict[str, Any]]:
        """
        Симулирует игру.

        Теперь стратегия действительно влияет на динамику payoff.
        """

        if steps < 0:
            raise ValueError("steps не может быть отрицательным.")

        results = []

        for step in range(steps):

            for name, data in self.players.items():

                strategy = data["strategy"]

                # Базовая случайная динамика.
                base_delta = random.uniform(-0.2, 0.2)

                # Стратегический компонент.
                strategic_delta = strategy * 0.1

                delta = base_delta + strategic_delta

                data["payoff"] += delta

                # Нормализация payoff для L5.
                normalized = max(
                    -1.0,
                    min(1.0, data["payoff"] / 10.0)
                )

                data["l5_status"] = quantize_penta(normalized)

            snapshot = {
                "step": step + 1,
                "players": {
                    name: data["payoff"]
                    for name, data in self.players.items()
                },
                "l5": {
                    name: data["l5_status"]
                    for name, data in self.players.items()
                },
            }

            results.append(snapshot)
            self.history.append(snapshot)

        return results

    def cost_of_conflict(self) -> float:
        """
        Стоимость конфликтных стратегий.

        -2 имеет больший вес, чем -1.
        """

        total = 0.0

        for data in self.players.values():

            strategy = data["strategy"]

            if strategy == -2:
                total += data["resources"] * 0.8

            elif strategy == -1:
                total += data["resources"] * 0.5

        return total

    def gain_of_cooperation(self) -> float:
        """
        Выигрыш от сотрудничества.

        +2 имеет больший вес, чем +1.
        """

        total = 0.0

        for data in self.players.values():

            strategy = data["strategy"]

            if strategy == 2:
                total += data["resources"] * 1.0

            elif strategy == 1:
                total += data["resources"] * 0.8

        return total

    def is_deal_good(self) -> bool:
        """Проверяет, превышает ли выигрыш сотрудничества цену конфликта."""

        return self.gain_of_cooperation() > self.cost_of_conflict()


