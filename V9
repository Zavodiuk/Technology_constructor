# 3. MATRIX BLOCK X — РАСШИРЕННЫЙ БЛОК ДЛЯ МАТРИЦ
# ============================================================

@dataclass
class MatrixBlockX:
    """Блок в цепочке для матричных состояний"""
    index: int
    version: str
    timestamp: float
    prev_hash: str
    state_matrix: TernaryMatrix
    payload: Dict[str, Any]
    signature: str = "Root-Architect"

    @property
    def hash(self) -> str:
        data = f"{self.index}{self.version}{self.timestamp}{self.prev_hash}{json.dumps(self.payload)}{self.signature}"
        return hashlib.sha256(data.encode()).hexdigest()

    def verify(self) -> bool:
        return self.hash.startswith('00')

    def to_dict(self) -> Dict:
        return {
            'index': self.index,
            'version': self.version,
            'timestamp': self.timestamp,
            'prev_hash': self.prev_hash[:16] + '...',
            'state_matrix': self.state_matrix.to_dict(),
            'payload': self.payload,
            'signature': self.signature,
            'hash': self.hash[:16] + '...'
        }

class MatrixBlockChain:
    """Цепочка матричных блоков"""

    def __init__(self):
        self.blocks: List[MatrixBlockX] = []

    def add_block(self, matrix: TernaryMatrix, payload: Dict[str, Any]) -> MatrixBlockX:
        block = MatrixBlockX(
            index=len(self.blocks),
            version='V9',
            timestamp=time.time(),
            prev_hash=self.blocks[-1].hash if self.blocks else 'GENESIS',
            state_matrix=matrix,
            payload=payload
        )
        self.blocks.append(block)
        return block

    def verify_chain(self) -> bool:
        for i in range(1, len(self.blocks)):
            if self.blocks[i].prev_hash != self.blocks[i-1].hash:
                return False
        return True

    def to_dict(self) -> Dict:
        return {
            'length': len(self.blocks),
            'verified': self.verify_chain(),
            'blocks': [b.to_dict() for b in self.blocks[-5:]]
        }

