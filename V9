# 6. КОНСОЛЬ V9
# ============================================================

class ConsoleV9:
    """Консоль для управления V9"""

    def __init__(self):
        self.engine = GameEngineV9()
        self.running = True

        print("\n🧠 V9 CONSOLE ACTIVE")
        print("   Троично-матричная архитектура")
        print("   База: V6 + матрицы + тригонометрия")
        print("=" * 60)

    def _render(self):
        print("\n" + "=" * 60)
        print("🧠 ROOT-ARCHITECT V9 — ТРОИЧНО-МАТРИЧНАЯ АРХИТЕКТУРА")
        print("=" * 60)

        print("\n📊 ТЕКУЩАЯ МАТРИЦА:")
        for row in self.engine.state.data:
            print(f"  {row}")

        print(f"\n📈 СТАТИСТИКА:")
        print(f"  Стабильность: {self.engine.state.stability_index():.2f}")
        print(f"  Энтропия: {self.engine.state.entropy():.2f}")
        print(f"  Детерминант: {self.engine.state.determinant()}")
        print(f"  История: {len(self.engine.history)} блоков")

        print("\n" + "-" * 60)
        print("КОМАНДЫ:")
        print("  show                 - показать текущую матрицу")
        print("  set <row> <col> <val> - установить значение")
        print("  add <matrix>         - сложить с матрицей")
        print("  mult <matrix>        - умножить на матрицу")
        print("  transpose            - транспонировать")
        print("  sin, cos, tan, cot   - тригонометрические функции")
        print("  sec, csc             - секанс/косеканс")
        print("  sinh, cosh, tanh     - гиперболические функции")
        print("  trig                 - все тригонометрические функции")
        print("  predict <steps>      - прогноз на N шагов")
        print("  graph                - граф состояний")
        print("  analyze              - полный анализ")
        print("  state                - полное состояние")
        print("  exit                 - выход")
        print("=" * 60)

    def _get_matrix_input(self, rows: int, cols: int) -> TernaryMatrix:
        """Ввод матрицы с клавиатуры"""
        print(f"Введите матрицу {rows}x{cols} (значения -1, 0, 1):")
        data = []
        for i in range(rows):
            while True:
                try:
                    row = list(map(int, input(f"Строка {i+1}: ").split()))
                    if len(row) != cols:
                        print(f"❌ Ожидается {cols} значений")
                        continue
                    data.append(row)
                    break
                except ValueError:
                    print("❌ Введите числа через пробел")
        return TernaryMatrix(data)

    def run(self):
        """Главный цикл консоли"""
        while self.running:
            self._render()

            cmd = input("\n➜ ").strip().split()
            if not cmd:
                continue

            action = cmd[0].lower()

            if action == "exit":
                self.running = False
                print("👋 Выход из V9")

            elif action == "show":
                print("\nТекущая матрица:")
                for row in self.engine.state.data:
                    print(f"  {row}")

            elif action == "set":
                if len(cmd) < 4:
                    print("❌ Использование: set row col val")
                    continue
                try:
                    r, c, v = int(cmd[1]), int(cmd[2]), int(cmd[3])
                    data = [row[:] for row in self.engine.state.data]
                    data[r][c] = v
                    new_mat = TernaryMatrix(data)
                    self.engine.transition('set', new_mat, {'set': (r, c, v)})
                    print(f"✅ Значение [{r}][{c}] = {v}")
                except Exception as e:
                    print(f"❌ Ошибка: {e}")

            elif action == "add":
                try:
                    mat = self._get_matrix_input(self.engine.state.rows, self.engine.state.cols)
                    self.engine.transition('add', mat)
                    print("✅ Сложение выполнено")
                except Exception as e:
                    print(f"❌ Ошибка: {e}")

            elif action == "mult":
                try:
                    mat = self._get_matrix_input(self.engine.state.cols, self.engine.state.rows)
                    self.engine.transition('multiply', mat)
                    print("✅ Умножение выполнено")
                except Exception as e:
                    print(f"❌ Ошибка: {e}")

            elif action == "transpose":
                self.engine.transition('transpose')
                print("✅ Транспонирование выполнено")

            elif action == "sin":
                self.engine.transition('sin')
                print("✅ Синус применён")

            elif action == "cos":
                self.engine.transition('cos')
                print("✅ Косинус применён")

            elif action == "tan":
                self.engine.transition('tan')
                print("✅ Тангенс применён")

            elif action == "cot":
                self.engine.transition('cot')
                print("✅ Котангенс применён")

            elif action == "sec":
                self.engine.transition('sec')
                print("✅ Секанс применён")

            elif action == "csc":
                self.engine.transition('csc')
                print("✅ Косеканс применён")

            elif action == "sinh":
                self.engine.transition('sinh')
                print("✅ Гиперболический синус применён")

            elif action == "cosh":
                self.engine.transition('cosh')
                print("✅ Гиперболический косинус применён")

            elif action == "tanh":
                self.engine.transition('tanh')
                print("✅ Гиперболический тангенс применён")

            elif action == "trig":
                analysis = self.engine.analyze()
                print("\n📊 ВСЕ ТРИГОНОМЕТРИЧЕСКИЕ ФУНКЦИИ:")
                for name, data in analysis.get('trig_functions', {}).items():
                    print(f"\n  {name}:")
                    for row in data.get('data', []):
                        print(f"    {row}")

            elif action == "predict":
                steps = int(cmd[1]) if len(cmd) > 1 else 1
                pred = self.engine.predict(steps)
                print(f"\n🔮 ПРОГНОЗ НА {steps} ШАГОВ:")
                for row in pred.data:
                    print(f"  {row}")

            elif action == "graph":
                graph = self.engine.get_graph()
                print("\n📊 ГРАФ СОСТОЯНИЙ:")
                print(f"  Узлов: {len(graph['nodes'])}")
                print(f"  Рёбер: {len(graph['edges'])}")
                print(f"  Текущая стабильность: {graph['stability']:.2f}")
                for node in graph['nodes'][-5:]:
                    print(f"    Блок {node['id']}: стаб={node['stability']:.2f}")

            elif action == "analyze":
                analysis = self.engine.analyze()
                print("\n📊 ПОЛНЫЙ АНАЛИЗ:")
                print(json.dumps(analysis, indent=2, ensure_ascii=False))

            elif action == "state":
                state = self.engine.get_state()
                print("\n📊 ПОЛНОЕ СОСТОЯНИЕ:")
                print(json.dumps(state, indent=2, ensure_ascii=False))

            else:
                print(f"❌ Неизвестная команда: {action}")

            input("\nНажмите Enter для продолжения...")


