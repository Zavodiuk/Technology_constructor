# 1. БАЗОВЫЕ ТИПЫ — ТРОИЧНАЯ ЛОГИКА
# ============================================================

class Ternary(Enum):
    """Троичное значение: -1 (Ложь), 0 (Неопределённость), 1 (Истина)"""
    FALSE = -1
    UNDEFINED = 0
    TRUE = 1

    def __int__(self):
        return self.value

    def __repr__(self):
        return f"Ternary({self.value})"

# ============================================================
# 2. ТРОИЧНАЯ МАТРИЦА — ОСНОВНОЙ ТИП V9
# ============================================================

class TernaryMatrix:
    """
    Троичная матрица — основной тип данных V9
    Значения: -1, 0, 1
    Поддерживает: сложение, умножение, транспонирование, детерминант,
                  синус, косинус, тангенс, котангенс, секанс, косеканс,
                  гиперболические функции, арк-функции
    """

    def __init__(self, data: List[List[int]]):
        self.data = data
        self.rows = len(data)
        self.cols = len(data[0]) if data else 0
        self._validate()
        self._hash = None

    def _validate(self):
        """Проверка валидности матрицы"""
        if not self.data:
            raise ValueError("Матрица не может быть пустой")

        for row in self.data:
            if len(row) != self.cols:
                raise ValueError(f"Все строки должны быть одинаковой длины. "
                                 f"Ожидается {self.cols}, получено {len(row)}")
            for val in row:
                if val not in [-1, 0, 1]:
                    raise ValueError(f"Недопустимое значение {val}. Допустимы -1, 0, 1")

    def __repr__(self):
        return f"TernaryMatrix({self.rows}x{self.cols})"

    def __eq__(self, other):
        if not isinstance(other, TernaryMatrix):
            return False
        if self.rows != other.rows or self.cols != other.cols:
            return False
        return all(self.data[i][j] == other.data[i][j]
                   for i in range(self.rows) for j in range(self.cols))

    # ---- БАЗОВЫЕ ОПЕРАЦИИ ----

    def copy(self) -> 'TernaryMatrix':
        """Создать копию матрицы"""
        return TernaryMatrix([row[:] for row in self.data])

    def to_dict(self) -> Dict:
        return {
            'rows': self.rows,
            'cols': self.cols,
            'data': self.data,
            'hash': self.hash
        }

    @property
    def hash(self) -> str:
        if self._hash is None:
            content = json.dumps(self.data)
            self._hash = hashlib.sha256(content.encode()).hexdigest()
        return self._hash

    # ---- МАТРИЧНЫЕ ОПЕРАЦИИ ----

    def add(self, other: 'TernaryMatrix') -> 'TernaryMatrix':
        """Троичное сложение матриц (с клиппингом)"""
        if self.rows != other.rows or self.cols != other.cols:
            raise ValueError(f"Размеры не совпадают: {self.rows}x{self.cols} vs "
                            f"{other.rows}x{other.cols}")

        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                s = self.data[i][j] + other.data[i][j]
                if s > 1:
                    s = 1
                elif s < -1:
                    s = -1
                row.append(s)
            result.append(row)
        return TernaryMatrix(result)

    def multiply(self, other: 'TernaryMatrix') -> 'TernaryMatrix':
        """Троичное умножение матриц (с клиппингом)"""
        if self.cols != other.rows:
            raise ValueError(f"Несовместимые размеры: {self.cols} != {other.rows}")

        result = []
        for i in range(self.rows):
            row = []
            for j in range(other.cols):
                s = 0
                for k in range(self.cols):
                    s += self.data[i][k] * other.data[k][j]
                if s > 1:
                    s = 1
                elif s < -1:
                    s = -1
                row.append(s)
            result.append(row)
        return TernaryMatrix(result)

    def transpose(self) -> 'TernaryMatrix':
        """Транспонирование матрицы"""
        result = [[self.data[j][i] for j in range(self.rows)] for i in range(self.cols)]
        return TernaryMatrix(result)

    def determinant(self) -> int:
        """Детерминант (реализован для 1x1, 2x2, 3x3)"""
        if self.rows != self.cols:
            raise ValueError("Детерминант только для квадратных матриц")

        if self.rows == 1:
            return self.data[0][0]

        if self.rows == 2:
            return self.data[0][0] * self.data[1][1] - self.data[0][1] * self.data[1][0]

        if self.rows == 3:
            a, b, c = self.data[0]
            d, e, f = self.data[1]
            g, h, i = self.data[2]
            det = (a * (e*i - f*h) -
                   b * (d*i - f*g) +
                   c * (d*h - e*g))
            # Нормализация в троичную логику
            if det > 0:
                return 1
            elif det < 0:
                return -1
            return 0

        raise ValueError(f"Детерминант для {self.rows}x{self.rows} не реализован")

    # ---- ТРИГОНОМЕТРИЧЕСКИЕ ФУНКЦИИ ----

    def sin(self) -> 'TernaryMatrix':
        """
        Синус — проекция на диагональ (самоидентификация)
        Оставляет только диагональные элементы
        """
        size = min(self.rows, self.cols)
        result = [[0 for _ in range(self.cols)] for _ in range(self.rows)]
        for i in range(size):
            result[i][i] = self.data[i][i]
        return TernaryMatrix(result)

    def cos(self) -> 'TernaryMatrix':
        """
        Косинус — квадрат матрицы (самосходство)
        Упрощённо: оставляет значения, которые равны 1 или -1
        """
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[i][j]
                if val == 0:
                    row.append(0)
                else:
                    row.append(1 if val > 0 else -1)
            result.append(row)
        return TernaryMatrix(result)

    def tan(self) -> 'TernaryMatrix':
        """
        Тангенс — отношение строк к столбцам
        Показывает доминирование
        """
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[i][j]
                if val == 0:
                    row.append(0)
                else:
                    row.append(1 if val > 0 else -1)
            result.append(row)
        return TernaryMatrix(result)

    def cot(self) -> 'TernaryMatrix':
        """Котангенс — обратное отношение"""
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[j][i] if j < self.cols and i < self.rows else 0
                if val == 0:
                    row.append(0)
                else:
                    row.append(1 if val > 0 else -1)
            result.append(row)
        return TernaryMatrix(result)

    def sec(self) -> 'TernaryMatrix':
        """
        Секанс — индекс нестабильности
        1/cos: инверсия сходства
        """
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[i][j]
                if val == 0:
                    row.append(0)      # максимальная нестабильность
                elif val == 1:
                    row.append(1)      # стабильность
                else:  # -1
                    row.append(-1)     # нестабильность
            result.append(row)
        return TernaryMatrix(result)

    def csc(self) -> 'TernaryMatrix':
        """
        Косеканс — уровень внутреннего конфликта
        1/sin: инверсия самоидентификации
        """
        size = min(self.rows, self.cols)
        result = [[0 for _ in range(self.cols)] for _ in range(self.rows)]
        for i in range(size):
            val = self.data[i][i]
            if val == 0:
                result[i][i] = 0       # конфликт
            elif val == 1:
                result[i][i] = 1       # нет конфликта
            else:  # -1
                result[i][i] = -1      # внутренний конфликт
        return TernaryMatrix(result)

    # ---- ГИПЕРБОЛИЧЕСКИЕ ФУНКЦИИ ----

    def sinh(self) -> 'TernaryMatrix':
        """
        Гиперболический синус — скорость перехода
        sinh(x) = (e^x - e^-x)/2
        В троичной логике: 1 (ускорение), -1 (замедление), 0 (равномерно)
        """
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[i][j]
                if val > 0:
                    row.append(1)
                elif val < 0:
                    row.append(-1)
                else:
                    row.append(0)
            result.append(row)
        return TernaryMatrix(result)

    def cosh(self) -> 'TernaryMatrix':
        """
        Гиперболический косинус — энергия системы
        cosh(x) = (e^x + e^-x)/2
        В троичной логике: 1 (энергия есть), 0 (энергии нет)
        """
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[i][j]
                row.append(1 if val != 0 else 0)
            result.append(row)
        return TernaryMatrix(result)

    def tanh(self) -> 'TernaryMatrix':
        """
        Гиперболический тангенс — стабилизация (сигмоид)
        tanh(x) = sinh(x)/cosh(x)
        Показывает: 1 (стабилизировалась), -1 (дестабилизировалась), 0 (в процессе)
        """
        result = []
        for i in range(self.rows):
            row = []
            for j in range(self.cols):
                val = self.data[i][j]
                if val > 0:
                    row.append(1)
                elif val < 0:
                    row.append(-1)
                else:
                    row.append(0)
            result.append(row)
        return TernaryMatrix(result)

    # ---- АРК-ФУНКЦИИ ----

    def asin(self) -> 'TernaryMatrix':
        """
        Арксинус — поиск состояния по самоидентификации
        asin(1) = 1, asin(-1) = -1, asin(0) = 0
        """
        return self.copy()

    def acos(self) -> 'TernaryMatrix':
        """Арккосинус — поиск состояния по сходству"""
        return self.copy()

    def atan(self) -> 'TernaryMatrix':
        """Арктангенс — поиск состояния по доминированию"""
        return self.copy()

    # ---- ДОПОЛНИТЕЛЬНЫЕ ОПЕРАЦИИ ----

    def convolve(self, other: 'TernaryMatrix') -> 'TernaryMatrix':
        """Свёртка матриц (для прогнозирования)"""
        return self.multiply(other)

    def stability_index(self) -> float:
        """Индекс устойчивости системы (0-1) на основе детерминанта"""
        try:
            det = self.determinant()
            return (det + 1) / 2.0
        except:
            return 0.5

    def entropy(self) -> float:
        """Энтропия матрицы (мера неопределённости)"""
        ones = sum(row.count(1) for row in self.data)
        zeros = sum(row.count(0) for row in self.data)
        negs = sum(row.count(-1) for row in self.data)
        total = self.rows * self.cols

        if total == 0:
            return 0.0

        p1 = ones / total
        p0 = zeros / total
        pn = negs / total

        ent = 0.0
        for p in [p1, p0, pn]:
            if p > 0:
                ent -= p * math.log2(p)
        return ent

    # ---- ПАКЕТЫ ФУНКЦИЙ ----

    def trig_package(self) -> Dict[str, 'TernaryMatrix']:
        """Вернуть все тригонометрические функции"""
        return {
            'sin': self.sin(),
            'cos': self.cos(),
            'tan': self.tan(),
            'cot': self.cot(),
            'sec': self.sec(),
            'csc': self.csc()
        }

    def hyperbolic_package(self) -> Dict[str, 'TernaryMatrix']:
        """Вернуть все гиперболические функции"""
        return {
            'sinh': self.sinh(),
            'cosh': self.cosh(),
            'tanh': self.tanh()
        }

    def all_functions(self) -> Dict[str, 'TernaryMatrix']:
        """Вернуть все функции разом"""
        result = self.trig_package()
        result.update(self.hyperbolic_package())
        result.update({
            'asin': self.asin(),
            'acos': self.acos(),
            'atan': self.atan()
        })
        return result

