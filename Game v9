@dataclass
class WaveNode:
    id: int
    amplitude: float
    phase: float
    position: Tuple[float, float]
    children: List[int] = field(default_factory=list)
    parents: List[int] = field(default_factory=list)

    def generate_wave(self, time: float) -> float:
        omega = 2.0
        return self.amplitude * math.sin(omega * time + self.phase)

    def spread(self, time: float, nodes: Dict[int, 'WaveNode'], geometry: GeometryEngine) -> Dict[int, float]:
        result = {}
        for child_id in self.children:
            if child_id in nodes:
                child = nodes[child_id]
                distance = geometry.distance(self.position, child.position)
                attenuation = 1.0 / (1.0 + distance)
                amplitude = self.generate_wave(time) * attenuation
                result[child_id] = amplitude
        return result


class InterferenceMatrix:
    def __init__(self, geometry: GeometryEngine):
        self.nodes: Dict[int, WaveNode] = {}
        self.waves: Dict[int, float] = {}
        self.geometry = geometry

    def add_node(self, node: WaveNode):
        self.nodes[node.id] = node

    def propagate_waves(self, time: float) -> Dict[int, float]:
        result = {}
        for node_id, node in self.nodes.items():
            spread = node.spread(time, self.nodes, self.geometry)
            for child_id, amp in spread.items():
                result[child_id] = result.get(child_id, 0.0) + amp
        self.waves = result
        return result

    def interference_pattern(self, time: float) -> Dict[int, float]:
        result = {}
        for node_id, node in self.nodes.items():
            incoming = self.waves.get(node_id, 0.0)
            own = node.generate_wave(time)
            result[node_id] = incoming + own
        return result

    def find_conflicts(self, time: float, threshold: float = 0.3) -> List[int]:
        pattern = self.interference_pattern(time)
        return [nid for nid, val in pattern.items() if abs(val) > threshold]

    def stability_index(self, time: float) -> float:
        conflicts = self.find_conflicts(time)
        total = len(self.nodes) if self.nodes else 1
        return 1.0 - len(conflicts) / total


class KirchhoffBalance:
    def __init__(self):
        self.cycles: List[List[int]] = []

    def find_cycles(self, graph: Dict[int, List[int]]) -> List[List[int]]:
        cycles = []
        visited = set()

        def dfs(node: int, path: List[int]):
            if node in visited:
                if len(path) > 2:
                    cycle_start = path.index(node)
                    cycles.append(path[cycle_start:])
                return
            visited.add(node)
            for neighbor in graph.get(node, []):
                if neighbor not in path or neighbor == path[0]:
                    dfs(neighbor, path + [neighbor])
            visited.remove(node)

        for node in graph:
            if node not in visited:
                dfs(node, [node])
        self.cycles = cycles
        return cycles

    def system_balance(self, waves: Dict[int, float]) -> float:
        return sum(waves.values())

    def is_balanced(self, waves: Dict[int, float], tolerance: float = 0.01) -> bool:
        return abs(self.system_balance(waves)) < tolerance


