class Maschera(Enum):
    """12 архетипов итальянской комедии dell'arte"""
    PANTALONE = "панталоне"        # Деньги, власть, интересы
    DOTTOR = "доктор"              # Логика, правила, знание
    CAPITANO = "капитан"           # Сила, риск, смелость
    BRIGHELLA = "бригелла"         # План, исполнение, тактика
    ARLECCHINO = "арлекино"        # Простота, трюки, хитрость
    TARTAGLIA = "тарталья"         # Ошибки, слабости, логика
    INNAMORATI = "влюблённые"      # Красота, чувства, справедливость
    COLOMBINA = "коломбина"        # Скрытое, правда, интуиция
    PULCINELLA = "пульчинелла"    # Честность, народ, простой смысл
    SCAPINO = "скапино"            # Манёвры, гибкость, ловкость
    GIANDUJA = "джандуя"           # Искренность, простота, человечность
    BALANZONE = "баланцоне"        # Точность, корректность, формы


@dataclass
class MascheraProfile:
    name: Maschera
    group: str
    description: str
    fact_keywords: List[str]  # Ключевые слова для поиска в фактах
    weight: float = 1.0
    active: bool = True

    def find_relevant_facts(self, facts: Dict[str, Any]) -> Dict[str, Any]:
        """Найти релевантные факты для этой маски"""
        relevant = {}
        facts_lower = {k.lower(): v for k, v in facts.items()}
        keywords_lower = [kw.lower() for kw in self.fact_keywords]
        
        for fact_key, fact_value in facts_lower.items():
            for kw in keywords_lower:
                if kw in fact_key:
                    relevant[fact_key] = fact_value
                    break
        
        # Если нет релевантных фактов, используем все
        if not relevant:
            relevant = facts_lower
        
        return relevant

    def evaluate(self, facts: Dict[str, Any]) -> float:
        """Оценить факты через призму этой маски"""
        relevant = self.find_relevant_facts(facts)
        
        if not relevant:
            return 0.5
        
        values = list(relevant.values())
        avg_value = sum(values) / len(values)
        
        # Каждая маска интерпретирует факты по-своему
        if self.name == Maschera.PANTALONE:
            # "Сколько это стоит?" → Ищет экономическую выгоду
            return 0.5 * avg_value + 0.5 * (1 - avg_value)  # Противоречие цены vs выгоды
        
        elif self.name == Maschera.DOTTOR:
            # "Логично ли это?" → Проверяет логическую согласованность
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return 1.0 - std_dev  # Низкая дисперсия = логично
        
        elif self.name == Maschera.CAPITANO:
            # "Покажем ли мы силу?" → Ищет максимальные значения
            return max(values) if values else 0.5
        
        elif self.name == Maschera.BRIGHELLA:
            # "Какой практический план?" → Ищет среднее (баланс)
            return avg_value
        
        elif self.name == Maschera.ARLECCHINO:
            # "А что, если всё проще?" → Ищет простоту (низкую дисперсию)
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return 1.0 - std_dev
        
        elif self.name == Maschera.TARTAGLIA:
            # "Где логическая ошибка?" → Ищет противоречия
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return std_dev  # Высокая дисперсия = проблемы
        
        elif self.name == Maschera.INNAMORATI:
            # "Нравится ли нам это?" → Эмоциональная оценка (выше среднего)
            return avg_value
        
        elif self.name == Maschera.COLOMBINA:
            # "Что на самом деле?" → Истина в самых высоких значениях
            return max(values) if values else 0.5
        
        elif self.name == Maschera.PULCINELLA:
            # "А что думает народ?" → Народное большинство
            return avg_value
        
        elif self.name == Maschera.SCAPINO:
            # "Как обойти препятствие?" → Гибкость (средние значения)
            return avg_value
        
        elif self.name == Maschera.GIANDUJA:
            # "Насколько это искренне?" → Честность (согласованность)
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return 1.0 - std_dev
        
        elif self.name == Maschera.BALANZONE:
            # "Насколько это точно?" → Точность (минимальная дисперсия)
            std_dev = math.sqrt(sum((v - avg_value)**2 for v in values) / len(values)) if values else 0
            return 1.0 - std_dev
        
        return avg_value


