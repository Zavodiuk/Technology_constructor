            ["народ", "мнени", "обществ", "масс", "большин", "люд"]
        ))
        self.maschere.append(MascheraProfile(
            Maschera.SCAPINO, "человек",
            "Как обойти препятствие? (гибкость, маневры)",
            ["гибк", "манев", "адапт", "обход", "альтер"]
        ))
        self.maschere.append(MascheraProfile(
            Maschera.GIANDUJA, "человек",
            "Насколько это искренне? (искренность, честность)",
            ["искренн", "честн", "правдив", "откры", "透明"]
        ))
        self.maschere.append(MascheraProfile(
            Maschera.BALANZONE, "власть",
            "Насколько это точно? (точность, корректность, формы)",
            ["точн", "коррект", "формаль", "правилльн", "акурат"]
        ))

    def evaluate(self, facts: Dict[str, Any]) -> Dict[str, Any]:
        """Оценить факты всеми масками"""
        results = {}
        weighted_sum = 0.0
        total_weight = 0.0

        for m in self.maschere:
            if not m.active:
                continue
            score = m.evaluate(facts)
            weighted = score * m.weight
            results[m.name.value] = {
                "score": round(score, 3),
                "weight": m.weight,
                "weighted": round(weighted, 3),
                "group": m.group,
                "description": m.description
            }
            weighted_sum += weighted
            total_weight += m.weight

        if total_weight == 0:
            return {"error": "Нет активных масок"}

        scores = [r["score"] for r in results.values()]
        avg_score = sum(scores) / len(scores)
        std_dev = math.sqrt(sum((s - avg_score)**2 for s in scores) / len(scores))
        is_coherent = std_dev < 0.15

        return {
            "results": results,
            "weighted_sum": round(weighted_sum / total_weight, 3),
            "coherence": is_coherent,
            "std_dev": round(std_dev, 3),
            "avg_score": round(avg_score, 3)
        }
    
    def find_leading_maschera(self, evaluation: Dict[str, Any]) -> Optional[str]:
        """Найти маску с наивысшей оценкой"""
        if "results" not in evaluation:
            return None
        results = evaluation["results"]
        if not results:
            return None
        leading = max(results.items(), key=lambda x: x[1]["weighted"])
        return leading[0]


