    священного египетского треугольника 3-4-5 (Pythagorean Lock) в SoA структуре.
    """
    n_feat = features.shape[0]
    for i in range(DIM_120):
        val = float(features[i % n_feat])
        clipped = int(np.clip(round(val), -2, 2))

        # Применение священного египетского треугольника 3-4-5
        leg3 = float((i % 3) + 1) * 3.0
        leg4 = float(clipped + 3) * 4.0
        pyth_factor = _njit_pythagorean_lock(leg3, leg4)
        
        excitation_val = sin_lut[i] * float(clipped) * pyth_factor
        exciter_120d[i] = excitation_val

        # Тринарная квантизация по Брусенцову-Лукасевичу (-1, 0, +1)
        b_state = 1 if val >= 0.33 else (-1 if val <= -0.33 else 0)

        if i < DIM_60:
            face_res[i] = np.int8(clipped)
            face_bruns[i] = np.int8(b_state)
            face_weight[i] = int(excitation_val * 1000.0)
        else:
            v_idx = i - DIM_60
            vertex_res[v_idx] = np.int8(clipped)
            vertex_bruns[v_idx] = np.int8(b_state)
            vertex_tension[v_idx] = int(excitation_val * 1000.0)


