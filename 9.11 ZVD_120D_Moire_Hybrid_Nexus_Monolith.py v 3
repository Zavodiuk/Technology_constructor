@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_pythagorean_lock(leg3: float, leg4: float) -> float:
    """Священный египетский треугольник 3-4-5: аппаратный расчет гипотенузы для фазового замка."""
    hypot_sq = leg3 * leg3 + leg4 * leg4
    return np.sqrt(hypot_sq) / 5.0


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_moiré_interference_120d(face_residual: np.ndarray, vertex_residual: np.ndarray, angle_a: float, angle_b: float) -> float:
    """Муаровая интерференция встречно-вращающихся био-ядер в 120D пространстве на SoA массивах."""
    n = face_residual.shape[0]
    total_interference = 0.0
    cos_a = math.cos(angle_a)
    sin_a = math.sin(angle_a)
    cos_b = math.cos(angle_b)
    sin_b = math.sin(angle_b)
    
    for i in prange(n):
        val_a = float(face_residual[i])
        val_b = float(vertex_residual[i] if i < vertex_residual.size else 0.0)
        fx = (i - n // 2) * cos_a - (i - n // 2) * sin_a
        phase_mod = math.sin(fx * 0.1 + angle_a - angle_b)
        total_interference += (val_a + val_b) * (1.0 + 0.5 * phase_mod)
    return float(total_interference)


@njit(parallel=True, fastmath=True, cache=True, boundscheck=False)
def _njit_rashomon_evaluate_120d(matrix_120d: np.ndarray, out_results: np.ndarray):
    rows = matrix_120d.shape[0]
    cols = matrix_120d.shape[1]
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = matrix_120d[i, 0]
        max_val = matrix_120d[i, 0]
        for j in range(cols):
            val = matrix_120d[i, j]
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val: min_val = val
            if val > max_val: max_val = val
        mean_val = sum_val / cols
        var_sum = 0.0
        for j in range(cols):
            val = matrix_120d[i, j]
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        out_results[i, 0] = mean_val
        out_results[i, 1] = min_val
        out_results[i, 2] = max_val
        out_results[i, 3] = std_val
        out_results[i, 4] = -(abs_sum_val / cols) - (std_val * 0.15)


@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_ingest_and_excite_120d(
    features: np.ndarray,
    face_res: np.ndarray, face_bruns: np.ndarray, face_weight: np.ndarray, face_tension: np.ndarray, face_phase: np.ndarray,
    vertex_res: np.ndarray, vertex_bruns: np.ndarray, vertex_weight: np.ndarray, vertex_tension: np.ndarray, vertex_phase: np.ndarray,
    exciter_120d: np.ndarray,
    sin_lut: np.ndarray
