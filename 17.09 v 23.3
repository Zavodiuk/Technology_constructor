# МОДУЛЬ 1: КВАТЕРНИОННАЯ КИНЕМАТИКА 3D-ВРАЩЕНИЯ (SO(3))
# ============================================================================
class Quaternion:
    """
    [RU] Кватернион для безсингулярного пространственного вращения (q = w + xi + yj + zk).
    [EN] Quaternion for singularity-free spatial rotation.
    """
    def __init__(self, w: float = 1.0, x: float = 0.0, y: float = 0.0, z: float = 0.0):
        norm = math.sqrt(w*w + x*x + y*y + z*z)
        if norm == 0:
            self.w, self.x, self.y, self.z = 1.0, 0.0, 0.0, 0.0
        else:
            self.w, self.x, self.y, self.z = w/norm, x/norm, y/norm, z/norm

    def update_by_velocity(self, axis: Tuple[float, float, float], angle_delta: float) -> None:
        ax, ay, az = axis
        norm_a = math.sqrt(ax*ax + ay*ay + az*az)
        if norm_a > 0:
            ax, ay, az = ax/norm_a, ay/norm_a, az/norm_a
        
        half_angle = angle_delta / 2.0
        s = math.sin(half_angle)
        dw = math.cos(half_angle)
        dx = ax * s
        dy = ay * s
        dz = az * s
        
        # Умножение кватернионов
        nw = self.w * dw - self.x * dx - self.y * dy - self.z * dz
        nx = self.w * dx + self.x * dw + self.y * dz - self.z * dy
        ny = self.w * dy - self.x * dz + self.y * dw + self.z * dx
        nz = self.w * dz + self.x * dy - self.y * dx + self.z * dw
        
        norm = math.sqrt(nw*nw + nx*nx + ny*ny + nz*nz)
        if norm > 0:
            self.w, self.x, self.y, self.z = nw/norm, nx/norm, ny/norm, nz/norm


# ============================================================================
# МОДУЛЬ 2: ТЕТРАЭДРИЧЕСКИЙ СИМПЛЕКС (14 ЭЛЕМЕНТОВ ВЫСОКОЙ ПЛОТНОСТИ)
# ============================================================================
class TetrahedralUnit:
    """
    [RU] Минимальный объемный жесткий элемент: 4 вершины, 6 рёбер, 4 грани (всего 14 элементов).
    Пентарная емкость: 5^14 (~6.1 млрд состояний) в ~4 байтах чистой памяти.
    [EN] Minimal volumetric rigid simplex: 4 vertices, 6 edges, 4 faces (14 elements total).
    """
    def __init__(self):
        self.vertices = np.zeros(4, dtype=int)  # 4 Вершины
        self.edges = np.zeros(6, dtype=int)     # 6 Рёбер
        self.faces = np.zeros(4, dtype=int)     # 4 Грани
        
        # Инициализация базовым распределением пентарных состояний
        self.vertices[:] = [1, 0, -1, 2]
        self.edges[:] = [0, 1, -1, 0, 2, -2]
        self.faces[:] = [1, -1, 0, 1]
        
        self.quaternion = Quaternion(1.0, 0.0, 0.0, 0.0)

    def get_flat_array(self) -> np.ndarray:
        return np.concatenate([self.vertices, self.edges, self.faces])

    def calculate_unit_entropy(self) -> float:
        flat = self.get_flat_array()
        total = flat.size
        _, counts = np.unique(flat, return_counts=True)
        entropy = 0.0
        for count in counts:
            p = count / total
            if p > 0:
                entropy -= p * math.log2(p)
        return float(entropy)

    def recover_extremes(self) -> int:
        """Рекуперация: сброс застоявшихся состояний (-2) в ламинарный ноль (0)."""
        count = int(np.sum(self.vertices == -2) + np.sum(self.edges == -2) + np.sum(self.faces == -2))
        self.vertices[self.vertices == -2] = 0
        self.edges[self.edges == -2] = 0
        self.faces[self.faces == -2] = 0
        return count


# ============================================================================
# МОДУЛЬ 3: ФАЗОВЫЙ ГИСТЕРЕЗИС И ТОПОЛОГИЧЕСКАЯ ПАМЯТЬ
# ============================================================================
class PhaseHysteresisMemory:
    """[RU] Устранение дребезга сигналов через скользящее окно истории."""
    def __init__(self, window_size: int = 4):
        self.history = deque(maxlen=window_size)

    def register_state(self, state: int) -> int:
        self.history.append(state)
        avg = sum(self.history) / len(self.history)
        if avg > 1.2: return 2
        elif avg > 0.3: return 1
        elif avg >= -0.3: return 0
        elif avg >= -1.2: return -1
        else: return -2


# ============================================================================
# МОДУЛЬ 4: ИНТЕГРИРОВАННЫЙ ОРКЕСТРАТОР ПРОСТРАНСТВЕННОГО МУАРА V23.3
# ============================================================================
class MoiréTetrahedralOrchestratorV23_3:
    """
    [RU] Главный оркестратор: управляет контрвращением двух тетраэдров через кватернионы,
    считает 3D-интерференцию муара, обрабатывает энтропию и гистерезис шлюза.
    """
    def __init__(self):
        self.tetra_a = TetrahedralUnit()
        self.tetra_b = TetrahedralUnit()
        self.rotation_axis = (0.577, 0.577, 0.577)  # Диагональная ось вращения в 3D
        self.hysteresis = PhaseHysteresisMemory(window_size=4)
        self.time_step: int = 0

    def execute_cycle(self) -> Tuple[int, int, float, float]:
        self.time_step += 1
        entropy_a = self.tetra_a.calculate_unit_entropy()
        entropy_b = self.tetra_b.calculate_unit_entropy()
        mean_entropy = (entropy_a + entropy_b) / 2.0
        
        # Автоматическая рекуперация при превышении порога энтропии
        if mean_entropy > 0.65:
            self.tetra_a.recover_extremes()
            self.tetra_b.recover_extremes()
        
        # Адаптивное замедление скорости вращения при росте хаоса
        vel_a = math.pi / (6.0 * (1.0 + mean_entropy))
        vel_b = math.pi / (4.0 * (1.0 + mean_entropy)) * 1.5
        
        # Обновление кватернионов (контрвращение)
        self.tetra_a.quaternion.update_by_velocity(self.rotation_axis, vel_a)
        self.tetra_b.quaternion.update_by_velocity(self.rotation_axis, -vel_b)
        
        flat_a = self.tetra_a.get_flat_array()
        flat_b = self.tetra_b.get_flat_array()
        
        # Расчет объемного тензорного муара
        interaction_sum = int(np.sum(flat_a * flat_b))
        matches = int(np.sum(flat_a == flat_b))
        
        # Пороговая квантизация шлюза
        if interaction_sum > 15: raw_gate = 2
        elif interaction_sum > 5: raw_gate = 1
        elif interaction_sum >= -5: raw_gate = 0
        elif interaction_sum >= -15: raw_gate = -1
        else: raw_gate = -2
        
        # Фильтрация дребезга через фазовый гистерезис
        stabilized_gate = self.hysteresis.register_state(raw_gate)
        coherence = float(matches / 14.0)
        
        return stabilized_gate, interaction_sum, mean_entropy, coherence

    def display_telemetry(self) -> None:
        gate, sum_val, entropy, coherence = self.execute_cycle()
        q_a = self.tetra_a.quaternion
        print(f"\n======== [ ТЕТРАЭДРИЧЕСКИЙ СИНХРО-МУАР V23.3: ТАКТ №{self.time_step} ] ========")
        print(f"  -> Пространственная энтропия (3D): {entropy:.4f}")
        print(f"  -> Кватернион ядра A [w, x, y, z]: {q_a.w:.3f}, {q_a.x:.3f}, {q_a.y:.3f}, {q_a.z:.3f}")
        print(f"  -> Интегральный тензорный муар (Σ): {sum_val:+d}")
        print(f"  -> Когерентность 14 элементов: {coherence:.2f}")
        print(f"  -> Стабилизированный шлюз (Гистерезис): {gate:+d} ({PENTAR_CODE[gate]}[span_1](start_span)[span_1](end_span))")


