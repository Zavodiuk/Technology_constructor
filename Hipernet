# 1. ТРОИЧНАЯ ЛОГИКА (L3)
# ============================================================

def quantize(value: float, low: float = 0.3, high: float = 0.7) -> int:
    if value >= high: return 1
    if value <= low: return -1
    return 0

def ternary_fold(values: List[int]) -> int:
    s = sum(values)
    if s > 0: return 1
    if s < 0: return -1
    return 0

