# 4. ГИПЕРНЕТ — ОРКЕСТРАТОР
# ============================================================

class HyperNet:
    def __init__(self):
        self.datacenters = {}
        self.history = []
        self.clock = 0

    def add_dc(self, name: str, lat: float, lon: float) -> DataCenter:
        dc = DataCenter(name, lat, lon)
        self.datacenters[dc._id] = dc
        self.clock += 1
        return dc

    def link(self, id1: str, id2: str, link_type: str = "optical", quality: float = 1.0):
        if id1 not in self.datacenters or id2 not in self.datacenters:
            return {"status": "error", "message": "Дата-центр не найден"}

        dc1 = self.datacenters[id1]
        dc2 = self.datacenters[id2]
        dc1.connect(dc2, link_type, quality)
        dc2.connect(dc1, link_type, quality)

        self.history.append({
            "action": "link",
            "from": dc1.name,
            "to": dc2.name,
            "time": time.time()
        })

        return {"status": "success"}

    def transmit(self, from_id: str, to_id: str, data: bytes) -> Dict:
        if from_id not in self.datacenters or to_id not in self.datacenters:
            return {"status": "error", "message": "Дата-центр не найден"}

        dc = self.datacenters[from_id]
        result = dc.send(to_id, data)

        if result["status"] == "success":
            # Симуляция приёма
            target = self.datacenters[to_id]
            target.receive(result["packet"])

        self.history.append({
            "action": "transmit",
            "from": dc.name,
            "to": self.datacenters[to_id].name,
            "size": len(data),
            "status": result["status"],
            "time": time.time()
        })

        return result

    def status(self) -> Dict:
        return {
            "datacenters": len(self.datacenters),
            "history": len(self.history),
            "clock": self.clock,
            "dcs": {dc.name: dc.status() for dc in self.datacenters.values()}
        }

