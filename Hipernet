class DataCenter:
    def __init__(self, name: str, latitude: float, longitude: float, radius: float = 1.0):
        self.name = name
        self.lat = latitude
        self.lon = longitude
        self.radius = radius
        self.routes = {}
        self.messages = []
        self.l3_status = 0
        self.active = True
        self.link_quality = 1.0  # 0..1
        self._id = hashlib.sha256(name.encode()).hexdigest()[:8]

        # Координаты в гиперболическом пространстве
        self.coords = (
            math.tanh(latitude / 90.0),
            math.tanh(longitude / 180.0),
            0.0
        )

        print(f"[{self.name}] Дата-центр инициализирован (ID: {self._id})")

    def connect(self, other: 'DataCenter', link_type: str = "optical", quality: float = 1.0):
        distance = hyperbolic_distance(self.coords, other.coords, self.radius)
        latency = distance * 10  # симуляция задержки

        self.routes[other._id] = {
            "target": other.name,
            "target_id": other._id,
            "distance": distance,
            "latency": latency,
            "link_type": link_type,
            "quality": quality,
            "active": True
        }

        print(f"[{self.name}] → [{other.name}] Связь установлена. Расстояние: {distance:.3f}, Задержка: {latency:.1f} мс")

    def send(self, target_id: str, data: bytes) -> Dict:
        if not self.active:
            return {"status": "veto", "message": "Дата-центр остановлен"}

        if target_id not in self.routes:
            return {"status": "error", "message": "Маршрут не найден"}

        route = self.routes[target_id]
        if not route["active"]:
            return {"status": "error", "message": "Маршрут не активен"}

        # 1. L3-фильтрация входа
        l3_in = quantize(len(data) / 1000.0)
        if l3_in == -1:
            return {"status": "rejected", "l3_in": -1}

        # 2. Упаковка в TMTP (симуляция)
        packet = {
            "from": self._id,
            "to": target_id,
            "data": data.hex()[:50] + "...",
            "size": len(data),
            "l3_in": l3_in,
            "timestamp": time.time(),
            "checksum": hashlib.sha256(data).hexdigest()[:8]
        }

        # 3. Симуляция гиперболической маршрутизации
        route_quality = route["quality"] * self.link_quality
        noise = (1 - route_quality) * 0.1
        l3_out = quantize(route_quality - noise)

        # 4. Сохранение в историю
        self.messages.append({
            "type": "sent",
            "target": target_id,
            "size": len(data),
            "l3_in": l3_in,
            "l3_out": l3_out,
            "time": time.time()
        })

        return {
            "status": "success",
            "l3_in": l3_in,
            "l3_out": l3_out,
            "packet": packet,
            "route": route,
            "quality": route_quality
        }

    def receive(self, packet: Dict) -> Dict:
        if not self.active:
            return {"status": "veto", "message": "Дата-центр остановлен"}

        if packet.get("to") != self._id:
            return {"status": "error", "message": "Пакет не для этого дата-центра"}

        # 1. L3-фильтрация входа
        l3_in = packet.get("l3_in", 0)
        if l3_in == -1:
            return {"status": "rejected", "l3_in": -1}

        # 2. Верификация через Rashomon (симуляция)
        l3_out = quantize(0.9 - random.random() * 0.2)

        # 3. Сохранение
        self.messages.append({
            "type": "received",
            "from": packet.get("from"),
            "size": packet.get("size", 0),
            "l3_in": l3_in,
            "l3_out": l3_out,
            "time": time.time()
        })

        return {
            "status": "success",
            "l3_in": l3_in,
            "l3_out": l3_out,
            "data": packet.get("data"),
            "from": packet.get("from")
        }

    def status(self) -> Dict:
        return {
            "name": self.name,
            "id": self._id,
            "active": self.active,
            "l3_status": self.l3_status,
            "routes": len(self.routes),
            "messages": len(self.messages),
            "link_quality": self.link_quality,
            "coords": self.coords
        }

    def veto(self):
        self.active = False
        self.l3_status = -1
        return {"status": "veto", "message": f"{self.name} остановлен"}

    def resume(self):
        self.active = True
        self.l3_status = 0
        return {"status": "resumed", "message": f"{self.name} активен"}

