class MmWave6GTransport:
    """Моделирование беспроводной среды mmWave (28/60 GHz) с лучеформированием и замираниями."""
    
    LEVEL_MAP = {-2: 0.1, -1: 0.3, 0: 0.5, 1: 0.7, 2: 0.9}
    INV_MAP = {0.1: -2, 0.3: -1, 0.5: 0, 0.7: 1, 0.9: 2}

    @staticmethod
    def modulate(data_bytes: bytes) -> List[float]:
        levels = []
        for b in data_bytes:
            val = int((b / 51.0) - 2)
            val = max(-2, min(2, val))
            levels.append(MmWave6GTransport.LEVEL_MAP[val])
        return levels

    @staticmethod
    def transmit_mmwave(signal_levels: List[float], beamforming_gain: float = 1.2, rain_attenuation: float = 0.05) -> List[float]:
        """Симуляция усиления лучеформированием (Beamforming) и атмосферного затухания на высоких частотах."""
        transmitted = []
        for amp in signal_levels:
            # Усиление направленным лучом минус затухание от осадков и случайный рэлеевский фейдинг
            fading = np.random.normal(0, 0.03)
            corrupted = (amp * beamforming_gain) - rain_attenuation + fading
            transmitted.append(max(0.05, min(0.95, corrupted)))
        return transmitted

    @staticmethod
    def demodulate(signal_levels: List[float]) -> bytes:
        out_bytes = bytearray()
        standard_levels = list(MmWave6GTransport.INV_MAP.keys())
        for amp in signal_levels:
            closest = min(standard_levels, key=lambda l: abs(l - amp))
            val = MmWave6GTransport.INV_MAP[closest]
            out_bytes.append(int((val + 2) * 51) & 0xFF)
        return bytes(out_bytes)


