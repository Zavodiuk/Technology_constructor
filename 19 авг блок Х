MONTH_SECONDS = 30 * 24 * 60 * 60

def _validate_probability(value: float, name: str) -> float:
    """Проверяет, что оценка является конечным числом в диапазоне [0, 1]."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise TypeError(f"{name} должна быть числом, получено {type(value).__name__}")
    value = float(value)
    if not math.isfinite(value) or not 0.0 <= value <= 1.0:
        raise ValueError(f"{name} должна находиться в диапазоне [0, 1]: {value}")
    return value


@dataclass
class LearningGuard:
    max_rate: float = 0.20
    current_growth: float = 0.0
    last_reset: float = field(default_factory=time.time)
    emergency_break: bool = False
    mode: str = "NORMAL"
    experience_log: List[Dict[str, Any]] = field(default_factory=list)

    def __post_init__(self) -> None:
        if not math.isfinite(self.max_rate) or self.max_rate < 0:
            raise ValueError("max_rate должен быть конечным неотрицательным числом")

    def _reset_if_new_cycle(self, now: Optional[float] = None) -> None:
        now = time.time() if now is None else now
        if now - self.last_reset >= MONTH_SECONDS:
            self.reset_cycle(now=now)

    def approve_learning(self, proposed_growth: float) -> bool:
        self._reset_if_new_cycle()
        if isinstance(proposed_growth, bool) or not isinstance(proposed_growth, (int, float)):
            raise TypeError("proposed_growth должна быть числом")
        proposed_growth = float(proposed_growth)
        if not math.isfinite(proposed_growth) or proposed_growth < 0:
            raise ValueError("proposed_growth должна быть конечной и неотрицательной")
        if self.emergency_break or self.current_growth + proposed_growth > self.max_rate:
            self.mode = "CONSERVATION"
            return False
        self.current_growth += proposed_growth
        self.adapt_mode()
        return True

    def adapt_mode(self) -> None:
        if self.current_growth >= self.max_rate * 0.95:
            self.mode = "CONSERVATION"
        elif self.current_growth >= self.max_rate * 0.80:
            self.mode = "RESTRICTED"
        else:
            self.mode = "NORMAL"

    def get_mode(self) -> str:
        self._reset_if_new_cycle()
        self.adapt_mode()
        return self.mode

    def reset_cycle(self, now: Optional[float] = None) -> None:
        self.current_growth = 0.0
        self.last_reset = time.time() if now is None else now
        self.mode = "NORMAL"
        self.experience_log.clear()

    def add_experience(self, experience: Dict[str, Any]) -> None:
        self.experience_log.append(dict(experience))
        del self.experience_log[:-100]

    def get_best_threshold(self, key: str, default: float = 0.3) -> float:
        values = [e[key] for e in self.experience_log if e.get("success") and key in e]
        return sum(values) / len(values) if values else default

    def status(self) -> Dict[str, Any]:
        self._reset_if_new_cycle()
        return {
            "mode": self.get_mode(),
            "current_growth": round(self.current_growth, 4),
            "monthly_limit": round(self.max_rate, 4),
            "remaining_capacity": round(max(0.0, self.max_rate - self.current_growth), 4),
            "experience_count": len(self.experience_log),
            "emergency_break": self.emergency_break,
        }



@dataclass
class BlockXResultV6_4:
    query: str
    l3_in: int
    l3_in_reason: str
    l3_out: int
    l3_out_reason: str
    delta_l3: int
    final_decision: str
    efficiency: float
    efficiency_trit: int
    experience_used: bool = False
    rollback_needed: bool = False
    rollback_reason: Optional[str] = None


class BlockXV6_4:
    def __init__(self) -> None:
        self.guard = LearningGuard()
        self.threshold_low = 0.3
        self.threshold_high = 0.7
        self.history: List[Dict[str, Any]] = []
        self.state = 0

    @staticmethod
    def efficiency(value: float, cost: float) -> float:
        value = _validate_probability(value, "value")
        if not math.isfinite(cost) or cost < 0:
            raise ValueError("cost должна быть конечной и неотрицательной")
        denominator = value + cost
        return value / denominator if denominator else 0.0

    def process(self, query: str, interpretations: Dict[str, float]) -> BlockXResultV6_4:
        if not isinstance(query, str) or not query.strip():
            raise ValueError("query должен быть непустой строкой")
        if not isinstance(interpretations, dict):
            raise TypeError("interpretations должен быть словарём")

        l3_in_result = rashomon_analyze(interpretations)
        l3_in = l3_in_result["state"]
        if l3_in == -1:
            return BlockXResultV6_4(query, -1, l3_in_result["reason"], -1,
                "Остановлено на входе (Veto)", 0, "REJECT", 0.0, -1,
                rollback_needed=True, rollback_reason="L3_IN_NEGATIVE")

        if self.guard.emergency_break:
            return BlockXResultV6_4(query, l3_in, l3_in_result["reason"], 0,
                "Остановлено аварийным контуром", -l3_in, "REJECT", 0.0, -1,
                rollback_needed=True, rollback_reason="EMERGENCY_BREAK")

        low = self.guard.get_best_threshold("threshold_low", self.threshold_low)
        high = self.guard.get_best_threshold("threshold_high", self.threshold_high)
        before_experience = len(self.guard.experience_log) > 0
        candidates = []
        for name, score in l3_in_result["all_scores"].items():
            candidates.append({"name": name, "score": score,
                               "efficiency": self.efficiency(score, 1.0 - score),
                               "l3": quantize(score, low, high)})
        best = max(candidates, key=lambda item: (item["score"], item["name"]))
        l3_out = best["l3"]
        if l3_out == 1:
            if self.guard.approve_learning(0.05):
                self.guard.add_experience({"query": query, "best": best["name"], "score": best["score"],
                    "threshold_low": low, "threshold_high": high, "success": True})
                reason = "SUCCESS"
            else:
                l3_out, reason = 0, "CONSERVATION_MODE"
        else:
            reason = "NEUTRAL_OR_NEGATIVE"

        self.state = l3_out
        self.history.append({"query": query, "l3_in": l3_in, "l3_out": l3_out,
                             "best": best["name"], "mode": self.guard.get_mode(), "time": time.time()})
        eff = best["efficiency"]
        return BlockXResultV6_4(query, l3_in, l3_in_result["reason"], l3_out, reason,
            l3_out - l3_in, "PASS" if l3_out == 1 else "CLARIFY" if l3_out == 0 else "REJECT",
            eff, quantize(eff), experience_used=before_experience,
            rollback_needed=l3_out == -1, rollback_reason="L3_OUT_NEGATIVE" if l3_out == -1 else None)

    def reset(self) -> None:
        self.guard.reset_cycle()
        self.history.clear()
        self.state = 0

    def veto(self) -> Dict[str, str]:
        self.guard.emergency_break = True
        return {"status": "veto", "message": "STOP Veto активирован"}

    def resume(self) -> Dict[str, str]:
        self.guard.emergency_break = False
        return {"status": "resumed", "message": "Работа возобновлена"}

    def status(self) -> Dict[str, Any]:
        return {"version": "6.4", "guard": self.guard.status(),
                "history_len": len(self.history), "state": self.state}


