import json
import time
import hashlib
import math
from typing import List, Dict, Any, Optional, Tuple
from dataclasses import dataclass

K = 2  # Параметр пентарного домена {-2, -1, 0, 1, 2}


class PentaryMatrix:
    """
    Пентарная матрица: элементы в диапазоне {-2, -1, 0, 1, 2}.
    Алгебра с насыщением (клиппингом) в границы [-2, 2] при арифметических операциях.
    """

    def __init__(self, data: List[List[int]]):
        self.data = data
        self.rows = len(data)
        self.cols = len(data[0]) if data else 0
        self._validate()

    def _validate(self):
        if not self.data:
            raise ValueError("Пентарная матрица не может быть пустой")
        for row in self.data:
            if len(row) != self.cols:
                raise ValueError(f"Несоответствие длины строк: ожидается {self.cols}, получено {len(row)}")
            for val in row:
                if val not in (-2, -1, 0, 1, 2):
                    raise ValueError(f"Недопустимое пентарное значение: {val}. Допустимы только от -2 до 2.")

    def __repr__(self):
        return f"PentaryMatrix({self.rows}x{self.cols}, K={K})"

    def __eq__(self, other):
        return isinstance(other, PentaryMatrix) and self.data == other.data

    def copy(self) -> 'PentaryMatrix':
        return PentaryMatrix([row[:] for row in self.data])

    @property
    def hash(self) -> str:
        return hashlib.sha256(json.dumps(self.data).encode()).hexdigest()

    def to_dict(self) -> Dict:
        return {
            'rows': self.rows, 
            'cols': self.cols, 
            'data': self.data, 
            'hash': self.hash[:16] + '...'
        }

    @staticmethod
    def _clip(v: int) -> int:
        return K if v > K else (-K if v < -K else v)

    def add(self, other: 'PentaryMatrix') -> 'PentaryMatrix':
        """Сложение в пентарном пространстве с насыщением до [-2, 2]."""
        if (self.rows, self.cols) != (other.rows, other.cols):
            raise ValueError(f"Размеры матриц не совпадают: {self.rows}x{self.cols} vs {other.rows}x{other.cols}")
        return PentaryMatrix([
            [self._clip(self.data[i][j] + other.data[i][j]) for j in range(self.cols)] 
            for i in range(self.rows)
        ])

    def multiply(self, other: 'PentaryMatrix') -> 'PentaryMatrix':
        """Матричное умножение с последующим клиппингом результатов в {-2..2}."""
        if self.cols != other.rows:
            raise ValueError(f"Несовместимые размеры для умножения: {self.cols} != {other.rows}")
        result = []
        for i in range(self.rows):
            row = []
            for j in range(other.cols):
                s = sum(self.data[i][k] * other.data[k][j] for k in range(self.cols))
                row.append(self._clip(s))
            result.append(row)
        return PentaryMatrix(result)

    def transpose(self) -> 'PentaryMatrix':
        return PentaryMatrix([[self.data[j][i] for j in range(self.rows)] for i in range(self.cols)])

    def stability_index(self) -> float:
        """Индекс стабильности пентарной среды: нормированная средняя энергия активации."""
        total_elements = self.rows * self.cols
        if total_elements == 0:
            return 0.0
        energy_sum = sum(abs(v) for row in self.data for v in row)
        return energy_sum / (total_elements * K)

    def entropy(self) -> float:
        """Расчет энтропии Шеннона по распределению элементов в диапазоне {-2..2}."""
        counts = {-2: 0, -1: 0, 0: 0, 1: 0, 2: 0}
        total = self.rows * self.cols
        for row in self.data:
            for v in row:
                counts[v] += 1
        
        if total == 0:
            return 0.0
        
        ent = 0.0
        for count in counts.values():
            if count > 0:
                p = count / total
                ent -= p * math.log2(p)
        return ent

    def energy_presence(self) -> 'PentaryMatrix':
        """Карта потенциалов: сохранение знака, но нормализация уровней активности."""
        return PentaryMatrix([
            [1 if v > 0 else (-1 if v < 0 else 0) for v in row] 
            for row in self.data
        ])


