@dataclass
class PentaryMatrixRecord:
    index: int
    timestamp: float
    prev_hash: str
    matrix: PentaryMatrix
    payload: Dict[str, Any]

    @property
    def hash(self) -> str:
        data = f"{self.index}{self.timestamp}{self.prev_hash}{self.matrix.hash}{json.dumps(self.payload, sort_keys=True)}"
        return hashlib.sha256(data.encode()).hexdigest()

    def to_dict(self) -> Dict:
        return {
            'index': self.index,
            'timestamp': self.timestamp,
            'prev_hash': self.prev_hash[:16] + '...',
            'matrix': self.matrix.to_dict(),
            'payload': self.payload,
            'hash': self.hash[:16] + '...'
        }


class PentaryMatrixAuditChain:
    def __init__(self, max_length: int = 500):
        self.records: List[PentaryMatrixRecord] = []
        self.max_length = max_length

    def add(self, matrix: PentaryMatrix, payload: Dict[str, Any]) -> PentaryMatrixRecord:
        record = PentaryMatrixRecord(
            index=len(self.records),
            timestamp=time.time(),
            prev_hash=self.records[-1].hash if self.records else 'GENESIS_PENTARY_MATRIX',
            matrix=matrix,
            payload=payload,
        )
        self.records.append(record)
        if len(self.records) > self.max_length:
            self.records.pop(0)
        return record

    def verify(self) -> Tuple[bool, int]:
        for i, r in enumerate(self.records):
            if i > 0 and r.prev_hash != self.records[i-1].hash:
                return False, i
        return True, -1

    def to_dict(self) -> Dict:
        verified, err = self.verify()
        return {'length': len(self.records), 'verified': verified, 'error_index': err if not verified else None}


