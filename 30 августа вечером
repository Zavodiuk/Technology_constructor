import numpy as np

def pentait_to_decimal(pentait_elements) -> int:
    """
    Переводит 6-разрядный пентаит в десятичную систему.
    Элементы пентаита должны быть числами от -2 до 2.
    Старший разряд находится слева (индекс 0).
    """
    if len(pentait_elements) != 6:
        raise ValueError("Длина пентаита должна быть строго 6 разрядов.")
        
    # Веса разрядов пятиричной системы (5^5, 5^4, 5^3, 5^2, 5^1, 5^0)
    weights = [3125, 625, 125, 25, 5, 1]
    
    decimal_value = 0
    for digit, weight in zip(pentait_elements, weights):
        if digit not in [-2, -1, 0, 1, 2]:
            raise ValueError(f"Недопустимый элемент в пентарном коде: {digit}")
        decimal_value += digit * weight
        
    return decimal_value

def parse_string_stream(stream_str: str) -> list:
    """
    Вспомогательная функция. Преобразует символьную строку вида "= - 0 1 2" 
    в числовой массив, где '=' означает -2, а '-' означает -1.
    """
    mapping = {'=': -2, '-': -1, '0': 0, '1': 1, '2': 2}
    # Удаляем пробелы
    clean_str = stream_str.replace(" ", "")
    
    parsed_code = []
    for char in clean_str:
        if char not in mapping:
            raise ValueError(f"Неизвестный символ в пентарном потоке: {char}")
        parsed_code.append(mapping[char])
    return parsed_code

def process_pentary_stream(stream, rows: int, cols: int):
    """
    Разбивает поток пентарного кода на пентаиты (по 6 элементов) 
    и формирует пентарную матрицу.
    """
    # Если на вход подали строку символов, переводим её в список чисел
    if isinstance(stream, str):
        pentary_code = parse_string_stream(stream)
    else:
        pentary_code = list(stream)
        
    required_pentaites = rows * cols
    required_elements = required_pentaites * 6
    
    if len(pentary_code) < required_elements:
        raise ValueError(f"Поток короткий. Нужно {required_elements} элементов, получено {len(pentary_code)}.")
        
    # 1. Группируем по 6 разрядов в пентаиты
    pentaites = [pentary_code[i:i+6] for i in range(0, required_elements, 6)]
    
    # 2. Считаем десятичные значения Брусенцовского типа для каждого пентаита
    decimals = [pentait_to_decimal(p) for p in pentaites]
    
    # 3. Упаковываем в матрицы
    # Символьное представление для красивого вывода
    inv_mapping = {-2: '=', -1: '-', 0: '0', 1: '1', 2: '2'}
    pentaites_str = ["".join([inv_mapping[d] for d in p]) for p in pentaites]
    
    pent_matrix_str = np.array(pentaites_str).reshape(rows, cols)
    pent_matrix_dec = np.array(decimals).reshape(rows, cols)
    
    return pent_matrix_str, pent_matrix_dec

