import numpy as np

# ==========================================
# 1. СЛОВАРИ И ВЕСА (Троично-пентарный базис)
# ==========================================
TRIT_MAP = {'+': 1, '0': 0, '-': -1}
PENT_MAP = {-2: '=', -1: '-', 0: '0', 1: '1', 2: '2'}

TRIT_WEIGHTS = [243, 81, 27, 9, 3, 1]
PENT_WEIGHTS = [3125, 625, 125, 25, 5, 1]

# Категории модальной логики Брусенцова для пентарных значений
BRUSENTSOV_LOGIC = {
     2: "Необходимо (Necessary)",
     1: "Возможно (Possible)",
     0: "Случайно / Нейтрально (Contingent)",
    -1: "Проблематично (Problematic)",
    -2: "Невозможно (Impossible)"
}

# ==========================================
# 2. БАЗОВЫЕ ВЫЧИСЛЕНИЯ
# ==========================================
def tryte_to_decimal(tryte_str: str) -> int:
    return sum(TRIT_MAP[t] * w for t, w in zip(tryte_str, TRIT_WEIGHTS))

def pentait_to_decimal(pentait_list: list) -> int:
    return sum(p * w for p, w in zip(pentait_list, PENT_WEIGHTS))

def parse_trit_stream(stream: str, rows: int, cols: int):
    stream = stream.replace(" ", "")
    required_trits = rows * cols * 6
    trytes = [stream[i:i+6] for i in range(0, required_trits, 6)]
    decimals = [tryte_to_decimal(t) for t in trytes]
    return np.array(trytes).reshape(rows, cols), np.array(decimals).reshape(rows, cols)

# ==========================================
# 3. СИНТЕЗ ТРОИЧНОГО В ПЕНТАРНЫЙ
# ==========================================
def synthesize_ternary_to_pentary(matrix_a, matrix_b):
    rows, cols = matrix_a.shape
    pent_matrix_str = np.zeros((rows, cols), dtype=object)
    pent_matrix_dec = np.zeros((rows, cols), dtype=int)
    # Сохраняем и «сырые» списки цифр от -2 до 2 для логического анализа
    pent_matrix_raw = np.zeros((rows, cols), dtype=object) 
    
    for r in range(rows):
        for c in range(cols):
            tryte_a = matrix_a[r, c]
            tryte_b = matrix_b[r, c]
            
            pentait_digits = [TRIT_MAP[t_a] + TRIT_MAP[t_b] for t_a, t_b in zip(tryte_a, tryte_b)]
            
            pent_matrix_str[r, c] = "".join([PENT_MAP[d] for d in pentait_digits])
            pent_matrix_dec[r, c] = pentait_to_decimal(pentait_digits)
            pent_matrix_raw[r, c] = pentait_digits
            
    return pent_matrix_str, pent_matrix_dec, pent_matrix_raw

# ==========================================
# 4. МОДАЛЬНЫЙ АНАЛИЗ БРУСЕНЦОВА
# ==========================================
def interpret_modality(matrix_raw):
    """Переводит каждый разряд каждого пентаита в модальное суждение."""
    rows, cols = matrix_raw.shape
    print("\n=== ВЕРИФИКАЦИЯ ПО МОДАЛЬНОЙ ЛОГИКЕ БРУСЕНЦОВА ===")
    for r in range(rows):
        for c in range(cols):
            digits = matrix_raw[r, c]
            print(f"\nЯчейка [{r},{c}] (Пентаит: {''.join([PENT_MAP[d] for d in digits])}):")
            for idx, d in enumerate(digits):
                print( f"  Разряд {idx+1} (вес {PENT_WEIGHTS[idx]}): {BRUSENTSOV_LOGIC[d]}")

