import numpy as np

def trit_to_int(trit: str) -> int:
    """Преобразует символьный трит Брусенцова в целое число."""
    mapping = {'+': 1, '0': 0, '-': -1}
    if trit not in mapping:
        raise ValueError(f"Недопустимый трит: {trit}. Используйте только '+', '0' или '-'.")
    return mapping[trit]

def tryte_to_decimal(tryte_str: str) -> int:
    """Переводит 6-тритовый трайт в десятичную систему (старший трит слева)."""
    if len(tryte_str) != 6:
        raise ValueError("Длина трайта должна быть строго 6 тритов.")
        
    weights = [243, 81, 27, 9, 3, 1]  # Веса разрядов троичной системы
    decimal_value = 0
    
    for trit, weight in zip(tryte_str, weights):
        decimal_value += trit_to_int(trit) * weight
        
    return decimal_value

def process_ternary_stream(stream: str, rows: int, cols: int):
    """
    Разбивает поток тритов на трайты и формирует:
    1. Матрицу символьных трайтов.
    2. Матрицу их десятичных значений.
    """
    # Удаляем пробелы, если они есть
    stream = stream.replace(" ", "")
    
    # Проверяем, хватает ли тритов для заполнения матрицы
    required_trytes = rows * cols
    required_trits = required_trytes * 6
    
    if len(stream) < required_trits:
        raise ValueError(f"Поток слишком короткий. Нужно минимум {required_trits} тритов.")
    
    # 1. Извлекаем трайты из потока
    trytes = [stream[i:i+6] for i in range(0, required_trits, 6)]
    
    # 2. Вычисляем десятичные значения для каждого трайта
    decimals = [tryte_to_decimal(t) for t in trytes]
    
    # 3. Преобразуем в матрицы нужной размерности
    tryte_matrix = np.array(trytes).reshape(rows, cols)
    decimal_matrix = np.array(decimals).reshape(rows, cols)
    
    return tryte_matrix, decimal_matrix

