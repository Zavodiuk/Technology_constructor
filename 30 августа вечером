# ЧАСТЬ 3: ДРУЖБА СИСТЕМ (СИНТЕЗ)
# ==========================================
def synthesize_ternary_to_pentary(matrix_a, matrix_b):
    """
    Поразрядно складывает две символьные троичные матрицы, 
    порождая пентарную матрицу из 6-разрядных пентаитов.
    """
    rows, cols = matrix_a.shape
    pent_matrix_str = np.zeros((rows, cols), dtype=object)
    pent_matrix_dec = np.zeros((rows, cols), dtype=int)
    
    for r in range(rows):
        for c in range(cols):
            # Получаем два трайта в одной и той же позиции матрицы
            tryte_a = matrix_a[r, c]
            tryte_b = matrix_b[r, c]
            
            # Поразрядное сложение тритов -> получаем элементы пентаита
            pentait_digits = []
            for t_a, t_b in zip(tryte_a, tryte_b):
                sum_digit = TRIT_MAP[t_a] + TRIT_MAP[t_b] # Результат от -2 до 2
                pentait_digits.append(sum_digit)
            
            # Переводим в символьный вид (с использованием '=' и '-')
            pentait_str = "".join([PENT_MAP[d] for d in pentait_digits])
            
            # Считаем десятичное значение по весам пентаита
            pent_matrix_str[r, c] = pentait_str
            pent_matrix_dec[r, c] = pentait_to_decimal(pentait_digits)
            
    return pent_matrix_str, pent_matrix_dec

