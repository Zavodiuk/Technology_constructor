@dataclass
class IntegrityBlock:
    index: int
    prev_hash: str
    payload_hash: str
    timestamp_ns: int
    tetra_sig: int
    block_hash: str = ""

    def compute(self) -> str:
        raw = (
            f"{self.index}:{self.prev_hash}:{self.payload_hash}:"
            f"{self.tetra_sig}:{self.timestamp_ns}"
        )
        self.block_hash = hashlib.sha256(raw.encode()).hexdigest()
        return self.block_hash


class IntegrityChain:
    def __init__(self) -> None:
        self.blocks: List[IntegrityBlock] = []
        gen = IntegrityBlock(0, "0" * 64, "GENESIS", time.time_ns(), 0)
        gen.compute()
        self.blocks.append(gen)

    def append(self, payload_hash: str) -> IntegrityBlock:
        prev = self.blocks[-1].block_hash
        sig = (int(payload_hash[:8], 16) % 5) - 2
        blk = IntegrityBlock(
            len(self.blocks), prev, payload_hash, time.time_ns(), sig
        )
        blk.compute()
        self.blocks.append(blk)
        return blk

    def verify(self) -> Tuple[bool, str]:
        for i in range(1, len(self.blocks)):
            cur, prev = self.blocks[i], self.blocks[i - 1]
            if cur.prev_hash != prev.block_hash:
                return False, f"broken at index {i}"
            expected = IntegrityBlock(
                cur.index, cur.prev_hash, cur.payload_hash,
                cur.timestamp_ns, cur.tetra_sig,
            )
            expected.compute()
            if expected.block_hash != cur.block_hash:
                return False, f"tampered at index {i}"
        return True, "OK"


class RashomonVerdict(str, Enum):
    GO = "GO"
    REVISE = "REVISE"
    NO_GO = "NO_GO"


def rashomon_gate(
    file_hash_ok: bool,
    chain_ok: bool,
    entropy_score: float = 0.5,
    force: bool = False,
) -> RashomonVerdict:
    if force:
        return RashomonVerdict.GO
    if not file_hash_ok or not chain_ok:
        return RashomonVerdict.NO_GO
    if entropy_score < 0.15 or entropy_score > 0.95:
        return RashomonVerdict.REVISE
    return RashomonVerdict.GO


