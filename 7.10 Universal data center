    def replicate(
        self,
        record_id: str,
        data: Any,
        target_dc: str,
        ontology: Optional[List[int]] = None,
        distance_km: float = 120.0,
        store_locally: bool = True,
        **link_kwargs: Any,
    ) -> InterDCResult:
        t0 = time.perf_counter()
        stages: List[PipelineStats] = []

        t1 = time.perf_counter()
        if isinstance(data, (str, dict, list)):
            raw = (
                data.encode("utf-8")
                if isinstance(data, str)
                else json.dumps(data, ensure_ascii=False).encode("utf-8")
            )
            buf = self.copy_in(raw)
        else:
            buf = self.copy_in(data)
        stages.append(
            PipelineStats("copy", (time.perf_counter() - t1) * 1000, buf.size, buf.size)
        )

        # variant C: typed data keeps type; raw → copy bytes
        stored = False
        if store_locally:
            t2 = time.perf_counter()
            if isinstance(data, (np.ndarray, str, dict, list)):
                self.store(record_id, data, ontology=ontology)
            elif isinstance(data, FastBuffer):
                self.store(record_id, data, ontology=ontology)
            else:
                self.store(record_id, buf.as_bytes(), ontology=ontology)
            stages.append(
                PipelineStats("store", (time.perf_counter() - t2) * 1000, bytes_in=buf.size)
            )
            stored = True

        t3 = time.perf_counter()
        if stored and record_id in self._storage.registry:
            meta = self._storage.registry[record_id]
            path = meta.get("path") or ""
            if path and os.path.exists(path):
                with open(path, "rb") as f:
                    wire = f.read()
            else:
                wire = meta.get("wire") or buf.as_bytes()
        else:
            wire = buf.as_bytes()

        tr = self.optical.transfer(
            wire, target_dc, distance_km=distance_km, **link_kwargs
        )
        stages.append(
            PipelineStats(
                "transfer", (time.perf_counter() - t3) * 1000,
                len(wire), tr.bytes_sent,
            )
        )

        return InterDCResult(
            record_id=record_id,
            copied=True,
            stored=stored,
            transferred=tr.success,
            target_dc=target_dc,
            total_latency_ms=(time.perf_counter() - t0) * 1000,
            stages=stages,
            optical_decision=tr.decision,
            checksum=buf.checksum(),
        )

    def triage_and_replicate(
        self,
        batch_scores: np.ndarray,
        payloads: List[bytes],
        record_ids: List[str],
        target_dc: str,
        distance_km: float = 120.0,
    ) -> List[InterDCResult]:
        decisions = _l3_triage(batch_scores.astype(np.float64))
        results: List[InterDCResult] = []
        for dec, payload, rid in zip(decisions, payloads, record_ids):
            if dec == -1:
                results.append(
                    InterDCResult(
rid, False, False, False, target_dc, 0.0, [], "SKIPPED", ""
                    )
                )
                continue
            results.append(
                self.replicate(rid, payload, target_dc, distance_km=distance_km)
            )
        return results

    # ----- file protect / unprotect -----
    def _sha256_bytes(self, data: bytes) -> str:
        return hashlib.sha256(data).hexdigest()

    def _entropy_norm(self, data: bytes) -> float:
        if not data:
            return 0.0
        counts = np.zeros(256, dtype=np.float64)
        for b in data:
            counts[b] += 1
        counts /= len(data)
        nz = counts[counts > 0]
        return float(-np.sum(nz * np.log2(nz))) / 8.0

    def _aad(self, filename: str, orig_size: int, file_hash: str) -> bytes:
        return f"{filename}|{orig_size}|{file_hash}|{BXFP_VERSION}".encode("utf-8")

    def protect(
        self,
        src_path: str,
        dst_path: Optional[str] = None,
        password: Optional[str] = None,
    ) -> ProtectResult:
        if not HAS_CRYPTO or self._master_key is None:
            return ProtectResult(
                False, "", 0, 0, "", RashomonVerdict.NO_GO.value,
                False, False, "cryptography not available",
            )
        src = Path(src_path)
        if not src.is_file():
            return ProtectResult(
                False, "", 0, 0, "", RashomonVerdict.NO_GO.value,
                False, False, f"file not found: {src_path}",
            )

        plain = src.read_bytes()
        orig_size = len(plain)
        file_hash = self._sha256_bytes(plain)
        file_hash_bin = bytes.fromhex(file_hash)

        body = plain
        flags = 0
        if self.use_moire and self.moire is not None:
            body = self.moire.diffuse(body, encrypt=True)
            flags |= FLAG_MOIRE

        salt = b""
        if password:
            salt = secrets.token_bytes(self.SALT_SIZE)
            key = derive_key_from_password(password, salt)
            flags |= FLAG_PASSWORD
        else:
            key = self._master_key

        nonce = secrets.token_bytes(12)
        aad = self._aad(src.name, orig_size, file_hash)
        ciphertext = AESGCM(key).encrypt(nonce, body, aad)

        header = struct.pack(
            BXFP_HEADER, BXFP_MAGIC, BXFP_VERSION, flags, 0,
            orig_size, file_hash_bin, nonce,
        )
        sealed = header + salt + ciphertext

        if dst_path is None:
            dst_path = str(Path(self.vault_dir) / (src.name + ".bxfp"))
        Path(dst_path).write_bytes(sealed)

        self.chain.append(file_hash)
        return ProtectResult(
            True, dst_path, orig_size, len(sealed), file_hash,
            RashomonVerdict.GO.value,
            bool(flags & FLAG_MOIRE), bool(flags & FLAG_PASSWORD),
            "protected OK",
        )

    def unprotect(
        self,
        sealed_path: str,
        dst_path: Optional[str] = None,
        password: Optional[str] = None,
        force: bool = False,
    ) -> UnprotectResult:
        if not HAS_CRYPTO or self._master_key is None:
            return UnprotectResult(
                False, "", 0, "", RashomonVerdict.NO_GO.value,
                "cryptography not available",
            )
        sealed_file = Path(sealed_path)
        if not sealed_file.is_file():
            return UnprotectResult(
                False, "", 0, "", RashomonVerdict.NO_GO.value,
                f"file not found: {sealed_path}",
            )

        blob = sealed_file.read_bytes()
        if len(blob) < self.BXFP_HEADER_SIZE:
            return UnprotectResult(
                False, "", 0, "", RashomonVerdict.NO_GO.value, "truncated header",
            )

        magic, ver, flags, _r, orig_size, file_hash_bin, nonce = struct.unpack(
            BXFP_HEADER, blob[: self.BXFP_HEADER_SIZE]
        )
        if magic != BXFP_MAGIC:
            return UnprotectResult(
                False, "", 0, "", RashomonVerdict.NO_GO.value, "bad magic",
            )
        if ver != BXFP_VERSION:
            return UnprotectResult(
                False, "", 0, "", RashomonVerdict.REVISE.value,
                f"unsupported version {ver}",
            )

        offset = self.BXFP_HEADER_SIZE
        if flags & FLAG_PASSWORD:
            salt = blob[offset : offset + self.SALT_SIZE]
            offset += self.SALT_SIZE
            if not password:
                return UnprotectResult(
                    False, "", 0, "", RashomonVerdict.NO_GO.value,
                    "password required",
                )
            key = derive_key_from_password(password, salt)
        else:
            key = self._master_key

        ciphertext = blob[offset:]
        file_hash = file_hash_bin.hex()
        base_name = sealed_file.name
        if base_name.endswith(".bxfp"):
            base_name = base_name[:-5]
        aad = self._aad(base_name, orig_size, file_hash)

        try:
            body = AESGCM(key).decrypt(nonce, ciphertext, aad)
        except Exception as e:
            return UnprotectResult(
                False, "", 0, file_hash, RashomonVerdict.NO_GO.value,
                f"AES-GCM decrypt failed: {e}",
            )

        if flags & FLAG_MOIRE:
            if self.moire is None:
                self.moire = CounterRotatingBiCore()
            body = self.moire.diffuse(body, encrypt=False)

        actual_hash = self._sha256_bytes(body)
        hash_ok = actual_hash == file_hash and len(body) == orig_size
        chain_ok, chain_msg = self.chain.verify()
        ent = self._entropy_norm(body)
        verdict = rashomon_gate(hash_ok, chain_ok, ent, force=force)

        if verdict == RashomonVerdict.NO_GO and not force:
            return UnprotectResult(
                False, "", orig_size, file_hash, verdict.value,
                f"Rashomon NO_GO (hash_ok={hash_ok}, chain={chain_msg})",
            )

        if dst_path is None:
            dst_path = str(Path(self.vault_dir) / (base_name + ".restored"))
        Path(dst_path).write_bytes(body)
        self.chain.append(actual_hash)

        return UnprotectResult(
            True, dst_path, orig_size, actual_hash, verdict.value,
            "unprotected OK" if verdict == RashomonVerdict.GO
            else f"unprotected with {verdict.value}",
        )

    def status(self) -> Dict[str, Any]:
        ok, msg = self.chain.verify()
        return {
            "version": "24.1.2-INTEGRATED",
            "dc_id": self.dc_id,
            "vault": self.vault_dir,
            "moire": self.use_moire,
            "chain_blocks": len(self.chain.blocks),
            "chain_ok": ok,
            "chain_msg": msg,
            "stored_records": len(self._storage.list_ids()),
            "crypto": HAS_CRYPTO,
            "numba": HAS_NUMBA,
        }


