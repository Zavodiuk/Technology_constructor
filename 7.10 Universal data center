def derive_key_from_password(
    password: str, salt: bytes, iterations: int = 200_000
) -> bytes:
    if not HAS_CRYPTO:
        raise RuntimeError("cryptography required")
    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(), length=32, salt=salt, iterations=iterations
    )
    return kdf.derive(password.encode("utf-8"))


def load_or_create_key(key_path: str) -> bytes:
    if not HAS_CRYPTO:
        raise RuntimeError("cryptography required: pip install cryptography")
    if os.path.exists(key_path):
        with open(key_path, "rb") as f:
            key = f.read()
        if len(key) != 32:
            raise ValueError(f"invalid key length: {key_path}")
        return key
    key = AESGCM.generate_key(bit_length=256)
    os.makedirs(os.path.dirname(key_path) or ".", exist_ok=True)
    with open(key_path, "wb") as f:
        f.write(key)
    try:
        os.chmod(key_path, 0o600)
    except OSError:
        pass
    return key


