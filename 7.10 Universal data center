class CounterRotatingBiCore:
    def __init__(self, seed_a: float = 0.78, seed_b: float = 2.35, size: int = 3):
        self.size = size
        self.angle_a = seed_a
        self.angle_b = seed_b
        self.base_velocity = math.pi / 6.0
        mid = size // 2
        self.matrix_a = np.zeros((size, size), dtype=np.int8)
        self.matrix_b = np.zeros((size, size), dtype=np.int8)
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid:
                    self.matrix_a[x, y] = 0
                    self.matrix_b[x, y] = 0
                elif (x + y) % 2 == 0:
                    self.matrix_a[x, y] = 1
                    self.matrix_b[x, y] = -1
                else:
                    self.matrix_a[x, y] = -1
                    self.matrix_b[x, y] = 1

    def _rot_sample(self, matrix: np.ndarray, angle: float, tx: int, ty: int) -> int:
        mid = self.size // 2
        ox, oy = tx - mid, ty - mid
        c, s = math.cos(angle), math.sin(angle)
        rx = int(round(ox * c - oy * s))
        ry = int(round(ox * s + oy * c))
        x = max(0, min(self.size - 1, rx + mid))
        y = max(0, min(self.size - 1, ry + mid))
        return int(matrix[x, y])

    def diffuse(self, data: bytes, encrypt: bool = True) -> bytes:
        if not data:
            return data
        out = bytearray(data)
        n = len(out)
        ent = min(1.0, n / 4096.0)
        vel = self.base_velocity / (1.0 + ent * 2.0)
        angle_a = self.angle_a + vel
        angle_b = self.angle_b - vel * 1.5

        for i in range(0, n - 8, 9):
            for k in range(9):
                tx, ty = k // 3, k % 3
                a = self._rot_sample(self.matrix_a, angle_a, tx, ty)
                b = self._rot_sample(self.matrix_b, angle_b, tx, ty)
                inter = a + b
                val = out[i + k]
                out[i + k] = (val + inter * 17 if encrypt else val - inter * 17) & 0xFF

        # хвост (remainder)
        remainder = n % 9
        if remainder > 0:
            for k in range(n - remainder, n):
                idx = k % 9
                tx, ty = idx // 3, idx % 3
                a = self._rot_sample(self.matrix_a, angle_a, tx, ty)
                b = self._rot_sample(self.matrix_b, angle_b, tx, ty)
                inter = a + b
                val = out[k]
                out[k] = (val + inter * 17 if encrypt else val - inter * 17) & 0xFF
        return bytes(out)


