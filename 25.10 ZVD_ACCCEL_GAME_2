                l5_state: list = field(default_factory=list)
                bxos_receipt: dict = field(default_factory=dict)
            return RejRes(bxos_receipt=receipt, l5_state=list(l5_inputs))

        l5_arr = self.ontology.update(l5_inputs)
        folded = self.logic_engine.fold(l5_arr)
