class GeometryMode(Enum):
    EUCLIDEAN = "евклидова"
    HYPERBOLIC = "гиперболическая (Лобачевский)"
    ELLIPTIC = "эллиптическая (Риман)"


class GeometryEngine:
    def __init__(self, mode: GeometryMode = GeometryMode.HYPERBOLIC):
        self.mode = mode
        self.curvature = -1.0

    def set_mode(self, mode: GeometryMode):
        self.mode = mode
        if mode == GeometryMode.EUCLIDEAN: self.curvature = 0.0
        elif mode == GeometryMode.HYPERBOLIC: self.curvature = -1.0
        else: self.curvature = 1.0

    def distance(self, p1: Tuple[float, float], p2: Tuple[float, float]) -> float:
        dx, dy = p1[0] - p2[0], p1[1] - p2[1]
        euclidean_dist = math.sqrt(dx*dx + dy*dy)
        if self.curvature == 0: return float(euclidean_dist)
        elif self.curvature < 0: return float(math.sinh(euclidean_dist))
        else: return float(math.sin(euclidean_dist))

    def select_mode_by_task(self, query: str, interpretations: Dict[str, float]) -> GeometryMode:
        if len(interpretations) > 5: return GeometryMode.HYPERBOLIC
        if any(w in query.lower() for w in ['цикл', 'обучение', 'возврат']): return GeometryMode.ELLIPTIC
        return GeometryMode.EUCLIDEAN


class InterferenceMatrix:
    """Zero-Allocation Interference Matrix using pre-allocated NumPy buffers."""
    def __init__(self, max_nodes: int = 32):
        self.max_nodes = max_nodes
        self.amplitudes = np.zeros(max_nodes, dtype=np.float64)
        self.phases = np.zeros(max_nodes, dtype=np.float64)
        self.positions = np.zeros((max_nodes, 2), dtype=np.float64)
        self.active_count = 0
        self.waves_buf = np.zeros(max_nodes, dtype=np.float64)
        self.pattern_buf = np.zeros(max_nodes, dtype=np.float64)
        self.conflicts_buf = np.zeros(max_nodes, dtype=np.int32)

    def reset(self):
        self.active_count = 0
        self.waves_buf.fill(0.0)
        self.pattern_buf.fill(0.0)
        self.conflicts_buf.fill(0)

    def add_node(self, amplitude: float, phase: float, position: Tuple[float, float]) -> int:
        if self.active_count >= self.max_nodes:
            return -1
        idx = self.active_count
        self.amplitudes[idx] = amplitude
        self.phases[idx] = phase
        self.positions[idx, 0] = position[0]
        self.positions[idx, 1] = position[1]
        self.active_count += 1
        return idx

    def propagate_waves(self, time_val: float, geometry: GeometryEngine):
        self.waves_buf.fill(0.0)
        omega = 2.0
        n = self.active_count
        for i in range(n):
            amp_i = self.amplitudes[i]
            phase_i = self.phases[i]
            wave_i = amp_i * math.sin(omega * time_val + phase_i)
            pos_i = self.positions[i]
            for j in range(n):
                if i == j:
                    continue
                pos_j = self.positions[j]
                dist = geometry.distance((pos_i[0], pos_i[1]), (pos_j[0], pos_j[1]))
                attenuation = 1.0 / (1.0 + dist)
                self.waves_buf[j] += wave_i * attenuation

    def interference_pattern(self, time_val: float):
        omega = 2.0
        n = self.active_count
        for i in range(n):
            amp_i = self.amplitudes[i]
            phase_i = self.phases[i]
            own = amp_i * math.sin(omega * time_val + phase_i)
            self.pattern_buf[i] = self.waves_buf[i] + own

    def find_conflicts(self, threshold: float = 0.3) -> int:
        count = 0
        n = self.active_count
        for i in range(n):
            if abs(self.pattern_buf[i]) > threshold:
                self.conflicts_buf[count] = i
                count += 1
        return count

    def stability_index(self, conflict_count: int) -> float:
        total = self.active_count if self.active_count > 0 else 1
        return 1.0 - (float(conflict_count) / float(total))


class KirchhoffBalance:
    def __init__(self):
        self.cycles: List[List[int]] = []

    def system_balance(self, matrix: InterferenceMatrix) -> float:
        return float(np.sum(matrix.pattern_buf[:matrix.active_count]))

    def is_balanced(self, matrix: InterferenceMatrix, tolerance: float = 0.01) -> bool:
        return abs(self.system_balance(matrix)) < tolerance


class LomonosovSpiral:
    def __init__(self):
        self.history: List[Dict] = []
        self.spiral_level = 0
        self.direction = 0

    def analyze_event(self, event: Dict) -> Dict:
        loss_val = float(event.get("loss", 0.0))
        gain_val = float(event.get("gain", 0.0))
        if gain_val > loss_val: self.direction = 1
        elif loss_val > gain_val: self.direction = -1
        else: self.direction = 0
        self.spiral_level += self.direction
        res = {
            "why": event.get("reason", "неизвестно"),
            "location": event.get("location", "GameEngine V9.6"),
            "timestamp": event.get("timestamp", time.time()),
            "loss": loss_val,
            "gain": gain_val,
            "spiral_level": self.spiral_level,
            "direction": self.direction,
            "status": "complete"
        }
        self.history.append(res)
        return res

    def get_trend(self) -> str:
        if not self.history: return "неизвестно"
        d = self.history[-1]["direction"]
        return "восходящая" if d == 1 else ("нисходящая" if d == -1 else "горизонтальная")

    def get_level(self) -> int: return self.spiral_level


