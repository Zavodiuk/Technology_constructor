class L3Triage:
    @staticmethod
    def process(value: float, low: float = 0.3, high: float = 0.7) -> int:
        if value >= high: return 1
        if value <= low: return -1
        return 0

    @staticmethod
    def process_vector(arr: np.ndarray, low: float = 0.3, high: float = 0.7) -> np.ndarray:
        return _njit_l3_triage_vector(arr, low, high)

    @staticmethod
    def analyze_interpretations(scores: np.ndarray, margin_threshold: float = 0.15, min_score: float = 0.3) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
        if scores.size == 0:
            return np.array([-1]), np.array([-1]), np.array([0.0])
        best_idx = np.argmax(scores, axis=1)
        best_scores = scores[np.arange(scores.shape[0]), best_idx]
        sorted_scores = np.sort(scores, axis=1)[:, ::-1]
        margins = sorted_scores[:, 0] - (sorted_scores[:, 1] if scores.shape[1] > 1 else 0.0)
        states = np.zeros(scores.shape[0], dtype=np.int8)
        states[best_scores < min_score] = -1
        states[(best_scores >= min_score) & (margins >= margin_threshold)] = 1
        return states, best_idx, best_scores


class MultivaluedLogicEngine:
    def __init__(self, strategy: Literal["godel", "luka"] = "godel"):
        if strategy not in ("godel", "luka"):
            raise ValueError("Strategy must be 'godel' or 'luka'")
        self.strategy = strategy

    def fold(self, data: Union[Sequence[int], np.ndarray]) -> Union[int, np.ndarray]:
        arr = np.asarray(data, dtype=np.int8)
        clean_data = BXOSGate.guard(arr)
        if clean_data.ndim == 1:
            return int(self._reduce_1d(clean_data))
        return self._reduce_batch(clean_data)

    def _reduce_1d(self, arr: np.ndarray) -> int:
        return _njit_reduce_1d(arr, self.strategy == "godel")

    def _reduce_batch(self, batch: np.ndarray) -> np.ndarray:
        return _njit_reduce_batch(batch, self.strategy == "godel")


class PentarnyRashomon:
    PERSPECTIVES = ("technical", "operational", "structural", "boundary", "risk")

    def __init__(self):
        self._audit_buffer = np.empty((1, 5), dtype=np.float64)

    def evaluate(self, matrix: np.ndarray) -> Dict[str, Union[float, np.ndarray]]:
        if matrix.size == 0:
            return {p: 0.0 for p in PentarnyRashomon.PERSPECTIVES}
        mat = np.asarray(matrix, dtype=np.float64)
        if mat.ndim == 1:
            mat = mat.reshape(1, -1)
        rows, cols = mat.shape
        if cols < 5:
            padded = np.zeros((rows, 5), dtype=np.float64)
            padded[:, :cols] = mat
            for c in range(cols, 5):
                padded[:, c] = mat[:, -1]
            mat = padded
        elif cols > 5:
            mat = mat[:, :5]
        if self._audit_buffer.shape[0] != rows:
            self._audit_buffer = np.empty((rows, 5), dtype=np.float64)
        _njit_rashomon_evaluate_zero_alloc(mat, self._audit_buffer)
        if matrix.ndim == 1:
            return {
                "technical": float(self._audit_buffer[0, 0]),
                "operational": float(self._audit_buffer[0, 1]),
                "structural": float(self._audit_buffer[0, 2]),
                "boundary": float(self._audit_buffer[0, 3]),
                "risk": float(self._audit_buffer[0, 4])
            }
        return {
            "technical": self._audit_buffer[:, 0].copy(),
            "operational": self._audit_buffer[:, 1].copy(),
            "structural": self._audit_buffer[:, 2].copy(),
            "boundary": self._audit_buffer[:, 3].copy(),
            "risk": self._audit_buffer[:, 4].copy()
        }


class L5OntologyLayer:
    LAYERS = ["L1_Intent", "L2_Goal", "L3_Ontology", "L4_Context", "L5_Action"]

    def __init__(self):
        self.state = np.zeros(5, dtype=np.int8)

    def update(self, values: Sequence[int]) -> np.ndarray:
        arr = np.asarray(values)
        if arr.size != 5:
            if arr.size < 5:
                padded = np.zeros(5, dtype=np.int8)
                padded[:arr.size] = arr
                arr = padded
            else:
                arr = arr[:5]
        self.state = BXOSGate.guard(arr.astype(np.int8))
        return self.state

    @property
    def system_energy(self) -> float:
        return float(np.sum(np.abs(self.state)) / 10.0)


class BXOSReceiptGenerator:
    MASTER_SIGNATURE = "KEY-VZ-2026-MASTER-SIGNATURE"

    @staticmethod
    def _stable_json_bytes(obj: Any) -> bytes:
        def _default(o: Any):
            if isinstance(o, (np.integer,)): return int(o)
            if isinstance(o, (np.floating,)): return float(o)
            if isinstance(o, np.ndarray): return o.tolist()
            if isinstance(o, (set, tuple)): return list(o)
            return str(o)
        return json.dumps(obj, sort_keys=True, ensure_ascii=False, default=_default).encode("utf-8")

    @classmethod
    def generate(cls, request_id: str, status: str, strategy: str, payload_summary: Dict[str, Any]) -> Dict[str, Any]:
        digest_bytes = cls._stable_json_bytes(payload_summary)
        body = {
            "request_id": request_id,
            "status": status,
            "active_strategy": strategy,
            "timestamp_ns": time.time_ns(),
            "payload_digest": hashlib.sha256(digest_bytes).hexdigest(),
            "authority_signature": cls.MASTER_SIGNATURE
        }
        serialized = cls._stable_json_bytes(body)
        body["bxos_digest"] = hashlib.sha256(serialized).hexdigest()
        body["simulated"] = True
        return body


