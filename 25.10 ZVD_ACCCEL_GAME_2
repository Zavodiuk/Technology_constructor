        payload_meta = {"folded_result": int(folded), "system_energy": self.ontology.system_energy, "stress_level": current_stress}
        receipt = BXOSReceiptGenerator.generate(request_id, "AUTHORIZED_PASS", strategy, payload_meta)

        @dataclass
        class OkRes:
