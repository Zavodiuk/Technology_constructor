_JIT_PACK_LUT = np.array([
    [-2, -2, -1, -1],  # trit -1
    [-1,  0,  0,  1],  # trit 0
    [ 0,  1,  2,  2]   # trit +1
], dtype=np.int8)

_JIT_UNPACK_LUT = np.array([
    [-1, 0],  # penta -2
    [-1, 2],  # penta -1
    [ 0, 1],  # penta  0
    [ 0, 3],  # penta  1
