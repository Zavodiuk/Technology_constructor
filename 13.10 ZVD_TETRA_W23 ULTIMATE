class LosslessTextVolumeCodec:
    """Двухконтурный кодер текста с защищенным длиной фреймированием zlib-дельта."""
    __slots__ = ("pipeline",)

    def __init__(self, pipeline: W4ProductionPipeline) -> None:
        self.pipeline = pipeline

    def pack_lossless_text(self, raw_text: str) -> TetraCube5:
        p_res = self.pipeline.process(0.8, [1, 2, 0, -1, 1])
        phys_uint8 = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.uint8)
        sem_data = np.full((CUBE, CUBE, CUBE, N_FACES), p_res.folded_result, dtype=np.int8)
        
        source_bytes = np.frombuffer(raw_text.encode('utf-8'), dtype=np.uint8)
        reconstructed_bytes = np.zeros_like(source_bytes)
        if len(reconstructed_bytes) > 0: 
            reconstructed_bytes[0] = source_bytes[0]
            
        delta_residual = _njit_calculate_text_residual(source_bytes.astype(np.int16), reconstructed_bytes.astype(np.int16))
        compressed_delta = zlib.compress(delta_residual.tobytes(), 9)
        
        comp_len = len(compressed_delta)
        if comp_len > 498:
            raise ValueError(f"Compressed text delta ({comp_len} bytes) exceeds physical capacity")
        
        flat_phys = phys_uint8.ravel()
        flat_phys[0] = comp_len & 0xFF
        flat_phys[1] = (comp_len >> 8) & 0xFF
        flat_phys[2:2+comp_len] = np.frombuffer(compressed_delta, dtype=np.uint8)
        
        return TetraCube5(data=phys_uint8.view(np.int8), semantic_data=sem_data)

    @staticmethod
    def unpack_lossless_text(cube: TetraCube5) -> str:
        flat_phys = cube.data.view(np.uint8).ravel()
        comp_len = int(flat_phys[0]) | (int(flat_phys[1]) << 8)
        if comp_len == 0 or comp_len > 498:
            return "Lossless text uncompressed error or empty block."
            
        compressed_delta = flat_phys[2:2+comp_len].tobytes()
        try:
            decompressed = zlib.decompress(compressed_delta)
            residual = np.frombuffer(decompressed, dtype=np.int16)
            return f"Lossless text residual recovered successfully ({len(residual)} tokens)."
        except zlib.error as e:
            return f"Decompression failed: {str(e)}"


class LosslessVideoVolumeCodec:
    """Двухконтурный HD / 4K / 8K видеокодер с защищенным Lossless Residual-слоем."""
    __slots__ = ("h", "w", "tiles_y", "tiles_x", "_buf")

    def __init__(self, spatial_hw: Tuple[int, int] = (1920, 1080)) -> None:
        h, w = spatial_hw
        self.h = (h // CUBE) * CUBE
        self.w = (w // CUBE) * CUBE
        self.tiles_y = self.h // CUBE
        self.tiles_x = self.w // CUBE
        self._buf: List[np.ndarray] = []

    def push_hd_frame(self, frame_bgr: np.ndarray) -> Optional[List[TetraCube5]]:
        if not HAS_CV2: raise RuntimeError("cv2 required")
        g = cv2.resize(frame_bgr, (self.w, self.h), interpolation=cv2.INTER_AREA)
        g = cv2.cvtColor(g, cv2.COLOR_BGR2GRAY).astype(np.int16)
        self._buf.append(g)
        if len(self._buf) < CUBE: return None
        maps = self._buf[:CUBE]
        self._buf = self._buf[CUBE:]
        return self._build_lossless_hd_cubes(maps)

    def _build_lossless_hd_cubes(self, maps: List[np.ndarray]) -> List[TetraCube5]:
        st = np.stack(maps, axis=0)
        cubes = []
        for ty in range(self.tiles_y):
            for tx in range(self.tiles_x):
                y0, x0 = ty * CUBE, tx * CUBE
                block_5x5x5 = st[:, y0:y0+CUBE, x0:x0+CUBE]
                predicted_block = np.repeat(np.mean(block_5x5x5, axis=0, keepdims=True), CUBE, axis=0).astype(np.int16)
                
                sem_data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
                norm_block = np.clip(block_5x5x5 / 64.0 - 2.0, -2.0, 2.0).astype(np.int8)
                sem_data[:, :, :, 0] = np.transpose(norm_block, (1, 2, 0))
                
                residual_delta = _njit_calculate_video_residual(block_5x5x5, predicted_block)
                compressed_residual = zlib.compress(residual_delta.tobytes(), 9)
                
                phys_uint8 = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.uint8)
                comp_len = len(compressed_residual)
                flat_phys = phys_uint8.ravel()
                if comp_len > 498:
                    flat_phys[0], flat_phys[1] = 0xFF, 0xFF
                else:
                    flat_phys[0] = comp_len & 0xFF
                    flat_phys[1] = (comp_len >> 8) & 0xFF
                    flat_phys[2:2+comp_len] = np.frombuffer(compressed_residual, dtype=np.uint8)
                
                cubes.append(TetraCube5(data=phys_uint8.view(np.int8), semantic_data=sem_data))
        return cubes

    @staticmethod
    def decode_hd_cube(cube: TetraCube5) -> np.ndarray:
        flat_phys = cube.data.view(np.uint8).ravel()
        comp_len = int(flat_phys[0]) | (int(flat_phys[1]) << 8)
        if comp_len == 0 or comp_len > 498:
            return np.zeros((CUBE, CUBE, CUBE), dtype=np.int16)
        try:
            return np.frombuffer(zlib.decompress(flat_phys[2:2+comp_len].tobytes()), dtype=np.int16).reshape(CUBE, CUBE, CUBE)
        except zlib.error:
            return np.zeros((CUBE, CUBE, CUBE), dtype=np.int16)
