def ternary_clip(val: int) -> int:
    if val > 0:
        return 1
    elif val < 0:
        return -1
    return 0


@njit(fastmath=True, cache=True)
def _njit_guard(arr: np.ndarray) -> np.ndarray:
    flat_arr = arr.ravel()  # Безопасный и быстрый проход по памяти
    for i in range(flat_arr.size):
        v = flat_arr[i]
        if v > 2:
            flat_arr[i] = 2
        elif v < -2:
            flat_arr[i] = -2
    return arr


class BXOSGate:
    @staticmethod
    def guard(arr: np.ndarray) -> np.ndarray:
        return _njit_guard(arr)


class MacroFieldW23:
    def __init__(self, shape: Tuple[int, int] = (7, 7)) -> None:
        # Инициализируем истинным ПЕНТАРНЫМ базисом, чтобы рекуперация имела физический смысл
        self.field = np.random.choice([-2, -1, 0, 1, 2], size=shape).astype(np.int8)

    def calculate_entropy(self) -> float:
        unique, counts = np.unique(self.field, return_counts=True)
        total = self.field.size
        entropy = 0.0
        for count in counts:
            p = count / total
            if p > 0:
                entropy -= p * math.log(p, 3)
        return float(min(1.0, max(0.0, entropy)))

    def recover_extremes(self) -> int:
        mask_ext = (self.field == 2) | (self.field == -2)
        count = int(np.sum(mask_ext))
        self.field[mask_ext] = 0
        return count


class PhaseHysteresisMemory:
    def __init__(self, window_size: int = 4) -> None:
        self.window_size = window_size
        self.history: List[int] = []

    def register_state(self, state: int) -> int:
        self.history.append(state)
        if len(self.history) > self.window_size:
            self.history.pop(0)
        if not self.history:
            return 0
        return int(round(sum(self.history) / len(self.history)))


@njit(fastmath=True, cache=True)
def _njit_triage_vector_mean(arr: np.ndarray) -> float:
    s = 0.0
    flat_arr = arr.ravel()
    for i in range(flat_arr.size):
        s += float(flat_arr[i])
    return s / float(flat_arr.size)


class L3Triage:
    @staticmethod
    def process_vector(arr: np.ndarray) -> float:
