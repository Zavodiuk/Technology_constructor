@njit(fastmath=True, cache=True)
def _njit_calculate_text_residual(source: np.ndarray, recon: np.ndarray) -> np.ndarray:
    n = source.shape[0]
    residual = np.zeros(n, dtype=np.int16)
    for i in range(n):
        residual[i] = np.int16(int(source[i]) - int(recon[i]))
    return residual


@njit(fastmath=True, cache=True)
def _njit_calculate_video_residual(block: np.ndarray, pred: np.ndarray) -> np.ndarray:
    res = np.zeros_like(block, dtype=np.int16)
    for t in range(block.shape[0]):
        for y in range(block.shape[1]):
            for x in range(block.shape[2]):
                res[t, y, x] = np.int16(int(block[t, y, x]) - int(pred[t, y, x]))
    return res


class TetraCube5:
    """
    Двухслойный куб 5×5×5 (1000 байт монолит):
    Layer 1 (data): Физика / Lossless-остаток (500 байт)
    Layer 2 (semantic): Смыслы и суждения ИИ (500 байт)
    """
    __slots__ = ("data", "semantic_data")

    def __init__(self, data: Optional[np.ndarray] = None, semantic_data: Optional[np.ndarray] = None) -> None:
        if data is None:
            self.data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
        else:
            self.data = data if data.dtype == np.int8 else np.clip(data, -2, 2).astype(np.int8)
            
        if semantic_data is None:
            self.semantic_data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
        else:
            self.semantic_data = semantic_data if semantic_data.dtype == np.int8 else np.clip(semantic_data, -2, 2).astype(np.int8)

    def pack_monolith(self, lossless: bool = False) -> bytes:
        if lossless:
            flat_phys = self.data.tobytes()
        else:
            flat_phys = (self.data.reshape(-1) + 2).astype(np.uint8).tobytes()
            
        flat_sem = (self.semantic_data.reshape(-1) + 2).astype(np.uint8).tobytes()
        return flat_phys + flat_sem

    @classmethod
    def unpack_monolith(cls, raw: bytes, lossless: bool = False) -> "TetraCube5":
        if len(raw) < 1000:
            raise ValueError("Monolithic dual-layer payload too short (need 1000 bytes)")
            
        if lossless:
            arr_phys = np.frombuffer(raw[:500], dtype=np.int8).copy().reshape(CUBE, CUBE, CUBE, N_FACES)
        else:
            arr_phys = (np.frombuffer(raw[:500], dtype=np.uint8).astype(np.int8) - 2).reshape(CUBE, CUBE, CUBE, N_FACES)
            
        arr_sem = (np.frombuffer(raw[500:1000], dtype=np.uint8).astype(np.int8) - 2).reshape(CUBE, CUBE, CUBE, N_FACES)
        return cls(data=arr_phys, semantic_data=arr_sem)

    def mean_energy(self) -> float:
        return float((np.mean(np.abs(self.data)) + np.mean(np.abs(self.semantic_data))) / 2.0)
