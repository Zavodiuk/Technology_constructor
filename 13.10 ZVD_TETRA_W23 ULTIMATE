class MultivaluedLogicEngine:
    __slots__ = ("strategy",)
    def __init__(self, strategy: Literal["godel", "luka"] = "godel") -> None:
        if strategy not in ("godel", "luka"):
            raise ValueError("Стратегия должна быть 'godel' или 'luka'")
        self.strategy = strategy

    def fold(self, data: Union[Sequence[int], np.ndarray]) -> Union[int, np.ndarray]:
        arr = np.array(data, dtype=np.int8)
        clean = BXOSGate.guard(arr)
        if clean.ndim == 1:
            return int(_njit_reduce_1d(clean, self.strategy == "godel"))
        return _njit_reduce_batch(clean, self.strategy == "godel")


class PentarnyRashomon:
    PERSPECTIVES = ("technical", "operational", "structural", "boundary", "risk")

    @staticmethod
    def evaluate(matrix: np.ndarray) -> Dict[str, Union[float, np.ndarray]]:
        if matrix.size == 0:
            return {p: 0.0 for p in PentarnyRashomon.PERSPECTIVES}
        is_1d = (matrix.ndim == 1)
        mat = matrix.reshape(1, -1) if is_1d else matrix
        tech, op, struct, bound, rsk = _njit_rashomon_evaluate(mat)
        if is_1d:
            return {"technical": float(tech[0]), "operational": float(op[0]), 
                    "structural": float(struct[0]), "boundary": float(bound[0]), "risk": float(rsk[0])}
        return {"technical": tech, "operational": op, "structural": struct, "boundary": bound, "risk": rsk}


class CounterRotatingTernaryBiCore:
    __slots__ = ("size", "matrix_a", "matrix_b", "step_index_a", "step_index_b")

    def __init__(self, size: int = 3) -> None:
        self.size = size
        self.matrix_a = self._gen(size)
        self.matrix_b = self._gen(size)
        self.step_index_a, self.step_index_b = 0, 0

    def _gen(self, size: int) -> np.ndarray:
        mat = np.zeros((size, size), dtype=np.int8)
        mid = size // 2
        for x in range(size):
            for y in range(size):
                if x == mid and y == mid: mat[x, y] = 0
                elif (x + y) % 2 == 0: mat[x, y] = 1
                else: mat[x, y] = -1
        return mat

    def update_rotation(self, entropy: float) -> None:
        self.step_index_a = (self.step_index_a + 1) % 12
        delta = 1.0 if entropy < 0.5 else 2.0
        step_shift = int(round(delta * 1.5))
        self.step_index_b = (self.step_index_b - step_shift) % 12

    @property
    def angle_a(self) -> float: return self.step_index_a * (math.pi / 6.0)
    @property
    def angle_b(self) -> float: return self.step_index_b * (math.pi / 6.0)

    def get_combined_state(self, coord: Tuple[int, int], angle: float, mat: np.ndarray) -> np.int8:
        x, y = coord
        mid = self.size // 2
        ox, oy = x - mid, y - mid
        ca, sa = math.cos(angle), math.sin(angle)
        rx, ry = int(round(ox * ca - oy * sa)), int(round(ox * sa + oy * ca))
        return np.int8(mat[max(0, min(self.size - 1, rx + mid)), max(0, min(self.size - 1, ry + mid))])


class MoiréUnifiedOrchestratorW23:
    __slots__ = ("macro_field", "bi_core", "hysteresis", "time_step")

    def __init__(self) -> None:
        self.macro_field = MacroFieldW23((7, 7))
        self.bi_core = CounterRotatingTernaryBiCore(3)
        self.hysteresis = PhaseHysteresisMemory(4)
        self.time_step: int = 0

    def execute_sync_cycle(self) -> Tuple[int, int, float, float, int]:
        self.time_step += 1
        entropy = self.macro_field.calculate_entropy()
        recovered = self.macro_field.recover_extremes() if entropy > 0.55 else 0
        self.bi_core.update_rotation(entropy)
        
        slice_field = self.macro_field.field[2:5, 2:5]
        interaction_sum, matches = 0, 0
        
        for tx in range(3):
            for ty in range(3):
                va = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_a, self.bi_core.matrix_a)
                vb = self.bi_core.get_combined_state((tx, ty), self.bi_core.angle_b, self.bi_core.matrix_b)
                inter = ternary_clip(int(va) + int(vb))
                p_val = int(slice_field[tx, ty])
                interaction_sum += inter * p_val
                if inter == p_val: matches += 1

        raw_gate = 1 if interaction_sum > 2 else (-1 if interaction_sum < -2 else 0)
        stabilized_gate = self.hysteresis.register_state(raw_gate)
        coherence = float(matches / 9.0)
        return stabilized_gate, interaction_sum, entropy, coherence, recovered
