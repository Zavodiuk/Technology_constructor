@njit(fastmath=True, cache=True)
def _njit_reduce_1d(arr: np.ndarray, strategy_is_godel: bool) -> int:
    n = arr.shape[0]
    if strategy_is_godel:
        min_val = 99
        for j in range(n):
            if arr[j] < min_val:
                min_val = arr[j]
        return int(min_val)
    else:
        if n == 0:
            return -2
        total_sum = np.int64(0)
        for j in range(n):
            total_sum += arr[j]
        luka_val = total_sum - 2 * (n - 1)
        if luka_val < -2:
            return -2
        elif luka_val > 2:
            return 2
        return int(luka_val)


@njit(fastmath=True, cache=True)
def _njit_reduce_batch(batch: np.ndarray, strategy_is_godel: bool) -> np.ndarray:
    rows = batch.shape[0]
    cols = batch.shape[1]
    res = np.empty(rows, dtype=np.int8)
    for i in range(rows):
        if strategy_is_godel:
            min_val = np.int8(127)
            for j in range(cols):
                val = batch[i, j]
                if val < min_val:
                    min_val = val
            res[i] = min_val
        else:
            total_sum = np.int64(0)
            for j in range(cols):
                total_sum += batch[i, j]
            luka_val = total_sum - 2 * (cols - 1)
            if luka_val < -2:
                luka_val = -2
            elif luka_val > 2:
                luka_val = 2
            res[i] = np.int8(luka_val)
    return res


@njit(parallel=True, fastmath=True, cache=True)
def _njit_rashomon_evaluate(matrix: np.ndarray):
    if matrix.ndim == 1:
        mat = matrix.reshape(1, -1)
    else:
        mat = matrix
    rows = mat.shape[0]
    cols = mat.shape[1]
    
    technical = np.zeros(rows, dtype=np.float64)
    operational = np.zeros(rows, dtype=np.float64)
    structural = np.zeros(rows, dtype=np.float64)
    boundary = np.zeros(rows, dtype=np.float64)
    risk = np.zeros(rows, dtype=np.float64)
    
    if cols == 0:
        return technical, operational, structural, boundary, risk
        
    for i in prange(rows):
        sum_val = 0.0
        abs_sum_val = 0.0
        min_val = 1e9
        max_val = -1e9
        
        for j in range(cols):
            val = float(mat[i, j])
            sum_val += val
            abs_sum_val += abs(val)
            if val < min_val:
                min_val = val
            if val > max_val:
                max_val = val
        
        mean_val = sum_val / cols
        var_sum = 0.0
        for j in range(cols):
            val = float(mat[i, j])
            diff = val - mean_val
            var_sum += diff * diff
        std_val = np.sqrt(var_sum / cols)
        
        technical[i] = mean_val
        operational[i] = min_val
        structural[i] = max_val
        boundary[i] = std_val
        risk[i] = -(abs_sum_val / cols)
        
    return technical, operational, structural, boundary, risk
