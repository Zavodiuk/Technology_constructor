class Maschera(Enum):
    PANTALONE = "панталоне"
    DOTTOR = "доктор"
    CAPITANO = "капитан"
    BRIGHELLA = "бригелла"
    ARLECCHINO = "арлекино"
    TARTAGLIA = "тарталья"
    INNAMORATI = "влюблённые"
    COLOMBINA = "коломбина"
    PULCINELLA = "пульчинелла"
    SCAPINO = "скапино"
    GIANDUJA = "джандуя"
    BALANZONE = "баланцоне"


@dataclass
class MascheraProfile:
    name: Maschera
    group: str
    question: str
    weight: float = 1.0
    active: bool = True

    def evaluate(self, facts: Dict[str, Any]) -> float:
        if self.name == Maschera.PANTALONE:
            return 0.6 * facts.get("profit", 0.5) + 0.4 * (1 - facts.get("cost", 0.5))
        elif self.name == Maschera.DOTTOR:
            return 0.5 * facts.get("logic", 0.5) + 0.5 * facts.get("rules", 0.5)
        elif self.name == Maschera.CAPITANO:
            return 0.5 * facts.get("strength", 0.5) + 0.5 * (1 - facts.get("risk", 0.5))
        elif self.name == Maschera.BRIGHELLA:
            return 0.5 * facts.get("plan", 0.5) + 0.5 * facts.get("execution", 0.5)
        elif self.name == Maschera.ARLECCHINO:
            return 0.5 * facts.get("simplicity", 0.5) + 0.5 * (1 - facts.get("trick", 0.5))
        elif self.name == Maschera.TARTAGLIA:
            return 0.5 * (1 - facts.get("logic_error", 0.5)) + 0.5 * (1 - facts.get("weakness", 0.5))
        elif self.name == Maschera.INNAMORATI:
            return 0.5 * facts.get("beauty", 0.5) + 0.5 * facts.get("rightness", 0.5)
        elif self.name == Maschera.COLOMBINA:
            return 0.5 * facts.get("hidden", 0.5) + 0.5 * facts.get("truth", 0.5)
        elif self.name == Maschera.PULCINELLA:
            return 0.5 * facts.get("honesty", 0.5) + 0.5 * (1 - facts.get("deception", 0.5))
        elif self.name == Maschera.SCAPINO:
            return 0.5 * facts.get("maneuver", 0.5) + 0.5 * facts.get("flexibility", 0.5)
        elif self.name == Maschera.GIANDUJA:
            return 0.5 * facts.get("sincerity", 0.5) + 0.5 * facts.get("simplicity2", 0.5)
        elif self.name == Maschera.BALANZONE:
            return 0.5 * facts.get("precision", 0.5) + 0.5 * facts.get("correctness", 0.5)
        return 0.5


class TeatroDelleMaschere:
    def __init__(self):
        self.maschere: List[MascheraProfile] = []
        self._init_default()

    def _init_default(self):
        self.maschere.append(MascheraProfile(Maschera.PANTALONE, "власть", "Сколько это стоит?"))
        self.maschere.append(MascheraProfile(Maschera.DOTTOR, "власть", "Соответствует ли формальной логике?"))
        self.maschere.append(MascheraProfile(Maschera.CAPITANO, "власть", "Покажем ли мы силу?"))
        self.maschere.append(MascheraProfile(Maschera.BRIGHELLA, "действие", "Какой практический план?"))
        self.maschere.append(MascheraProfile(Maschera.ARLECCHINO, "действие", "А что, если всё проще?"))
        self.maschere.append(MascheraProfile(Maschera.TARTAGLIA, "действие", "Где логическая ошибка?"))
        self.maschere.append(MascheraProfile(Maschera.INNAMORATI, "человек", "Нравится ли нам это?"))
        self.maschere.append(MascheraProfile(Maschera.COLOMBINA, "человек", "Что на самом деле?"))
        self.maschere.append(MascheraProfile(Maschera.PULCINELLA, "человек", "А что думает народ?"))
        self.maschere.append(MascheraProfile(Maschera.SCAPINO, "человек", "Как обойти препятствие?"))
        self.maschere.append(MascheraProfile(Maschera.GIANDUJA, "человек", "Насколько это искренне?"))
        self.maschere.append(MascheraProfile(Maschera.BALANZONE, "власть", "Насколько это точно?"))

    def evaluate(self, facts: Dict[str, Any]) -> Dict[str, Any]:
        results = {}
        weighted_sum = 0.0
        total_weight = 0.0

        for m in self.maschere:
            if not m.active:
                continue
            score = m.evaluate(facts)
            weighted = score * m.weight
            results[m.name.value] = {"score": score, "weight": m.weight, "weighted": weighted, "group": m.group, "question": m.question}
            weighted_sum += weighted
            total_weight += m.weight

        if total_weight == 0:
            return {"error": "Нет активных масок"}

        scores = [r["score"] for r in results.values()]
        std_dev = math.sqrt(sum((s - sum(scores)/len(scores))**2 for s in scores) / len(scores))
        is_coherent = std_dev < 0.15

        return {
            "results": results,
            "weighted_sum": weighted_sum / total_weight,
            "coherence": is_coherent,
            "std_dev": std_dev
        }


