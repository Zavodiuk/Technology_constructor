1295	            return requested
1296	        aliases = {'L3': LogicType.TERNARY,
1297	                  'L3_MATRIX': LogicType.TERNARY_MATRIX,
1298	                  'L5': LogicType.PENTARY,
1299	                  'L5_MATRIX': LogicType.PENTARY_MATRIX}
