 467	class DynamicRiskEngine:
 468	    """Conservative risk model kept separate from module scoring."""
 469	
 470	    def assess(self, result: ModuleResult, *, projection_loss: float = 0.0,
 471	               conflict_density: float = 0.0,
 472	               execution_cost: float = 0.0) -> RiskAssessment:
 473	        factors = {
 474	            'uncertainty': max(0.0, min(1.0, result.uncertainty)),
 475	            'low_confidence': max(0.0, min(1.0, 1.0 - result.confidence)),
 476	            'projection_loss': max(0.0, min(1.0, projection_loss)),
 477	            'conflict_density': max(0.0, min(1.0, conflict_density)),
 478	            'execution_cost': max(0.0, min(1.0, execution_cost))
 479	        }
 480	        score = min(1.0, 0.3 * factors['uncertainty'] +
 481	                    0.25 * factors['low_confidence'] +
 482	                    0.2 * factors['projection_loss'] +
 483	                    0.2 * factors['conflict_density'] +
 484	                    0.05 * factors['execution_cost'])
 485	        if score >= 0.8:
 486	            level, veto = (RiskLevel.CRITICAL, True)
 487	        elif score >= 0.55:
 488	            level, veto = (RiskLevel.HIGH, False)
 489	        elif score >= 0.3:
 490	            level, veto = (RiskLevel.MEDIUM, False)
 491	        else:
 492	            level, veto = (RiskLevel.LOW, False)
 493	        explanation = ('risk is driven by ' + ', '.join(
 494	            name for name, value in factors.items() if value >= 0.3)
 495            or 'all monitored factors are low')
 496	        return RiskAssessment(score, level, factors, explanation, veto)
