 801	class ConflictRiskEngine:
 802	
 803	    def assess(self, aggregate: EvidenceAggregate, *,
 804	               projection_loss: float = 0.0, execution_cost: float = 0.0,
 805	               allow_action: bool = False) -> ConflictRisk:
 806	        fallback_rate = sum((e.status.value != 'OK'
 807	                            for e in aggregate.evidences)) / len(aggregate.evidences)
 808	        factors = {
 809	            'conflict_density': max(0.0, min(1.0, aggregate.conflict_density)),
 810	            'aggregate_uncertainty': max(0.0, min(1.0, aggregate.uncertainty)),
 811	            'fallback_rate': max(0.0, min(1.0, fallback_rate)),
 812	            'projection_loss': max(0.0, min(1.0, projection_loss)),
 813	            'execution_cost': max(0.0, min(1.0, execution_cost))
 814	        }
 815	        score = min(1.0, 0.45 * factors['conflict_density'] +
 816	                    0.25 * factors['aggregate_uncertainty'] +
 817	                    0.1 * factors['fallback_rate'] +
 818	                    0.1 * factors['projection_loss'] +
 819	                    0.1 * factors['execution_cost'])
 820	        if score >= 0.8:
 821	            level, action = (RiskLevel.CRITICAL, 'VETO')
 822	        elif score >= 0.55:
 823	            level, action = (RiskLevel.HIGH, 'CLARIFY')
 824	        elif allow_action:
 825	            level, action = (RiskLevel.LOW if score < 0.3
 826	                           else RiskLevel.MEDIUM, 'PASS')
 827	        else:
 828	            level, action = (RiskLevel.LOW if score < 0.3
 829	                           else RiskLevel.MEDIUM, 'CLARIFY')
 830	        largest = sorted(factors.items(), key=lambda item: item[1], reverse=True)
 831	        explanation = '; '.join((f'{name}={value:.3f}'
 832	                                for name, value in largest[:2]))
 833	        return ConflictRisk(score, level, factors, action, explanation)
