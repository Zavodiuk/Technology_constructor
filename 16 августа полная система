 104	def _finite_number(value: Any, name: str) -> float:
 105	    if isinstance(value, bool) or not isinstance(value, (int, float)):
 106	        raise ValueError(f'{name} must be numeric')
 107	    result = float(value)
 108	    if result != result or result in (float('inf'), float('-inf')):
 109	        raise ValueError(f'{name} must be finite')
 110	    return result
 111	
 112	def quantize_ternary(value: float, low: float = 0.3, high: float = 0.7) -> int:
 113	    value = _finite_number(value, 'value')
 114	    if not 0 <= low < high <= 1:
 115	        raise ValueError('ternary thresholds must satisfy 0 <= low < high <= 1')
 116	    return 1 if value >= high else -1 if value <= low else 0
 117	
 118	def quantize_pentary(value: float) -> int:
 119	    value = _finite_number(value, 'value')
 120	    if not 0 <= value <= 1:
 121	        raise ValueError('pentary confidence must be in [0, 1]')
 122	    if value < 0.2:
 123	        return -2
 124	    if value < 0.4:
 125	        return -1
 126	    if value < 0.6:
 127	        return 0
 128	    if value < 0.8:
 129	        return 1
 130	    return 2
 131	
 132	def _validate_vector(values: Sequence[int], allowed: set[int]) -> List[int]:
 133	    result = [int(v) for v in values]
 134	    if not result:
 135	        raise ValueError('vector cannot be empty')
 136	    if any((v not in allowed for v in result)):
 137	        raise ValueError(f'values must belong to {sorted(allowed)}')
 138	    return result
