 144	class SaturatedMatrix:
 145	    """Small immutable-by-convention matrix with explicit finite alphabet."""
 146	
 147	    def __init__(self, data: Sequence[Sequence[int]], limit: int):
 148	        rows = [list(row) for row in data]
 149	        if not rows or not rows[0]:
 150	            raise ValueError('matrix cannot be empty')
 151	        width = len(rows[0])
 152	        if any((len(row) != width for row in rows)):
 153	            raise ValueError('matrix rows must have equal length')
 154	        if any((isinstance(v, bool) or not isinstance(v, int) or abs(v) > limit
 155	                for row in rows for v in row)):
 156	            raise ValueError(f'matrix values must be integers in [-{limit}, {limit}]')
 157	        self.data = tuple((tuple(row) for row in rows))
 158	        self.limit = limit
 159	
 160	    @property
 161	    def shape(self) -> Tuple[int, int]:
 162	        return (len(self.data), len(self.data[0]))
 163	
 164	    def _new(self, data: Sequence[Sequence[int]]) -> 'SaturatedMatrix':
 165	        return SaturatedMatrix(data, self.limit)
 166	
 167	    def add(self, other: 'SaturatedMatrix') -> 'SaturatedMatrix':
 168	        if self.shape != other.shape or self.limit != other.limit:
 169	            raise ValueError('matrix shape or alphabet mismatch')
 170	        return self._new([[
 171	            max(-self.limit, min(self.limit, a + b))
 172	            for a, b in zip(row_a, row_b)
 173	        ] for row_a, row_b in zip(self.data, other.data)])
 174	
 175	    def multiply(self, other: 'SaturatedMatrix') -> 'SaturatedMatrix':
 176	        if self.shape[1] != other.shape[0] or self.limit != other.limit:
 177	            raise ValueError('matrix dimensions or alphabet mismatch')
 178	        rows, inner, cols = (self.shape[0], self.shape[1], other.shape[1])
 179	        data = []
 180	        for i in range(rows):
 181	            row = []
 182	            for j in range(cols):
 183	                raw = sum((self.data[i][k] * other.data[k][j]
 184	                           for k in range(inner)))
 185	                row.append(max(-self.limit, min(self.limit, raw)))
 186	            data.append(row)
 187	        return self._new(data)
 188	
 189	    def transpose(self) -> 'SaturatedMatrix':
 190	        return self._new(list(map(list, zip(*self.data))))
 191	
 192	    def score(self) -> float:
 193	        total = self.shape[0] * self.shape[1] * self.limit
 194	        return sum((sum(row) for row in self.data)) / total
 195	
 196	    def uncertainty(self) -> float:
 197	        total = self.shape[0] * self.shape[1]
 198	        return sum((v == 0 for row in self.data for v in row)) / total
 199	
 200	    def to_dict(self) -> Dict[str, Any]:
 201	        return {
 202	            'data': [list(row) for row in self.data],
 203	            'shape': self.shape,
 204	            'limit': self.limit,
 205	            'score': round(self.score(), 4),
 206	            'uncertainty': round(self.uncertainty(), 4)
 207	        }
