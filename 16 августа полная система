 353	class ExecutionOS:
 354	    """Minimal audited execution boundary; no external side effects by default."""
 355	
 356	    def __init__(self):
 357	        self.records: List[AuditRecord] = []
 358	
 359	    def execute(self, request: OrchestratorRequest,
 360	                response: OrchestratorResponse) -> Optional[str]:
 361	        if response.action is not Action.PASS or not request.allow_action:
 362	            return None
 363	        previous = self.records[-1].hash if self.records else 'GENESIS'
 364	        record = AuditRecord(request.request_id, response.action,
 365	                             response.to_dict(), previous)
 366	        self.records.append(record)
 367	        return record.hash
 368	
 369	    def verify(self) -> bool:
 370	        previous = 'GENESIS'
 371	        for record in self.records:
 372	            if record.previous_hash != previous:
 373	                return False
 374	            previous = record.hash
 375	        return True
