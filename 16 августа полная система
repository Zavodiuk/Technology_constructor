 282	class TernaryLogicModule(LogicModule):
 283	    name, logic_type = ('ternary_logic', LogicType.TERNARY)
 284	
 285	    def evaluate(self, payload: Any) -> ModuleResult:
 286	        values = _validate_vector(payload, {-1, 0, 1})
 287	        score = sum(values) / len(values)
 288	        uncertainty = values.count(0) / len(values)
 289	        confidence = 1.0 - uncertainty
 290	        return ModuleResult(
 291	            self.name, self.logic_type, values, score, confidence, uncertainty,
 292	            {'counts': {str(v): values.count(v) for v in (-1, 0, 1)}},
 293	            'L3 vector evaluated without changing its native alphabet.')
 294	
 295	class PentaryLogicModule(LogicModule):
 296	    name, logic_type = ('pentary_logic', LogicType.PENTARY)
 297	
 298	    def evaluate(self, payload: Any) -> ModuleResult:
 299	        values = _validate_vector(payload, {-2, -1, 0, 1, 2})
 300	        score = sum(values) / (len(values) * 2)
 301	        uncertainty = values.count(0) / len(values)
 302	        confidence = 1.0 - uncertainty
 303	        return ModuleResult(
 304	            self.name, self.logic_type, values, score, confidence, uncertainty,
 305	            {'counts': {str(v): values.count(v) for v in (-2, -1, 0, 1, 2)}},
 306	            'L5 vector evaluated without collapsing extreme states.')
