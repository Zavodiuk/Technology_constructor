1644	
1645	    def __init__(self, dimensions: Sequence[int]):
1646	        dimensions = tuple(int(value) for value in dimensions)
1647	        if not dimensions or any(value <= 0 for value in dimensions):
1648	            raise ValueError('dimensions must be positive')
1649	        self.dimensions = dimensions
1650	        self.field: Dict[Tuple[int, ...], int] = {
1651	            coords: 0
1652	            for coords in itertools.product(*[range(size) for size in dimensions])
1653	        }
