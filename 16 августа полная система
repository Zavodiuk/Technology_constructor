 390	    rounding_mode: str = 'ROUND_HALF_EVEN'
 391	
 392	    def to_dict(self):
 393	        return {
 394	            'source_value': str(self.source_value),
 395	            'source_scale': self.source_scale,
 396	            'target_scale': self.target_scale,
 397	            'transformed_value': str(self.transformed_value),
 398	            'quantization_error': str(self.quantization_error),
 399	            'clipped': self.clipped,
 400	            'reversible': self.reversible,
 401	            'rounding_mode': self.rounding_mode
 402	        }
 403	
 404	def _decimal(value: Number) -> Decimal:
 405	    if isinstance(value, bool):
 406	        raise ValueError('boolean is not a numeric state')
 407	    try:
 408	        result = Decimal(str(value))
 409	    except (InvalidOperation, ValueError) as exc:
 410	        raise ValueError('value must be a finite numeric value') from exc
 411	    if not result.is_finite():
 412	        raise ValueError('value must be finite')
 413	    return result
 414	
 415	def shift_decimal(value: Number, source_scale: int, target_scale: int, *,
 416	                  min_value: Number | None = None,
 417	                  max_value: Number | None = None) -> DecimalShiftResult:
 418	    """Move decimal precision while preserving an auditable loss estimate."""
 419	    if not isinstance(source_scale, int) or not isinstance(target_scale, int):
 420	        raise ValueError('scales must be integers')
 421	    if source_scale < 0 or target_scale < 0:
 422	        raise ValueError('scales cannot be negative')
 423	    source = _decimal(value).quantize(Decimal(1).scaleb(-source_scale),
 424	                                      rounding=ROUND_HALF_EVEN)
 425	    quantum = Decimal(1).scaleb(-target_scale)
 426	    transformed = source.quantize(quantum, rounding=ROUND_HALF_EVEN)
 427	    clipped = False
 428	    if min_value is not None:
 429	        lower = _decimal(min_value)
 430	        if transformed < lower:
 431	            transformed, clipped = (lower, True)
 432	    if max_value is not None:
 433	        upper = _decimal(max_value)
 434	        if transformed > upper:
 435	            transformed, clipped = (upper, True)
 436	    error = transformed - source
 437	    reversible = not clipped and target_scale >= source_scale
 438	    return DecimalShiftResult(source, source_scale, target_scale,
 439	                              transformed, error, clipped, reversible)
 440	
 441	def project_pentary(value: Number, *, scale: int = 2) -> DecimalShiftResult:
 442	    """Project a numeric value to the bounded pentary representation [-2, 2]."""
 443	    return shift_decimal(value, source_scale=scale, target_scale=0,
 444	                         min_value=-2, max_value=2)
