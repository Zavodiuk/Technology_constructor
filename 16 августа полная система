 967	class OperationalOS:
 968	    """Guarded in-memory execution boundary."""
 969	
 970	    def __init__(self, starvation_limit: int = 5):
 971	        if starvation_limit < 1:
 972	            raise ValueError('starvation_limit must be positive')
 973	        self.starvation_limit = starvation_limit
 974	        self.processes: Dict[str, Process] = {}
 975	        self.actions: Dict[str, Callable[[Any], Any]] = {}
 976	        self.records: List[ExecutionRecord] = []
 977	
 978	    def register_action(self, name: str, handler: Callable[[Any], Any]) -> None:
 979	        if not name or not callable(handler):
 980	            raise ValueError('action name and callable handler are required')
 981	        self.actions[name] = handler
 982	
 983	    def create_process(self, process_id: str, priority: int = 0) -> Process:
 984	        if process_id in self.processes:
 985	            raise ValueError(f'process already exists: {process_id}')
 986	        if priority < 0:
 987	            raise ValueError('priority cannot be negative')
 988	        process = Process(process_id, priority)
 989	        self.processes[process_id] = process
 990	        return process
 991	
 992	    def _next_process(self) -> Optional[Process]:
 993	        ready = [p for p in self.processes.values()
 994	                if p.state is ProcessState.READY]
 995	        if not ready:
 996	            return None
 997	        starved = [p for p in ready if p.waiting_ticks >= self.starvation_limit]
 998	        pool = starved or ready
 999	        selected = max(pool, key=lambda p: (p.priority + p.waiting_ticks,
1000	                                           -p.waiting_ticks))
1001	        for process in ready:
1002	            if process.process_id == selected.process_id:
1003	                process.waiting_ticks = 0
1004	            else:
1005	                process.waiting_ticks += 1
1006	        return selected
1007	
1008	    def execute(self, process_id: str, action: Action, action_name: str,
1009	               payload: Any = None, *, risk_score: float = 0.0) -> Any:
1010	        if process_id not in self.processes:
1011	            raise ValueError('unknown process')
1012	        if action is not Action.PASS:
1013	            raise PermissionError(f'execution denied by action {action.value}')
1014	        if not 0 <= risk_score < 0.5:
1015	            raise PermissionError('risk score is outside the execution budget')
1016	        if action_name not in self.actions:
1017	            raise ValueError('unregistered action')
1018	        process = self.processes[process_id]
1019	        if process.state is ProcessState.TERMINATED:
1020	            raise RuntimeError('terminated process cannot execute')
1021	        previous = self.records[-1].hash if self.records else 'GENESIS'
1022	        process.state = ProcessState.RUNNING
1023	        result = self.actions[action_name](payload)
1024	        process.ticks += 1
1025	        process.state = ProcessState.READY
1026	        record = ExecutionRecord(process_id, action, result, previous)
1027	        self.records.append(record)
1028	        return result
