1660	    def _metrics(self, affected_cells: int, boundary_loss: int,
1661	                saturation: int) -> TensorFieldStep:
1662	        counts = {str(value): 0 for value in (-2, -1, 0, 1, 2)}
1663	        for value in self.field.values():
1664	            counts[str(value)] += 1
1665	        total = len(self.field)
1666	        extremes = (counts['-2'] + counts['2']) / total
1667	        activity = 0.0
1668	        for coords, value in self.field.items():
1669	            for axis in range(len(self.dimensions)):
1670	                if coords[axis] + 1 < self.dimensions[axis]:
1671	                    neighbor = list(coords)
1672	                    neighbor[axis] += 1
1673	                    activity += abs(value - self.field[tuple(neighbor)])
1674	        activity /= max(1, total)
1675	        return TensorFieldStep(affected_cells, boundary_loss, saturation,
1676	                              extremes, activity, counts)
