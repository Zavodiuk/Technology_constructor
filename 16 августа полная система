1051	                    'state': p.state.value,
1052	                    'priority': p.priority,
1053	                    'ticks': p.ticks,
1054	                    'waiting_ticks': p.waiting_ticks
1055	                }
1056	                for pid, p in self.processes.items()
1057	            },
