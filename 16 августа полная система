 523	@dataclass
 524	class ScheduledTask:
 525	    task_id: str
 526	    priority: int
 527	    submitted_at: float = field(default_factory=time.time)
 528	    waiting_ticks: int = 0
 529	    runs: int = 0
 530	
 531	    @property
 532	    def effective_priority(self) -> int:
 533	        return self.priority + self.waiting_ticks
 534	
 535	class FairnessScheduler:
 536	    """Deterministic priority scheduler with aging and starvation prevention."""
 537	
 538	    def __init__(self, starvation_limit: int = 5):
 539	        if starvation_limit < 1:
 540	            raise ValueError('starvation_limit must be positive')
 541	        self.starvation_limit = starvation_limit
 542	        self.tasks: Dict[str, ScheduledTask] = {}
 543	        self.history: List[str] = []
 544	
 545	    def submit(self, task_id: str, priority: int = 0) -> None:
 546	        if task_id in self.tasks:
 547	            raise ValueError(f'task already exists: {task_id}')
 548	        if priority < 0:
 549	            raise ValueError('priority cannot be negative')
 550	        self.tasks[task_id] = ScheduledTask(task_id, priority)
 551	
 552	    def dispatch(self) -> Optional[ScheduledTask]:
 553	        if not self.tasks:
 554	            return None
 555	        starved = [t for t in self.tasks.values()
 556	                  if t.waiting_ticks >= self.starvation_limit]
 557	        pool = starved if starved else list(self.tasks.values())
 558	        selected = max(pool, key=lambda t: (t.effective_priority, -t.submitted_at))
 559	        selected.waiting_ticks = 0
 560	        selected.runs += 1
 561	        self.history.append(selected.task_id)
 562	        for task in self.tasks.values():
 563	            if task.task_id != selected.task_id:
 564	                task.waiting_ticks += 1
 565	        return selected
 566	
 567	    def complete(self, task_id: str) -> None:
 568	        self.tasks.pop(task_id, None)
 569	
 570	    def snapshot(self) -> Dict[str, Any]:
 571	        return {
 572	            task_id: {
 573	                'priority': task.priority,
 574	                'waiting_ticks': task.waiting_ticks,
 575	                'effective_priority': task.effective_priority,
 576	                'runs': task.runs
 577	            }
 578	            for task_id, task in self.tasks.items()
 579	        }
