1678	    def step(self, impulses: Sequence[Tuple[Sequence[int], int, int, int]] = ()
1679	             ) -> TensorFieldStep:
1680	        delta: Dict[Tuple[int, ...], int] = {}
1681	        affected, boundary_loss, saturation = 0, 0, 0
1682	        for origin_raw, magnitude, radius, decay in impulses:
1683	            origin = tuple(int(value) for value in origin_raw)
1684	            magnitude, radius, decay = int(magnitude), int(radius), int(decay)
1685	            if not self._inside(origin):
1686	                raise ValueError('impulse origin is outside field')
1687	            if magnitude not in (-2, -1, 0, 1, 2):
1688	                raise ValueError('impulse magnitude must belong to L5')
1689	            if radius < 0 or decay < 0:
1690	                raise ValueError('radius and decay must be non-negative')
1691	            for offsets in itertools.product(
1692	                    *[range(-radius, radius + 1) for _ in self.dimensions]):
1693	                if sum(abs(value) for value in offsets) > radius:
1694	                    continue
1695	                target = tuple(origin[i] + offsets[i]
1696	                              for i in range(len(self.dimensions)))
1697	                if not self._inside(target):
1698	                    boundary_loss += 1
1699	                    continue
1700	                distance = sum(abs(value) for value in offsets)
1701	                magnitude_abs = max(0, abs(magnitude) - decay * distance)
1702	                contribution = (1 if magnitude >= 0 else -1) * magnitude_abs
1703	                if contribution:
1704	                    affected += 1
1705	                    delta[target] = delta.get(target, 0) + contribution
1706	        for coords, contribution in delta.items():
1707	            raw = self.field[coords] + contribution
1708	            clipped = max(-2, min(2, raw))
1709	            if clipped != raw:
1710	                saturation += 1
1711	            self.field[coords] = clipped
1712	        return self._metrics(affected, boundary_loss, saturation)
