1174	class StateStore:
1175	
1176	    def __init__(self, path: str | Path):
1177	        self.path = Path(path)
1178	        self.path.parent.mkdir(parents=True, exist_ok=True)
1179	
1180	    @staticmethod
1181	    def _digest(state: Dict[str, Any]) -> str:
1182	        body = json.dumps(state, sort_keys=True, ensure_ascii=False, default=str)
1183	        return hashlib.sha256(body.encode('utf-8')).hexdigest()
1184	
1185	    def save(self, state: Dict[str, Any]) -> str:
1186	        if not isinstance(state, dict):
1187	            raise ValueError('state must be a dictionary')
1188	        envelope = {'state': state, 'digest': self._digest(state), 'format': 1}
1189	        encoded = json.dumps(envelope, sort_keys=True, ensure_ascii=False,
1190                            indent=2, default=str).encode('utf-8')
1191	        fd, temp_name = tempfile.mkstemp(prefix=f'.{self.path.name}.',
1192                                         dir=str(self.path.parent))
1193	        try:
1194	            with os.fdopen(fd, 'wb') as handle:
1195	                handle.write(encoded)
1196	                handle.flush()
1197	                os.fsync(handle.fileno())
1198	            os.replace(temp_name, self.path)
1199	        finally:
1200	            if os.path.exists(temp_name):
1201	                os.unlink(temp_name)
1202	        return envelope['digest']
1203	
1204	    def load(self) -> Dict[str, Any]:
1205	        if not self.path.exists():
1206	            raise FileNotFoundError(self.path)
1207	        envelope = json.loads(self.path.read_text(encoding='utf-8'))
1208	        if envelope.get('format') != 1 or not isinstance(envelope.get('state'), dict):
1209	            raise ValueError('invalid state envelope')
1210	        expected = self._digest(envelope['state'])
1211	        if envelope.get('digest') != expected:
1212	            raise ValueError('state digest mismatch')
1213	        return envelope['state']
