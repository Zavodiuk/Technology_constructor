1030	    def dispatch_one(self) -> Optional[str]:
1031	        process = self._next_process()
1032	        return process.process_id if process else None
1033	
1034	    def terminate(self, process_id: str) -> None:
1035	        if process_id not in self.processes:
1036	            raise ValueError('unknown process')
1037	        self.processes[process_id].state = ProcessState.TERMINATED
1038	
1039	    def verify_audit(self) -> bool:
1040	        previous = 'GENESIS'
1041	        for record in self.records:
1042	            if record.previous_hash != previous:
1043	                return False
1044	            previous = record.hash
1045	        return True
