class BXOSDaemonReceipt:
    @staticmethod
    def seal(
        event_id: str,
        energy: float,
        threshold: float,
        state: List[int],
        action_taken: str,
    ) -> Dict[str, Any]:
        payload = {
            "event_id": event_id,
            "timestamp_ns": time.time_ns(),
            "system_energy": round(energy, 4),
            "applied_threshold": round(threshold, 4),
            "l5_state": [int(x) for x in state],
            "action": action_taken,
            "author": "Vladimir Zavodiuk",
            "rights": "All rights reserved",
        }
        raw_str = json.dumps(payload, sort_keys=True, ensure_ascii=False)
        digest = hashlib.sha3_256(raw_str.encode("utf-8")).hexdigest()
        return {"receipt_id": event_id, "bxos_digest": digest, "payload": payload}


class OSAutostartManager:
    @staticmethod
    def register_autostart() -> bool:
        script_path = os.path.abspath(sys.argv[0])
        python_executable = sys.executable
        platform_name = sys.platform
        print(f"\n[*] Автозапуск: платформа={platform_name}")
        print(f"[*] Скрипт: {script_path}")
        try:
            if platform_name.startswith("linux"):
                service_content = f"""[Unit]
Description=Harmony OS Enterprise Daemon (Vladimir Zavodiuk)
After=network.target

[Service]
Type=simple
User={os.getenv("USER", "root")}
ExecStart={python_executable} {script_path} --auto-run
Restart=on-failure

[Install]
WantedBy=multi-user.target
"""
                with open("harmony_daemon.service", "w", encoding="utf-8") as f:
                    f.write(service_content)
                print("[+] Создан harmony_daemon.service")
                print(
                    "[i] sudo mv harmony_daemon.service /etc/systemd/system/ && "
                    "sudo systemctl enable --now harmony_daemon"
                )
                return True
            if platform_name == "win32":
                import winreg

                key_path = r"Software\Microsoft\Windows\CurrentVersion\Run"
                with winreg.OpenKey(
                    winreg.HKEY_CURRENT_USER, key_path, 0, winreg.KEY_SET_VALUE
                ) as key:
                    winreg.SetValueEx(
                        key,
                        "HarmonyOSDaemon",
                        0,
                        winreg.REG_SZ,
                        f'"{python_executable}" "{script_path}" --auto-run',
                    )
                print("[+] Зарегистрировано в автозагрузке Windows (HKCU Run).")
                return True
            print(f"[-] Платформа {platform_name}: настройте автозапуск вручную.")
            return False
        except Exception as e:
            print(f"[-] Ошибка регистрации автозапуска: {e}")
            return False


