class BXOSGate:
    @staticmethod
    def guard(signal: np.ndarray) -> np.ndarray:
        return np.clip(signal, -2.0, 2.0)


class LukasiewiczLogic:
    @staticmethod
    def bounded_sum(a: int, b: int) -> int:
        return int(np.clip(a + b, -1, 1))

    @staticmethod
    def implication(a: int, b: int) -> int:
        fa = (a + 1) / 2.0
        fb = (b + 1) / 2.0
        res_float = min(1.0, 1.0 - fa + fb)
        if res_float > 0.66:
            return 1
        if res_float < 0.33:
            return -1
        return 0


class L3Triage:
    """Троичный triage + EMA CPU (α=0.25). Минимум аллокаций в hot-path."""

    __slots__ = ("alpha", "_ema_cpu")

    def __init__(self, alpha: float = 0.25) -> None:
        self.alpha = float(alpha)
        self._ema_cpu = -1.0  # <0 ⇒ ещё не инициализирован

    @staticmethod
    def process_metric(value: float, low: float, high: float) -> int:
        if value >= high:
            return 1
        if value <= low:
            return -1
        return 0

    def process_cpu(self, sample: float, low: float = 20.0, high: float = 80.0) -> int:
        s = float(sample)
        if self._ema_cpu < 0.0:
            self._ema_cpu = s
        else:
            a = self.alpha
            self._ema_cpu = a * s + (1.0 - a) * self._ema_cpu
        return self.process_metric(self._ema_cpu, low, high)


class TelemetryCollector:
    """Быстрый сбор метрик: cpu_percent(interval=None) + EMA → триты."""

    __slots__ = ("triage",)

    def __init__(self, alpha: float = 0.25) -> None:
        self.triage = L3Triage(alpha=alpha)

    def collect(self) -> List[int]:
        cpu_raw = psutil.cpu_percent(interval=None)
        ram = psutil.virtual_memory().percent
        swap = psutil.swap_memory().percent
        try:
            io_c = psutil.disk_io_counters()
            io = min(100.0, ((io_c.read_bytes if io_c else 0) / 10485760.0) % 100.0)
        except Exception:
            io = 0.0
        threads = min(100.0, (len(psutil.pids()) / 10.0) % 100.0)
        return [
            self.triage.process_cpu(cpu_raw, 20.0, 80.0),
            L3Triage.process_metric(ram, 40.0, 85.0),
            L3Triage.process_metric(swap, 5.0, 50.0),
            L3Triage.process_metric(io, 10.0, 70.0),
            L3Triage.process_metric(threads, 30.0, 75.0),
        ]


class L5SystemOntology:
    LAYERS = ("cpu_load", "ram_used", "swap_activity", "io_intensity", "thread_count")

    def __init__(self) -> None:
        self.state = np.zeros(5, dtype=np.int8)

    def update(self, metrics: List[int]) -> np.ndarray:
        arr = np.zeros(5, dtype=np.float64)
        n = min(5, len(metrics))
        for i in range(n):
            arr[i] = metrics[i]
        self.state = BXOSGate.guard(arr).astype(np.int8)
        return self.state

    @property
    def system_energy(self) -> float:
        return float(np.sum(np.abs(self.state)) / 10.0)

    def evaluate_logical_coherence(self) -> int:
        return LukasiewiczLogic.implication(int(self.state[0]), int(self.state[1]))


