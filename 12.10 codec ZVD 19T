@njit(fastmath=True, cache=True)
def _njit_q_val(v: float) -> np.int8:
    if v > 0.75:
        return np.int8(2)
    if v > 0.25:
        return np.int8(1)
    if v >= -0.25:
        return np.int8(0)
    if v >= -0.75:
        return np.int8(-1)
    return np.int8(-2)


@njit(fastmath=True, cache=True)
def _njit_q_field(a: np.ndarray) -> np.ndarray:
    out = np.zeros(a.shape, dtype=np.int8)
    flat_in = a.ravel()
    flat_out = out.ravel()
    for i in range(flat_in.shape[0]):
        v = flat_in[i]
        if v > 0.75:
            flat_out[i] = 2
        elif v > 0.25:
            flat_out[i] = 1
        elif v >= -0.25:
            flat_out[i] = 0
        elif v >= -0.75:
            flat_out[i] = -1
        else:
            flat_out[i] = -2
    return out


@njit(parallel=True, fastmath=True, cache=True)
def _njit_build_all_cubes(st: np.ndarray, tiles_y: int, tiles_x: int) -> np.ndarray:
    """
    Одновременный расчет признаков motion, energy, mask и trust в один проход
    по локальному 3D-окну 5×5×5 с инлайновым квантованием.
    Возвращает единый монолитный массив формы (num_cubes, 5, 5, 5, 4).
    """
    num_cubes = tiles_y * tiles_x
    out = np.empty((num_cubes, 5, 5, 5, 4), dtype=np.int8)
    
    for idx in prange(num_cubes):
        ty = idx // tiles_x
        tx = idx % tiles_x
        y0 = ty * 5
        x0 = tx * 5
        
        # 1. Первый проход: вычисление среднего по временной оси T (axis=2) для trust
        mean_t = np.zeros((5, 5), dtype=np.float32)
        for y in range(5):
            for x in range(5):
                s_val = 0.0
                for t in range(5):
                    s_val += st[t, y0 + y, x0 + x]
                mean_t[y, x] = s_val / 5.0
        
        # 2. Второй проход: формирование 4 граней тетраэдра и инлайновое квантование
        for y in range(5):
            for x in range(5):
                for t in range(5):
                    raw_v = st[t, y0 + y, x0 + x]
                    
                    # Грана 0: motion (дельта яркости)
                    out[idx, y, x, t, 0] = _njit_q_val(raw_v)
                    
                    # Грана 1: energy (|delta| / контраст)
                    en_val = abs(raw_v)
                    out[idx, y, x, t, 1] = _njit_q_val(en_val * 2.0 - 1.0)
                    
                    # Грана 2: mask (семантика / знак)
                    m_val = 0.0
                    if raw_v > 0.0:
                        m_val = 1.0
                    elif raw_v < 0.0:
                        m_val = -1.0
                    out[idx, y, x, t, 2] = _njit_q_val(m_val)
                    
                    # Грана 3: trust (устойчивость через локальное отклонение от среднего по времени)
                    diff = abs(raw_v - mean_t[y, x])
                    clamped = diff * 2.0
                    if clamped > 1.0:
                        clamped = 1.0
                    elif clamped < 0.0:
                        clamped = 0.0
                    trust_v = 1.0 - clamped
                    out[idx, y, x, t, 3] = _njit_q_val(trust_v * 2.0 - 1.0)
                    
    return out


def q_pent(v: float) -> int:
    if v > 0.75:
        return 2
    if v > 0.25:
        return 1
    if v >= -0.25:
        return 0
    if v >= -0.75:
        return -1
    return -2


def q_field(a: np.ndarray) -> np.ndarray:
    return _njit_q_field(a)


# =====================================================================
# ТЕТРАЭДР: 4 грани
# =====================================================================

class TetraCell:
    """
    Минимальная информационная ячейка — тетраэдр.
    Информация на 4 гранях, каждая ∈ [-2, 2].
    """

    __slots__ = ("faces",)

    def __init__(self, faces: Optional[np.ndarray] = None) -> None:
        if faces is None:
            self.faces = np.zeros(N_FACES, dtype=np.int8)
        else:
            f = np.asarray(faces, dtype=np.int8).reshape(N_FACES)
            self.faces = np.clip(f, -2, 2).astype(np.int8)

    def pack(self) -> bytes:
        return (self.faces.astype(np.int16) + 2).astype(np.uint8).tobytes()

    @classmethod
    def unpack(cls, raw: bytes) -> "TetraCell":
        arr = np.frombuffer(raw[:N_FACES], dtype=np.uint8).astype(np.int16) - 2
        return cls(arr.astype(np.int8))

    def energy(self) -> float:
        return float(np.mean(np.abs(self.faces)))


# =====================================================================
# КУБ 5×5×5 ИЗ ТЕТРАЭДРОВ
# =====================================================================

class TetraCube5:
    """
    Куб 5×5×5, в каждом узле — TetraCell (4 грани).
    Форма данных: (5,5,5,4) int8
    """

    __slots__ = ("data",)

    def __init__(self, data: Optional[np.ndarray] = None) -> None:
        if data is None:
            self.data = np.zeros((CUBE, CUBE, CUBE, N_FACES), dtype=np.int8)
        else:
            if data.shape != (CUBE, CUBE, CUBE, N_FACES):
                raise ValueError("expected shape (5,5,5,4)")
            self.data = np.clip(data, -2, 2).astype(np.int8)

    def pack(self) -> bytes:
        flat = (self.data.reshape(-1).astype(np.int16) + 2).astype(np.uint8)
        return flat.tobytes()

    @classmethod
    def unpack(cls, raw: bytes) -> "TetraCube5":
        need = CUBE * CUBE * CUBE * N_FACES
        if len(raw) < need:
            raise ValueError("tetra-cube payload too short")
        arr = np.frombuffer(raw[:need], dtype=np.uint8).astype(np.int16) - 2
        return cls(arr.reshape(CUBE, CUBE, CUBE, N_FACES).astype(np.int8))

    def mean_energy(self) -> float:
        return float(np.mean(np.abs(self.data)))

    def scalar_projection(self) -> np.ndarray:
        w = np.array([0.35, 0.30, 0.20, 0.15], dtype=np.float32)
        s = np.tensordot(self.data.astype(np.float32), w, axes=([-1], [0]))
        return q_field(s / 2.0)


