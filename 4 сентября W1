from typing import Dict, Tuple, Optional

# Тип для единичного трита
Trit = int  # Допустимые значения: -1, 0, 1


def validate_trit(t: Trit) -> Trit:
    """Строгая проверка принадлежности значения троичному алфавиту {-1, 0, 1}."""
    if t not in (-1, 0, 1):
        raise ValueError(f"Недопустимое значение трита: {t}. Ожидается -1, 0 или 1.")
    return t


# ============================================================================
# 1. БАЗОВЫЕ ЗАКОНЫ (Отрицание и Импликация Брусенцова)
# ============================================================

def trit_not(a: Trit) -> Trit:
    """
    Базовое отрицание (инверсия): -t.
    Зеркально отражает троичную шкалу относительно нуля.
    """
    return -validate_trit(a)


# Таблица импликации Брусенцова: a -> b
# Индексация задана матрицей 3x3 для строк (a) и столбцов (b) в порядке {-1, 0, 1}
_IMPL_SCALAR_TABLE: Dict[Tuple[Trit, Trit], Trit] = {
    (-1, -1):  1, (-1,  0):  1, (-1,  1):  1,
    ( 0, -1):  0, ( 0,  0):  1, ( 0,  1):  1,
    ( 1, -1): -1, ( 1,  0):  0, ( 1,  1):  1,
}


def trit_impl(a: Trit, b: Trit) -> Trit:
    """
    Базовая импликация Брусенцова (a -> b).
    Фундаментальный закон, из которого выводятся все остальные логические связи.
    """
    validate_trit(a)
    validate_trit(b)
    return _IMPL_SCALAR_TABLE[(a, b)]


# ============================================================================
# 2. ПРОИЗВОДНЫЕ ОПЕРАЦИИ (Сильная логика Лукасевича / Брусенцова)
# ============================================================

def trit_and(a: Trit, b: Trit) -> Trit:
    """Конъюнкция (AND): a AND b := NOT(a -> NOT(b))."""
    return trit_not(trit_impl(a, trit_not(b)))


def trit_or(a: Trit, b: Trit) -> Trit:
    """Дизъюнкция (OR): a OR b := (NOT a) -> b."""
    return trit_impl(trit_not(a), b)


def trit_eq(a: Trit, b: Trit) -> Trit:
    """Эквивалентность (сравнение): 1 если равны, -1 если противоположны, 0 иначе."""
    validate_trit(a)
    validate_trit(b)
    if a == b:
        return 1
    elif a == -b and a != 0:
        return -1
    else:
        return 0


# ============================================================
# 3. СБАЛАНСИРОВАННАЯ ТРОИЧНАЯ АРИФМЕТИКА (Скалярный уровень)
# ============================================================

def int_to_balanced_ternary(n: int, width: int = 6) -> list[Trit]:
    """
    Целое число -> список тритов фиксированной ширины (младший разряд первым).
    Диапазон для width=6: от -364 до +364.
    """
    max_val = (3 ** width - 1) // 2
    if not (-max_val <= n <= max_val):
        raise ValueError(f"Число {n} вне диапазона ±{max_val} для ширины {width}")
    
    result = []
    v = n
    for _ in range(width):
        rem = v % 3
        v = v // 3
        if rem == 2:
            rem = -1
            v += 1
        elif rem == -2:
            rem = 1
            v -= 1
        result.append(int(rem))
    return result


def balanced_ternary_to_int(trits: list[Trit]) -> int:
    """Список тритов (младший разряд первым) -> целое число."""
    return sum(t * (3 ** i) for i, t in enumerate(trits))


