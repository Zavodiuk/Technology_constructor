def quantize_pentarny(value: float) -> int:
    if value > 0.75:
        return 2
    elif value > 0.25:
        return 1
    elif value >= -0.25:
        return 0
    elif value >= -0.75:
        return -1
    else:
        return -2

# --- МОДУЛЬ 1: МАКРО-ПОЛЕ (ТЕНЗОРНАЯ СРЕДА V11) ---
class PentarnyTensorField:
    def __init__(self, dimensions: tuple):
        self.dimensions = dimensions
        self.field = np.zeros(dimensions, dtype=int)

    def inject_quantum_impulse(self, coordinates: tuple, value: int):
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно лежать в пентарном базисе [-2, 2]")
        self.field[coordinates] = value

    def calculate_field_entropy(self) -> float:
        total_elements = self.field.size
        extreme_states = np.sum(np.abs(self.field) == 2)
        return float(extreme_states / total_elements)

class PentarnyTensorEvolution:
    def __init__(self, tensor_field: PentarnyTensorField):
        self.field = tensor_field
        self.step_counter = 0

    def propagate_wave(self, origin: tuple, radius: int = 1):
        dims = len(origin)
        self.step_counter += 1
        ranges = [range(max(0, origin[d] - radius), 
                       min(self.field.dimensions[d], origin[d] + radius + 1)) 
                  for d in range(dims)]
        for coords in product(*ranges):
            dist = sum(abs(coords[d] - origin[d]) for d in range(dims))
            if 0 < dist <= radius:
                impulse_value = self.field.field[origin] // (dist + 1)
                if impulse_value != 0:
                    current = self.field.field[coords]
                    self.field.field[coords] = max(-2, min(2, current + impulse_value))

    def calculate_field_divergence(self) -> float:
        gradient = np.gradient(self.field.field)
        return float(np.sum([np.sum(np.abs(g)) for g in gradient]))

# --- МОДУЛЬ 2: МИКРО-ГРАФ (СЕТЕВАЯ ФИЗИКА V10.2) ---
class PentarNode:
    def __init__(self, node_id):
        self.node_id = node_id
        self.internal_state = 0
        self.mass = 0.0
        self.decision = 0

    def process_signals(self, signal_matrix_A: int, signal_matrix_B: int) -> int:
        signal_matrix_A = int(max(-2, min(2, signal_matrix_A)))
        signal_matrix_B = int(max(-2, min(2, signal_matrix_B)))

        sum_of_decisions = signal_matrix_A + signal_matrix_B
        conflict = abs(signal_matrix_A - signal_matrix_B)
        
        base_temp = 1.0 + (sum_of_decisions * 0.2)
        actual_temp = max(0.1, base_temp - (conflict * 0.2))
        rhythm = sum_of_decisions * 0.5
        
        if conflict >= 3:
            informational_mass = conflict * 2.5
            self.internal_state = 0
        else:
            informational_mass = conflict * 0.5
            self.internal_state = max(-2, min(2, sum_of_decisions))
            
        self.mass = informational_mass
        self.decision = self.internal_state
        return self.internal_state

class PentarEdge:
    def __init__(self, source: PentarNode, target: PentarNode):
        self.source = source
        self.target = target
        self.energy_flow = 1.0
        self.temp = 1.0
        self.rhythm = 0.0

    def update_dynamics(self):
        decision_sum = self.source.decision + self.target.decision
        total_mass = self.source.mass + self.target.mass
        old_temp = self.temp
        base_modifier = 1.0 + (decision_sum * 0.25) - (total_mass * 0.2)
        self.temp = max(0.05, base_modifier)
        self.rhythm = self.temp - old_temp
        if self.source.decision == -2 or self.target.decision == -2:
            self.energy_flow = 0.0
        else:
            self.energy_flow = (self.temp * 1.5) + (total_mass * 0.5)

class PentarUniverseGraph:
    def __init__(self):
        self.nodes = {}
        self.edges = []
        self.time_step = 0

    def add_node(self, name):
        self.nodes[name] = PentarNode(name)

    def add_edge(self, src, tgt):
        self.edges.append(PentarEdge(self.nodes[src], self.nodes[tgt]))

    def pulse(self):
        self.time_step += 1
        for name, node in self.nodes.items():
            connected_signals = []
            for edge in self.edges:
                if edge.target == node:
                    norm_val = (edge.energy_flow - 1.5) / 1.5
                    connected_signals.append(quantize_pentarny(norm_val))
                elif edge.source == node:
                    connected_signals.append(quantize_pentarny(edge.energy_flow / 3.0 - 0.5))
            
            if not connected_signals:
                connected_signals = [random.choice([-2, -1, 0, 1, 2])]
            
            node.process_signals(int(connected_signals[0]), int(connected_signals[-1]))
            
        for edge in self.edges:
            edge.update_dynamics()

# --- МОДУЛЬ 3: СИНХРОНИЗИРОВАННАЯ ВСЕЛЕННАЯ V15 ---
class PentarnyUniverseV15:
    def __init__(self, dimensions: tuple, node_coords: dict):
        self.tensor_field = PentarnyTensorField(dimensions)
        self.tensor_evolution = PentarnyTensorEvolution(self.tensor_field)
        self.graph = PentarUniverseGraph()
        self.node_coords = node_coords

    def add_node(self, name: str, coords: tuple):
        self.graph.add_node(name)
        self.node_coords[name] = coords

    def add_edge(self, src: str, tgt: str):
        self.graph.add_edge(src, tgt)

    def step(self):
        self.graph.pulse()
        
        for name, node in self.graph.nodes.items():
            if name in self.node_coords:
                coords = self.node_coords[name]
                impulse_val = int(node.decision)
                if impulse_val != 0:
                    self.tensor_field.inject_quantum_impulse(coords, impulse_val)
        
        for name, coords in self.node_coords.items():
            self.tensor_evolution.propagate_wave(coords, radius=1)
            
        field_divergence = self.tensor_evolution.calculate_field_divergence()
        
        for edge in self.graph.edges:
            edge.energy_flow = max(0.0, edge.energy_flow * (1.0 - (field_divergence * 0.01)))

    def display_state(self):
        print(f"\n================ [ СИНХРО-ТАКТ V15: {self.graph.time_step} ] ================")
        print(f"  -> Энтропия тензорного поля (V11): {self.tensor_field.calculate_field_entropy():.4f}")
        print(f"  -> Дивергенция поля (V11): {self.tensor_evolution.calculate_field_divergence():.2f}")
        print("--- СОСТОЯНИЕ УЗЛОВ И КАНАЛОВ (V10.2) ---")
        for name, node in self.graph.nodes.items():
            print(f"  -> Узел [{name}]: Решение = {node.decision:+d} ({PENTAR_CODE[node.decision][:20]}...) | МАССА = {node.mass:.2f}")
        for edge in self.edges:
            print(f"  -> Канал [{edge.source.node_id} -> {edge.target.node_id}]: ПОТОК = {edge.energy_flow:.2f}, ТЕМП = {edge.temp:.2f}")

