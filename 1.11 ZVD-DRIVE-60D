# 3. BARE-METAL JIT KERNELS (ZERO-ALLOCATION, BRANCHLESS FOC & SVPWM)
# =====================================================================

@njit(fastmath=True, cache=True, boundscheck=False)
def _njit_inverter_foc_step(
    normalized_currents: np.ndarray, 
    driver_demand: float, 
    hyperbolic_lut: np.ndarray,
    out_pwm_gates: np.ndarray,
    metric_map_60d: np.ndarray,
    pwm_res: int
):
    """
    Zero-Allocation JIT FOC & SVPWM step operating on normalized currents [-1.0, 1.0].
    - ISO 26262 Safeguards: Validates PWM resolution and enforces Dead-Time Guard-Band limits.
    - Non-Euclidean Warping: Applies Lobachevsky hyperbolic saturation overdrive when driver_demand > 0.85.
    """
    res_pwm = pwm_res
    if res_pwm <= 0:
        res_pwm = 1000

    # 1. Map normalized phase currents into DIM_60 metric tensor space
    for i in range(DIM_60):
        c_idx = i % 3
        raw_val = normalized_currents[c_idx]
        p_val = int(round(raw_val * 2.0))
        if p_val < -2: p_val = -2
        if p_val > 2:  p_val = 2
        metric_map_60d[i] = np.int8(p_val + 2)

    # 2. Hyperbolic Vector Warp (Saturation Overdrive for intensive acceleration)
    is_high_demand = 1.0 if driver_demand > 0.85 else 0.0
    
    # 3. Process 60D vector states through 3-4-5 unpack LUT & compute SVPWM duties
    accum_a = 0.0
    accum_b = 0.0
    accum_c = 0.0

    for i in range(DIM_60):
        penta_byte = metric_map_60d[i]
        penta_val = int(penta_byte) - 2
        p_idx = penta_val + 2
        if p_idx < 0: p_idx = 0
        if p_idx > 4: p_idx = 4
        
        trit = _JIT_UNPACK_LUT[p_idx, 0]
        quad = _JIT_UNPACK_LUT[p_idx, 1]
        
        warp_mod = 1.0
        if is_high_demand > 0.5:
            lut_y = i % 5
            lut_x = (i // 5) % 5
            warp_mod = 1.0 + float(hyperbolic_lut[lut_y, lut_x, 0]) * 0.05

        phase_weight = float(trit * (quad + 1)) * warp_mod
        
        if i % 3 == 0:
            accum_a += phase_weight
        elif i % 3 == 1:
            accum_b += phase_weight
        else:
            accum_c += phase_weight

    half_res = float(res_pwm) / 2.0
    duty_a = int(half_res + (accum_a / 20.0) * half_res * driver_demand)
    duty_b = int(half_res + (accum_b / 20.0) * half_res * driver_demand)
    duty_c = int(half_res + (accum_c / 20.0) * half_res * driver_demand)

    # ISO 26262 Dead-Time Guard-Band Clamping (Prevents shoot-through short circuits)
    max_limit = res_pwm - 10
    if duty_a < 10: duty_a = 10
    elif duty_a > max_limit: duty_a = max_limit

    if duty_b < 10: duty_b = 10
    elif duty_b > max_limit: duty_b = max_limit

    if duty_c < 10: duty_c = 10
    elif duty_c > max_limit: duty_c = max_limit

    # 4. Write gate states into out_pwm_gates with complementary dead-time control
    out_pwm_gates[0] = np.uint16(duty_a)
    out_pwm_gates[1] = np.uint16(res_pwm - duty_a)
    
    out_pwm_gates[2] = np.uint16(duty_b)
    out_pwm_gates[3] = np.uint16(res_pwm - duty_b)
    
    out_pwm_gates[4] = np.uint16(duty_c)
    out_pwm_gates[5] = np.uint16(res_pwm - duty_c)


# =====================================================================
# 4. SOFTWARE-DEFINED INVERTER CLASS & LOBACHEVSKY LUT WARPING
# =====================================================================

class ZVD_SoftwareInverter_60D:
    """
    ===================================================================
    ZVD SOFTWARE-DEFINED INVERTER CORE (60D) - INVARIANT SCALE GOVERNOR
    ===================================================================
    """
    def __init__(self, v_bus: float = 800.0, i_max: float = 1000.0, pwm_resolution: int = 4096) -> None:
        self.v_bus = float(v_bus)
        self.i_max = float(i_max)
        self.pwm_resolution = int(pwm_resolution)
        
        self.currents_abc = np.zeros(3, dtype=np.float32)
        self.normalized_currents = np.zeros(3, dtype=np.float32)
        
        self.metric_map_60d = np.zeros(DIM_60, dtype=np.uint8)
        self.out_pwm_gates = np.zeros(6, dtype=np.uint16)
        
        self.hyperbolic_lut = self._generate_hyperbolic_lut()

    @staticmethod
    def _generate_hyperbolic_lut() -> np.ndarray:
        lut = np.empty((5, 5, 2), dtype=np.int8)
        for y in range(5):
            for x in range(5):
                dy = float(y) - 2.0
                dx = float(x) - 2.0
                dist = math.sqrt(dx*dx + dy*dy)
                # Fixed non-linear Lobachevsky deformation without edge collapse
                offset_y = int(round(2.0 + dy * (1.0 - 0.05 * dist))) - 2
                offset_x = int(round(2.0 + dx * (1.0 - 0.05 * dist))) - 2
                lut[y, x, 0] = np.int8(offset_y)
                lut[y, x, 1] = np.int8(offset_x)
        return lut

    def execute_foc_step(self, ia: float, ib: float, ic: float, driver_demand: float) -> np.ndarray:
        self.currents_abc[0] = ia
        self.currents_abc[1] = ib
        self.currents_abc[2] = ic
        
        for i in range(3):
            self.normalized_currents[i] = self.currents_abc[i] / self.i_max
        
        _njit_inverter_foc_step(
            self.normalized_currents, 
            driver_demand, 
            self.hyperbolic_lut, 
            self.out_pwm_gates, 
            self.metric_map_60d,
            self.pwm_resolution
        )
        return self.out_pwm_gates


# =====================================================================
# 5. OPTICAL SWARM TRANSPORT & ROUTING GATEWAY
# =====================================================================

class OpticalFiberTransmitter60D:
    OPTIC_SYNC = b"ZVD_OPTIC_SWARM_60D"
    
    @staticmethod
    def transmit_bytes(data: bytes, channel_id: str = "SWARM") -> bytes:
        payload_len = len(data)
        checksum = hashlib.sha256(data).digest()
        channel_bytes = channel_id.encode('utf-8').ljust(8, b'\x00')[:8]
        return OpticalFiberTransmitter60D.OPTIC_SYNC + channel_bytes + struct.pack("<I32s", payload_len, checksum) + data


class OpticalFiberReceiver60D:
    @staticmethod
    def receive_and_replicate(optic_packet: bytes, replication_count: int = 1) -> List[bytes]:
        sync = optic_packet[:19]
        if sync != OpticalFiberTransmitter60D.OPTIC_SYNC:
            raise ValueError("Optical synchronization loss detected in swarm fiber channel.")
        
        channel_bytes = optic_packet[19:27]
        payload_len, checksum = struct.unpack("<I32s", optic_packet[27:27+36])
        data = optic_packet[27+36:]
        
        if len(data) != payload_len:
            raise ValueError("Optical packet framing error: length mismatch.")
        if hashlib.sha256(data).digest() != checksum:
            raise ValueError("Optical fiber noise corruption detected: checksum mismatch.")
            
        return [data for _ in range(replication_count)]


