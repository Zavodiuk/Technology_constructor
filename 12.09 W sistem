def interface_continuous_to_ternary(top_scores: np.ndarray, margins: np.ndarray, 
                                    min_score: float, threshold: float, 
                                    out_buffer: np.ndarray) -> None:
    """
    ПЕРЕХОДНЫЙ МОДУЛЬ 1: Перевод непрерывных вероятностных оценок в триты {-1, 0, 1}.
    Служит мостом между Рашомон-анализом входящего хаоса и дискретной логикой.
    """
    # l3_in: 1 (устойчивое ядро), 0 (сомнение), -1 (критически низкая оценка)
    np.where(margins >= threshold, np.int8(1), np.int8(0), out=out_buffer[:, 0])
    np.where(top_scores < min_score, np.int8(-1), out_buffer[:, 0], out=out_buffer[:, 0])
    
    # l3_out: уверенное преодоление порога
    np.where(top_scores > 0.5, np.int8(1), np.int8(0), out=out_buffer[:, 1])
    
    # eff_trit: градация эффективности
    np.where(top_scores > 0.7, np.int8(1), 
             np.where(top_scores >= 0.4, np.int8(0), np.int8(-1)), out=out_buffer[:, 2])


def interface_ternary_to_pentary(parallel_logic_tensor: np.ndarray, out_buffer: np.ndarray) -> None:
    """
    ПЕРЕХОДНЫЙ МОДУЛЬ 2: Масштабирование из троичного пространства {-1, 0, 1} в пентарное {-2, -1, 0, 1, 2}.
    Готовит силу сигналов трех параллельных каналов одновременно.
    """
    np.copyto(out_buffer, np.select(
        condlist=[parallel_logic_tensor == 1, parallel_logic_tensor == 0, parallel_logic_tensor == -1],
        choicelist=[np.int8(2), np.int8(1), np.int8(-1)], 
        default=np.int8(0)
    ).astype(np.int8))


