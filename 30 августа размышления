import numpy as np

class PentaryArithmetic:
    """Модуль расширенной пентарной арифметики нижнего слоя BXOS"""
    
    @staticmethod
    def add_digits(a, b, carry_in=0):
        """
        Сложение двух симметричных пентарных разрядов {-2, -1, 0, 1, 2} 
        с учетом входящего и исходящего переноса (по базе 5).
        Формула баланса: a + b + carry_in = sum_digit + 5 * carry_out
        """
        raw_sum = a + b + carry_in
        
        # Определяем перенос (carry_out) и остаток (sum_digit) по симметричной базе 5
        if raw_sum > 2:
            # Например: 2 + 2 = 4 -> это 5 * 1 - 1 (sum: -1, carry: 1)
            # Например: 2 + 1 = 3 -> это 5 * 1 - 2 (sum: -2, carry: 1)
            carry_out = 1
            sum_digit = raw_sum - 5
        elif raw_sum < -2:
            # Например: -2 + -2 = -4 -> это 5 * (-1) + 1 (sum: 1, carry: -1)
            # Например: -2 + -1 = -3 -> это 5 * (-1) + 2 (sum: 2, carry: -1)
            carry_out = -1
            sum_digit = raw_sum + 5
        else:
            carry_out = 0
            sum_digit = raw_sum
            
        return sum_digit, carry_out

    @classmethod
    def add_pentayts(cls, pentayt_a, pentayt_b):
        """
        Поразрядное сложение двух пентайтов одинаковой размерности 
        с распространением переноса от младших разрядов к старшим.
        """
        size = len(pentayt_a)
        result = np.zeros(size, dtype=int)
        carry = 0
        
        # Идем справа налево (от младших к старшим, если массив упорядочен так)
        for i in reversed(range(size)):
            sum_digit, carry = cls.add_digits(pentayt_a[i], pentayt_b[i], carry)
            result[i] = sum_digit
            
        # Возвращаем итоговый вектор-пентайт и финальный перенос переполнения слова
        return result, carry


class BXOSJudgmentFunctions:
    """Специфические логические функции анализа суждений BXOS"""
    
    @staticmethod
    def ternary_to_pentary_projection(ternary_vector):
        """Прямая проекция троичного трайта в пентарный слой (Уровни 2 -> 5)"""
        # Вложение {-1, 0, 1} в {-2, -1, 0, 1, 2} без искажения смыслов
        return np.array(ternary_vector, dtype=int)

    @staticmethod
    def pentary_to_ternary_compression(pentary_vector, threshold=1.5):
        """
        Сжатие/свёртка пентарного суждения обратно в троичное каноническое ядро (Уровни 5 -> 2).
        Реализует функцию оценки интенсивности:
        Экстремумы ±2 сжимаются до ±1, но если они доминируют, выставляется системный маркер важности.
        """
        ternary_result = np.zeros(len(pentary_vector), dtype=int)
        meta_flags = [] # Скрытые маркеры экстра-важности для Длинного Оркестратора
        
        for i, val in enumerate(pentary_vector):
            if abs(val) >= 2:
                meta_flags.append(f"EXTREME_VALUE_AT_INDEX_{i}")
                ternary_result[i] = np.sign(val) # Перевод ±2 в брусенцовские ±1
            else:
                ternary_result[i] = val # Состояния -1, 0, 1 переносятся как есть
                
        return ternary_result, meta_flags


