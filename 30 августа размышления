    # Тест 1: Сложение двух экстремальных разрядов
    s_digit, c_out = PentaryArithmetic.add_digits(2, 2)
    print(f"Разрядный тест: 2 + 2 = {s_digit} (Перенос: {c_out}) -> Математически корректно: 5 * {c_out} + ({s_digit}) = 4")
    
    # Тест 2: Сложение двух пентайтов (векторов состояний)
    # Состояние А: [2,  1, -2]
    # Состояние Б: [2,  0, -2]
    pentayt_A = np.array([2, 1, -2])
    pentayt_B = np.array([2, 0, -2])
    
    sum_vector, final_carry = PentaryArithmetic.add_pentayts(pentayt_A, pentayt_B)
    print(f"Сложение пентайтов: {pentayt_A} + {pentayt_B} = {sum_vector} (Финальный перенос слова: {final_carry})")
    
    print("\n[BXOS] Тестирование функции логического сжатия суждений...")
    
    # Тест 3: Функция свёртки суждения из Пентарного в Троичный слой
    complex_judgment = np.array([2, -1, 0, -2, 1])
    canonical_troits, flags = BXOSJudgmentFunctions.pentary_to_ternary_compression(complex_judgment)
    
    print(f"Исходное пентарное суждение: {complex_judgment}")
