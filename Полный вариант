# ==================================================
# ARCHITECTURE v6.1.8 PATCH
# SHARED MODULE — rashomon.py
#
# Заменяет прежний паттерн "Rashomon = среднее арифметическое",
# повторявшийся во всех 8 блоках, на механизм, который реально
# делает то, для чего задуман Расёмон: обнаруживает РАСХОЖДЕНИЕ
# между независимыми оценками, а не просто усредняет его в
# ложно-уверенное число.
#
# Идея: consensus (среднее) остаётся полезной точечной оценкой,
# но теперь дополняется мерой разброса (StdDev/Spread). Если
# разброс превышает порог — это сигнал РЕАЛЬНОГО расхождения
# мнений, и решение не должно тихо проходить как L3=+1 только
# потому, что среднее оказалось высоким.
#
# Используется всеми блоками 0-7 вместо их собственных копий
# rashomon_check/meta_rashomon.
# ==================================================



def rashomon_evaluate(opinions, disagreement_threshold=0.25, labels=None):
    """
    opinions: список независимых оценок (например, E1, E2, E3;
              H1, H2, H3; экспертные значения и т.д.), каждая
              в диапазоне [0,1].
    disagreement_threshold: если стандартное отклонение мнений
              превышает это значение — фиксируется расхождение.
    labels: опционально — имена источников оценок (например,
              ["E1", "E2", "E3"]), для трассировки, кто с кем
              разошёлся.

    Возвращает:
      Consensus  — среднее (точечная оценка, как раньше)
      StdDev     — стандартное отклонение (мера расхождения)
      Spread     — max-min (простая, наглядная мера разброса)
      Count      — число оценок
      Disagreement — True, если StdDev > disagreement_threshold
      Recommendation — что делать дальше:
          "USE_CONSENSUS"  — мнения согласуются, можно доверять среднему
          "FORCE_ANALYZE"  — мнения разошлись, решение не должно
                              автоматически проходить в L3=+1,
                              даже если среднее высокое
    """

    if not opinions:
        return None

    n = len(opinions)
    consensus = sum(opinions) / n

    stdev = statistics.pstdev(opinions) if n > 1 else 0.0
    spread = max(opinions) - min(opinions) if n > 1 else 0.0

    disagreement = stdev > disagreement_threshold

    result = {
        "Consensus": consensus,
        "StdDev": stdev,
        "Spread": spread,
        "Count": n,
        "Disagreement": disagreement,
        "Recommendation": "FORCE_ANALYZE" if disagreement else "USE_CONSENSUS"
    }

    if labels:
        result["Labels"] = dict(zip(labels, opinions))

    return result


def meta_rashomon_evaluate(evaluation_a, evaluation_b, tolerance=0.1):
    """
    Проверка самой проверки (Meta-Rashomon) — теперь сравнивает
    не два голых числа, а два ПОЛНЫХ результата rashomon_evaluate,
    включая их вывод о расхождении, а не только консенсус.

    Раньше: meta_rashomon(check_a, check_b) сравнивал два числа
    и не мог заметить ситуацию, где консенсусы совпали случайно,
    а сами внутренние расхождения оценок — разные (например,
    A: [0.5, 0.5, 0.5] и B: [0.1, 0.5, 0.9] дают одинаковый
    Consensus=0.5, но это совершенно разные ситуации).

    Возвращает:
      ConsensusDifference — разница средних
      DisagreementMismatch — True, если один прогон обнаружил
              расхождение мнений, а другой — нет (это само по
              себе сигнал ошибки в механизме оценки)
      Status — "VALID" | "RECHECK"
    """

    if evaluation_a is None or evaluation_b is None:
        return {"Status": "RECHECK", "Reason": "Пустая оценка"}

    consensus_diff = abs(
        evaluation_a["Consensus"] - evaluation_b["Consensus"]
    )

    disagreement_mismatch = (
        evaluation_a["Disagreement"] != evaluation_b["Disagreement"]
    )

    if consensus_diff < tolerance and not disagreement_mismatch:
        status = "VALID"
    else:
        status = "RECHECK"

    return {
        "ConsensusDifference": consensus_diff,
        "DisagreementMismatch": disagreement_mismatch,
        "Status": status
    }



