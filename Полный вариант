"""
ТЕСТ: разделение ОДНОЙ величины (например, Tempo) на несколько
потоков как дополнительный слой защиты для blockchain

Это ДРУГАЯ идея, чем вчерашняя (умножение матриц как "хэш") --
здесь используется настоящая, известная техника: РАЗДЕЛЕНИЕ
СЕКРЕТА (secret sharing, аддитивная схема). В отличие от
вчерашнего, эта техника имеет РЕАЛЬНОЕ математическое
доказательство защиты, а не просто "трудно перебрать".

Принцип (n-из-n аддитивная схема):
  secret = share_1 + share_2 + ... + share_n (mod M)

Каждая доля (share) генерируется СЛУЧАЙНО, кроме последней,
которая вычисляется так, чтобы сумма дала исходный секрет.

КЛЮЧЕВОЕ СВОЙСТВО (в отличие от вчерашнего): любой, у кого
есть ВСЕ доли КРОМЕ ОДНОЙ, не имеет АБСОЛЮТНО НИКАКОЙ информации
о секрете -- не "трудно угадать", а математически ноль
информации (Shannon-теоретическая, а не вычислительная защита).
"""



def split_secret_additive(secret_value, n_shares, modulus):
    """
    Разделяет secret_value на n_shares долей по модулю modulus.
    Сумма всех долей (mod modulus) = secret_value.
    """
    shares = [random.randint(0, modulus - 1) for _ in range(n_shares - 1)]
    last_share = (secret_value - sum(shares)) % modulus
    shares.append(last_share)
    random.shuffle(shares)
    return shares


def reconstruct_secret(shares, modulus):
    """Восстановление: просто сумма всех долей по модулю."""
    return sum(shares) % modulus


def value_to_ternary_stream(value, modulus, n_trits):
    """Кодирует одно целое число (0..modulus-1) как
    последовательность тритов -- каждая 'доля' далее может
    передаваться как отдельный троичный поток."""
    digits = []
    remainder = value
    for _ in range(n_trits):
        digit = remainder % 3
        if digit == 2:
            digit = -1
            remainder += modulus  # компенсация для балансированной формы
        digits.append(digit)
        remainder //= 3
    return digits



