"""
ТЕСТ: интеграция графов (Блок №2) и время/темп/ритм (temporal.py)
в Block X

ИДЕЯ 1 (граф): матрица согласия R×Rᵀ (Часть 8 Block X) -- это
УЖЕ ПО СУТИ взвешенная матрица смежности графа (граф решений,
где узлы = кандидаты, рёбра = сила согласия между ними). Значит,
интеграция с Блоком №2 (G=(V,E,W,T,Z,Σ,L3)) естественна --
можно применить графовые операции (например, поиск компонент
связности -- "кластеров согласия").

ИДЕЯ 2 (ритм): проследить несколько ЦИКЛОВ Block X подряд и
измерить Rhythm последовательности L3_out -- насколько
СТАБИЛЬНО система принимает решения во времени, а не только
насколько хорошо одно отдельное решение.
"""



# ==========================================================
# ИДЕЯ 1: граф решений -- поиск кластеров согласия
# ==========================================================

def find_agreement_clusters(agreement_matrix, n_axes, threshold=0.6):
    """
    Простой поиск кластеров: два кандидата считаются "в одном
    кластере", если их согласие (нормированное) выше порога.
    Реализовано как union-find по рёбрам графа согласия --
    прямое применение идеи Блока №2 (G=(V,E)) к пространству
    решений Block X.
    """
    n = len(agreement_matrix)
    parent = list(range(n))

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(x, y):
        px, py = find(x), find(y)
        if px != py:
            parent[px] = py

    edges = []
    for i in range(n):
        for j in range(i+1, n):
            normalized = agreement_matrix[i][j] / n_axes
            if normalized >= threshold:
                union(i, j)
                edges.append((i, j, normalized))

    clusters = {}
    for i in range(n):
        root = find(i)
        clusters.setdefault(root, []).append(i)

    return {"clusters": list(clusters.values()), "edges": edges}


