# ==================================================
# ARCHITECTURE v6.1.9 PATCH
# SHARED MODULE — zmatch.py
#
# Заменяет прежний паттерн "Z_match = (a == b)", повторявшийся
# во всех 8 блоках, на реальное измерение похожести текста.
#
# ЧЕСТНОЕ ОГРАНИЧЕНИЕ: в этой среде нет доступа к интернету из
# кода, поэтому "настоящие" embeddings (через внешний API) здесь
# вызвать нельзя. Вместо этого реализованы ДВА уровня:
#
#   Уровень 1 — лексическое сходство (работает офлайн, всегда
#   доступно, детерминировано). Это не "понимание смысла" в
#   полном смысле, а сравнение по общим словам/n-граммам —
#   заметно лучше, чем точное "==", но не заменяет полноценную
#   семантическую модель.
#
#   Уровень 2 — внешняя оценка (external_semantic_score).
#   Если у вызывающего кода есть доступ к языковой модели
#   (например, вы прямо спрашиваете меня "насколько это письмо
#   соответствует замыслу X" и получаете число), это число можно
#   передать сюда напрямую — оно приоритетнее лексического.
#
# Для чисел (не текста) Z_match остаётся точным сравнением —
# там "==" осмысленно и его менять не нужно.
# ==================================================



def _tokenize(text):
    """Разбивает текст на слова в нижнем регистре, без знаков препинания."""
    return set(re.findall(r"[a-zа-яё0-9]+", text.lower()))


def lexical_similarity(text_a, text_b):
    """
    Комбинация двух мер:
    - Jaccard по множеству слов (насколько пересекается словарь)
    - SequenceMatcher по символьным последовательностям (насколько
      похож порядок/структура текста)

    Возвращает число в диапазоне [0,1].
    """

    if not text_a or not text_b:
        return 0.0

    words_a = _tokenize(text_a)
    words_b = _tokenize(text_b)

    if not words_a or not words_b:
        jaccard = 0.0
    else:
        intersection = words_a & words_b
        union = words_a | words_b
        jaccard = len(intersection) / len(union)

    sequence_ratio = difflib.SequenceMatcher(
        None, text_a.lower(), text_b.lower()
    ).ratio()

    # среднее двух мер — сглаживает крайние случаи одной метрики
    return (jaccard + sequence_ratio) / 2


def calculate_z_match(
    value_a,
    value_b,
    external_semantic_score=None
):
    """
    Единая точка входа для всех блоков.

    - Если оба значения — числа: точное сравнение (как раньше),
      это корректно для числовых состояний (S1, S2, target_value).
    - Если хотя бы одно — None: 0.5 (неопределённость, как раньше).
    - Если оба — строки: лексическое сходство (НОВОЕ поведение
      вместо "==").
    - Если передан external_semantic_score (число 0..1) — он
      используется вместо лексического сходства, как более точная
      оценка (например, от LLM).
    """

    if value_a is None or value_b is None:
        return 0.5

    if external_semantic_score is not None:
        return max(0.0, min(1.0, external_semantic_score))

    # числа — точное сравнение остаётся осмысленным
    if isinstance(value_a, (int, float)) and isinstance(value_b, (int, float)):
        return 1.0 if value_a == value_b else 0.0

    # строки — лексическое сходство вместо "=="
    if isinstance(value_a, str) and isinstance(value_b, str):
        return lexical_similarity(value_a, value_b)

    # смешанные/прочие типы — как раньше, точное сравнение
    return 1.0 if value_a == value_b else 0.0



