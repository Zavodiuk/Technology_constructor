# ==================================================
# ARCHITECTURE v6.1.10 PATCH
# SHARED MODULE — efficiency.py
#
# Устраняет разрыв, повторявшийся во ВСЕХ 8 блоках (0-7):
# `E` (эффективность) — множитель в формуле
#
#   Development = ΔS × E × Z_match × Manageability
#
# — нигде не вычислялся. Это было просто число, подаваемое
# извне (в примерах — 0.8), без формулы, которая бы объясняла,
# откуда оно берётся.
#
# ФОРМУЛА (новая, v6.1.10):
#
#   E = V / (V + C)
#
# где:
#   V (Value)  — произведённая ценность / достигнутый результат
#   C (Cost)   — затраты на достижение этого результата
#
# Почему именно так, а не A_raw/A_reference (как в патче для
# адаптации, Блок №6):
#   - Не нужна внешняя калибровочная константа (A_reference) —
#     формула САМА ограничена диапазоном (0,1) за счёт
#     математической структуры V/(V+C).
#   - E → 1, когда C → 0 (результат достигнут почти бесплатно).
#   - E → 0, когда C → ∞ или V → 0 (высокие затраты без
#     результата, либо результат без затрат недостижим).
#   - Формула переиспользует терминологию, которую вы уже
#     ввели в черновике "Блок B" (Gc — выгода сотрудничества,
#     Cf — стоимость конфликта, Gc > Cf — главная формула):
#     это тот же принцип "ценность против стоимости",
#     формализованный для E.
#
# Область применения не ограничена откликами ИИ — это общая
# формула эффективности для любого блока архитектуры (решения,
# адаптации, обучения и т.д.), не только для формата ответов.
# ==================================================


def calculate_efficiency(value, cost):
    """
    E = V / (V + C), ограничено (0, 1).

    value: произведённая ценность (Value / Gc) — неотрицательное число
    cost:  затраты на её достижение (Cost / Cf) — неотрицательное число

    Особые случаи:
    - value=0, cost=0  -> 0.5 (полная неопределённость: ни ценности,
                                ни затрат — как и в остальной
                                архитектуре, 0.5 обозначает "нет данных")
    - value=0, cost>0  -> 0.0 (чистые издержки без результата)
    - value>0, cost=0  -> 1.0 (результат достигнут без затрат)
    """

    if value < 0 or cost < 0:
        raise ValueError("value и cost должны быть неотрицательными")

    if value == 0 and cost == 0:
        return 0.5

    return value / (value + cost)


def calculate_response_efficiency(relevance, length_cost, branch_count=0, branch_cost_weight=0.15):
    """
    Специализация E для формата ответа (см. обсуждение "Блока №8" —
    формат и эффективность ответа).

    relevance:   насколько ответ соответствует вопросу — можно
                 напрямую передать Z_match (см. zmatch.py) как value
    length_cost: "стоимость потребления" — грубая мера объёма текста
                 (например, число предложений / 10, чтобы держать
                 масштаб сопоставимым с relevance ∈ [0,1])
    branch_count: количество веток/раскрывающихся секций в ответе
    branch_cost_weight: вклад каждой ветки в общую стоимость —
                 ветвление имеет свою цену для читателя, даже если
                 сворачиваемо по умолчанию

    Возвращает E_response ∈ (0,1). Высокое значение — ответ короткий
    и по делу относительно своей ценности; низкое — ответ раздут
    (много текста/веток) относительно того, что он реально доносит.
    """

    total_cost = length_cost + branch_count * branch_cost_weight
    return calculate_efficiency(relevance, total_cost)



