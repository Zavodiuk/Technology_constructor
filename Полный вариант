# ==================================================
# ARCHITECTURE v6.1.11 PATCH
# SHARED MODULE — temporal.py
#
# Реализует исправленную временную динамику (см.
# Temporal_Control_v6.1.11_revised.md):
#
# 1) calculate_rhythm — Rhythm теперь ГАРАНТИРОВАННО в [0,1]
#    через clamp, вместо формулы, которая могла уйти в минус
#    при нестабильном развитии (σV > V_average).
#
# 2) calculate_tempo_factor — заменяет сырой Tempo как множитель
#    Development. Раньше умножение на сырой Tempo вознаграждало
#    систему за опасное ускорение (Tempo=3 давал больший
#    Development, чем Tempo=1, хотя текст называет Tempo>1.3
#    риском потери контроля). Новая функция — треугольная,
#    с пиком (=1.0) РОВНО при Tempo=1 (оптимум) и падением до 0
#    на обеих границах рабочей зоны.
#
# 3) calculate_development_controlled — итоговая формула,
#    использующая Tempo_factor и clamped Rhythm вместо старых
#    ошибочных множителей.
# ==================================================


def calculate_rhythm(std_dev_v, v_average):
    """
    Rhythm = clamp(1 - std_dev_v/v_average, 0, 1)

    std_dev_v: стандартное отклонение скорости изменений (σV)
    v_average: средняя скорость изменений

    Особый случай: v_average == 0 -> Rhythm = 0 (стабильность
    неподвижной системы не определена содержательно; безопаснее
    трактовать как отсутствие устойчивого ритма, а не как
    деление на ноль).
    """

    if v_average == 0:
        return 0.0

    raw = 1 - (std_dev_v / v_average)

    return max(0.0, min(1.0, raw))


def calculate_tempo_factor(tempo, tempo_limit_low=0.7, tempo_limit_high=1.3):
    """
    Треугольная функция с пиком (=1.0) при tempo=1 (оптимальная
    скорость) и падением до 0.0 на границах рабочей зоны
    [tempo_limit_low, tempo_limit_high] и за её пределами.

    Раньше Development_controlled умножался на СЫРОЙ tempo —
    из-за чего чрезмерное ускорение (tempo=2, 3, 5...)
    математически УВЕЛИЧИВАЛО Development, хотя текст явно
    называет tempo > tempo_limit_high риском потери контроля.
    Эта функция исправляет направление зависимости: оптимум
    вознаграждается, отклонение в любую сторону — штрафуется.
    """

    if tempo <= tempo_limit_low or tempo >= tempo_limit_high:
        return 0.0

    if tempo <= 1:
        # рост от 0 (на нижней границе) до 1 (на tempo=1)
        return (tempo - tempo_limit_low) / (1 - tempo_limit_low)

    # падение от 1 (на tempo=1) до 0 (на верхней границе)
    return (tempo_limit_high - tempo) / (tempo_limit_high - 1)


def calculate_development_controlled(
    delta_s,
    efficiency,
    z_match,
    manageability,
    tempo,
    std_dev_v,
    v_average,
    tempo_limit_low=0.7,
    tempo_limit_high=1.3
):
    """
    Development_controlled = ΔS × E × Z_match × Manageability
                              × Tempo_factor × Rhythm

    Полная, исправленная формула управляемого развития —
    заменяет старую версию, где сырой Tempo как множитель
    поощрял опасное ускорение.
    """

    tempo_factor = calculate_tempo_factor(
        tempo, tempo_limit_low, tempo_limit_high
    )
    rhythm = calculate_rhythm(std_dev_v, v_average)

    development = (
        delta_s *
        efficiency *
        z_match *
        manageability *
        tempo_factor *
        rhythm
    )

    return {
        "Development_controlled": development,
        "Tempo_factor": tempo_factor,
        "Rhythm": rhythm
    }



