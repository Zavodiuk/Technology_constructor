"""
ТЕСТ ГИПОТЕЗЫ: Время/Темп/Ритм связаны как производные --
можно ли использовать эту связь, разделив данные на два потока
(состояние S(t) в одном, темп dS/dt в другом), как
дополнительный слой защиты?

ЧЕСТНАЯ ПЕРЕФОРМУЛИРОВКА ЗАДАЧИ: это НЕ про секретность (скрыть
значение от чужих глаз -- этим вчера занималось разделение
секрета). Это про ЦЕЛОСТНОСТЬ (integrity) -- обнаружение, что
данные подделали по дороге. Разная задача, разный тип защиты.

Идея: если Поток 1 = состояние S(t) в разные моменты времени,
а Поток 2 = темп (dS/dt), эти два потока МАТЕМАТИЧЕСКИ СВЯЗАНЫ.
Если получатель пересчитывает темп из Потока 1 и сравнивает с
Потоком 2 -- любое ИЗМЕНЕНИЕ ТОЛЬКО ОДНОГО потока становится
заметным как несовпадение.
"""

def compute_tempo_stream(state_stream, dt=1.0):
    """Темп = производная состояния (Часть 'Время, темп, ритм')."""
    return [
        (state_stream[i] - state_stream[i-1]) / dt
        for i in range(1, len(state_stream))
    ]


def verify_consistency(state_stream, tempo_stream, dt=1.0, tolerance=1e-9):
    """Пересчитывает темп из состояния и сравнивает с переданным
    потоком темпа -- ловит рассогласование."""
    recomputed = compute_tempo_stream(state_stream, dt)

    if len(recomputed) != len(tempo_stream):
        return {"consistent": False, "reason": "LENGTH_MISMATCH"}

    mismatches = []
    for i, (r, t) in enumerate(zip(recomputed, tempo_stream)):
        if abs(r - t) > tolerance:
            mismatches.append({"index": i, "expected": r, "received": t})

    return {
        "consistent": len(mismatches) == 0,
        "mismatches": mismatches
    }



