# ==================================================
# ARCHITECTURE v6.1.12 PATCH
# SHARED MODULE — aggregate.py
#
# Блоки 8-11 используют формулы вида:
#   Integrity = Consistency × Completeness × Z_match
#   Execution Quality = Result × Stability × Safety
#   Forecast Confidence = Prediction × Reliability × Z_match
#   Strategic Alignment = Intent × Forecast × Adaptation × Evolution
#
# ПРОБЛЕМА (найдена в Блоке №11): прямое произведение N величин,
# каждая в [0,1], даёт результат, который систематически ниже
# порога 0.7, даже если каждая величина по отдельности хороша.
# Пример: 0.9 × 0.9 × 0.9 × 0.9 ≈ 0.66 < 0.7 — L3 никогда не
# достигнет +1, даже когда всё реально идёт хорошо.
#
# РЕШЕНИЕ: среднее геометрическое вместо прямого произведения.
# geometric_mean(0.9, 0.9, 0.9, 0.9) = 0.9 — сохраняет то же
# требование "все компоненты должны быть хороши одновременно"
# (если хотя бы один компонент близок к 0, среднее тоже падает
# к 0 — в отличие от арифметического среднего), но не наказывает
# только за количество перемножаемых компонентов.
# ==================================================


def geometric_mean(*values):
    """
    Среднее геометрическое: (v1 × v2 × ... × vn) ^ (1/n)

    Все значения должны быть в диапазоне [0,1] (как и везде
    в архитектуре). Если хотя бы одно значение = 0, результат = 0
    (это осознанное поведение: как и в исходной идее "все компоненты
    должны выполняться одновременно", один провальный компонент
    должен обнулять итог — в отличие от арифметического среднего,
    которое такой провал сгладило бы).
    """

    if not values:
        return 0.0

    for v in values:
        if v < 0:
            raise ValueError("Все компоненты должны быть неотрицательны")

    product = 1.0
    for v in values:
        product *= v

    n = len(values)
    return product ** (1 / n)



