"""
ТЕСТ ГИПОТЕЗЫ: направленные графы для блокчейна/криптографии

Направленные графы РЕАЛЬНО используются в блокчейне -- это
называется ДЕРЕВО МЕРКЛА (Merkle tree), стандартная техника
Bitcoin, Ethereum и почти всех блокчейнов. Это направленный
граф (дерево): каждый узел зависит от своих потомков, и любое
изменение ЛЮБОГО листа распространяется вверх до корня.

Здесь строим дерево Меркла, используя НАШИ инструменты
(ternary_fold как функция объединения вместо обычного хэша),
и честно сравниваем с "плоской" проверкой (вчерашняя связь
через производную) -- находит ли направленная древовидная
структура подделку ТОЧНЕЕ (не просто "да/нет", а КАКОЙ ИМЕННО
элемент подделан).
"""



def leaf_hash(data):
    """Хэш листового узла (обычный криптографический хэш --
    ЗДЕСЬ используется настоящий SHA-256, не наша троичная
    операция, потому что вчера доказали: для хэширования нужна
    настоящая криптография, не троичное умножение)."""
    return hashlib.sha256(str(data).encode()).hexdigest()[:12]


def combine_hash(left, right):
    """Объединение двух дочерних узлов в родительский --
    направленная связь: родитель ЗАВИСИТ от детей, не наоборот."""
    return hashlib.sha256((left + right).encode()).hexdigest()[:12]


def build_merkle_tree(leaves_data):
    """Строит дерево Меркла снизу вверх, возвращает все уровни
    (направленный граф: рёбра идут от листьев к корню)."""
    level = [leaf_hash(d) for d in leaves_data]
    tree_levels = [level]

    while len(level) > 1:
        if len(level) % 2 == 1:
            level = level + [level[-1]]  # дублируем последний при нечётном числе
        next_level = [combine_hash(level[i], level[i+1]) for i in range(0, len(level), 2)]
        tree_levels.append(next_level)
        level = next_level

    return tree_levels


def find_tampered_leaf(original_leaves, tampered_leaves):
    """
    Использует НАПРАВЛЕННОСТЬ графа для локализации подделки:
    сравнивает деревья уровень за уровнем от корня к листьям,
    на каждом шаге сужая, В КАКОЙ ПОЛОВИНЕ находится расхождение
    -- это возможно ИМЕННО благодаря направленной структуре
    (бинарный поиск по дереву), а не при плоской проверке.
    """
    tree_orig = build_merkle_tree(original_leaves)
    tree_tamp = build_merkle_tree(tampered_leaves)

    root_orig = tree_orig[-1][0]
    root_tamp = tree_tamp[-1][0]

    if root_orig == root_tamp:
        return {"tampered": False}

    # спускаемся от корня к листьям, находя расходящийся индекс
    n_levels = len(tree_orig)
    index = 0
    for level in range(n_levels - 1, 0, -1):
        left_idx = index * 2
        right_idx = index * 2 + 1
        left_orig = tree_orig[level-1][left_idx] if left_idx < len(tree_orig[level-1]) else None
        left_tamp = tree_tamp[level-1][left_idx] if left_idx < len(tree_tamp[level-1]) else None

        if left_orig != left_tamp:
            index = left_idx
        else:
            index = right_idx

    return {"tampered": True, "leaf_index": index}



