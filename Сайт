<script>
    // L3-индикатор: живёт и пульсирует
    const lamps = document.querySelectorAll('.trit-lamp');
    const label = document.querySelector('.trit-label');
    const states = ['active-plus', 'active-zero', 'active-minus'];
    let idx = 0;

    setInterval(() => {
        lamps.forEach((l, i) => {
            l.className = 'trit-lamp';
            if (i === idx) l.classList.add(states[idx]);
        });
        const labels = ['L3 · уверен', 'L3 · уточнение', 'L3 · конфликт'];
        label.textContent = labels[idx];
        idx = (idx + 1) % states.length;
    }, 2000);
</script>

