<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>BXOS / Block X — новая парадигма вычислений</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0B0D11;
            --panel: #14161B;
            --panel-hi: #1C1F26;
            --line: #2C3038;
            --text: #EAE8E3;
            --text-dim: #8A8F99;
            --plus: #4ADE80;
            --zero: #FBBF24;
            --minus: #F87171;
            --mono: 'IBM Plex Mono', monospace;
            --sans: 'Manrope', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--sans);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a { color: var(--zero); text-decoration: none; }
        a:hover { text-decoration: underline; }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 24px 60px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0 20px;
            border-bottom: 1px solid var(--line);
            flex-wrap: wrap;
            gap: 12px;
        }

        .logo {
            font-family: var(--mono);
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.06em;
        }
        .logo span { color: var(--text-dim); font-weight: 400; }

        .trit-indicator {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .trit-lamp {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #333844;
            transition: all .3s;
        }
        .trit-lamp.active-plus { background: var(--plus); box-shadow: 0 0 12px rgba(74,222,128,.5); }
        .trit-lamp.active-zero { background: var(--zero); box-shadow: 0 0 12px rgba(251,191,36,.5); }
        .trit-lamp.active-minus { background: var(--minus); box-shadow: 0 0 12px rgba(248,113,113,.5); }

        .trit-label {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--text-dim);
            letter-spacing: 0.08em;
            margin-left: 4px;
        }

        .hero {
            text-align: center;
            padding: 60px 0 40px;
        }
        .hero h1 {
            font-size: 42px;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }
        .hero h1 .highlight {
            background: linear-gradient(135deg, var(--plus), var(--zero));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero p {
            font-size: 18px;
            color: var(--text-dim);
            max-width: 640px;
            margin: 16px auto 28px;
        }

        .badge-group {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px 24px;
            margin-bottom: 30px;
        }
        .badge {
            font-family: var(--mono);
            font-size: 13px;
            color: var(--text-dim);
            background: var(--panel-hi);
            padding: 4px 14px;
            border-radius: 40px;
            border: 1px solid var(--line);
        }
        .badge strong { color: var(--text); }

        .btn {
            display: inline-block;
            background: var(--zero);
            color: #0B1410;
            font-weight: 600;
            padding: 12px 32px;
            border-radius: 40px;
            font-size: 16px;
            border: none;
            cursor: pointer;
            transition: opacity .2s, transform .1s;
        }
        .btn:hover { opacity: 0.85; text-decoration: none; }
        .btn:active { transform: scale(0.96); }

        .btn-outline {
            background: transparent;
            color: var(--text);
            border: 1px solid var(--line);
        }
        .btn-outline:hover { background: var(--panel-hi); }

        .section {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 1px solid var(--line);
        }
        .section h2 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .section h2 .badge-count {
            font-size: 14px;
            font-weight: 400;
            color: var(--text-dim);
            font-family: var(--mono);
            margin-left: 10px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }
        .card {
            background: var(--panel);
            border: 1px solid var(--line);
            padding: 20px 22px;
            border-radius: 14px;
            transition: border-color .2s;
        }
        .card:hover { border-color: var(--zero); }
        .card .icon { font-size: 24px; margin-bottom: 6px; }
        .card h3 { font-size: 17px; margin-bottom: 4px; }
        .card p { font-size: 14px; color: var(--text-dim); }

        .card .tag {
            display: inline-block;
            font-family: var(--mono);
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 20px;
            background: var(--panel-hi);
            border: 1px solid var(--line);
            color: var(--text-dim);
            margin-top: 6px;
        }

        .patent-list {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 12px;
        }
        .patent-item {
            background: var(--panel-hi);
            border: 1px solid var(--line);
            padding: 6px 16px;
            border-radius: 40px;
            font-family: var(--mono);
            font-size: 13px;
            color: var(--text-dim);
        }
        .patent-item strong { color: var(--text); }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px 40px;
            margin-top: 40px;
            padding-top: 30px;
            border-top: 1px solid var(--line);
            font-size: 14px;
            color: var(--text-dim);
        }
        .footer-links a { color: var(--text-dim); }
        .footer-links a:hover { color: var(--text); }

        .video-placeholder {
            background: var(--panel-hi);
            border: 2px dashed var(--line);
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            color: var(--text-dim);
            font-size: 15px;
            margin: 16px 0;
        }
        .video-placeholder strong { color: var(--text); }

        @media (max-width: 600px) {
            .hero h1 { font-size: 28px; }
            .hero p { font-size: 16px; }
            .badge-group { gap: 8px; }
            .btn { padding: 10px 24px; font-size: 14px; }
        }
    </style>
</head>
