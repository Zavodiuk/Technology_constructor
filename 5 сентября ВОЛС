class LongHaulFiberTransport:
    """Моделирование прохождения оптического сигнала через протяженную волоконную линию (ВОЛС)."""
    
    LEVEL_MAP = {-2: 0.1, -1: 0.3, 0: 0.5, 1: 0.7, 2: 0.9}
    INV_MAP = {0.1: -2, 0.3: -1, 0.5: 0, 0.7: 1, 0.9: 2}

    @staticmethod
    def modulate_optical(data_bytes: bytes) -> List[float]:
        levels = []
        for b in data_bytes:
            val = int((b / 51.0) - 2)
            val = max(-2, min(2, val))
            levels.append(LongHaulFiberTransport.LEVEL_MAP[val])
        return levels

    @staticmethod
    def propagate_fiber(signal_levels: List[float], distance_km: float = 100.0, cd_coeff: float = 0.02) -> List[float]:
        """Симуляция хроматической дисперсии (CD) и фазовых нелинейностей Керра (SPM) на дистанции."""
        propagated = []
        n = len(signal_levels)
        for i, amp in enumerate(signal_levels):
            # Хроматическая дисперсия (межсимвольная интерференция от соседей)
            neighbor_effect = 0.0
            if i > 0: neighbor_effect += signal_levels[i-1] * 0.05
            if i < n - 1: neighbor_effect += signal_levels[i+1] * 0.05
            
            # Нелинейный фазовый набег Керра (SPM) пропорционален мощности и длине волокна
            kerr_shift = (amp ** 2) * cd_coeff * (distance_km / 50.0)
            
            distorted = amp + neighbor_effect * (distance_km * 0.001) + kerr_shift
            propagated.append(max(0.05, min(0.95, distorted)))
        return propagated

    @staticmethod
    def demodulate_optical(signal_levels: List[float]) -> bytes:
        out_bytes = bytearray()
        standard_levels = list(LongHaulFiberTransport.INV_MAP.keys())
        for amp in signal_levels:
            closest = min(standard_levels, key=lambda l: abs(l - amp))
            val = LongHaulFiberTransport.INV_MAP[closest]
            out_bytes.append(int((val + 2) * 51) & 0xFF)
        return bytes(out_bytes)


