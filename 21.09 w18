# МОДУЛЬ 2: МИКРО-ГРАФ С ПОРОГОВЫМИ БАРЬЕРАМИ ( : )
# ============================================================================
class TernaryNode:
    def __init__(self, node_id):
        self.node_id = node_id
        self.internal_state = np.int8(0)
        self.mass = 0.0
        self.decision = np.int8(0)

    def process_signals(self, signal_A: int, signal_B: int) -> np.int8:
        a = ternary_clip(signal_A)
        b = ternary_clip(signal_B)

        sum_signals = int(a) + int(b)
        conflict = abs(int(a) - int(b))
        
        # `:` — пороговое разделение состояний
        if conflict >= 2:
            informational_mass = conflict * 2.0
            self.internal_state = np.int8(0)
        else:
            informational_mass = conflict * 0.5
            self.internal_state = ternary_clip(sum_signals)
            
        self.mass = informational_mass
        self.decision = self.internal_state
        return self.decision


class TernaryEdge:
    def __init__(self, source: TernaryNode, target: TernaryNode):
        self.source = source
        self.target = target
        self.energy_flow = 1.0
        self.temp = 1.0
        self.rhythm = 0.0  # Индикатор термодинамического биения сети

    def update_dynamics(self):
        decision_sum = int(self.source.decision) + int(self.target.decision)
        total_mass = self.source.mass + self.target.mass
        old_temp = self.temp
        base_modifier = 1.0 + (decision_sum * 0.2) - (total_mass * 0.15)
        self.temp = max(0.05, base_modifier)
        
        # Возвращение термодинамического биения сердца сети (rhythm)
        self.rhythm = self.temp - old_temp
        
        if self.source.decision == -1 or self.target.decision == -1:
            self.energy_flow = 0.0
        else:
            self.energy_flow = (self.temp * 1.2) + (total_mass * 0.4)


class TernaryUniverseGraph:
    def __init__(self):
        self.nodes = {}  # {} — ассоциативная память узлов
        self.edges = []
        self.time_step = 0

    def add_node(self, name):
        self.nodes[name] = TernaryNode(name)

    def add_edge(self, src, tgt):
        self.edges.append(TernaryEdge(self.nodes[src], self.nodes[tgt]))

    def pulse(self):
        self.time_step += 1
        for name, node in self.nodes.items():
            connected_signals = []
            for edge in self.edges:
                if edge.target == node:
                    norm_val = (edge.energy_flow - 1.0) / 1.0
                    connected_signals.append(quantize_ternary(norm_val))
                elif edge.source == node:
                    connected_signals.append(quantize_ternary(edge.energy_flow / 2.0 - 0.5))
            
            if not connected_signals:
                connected_signals = [np.int8(random.choice([-1, 0, 1]))]
            
            node.process_signals(int(connected_signals[0]), int(connected_signals[-1]))
            
        for edge in self.edges:
            edge.update_dynamics()


