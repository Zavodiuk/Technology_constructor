# ИНФРАСТРУКТУРНЫЙ СЛОЙ: ДАТА-ЦЕНТР (ЦОД) И ТРАНСПОРТ ВОЛС
# ---------------------------------------------------------------------------
class DataCenterNode:
    """
    Магистральный Дата-Центр (ЦОД).
    Обеспечивает прием потоков через ВОЛС, валидацию BXOS-квитанций,
    централизованное логирование и маршрутизацию данных к целевому узлу.
    Автор: Владимир Заводюк
    """
    def __init__(self, dc_id: str = "DC-MOSCOW-CORE-01"):
        self.dc_id = dc_id
        self.transit_log: List[Dict[str, Any]] = []
        os.makedirs("./dc_storage_buffer", exist_ok=True)

    def process_incoming_transmission(self, record_id: str, payload_bytes: bytes,
                                      checksum: str, destination_node: str) -> Dict[str, Any]:
        print(f"  [ЦОД '{self.dc_id}'] Пакет '{record_id}' принят через оптический магистральный шлюз.")

        current_hash = hashlib.sha256(payload_bytes).hexdigest()
        if current_hash != checksum:
            raise ValueError(f"[-] КРИТИЧЕСКАЯ ОШИБКА В ЦОДЕ: Несоответствие BXOS-хэша для {record_id}!")

        print(f"  [ЦОД '{self.dc_id}'] Валидация хэша успешна. Регистрация в шлюзе маршрутизации...")

        buffer_path = os.path.join("./dc_storage_buffer", f"{record_id}_transit.bin")
        with open(buffer_path, "wb") as f:
            f.write(payload_bytes)

        transit_record = {
            "dc_id": self.dc_id,
            "record_id": record_id,
            "transit_timestamp_ns": time.time_ns(),
            "payload_size": len(payload_bytes),
            "bxos_checksum": checksum,
            "status": "ROUTED_AND_DELIVERED",
            "destination": destination_node
        }
        self.transit_log.append(transit_record)

        print(f"  [ЦОД '{self.dc_id}'] Пакет успешно перенаправлен на узел назначения: '{destination_node}'.")
        return transit_record


class OpticalTransportLayerV23:
    """Моделирование ВОЛС с прохождением через магистральный узел Дата-Центра."""
    def __init__(self, data_center: DataCenterNode):
        self.dc = data_center

    def transmit_via_dc(self, record_id: str, payload: bytes, checksum: str,
                        destination: str, distance_km: float = 300.0):
        print(f"  [ВОЛС] Передача потока на расстояние {distance_km} км в Дата-Центр '{self.dc.dc_id}'...")
        return self.dc.process_incoming_transmission(record_id, payload, checksum, destination)


# ---------------------------------------------------------------------------
# ЭТАПЫ 1 & 2: ПРИЕМ И КОНВЕРТАЦИЯ В УНИВЕРСАЛЬНЫЙ ФОРМАТ ХРАНЕНИЯ
# ---------------------------------------------------------------------------
@dataclass
class UniversalSemanticRecord:
    record_id: str
    data_type: str
    schema_version: int
    ontology_vector: List[int]
    compressed_payload: bytes
    original_size: int
    bxos_checksum: str
    timestamp_ns: int

    @classmethod
    def convert_and_pack(cls, record_id: str, raw_data: Any,
                         ontology_vector: List[int] = None) -> "UniversalSemanticRecord":
        """Этап 1 и 2: Прием и полиморфная упаковка."""
        if isinstance(raw_data, str):
            data_type = "text"
            payload_bytes = raw_data.encode("utf-8")
        elif isinstance(raw_data, (dict, list)):
            data_type = "json"
            payload_bytes = json.dumps(raw_data, ensure_ascii=False).encode("utf-8")
        elif isinstance(raw_data, np.ndarray):
            data_type = "tensor_np"
            header = {"shape": raw_data.shape, "dtype": str(raw_data.dtype)}
            header_bytes = json.dumps(header).encode("utf-8")
            payload_bytes = len(header_bytes).to_bytes(4, byteorder="big") + header_bytes + raw_data.tobytes()
        else:
            data_type = "text"
            payload_bytes = str(raw_data).encode("utf-8")

        original_size = len(payload_bytes)
        compressed = zlib.compress(payload_bytes, level=9)
        checksum = hashlib.sha256(compressed).hexdigest()

        return cls(
            record_id=record_id,
            data_type=data_type,
            schema_version=1,
            ontology_vector=ontology_vector or [0, 0, 0, 0, 0],
            compressed_payload=compressed,
            original_size=original_size,
            bxos_checksum=checksum,
            timestamp_ns=time.time_ns()
        )

    def unpack_payload(self) -> Any:
        """Этап 4: Распаковка по требованию."""
        current_checksum = hashlib.sha256(self.compressed_payload).hexdigest()
        if current_checksum != self.bxos_checksum:
            raise ValueError(f"[-] Нарушение целостности записи {self.record_id}!")

        raw_bytes = zlib.decompress(self.compressed_payload)
        if self.data_type == "text":
            return raw_bytes.decode("utf-8")
        elif self.data_type == "json":
            return json.loads(raw_bytes.decode("utf-8"))
        elif self.data_type == "tensor_np":
            header_len = int.from_bytes(raw_bytes[:4], byteorder="big")
            header = json.loads(raw_bytes[4:4 + header_len].decode("utf-8"))
            array_bytes = raw_bytes[4 + header_len:]
            return np.frombuffer(array_bytes, dtype=header["dtype"]).reshape(header["shape"])
        return raw_bytes


# ---------------------------------------------------------------------------
# РЕКУРСИВНЫЙ КУБ (ГЛУБИНА 3) — СВЕРХПЛОТНЫЙ СЛОЙ ХРАНЕНИЯ
# С ИНТЕГРИРОВАННЫМИ МАТЕМАТИЧЕСКИМИ ТРАНСЛЯТОРАМИ И O(1) ДОСТУПОМ
# Автор: Владимир Заводюк
# ---------------------------------------------------------------------------
class RecursiveCube:
    """
    Рекурсивный пентарный куб 5×5×5.
    Глубина 3 → ёмкость 5⁹ = 1 953 125 листьев.
    Используется как основной высокоплотный слой в гибридном хранилище.
    """

    def __init__(self, side: int = 5, depth: int = 3):
        if side < 1:
            raise ValueError("side должен быть >= 1")
        if depth < 1:
            raise ValueError("depth должен быть >= 1")

        self.side = side
        self.depth = depth
        self.capacity = side ** (3 * depth)
        self._lock = threading.Lock()

        if depth == 1:
            self.volume = np.full((side, side, side), None, dtype=object)
            self.is_leaf = True
        else:
            self.volume = np.empty((side, side, side), dtype=object)
            for x in range(side):
                for y in range(side):
                    for z in range(side):
                        self.volume[x, y, z] = RecursiveCube(side=side, depth=depth - 1)
            self.is_leaf = False

    def calculate_path_from_position(self, position: int) -> list:
        """
        Математический транслятор сквозной позиции в 3D-координаты.
        Для глубины 3 возвращает список из 3 кортежей: [(x1,y1,z1), (x2,y2,z2), (x3,y3,z3)]
        """
        if not (0 <= position < self.capacity):
            raise ValueError(f"Позиция {position} выходит за пределы емкости куба (0 - {self.capacity - 1})")

        path = []
        current_pos = position
        
        for level in range(self.depth):
            block_volume = self.side ** 3
            idx_in_level = current_pos % block_volume
            
            z = idx_in_level % self.side
            tmp = idx_in_level // self.side
            y = tmp % self.side
            x = tmp // self.side
            
            path.insert(0, (x, y, z))
            current_pos = current_pos // block_volume
            
        return path

    def pack_at_path(self, path: list, data: Any, current_level: int = 0) -> None:
        """
        Точечная запись объекта по координатному пути за O(1).
        path: список кортежей [(x1,y1,z1), (x2,y2,z2), ...]
        """
        x, y, z = path[current_level]
        
        if self.is_leaf or current_level == self.depth - 1:
            self.volume[x, y, z] = data
            return
            
        child: RecursiveCube = self.volume[x, y, z]
        child.pack_at_path(path, data, current_level + 1)

    def fetch_at_path(self, path: list, current_level: int = 0) -> Any:
        """
        Мгновенное извлечение объекта по координатному пути за O(1).
        """
        x, y, z = path[current_level]
        
        if self.is_leaf or current_level == self.depth - 1:
            return self.volume[x, y, z]
            
        child: RecursiveCube = self.volume[x, y, z]
        return child.fetch_at_path(path, current_level + 1)

    def pack_one(self, item: Any) -> Optional[List[Tuple[int, int, int]]]:
        """
        Упаковывает ОДИН элемент последовательно.
        """
        with self._lock:
            position = self._count_filled()
            if position >= self.capacity:
                return None
            path = self.calculate_path_from_position(position)
            self.pack_at_path(path, item)
            return path

    def get_by_path(self, path: List[Tuple[int, int, int]]) -> Any:
        """Достаёт объект по заранее сохранённому пути координат. O(depth) ≈ O(1)."""
        return self.fetch_at_path(path)

    def _count_filled(self) -> int:
        if self.is_leaf:
            return int(np.count_nonzero(self.volume != None))
        total = 0
        for x in range(self.side):
            for y in range(self.side):
                for z in range(self.side):
                    total += self.volume[x, y, z]._count_filled()
        return total

    def density(self) -> float:
        return self._count_filled() / self.capacity

    def summary(self) -> str:
        return (f"RecursiveCube side={self.side} depth={self.depth} | "
                f"ёмкость={self.capacity:,} | заполнено={self._count_filled():,} "
                f"({self.density():.2%})")


