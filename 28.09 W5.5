    class ComputeAndTransmitRequest(BaseModel):
        interpretations_scores: List[List[float]]
        l5_values_list: List[List[int]]
        distance_km: float = 150.0
        stress_level: float = 0.55

    class OpticalReceiverPayload(BaseModel):
        compressed_payload_b64: str = Field(..., description="Сжатые zlib-данные в кодировке Base64")
        original_size_bytes: int

    @app.get("/")
    def node_status():
        return {
            "author": "Vladimir Zavodiuk",
            "rights": "All rights reserved",
            "project": "W5.5-ADAPTIVE-ULTIMATE-MONOLITH",
