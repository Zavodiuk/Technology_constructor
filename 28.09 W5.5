                "compute-linear-batch",
                "compute-and-transmit-optical",
                "receive-and-decode-optical"
            ],
            "telemetry": node_pipeline.gate.summary()
        }

    @app.post("/compute-linear-batch")
    def compute_linear_batch(payload: NodePayload):
        try:
            return node_pipeline.run(payload.interpretations_scores, payload.l5_values_list, current_stress=payload.stress_level)
        except Exception as e:
            raise HTTPException(status_code=400, detail=str(e))

    @app.post("/compute-and-transmit-optical")
    async def compute_and_transmit_optical(req: ComputeAndTransmitRequest):
        try:
            compute_result = node_pipeline.run(req.interpretations_scores, req.l5_values_list, current_stress=req.stress_level)
        except Exception as e:
            raise HTTPException(status_code=400, detail=f"Compute error: {e}")

        raw_json = json.dumps(compute_result, ensure_ascii=False).encode("utf-8")
        compressed_payload = zlib.compress(raw_json, level=9)
        
        orig_size = len(raw_json)
        comp_size = len(compressed_payload)
        compression_ratio = round(orig_size / comp_size, 2) if comp_size > 0 else 1.0

        optical_result = optical_transport.transmit(
            payload=compressed_payload,
            distance_km=req.distance_km
        )

        transmitted_b64 = base64.b64encode(optical_result.recovered_payload).decode("utf-8")

        return {
            "transmission_meta": {
                "success": optical_result.success,
                "message": optical_result.message,
                "distance_km": optical_result.distance_km,
                "optimization_ratio": compression_ratio
            },
            "transport_payload": {
                "compressed_payload_b64": transmitted_b64,
                "original_size_bytes": orig_size
            }
        }

    @app.post("/receive-and-decode-optical")
    async def receive_and_decode_optical(payload: OpticalReceiverPayload):
        try:
            compressed_bytes = base64.b64decode(payload.compressed_payload_b64)
            raw_json_bytes = safe_zlib_decompress(compressed_bytes, max_mb=50)
            
            decompressed_size = len(raw_json_bytes)
            return restored_data_triage(
                raw_json_bytes, 
                payload.original_size_bytes, 
                decompressed_size
            )
        except (zlib.error, ValueError) as ze:
            raise HTTPException(status_code=422, detail=f"Ошибка декомпрессии или защиты ВОЛС: {ze}")
        except Exception as e:
            raise HTTPException(status_code=400, detail=f"Критический сбой декодера: {e}")


