class ConsoleV8:
    """
    Консоль для работы с V8
    Поддерживает все команды для управления GameEngine
    """

    def __init__(self, engine: Optional[GameEngine] = None):
        self.engine = engine or GameEngine(LogicType.TERNARY)
        self.running = True

        print("\n🧠 V8 CONSOLE ACTIVE")
        print("   Интегральная архитектура")
        print("   Поддерживает: binary, ternary, pentary")
        print("=" * 60)

    def _render(self):
        print("\n" + "=" * 60)
        print("🧠 ROOT-ARCHITECT V8 — ИНТЕГРАЛЬНАЯ АРХИТЕКТУРА")
        print("=" * 60)

        if self.engine.current_state:
            state = self.engine.current_state
            print(f"\n📊 ТЕКУЩЕЕ СОСТОЯНИЕ:")
            print(f"  Тип: {state.logic_type.value}")
            print(f"  Значение: {state.value}")
            print(f"  Уверенность: {state.confidence*100:.1f}%")
            print(f"  Время: {time.ctime(state.timestamp)}")
        else:
            print("\n⚠️ Состояние не установлено")

        print(f"\n📈 ИСТОРИЯ: {len(self.engine.history)} блоков")
        print(f"📐 УРАВНЕНИЙ: {len(self.engine.equations)}")
        print(f"📋 ПРАВИЛ ПЕРЕХОДОВ: {len(self.engine.transition_rules)}")

        print("\n" + "-" * 60)
        print("КОМАНДЫ:")
        print("  state <value> [confidence] - установить состояние")
        print("  transition <value> [confidence] - переход")
        print("  graph - показать граф")
        print("  analyze - анализ состояния")
        print("  equation <name> <formula> - добавить уравнение")
        print("  rule <from> <to> - добавить правило перехода")
        print("  info - полная информация")
        print("  clear - очистить историю")
        print("  exit - выход")
        print("=" * 60)

    def _set_state(self, args: List[str]):
        """Установить состояние"""
        if not args:
            print("❌ Укажите значение")
            return

        try:
            value = int(args[0])
            confidence = float(args[1]) if len(args) > 1 else 0.5
            self.engine.set_state(value, confidence)
            print(f"✅ Состояние установлено: {value} (conf={confidence:.2f})")
        except ValueError:
            print("❌ Некорректное значение")

    def _transition(self, args: List[str]):
        """Переход"""
        if not args:
            print("❌ Укажите значение")
            return

        try:
            value = int(args[0])
            confidence = float(args[1]) if len(args) > 1 else 0.5
            self.engine.transition(value, confidence)
            print(f"✅ Переход выполнен: {value} (conf={confidence:.2f})")
        except ValueError:
            print("❌ Некорректное значение")

    def _graph(self):
        """Показать граф"""
        graph = self.engine.get_graph()
        print("\n📊 ГРАФ СОСТОЯНИЙ:")
        print(f"  Узлов: {len(graph['nodes'])}")
        print(f"  Рёбер: {len(graph['edges'])}")
        if graph['current']:
            print(f"  Текущее состояние: {graph['current']['value']}")

        # Показать последние 5 узлов
        print("\n  Последние состояния:")
        for node in graph['nodes'][-5:]:
            print(f"    {node['label']}: {node['value']} (conf={node['confidence']:.2f})")

    def _analyze(self):
        """Анализ"""
        analysis = self.engine.analyze()
        print("\n📊 АНАЛИЗ СОСТОЯНИЯ:")
        print(json.dumps(analysis, indent=2, ensure_ascii=False))

    def _equation(self, args: List[str]):
        """Добавить уравнение"""
        if len(args) < 2:
            print("❌ Использование: equation <name> <formula>")
            return

        name = args[0]
        formula = " ".join(args[1:])
        self.engine.add_equation(name, formula, {'weight': 1.0, 'bias': 0.0})
        print(f"✅ Уравнение добавлено: {name}")

    def _rule(self, args: List[str]):
        """Добавить правило перехода"""
        if len(args) < 2:
            print("❌ Использование: rule <from> <to>")
            return

        try:
            from_val = int(args[0])
            to_val = int(args[1])
            self.engine.add_transition_rule(from_val, to_val)
            print(f"✅ Правило добавлено: {from_val} → {to_val}")
        except ValueError:
            print("❌ Некорректные значения")

    def _info(self):
        """Полная информация"""
        state = self.engine.get_state()
        print("\n📊 ПОЛНАЯ ИНФОРМАЦИЯ:")
        print(json.dumps(state, indent=2, ensure_ascii=False))

    def _clear(self):
        """Очистить историю"""
        self.engine.history.clear()
        print("✅ История очищена")

    def run(self):
        """Главный цикл консоли"""
        while self.running:
            self._render()

            cmd = input("\n➜ ").strip().split()
            if not cmd:
                continue

            action = cmd[0].lower()

            if action == "exit":
                self.running = False
                print("👋 Выход из V8 Console")
            elif action == "state":
                self._set_state(cmd[1:])
            elif action == "transition":
                self._transition(cmd[1:])
            elif action == "graph":
                self._graph()
            elif action == "analyze":
                self._analyze()
            elif action == "equation":
                self._equation(cmd[1:])
            elif action == "rule":
                self._rule(cmd[1:])
            elif action == "info":
                self._info()
            elif action == "clear":
                self._clear()
            else:
                print(f"❌ Неизвестная команда: {action}")

            input("\nНажмите Enter для продолжения...")


