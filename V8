class V8System:
    """
    Интегральная система V8
    Объединяет GameEngine, графы, уравнения и консоль
    """

    def __init__(self, logic_type: str = "ternary"):
        logic_map = {
            'binary': LogicType.BINARY,
            'ternary': LogicType.TERNARY,
            'pentary': LogicType.PENTARY
        }
        self.logic_type = logic_map.get(logic_type, LogicType.TERNARY)
        self.engine = GameEngine(self.logic_type)
        self.console = ConsoleV8(self.engine)

        self._log(f"V8 System инициализирована (logic={logic_type})")

    def _log(self, msg: str):
        print(f"[V8] {msg}")

    def run(self):
        """Запуск V8 системы"""
        self._log("Запуск V8...")
        self.console.run()

    def get_state(self) -> Dict:
        """Полное состояние системы"""
        return {
            'version': 'V8',
            'logic_type': self.logic_type.value,
            'engine': self.engine.get_state(),
            'timestamp': time.time()
        }


