# 1. УНИВЕРСАЛЬНЫЕ ТИПЫ (ПОДДЕРЖКА V5–V7)
# ============================================================

class LogicType(Enum):
    """Тип логики, используемый в системе"""
    BINARY = "binary"      # V5
    TERNARY = "ternary"    # V6
    PENTARY = "pentary"    # V7

class UniversalState:
    """
    Универсальное состояние, работающее с любым типом логики
    """
    def __init__(self, logic_type: LogicType, value: Union[int, float],
                 confidence: float = 0.5):
        self.logic_type = logic_type
        self.value = value
        self.confidence = min(max(confidence, 0.0), 1.0)
        self.timestamp = time.time()

    def to_dict(self) -> Dict:
        return {
            'logic_type': self.logic_type.value,
            'value': self.value,
            'confidence': self.confidence,
            'timestamp': self.timestamp
        }

    def normalize(self) -> float:
        """Нормализовать значение в диапазон [-1, 1]"""
        if self.logic_type == LogicType.BINARY:
            return 1.0 if self.value > 0 else -1.0
        elif self.logic_type == LogicType.TERNARY:
            return float(self.value)  # -1, 0, 1
        else:  # PENTARY
            return self.value / 2.0  # -1..1

    def __repr__(self):
        return f"UniversalState({self.logic_type.value}, {self.value}, {self.confidence:.2f})"

# ============================================================
# 2. GAME ENGINE — ДВИЖОК УПРАВЛЕНИЯ СОСТОЯНИЯМИ
# ============================================================

@dataclass
class GameBlock:
    """Блок состояния в GameEngine"""
    index: int
    state: UniversalState
    prev_hash: str
    payload: Dict[str, Any]
    timestamp: float = field(default_factory=time.time)

    @property
    def hash(self) -> str:
        data = f"{self.index}{self.state.to_dict()}{self.prev_hash}{json.dumps(self.payload)}{self.timestamp}"
        return hashlib.sha256(data.encode()).hexdigest()

    def to_dict(self) -> Dict:
        return {
            'index': self.index,
            'state': self.state.to_dict(),
            'prev_hash': self.prev_hash[:16] + '...' if len(self.prev_hash) > 16 else self.prev_hash,
            'payload': self.payload,
            'timestamp': self.timestamp,
            'hash': self.hash[:16] + '...'
        }

class GameEngine:
    """
    Движок управления состояниями V8
    Управляет переходами, историей, графами и уравнениями
    """

    def __init__(self, logic_type: LogicType = LogicType.TERNARY):
        self.logic_type = logic_type
        self.current_state: Optional[UniversalState] = None
        self.history: List[GameBlock] = []
        self.equations: Dict[str, Any] = {}
        self.transition_rules: List[Dict] = []

        self._log(f"GameEngine инициализирован (logic={logic_type.value})")

    def _log(self, msg: str):
        print(f"[GameEngine] {msg}")

    # ---- УПРАВЛЕНИЕ СОСТОЯНИЕМ ----

    def set_state(self, value: Union[int, float], confidence: float = 0.5,
                  payload: Dict[str, Any] = None) -> UniversalState:
        """Установить текущее состояние"""
        state = UniversalState(self.logic_type, value, confidence)
        self.current_state = state

        # Сохраняем в историю
        block = GameBlock(
            index=len(self.history),
            state=state,
            prev_hash=self.history[-1].hash if self.history else 'GENESIS',
            payload=payload or {'type': 'state_set'}
        )
        self.history.append(block)

        self._log(f"Состояние установлено: {value} (conf={confidence:.2f})")
        return state

    def transition(self, new_value: Union[int, float], confidence: float = 0.5,
                   payload: Dict[str, Any] = None) -> UniversalState:
        """Переход в новое состояние"""
        return self.set_state(new_value, confidence, payload)

    # ---- ГРАФЫ ----

    def get_graph(self) -> Dict:
        """Построить граф состояний"""
        nodes = []
        edges = []

        for i, block in enumerate(self.history):
            nodes.append({
                'id': i,
                'label': f"S{i}",
                'value': block.state.value,
                'confidence': block.state.confidence,
                'logic_type': block.state.logic_type.value,
                'timestamp': block.timestamp
            })
            if i > 0:
                edges.append({
                    'from': i - 1,
                    'to': i,
                    'label': '→',
                    'confidence': block.state.confidence
                })

        return {
            'nodes': nodes,
            'edges': edges,
            'current': self.current_state.to_dict() if self.current_state else None,
            'total_blocks': len(self.history)
        }

    # ---- УРАВНЕНИЯ СОСТОЯНИЙ ----

    def add_equation(self, name: str, formula: str, variables: Dict[str, float]):
        """Добавить уравнение состояния"""
        self.equations[name] = {
            'formula': formula,
            'variables': variables,
            'timestamp': time.time()
        }

    def solve_equation(self, name: str) -> Optional[float]:
        """Решить уравнение состояния"""
        if name not in self.equations:
            return None

        eq = self.equations[name]
        # Упрощённое решение — подставляем текущее состояние
        if self.current_state:
            # Пример: формула "state * weight + bias"
            try:
                result = self.current_state.normalize()
                for var, val in eq['variables'].items():
                    if var == 'weight':
                        result *= val
                    elif var == 'bias':
                        result += val
                return min(max(result, -1.0), 1.0)
            except:
                return None
        return None

    def get_equations(self) -> Dict:
        """Получить все уравнения"""
        return self.equations

    # ---- ПЕРЕХОДЫ ----

    def add_transition_rule(self, from_state: Union[int, float],
                           to_state: Union[int, float],
                           condition: str = "always"):
        """Добавить правило перехода"""
        self.transition_rules.append({
            'from': from_state,
            'to': to_state,
            'condition': condition,
            'timestamp': time.time()
        })

    def get_transition_rules(self) -> List[Dict]:
        return self.transition_rules

    # ---- АНАЛИЗ ----

    def analyze(self) -> Dict:
        """Анализ текущего состояния"""
        if self.current_state is None:
            return {'error': 'Состояние не установлено'}

        # Стабильность
        stability = self.current_state.confidence

        # Тренд (изменение относительно предыдущего)
        trend = 0
        if len(self.history) >= 2:
            prev = self.history[-2].state.normalize()
            curr = self.current_state.normalize()
            trend = curr - prev

        return {
            'current': self.current_state.to_dict(),
            'stability': stability,
            'trend': trend,
            'history_len': len(self.history),
            'logic_type': self.logic_type.value,
            'equations': list(self.equations.keys())
        }

    # ---- УТИЛИТЫ ----

    def get_state(self) -> Dict:
        """Полное состояние GameEngine"""
        return {
            'version': 'V8',
            'logic_type': self.logic_type.value,
            'current_state': self.current_state.to_dict() if self.current_state else None,
            'history_len': len(self.history),
            'equations_count': len(self.equations),
            'transition_rules_count': len(self.transition_rules),
            'timestamp': time.time()
        }

    def to_dict(self) -> Dict:
        return {
            'current': self.current_state.to_dict() if self.current_state else None,
            'history': [b.to_dict() for b in self.history[-10:]],  # последние 10
            'equations': self.equations,
            'rules': self.transition_rules
        }

