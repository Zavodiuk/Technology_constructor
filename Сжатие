// ============================================================================
// БЛОК 1: УНИВЕРСАЛЬНЫЙ ТРОИЧНО-МАТРИЧНЫЙ КОНТУР СЖАТИЯ И РЕКОНСТРУКЦИИ
// ============================================================================

class HarmoniaEngine {

    // Шаг 1: Прямое троичное кодирование потока
    fun compressTernary(rawStream: List<Double>, threshold: Double): List<Int> {
        val compressed = mutableListOf<Int>()
        var baseline = rawStream.firstOrNull() ?: 0.0
        for (value in rawStream) {
            val trit = when {
                value < baseline - threshold -> -1
                value > baseline + threshold -> 1
                else -> 0
            }
            compressed.add(trit)
            baseline = value
        }
        return compressed
    }

    // Шаг 1 (Зеркало): Обратная декомпрессия троичного потока
    fun decompressTernary(compressedTrits: List<Int>, initialBaseline: Double, threshold: Double): List<Double> {
        val reconstructed = mutableListOf<Double>()
        var currentBaseline = initialBaseline
        for (trit in compressedTrits) {
            val restoredVal = when (trit) {
                -1 -> currentBaseline - threshold
                1 -> currentBaseline + threshold
                else -> currentBaseline
            }
            reconstructed.add(restoredVal)
            currentBaseline = restoredVal
        }
        return reconstructed
    }

    // Шаг 3: Матричное сжатие блоков (версии 9-10+)
    fun packMatrixBlock(chunk: List<Double>, dimension: Int): Array<DoubleArray> {
        val matrix = Array(dimension) { DoubleArray(dimension) { 0.0 } }
        var idx = 0
        for (i in 0 until dimension) {
            for (j in 0 until dimension) {
                if (idx < chunk.size) {
                    matrix[i][j] = chunk[idx++]
                }
            }
        }
        return matrix
    }

    // Шаг 3 (Зеркало): Обратная распаковка матричного блока в линейный поток
    fun unpackMatrixBlock(matrix: Array<DoubleArray>): List<Double> {
        val chunk = mutableListOf<Double>()
        for (row in matrix) {
            for (value in row) {
                chunk.add(value)
            }
        }
        return chunk
    }
}

// ============================================================================
// БЛОК 2: МОДУЛЬ ОБРАБОТКИ ИЗОБРАЖЕНИЙ (РАСТР) С РЕКОНСТРУКЦИЕЙ
// ============================================================================

class HarmoniaImageProcessor {

    // Прямое кодирование строк пикселей
    fun compressImageRow(rowPixels: IntArray, threshold: Int): List<Int> {
        val stream = mutableListOf<Int>()
        var baseline = rowPixels.firstOrNull() ?: 0
        for (pixel in rowPixels) {
            val delta = when {
                pixel < baseline - threshold -> -1
                pixel > baseline + threshold -> 1
                else -> 0
            }
            stream.add(delta)
            baseline = pixel
        }
        return stream
    }

    // Зеркало: Полная декомпрессия и восстановление строки изображения без потерь
    fun decompressImageRow(stream: List<Int>, initialBaseline: Int, threshold: Int): IntArray {
        val restored = IntArray(stream.size)
        var currentBaseline = initialBaseline
        for ((index, delta) in stream.withIndex()) {
            val pixelVal = when (delta) {
                -1 -> currentBaseline - threshold
                1 -> currentBaseline + threshold
                else -> currentBaseline
            }
            restored[index] = pixelVal
            currentBaseline = pixelVal
        }
        return restored
    }
}

