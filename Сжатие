class HarmoniaCosmicTransceiver {

    // Прямая радио/космическая модуляция с учетом решимонов
    fun modulateAndTransmit(rawSignal: List<Double>, noiseFloor: Double, radiationRisk: Int): Pair<List<Int>, String> {
        if (radiationRisk > 5) {
            return Pair(emptyList(), "RESHIMON_VETO_COSMIC: Передача заблокирована радиационным порогом")
        }

        val trits = mutableListOf<Int>()
        var baseline = rawSignal.firstOrNull() ?: 0.0
        for (sig in rawSignal) {
            val trit = when {
                sig < baseline - noiseFloor -> -1
                sig > baseline + noiseFloor -> 1
                else -> 0
            }
            trits.add(trit)
            baseline = sig
        }
        return Pair(trits, "RESHIMON_APPROVE_COSMIC: Сигнал успешно сформирован и защищен")
    }

    // Зеркало: Обратная демодуляция и реконструкция радио/космического сигнала на приемнике
    fun receiveAndDemodulate(trits: List<Int>, initialBaseline: Double, noiseFloor: Double): List<Double> {
        val restoredSignal = mutableListOf<Double>()
        var currentBaseline = initialBaseline
        for (trit in trits) {
            val sigVal = when (trit) {
                -1 -> currentBaseline - noiseFloor
                1 -> currentBaseline + noiseFloor
                else -> currentBaseline
            }
            restoredSignal.add(sigVal)
            currentBaseline = sigVal
        }
        return restoredSignal
    }

