class CounterRotatingBiCore120D {
public:
    double angle_a;
    double angle_b;
    double base_velocity;

    CounterRotatingBiCore120D() : angle_a(0.0), angle_b(0.0), base_velocity(M_PI / 6.0) {}

    void update_rotation(double entropy) {
        double dynamic_velocity = base_velocity / (1.0 + entropy * 0.25);
        angle_a += dynamic_velocity;
        angle_b -= dynamic_velocity * 1.5;
        if (angle_a >= 2 * M_PI) angle_a = 0.0;
        if (angle_b <= -2 * M_PI) angle_b = 0.0;
    }
};

// ============================================================================
// 6. 4D-ГИПЕРТЕНЗОРНОЕ ПОЛЕ ПАМЯТИ {2, 3, 4, 5} = 120 С ВЫРАВНИВАНИЕМ
// ============================================================================
class alignas(64) DesktopTensorMemoryField120D {
private:
    std::array<int, 4> dims_;                  // Строго {2, 3, 4, 5} = 120 ячеек
    std::array<int8_t, DIM_120> field_;          // Плотный массив ровно на 120 элементов
    std::array<double, DIM_120> exciter_120d_;   // 120-мерный эксайдер состояния

public:
    DesktopTensorMemoryField120D() : dims_{2, 3, 4, 5} {
        field_.fill(0);
        exciter_120d_.fill(0.0);
    }

    inline size_t get_index(int w, int x, int y, int z) const {
        int cw = (w < 0) ? 0 : ((w > 1) ? 1 : w);
        int cx = (x < 0) ? 0 : ((x > 2) ? 2 : x);
        int cy = (y < 0) ? 0 : ((y > 3) ? 3 : y);
        int cz = (z < 0) ? 0 : ((z > 4) ? 4 : z);
        return static_cast<size_t>(cw * 60 + cx * 20 + cy * 5 + cz);
    }

    void ingest_multimodal_stream(std::span<const uint8_t> raw_bytes, double angle_a, double angle_b) {
        size_t n_bytes = raw_bytes.size();
        if (n_bytes == 0) return;

        double cos_a = std::cos(angle_a);
        double sin_a = std::sin(angle_a);
        double cos_b = std::cos(angle_b);
        double sin_b = std::sin(angle_b);

        for (int i = 0; i < DIM_120; ++i) {
            double b_val = static_cast<double>(raw_bytes[i % n_bytes]);
            double val = std::fmod(b_val, 5.0) - 2.0;
            int clipped = static_cast<int>(std::clamp(std::round(val), -2.0, 2.0));

            field_[i] = static_cast<int8_t>(clipped);

            double phase = static_cast<double>(i) * (2.0 * M_PI / DIM_120);
            double fx = (i - DIM_120 / 2) * cos_a - (i - DIM_120 / 2) * sin_a;
            double fy = (i - DIM_120 / 2) * sin_b + (i - DIM_120 / 2) * cos_b;
            double moire = std::sin(fx * 0.1 + fy * 0.1 + angle_a - angle_b);

            double leg3 = static_cast<double>((i % 3) + 1) * 3.0;
            double leg4 = static_cast<double>(clipped + 3) * 4.0;
            double pyth_factor = ZvdNativeEdgeCodec::compute_pythagorean_lock(leg3, leg4);

            exciter_120d_[i] = std::sin(phase) * static_cast<double>(clipped) * pyth_factor * (1.0 + 0.5 * moire);
        }
    }

    void inject_impulse(int w, int x, int y, int z, int value, double angle_a, double angle_b) {
        int clipped = std::max(-2, std::min(2, value));
        size_t idx = get_index(w, x, y, z);
        field_[idx] = static_cast<int8_t>(clipped);

        double leg3 = static_cast<double>(w + x + y + z + 1) * 3.0;
        double leg4 = static_cast<double>(clipped + 3) * 4.0;
        double pyth_factor = ZvdNativeEdgeCodec::compute_pythagorean_lock(leg3, leg4);

        double cos_a = std::cos(angle_a);
        double sin_a = std::sin(angle_a);
        double cos_b = std::cos(angle_b);
        double sin_b = std::sin(angle_b);

        for (int i = 0; i < DIM_120; ++i) {
            double phase = static_cast<double>(i) * (2.0 * M_PI / DIM_120);
            double fx = (i - DIM_120 / 2) * cos_a - (i - DIM_120 / 2) * sin_a;
            double fy = (i - DIM_120 / 2) * sin_b + (i - DIM_120 / 2) * cos_b;
            double moire = std::sin(fx * 0.1 + fy * 0.1 + angle_a - angle_b);

            exciter_120d_[i] = std::sin(phase) * static_cast<double>(clipped) * pyth_factor * (1.0 + 0.5 * moire);
        }
    }

    int8_t get(int w, int x, int y, int z) const {
        return field_[get_index(w, x, y, z)];
    }

    void set(int w, int x, int y, int z, int8_t val) {
        field_[get_index(w, x, y, z)] = val;
    }

    double calculate_entropy() const {
        size_t active_states = 0;
        for (auto val : field_) {
            if (val != 0) active_states++;
        }
        return static_cast<double>(active_states) / static_cast<double>(DIM_120);
    }

    const std::array<int8_t, DIM_120>& data() const { return field_; }
    const std::array<int, 4>& dimensions() const { return dims_; }
    const std::array<double, DIM_120>& get_exciter_120d() const { return exciter_120d_; }
};

class WaveMemoryEvolution120D {
private:
    DesktopTensorMemoryField120D& tensor_memory_;
public:
    WaveMemoryEvolution120D(DesktopTensorMemoryField120D& tm) : tensor_memory_(tm) {}

    void propagate_wave(const std::array<int, 4>& origin, int radius = 1) {
        const auto& dims = tensor_memory_.dimensions();
        int ow = origin[0], ox = origin[1], oy = origin[2], oz = origin[3];
        int orig_val = tensor_memory_.get(ow, ox, oy, oz);

        for (int w = std::max(0, ow - radius); w <= std::min(dims[0] - 1, ow + radius); ++w) {
            for (int x = std::max(0, ox - radius); x <= std::min(dims[1] - 1, ox + radius); ++x) {
                for (int y = std::max(0, oy - radius); y <= std::min(dims[2] - 1, oy + radius); ++y) {
                    for (int z = std::max(0, oz - radius); z <= std::min(dims[3] - 1, oz + radius); ++z) {
                        int dist = std::abs(w - ow) + std::abs(x - ox) + std::abs(y - oy) + std::abs(z - oz);
                        if (dist > 0 && dist <= radius) {
                            double float_val = static_cast<double>(orig_val) / (dist + 1);
                            int impulse = static_cast<int>(std::round(float_val));
                            if (impulse != 0) {
                                int current = tensor_memory_.get(w, x, y, z);
                                int updated = std::max(-2, std::min(2, current + impulse));
                                tensor_memory_.set(w, x, y, z, static_cast<int8_t>(updated));
                            }
                        }
                    }
                }
            }
        }
    }
};

