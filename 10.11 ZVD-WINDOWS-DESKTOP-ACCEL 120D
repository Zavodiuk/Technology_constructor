        size_t c_idx = tensor_field.get_index(cw, cx, cy, cz);
        int local_base = std::abs(tensor_field.data()[c_idx]);
        double grad_base = std::abs(grad_w[c_idx]) + std::abs(grad_x[c_idx]) + std::abs(grad_y[c_idx]) + std::abs(grad_z[c_idx]);
        double max_tension = static_cast<double>(local_base) + grad_base;

        std::array<int, 4> best_coords = coords_;
        const auto& dims = tensor_field.dimensions();

        int dw_arr[8] = {-1, 1, 0, 0, 0, 0, 0, 0};
        int dx_arr[8] = {0, 0, -1, 1, 0, 0, 0, 0};
        int dy_arr[8] = {0, 0, 0, 0, -1, 1, 0, 0};
        int dz_arr[8] = {0, 0, 0, 0, 0, 0, -1, 1};

        for (int i = 0; i < 8; ++i) {
            int nw = cw + dw_arr[i];
            int nx = cx + dx_arr[i];
            int ny = cy + dy_arr[i];
            int nz = cz + dz_arr[i];

            if (nw >= 0 && nw < dims[0] && nx >= 0 && nx < dims[1] && ny >= 0 && ny < dims[2] && nz >= 0 && nz < dims[3]) {
                std::array<int, 4> test_pos = {nw, nx, ny, nz};
                if (forbidden_coords.find(test_pos) != forbidden_coords.end()) {
                    continue;
                }
                size_t t_idx = tensor_field.get_index(nw, nx, ny, nz);
                int local_val = std::abs(tensor_field.data()[t_idx]);
                double grad_val = std::abs(grad_w[t_idx]) + std::abs(grad_x[t_idx]) + std::abs(grad_y[t_idx]) + std::abs(grad_z[t_idx]);
                double tension = static_cast<double>(local_val) + grad_val;

                if (tension > max_tension) {
                    max_tension = tension;
                    best_coords = test_pos;
                }
            }
        }

        last_delta_ = {
            best_coords[0] - coords_[0],
            best_coords[1] - coords_[1],
            best_coords[2] - coords_[2],
            best_coords[3] - coords_[3]
        };
        coords_ = best_coords;
    }

    const std::array<int, 4>& coords() const { return coords_; }
    DeltaCoord4D last_delta() const { return last_delta_; }
};

class DynamicPlaneMembrane120D {
private:
    ConflictAttractorPoint120D vertex_a;
    ConflictAttractorPoint120D vertex_b;
    ConflictAttractorPoint120D vertex_c;

public:
    DynamicPlaneMembrane120D(std::array<int, 4> p1, std::array<int, 4> p2, std::array<int, 4> p3)
        : vertex_a(p1), vertex_b(p2), vertex_c(p3) {}

    void update_membrane_position(const DesktopTensorMemoryField120D& tensor_field,
                                  const std::array<double, DIM_120>& grad_w,
                                  const std::array<double, DIM_120>& grad_x,
                                  const std::array<double, DIM_120>& grad_y,
                                  const std::array<double, DIM_120>& grad_z) {
        std::set<std::array<int, 4>> forbidden_ab = {vertex_b.coords(), vertex_c.coords()};
        vertex_a.drift_by_conflict(tensor_field, grad_w, grad_x, grad_y, grad_z, forbidden_ab);

        std::set<std::array<int, 4>> forbidden_bc = {vertex_a.coords(), vertex_c.coords()};
        vertex_b.drift_by_conflict(tensor_field, grad_w, grad_x, grad_y, grad_z, forbidden_bc);

        std::set<std::array<int, 4>> forbidden_ca = {vertex_a.coords(), vertex_b.coords()};
        vertex_c.drift_by_conflict(tensor_field, grad_w, grad_x, grad_y, grad_z, forbidden_ca);
    }

    MembraneDeltas4D get_membrane_deltas() const {
        return {vertex_a.last_delta(), vertex_b.last_delta(), vertex_c.last_delta()};
    }
};

