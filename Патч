class MiningManager:
    """
    Главный менеджер майнинг-фермы.
    Объединяет все модули.
    """
    
    def __init__(self):
        self.pool_selector = PoolSelector()
        self.load_balancer = LoadBalancer()
        self.predictor = Predictor()
        self.energy_manager = EnergyManager()
        self.pools = []
        self.running = False
    
    def add_pool(self, name: str, data: Dict):
        data['name'] = name
        self.pools.append(data)
    
    def register_asic(self, asic_id: str, capacity: float, power: float):
        self.load_balancer.register_asic(asic_id, capacity, power)
    
    def add_difficulty_record(self, difficulty: float, price: float):
        self.predictor.add_record(difficulty, price)
    
    def run_cycle(self):
        """
        Один цикл управления фермой.
        """
        print("\n" + "=" * 60)
        print("🔄 ЦИКЛ УПРАВЛЕНИЯ ФЕРМОЙ")
        print("=" * 60)
        
        # 1. Выбор пула
        if self.pools:
            best_pool = self.pool_selector.select_best(self.pools)
            print(f"✅ Лучший пул: {best_pool}")
        
        # 2. Балансировка нагрузки
        loads = self.load_balancer.balance()
        print(f"⚡ Распределение нагрузки: {loads}")
        
        # 3. Проверка здоровья
        issues = self.load_balancer.check_health()
        if issues:
            print(f"⚠️ Проблемы: {issues}")
        else:
            print("✅ Все ASIC в норме")
        
        # 4. Прогнозирование
        if len(self.predictor.history) > 0:
            profit = self.predictor.predict_profit(100)  # 100 TH/s
            print(f"📈 Прогноз прибыли (7 дней): ${profit:.2f}")
        
        # 5. Энергоменеджмент
        cost = self.energy_manager.calculate_cost(5000, 24)
        print(f"💡 Затраты на электроэнергию (сутки): ${cost:.2f}")
        
        return {
            'best_pool': best_pool if self.pools else None,
            'loads': loads,
            'issues': issues,
            'profit_forecast': profit if len(self.predictor.history) > 0 else 0,
            'energy_cost': cost
        }

