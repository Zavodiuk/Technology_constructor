class EnergyManager:
    """
    Управляет энергопотреблением фермы.
    Оптимизирует затраты на электричество.
    """
    
    def __init__(self, electricity_cost: float = 0.10):
        """
        electricity_cost: $/кВт·ч
        """
        self.cost = electricity_cost
        self.history = []
    
    def calculate_consumption(self, power: float, hours: float) -> float:
        """
        Рассчитывает потребление в кВт·ч.
        power: Вт
        hours: часы
        """
        return (power * hours) / 1000
    
    def calculate_cost(self, power: float, hours: float) -> float:
        """
        Рассчитывает стоимость электроэнергии.
        """
        consumption = self.calculate_consumption(power, hours)
        return consumption * self.cost
    
    def optimize_power(self, asics: Dict) -> Dict:
        """
        Оптимизирует мощность в зависимости от цены электроэнергии.
        """
        optimized = {}
        for asic_id, data in asics.items():
            # Если цена высокая — снижаем мощность
            if self.cost > 0.15:
                optimized[asic_id] = data['capacity'] * 0.7
            else:
                optimized[asic_id] = data['capacity']
        return optimized

