class PoolSelector:
    """
    Анализирует пулы и выбирает лучший.
    Оценивает: комиссия, задержка, стабильность, история.
    """
    
    def __init__(self):
        self.history = []
    
    def analyze_pool(self, pool_data: Dict) -> float:
        """
        Оценивает пул по нескольким параметрам.
        pool_data: {
            'fee': 0.02,
            'latency': 50,  # мс
            'stability': 0.95,  # 0-1
            'hashrate': 100  # TH/s
        }
        """
        fee_score = 1.0 - pool_data.get('fee', 0.05) * 10
        latency_score = 1.0 - (pool_data.get('latency', 100) / 200)
        stability_score = pool_data.get('stability', 0.9)
        hashrate_score = min(1.0, pool_data.get('hashrate', 0) / 200)
        
        total = (fee_score * 0.3 + latency_score * 0.2 + 
                 stability_score * 0.3 + hashrate_score * 0.2)
        return max(0.0, min(1.0, total))
    
    def select_best(self, pools: List[Dict]) -> str:
        """
        Выбирает лучший пул из списка.
        """
        scores = {}
        for pool in pools:
            name = pool.get('name', 'unknown')
            scores[name] = self.analyze_pool(pool)
            self.history.append({'name': name, 'score': scores[name], 'time': time.time()})
        
        best = max(scores.items(), key=lambda x: x[1])
        return best[0]

