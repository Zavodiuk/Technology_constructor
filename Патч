class LoadBalancer:
    """
    Распределяет нагрузку между ASIC-устройствами.
    Учитывает: мощность, температуру, энергопотребление.
    """
    
    def __init__(self):
        self.asics = {}
    
    def register_asic(self, asic_id: str, capacity: float, power: float):
        """
        Регистрирует ASIC в системе.
        capacity: TH/s
        power: Вт
        """
        self.asics[asic_id] = {
            'capacity': capacity,
            'power': power,
            'load': 0.0,
            'temp': 40.0,
            'status': 'active'
        }
    
    def balance(self) -> Dict[str, float]:
        """
        Распределяет нагрузку пропорционально мощности.
        Возвращает {asic_id: load_percent}
        """
        total_capacity = sum(a['capacity'] for a in self.asics.values())
        if total_capacity == 0:
            return {asic_id: 0.0 for asic_id in self.asics}
        
        result = {}
        for asic_id, data in self.asics.items():
            load = data['capacity'] / total_capacity
            # Ограничиваем нагрузку 90% для безопасности
            load = min(0.9, load)
            result[asic_id] = load
            data['load'] = load
        
        return result
    
    def check_health(self) -> List[str]:
        """
        Проверяет состояние ASIC.
        Возвращает список проблемных.
        """
        issues = []
        for asic_id, data in self.asics.items():
            if data['temp'] > 75:
                issues.append(f"{asic_id}: перегрев ({data['temp']}°C)")
            if data['load'] > 0.95:
                issues.append(f"{asic_id}: перегрузка ({data['load']*100:.0f}%)")
        return issues

