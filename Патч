class Predictor:
    """
    Прогнозирует сложность майнинга и прибыльность.
    Использует простую линейную регрессию на основе истории.
    """
    
    def __init__(self):
        self.history = []
    
    def add_record(self, difficulty: float, price: float):
        self.history.append({
            'difficulty': difficulty,
            'price': price,
            'time': time.time()
        })
        if len(self.history) > 1000:
            self.history.pop(0)
    
    def predict_difficulty(self, days: int = 7) -> float:
        """
        Прогнозирует сложность через N дней.
        """
        if len(self.history) < 10:
            return 1.0
        
        # Простая экстраполяция по последним 10 точкам
        recent = self.history[-10:]
        diffs = [r['difficulty'] for r in recent]
        avg_change = sum(diffs[i] - diffs[i-1] for i in range(1, len(diffs))) / len(diffs)
        future = diffs[-1] + avg_change * days * 2  # ~2 изменения в день
        return max(0.5, future)
    
    def predict_profit(self, hashrate: float, days: int = 7) -> float:
        """
        Прогнозирует прибыль через N дней.
        """
        predicted_difficulty = self.predict_difficulty(days)
        current_price = self.history[-1]['price'] if self.history else 30000
        
        # Простая модель: прибыль ~ hashrate / difficulty
        profit = hashrate / predicted_difficulty * current_price * days * 0.0001
        return profit

