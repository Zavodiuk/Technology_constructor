def quantize(value: float) -> int:
    if value > 0.75: return 2
    elif value > 0.25: return 1
    elif value >= -0.25: return 0
    elif value >= -0.75: return -1
    else: return -2

def consensus(values: list) -> int:
    if not values:
        return 0
    return quantize(sum(values) / len(values))

