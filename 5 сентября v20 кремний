// Строго типизированный пентарный базис кристалла
sealed class PentarnyState(val value: Int, val description: String) {
    object Brigella : PentarnyState(2, "КАТЕГОРИЧЕСКОЕ ДА (Сверхпроводимость / Резонансное ускорение)")
    object Colombina : PentarnyState(1, "МЯГКОЕ ДА (Активация проводимости / Индукционный подъем)")
    object Graziano : PentarnyState(0, "НЕОПРЕДЕЛЕННОСТЬ / ПОКОЙ (Свободный ламинарный транзит)")
    object Piero : PentarnyState(-1, "МЯГКОЕ НЕТ (Демпфирование потока / Энергетическое торможение)")
    object Arlekin : PentarnyState(-2, "КАТЕГОРИЧЕСКОЕ НЕТ (Аппаратный обрыв канала / Сингулярный сток)")

    companion object {
        fun fromInt(v: Int): PentarnyState = when (v) {
            2 -> Brigella
            1 -> Colombina
            0 -> Graziano
            -1 -> Piero
            -2 -> Arlekin
            else -> if (v > 0) Brigella else Arlekin
        }

        fun quantize(raw: Double): PentarnyState = when {
            raw > 0.75 -> Brigella
            raw > 0.25 -> Colombina
            raw >= -0.25 -> Graziano
            raw >= -0.75 -> Piero
            else -> Arlekin
        }
    }
}

// Многомерная макроскопическая тензорная матрица среды
class PentarnyTensorField(val dimensions: IntArray) {
    private val totalSize = dimensions.fold(1) { acc, d -> acc * d }
    val field = IntArray(totalSize)

    private fun coordsToIndex(coords: IntArray): Int {
        var idx = 0
        var mult = 1
        for (i in coords.indices.reversed()) {
            idx += coords[i] * mult
            mult *= dimensions[i]
        }
        return idx
    }

    fun injectImpulse(coords: IntArray, value: Int) {
        val idx = coordsToIndex(coords)
        field[idx] = maxOf(-2, minOf(2, value))
    }

    fun getEntropy(): Double {
        if (totalSize == 0) return 0.0
        val counts = field.toList().groupingBy { it }.eachCount()
        return counts.values.sumOf { count ->
            val p = count.toDouble() / totalSize
            if (p > 0) -p * (ln(p) / ln(2.0)) else 0.0
        }
    }
}

// Микро-узел сетевой физики с поддержкой тетраэдральной изоляции
class PentarNode(val nodeId: String) {
    var internalState: PentarnyState = PentarnyState.Graziano
    var mass: Double = 0.0
    var decision: PentarnyState = PentarnyState.Graziano
    var isolated: Boolean = false // Флаг нахождения внутри тетраэдральной капсулы

    fun processSignals(signalA: PentarnyState, signalB: PentarnyState): PentarnyState {
        if (isolated) {
            decision = PentarnyState.Graziano
            internalState = PentarnyState.Graziano
            mass = 0.0
            return PentarnyState.Graziano
        }

        val sumVal = signalA.value + signalB.value
        val conflict = abs(signalA.value - signalB.value)

        if (conflict >= 3) {
            mass = conflict * 3.14
            internalState = PentarnyState.Graziano
        } else {
            mass = conflict * 0.75
            val clamped = maxOf(-2, minOf(2, sumVal))
            internalState = PentarnyState.fromInt(clamped)
        }

        decision = internalState
        return internalState
    }
}

// Канал связи между узлами с динамическим конфайнментом
class PentarEdge(val source: PentarNode, val target: PentarNode) {
    var energyFlow: Double = 1.0
    var temp: Double = 1.0

    fun updateDynamics() {
        if (source.isolated || target.isolated) {
            energyFlow = 0.0
            temp = 0.05
            return
        }

        val decisionSum = source.decision.value + target.decision.value
        val totalMass = source.mass + target.mass
        val baseModifier = 1.0 + (decisionSum * 0.2) - (totalMass * 0.15)
        temp = maxOf(0.05, baseModifier)

        if (source.decision is PentarnyState.Arlekin || target.decision is PentarnyState.Arlekin) {
            energyFlow = 0.0
        } else {
            energyFlow = (temp * 1.618) + (totalMass * 0.5)
        }
    }
}

// Вершина объемной тетраэдральной капсулы конфайнмента
class TetrahedralVertex(val name: String, initialCoords: IntArray, val fieldDims: IntArray) {
    var coords: IntArray = initialCoords.clone()

    fun drift(fieldData: IntArray) {
        val dims = fieldDims.size
        var bestCoords = coords.clone()
        var maxTension = -999.0

        for (d in 0 until dims) {
            for (delta in intArrayOf(-1, 1)) {
                val testCoords = coords.clone()
                testCoords[d] += delta

                if (testCoords.indices.all { testCoords[it] in 0 until fieldDims[it] }) {
                    // Упрощенная оценка локального напряжения поля
                    var idx = 0
                    var mult = 1
                    for (i in testCoords.indices.reversed()) {
                        idx += testCoords[i] * mult
                        mult *= fieldDims[i]
                    }
                    val tension = abs(fieldData[idx]).toDouble() + 2.0

                    if (tension > maxTension) {
                        maxTension = tension
                        bestCoords = testCoords
                    }
                }
            }
        }
        coords = bestCoords
    }
}

// Тетраэдральная капсула изоляции (Alpha, Beta, Gamma, Delta)
class TetrahedralConfinedCapsule(val fieldDims: IntArray, p1: IntArray, p2: IntArray, p3: IntArray, p4: IntArray) {
    val vAlpha = TetrahedralVertex("Alpha", p1, fieldDims)
    val vBeta = TetrahedralVertex("Beta", p2, fieldDims)
    val vGamma = TetrahedralVertex("Gamma", p3, fieldDims)
    val vDelta = TetrahedralVertex("Delta", p4, fieldDims)

    fun evolveCapsule(fieldData: IntArray) {
        vAlpha.drift(fieldData)
        vBeta.drift(fieldData)
        vGamma.drift(fieldData)
        vDelta.drift(fieldData)
    }

    fun getVertices(): List<IntArray> = listOf(vAlpha.coords, vBeta.coords, vGamma.coords, vDelta.coords)

    fun enforceContainment(tensorField: PentarnyTensorField, graph: MutableMap<String, PentarNode>, nodeCoords: Map<String, IntArray>) {
        val vertices = getVertices()
        val dims = fieldDims.size
        
        val minB = IntArray(dims) { i -> vertices.minOf { it[i] } }
        val maxB = IntArray(dims) { i -> vertices.maxOf { it[i] } }

        for ((name, node) in graph) {
            if (nodeCoords.containsKey(name)) {
                val nCoords = nodeCoords[name]!!
                val inside = nCoords.indices.all { nCoords[it] in minB[it]..maxB[it] }
                node.isolated = inside
            }
        }

        // Инъекция экранирующих импульсов защиты
        for (v in vertices) {
            tensorField.injectImpulse(v, -2)
        }
    }
}

// Главный оркестратор кристалла V20 на Kotlin
class PentarUniverseV20Core(val dimensions: IntArray) {
    val tensorField = PentarnyTensorField(dimensions)
    val graphNodes = mutableMapOf<String, PentarNode>()
    val edges = mutableListOf<PentarEdge>()
    val nodeCoords = mutableMapOf<String, IntArray>()
    var timeStep: Int = 0

    private val maxIdx = dimensions[0] - 1
    private val mid = dimensions[0] / 2
    val capsule = TetrahedralConfinedCapsule(
        dimensions,
        intArrayOf(0, 0, 0, 0),
        intArrayOf(maxIdx, maxIdx, 0, 0),
        intArrayOf(maxIdx, 0, maxIdx, 0),
        intArrayOf(mid, mid, mid, maxIdx)
    )

    fun addNode(name: String, coords: IntArray) {
        graphNodes[name] = PentarNode(name)
        nodeCoords[name] = coords
    }

    fun addEdge(src: String, tgt: String) {
        val sNode = graphNodes[src] ?: throw IllegalArgumentException("Узел $src не найден")
        val tNode = graphNodes[tgt] ?: throw IllegalArgumentException("Узел $tgt не найден")
        edges.add(PentarEdge(sNode, tNode))
    }

    fun step() {
        timeStep++

        // Пульсация графа
        for ((_, node) in graphNodes) {
            val connectedSignals = mutableListOf<PentarnyState>()
            for (edge in edges) {
                if (edge.target == node) {
                    val normVal = (edge.energyFlow - 1.5) / 1.5
                    connectedSignals.add(PentarnyState.quantize(normVal))
                } else if (edge.source == node) {
                    connectedSignals.add(PentarnyState.quantize(edge.energyFlow / 3.0 - 0.5))
                }
            }

            if (connectedSignals.isEmpty()) {
                connectedSignals.add(PentarnyState.fromInt(Random.nextInt(-2, 3)))
            }

            node.processSignals(connectedSignals.first(), connectedSignals.last())
        }

        for (edge in edges) {
            edge.updateDynamics()
        }

        // Проекция решений в тензорное поле
        for ((name, node) in graphNodes) {
            if (nodeCoords.containsKey(name) && !node.isolated) {
                val coords = nodeCoords[name]!!
                if (node.decision.value != 0) {
                    tensorField.injectImpulse(coords, node.decision.value)
                }
            }
        }

        // Эволюция и изоляция капсулы конфайнмента
        capsule.evolveCapsule(tensorField.field)
        capsule.enforceContainment(tensorField, graphNodes, nodeCoords)
    }
}

