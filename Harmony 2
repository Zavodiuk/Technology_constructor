enum class Harmony2Route { FAST_PATH, DEEP_PATH, LOCKED }
enum class Harmony2Safety { PASS, HOLD, LOCK }
data class Harmony2Simulation(val route: Harmony2Route, val safety: Harmony2Safety, val externalExecution: Boolean = false)
fun harmony2Preview(input: String): Harmony2Simulation {
    val route = if (input.length < 64) Harmony2Route.FAST_PATH else Harmony2Route.DEEP_PATH
    return Harmony2Simulation(route, Harmony2Safety.HOLD)
