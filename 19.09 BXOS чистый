    print(f"\n[Контур: Лукасевич / Брусенцов]")
    print(f"  - Результат свёртки: {res_l.folded_state}")
    print(f"  - Бинарный код (bxos_token): {res_l.bxos_token}")
    print(f"  - Распаковка обратно в L5: {BXOSBinaryPacker.unpack_int16_to_l5(res_l.bxos_token)}")
    
