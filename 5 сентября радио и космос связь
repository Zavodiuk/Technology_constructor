class SpaceRFTransport5PSK:
    """Модуляция пентарных данных в 5-уровневую фазовую манипуляцию (5-PSK) для радио/космоса."""
    
    # Отображение пентарных значений в фазовые углы (в радианах)
    PHASE_MAP = {-2: 0.0, -1: 1.256, 0: 2.513, 1: 3.770, 2: 5.026}
    INV_PHASE_MAP = {0.0: -2, 1.256: -1, 2.513: 0, 3.770: 1, 5.026: 2}

    @staticmethod
    def modulate(compressed_bytes: bytes) -> List[float]:
        phases = []
        for b in compressed_bytes:
            pentar_val = int((b / 51.0) - 2)
            pentar_val = max(-2, min(2, pentar_val))
            phases.append(SpaceRFTransport5PSK.PHASE_MAP[pentar_val])
        return phases

    @staticmethod
    def transmit_space_channel(phases: List[float], doppler_shift: float = 0.1, noise_sigma: float = 0.05) -> List[float]:
        transmitted = []
        for p in phases:
            # Добавление доплеровского смещения и гауссовского шума (AWGN)
            corrupted = (p + doppler_shift + np.random.normal(0, noise_sigma)) % (2 * math.pi)
            transmitted.append(corrupted)
        return transmitted

    @staticmethod
    def demodulate(phases: List[float]) -> bytes:
        out_bytes = bytearray()
        standard_phases = list(SpaceRFTransport5PSK.INV_PHASE_MAP.keys())
        for ph in phases:
            closest_phase = min(standard_phases, key=lambda sp: min(abs(sp - ph), 2 * math.pi - abs(sp - ph)))
            pentar_val = SpaceRFTransport5PSK.INV_PHASE_MAP[closest_phase]
            out_bytes.append(int((pentar_val + 2) * 51) & 0xFF)
        return bytes(out_bytes)


