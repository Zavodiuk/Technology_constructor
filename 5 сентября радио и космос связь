class SpaceCommunicationPipelineV23:
    def __init__(self, seed_a: float = 0.78, seed_b: float = 2.35):
        self.codec = SpaceMoireEncoderDecoder(seed_a, seed_b)
        self.rf_transport = SpaceRFTransport5PSK()

    def transmit_package(self, payload: bytes, block_size: int = 49, space_env: Dict[str, Any] = None) -> Tuple[bytes, List[str]]:
        space_env = space_env or {'radiation_risk': 0.05, 'doppler_shift': 0.02}
        padded = payload + b"\x00" * (block_size - (len(payload) % block_size))
        decisions = []

        # Фаза 1: Кодирование и сжатие на борту аппарата
        encoded_stream = bytearray()
        for i in range(0, len(padded), block_size):
            block = padded[i:i+block_size]
            enc_block, dec = self.codec.encode_block(block, context=space_env)
            decisions.append(dec)
            encoded_stream.extend(enc_block)

        # Фаза 2: Радиомодуляция (5-PSK) и передача через космический тракт
        rf_phases = self.rf_transport.modulate(bytes(encoded_stream))
        space_phases = self.rf_transport.transmit_space_channel(rf_phases, doppler_shift=space_env['doppler_shift'], noise_sigma=0.03)
        demodulated_stream = self.rf_transport.demodulate(space_phases)

        # Фаза 3: Прием, демодуляция и восстановление на Земле
        decoded_stream = bytearray()
        for i in range(0, len(demodulated_stream), block_size):
            block = demodulated_stream[i:i+block_size]
            dec_block, _ = self.codec.decode_block(block, context=space_env)
            decoded_stream.extend(dec_block)

        return decoded_stream.rstrip(b"\x00"), decisions


