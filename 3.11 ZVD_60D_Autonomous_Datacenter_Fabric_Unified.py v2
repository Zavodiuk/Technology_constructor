class ZVDAutoStartDaemon:
    def __init__(self, node: BXOSClusterNode, heartbeat_interval: float = 0.5) -> None:
        self.node = node
        self.heartbeat_interval = heartbeat_interval
        self._is_running = False
        self._daemon_task: Optional[asyncio.Task] = None

    async def start_daemon(self) -> None:
        self._is_running = True
        print(f"[DAEMON] Lifecycle daemon active for [{self.node.dc_id}].")
        while self._is_running:
            try:
                await asyncio.sleep(self.heartbeat_interval)
            except asyncio.CancelledError:
                break
            except Exception as e:
                print(f"[DAEMON ERROR] [{self.node.dc_id}]: {e}")

    def trigger_background_start(self) -> None:
        # AUDIT FIX: Hard cancellation of previous active task to prevent zombie leaks
        if self._daemon_task and not self._daemon_task.done():
            self._daemon_task.cancel()
        self._daemon_task = asyncio.create_task(self.start_daemon())

    async def stop_daemon(self) -> None:
        self._is_running = False
        if self._daemon_task and not self._daemon_task.done():
            self._daemon_task.cancel()
            try:
                await self._daemon_task
            except asyncio.CancelledError:
                pass
        print(f"[DAEMON] Lifecycle daemon for [{self.node.dc_id}] terminated.")


