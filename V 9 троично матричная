# 4. MATRIX RASHOMON
# ============================================================

class MatrixRashomon:
    """Rashomon-анализ для троичных матриц"""

    def __init__(self, matrix: TernaryMatrix):
        self.matrix = matrix

    def analyze(self) -> Dict[str, Any]:
        """Анализ со всех перспектив"""
        ones = sum(row.count(1) for row in self.matrix.data)
        zeros = sum(row.count(0) for row in self.matrix.data)
        negs = sum(row.count(-1) for row in self.matrix.data)
        total = self.matrix.rows * self.matrix.cols

        return {
            'техническая': {
                'единицы': ones,
                'нули': zeros,
                'минус_единицы': negs,
                'энтропия': round(self.matrix.entropy(), 3),
                'детерминант': self.matrix.determinant()
            },
            'юридическая': {
                'устойчивость': self.matrix.stability_index() > 0.5,
                'риск': round(zeros / total, 3) if total > 0 else 0
            },
            'бизнес': {
                'плотность_истины': round(ones / total, 3) if total > 0 else 0,
                'плотность_лжи': round(negs / total, 3) if total > 0 else 0
            },
            'стратегическая': {
                'рекомендация': self._get_recommendation(),
                'индекс_стабильности': round(self.matrix.stability_index(), 3)
            }
        }

    def _get_recommendation(self) -> str:
        """Рекомендация на основе анализа"""
        det = self.matrix.determinant()
        ent = self.matrix.entropy()

        if det == 1 and ent < 1.0:
            return "✅ Система стабильна. Продолжать."
        elif det == -1:
            return "⚠️ Обнаружен конфликт. Требуется переход."
        elif ent > 1.5:
            return "🔍 Высокая неопределённость. Требуется анализ."
        else:
            return "⏳ Система в процессе. Наблюдать."

    def to_dict(self) -> Dict:
        return {
            'matrix': self.matrix.to_dict(),
            'analysis': self.analyze()
        }


