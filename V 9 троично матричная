class GameEngineV9:
    """
    GameEngine для V9.1 — работает с троичными матрицами
    Управляет состояниями, переходами, прогнозами
    """

    def __init__(self, initial_matrix: Optional[TernaryMatrix] = None):
        if initial_matrix is None:
            data = [
                [0, 0, 0],
                [0, 1, 0],
                [0, 0, 0]
            ]
            initial_matrix = TernaryMatrix(data)

        self.state = initial_matrix
        self.history: List[MatrixBlockX] = []
        self.blockchain = MatrixBlockChain()
        self.operations_log: List[str] = []

        self._log("GameEngine V9.1 инициализирован")

    def _log(self, msg: str):
        print(f"[GameEngine V9.1] {msg}")

    def transition(self, operation: str, matrix: Optional[TernaryMatrix] = None,
                   payload: Optional[Dict] = None) -> MatrixBlockX:
        """Выполнить переход над текущей матрицей"""
        old_state = self.state.copy()

        # Маппинг операций
        operation_map = {
            'set': lambda: matrix.copy() if matrix else old_state,
            'add': lambda: self.state.add(matrix) if matrix else old_state,
            'multiply': lambda: self.state.multiply(matrix) if matrix else old_state,
            'transpose': lambda: self.state.transpose(),
            'diagonal_projection': lambda: self.state.diagonal_projection(),
            'sign_normalization': lambda: self.state.sign_normalization(),
            'dominance_map': lambda: self.state.dominance_map(),
            'transposed_dominance': lambda: self.state.transposed_dominance(),
            'stability_map': lambda: self.state.stability_map(),
            'conflict_index': lambda: self.state.conflict_index(),
            'transition_velocity': lambda: self.state.transition_velocity(),
            'energy_presence': lambda: self.state.energy_presence(),
            'stabilization': lambda: self.state.stabilization(),
            'convolve': lambda: self.state.convolve(matrix) if matrix else old_state,
        }

        if operation not in operation_map:
            raise ValueError(f"Неизвестная операция: {operation}")

        new_matrix = operation_map[operation]()
        self.state = new_matrix

        block = MatrixBlockX(
            index=len(self.history),
            version='V9.1',
            timestamp=time.time(),
            prev_hash=self.history[-1].hash if self.history else 'GENESIS',
            state_matrix=self.state,
            payload=payload or {
                'operation': operation,
                'old_stability': old_state.stability_index(),
                'new_stability': self.state.stability_index()
            }
        )

        self.history.append(block)
        self.blockchain.add_block(self.state, {'operation': operation})
        self.operations_log.append(f"{operation} → {time.strftime('%H:%M:%S')}")

        self._log(f"Переход: {operation} (стаб: {old_state.stability_index():.2f} → {self.state.stability_index():.2f})")
        return block

    def predict(self, steps: int = 1) -> TernaryMatrix:
        """Прогноз на N шагов (свёртка самой себя)"""
        result = self.state.copy()
        for _ in range(steps - 1):
            result = result.convolve(result)
        return result

    def get_graph(self) -> Dict:
        """Граф состояний из матриц"""
        nodes = []
        edges = []

        for i, block in enumerate(self.history):
            nodes.append({
                'id': i,
                'stability': round(block.state_matrix.stability_index(), 3),
                'entropy': round(block.state_matrix.entropy(), 3),
                'timestamp': block.timestamp
            })
            if i > 0:
                edges.append({
                    'from': i - 1,
                    'to': i,
                    'label': block.payload.get('operation', 'unknown')
                })

        return {
            'nodes': nodes,
            'edges': edges,
            'current_stability': round(self.state.stability_index(), 3)
        }

    def analyze(self) -> Dict:
        """Полный анализ текущего состояния"""
        return {
            'current_state': self.state.to_dict(),
            'stability': round(self.state.stability_index(), 3),
            'entropy': round(self.state.entropy(), 3),
            'determinant': self.state.determinant(),
            'history_len': len(self.history),
            'operations': self.operations_log[-10:],
            'state_functions': {k: v.to_dict() for k, v in self.state.state_functions().items()},
            'dynamic_functions': {k: v.to_dict() for k, v in self.state.dynamic_functions().items()}
        }

    def get_state(self) -> Dict:
        return {
            'version': 'V9.1',
            'matrix': self.state.to_dict(),
            'stability': round(self.state.stability_index(), 3),
            'history_len': len(self.history),
            'blockchain': self.blockchain.to_dict()
        }

    def get_matrix(self) -> TernaryMatrix:
        return self.state


