class SpaceLaserTransport:
    """Моделирование вакуумного лазерного канала с учетом расходимости луча и микродрожи платформы."""
    
    OPTICAL_MAP = {-2: 0.1, -1: 0.3, 0: 0.5, 1: 0.7, 2: 0.9}
    INV_MAP = {0.1: -2, 0.3: -1, 0.5: 0, 0.7: 1, 0.9: 2}

    @staticmethod
    def modulate_optical(data_bytes: bytes) -> List[float]:
        pulses = []
        for b in data_bytes:
            val = int((b / 51.0) - 2)
            val = max(-2, min(2, val))
            pulses.append(SpaceLaserTransport.OPTICAL_MAP[val])
        return pulses

    @staticmethod
    def transmit_space_laser(pulses: List[float], pointing_jitter: float = 0.02, solar_noise: float = 0.01) -> List[float]:
        transmitted = []
        for p in pulses:
            # Имитация микродрожи (jitter) и фонового шума солнца
            jitter_effect = np.random.normal(0, pointing_jitter)
            noise = np.random.uniform(-solar_noise, solar_noise)
            corrupted = max(0.05, min(0.95, p + jitter_effect + noise))
            transmitted.append(corrupted)
        return transmitted

    @staticmethod
    def demodulate_optical(pulses: List[float]) -> bytes:
        out_bytes = bytearray()
        levels = list(SpaceLaserTransport.INV_MAP.keys())
        for p in pulses:
            closest = min(levels, key=lambda l: abs(l - p))
            val = SpaceLaserTransport.INV_MAP[closest]
            out_bytes.append(int((val + 2) * 51) & 0xFF)
        return bytes(out_bytes)


