    def __init__(self, logic_strategy: Literal["godel", "luka"] = "godel"):
        self.w_orchestrator = WOrchestrator()
        self.logic_engine = MultivaluedLogicEngine(strategy=logic_strategy)
        self.l5_layer = L5OntologyLayer()
        
        # Инициализация 12 масок Театра дель арте
        self.masks = [
            PantaloneMask("Панталоне", "Finance"),
            DottoreMask("Доктор", "Regulation"),
            CapitanoMask("Капитан", "Performance"),
            BrighellaMask("Бригелла", "Logistics"),
            ArlecchinoMask("Арлекино", "Heuristics"),
            TartagliaMask("Тарталья", "Debug"),
            InnamoratiMask("Влюблённые", "UX/Harmony"),
            ColombinaMask("Коломбина", "Integration"),
            PulcinellaMask("Пульчинелла", "Scepticism"),
            ScapinoMask("Скапино", "Tactics"),
            GiandujaMask("Джандуя", "Practice"),
            BalanzoneMask("Баланцоне", "Ency/Precedents")
        ]

    def run_pipeline(self, request_id: str, text: str, 
                     execution_requested: bool = False, 
                     action_type: str = "DRY_RUN") -> Dict[str, Any]:
        
        # 1. Запрос к W оркестратору (оценка риска, неопределенности, глубины Фибоначчи)
        req = Request(
            request_id=request_id, 
            text=text, 
            execution_requested=execution_requested, 
            action_type=action_type
        )
        w_result = self.w_orchestrator.decide(req)
        
        # 2. Определение домена задачи
        domain = TaskClassifier.classify(text)
        
        # 3. Синтез поисковых запросов и сбор внешних фактов по глубине Фибоначчи
        search_queries = PerspectiveWebSearcher.synthesize_queries(text, domain, w_result.fibonacci_depth)
        search_findings = PerspectiveWebSearcher.simulate_search(search_queries)
        
        # 4. Оценка масками с учетом динамического домена и собранных фактов
        mask_evals = {}
        scores_list = []
        for mask in self.masks:
            eval_res = mask.evaluate(text, domain)
            mask_evals[mask.name] = eval_res
            
            # Маппинг оценки в пентарный домен [-2, 2]
            score_val = eval_res["score"]
            scaled_score = int(np.clip(round((score_val - 0.5) * 4), -2, 2))
            scores_list.append(scaled_score)
            
        # 5. Троично-пентарная свёртка оценок масок через W4 логическое ядро
        scores_array = np.array(scores_list, dtype=np.int8)
        folded_val = self.logic_engine.fold(scores_array)
        
        # 6. Обновление онтологического слоя L5
        l5_input = scores_list[:5] if len(scores_list) >= 5 else scores_list + [0] * (5 - len(scores_list))
        l5_state = self.l5_layer.update(l5_input)
        
        # 7. Многоракурсный Rashomon анализ
        rashomon_audit = PentarnyRashomon.evaluate(scores_array)
        
        # 8. Формирование финального производственного результата
        pipeline_result = ProductionPipelineResult(
            status=w_result.decision,
            triage_state=int(folded_val),
            folded_result=int(folded_val),
            system_energy=self.l5_layer.system_energy,
            rashomon_audit={k: (v.tolist() if isinstance(v, np.ndarray) else v) for k, v in rashomon_audit.items()},
            l5_state=l5_state.tolist(),
            mask_evaluations=mask_evals,
            domain_type=domain.value
        )
        
        return {
            "w_decision": asdict(w_result),
            "domain": domain.value,
            "search_findings": search_findings,
            "pipeline_execution": asdict(pipeline_result)
        }
