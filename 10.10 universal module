class BXOSGate:
    """Детерминированный входной/выходной фильтр критических состояний с нулевой задержкой."""
    
    @staticmethod
    def guard(signal: np.ndarray | float) -> np.ndarray | float:
        return np.clip(signal, -2.0, 2.0)


class BXOS:
    """Execution boundary. It only produces simulated, auditable receipts."""

    ALLOWLIST = frozenset({"DRY_RUN", "LOCAL_TASK", "RESEARCH_RECORD"})

    def __init__(self, max_risk: float = 0.35, max_actions: int = 10) -> None:
        self.max_risk = max_risk
        self.max_actions = max_actions
        self.actions = 0
        self.stopped = False
        self.seen: set[str] = set()
        self.audit: list[dict[str, Any]] = []

    def emergency_stop(self, reason: str = "MANUAL_STOP") -> None:
        self.stopped = True
        self.audit.append({"event": "EMERGENCY_STOP", "reason": reason, "ts": time.time_ns()})

    def simulate(self, request: Request, decision: Decision, risk: float,
                 provenance: tuple[str, ...]) -> dict[str, Any]:
        key = request.request_id
        status = "SIMULATED"
        reason = "SIMULATION_ONLY"
        
        if self.stopped:
            status, reason = "EMERGENCY_STOP", "EMERGENCY_STOP_ACTIVE"
        elif decision is not Decision.PASS:
            status, reason = "DENIED", "DECISION_GATE_NOT_PASS"
        elif not request.execution_requested:
            status, reason = "DENIED", "EXECUTION_NOT_REQUESTED"
        elif request.action_type not in self.ALLOWLIST:
            status, reason = "DENIED", "ACTION_TYPE_NOT_ALLOWLISTED"
        elif risk > self.max_risk:
            status, reason = "DENIED", "RISK_QUOTA_EXCEEDED"
        elif key in self.seen:
            status, reason = "DENIED", "IDEMPOTENCY_DUPLICATE"
        elif self.actions >= self.max_actions:
            status, reason = "DENIED", "ACTION_QUOTA_EXCEEDED"
        else:
            self.actions += 1
            self.seen.add(key)
            
        body = {
            "request_id": key, 
            "status": status, 
            "reason": reason,
            "action_type": request.action_type, 
            "ts": time.time_ns()
        }
        receipt = {
            **body, 
            "simulated": True, 
            "authority": False,
            "digest": hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest()
        }
        self.audit.append({"event": "BXOS_RECEIPT", **receipt})
        return receipt
