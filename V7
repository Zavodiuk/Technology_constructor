class V7System:
    """
    Пентарная система V7
    База: L5 + Pentarny Rashomon + Pentarny Block X
    """

    def __init__(self, difficulty: int = 4):
        self.l5 = L5Engine()
        self.rashomon = PentarnyRashomon()
        self.blockchain = PentarnyBlockChain(difficulty)
        self.current_state: Optional[PentarnyStateData] = None

        self._log(f"V7 System инициализирована (difficulty={difficulty})")

    def _log(self, msg: str):
        print(f"[V7] {msg}")

    # ---- УПРАВЛЕНИЕ СОСТОЯНИЕМ ----

    def set_state(self, value: int, confidence: float = 0.5,
                  metadata: Dict[str, Any] = None) -> PentarnyStateData:
        """Установить текущее пентарное состояние"""
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно быть -2, -1, 0, 1 или 2")

        p_state = PentarnyState(value)
        self.current_state = PentarnyStateData(
            value=p_state,
            confidence=confidence,
            timestamp=time.time(),
            metadata=metadata or {}
        )

        # Сохраняем в Block X
        self.blockchain.add_block(self.current_state, {
            'type': 'state_set',
            'value': value,
            'confidence': confidence
        })

        self._log(f"Состояние установлено: {value} (conf={confidence:.2f})")
        return self.current_state

    # ---- L5 ----

    def set_l5_state(self, layer: str, value: int, confidence: float = 0.5,
                     metadata: Dict[str, Any] = None):
        """Установить состояние на уровне L5"""
        layer_map = {
            'intent': L5Layer.INTENT,
            'goal': L5Layer.GOAL,
            'ontology': L5Layer.ONTOLOGY,
            'context': L5Layer.CONTEXT,
            'action': L5Layer.ACTION
        }
        if layer not in layer_map:
            raise ValueError("Допустимые слои: intent, goal, ontology, context, action")

        self.l5.set_state(layer_map[layer], value, confidence, metadata)

    def evaluate_l5(self) -> Dict:
        """Оценка L5"""
        return self.l5.evaluate()

    # ---- RASHOMON ----

    def analyze_rashomon(self) -> Dict:
        """Rashomon-анализ текущего состояния"""
        if self.current_state is None:
            return {'error': 'Состояние не установлено'}

        return self.rashomon.to_dict(self.current_state)

    # ---- BLOCK X ----

    def get_blockchain_state(self) -> Dict:
        """Состояние Block X"""
        return self.blockchain.to_dict()

    # ---- ЗАПУСК ----

    def run(self, data: Optional[Dict] = None) -> Dict:
        """Запуск V7 системы"""
        self._log("Запуск V7...")

        if self.current_state is None:
            return {
                'status': 'error',
                'message': 'Состояние не установлено. Используйте set_state()'
            }

        # Оценка L5
        l5_result = self.l5.evaluate()

        # Rashomon-анализ
        rashomon_result = self.rashomon.to_dict(self.current_state)

        # Block X
        block_x_result = self.blockchain.to_dict()

        return {
            'status': 'running',
            'version': 'V7',
            'current_state': self.current_state.to_dict(),
            'l5': l5_result,
            'rashomon': rashomon_result,
            'block_x': block_x_result,
            'timestamp': time.time()
        }

    # ---- УТИЛИТЫ ----

    def get_state(self) -> Dict:
        """Полное состояние системы"""
        return {
            'version': 'V7',
            'current_state': self.current_state.to_dict() if self.current_state else None,
            'l5': self.l5.to_dict(),
            'blockchain': self.blockchain.to_dict(),
            'timestamp': time.time()
        }

    def get_graph(self) -> Dict:
        """Граф состояний V7"""
        nodes = []
        edges = []

        # Узлы: состояния L5
        for i, layer in enumerate([L5Layer.INTENT, L5Layer.GOAL, L5Layer.ONTOLOGY,
                                   L5Layer.CONTEXT, L5Layer.ACTION]):
            state = self.l5.get_state(layer)
            nodes.append({
                'id': i,
                'label': layer.value,
                'state': state.value.value if state else 0,
                'confidence': state.confidence if state else 0.0,
                'energy': abs(state.value.value) / 2.0 if state else 0.0
            })
            if i > 0:
                edges.append({'from': i-1, 'to': i, 'label': '→'})

        # Текущее состояние
        if self.current_state:
            nodes.append({
                'id': 5,
                'label': 'Current',
                'state': self.current_state.value.value,
                'confidence': self.current_state.confidence,
                'energy': self.current_state.value.strength()
            })
            edges.append({'from': 4, 'to': 5, 'label': '→'})

        return {'nodes': nodes, 'edges': edges}


