# 4. ПЕНТАРНЫЙ BLOCK X (L5)
# ============================================================

@dataclass
class PentarnyBlock:
    """Блок в пентарной цепочке"""
    index: int
    version: str
    timestamp: float
    prev_hash: str
    state: PentarnyStateData
    payload: Dict[str, Any]
    signature: str
    nonce: int = 0

    @property
    def hash(self) -> str:
        data = f"{self.index}{self.version}{self.timestamp}{self.prev_hash}{json.dumps(self.payload)}{self.signature}{self.nonce}"
        return hashlib.sha256(data.encode()).hexdigest()

    def verify(self, difficulty: int = 4) -> bool:
        return self.hash.startswith('0' * difficulty)

    def mine(self, difficulty: int = 4):
        """Доказательство работы (майнинг)"""
        while not self.hash.startswith('0' * difficulty):
            self.nonce += 1
        return self.nonce

    def to_dict(self) -> Dict:
        return {
            'index': self.index,
            'version': self.version,
            'timestamp': self.timestamp,
            'prev_hash': self.prev_hash[:16] + '...' if len(self.prev_hash) > 16 else self.prev_hash,
            'state': self.state.to_dict(),
            'payload': self.payload,
            'signature': self.signature,
            'nonce': self.nonce,
            'hash': self.hash[:16] + '...'
        }

class PentarnyBlockChain:
    """Пентарная цепочка блоков"""

    def __init__(self, difficulty: int = 4):
        self.blocks: List[PentarnyBlock] = []
        self.difficulty = difficulty

    def add_block(self, state: PentarnyStateData, payload: Dict[str, Any]) -> PentarnyBlock:
        """Добавить блок с майнингом"""
        block = PentarnyBlock(
            index=len(self.blocks),
            version='V7',
            timestamp=time.time(),
            prev_hash=self.blocks[-1].hash if self.blocks else 'GENESIS',
            state=state,
            payload=payload,
            signature='Root-Architect'
        )
        block.mine(self.difficulty)
        self.blocks.append(block)
        return block

    def verify_chain(self) -> Tuple[bool, int]:
        """Проверить целостность цепочки"""
        for i, block in enumerate(self.blocks):
            if not block.verify(self.difficulty):
                return False, i
            if i > 0 and block.prev_hash != self.blocks[i-1].hash:
                return False, i
        return True, -1

    def get_last(self) -> Optional[PentarnyBlock]:
        return self.blocks[-1] if self.blocks else None

    def to_dict(self) -> Dict:
        verified, error_idx = self.verify_chain()
        return {
            'length': len(self.blocks),
            'difficulty': self.difficulty,
            'verified': verified,
            'error_index': error_idx if not verified else None,
            'blocks': [b.to_dict() for b in self.blocks[-5:]]
        }

