# 1. БАЗОВЫЕ ТИПЫ — ПЕНТАРНАЯ ЛОГИКА (5 СОСТОЯНИЙ)
# ============================================================

class PentarnyState(Enum):
    """
    5 состояний пентарной логики:
    -2: Сильная ложь (strong false)
    -1: Ложь (false)
     0: Неопределённость (undefined)
     1: Истина (true)
     2: Сильная истина (strong true)
    """
    STRONG_FALSE = -2
    FALSE = -1
    UNDEFINED = 0
    TRUE = 1
    STRONG_TRUE = 2

    def is_positive(self) -> bool:
        return self.value > 0

    def is_negative(self) -> bool:
        return self.value < 0

    def is_undefined(self) -> bool:
        return self.value == 0

    def strength(self) -> float:
        """Сила состояния: 0.0 – 1.0"""
        return abs(self.value) / 2.0

@dataclass
class PentarnyStateData:
    """Пентарное состояние системы"""
    value: PentarnyState
    confidence: float  # 0.0 – 1.0
    timestamp: float
    metadata: Dict[str, Any]

    def to_dict(self) -> Dict:
        return {
            'value': self.value.value,
            'label': self.value.name,
            'confidence': self.confidence,
            'timestamp': self.timestamp,
            'metadata': self.metadata
        }

# ============================================================
# 2. L5 — ПЕНТАРНАЯ ЛОГИКА УРОВНЕЙ
# ============================================================

class L5Layer(Enum):
    """Пять уровней L5"""
    INTENT = "intent"
    GOAL = "goal"
    ONTOLOGY = "ontology"
    CONTEXT = "context"
    ACTION = "action"

@dataclass
class L5State:
    """Состояние уровня L5"""
    layer: L5Layer
    state: PentarnyStateData
    transition_energy: float  # 0.0 – 1.0

    def to_dict(self) -> Dict:
        return {
            'layer': self.layer.value,
            'state': self.state.to_dict(),
            'transition_energy': self.transition_energy
        }

class L5Engine:
    """Движок L5 — управление пентарной логикой"""

    def __init__(self):
        self.states: Dict[L5Layer, Optional[PentarnyStateData]] = {
            L5Layer.INTENT: None,
            L5Layer.GOAL: None,
            L5Layer.ONTOLOGY: None,
            L5Layer.CONTEXT: None,
            L5Layer.ACTION: None
        }
        self.history: List[L5State] = []
        self.energy = 0.5  # общая энергия системы

    def set_state(self, layer: L5Layer, value: int, confidence: float = 0.5,
                  metadata: Dict[str, Any] = None) -> PentarnyStateData:
        """Установить состояние для уровня"""
        if value not in [-2, -1, 0, 1, 2]:
            raise ValueError("Значение должно быть -2, -1, 0, 1 или 2")

        p_state = PentarnyState(value)
        state_data = PentarnyStateData(
            value=p_state,
            confidence=confidence,
            timestamp=time.time(),
            metadata=metadata or {}
        )
        self.states[layer] = state_data

        # Энергия перехода
        transition_energy = abs(value) / 2.0
        self.history.append(L5State(layer, state_data, transition_energy))
        self.energy = (self.energy + transition_energy) / 2.0

        return state_data

    def get_state(self, layer: L5Layer) -> Optional[PentarnyStateData]:
        return self.states.get(layer)

    def evaluate(self) -> Dict[str, Any]:
        """Оценка всей L5 системы"""
        result = {}
        total_energy = 0
        count = 0

        for layer in L5Layer:
            state = self.states.get(layer)
            if state:
                result[layer.value] = state.to_dict()
                total_energy += abs(state.value.value) / 2.0
                count += 1
            else:
                result[layer.value] = None

        # Средняя энергия
        avg_energy = total_energy / count if count > 0 else 0

        # Уровень согласованности
        values = [s.value.value for s in self.states.values() if s is not None]
        if values:
            avg_val = sum(values) / len(values)
            if avg_val > 0.5:
                consistency = "positive"
            elif avg_val < -0.5:
                consistency = "negative"
            else:
                consistency = "neutral"
        else:
            consistency = "undefined"

        return {
            'states': result,
            'avg_energy': avg_energy,
            'consistency': consistency,
            'system_energy': self.energy,
            'history_len': len(self.history)
        }

    def to_dict(self) -> Dict:
        return {
            'states': {k.value: v.to_dict() if v else None for k, v in self.states.items()},
            'energy': self.energy,
            'history_len': len(self.history)
        }

