class LogicMode(str, Enum):
    TERNARY_FIRST = 'TERNARY_FIRST'
    PENTARY_FIRST = 'PENTARY_FIRST'
    HYBRID_ESCALATE = 'HYBRID_ESCALATE'


@dataclass(frozen=True)
class LogicRoute:
    mode: LogicMode
    reason: str
    l3_role: str
    l5_role: str
    escalation_required: bool
    authority_allowed: bool


def choose_logic_route(
    *,
    uncertainty: float,
    risk: float,
    external_effect: bool,
    information_loss_tolerance: float = 0.0,
    monetary_value: float = 0.0,
    time_pressure: float = 0.5,
) -> LogicRoute:
    uncertainty = max(0.0, min(1.0, _finite(uncertainty, 'uncertainty')))
    risk = max(0.0, min(1.0, _finite(risk, 'risk')))
    loss_tolerance = max(0.0, min(1.0, _finite(information_loss_tolerance, 'information_loss_tolerance')))
    time_pressure = max(0.0, min(1.0, _finite(time_pressure, 'time_pressure')))
    monetary_value = _finite(monetary_value, 'monetary_value')
    high_stakes = external_effect or risk >= 0.60 or abs(monetary_value) >= 100000.0
    if high_stakes and (uncertainty >= 0.35 or loss_tolerance < 0.50):
        return LogicRoute(
            LogicMode.PENTARY_FIRST,
            'rich intensity and uncertainty require L5 before any decision',
            'coarse directional pre-check only',
            'primary state, intensity and alternative analysis',
            True,
            False,
        )
    if uncertainty >= 0.20 or risk >= 0.30 or loss_tolerance < 0.25:
        return LogicRoute(
            LogicMode.HYBRID_ESCALATE,
            'start with fast L3 routing, escalate to L5 when ambiguity or risk appears',
            'fast routing and anomaly screen',
            'escalation, ambiguity and consequence analysis',
            True,
            False,
        )
    if time_pressure >= 0.80 and not external_effect and risk < 0.30:
        return LogicRoute(
            LogicMode.TERNARY_FIRST,
            'low-risk bounded task with strong time pressure',
            'primary operational decision',
            'optional diagnostic detail',
            False,
            True,
        )
    return LogicRoute(
        LogicMode.TERNARY_FIRST,
        'bounded low-risk directional task',
        'primary operational decision',
        'optional diagnostic detail',
        False,
        not external_effect,
    )


def run_logic_router_self_test() -> Dict[str, Any]:
    low = choose_logic_route(uncertainty=0.05, risk=0.10, external_effect=False, information_loss_tolerance=0.50, time_pressure=0.90)
    ambiguous = choose_logic_route(uncertainty=0.45, risk=0.35, external_effect=False)
    high = choose_logic_route(uncertainty=0.50, risk=0.80, external_effect=True, monetary_value=250000.0)
    assert low.mode == LogicMode.TERNARY_FIRST and low.authority_allowed
    assert ambiguous.mode == LogicMode.HYBRID_ESCALATE and not ambiguous.authority_allowed
    assert high.mode == LogicMode.PENTARY_FIRST and high.escalation_required and not high.authority_allowed
    return {
        'version': 'V12-TERNARY-PENTARY-ROUTER',
        'routes': {'low': asdict(low), 'ambiguous': asdict(ambiguous), 'high': asdict(high)},
        'invariants': {
            'low_risk_uses_l3': low.mode == LogicMode.TERNARY_FIRST,
            'ambiguity_escalates': ambiguous.mode == LogicMode.HYBRID_ESCALATE,
            'high_stakes_uses_l5': high.mode == LogicMode.PENTARY_FIRST,
            'external_authority_blocked_until_review': not high.authority_allowed,
        },
    }


