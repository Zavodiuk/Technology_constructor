class DeterministicLLMAdapter:
    """Offline adapter used for repeatable contract and gate tests."""

    provider = 'deterministic-test'
    model = 'fixture-v12-core'

    def propose(self, request: str, *, request_id: str, context: str) -> LLMProposal:
        digest = hashlib.sha256(request.encode('utf-8')).hexdigest()[:16]
        return LLMProposal(
            request_id=request_id, context=context,
            l5_matrix=((1, 0), (0, 1)),
            interpretation=f'bounded proposal for: {request}', confidence=0.92,
            gross_value=150000.0, avoided_cost=25000.0,
            implementation_cost=20000.0, operating_cost=10000.0,
            risk_reserve=5000.0, liquidity_discount=2000.0,
            timing_cost=3000.0, externality_cost=1000.0,
            recommended_action='route_to_human_approved_execution',
            external_effect=True, provider=self.provider, model=self.model,
            provenance_ref=f'llm://{self.provider}/{self.model}/{digest}',
        )


class OpenAIJsonLLMAdapter:
    """OpenAI-compatible adapter for the configured built-in LLM proxy.

    The LLM proposes structured data only. It never receives BXOS authority;
    V12 validates the proposal, stores it, prices it and applies the gate.
    """

    provider = 'openai-compatible-proxy'

    def __init__(self, model: str = 'gpt-5-mini', max_completion_tokens: int = 1800) -> None:
        self.model = model
        self.max_completion_tokens = max_completion_tokens

    @staticmethod
    def _schema() -> Dict[str, Any]:
        number = {'type': 'number'}
        return {
            'type': 'object',
            'properties': {
                'interpretation': {'type': 'string'},
                'l5_matrix': {'type': 'array', 'items': {'type': 'array', 'items': {'type': 'integer'}}},
                'confidence': number,
                'gross_value': number, 'avoided_cost': number,
                'implementation_cost': number, 'operating_cost': number,
                'risk_reserve': number, 'liquidity_discount': number,
                'timing_cost': number, 'externality_cost': number,
                'recommended_action': {'type': 'string'},
                'external_effect': {'type': 'boolean'},
            },
            'required': [
                'interpretation', 'l5_matrix', 'confidence', 'gross_value', 'avoided_cost',
                'implementation_cost', 'operating_cost', 'risk_reserve', 'liquidity_discount',
                'timing_cost', 'externality_cost', 'recommended_action', 'external_effect',
            ],
            'additionalProperties': False,
        }

    def propose(self, request: str, *, request_id: str, context: str) -> LLMProposal:
        from openai import OpenAI
        client = OpenAI()
        system = (
            'You are the proposal layer only. Return JSON matching the schema. '
            'Use the same currency unit throughout. Do not claim execution, ownership, '
            'or verified evidence. Use a 2x2 pentary matrix with values from -2 to 2. '
            'Estimate money fields only when the request provides a basis; otherwise use 0.'
        )
        response = client.chat.completions.create(
            model=self.model,
            messages=[
                {'role': 'system', 'content': system},
                {'role': 'user', 'content': f'Context: {context}\nRequest: {request}'},
            ],
            max_completion_tokens=self.max_completion_tokens,
            response_format={
                'type': 'json_schema',
                'json_schema': {
                    'name': 'v12_llm_proposal', 'strict': True, 'schema': self._schema(),
                },
            },
            extra_body={'reasoning': {'effort': 'low'}},
        )
        content = response.choices[0].message.content
        if not content:
            raise ValueError('LLM returned empty structured content')
        data = json.loads(content)
        matrix = matrix_tuple(data['l5_matrix'], L5)
        digest = hashlib.sha256(request.encode('utf-8')).hexdigest()[:16]
        return LLMProposal(
            request_id=request_id, context=context, l5_matrix=matrix,
            interpretation=str(data['interpretation']),
            confidence=max(0.0, min(1.0, _finite(data['confidence'], 'confidence'))),
            gross_value=_finite(data['gross_value'], 'gross_value'),
            avoided_cost=_finite(data['avoided_cost'], 'avoided_cost'),
            implementation_cost=_finite(data['implementation_cost'], 'implementation_cost'),
            operating_cost=_finite(data['operating_cost'], 'operating_cost'),
            risk_reserve=_finite(data['risk_reserve'], 'risk_reserve'),
            liquidity_discount=_finite(data['liquidity_discount'], 'liquidity_discount'),
            timing_cost=_finite(data['timing_cost'], 'timing_cost'),
            externality_cost=_finite(data['externality_cost'], 'externality_cost'),
            recommended_action=str(data['recommended_action']),
            external_effect=bool(data['external_effect']),
            provider=self.provider, model=self.model,
            provenance_ref=f'llm://{self.provider}/{self.model}/{digest}',
        )


@dataclass(frozen=True)
class V12CoreLLMResult:
    request_id: str
    proposal: Dict[str, Any]
    experience: Dict[str, Any]
    monetary: Dict[str, Any]
    gate: Dict[str, Any]
    decision_record: Dict[str, Any]
    authority: bool


def run_v12_core_with_llm(
    request: str,
    *,
    request_id: str = 'req-v12-001',
    context: str = 'generic',
    adapter: Optional[LLMAdapter] = None,
    tree: Optional[LomonosovSpiralTree] = None,
    turn: int = 1,
) -> V12CoreLLMResult:
    adapter = adapter or OpenAIJsonLLMAdapter()
    tree = tree or LomonosovSpiralTree()
    proposal = adapter.propose(request, request_id=request_id, context=context)
    # The model output is unverified evidence; V12 creates its own provenance.
    node = tree.add(
        proposal.l5_matrix, context=context, turn=turn,
        mode='sign', outcome='LLM_PROPOSAL_UNVERIFIED',
        decision=Decision.CLARIFY, confidence=proposal.confidence, validated=False,
    )
    monetary = evaluate_monetary_effectiveness(
        decision_id=request_id, currency='USD',
        gross_value=proposal.gross_value, avoided_cost=proposal.avoided_cost,
        implementation_cost=proposal.implementation_cost, operating_cost=proposal.operating_cost,
        risk_reserve=proposal.risk_reserve, liquidity_discount=proposal.liquidity_discount,
        timing_cost=proposal.timing_cost, externality_cost=proposal.externality_cost,
        confidence=proposal.confidence, provenance_quality=0.4,
        conflicts=0, rhythm_alignment=1.0,
    )
    gate = decision_gate(node, external_effect=proposal.external_effect)
    reasons = list(gate.reasons) + list(monetary.explanation)
    if monetary.decision == Decision.VETO:
        final_decision = Decision.VETO
    elif gate.decision != Decision.PASS or monetary.decision != Decision.PASS:
        final_decision = Decision.CLARIFY
    else:
        final_decision = Decision.PASS
    authority = final_decision == Decision.PASS and gate.bxos_authority and monetary.decision == Decision.PASS
    record = make_decision_record(
        task_id=request_id,
        conclusions=(
            'LLM output is a proposal, not an execution authority.',
            f'V12 stored the proposal in the Lomonosov tree as {node.experience_id}.',
            f'Monetary net value is {monetary.net_monetary_value:.2f} USD under supplied assumptions.',
        ),
        options=('PASS to guarded execution', 'CLARIFY with human review', 'VETO the external action'),
        selected={Decision.PASS: 'PASS to guarded execution', Decision.CLARIFY: 'CLARIFY with human review', Decision.VETO: 'VETO the external action'}[final_decision],
        confidence=min(proposal.confidence, 0.49 if final_decision != Decision.PASS else proposal.confidence),
        evidence_refs=(proposal.provenance_ref, node.fold.provenance.source_digest),
        uncertainties=tuple(reasons) or ('No blocking reason detected by CORE checks.',),
        constraints=('LLM cannot grant itself authority.', 'Unverified proposals cannot become reusable knowledge.'),
        next_step='Human review and external outcome capture before validation.',
        status='PRELIMINARY',
    )
    return V12CoreLLMResult(
        request_id=request_id,
        proposal=asdict(proposal), experience=node.to_dict(),
        monetary=asdict(monetary), gate=asdict(gate),
        decision_record=record.to_dict(), authority=authority,
    )


def run_v12_core_llm_integration_self_test() -> Dict[str, Any]:
    result = run_v12_core_with_llm(
        'Evaluate a bounded operational proposal and calculate its monetary value.',
        adapter=DeterministicLLMAdapter(), context='integration-test',
