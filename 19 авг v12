class LearningGuardMode(str, Enum):
    NORMAL = 'NORMAL'
    RESTRICTED = 'RESTRICTED'
    CONSERVATION = 'CONSERVATION'
    FROZEN = 'FROZEN'


@dataclass(frozen=True)
class PolicySnapshot:
    threshold_low: float
    threshold_high: float
    update_count: int


@dataclass(frozen=True)
class LearningUpdateResult:
    update_id: str
    status: str
    mode: LearningGuardMode
    experience_id: str
    context: str
    proposed_growth: float
    applied_growth: float
    threshold_low_before: float
    threshold_low_after: float
    threshold_high_before: float
    threshold_high_after: float
    validation_score: float
    out_of_sample_score: float
    monetary_decision: Decision
    rhythm_decision: Decision
    reasons: Tuple[str, ...]
    rollback_available: bool


class LearningGuardV12:
    """Bounded retrieval-to-policy calibration for validated V12 experience."""

    def __init__(self, *, max_rate: float = 0.20, minimum_validation: float = 0.80, minimum_oos: float = 0.80) -> None:
        self.max_rate = max(0.0, _finite(max_rate, 'max_rate'))
        self.minimum_validation = max(0.0, min(1.0, _finite(minimum_validation, 'minimum_validation')))
        self.minimum_oos = max(0.0, min(1.0, _finite(minimum_oos, 'minimum_oos')))
        self.current_growth = 0.0
        self.mode = LearningGuardMode.NORMAL
        self.update_count = 0
        self.history: List[LearningUpdateResult] = []
        self._snapshots: Dict[str, PolicySnapshot] = {}

    def _adapt_mode(self) -> None:
        if self.current_growth >= self.max_rate:
            self.mode = LearningGuardMode.CONSERVATION
        elif self.current_growth >= self.max_rate * 0.80:
            self.mode = LearningGuardMode.RESTRICTED
        else:
            self.mode = LearningGuardMode.NORMAL

    def _authorize(
        self,
        *,
        node: ExperienceNode,
        monetary: MonetaryEffectiveness,
        rhythm: RhythmGovernorResult,
        validation_score: float,
        out_of_sample_score: float,
        proposed_growth: float,
    ) -> Tuple[bool, Tuple[str, ...]]:
        reasons: List[str] = []
        if not node.validated or not node.reusable():
            reasons.append('experience_not_validated_or_reusable')
        if monetary.decision != Decision.PASS:
            reasons.append('monetary_gate_not_pass')
        if rhythm.decision != Decision.PASS:
            reasons.append('rhythm_gate_not_pass')
        if validation_score < self.minimum_validation:
            reasons.append('validation_score_below_threshold')
        if out_of_sample_score < self.minimum_oos:
            reasons.append('out_of_sample_score_below_threshold')
        if proposed_growth <= 0.0 or proposed_growth > self.max_rate:
            reasons.append('proposed_growth_out_of_bounds')
        if self.mode in (LearningGuardMode.CONSERVATION, LearningGuardMode.FROZEN):
            reasons.append('learning_guard_in_conservation_or_frozen_mode')
        if self.current_growth + proposed_growth > self.max_rate:
            reasons.append('growth_budget_exceeded')
        return not reasons, tuple(reasons)

    def calibrate_thresholds(
        self,
        *,
        node: ExperienceNode,
        context: str,
        threshold_low: float,
        threshold_high: float,
        target_low: float,
        target_high: float,
        validation_score: float,
        out_of_sample_score: float,
        monetary: MonetaryEffectiveness,
        rhythm: RhythmGovernorResult,
        proposed_growth: float = 0.05,
        commit: bool = True,
    ) -> LearningUpdateResult:
        values = (threshold_low, threshold_high, target_low, target_high, validation_score, out_of_sample_score, proposed_growth)
        threshold_low, threshold_high, target_low, target_high, validation_score, out_of_sample_score, proposed_growth = tuple(_finite(v, 'learning_parameter') for v in values)
        if not 0.0 <= threshold_low <= threshold_high <= 1.0:
            raise ValueError('current thresholds must satisfy 0 <= low <= high <= 1')
        if not 0.0 <= target_low <= target_high <= 1.0:
            raise ValueError('target thresholds must satisfy 0 <= low <= high <= 1')
        validation_score = max(0.0, min(1.0, validation_score))
        out_of_sample_score = max(0.0, min(1.0, out_of_sample_score))
        proposed_growth = max(0.0, proposed_growth)
        self._adapt_mode()
        update_id = 'learn-' + hashlib.sha256(f'{node.experience_id}:{context}:{len(self.history)}:{self.update_count}'.encode()).hexdigest()[:16]
        authorized, reasons = self._authorize(
            node=node, monetary=monetary, rhythm=rhythm,
            validation_score=validation_score, out_of_sample_score=out_of_sample_score,
            proposed_growth=proposed_growth,
        )
        if not authorized or not commit:
            status = 'REJECTED' if not authorized else 'PROPOSED_SHADOW'
            if commit and not authorized:
                self.mode = LearningGuardMode.CONSERVATION if reasons else self.mode
            result = LearningUpdateResult(update_id, status, self.mode, node.experience_id, context,
                                          proposed_growth, 0.0, threshold_low, threshold_low,
                                          threshold_high, threshold_high, validation_score,
                                          out_of_sample_score, monetary.decision, rhythm.decision,
                                          reasons or ('shadow_mode_no_commit',), False)
            self.history.append(result)
            return result
        self._snapshots[update_id] = PolicySnapshot(threshold_low, threshold_high, self.update_count)
        # A single update is bounded by the proposed growth and cannot jump to target directly.
        applied_growth = min(proposed_growth, self.max_rate - self.current_growth)
        direction_low = target_low - threshold_low
        direction_high = target_high - threshold_high
        new_low = max(0.0, min(1.0, threshold_low + max(-applied_growth, min(applied_growth, direction_low))))
        new_high = max(new_low, min(1.0, threshold_high + max(-applied_growth, min(applied_growth, direction_high))))
        self.current_growth += applied_growth
        self.update_count += 1
        self._adapt_mode()
        result = LearningUpdateResult(update_id, 'COMMITTED', self.mode, node.experience_id, context,
                                      proposed_growth, applied_growth, threshold_low, new_low,
                                      threshold_high, new_high, validation_score, out_of_sample_score,
                                      monetary.decision, rhythm.decision,
                                      ('validated_bounded_policy_update',), True)
        self.history.append(result)
        return result

    def rollback(self, update_id: str) -> PolicySnapshot:
        if update_id not in self._snapshots:
            raise KeyError('unknown or non-committed update_id')
        snapshot = self._snapshots[update_id]
        committed = next((item for item in reversed(self.history) if item.update_id == update_id), None)
        applied_growth = committed.applied_growth if committed is not None else 0.0
        self.current_growth = max(0.0, self.current_growth - applied_growth)
        self.update_count = snapshot.update_count
        self._adapt_mode()
        return snapshot

    def status(self) -> Dict[str, Any]:
        self._adapt_mode()
        return {'mode': self.mode.value, 'current_growth': round(self.current_growth, 6),
                'max_rate': self.max_rate, 'remaining_capacity': round(max(0.0, self.max_rate - self.current_growth), 6),
                'update_count': self.update_count, 'history_count': len(self.history)}


def run_v12_controlled_learning_self_test() -> Dict[str, Any]:
    tree = LomonosovSpiralTree()
    node = tree.add([[0, -1], [1, 0]], context='gazprom-learning', turn=1,
                    outcome='VALIDATED', decision=Decision.PASS, confidence=0.92, validated=True)
    monetary = evaluate_monetary_effectiveness(
        decision_id='learn-gazprom', gross_value=150000.0, avoided_cost=25000.0,
        implementation_cost=10000.0, operating_cost=5000.0, risk_reserve=5000.0,
        timing_cost=1000.0, confidence=0.92, provenance_quality=0.95,
        rhythm_alignment=0.95,
    )
    rhythm = RhythmGovernor().evaluate(
        external_rate=1.0, observed_growth_rate=0.10, observed_rhythm=0.10,
        effective_load=0.20, adaptation_capacity=1.0, provenance_quality=0.95,
    )
    guard = LearningGuardV12()
    proposal = guard.calibrate_thresholds(
        node=node, context='gazprom-learning', threshold_low=0.30, threshold_high=0.70,
        target_low=0.40, target_high=0.80, validation_score=0.90,
        out_of_sample_score=0.88, monetary=monetary, rhythm=rhythm,
        proposed_growth=0.05, commit=False,
    )
    committed = guard.calibrate_thresholds(
        node=node, context='gazprom-learning', threshold_low=0.30, threshold_high=0.70,
        target_low=0.40, target_high=0.80, validation_score=0.90,
        out_of_sample_score=0.88, monetary=monetary, rhythm=rhythm,
        proposed_growth=0.05, commit=True,
    )
    assert proposal.status == 'PROPOSED_SHADOW'
    assert committed.status == 'COMMITTED'
    assert committed.threshold_low_after == 0.35
    assert committed.threshold_high_after == 0.75
    snapshot = guard.rollback(committed.update_id)
    assert snapshot.threshold_low == 0.30 and snapshot.threshold_high == 0.70
    blocked = guard.calibrate_thresholds(
        node=node, context='gazprom-learning', threshold_low=0.30, threshold_high=0.70,
        target_low=0.40, target_high=0.80, validation_score=0.60,
        out_of_sample_score=0.50, monetary=monetary, rhythm=rhythm,
        proposed_growth=0.05, commit=True,
    )
    assert blocked.status == 'REJECTED'
    return {'version': 'V12-CONTROLLED-LEARNING-GUARD', 'author': 'Vladimir Zavodiuk',
            'license': 'All Rights Reserved', 'shadow_proposal': asdict(proposal),
            'committed_update': asdict(committed), 'rollback_snapshot': asdict(snapshot),
            'blocked_update': asdict(blocked), 'guard_status': guard.status(),
            'invariants': {'shadow_does_not_mutate': proposal.threshold_low_after == 0.30,
                           'update_is_bounded': committed.applied_growth == 0.05,
                           'oos_validation_required': 'out_of_sample_score_below_threshold' in blocked.reasons,
                           'rollback_available': committed.rollback_available,
