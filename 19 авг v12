@dataclass(frozen=True)
class DecisionRecord:
    task_id: str
    preliminary_conclusions: Tuple[str, ...]
    solution_options: Tuple[str, ...]
    selected_solution: str
    confidence: float
    evidence_refs: Tuple[str, ...]
    uncertainties: Tuple[str, ...]
    constraints: Tuple[str, ...]
    next_step: str
    status: str = 'PRELIMINARY'

    def __post_init__(self) -> None:
        if not self.task_id.strip():
            raise ValueError('task_id is required')
        if not self.preliminary_conclusions:
            raise ValueError('at least one preliminary conclusion is required')
        if not self.solution_options:
            raise ValueError('at least one solution option is required')
        if self.selected_solution not in self.solution_options:
            raise ValueError('selected_solution must be one of solution_options')
        if not 0.0 <= self.confidence <= 1.0:
            raise ValueError('confidence must be in [0, 1]')
        if not self.next_step.strip():
            raise ValueError('next_step is required')

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def make_decision_record(
    task_id: str,
    conclusions: Sequence[str],
    options: Sequence[str],
    selected: str,
    confidence: float,
    evidence_refs: Sequence[str],
    uncertainties: Sequence[str],
    constraints: Sequence[str],
    next_step: str,
    *,
    status: str = 'PRELIMINARY',
) -> DecisionRecord:
    """Create the mandatory V12 conclusion/solution record for any task."""
    return DecisionRecord(
        task_id=task_id,
        preliminary_conclusions=tuple(conclusions),
        solution_options=tuple(options),
        selected_solution=selected,
        confidence=max(0.0, min(1.0, _finite(confidence, 'confidence'))),
        evidence_refs=tuple(evidence_refs),
        uncertainties=tuple(uncertainties),
        constraints=tuple(constraints),
        next_step=next_step,
        status=status,
    )


