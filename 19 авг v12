def v12_domain_masks(packs: Sequence[str] = ('Core', 'Market', 'Geopolitics')) -> Tuple[DomainMaskInstance, ...]:
    base = v12_character_masks()
    responsibilities = {
        'Core': 'general systems perspective',
        'Market': 'market and capital-allocation perspective',
        'Geopolitics': 'state, diplomacy and transit perspective',
        'Energy': 'energy infrastructure and supply perspective',
        'Legal': 'legal, regulatory and sanctions perspective',
    }
    instances: List[DomainMaskInstance] = []
    for pack in packs:
