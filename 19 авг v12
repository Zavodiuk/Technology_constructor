class DoubleRashomon:
    """Preserves multiple interpretations at input and candidates at output."""

    def __init__(self, masks: Sequence[CharacterMask] = ()) -> None:
        active = masks or v12_character_masks()
        self.masks: Dict[str, CharacterMask] = {mask.mask_id: mask for mask in active}
        self.input_branches: Dict[str, RashomonBranch] = {}
        self.output_candidates: Dict[str, CandidateOutcome] = {}

    def add_input(self, event_id: str, mask_id: str, interpretation: str, confidence: float, provenance_ref: str, loss_mask_ref: Optional[str] = None) -> RashomonBranch:
        if mask_id not in self.masks:
            raise KeyError(f'unknown mask: {mask_id}')
        if self.masks[mask_id].contour not in ('INPUT', 'EXPERIENCE'):
            raise ValueError('mask is not valid for input interpretation')
        confidence = max(0.0, min(1.0, _finite(confidence, 'confidence')))
        branch_id = 'in-' + hashlib.sha256(f'{event_id}:{mask_id}:{interpretation}'.encode()).hexdigest()[:12]
        branch = RashomonBranch(branch_id, event_id, mask_id, 'INPUT', interpretation, confidence, provenance_ref, loss_mask_ref)
        self.input_branches[branch_id] = branch
        return branch

    def add_output(self, input_branch_ids: Sequence[str], mask_id: str, description: str, risk: float, confidence: float, reversible: bool, provenance_ref: str) -> CandidateOutcome:
        if mask_id not in self.masks:
            raise KeyError(f'unknown mask: {mask_id}')
        if self.masks[mask_id].contour not in ('OUTPUT', 'EXPERIENCE'):
            raise ValueError('mask is not valid for output assessment')
        if any(branch_id not in self.input_branches for branch_id in input_branch_ids):
            raise KeyError('output references unknown input branch')
        candidate_id = 'out-' + hashlib.sha256(f'{sorted(input_branch_ids)}:{mask_id}:{description}'.encode()).hexdigest()[:12]
        candidate = CandidateOutcome(candidate_id, tuple(input_branch_ids), mask_id, description,
                                     max(0.0, min(1.0, _finite(risk, 'risk'))),
                                     max(0.0, min(1.0, _finite(confidence, 'confidence'))), reversible, provenance_ref)
        self.output_candidates[candidate_id] = candidate
        return candidate

    def assess(self, *, external_effect: bool = True) -> RashomonAssessment:
        branches = list(self.input_branches.values())
        candidates = sorted(self.output_candidates.values(), key=lambda item: (item.risk, -item.confidence, not item.reversible))
        input_conflict = len({branch.interpretation for branch in branches}) > 1
        output_conflict = len({candidate.description for candidate in candidates}) > 1
        if not branches:
            return RashomonAssessment(True, True, None, Decision.VETO, ('no input branches',), False)
        if not candidates:
            return RashomonAssessment(input_conflict, True, None, Decision.CLARIFY, ('no output candidates',), False)
        selected = candidates[0]
        reasons: List[str] = []
        if input_conflict:
            reasons.append('input interpretation conflict')
        if output_conflict:
            reasons.append('output candidate conflict')
        if selected.risk > 0.70:
            reasons.append('risk above 0.70')
        if not selected.reversible:
            reasons.append('candidate is not reversible')
        if external_effect and selected.risk > 0.70:
            return RashomonAssessment(input_conflict, output_conflict, selected.candidate_id, Decision.VETO, tuple(reasons), False)
        if external_effect and (input_conflict or output_conflict or not selected.reversible):
            return RashomonAssessment(input_conflict, output_conflict, selected.candidate_id, Decision.CLARIFY, tuple(reasons), False)
        return RashomonAssessment(input_conflict, output_conflict, selected.candidate_id, Decision.PASS, tuple(reasons), True)

    def export(self) -> Dict[str, Any]:
        return {'masks': {key: asdict(value) for key, value in self.masks.items()},
                'input_branches': {key: asdict(value) for key, value in self.input_branches.items()},
                'output_candidates': {key: asdict(value) for key, value in self.output_candidates.items()}}


