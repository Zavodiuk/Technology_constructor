@dataclass(frozen=True)
class CausalBalanceEvent:
    event_id: str
    cause: str
    location: str
    time: float
    parent_event_ids: Tuple[str, ...]
    arrived: float
    departed: float
    external_input: float
    external_output: float
    residual: float
    tempo: float
    rhythm: float
    provenance_ref: str
    confidence: float
    status: str


class LomonosovBalanceLedger:
    """Append-only causal ledger for graph events.

    `arrived` and `departed` are accounting fields for a chosen quantity
    (information, resource, risk, energy proxy, or attention). They are not
    claimed to be a universal conservation law for social systems.
    """

    def __init__(self, tolerance: float = 1e-9):
        self.tolerance = max(_finite(tolerance, 'tolerance'), 1e-12)
        self.events: List[CausalBalanceEvent] = []

    def record(
        self,
        *,
        event_id: str,
        cause: str,
        location: str,
        time_value: float,
        parent_event_ids: Sequence[str] = (),
        arrived: float = 0.0,
        departed: float = 0.0,
        external_input: float = 0.0,
        external_output: float = 0.0,
        tempo: float = 0.0,
        rhythm: float = 0.0,
        provenance_ref: str = '',
        confidence: float = 0.0,
    ) -> CausalBalanceEvent:
        numeric = {
            'time': time_value, 'arrived': arrived, 'departed': departed,
            'external_input': external_input, 'external_output': external_output,
            'tempo': tempo, 'rhythm': rhythm, 'confidence': confidence,
        }
        checked = {key: _finite(value, key) for key, value in numeric.items()}
        if any(value < 0.0 for key, value in checked.items() if key not in ('time',)):
            raise ValueError('quantities and confidence must be non-negative')
        if checked['confidence'] > 1.0:
            raise ValueError('confidence must be in [0, 1]')
        residual = (checked['arrived'] + checked['external_input']) - (checked['departed'] + checked['external_output'])
        status = 'BALANCED' if abs(residual) <= self.tolerance else 'UNACCOUNTED_RESIDUAL'
        event = CausalBalanceEvent(
            event_id=str(event_id), cause=str(cause), location=str(location),
            time=checked['time'], parent_event_ids=tuple(str(item) for item in parent_event_ids),
            arrived=checked['arrived'], departed=checked['departed'],
            external_input=checked['external_input'], external_output=checked['external_output'],
            residual=residual, tempo=checked['tempo'], rhythm=checked['rhythm'],
            provenance_ref=str(provenance_ref), confidence=checked['confidence'], status=status,
        )
        self.events.append(event)
        return event

    def causal_chain(self, event_id: str) -> List[str]:
        known = {event.event_id: event for event in self.events}
        if event_id not in known:
            return []
        result: List[str] = []
        visiting = set()
        def visit(current: str) -> None:
            if current in visiting:
                return
            visiting.add(current)
            event = known.get(current)
            if event is None:
                return
            for parent in event.parent_event_ids:
                visit(parent)
            result.append(current)
        visit(event_id)
        return result

    def summary(self) -> Dict[str, Any]:
        return {
            'events': len(self.events),
            'balanced_events': sum(event.status == 'BALANCED' for event in self.events),
            'residual_events': sum(event.status != 'BALANCED' for event in self.events),
            'total_arrived': sum(event.arrived for event in self.events),
            'total_departed': sum(event.departed for event in self.events),
            'total_residual': sum(event.residual for event in self.events),
            'causal_depth': max((len(self.causal_chain(event.event_id)) for event in self.events), default=0),
        }


def run_lomonosov_balance_self_test() -> Dict[str, Any]:
    ledger = LomonosovBalanceLedger()
    first = ledger.record(
        event_id='E1', cause='input_observation', location='graph:root', time_value=1.0,
        arrived=10.0, departed=2.0, external_input=2.0, external_output=10.0,
        tempo=1.0, rhythm=1.0, provenance_ref='obs:E1', confidence=0.95,
    )
    second = ledger.record(
