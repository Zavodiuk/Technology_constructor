L3 = (-1, 0, 1)
L5 = (-2, -1, 0, 1, 2)
Matrix = Tuple[Tuple[int, ...], ...]


class FoldStatus(str, Enum):
    STABLE = "FOLDED_STABLE"
    LOSSY = "FOLDED_LOSSY"
    AMBIGUOUS = "FOLDED_AMBIGUOUS"
    CONFLICTED = "FOLDED_CONFLICTED"
    FAILED = "FOLD_FAILED"


class Decision(str, Enum):
    PASS = "PASS"
    CLARIFY = "CLARIFY"
    VETO = "VETO"


def _finite(value: Any, name: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError(f"{name} must be numeric")
    result = float(value)
    if not math.isfinite(result):
        raise ValueError(f"{name} must be finite")
    return result


def matrix_tuple(values: Sequence[Sequence[int]], allowed: Iterable[int]) -> Matrix:
    allowed_set = set(allowed)
    rows = tuple(tuple(int(x) for x in row) for row in values)
    if not rows or not rows[0] or any(len(row) != len(rows[0]) for row in rows):
        raise ValueError("matrix must be non-empty and rectangular")
    if any(x not in allowed_set for row in rows for x in row):
        raise ValueError(f"matrix contains values outside {sorted(allowed_set)}")
    return rows


def matrix_digest(matrix: Matrix) -> str:
    payload = json.dumps(matrix, separators=(",", ":"), ensure_ascii=False).encode()
    return hashlib.sha256(payload).hexdigest()


def matrix_shape(matrix: Matrix) -> Tuple[int, int]:
    return len(matrix), len(matrix[0])


def sign_fold(source: Matrix) -> Tuple[Matrix, Tuple[Tuple[int, ...], ...]]:
    source = matrix_tuple(source, L5)
    projected = tuple(tuple(-1 if x < 0 else 1 if x > 0 else 0 for x in row) for row in source)
    loss = tuple(tuple(1 if abs(x) == 2 else 0 for x in row) for row in source)
    return projected, loss


def threshold_fold(source: Matrix, threshold: int = 2) -> Tuple[Matrix, Tuple[Tuple[int, ...], ...]]:
    source = matrix_tuple(source, L5)
    if threshold not in (1, 2):
        raise ValueError("threshold must be 1 or 2")
    projected = tuple(
        tuple(((-1 if x < 0 else 1) if abs(x) >= threshold else 0) for x in row)
        for row in source
    )
    loss = tuple(tuple(1 if 0 < abs(x) < threshold else 0 for x in row) for row in source)
    return projected, loss


def _mask_count(mask: Tuple[Tuple[int, ...], ...]) -> int:
    return sum(sum(row) for row in mask)


