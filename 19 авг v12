@dataclass(frozen=True)
class FoldResult:
    source_matrix: Matrix
    projection_matrix: Matrix
    loss_mask: Tuple[Tuple[int, ...], ...]
    ambiguity_mask: Tuple[Tuple[int, ...], ...]
    conflict_count: int
    status: FoldStatus
    provenance: Provenance

    @property
    def loss_count(self) -> int:
        return _mask_count(self.loss_mask)

    @property
    def cell_count(self) -> int:
        rows, cols = matrix_shape(self.source_matrix)
        return rows * cols

    @property
    def loss_ratio(self) -> float:
        return self.loss_count / self.cell_count

    @property
    def provenance_reconstructible(self) -> bool:
        return bool(self.provenance.source_digest and self.source_matrix)

    @property
    def mathematical_reversible(self) -> bool:
        return False

    def to_dict(self) -> Dict[str, Any]:
        data = asdict(self)
        data["status"] = self.status.value
        data["provenance"] = asdict(self.provenance)
        data.update({
            "loss_count": self.loss_count,
            "loss_ratio": self.loss_ratio,
            "provenance_reconstructible": self.provenance_reconstructible,
            "mathematical_reversible": self.mathematical_reversible,
        })
        return data


def fold_l5_to_l3(
    source: Sequence[Sequence[int]],
    *,
    mode: str = "sign",
    parent_ids: Sequence[str] = (),
    operator_version: str = "fold-v1",
    audit_event_id: str = "",
) -> FoldResult:
    source_matrix = matrix_tuple(source, L5)
    if mode == "sign":
        projection, loss = sign_fold(source_matrix)
    elif mode == "threshold":
        projection, loss = threshold_fold(source_matrix)
    else:
        raise ValueError("mode must be 'sign' or 'threshold'")
    status = FoldStatus.LOSSY if _mask_count(loss) else FoldStatus.STABLE
    provenance = Provenance(
        source_digest=matrix_digest(source_matrix),
        operator=f"{mode}_projection",
        operator_version=operator_version,
        operator_path=("L5", f"{mode}_projection", "L3"),
        parent_ids=tuple(parent_ids),
        audit_event_id=audit_event_id,
    )
    return FoldResult(source_matrix, projection, loss, tuple(tuple(0 for _ in row) for row in source_matrix), 0, status, provenance)


def weighted_vote(values: Sequence[int], weights: Sequence[float], margin: float = 0.20) -> Tuple[int, Dict[int, float], FoldStatus]:
    if len(values) != len(weights) or not values:
        raise ValueError("values and weights must be non-empty and have equal length")
    scores = {state: 0.0 for state in L3}
    for value, weight in zip(values, weights):
        if value not in L5:
            raise ValueError("vote contains non-pentary value")
        weight = _finite(weight, "weight")
        if weight < 0:
            raise ValueError("weight must be non-negative")
        scores[-1 if value < 0 else 1 if value > 0 else 0] += weight
    ranked = sorted(scores.items(), key=lambda item: (-item[1], item[0]))
    winner, top = ranked[0]
    runner = ranked[1][1]
    total = sum(scores.values())
    relative_margin = (top - runner) / total if total else 0.0
    if top == 0:
        return 0, scores, FoldStatus.STABLE
    if relative_margin < margin:
        return winner, scores, FoldStatus.AMBIGUOUS
    if scores[-1] > 0 and scores[1] > 0 and relative_margin < margin * 2:
        return winner, scores, FoldStatus.CONFLICTED
    return winner, scores, FoldStatus.STABLE


@dataclass
class ExperienceNode:
    experience_id: str
    spiral_turn: int
    branch_context: str
    fold: FoldResult
    parent_experience_id: Optional[str] = None
    outcome: str = "UNASSESSED"
    decision: Decision = Decision.CLARIFY
    confidence: float = 0.0
    recurrence_count: int = 1
    validated: bool = False
    decay_score: float = 1.0
    children: List[str] = field(default_factory=list)

    def reusable(self) -> bool:
        return (
            self.validated
            and self.fold.status == FoldStatus.STABLE
            and self.fold.loss_ratio == 0.0
            and self.fold.provenance_reconstructible
            and self.decision != Decision.VETO
        )

    def to_dict(self) -> Dict[str, Any]:
        return {
            "experience_id": self.experience_id,
            "spiral_turn": self.spiral_turn,
            "branch_context": self.branch_context,
            "parent_experience_id": self.parent_experience_id,
            "fold": self.fold.to_dict(),
            "outcome": self.outcome,
            "decision": self.decision.value,
            "confidence": self.confidence,
            "recurrence_count": self.recurrence_count,
            "validated": self.validated,
            "decay_score": self.decay_score,
            "children": list(self.children),
            "reusable": self.reusable(),
        }


class LomonosovSpiralTree:
    """Append-only experience memory with explicit branches and provenance."""

    def __init__(self) -> None:
        self.nodes: Dict[str, ExperienceNode] = {}
        self.roots: List[str] = []

    def add(
        self,
        source: Sequence[Sequence[int]],
        *,
        context: str,
        turn: int,
        parent_id: Optional[str] = None,
        mode: str = "sign",
        outcome: str = "UNASSESSED",
        decision: Decision = Decision.CLARIFY,
        confidence: float = 0.0,
        validated: bool = False,
    ) -> ExperienceNode:
        fold = fold_l5_to_l3(source, mode=mode, parent_ids=(parent_id,) if parent_id else ())
        seed = f"{fold.provenance.source_digest}:{context}:{turn}:{len(self.nodes)}"
        experience_id = "exp-" + hashlib.sha256(seed.encode()).hexdigest()[:16]
        node = ExperienceNode(
            experience_id=experience_id,
            spiral_turn=turn,
            branch_context=context,
            fold=fold,
            parent_experience_id=parent_id,
            outcome=outcome,
            decision=decision,
            confidence=max(0.0, min(1.0, _finite(confidence, "confidence"))),
            validated=validated,
        )
        self.nodes[experience_id] = node
        if parent_id:
            if parent_id not in self.nodes:
                raise KeyError("parent experience does not exist")
            self.nodes[parent_id].children.append(experience_id)
        else:
            self.roots.append(experience_id)
        return node

    def retrieve(self, context: str, *, include_lossy: bool = True) -> List[ExperienceNode]:
        candidates = [n for n in self.nodes.values() if n.branch_context == context]
        if not include_lossy:
            candidates = [n for n in candidates if n.fold.status == FoldStatus.STABLE]
        return sorted(candidates, key=lambda n: (n.reusable(), n.confidence, n.recurrence_count), reverse=True)

    def validate(self, experience_id: str, confidence: float) -> None:
        node = self.nodes[experience_id]
        node.confidence = max(0.0, min(1.0, _finite(confidence, "confidence")))
        node.validated = node.fold.status == FoldStatus.STABLE and node.fold.provenance_reconstructible
        node.outcome = "VALIDATED" if node.validated else "REQUIRES_REVIEW"

    def decay(self, factor: float = 0.99) -> None:
        factor = _finite(factor, "factor")
        if not 0 < factor <= 1:
            raise ValueError("decay factor must be in (0, 1]")
        for node in self.nodes.values():
            node.decay_score *= factor

    def export(self) -> Dict[str, Any]:
        return {"roots": list(self.roots), "nodes": {k: v.to_dict() for k, v in self.nodes.items()}}


@dataclass(frozen=True)
class TensorFieldResult:
    field: Matrix
    scale_field: Matrix
    saturation_count: int
    gradient_activity: int
    operator: str
    advisory_only: bool = True


def _saturate(value: int, low: int = -2, high: int = 2) -> int:
    return max(low, min(high, value))


def global_comma_shift(field: Sequence[Sequence[int]], scale: int) -> TensorFieldResult:
    source = matrix_tuple(field, L5)
    if scale not in (-2, -1, 1, 2):
        raise ValueError("scale must be a nonzero integer in {-2,-1,1,2}")
    shifted = tuple(tuple(_saturate(x * scale) for x in row) for row in source)
    saturation = sum(1 for a, row in zip(source, shifted) for x, y in zip(a, row) if abs(x * scale) > 2)
    gradient = sum(1 for row in shifted for a, b in zip(row, row[1:]) if a != b)
    scales = tuple(tuple(scale for _ in row) for row in source)
    return TensorFieldResult(shifted, scales, saturation, gradient, "global_comma_shift")


def spatial_comma_shift(field: Sequence[Sequence[int]], scale_field: Sequence[Sequence[int]]) -> TensorFieldResult:
    source = matrix_tuple(field, L5)
    scales = matrix_tuple(scale_field, (-2, -1, 1, 2))
    if matrix_shape(source) != matrix_shape(scales):
        raise ValueError("field and scale_field shapes must match")
    shifted = tuple(tuple(_saturate(x * s) for x, s in zip(row, srow)) for row, srow in zip(source, scales))
    saturation = sum(1 for row, srow in zip(source, scales) for x, s in zip(row, srow) if abs(x * s) > 2)
    gradient = sum(1 for row in shifted for a, b in zip(row, row[1:]) if a != b)
    return TensorFieldResult(shifted, scales, saturation, gradient, "spatial_comma_shift")


@dataclass(frozen=True)
class DecisionGateResult:
    decision: Decision
    reasons: Tuple[str, ...]
    bxos_authority: bool


def decision_gate(node: ExperienceNode, *, external_effect: bool = True) -> DecisionGateResult:
    reasons: List[str] = []
    if not node.fold.provenance_reconstructible:
        reasons.append("missing provenance")
    if node.fold.status in (FoldStatus.AMBIGUOUS, FoldStatus.CONFLICTED):
        reasons.append(node.fold.status.value)
    if node.fold.loss_ratio > 0:
        reasons.append("projection loss present")
    if node.confidence < 0.70:
        reasons.append("confidence below 0.70")
    if node.decision == Decision.VETO:
        return DecisionGateResult(Decision.VETO, tuple(reasons) + ("node veto",), False)
    if node.decision == Decision.CLARIFY:
        return DecisionGateResult(Decision.CLARIFY, tuple(reasons) + ("node requires clarification",), False)
    if external_effect and reasons:
        return DecisionGateResult(Decision.CLARIFY, tuple(reasons), False)
    return DecisionGateResult(Decision.PASS, tuple(reasons), True)


def run_v12_self_test() -> Dict[str, Any]:
    tree = LomonosovSpiralTree()
    stable = tree.add([[0, -1], [1, 0]], context="baseline", turn=1, confidence=0.95, validated=True, decision=Decision.PASS)
    lossy = tree.add([[-2, -1], [1, 2]], context="experimental", turn=2, mode="sign", confidence=0.90)
    gate_stable = decision_gate(stable)
    gate_lossy = decision_gate(lossy)
    assert stable.fold.status == FoldStatus.STABLE
    assert lossy.fold.status == FoldStatus.LOSSY
    assert not gate_lossy.bxos_authority
    assert stable.fold.provenance_reconstructible
    assert not stable.fold.mathematical_reversible
    field = global_comma_shift([[-2, -1], [1, 2]], 2)
    assert field.advisory_only
    return {
        "version": "V12",
        "stable_experience": stable.to_dict(),
        "lossy_experience": lossy.to_dict(),
        "stable_gate": asdict(gate_stable),
        "lossy_gate": asdict(gate_lossy),
        "tensor_field": asdict(field),
        "tree": tree.export(),
        "invariants": {
            "l3_domain_preserved": all(x in L3 for row in stable.fold.projection_matrix for x in row),
            "source_digest_present": bool(lossy.fold.provenance.source_digest),
            "loss_mask_present": lossy.fold.loss_count == 2,
            "bxos_blocked_on_loss": not gate_lossy.bxos_authority,
        },
    }


