        parent_event_ids=('E1',), arrived=8.0, departed=5.0, external_input=0.0, external_output=3.0,
        tempo=1.0, rhythm=1.0, provenance_ref='obs:E1->transform:E2', confidence=0.90,
    )
    third = ledger.record(
        event_id='E3', cause='conflicting_output', location='graph:intersection-X', time_value=3.0,
