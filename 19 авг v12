# Adapted from preserved GamePenta and GameEngineV9.6 contracts.
# Historical source files remain immutable. V12 uses deterministic execution,
# explicit provenance and the existing V12 decision gate.

class GamePenta:
    """Deterministic pentary strategic game layer: -2..+2."""

    STRATEGIES = (-2, -1, 0, 1, 2)
    STRATEGY_NAMES = {
        -2: 'hard_conflict', -1: 'competitive_pressure', 0: 'neutral_wait',
        1: 'limited_cooperation', 2: 'active_cooperation',
    }

    def __init__(self) -> None:
        self.players: Dict[str, Dict[str, Any]] = {}
        self.history: List[Dict[str, Any]] = []

    def add_player(self, name: str, role: str, resources: float, strategy: int, *, provenance_ref: str = '') -> None:
        if strategy not in self.STRATEGIES:
            raise ValueError('strategy must be one of -2, -1, 0, 1, 2')
        resources = _finite(resources, 'resources')
        if resources < 0:
            raise ValueError('resources must be non-negative')
        self.players[name] = {
            'role': role, 'resources': resources, 'strategy': strategy,
            'strategy_name': self.STRATEGY_NAMES[strategy], 'payoff': 0.0,
            'l5_status': 0, 'provenance_ref': provenance_ref,
        }

    def set_strategy(self, name: str, strategy: int) -> None:
        if name not in self.players:
            raise KeyError(f'unknown player: {name}')
        if strategy not in self.STRATEGIES:
            raise ValueError('strategy must be one of -2, -1, 0, 1, 2')
        self.players[name]['strategy'] = strategy
        self.players[name]['strategy_name'] = self.STRATEGY_NAMES[strategy]

    @staticmethod
    def _deterministic_environment(name: str, step: int) -> float:
        digest = hashlib.sha256(f'{name}:{step}'.encode()).hexdigest()
        bucket = int(digest[:8], 16) % 9
        return (bucket - 4) / 100.0

    def simulate(self, steps: int = 5) -> List[Dict[str, Any]]:
        if steps < 0:
            raise ValueError('steps must be non-negative')
        results: List[Dict[str, Any]] = []
        for step in range(steps):
            for name, data in self.players.items():
                strategic_delta = data['strategy'] * 0.10
                environmental_delta = self._deterministic_environment(name, step)
                data['payoff'] += strategic_delta + environmental_delta
                normalized = max(-1.0, min(1.0, data['payoff'] / 10.0))
                data['l5_status'] = 2 if normalized >= 0.6 else 1 if normalized >= 0.2 else -2 if normalized <= -0.6 else -1 if normalized <= -0.2 else 0
            snapshot = {
                'step': step + 1,
                'players': {name: round(data['payoff'], 6) for name, data in self.players.items()},
                'l5': {name: data['l5_status'] for name, data in self.players.items()},
            }
            results.append(snapshot)
            self.history.append(snapshot)
        return results

    def cost_of_conflict(self) -> float:
        return sum(data['resources'] * (0.8 if data['strategy'] == -2 else 0.5)
                   for data in self.players.values() if data['strategy'] in (-2, -1))

    def gain_of_cooperation(self) -> float:
        return sum(data['resources'] * (1.0 if data['strategy'] == 2 else 0.8)
                   for data in self.players.values() if data['strategy'] in (1, 2))

    def is_deal_good(self) -> bool:
        return self.gain_of_cooperation() > self.cost_of_conflict()

    def export(self) -> Dict[str, Any]:
        return {'players': self.players, 'history': self.history,
                'cost_of_conflict': self.cost_of_conflict(),
                'gain_of_cooperation': self.gain_of_cooperation(),
                'deal_good': self.is_deal_good()}


@dataclass
class V12WaveNode:
    node_id: int
    label: str
    amplitude: float
    phase: float
    position: Tuple[float, float]
    children: List[int] = field(default_factory=list)
    parents: List[int] = field(default_factory=list)

    def wave(self, timestamp: float) -> float:
        return self.amplitude * math.sin(2.0 * timestamp + self.phase)


class GameEngineV9Improved:
    """V12-safe adaptation of GameEngineV9.6 for actor and mask scenarios."""

    def __init__(self, *, domain_packs: Sequence[str] = ('Core', 'Market', 'Geopolitics')) -> None:
        self.domain_packs = tuple(domain_packs)
        self.nodes: Dict[int, V12WaveNode] = {}
        self.history: List[Dict[str, Any]] = []
        self.current_time = 0.0
        self.experience: Dict[str, List[float]] = {}

    def _add_node(self, label: str, amplitude: float, phase: float, position: Tuple[float, float]) -> int:
        node_id = len(self.nodes) + 1
        self.nodes[node_id] = V12WaveNode(node_id, label, amplitude, phase, position)
        return node_id

    def _wire_chain(self, node_ids: Sequence[int]) -> None:
        for left, right in zip(node_ids, node_ids[1:]):
            if right not in self.nodes[left].children:
                self.nodes[left].children.append(right)
            if left not in self.nodes[right].parents:
                self.nodes[right].parents.append(left)

    @staticmethod
    def _positions(count: int) -> List[Tuple[float, float]]:
        if count <= 0:
            return []
        return [(0.5 * math.cos(2 * math.pi * i / count), 0.5 * math.sin(2 * math.pi * i / count)) for i in range(count)]

    def _experience_score(self, label: str) -> float:
        values = self.experience.get(label, [])
        return sum(values) / len(values) if values else 0.5

    def add_experience(self, label: str, outcome: float) -> None:
        outcome = max(0.0, min(1.0, _finite(outcome, 'outcome')))
        self.experience.setdefault(label, []).append(outcome)

    def process(self, query: str, interpretations: Dict[str, float], *, game: Optional[GamePenta] = None, mask_scores: Optional[Dict[str, float]] = None) -> Dict[str, Any]:
        if not interpretations:
            raise ValueError('interpretations must be non-empty')
        self.current_time += 1.0
        positions = self._positions(len(interpretations))
        node_ids: Dict[str, int] = {}
        for (label, score), position in zip(interpretations.items(), positions):
            score = max(-1.0, min(1.0, _finite(score, f'interpretation:{label}')))
            node_ids[label] = self._add_node(label, score, len(node_ids) * 0.5, position)
        self._wire_chain(tuple(node_ids.values()))

        pattern: Dict[int, float] = {}
        for node_id, node in self.nodes.items():
            incoming = 0.0
            for parent_id in node.parents:
                parent = self.nodes[parent_id]
                dx = parent.position[0] - node.position[0]
                dy = parent.position[1] - node.position[1]
                attenuation = 1.0 / (1.0 + math.sqrt(dx * dx + dy * dy))
                incoming += parent.wave(self.current_time) * attenuation
            pattern[node_id] = incoming + node.wave(self.current_time)
        conflicts = [node_id for node_id, value in pattern.items() if abs(value) > 0.3]
        stability = 1.0 - len(conflicts) / max(len(self.nodes), 1)
        balance = sum(pattern.values())
        game_score = 0.5
        if game is not None:
            total = game.gain_of_cooperation() + game.cost_of_conflict()
            game_score = game.gain_of_cooperation() / total if total else 0.5

        candidate_scores: Dict[str, Dict[str, float]] = {}
        best_candidate: Optional[str] = None
        best_score = -float('inf')
        for label, node_id in node_ids.items():
            wave_score = max(0.0, min(1.0, (pattern.get(node_id, 0.0) + 1.0) / 2.0))
            mask_score = (mask_scores or {}).get(label, 0.5)
            experience_score = self._experience_score(label)
            confidence = max(0.0, min(1.0, interpretations[label]))
            composite = 0.20 * wave_score + 0.25 * mask_score + 0.20 * experience_score + 0.15 * confidence + 0.20 * game_score
            candidate_scores[label] = {'wave': round(wave_score, 4), 'mask': round(mask_score, 4), 'experience': round(experience_score, 4), 'confidence': round(confidence, 4), 'game': round(game_score, 4), 'composite': round(composite, 4)}
            if composite > best_score:
                best_score, best_candidate = composite, label
        result = {
            'status': 'success', 'query': query, 'best_candidate': best_candidate,
            'best_composite_score': round(best_score, 4), 'candidate_scores': candidate_scores,
            'stability_index': round(stability, 4), 'conflicts_count': len(conflicts),
            'system_balance': round(balance, 4), 'node_count': len(self.nodes),
            'domain_packs': self.domain_packs, 'game_score': round(game_score, 4),
            'version': 'V12 Game-Integrated / V9.6 adapter',
        }
        self.history.append(result)
        return result

    def get_state(self) -> Dict[str, Any]:
        return {'version': 'V12 Game-Integrated / V9.6 adapter', 'nodes': len(self.nodes), 'history_len': len(self.history), 'current_time': self.current_time, 'domain_packs': self.domain_packs}


