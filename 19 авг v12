            'causal_chain_resolved': ledger.causal_chain('E3') == ['E1', 'E2', 'E3'],
            'provenance_present': all(event.provenance_ref for event in ledger.events),
            'balance_contract_passed': summary['residual_events'] == 0,
            'not_universal_conservation_claim': True,
        },
    }


