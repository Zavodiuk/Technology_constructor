def _scenario_game(scenario: HistoricalScenario) -> GamePenta:
    game = GamePenta()
    for actor, strategy in scenario.strategies.items():
        game.add_player(actor, scenario.actor_roles[actor], 1.0, strategy, provenance_ref=f'historical://{scenario.scenario_id}/{actor}')
    game.simulate(steps=3)
    return game


def _replay_once(scenario: HistoricalScenario, packs: Sequence[str]) -> Dict[str, Any]:
    game = _scenario_game(scenario)
    engine = GameEngineV9Improved(domain_packs=tuple(packs))
    interpretations = {actor: 0.5 + 0.1 * max(-2, min(2, strategy)) for actor, strategy in scenario.strategies.items()}
    mask_scores = {actor: 0.5 for actor in interpretations}
    engine_result = engine.process(scenario.title, interpretations, game=game, mask_scores=mask_scores)
    folded = LomonosovSpiralTree().add([[-2, -1], [1, 2]], context=scenario.scenario_id, turn=1, confidence=0.75)
    gate = decision_gate(folded, external_effect=True)
    return {
        'scenario_id': scenario.scenario_id,
        'packs': list(packs),
        'mask_count': len(v12_domain_masks(packs)),
        'actor_count': len(scenario.actors),
        'actor_coverage': round(len(set(scenario.actors) & set(scenario.strategies)) / len(scenario.actors), 3),
        'engine_result': engine_result,
        'game_summary': {'conflict_cost': game.cost_of_conflict(), 'cooperation_gain': game.gain_of_cooperation(), 'deal_good': game.is_deal_good()},
        'decision': gate.decision.value,
        'bxos_authority': gate.bxos_authority,
        'source_urls': list(scenario.source_urls),
        'documented_outcomes': list(scenario.documented_outcomes),
    }


def run_historical_replay_benchmark() -> Dict[str, Any]:
    full_packs = ('Core', 'Market', 'Geopolitics')
    scenarios = historical_v12_scenarios()
    rows: List[Dict[str, Any]] = []
    robustness: List[Dict[str, Any]] = []
    for scenario in scenarios:
        full = _replay_once(scenario, full_packs)
        repeat = _replay_once(scenario, full_packs)
        deterministic = (full['engine_result']['best_candidate'] == repeat['engine_result']['best_candidate'] and full['engine_result']['best_composite_score'] == repeat['engine_result']['best_composite_score'])
        full['deterministic_repeat'] = deterministic
        rows.append(full)
        ablations = {}
        for removed in full_packs:
            reduced = tuple(pack for pack in full_packs if pack != removed)
            ablations[f'without_{removed}'] = {
                'mask_count': len(v12_domain_masks(reduced)),
                'decision': _replay_once(scenario, reduced)['decision'],
                'bxos_authority': _replay_once(scenario, reduced)['bxos_authority'],
            }
        robustness.append({'scenario_id': scenario.scenario_id, 'ablations': ablations, 'full_gate_conservative': full['bxos_authority'] is False})
    return {
        'version': 'V12-HISTORICAL-REPLAY-BENCHMARK',
        'author': 'Vladimir Zavodiuk', 'license': 'All Rights Reserved',
        'scenarios': rows, 'robustness': robustness,
        'limitations': [
            'Retrospective replay is not prospective validation.',
            'Inputs must be frozen at each historical start date in a future data audit.',
            'The current benchmark uses documented outcome descriptors; it does not claim causal price prediction.',
            'Normalized game resources are analytical units, not reported financial values.',
