@dataclass(frozen=True)
class MonetaryEffectiveness:
    decision_id: str
    currency: str
    gross_value: float
    avoided_cost: float
    implementation_cost: float
    operating_cost: float
    risk_reserve: float
    liquidity_discount: float
    timing_cost: float
    externality_cost: float
    total_cost: float
    net_monetary_value: float
    monetary_efficiency: float
    monetary_efficiency_trit: int
    confidence: float
    decision: Decision
    explanation: Tuple[str, ...]


def evaluate_monetary_effectiveness(
    *,
    decision_id: str,
    currency: str = 'USD',
    gross_value: float = 0.0,
    avoided_cost: float = 0.0,
    implementation_cost: float = 0.0,
    operating_cost: float = 0.0,
    risk_reserve: float = 0.0,
    liquidity_discount: float = 0.0,
    timing_cost: float = 0.0,
    externality_cost: float = 0.0,
    confidence: float = 0.0,
    provenance_quality: float = 0.0,
    conflicts: int = 0,
    rhythm_alignment: float = 1.0,
) -> MonetaryEffectiveness:
    raw = {
        'gross_value': gross_value, 'avoided_cost': avoided_cost,
        'implementation_cost': implementation_cost, 'operating_cost': operating_cost,
        'risk_reserve': risk_reserve, 'liquidity_discount': liquidity_discount,
        'timing_cost': timing_cost, 'externality_cost': externality_cost,
        'confidence': confidence, 'provenance_quality': provenance_quality,
        'rhythm_alignment': rhythm_alignment,
    }
    checked = {key: _finite(value, key) for key, value in raw.items()}
    nonnegative = ('gross_value', 'avoided_cost', 'implementation_cost', 'operating_cost', 'risk_reserve', 'liquidity_discount', 'timing_cost', 'externality_cost')
    if any(checked[key] < 0.0 for key in nonnegative):
        raise ValueError('monetary quantities must be non-negative')
    if not 0.0 <= checked['confidence'] <= 1.0 or not 0.0 <= checked['provenance_quality'] <= 1.0:
        raise ValueError('confidence and provenance_quality must be in [0, 1]')
    if checked['rhythm_alignment'] < 0.0:
        raise ValueError('rhythm_alignment must be non-negative')
    benefit = checked['gross_value'] + checked['avoided_cost']
    total_cost = sum(checked[key] for key in nonnegative[2:])
    net_value = benefit - total_cost
    monetary_efficiency = benefit / max(total_cost, 0.01)
    if checked['provenance_quality'] < 0.5 or checked['confidence'] < 0.5 or conflicts > 0:
        monetary_efficiency *= max(0.0, min(1.0, checked['provenance_quality']))
    monetary_efficiency *= max(0.0, min(1.0, checked['rhythm_alignment']))
    efficiency_trit = _pentary_bucket(monetary_efficiency - 1.0, 1.0)
    reasons: List[str] = []
    if net_value < 0.0:
        reasons.append('net_monetary_value_negative')
    if checked['provenance_quality'] < 0.5:
        reasons.append('provenance_quality_below_threshold')
    if checked['confidence'] < 0.5:
        reasons.append('confidence_below_threshold')
    if conflicts > 0:
        reasons.append('conflicts_present')
    if checked['rhythm_alignment'] < 0.75:
        reasons.append('rhythm_misaligned')
    if net_value < 0.0 or checked['provenance_quality'] < 0.25:
        decision = Decision.VETO
    elif reasons:
        decision = Decision.CLARIFY
    else:
        decision = Decision.PASS
    if not reasons:
        reasons.append('positive_monetary_value_and_evidence_within_thresholds')
    return MonetaryEffectiveness(
        decision_id=str(decision_id), currency=str(currency),
        gross_value=checked['gross_value'], avoided_cost=checked['avoided_cost'],
        implementation_cost=checked['implementation_cost'], operating_cost=checked['operating_cost'],
        risk_reserve=checked['risk_reserve'], liquidity_discount=checked['liquidity_discount'],
        timing_cost=checked['timing_cost'], externality_cost=checked['externality_cost'],
        total_cost=total_cost, net_monetary_value=net_value,
        monetary_efficiency=monetary_efficiency, monetary_efficiency_trit=efficiency_trit,
        confidence=checked['confidence'], decision=decision, explanation=tuple(reasons),
    )


def run_monetary_effectiveness_self_test() -> Dict[str, Any]:
    productive = evaluate_monetary_effectiveness(
        decision_id='M1', gross_value=150000.0, avoided_cost=25000.0,
        implementation_cost=20000.0, operating_cost=10000.0, risk_reserve=5000.0,
        liquidity_discount=2000.0, timing_cost=3000.0, externality_cost=1000.0,
        confidence=0.95, provenance_quality=0.95, rhythm_alignment=0.95,
    )
    costly = evaluate_monetary_effectiveness(
        decision_id='M2', gross_value=10000.0, implementation_cost=18000.0,
        operating_cost=6000.0, risk_reserve=5000.0, timing_cost=3000.0,
        confidence=0.90, provenance_quality=0.90, rhythm_alignment=0.90,
    )
    conflicted = evaluate_monetary_effectiveness(
        decision_id='M3', gross_value=90000.0, avoided_cost=10000.0,
        implementation_cost=15000.0, operating_cost=5000.0, risk_reserve=5000.0,
        confidence=0.70, provenance_quality=0.40, rhythm_alignment=0.60,
        conflicts=2,
    )
    assert productive.net_monetary_value > 0 and productive.decision == Decision.PASS
    assert costly.net_monetary_value < 0 and costly.decision == Decision.VETO
    assert conflicted.net_monetary_value > 0 and conflicted.decision == Decision.CLARIFY
    return {
        'version': 'V12-MONETARY-EFFECTIVENESS',
        'cases': {
            'productive': asdict(productive),
            'costly': asdict(costly),
            'conflicted': asdict(conflicted),
        },
        'invariants': {
            'money_is_primary_unit': True,
            'net_value_is_explicit': all('net_monetary_value' in asdict(item) for item in (productive, costly, conflicted)),
            'negative_value_blocks_pass': costly.decision == Decision.VETO,
            'positive_value_is_not_sufficient_without_evidence': conflicted.decision == Decision.CLARIFY,
            'provenance_and_rhythm_affect_score': conflicted.monetary_efficiency < productive.monetary_efficiency,
            'currency_present': all(item.currency == 'USD' for item in (productive, costly, conflicted)),
        },
    }


