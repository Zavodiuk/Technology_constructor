# ---------------------------------------------------------------------------

class RhythmMode(str, Enum):
    FROZEN = 'FROZEN'
    SLOW = 'SLOW'
    STEADY = 'STEADY'
    ADAPTIVE = 'ADAPTIVE'
    REVIEW = 'REVIEW'


@dataclass(frozen=True)
class GraphMotion:
    node_id: str
    previous_node_id: Optional[str]
    time: float
    path_length: float
    dt: float
    tempo: float
    rhythm: float
    tempo_derivative: float
    rhythm_derivative: float
    base_energy: float
    effective_load: float
    load_ratio: float
    rhythm_trit: int
    load_pent: int


@dataclass(frozen=True)
class RhythmGovernorResult:
    mode: RhythmMode
    governor_ratio: float
    allowed_growth_rate: float
    observed_growth_rate: float
    observed_rhythm: float
    external_rate: float
    effective_load: float
    decision: Decision
    explanation: Tuple[str, ...]


class RhythmGovernor:
    """Advisory governor; limits growth tempo, not raw computation."""

    def __init__(self, epsilon: float = 1e-9, max_load_ratio: float = 1.0):
        self.epsilon = max(float(epsilon), 1e-12)
        self.max_load_ratio = max(float(max_load_ratio), self.epsilon)

    def evaluate(
        self,
        *,
        external_rate: float,
        observed_growth_rate: float,
        observed_rhythm: float,
        effective_load: float,
        adaptation_capacity: float,
        provenance_quality: float,
        conflicts: int = 0,
    ) -> RhythmGovernorResult:
        values = {
            'external_rate': external_rate,
            'observed_growth_rate': observed_growth_rate,
            'observed_rhythm': observed_rhythm,
            'effective_load': effective_load,
            'adaptation_capacity': adaptation_capacity,
            'provenance_quality': provenance_quality,
        }
        clean = {key: max(0.0, _finite(value, key)) for key, value in values.items()}
        external = clean['external_rate']
        observed = clean['observed_growth_rate']
        adaptation = clean['adaptation_capacity']
        if external <= self.epsilon or adaptation <= self.epsilon:
            ratio = 0.0
        else:
            ratio = min(
                external / max(observed, self.epsilon),
                external / max(clean['observed_rhythm'], self.epsilon),
                adaptation / max(observed, self.epsilon),
                self.max_load_ratio / max(clean['effective_load'], self.epsilon),
            )
        ratio = max(0.0, min(1.0, ratio))
        reasons: List[str] = []
        if clean['provenance_quality'] < 0.5:
            reasons.append('provenance_quality_below_threshold')
        if conflicts > 0:
            reasons.append('graph_conflicts_present')
        if clean['effective_load'] > self.max_load_ratio:
            reasons.append('effective_load_exceeds_budget')
        if ratio == 0.0 or clean['provenance_quality'] < 0.25:
            mode = RhythmMode.FROZEN
            decision = Decision.VETO
        elif ratio < 0.5 or conflicts >= 3:
            mode = RhythmMode.SLOW
            decision = Decision.CLARIFY
        elif ratio < 0.9 or conflicts > 0 or clean['provenance_quality'] < 0.75:
            mode = RhythmMode.REVIEW
            decision = Decision.CLARIFY
        elif ratio < 1.0:
            mode = RhythmMode.STEADY
            decision = Decision.PASS
        else:
            mode = RhythmMode.ADAPTIVE
            decision = Decision.PASS
        if not reasons:
            reasons.append('rates_and_load_within_configured_bounds')
        return RhythmGovernorResult(
            mode=mode,
            governor_ratio=ratio,
            allowed_growth_rate=external * ratio,
            observed_growth_rate=observed,
            observed_rhythm=clean['observed_rhythm'],
            external_rate=external,
            effective_load=clean['effective_load'],
            decision=decision,
            explanation=tuple(reasons),
        )


def _pentary_bucket(value: float, scale: float = 1.0) -> int:
    normalized = _finite(value, 'value') / max(_finite(scale, 'scale'), 1e-9)
    if normalized <= -1.0:
        return -2
    if normalized < -0.25:
        return -1
    if normalized <= 0.25:
        return 0
    if normalized < 1.0:
        return 1
    return 2


def graph_motion_sequence(
    points: Sequence[Tuple[str, float, float, float]],
    *,
    base_energy: float = 1.0,
    load_acceleration: float = 0.5,
) -> Tuple[GraphMotion, ...]:
    """Compute graph motion metrics from (node_id, time, path_length, tempo).

    effective_load is a dimensionless engineering load proxy. It is not
    relativistic mass and makes no physical claim about the graph.
    """
    if not points:
        return tuple()
    previous: Optional[GraphMotion] = None
    result: List[GraphMotion] = []
    for node_id, current_time, path_length, tempo in points:
        t = _finite(current_time, 'time')
        path = max(0.0, _finite(path_length, 'path_length'))
        current_tempo = max(0.0, _finite(tempo, 'tempo'))
        if previous is None:
            dt = max(t, 1.0)
            rhythm = path / dt
            tempo_derivative = 0.0
            rhythm_derivative = 0.0
        else:
            dt = max(t - previous.time, 1e-9)
            rhythm = path / dt
            tempo_derivative = (current_tempo - previous.tempo) / dt
            rhythm_derivative = (rhythm - previous.rhythm) / dt
        acceleration_term = abs(tempo_derivative) + abs(rhythm_derivative)
        effective_load = max(0.0, _finite(base_energy, 'base_energy')) * (1.0 + load_acceleration * (rhythm ** 2) + acceleration_term)
        load_ratio = effective_load / max(base_energy, 1e-9)
        motion = GraphMotion(
            node_id=str(node_id), previous_node_id=previous.node_id if previous else None,
            time=t, path_length=path, dt=dt, tempo=current_tempo, rhythm=rhythm,
            tempo_derivative=tempo_derivative, rhythm_derivative=rhythm_derivative,
            base_energy=max(0.0, _finite(base_energy, 'base_energy')),
            effective_load=effective_load, load_ratio=load_ratio,
            rhythm_trit=_pentary_bucket(rhythm - 0.5, 0.5),
            load_pent=_pentary_bucket(load_ratio - 1.0, 1.0),
        )
        result.append(motion)
        previous = motion
    return tuple(result)


def run_graph_rhythm_self_test() -> Dict[str, Any]:
    steady = graph_motion_sequence((('A', 1.0, 1.0, 1.0), ('B', 2.0, 1.0, 1.0), ('C', 3.0, 1.0, 1.0)), load_acceleration=0.0)
    accelerated = graph_motion_sequence((('A', 1.0, 1.0, 0.5), ('B', 1.5, 2.0, 1.5), ('C', 1.75, 5.0, 3.5)))
    governor = RhythmGovernor()
    steady_gate = governor.evaluate(external_rate=2.0, observed_growth_rate=0.5, observed_rhythm=steady[-1].rhythm, effective_load=steady[-1].effective_load, adaptation_capacity=2.0, provenance_quality=0.95)
    accelerated_gate = governor.evaluate(external_rate=0.5, observed_growth_rate=3.0, observed_rhythm=accelerated[-1].rhythm, effective_load=accelerated[-1].effective_load, adaptation_capacity=0.75, provenance_quality=0.70, conflicts=2)
    assert steady_gate.mode in (RhythmMode.STEADY, RhythmMode.ADAPTIVE)
    assert accelerated_gate.decision in (Decision.CLARIFY, Decision.VETO)
    assert accelerated[-1].effective_load > steady[-1].effective_load
    return {
        'version': 'V12-GRAPH-RHYTHM-GOVERNOR',
        'steady': [asdict(item) for item in steady],
        'accelerated': [asdict(item) for item in accelerated],
        'steady_gate': asdict(steady_gate),
        'accelerated_gate': asdict(accelerated_gate),
        'invariants': {
            'time_tempo_rhythm_linked': all(item.dt > 0 and item.rhythm >= 0 for item in steady + accelerated),
            'derivatives_present': any(item.tempo_derivative != 0 for item in accelerated),
            'acceleration_increases_load': accelerated[-1].effective_load > steady[-1].effective_load,
            'governor_slows_excess_rate': accelerated_gate.decision != Decision.PASS,
            'model_is_advisory': True,
        },
    }


