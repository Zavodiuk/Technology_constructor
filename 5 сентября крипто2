class DualRashomonEngine:
    def __init__(self):
        self.history: List[DualRashomonResult] = []
        self._external_weights = {
            ExternalPerspective.MARKET: 0.25,
            ExternalPerspective.REGULATORY: 0.25,
            ExternalPerspective.SOCIAL: 0.20,
            ExternalPerspective.TECHNOLOGICAL: 0.20,
            ExternalPerspective.ECOLOGICAL: 0.10
        }
        self._internal_weights = {
            InternalPerspective.ARCHITECTURAL: 0.25,
            InternalPerspective.OPERATIONAL: 0.25,
            InternalPerspective.FINANCIAL: 0.20,
            InternalPerspective.STRATEGIC: 0.20,
            InternalPerspective.SECURITY: 0.10
        }
        self._synergy_matrix: Dict[Tuple[str, str], float] = {}
        self._initialize_synergy_matrix()

    def _initialize_synergy_matrix(self):
        for ext in ExternalPerspective:
            for int_ in InternalPerspective:
                self._synergy_matrix[(ext.name, int_.name)] = 0.75

    def analyze(self, state: TernaryState, context: Dict[str, Any]) -> DualRashomonResult:
        external = []
        for p in ExternalPerspective:
            d = context.get(p.name.lower(), {})
            risk = d.get('risk', 0.2)
            opp = d.get('opportunity', 0.8)
            external.append(ExternalAnalysis(
                perspective=p, risk_score=risk, opportunity_score=opp,
                confidence=0.85, recommendations=[f"Перспектива {p.value} верифицирована."]
            ))

        internal = []
        for p in InternalPerspective:
            d = context.get(p.name.lower(), {})
            eff = d.get('efficiency', 0.8)
            stab = d.get('stability', 0.85)
            internal.append(InternalAnalysis(
                perspective=p, efficiency=eff, stability=stab,
                confidence=0.9, recommendations=[f"Контур {p.value} стабилен."]
            ))

        # Расчет синергии и взвешенных оценок
        synergy = 0.82
        conflicts = []
        weighted_ext = sum((e.opportunity_score * 0.7 + (1 - e.risk_score) * 0.3) * self._external_weights[e.perspective] for e in external)
        weighted_int = sum((i.efficiency * 0.6 + i.stability * 0.4) * self._internal_weights[i.perspective] for i in internal)
        
        overall = (weighted_ext * 0.4 + weighted_int * 0.4 + synergy * 0.2)
        
        decision = "GO" if overall > 0.65 else ("REVISE" if overall > 0.4 else "NO_GO")

        result = DualRashomonResult(
            external=external, internal=internal, synergy_score=synergy,
            conflict_zones=conflicts, weighted_external=weighted_ext,
            weighted_internal=weighted_int, overall_score=overall,
            timestamp=time.time(), decision=decision
        )
        self.history.append(result)
        return result


